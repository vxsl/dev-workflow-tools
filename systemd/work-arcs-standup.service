# work-arcs-standup.service -- put the standup prep on the screen. Started by
# work-arcs-standup.timer.
#
# Installed by `arc-standup-notify --install-timer`, which copies this into
# ~/.config/systemd/user/ and rewrites ExecStart to the checkout it was invoked from. The
# path below is where that checkout actually lives, so a hand-copied unit works as it
# stands and this file is not a template you have to fill in to read.
#
# A *user* unit for the same three reasons the refresh one is: it reads a user's state
# directory, and it delivers to a user's session bus. Unlike the refresh it spends nothing
# and reaches no network -- the whole job is to read one string off the disk and hand it to
# notify-send -- which is why there is no timeout worth raising and no quota worth guarding.
#
# There is deliberately no EnvironmentFile= for the repo's .env. systemd's parser is not a
# shell and does not know about `export` or quoting rules, and the cadence knobs are the
# one thing here that must not be half-read; arc-standup-notify parses .env itself, so a
# timer, a cron line and a person typing the name all get the same answer.

[Unit]
Description=Deliver the standup prep

[Service]
Type=oneshot

ExecStart=%h/bin/dev-workflow-tools/bin/arc-standup-notify

# 3 is "decided not to speak, and the log says which gate closed" -- no prep on disk, prep
# for a standup that has been and gone, nothing to report, not the right quarter hour,
# already delivered. Every one of those is the design working as designed, and a unit
# sitting in `failed` for the ordinary case of a wake-up the program declined would train
# `systemctl --user status` to be ignored. 1 stays a failure: it means the prep was ready
# and could not be put on the screen, which is the one outcome worth looking into.
SuccessExitStatus=3
