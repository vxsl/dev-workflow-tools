# work-arcs-refresh.service -- one arcs rebuild. Started by work-arcs-refresh.timer.
#
# Installed by `arcs-refresh --install-timer`, which copies this into
# ~/.config/systemd/user/ and rewrites ExecStart to the checkout it was invoked from. The
# path below is where that checkout actually lives, so a hand-copied unit works as it
# stands and this file is not a template you have to fill in to read.
#
# A *user* unit and not a system one, because the job is a user's all the way down: it
# reads a user's OAuth credentials, writes a user's state directory, and delivers its
# notification to a user's session bus. All three would have to be punched through for a
# system unit to buy anything, and it would buy nothing.
#
# There is no After=network-online.target here on purpose. That is a system unit and a user
# manager cannot order against it; the honest fix lives in arcs-refresh instead, which
# retries a usage read that comes back with no HTTP status at all. A timer that catches up
# after a wake runs while wifi is still associating, and that has to be survivable in the
# program rather than declared away in the unit.

[Unit]
Description=Rebuild the work-arcs page

[Service]
Type=oneshot

ExecStart=%h/bin/dev-workflow-tools/bin/arcs-refresh

# The pipeline is four to nine minutes of model calls on a normal morning, and the default
# TimeoutStartSec would kill it at ninety seconds -- mid-run, holding the lock, with a
# half-written page and a snapshot baseline already moved.
TimeoutStartSec=45min

# arcs-refresh keeps its own log, its own notifier and its own opinion about which exits
# are worth waking somebody for. 3 is "stood down on quota" and 4 is "a manual arcs holds
# the lock": both are the design working as designed, and a unit sitting in `failed` for
# either would train `systemctl --user status` to be ignored. 1 and 5 stay failures.
SuccessExitStatus=3 4
