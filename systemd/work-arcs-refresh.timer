# work-arcs-refresh.timer -- 07:10 every day, and the morning after a closed lid.
#
# Persistent=true is the entire reason this file exists rather than the crontab line it
# replaces. systemd stamps every run under ~/.local/share/systemd/timers/ and, on its next
# start, compares that stamp against the schedule and fires immediately for a run it owes.
# A cron daemon on a sleeping laptop misses 07:10 and never mentions it again -- which is
# not a failure in the log, it is an absence from the log, and that took a week to notice.
#
# WakeSystem is deliberately NOT set. Waking a laptop in a bag at 07:10 to rebuild a page
# nobody is looking at yet is worse than rebuilding it at 08:04 when the lid opens.
#
# `arcs-refresh --install-timer [HH:MM]` writes this into ~/.config/systemd/user/ with
# OnCalendar rewritten to the time asked for, enables it, and removes the crontab line as
# it goes -- two schedulers for one job is a race dressed up as redundancy.

[Unit]
Description=Rebuild the work-arcs page every morning

[Timer]
OnCalendar=07:10
Persistent=true

# A user timer's default is a minute of slack, which would be fine, except that this one is
# named after a time of day in the README and may as well mean it.
AccuracySec=30s

Unit=work-arcs-refresh.service

[Install]
WantedBy=timers.target
