#!/usr/bin/env bash
# arcs-refresh: run the arcs pipeline every morning, so the page is fresh before you are.
#
# "Passively, without keeping notes" was the point of the whole thing, and it was still a
# command you had to remember to type. This is the part that types it. It is `arcs` plus
# everything a program needs in order to be trusted to run while nobody is watching:
#
#   a quota guard   because extra_usage is ENABLED on this account -- crossing 100% does
#                   not stop, it starts spending money. An automation is the one thing
#                   that must never be what pushes you over, so it reads the utilisation
#                   before it starts and stands down rather than find out afterwards.
#   a lock          because a 07:10 timer and a 07:10 `arcs` typed by hand would otherwise
#                   both move the run-over-run snapshot baseline, and the loser's interval
#                   of changes disappears.
#   a log           because a program nobody watches has to be able to say what it did.
#   silence         on success. A daily "it worked" notification is training to ignore
#                   notifications; you only hear from this when it did not run.
#   an environment  built explicitly -- the first bug.
#   a credential    that survives a night with nobody logged in -- the second.
#   a clock         that survives a closed lid -- the third.
#
# All three are the same bug wearing different clothes: the program was correct and its
# surroundings were not what it was written in. What follows is the record of each, kept
# here rather than in a commit message because the next one will be of the same family.
#
# THE ENVIRONMENT IS THE WHOLE PROBLEM.
#
# cron runs jobs with PATH=/usr/bin:/bin and nothing else, and the pipeline was written by
# and for a login shell. Timed from an emulated cron environment before this script
# existed, the run "succeeded" in 40.5s and exited 0 -- and every arc on the page had lost
# its name:
#
#     ! no brief for Zero-fill categorical chart domains in SQL — could not run claude
#       (FileNotFoundError)
#     arc-brief: 10 arc(s) have no description; they fall back to their cluster label
#     brief: 4 sentences — unavailable — FileNotFoundError
#
# `claude` lives in ~/.local/bin and lib/headless_claude.py invokes it by bare name, so
# with cron's PATH every model call in the pipeline raises FileNotFoundError. Each one is
# caught -- correctly, a namer must not break the thing it names -- so the page is built,
# published and worse, and nothing anywhere says so. That is the exact shape of failure an
# unattended job exists to avoid, so this script does three things about it: it puts the
# real PATH back, it refuses to start when a required program is missing, and it treats
# "could not run claude" appearing in the output as a failed run even though the pipeline
# exited 0.
#
# Two more environment facts, same root cause. `python3` is pyenv's 3.12.8 interactively
# and /usr/bin/python3 (3.14) under cron -- a different interpreter with a different
# site-packages, which is not what any of this was tested against. And bin/arcs sources
# .env with a bare `source`, which sets shell variables without exporting them; it works
# interactively only because shell/dev-workflow.zsh already did `set -a` around the same
# file. From cron nothing has, so JIRA_REPO and the Slack tokens would be invisible to
# every subprocess. Both are fixed here rather than there, because bin/arcs is correct for
# the shell it was written for.
#
# AND THEN THE CREDENTIAL, AND THEN THE CLOCK.
#
# The paragraphs above were written with some satisfaction, and then the page stopped
# being rebuilt for eight days anyway. The log is the whole story:
#
#     Aug 17 07:10  refreshed in 278s
#     Aug 19 07:10  stood down: the usage endpoint could not be read
#     Aug 21 07:10  stood down: the usage endpoint could not be read
#     Aug 22-25     no line at all
#
# THE CREDENTIAL. The quota guard reads claudeAiOauth.accessToken out of
# ~/.claude/.credentials.json, and that token is good for hours, not for a night. At 07:10
# nobody has run a Claude session since the evening before, so the token is stale, /usage
# answers 401, and the guard does precisely the thing it was carefully built to do: it
# declines to guess, and stands down. Every step of that is correct and the feature does
# not exist. The tell was that the same check passed by hand at 10:00 the same morning --
# by then a live session had refreshed the token on its own behalf.
#
# So a 401, and a 401 only, now buys one retry with an access token minted from
# claudeAiOauth.refreshToken against the token endpoint the CLI itself uses. A timeout or
# a 500 buys nothing: those say something about the network and nothing about the token,
# and spending a refresh on them would turn "the wifi was down" into "your login is
# broken" in the log. The new token is held in a variable and never written down --
# see refresh_access_token for why writing it would be worse than the bug it fixes.
#
# Two things learned trying to watch that work, both of them about how hard these endpoints
# are to probe rather than about the flow itself, and both worth writing down because the
# next person to test this will otherwise spend the same half hour:
#
#   /usage answers 429 rather than a second 401 when it is handed the same invalid bearer
#   token more than once. So "corrupt a copy of the credentials and watch it refresh" works
#   exactly once per window; a retry loop re-arms the throttle and can never succeed. That
#   is what --check-refresh is for: it asks about the token endpoint alone.
#
#   The token endpoint itself answered 429 to every attempt over half an hour, on an
#   account whose 5-hour window was at 84% and whose live session had been refreshing all
#   evening. So minting a token was never observed to succeed here, only to be throttled --
#   which is a different thing from being refused, and the log now says which. If 07:10
#   turns out to be throttled too, the line to look for is "refreshing it was refused",
#   and the fallback is the one this file already has: say so plainly and stand down.
#
# THE CLOCK. `10 7 * * *` in a crontab does not fire on a laptop that is asleep at 07:10,
# and cron has no notion of a run it owes you, so three days of closed lid produced no
# line in the log at all. Not a failure -- an absence, which is the harder thing to
# notice, and the reason this went a week. That is now a systemd user timer with
# Persistent=true, which fires on the next wake for a run it missed. `--install-timer`
# removes the crontab line on its way past, because two schedulers for one job is a
# race dressed as a belt and braces.
#
# And a timer that fires on wake fires while wifi is still associating, which would have
# traded the old silence for a new one. A usage read that comes back with no HTTP status
# at all is therefore retried a few times before it counts as an answer: a run that
# happens without a network is the same missing page as a run that never happened.
#
#   arcs-refresh                    run it now, the way the timer will
#   arcs-refresh --force            run even if the quota guard says no
#   arcs-refresh --check-quota      just the guard's verdict, then exit
#   arcs-refresh --check-refresh    can the stored refresh token still mint one? no token
#                                   is printed, only whether it worked
#   arcs-refresh --install-timer    the systemd user timer: 07:10, catches up after sleep
#   arcs-refresh --install-timer 06:30
#   arcs-refresh --uninstall-timer  disable it and remove the units
#   arcs-refresh --install-cron     the crontab line instead -- no catch-up, see above
#   arcs-refresh --uninstall-cron   remove it, leave every other crontab line alone
#   arcs-refresh --hook             print the arc-record Stop hook block for settings.json
#
# Tuning, all read from .env or the environment:
#   WORK_ARCS_REFRESH_MAX_5H     stand down above this 5-hour utilisation  (default 80)
#   WORK_ARCS_REFRESH_MAX_7D     stand down above this 7-day utilisation   (default 90)
#   WORK_ARCS_REFRESH_ON_UNKNOWN skip|run when the quota cannot be read    (default skip)
#   WORK_ARCS_REFRESH_CMD        the pipeline to run                       (default arcs)
#   WORK_ARCS_REFRESH_LOG_LINES  ring-trim the log to this many lines      (default 2000)
#   WORK_ARCS_REFRESH_NET_TRIES  usage reads before a dead network counts  (default 3)
#   WORK_ARCS_REFRESH_NET_DELAY  seconds to wait between those             (default 10)
#   WORK_ARCS_CREDS              the OAuth credential file to read from
#                                                  (~/.claude/.credentials.json)
#
# Exit codes are distinct so the log and a test can tell the outcomes apart: 0 refreshed,
# 1 the pipeline failed, 3 stood down on quota, 4 another run holds the lock, 5 a required
# program is missing. cron mails on output rather than on status and this script writes
# its output to its own log, so a non-zero exit is quiet by construction; the systemd unit
# names 3 and 4 in SuccessExitStatus for the same reason.
#
# PUBLISHING IS NOT HERE, and cannot be: the page is a Claude Code artifact and only a
# Claude Code session can write to that URL. That is a platform constraint rather than a
# gap, and the human in the loop before anything goes outward is wanted anyway. What this
# buys is that the expensive half is already done: by the time you type /arcs the page on
# disk is minutes old, so the session's only job is the upload.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"

# --- the environment cron does not give you -------------------------------------------

# Ordering matters and is not the obvious one. The repo's own bin goes first so `arcs` and
# its stages resolve to this checkout. Then the dirs a login shell would have contributed
# and cron does not -- pyenv's shims ahead of /usr/bin so python3 is the 3.12.8 everything
# was written against, and ~/.local/bin so `claude` exists at all. The inherited PATH
# follows rather than leads: under cron it is only /usr/bin:/bin, and putting it first
# would let the wrong python3 win the very race this list exists to settle. The system
# dirs are repeated at the end as a floor, for the case where PATH arrives empty.
for d in "$HOME/.local/bin" "$HOME/.pyenv/shims" "$HOME/bin"; do
    [ -d "$d" ] && PATH="$d:$PATH"
done
PATH="$SCRIPT_DIR:$PATH:/usr/local/bin:/usr/bin:/bin"
export PATH

# `set -a` and not a bare source: see the header. Subprocesses need these, not this shell.
if [ -f "$REPO_DIR/.env" ]; then
    set -a
    # shellcheck disable=SC1091
    source "$REPO_DIR/.env"
    set +a
fi

# A desktop notification needs a session bus to deliver to and cron is not in one. All
# three are derivable from the uid, and are only set when the bus socket is actually
# there -- on a machine with nobody logged in, a notification that cannot be delivered
# should fail quietly rather than hang.
_uid="$(id -u)"
if [ -S "/run/user/$_uid/bus" ]; then
    export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$_uid}"
    export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$_uid/bus}"
    export DISPLAY="${DISPLAY:-:0}"
fi

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/work-arcs"
LOG_FILE="$STATE/refresh.log"
LOCK_FILE="$STATE/refresh.lock"
STATE_FILE="$STATE/refresh.json"
# Overridable so a test can point it at a fixture -- the 401 path is the whole reason this
# file has a refresh in it, and it cannot be exercised against the real login.
CREDS="${WORK_ARCS_CREDS:-$HOME/.claude/.credentials.json}"
USAGE_URL="${WORK_ARCS_USAGE_URL:-https://api.anthropic.com/api/oauth/usage}"

# The refresh_token half of the flow Claude Code itself uses, read out of the CLI it ships
# with rather than guessed: TOKEN_URL and CLIENT_ID are its own constants, and the beta
# header is the one both the token endpoint and /usage are gated behind. Overridable
# because they are somebody else's constants and will move without asking.
OAUTH_TOKEN_URL="${WORK_ARCS_OAUTH_TOKEN_URL:-https://platform.claude.com/v1/oauth/token}"
OAUTH_CLIENT_ID="${WORK_ARCS_OAUTH_CLIENT_ID:-9d1c250a-e61b-44d9-88ed-5944d1962f5e}"
OAUTH_BETA="${WORK_ARCS_OAUTH_BETA:-oauth-2025-04-20}"
NOTIFY="$HOME/bin/notification/claude-notify.sh"

MAX_5H="${WORK_ARCS_REFRESH_MAX_5H:-80}"
MAX_7D="${WORK_ARCS_REFRESH_MAX_7D:-90}"
ON_UNKNOWN="${WORK_ARCS_REFRESH_ON_UNKNOWN:-skip}"
PIPELINE="${WORK_ARCS_REFRESH_CMD:-arcs}"
LOG_LINES="${WORK_ARCS_REFRESH_LOG_LINES:-2000}"
HTTP_TIMEOUT=10

# A timer that catches up after a wake runs while wifi is still associating, so a
# usage read that comes back with no HTTP status at all is not yet an answer. Three
# tries ten seconds apart, which costs half a minute on the one morning a year the
# machine genuinely has no network and buys back every morning it is merely slow.
NET_TRIES="${WORK_ARCS_REFRESH_NET_TRIES:-3}"
NET_DELAY="${WORK_ARCS_REFRESH_NET_DELAY:-10}"

CRON_MARKER="# work-arcs-refresh"
CRON_DEFAULT_TIME="07:10"

mkdir -p "$STATE"

# --- saying what happened --------------------------------------------------------------

log() {
    printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S%z')" "$*" >>"$LOG_FILE"
    # Echoed as well when a person is watching. Under cron stdout goes to /dev/null, so
    # the log is the only reader and this costs nothing.
    [ -t 1 ] && printf '%s\n' "$*" || true
}

# Only ever called when something went wrong. claude-notify.sh has no quiet mode of its
# own -- CLAUDE_NOTIFY_QUIET is read by the Stop hook, not by the notifier -- so "silent
# on success" has to mean "not called on success", which is what this file does.
notify() {
    [ -x "$NOTIFY" ] || return 0
    "$NOTIFY" "work-arcs refresh" "$1" >/dev/null 2>&1 || true
}

trim_log() {
    [ -f "$LOG_FILE" ] || return 0
    local n
    n="$(wc -l <"$LOG_FILE")"
    [ "$n" -le "$LOG_LINES" ] && return 0
    tail -n "$LOG_LINES" "$LOG_FILE" >"$LOG_FILE.trim" && mv "$LOG_FILE.trim" "$LOG_FILE"
}

# --- the quota guard --------------------------------------------------------------------

# Globals rather than a printed tuple, and that is not laziness. The interesting part of
# the answer is no longer only the number: a read that needed a new access token first is
# a different outcome from one that did not, and the log has to be able to say which. A
# command substitution runs its function in a subshell, so anything the function learned
# on the way to the number would be discarded with it.
USAGE_JSON=""        # path to a temp file holding the response body, on success
USAGE_FAILURE=""     # a sentence saying why there is no body, on failure
USAGE_REFRESHED=0    # 1 when refreshing the access token is what made it work
USAGE_HTTP_CODE=""   # the last status /usage gave, "000" when curl never got one
REFRESH_HTTP_CODE="" # ditto for the token endpoint
REFRESH_ERROR=""     # what the token endpoint said when it said no
FRESH_ACCESS_TOKEN=""

# One GET with one bearer token, and the status kept where the caller can see it. That
# last part is the change: 401 means this token is stale and 000 means there is no network
# yet, and the whole fix rests on not treating them the same.
# curl prints `%{http_code}` as 000 when it never reached the host AND exits non-zero, so
# the `|| echo 000` this used to carry appended a second one and left "000000" in the
# variable. Harmless while nothing read it; the retry-on-unreachable path reads it, and
# would have compared "000000" against "000" and never retried -- the same class of quiet
# wrong-for-the-right-reason failure as everything else in this file.
http_code_or_000() {
    case "$1" in
        [0-9][0-9][0-9]) printf '%s' "$1" ;;
        *)               printf '000' ;;
    esac
}

usage_call() {
    local tok="$1" body
    body="$(mktemp)"
    USAGE_HTTP_CODE="$(curl -sS -m "$HTTP_TIMEOUT" -o "$body" -w '%{http_code}' \
        -H "Authorization: Bearer $tok" \
        -H "anthropic-beta: $OAUTH_BETA" \
        "$USAGE_URL" 2>/dev/null || true)"
    USAGE_HTTP_CODE="$(http_code_or_000 "$USAGE_HTTP_CODE")"
    if [ "$USAGE_HTTP_CODE" = "200" ] && jq -e . "$body" >/dev/null 2>&1; then
        USAGE_JSON="$body"
        return 0
    fi
    rm -f "$body"
    return 1
}

# The same call, given up on only after the network has had a chance to arrive. Retries on
# a "000" -- curl could not complete the request at all -- and on nothing else: a 401 is an
# answer and gets handled, a 500 is an answer and is not going to change in ten seconds.
usage_call_patiently() {
    local tok="$1" try=1
    while :; do
        if usage_call "$tok"; then return 0; fi
        if [ "$USAGE_HTTP_CODE" != "000" ] || [ "$try" -ge "$NET_TRIES" ]; then
            return 1
        fi
        log "the usage endpoint was unreachable (try $try of $NET_TRIES) — waiting ${NET_DELAY}s for the network"
        sleep "$NET_DELAY"
        try=$((try + 1))
    done
}

# THE 07:10 BUG, and the reason this function exists at all. See the header: the access
# token in the credentials file is good for hours and not for a night, so at 07:10 it is
# stale, /usage answers 401, and a guard built to refuse to guess refuses to guess. This
# mints a new one from the refresh token, which is the flow the CLI uses on its own behalf.
#
# THE NEW TOKEN IS NEVER WRITTEN DOWN, and that is the load-bearing decision here.
# ~/.claude/.credentials.json belongs to whichever Claude Code session is running: it
# rewrites the whole file when it refreshes, with no lock for anyone else to take. A second
# writer would turn a lost race into a truncated credential file, which is a broken login
# rather than a stale page -- strictly worse than the bug being fixed. So the token lives
# in a shell variable for the length of one retry and is then dropped. The cost is one
# extra token minted per morning; the benefit is that this file cannot break a session.
#
# ~/bin/hud-claude-usage reads the same endpoint with the same 401-means-stale limitation
# and keeps its stale cache instead. It could borrow this, but it is outside this repo and
# a shared helper for two callers is a worse trade than a pointer in a comment.
#
# The request body is a file and not an argument, because an argument is in `ps` and a
# refresh token is the durable half of the credential.
refresh_access_token() {
    local req resp
    FRESH_ACCESS_TOKEN=""
    REFRESH_HTTP_CODE=""
    REFRESH_ERROR=""
    req="$(mktemp)"; resp="$(mktemp)"
    chmod 600 "$req" "$resp"

    jq -n --slurpfile c "$CREDS" --arg cid "$OAUTH_CLIENT_ID" '
        {grant_type: "refresh_token",
         refresh_token: $c[0].claudeAiOauth.refreshToken,
         client_id: $cid,
         scope: (($c[0].claudeAiOauth.scopes // []) | join(" "))}' >"$req" 2>/dev/null || true
    # No refresh token to spend is not a network problem and must not look like one.
    if ! jq -e '.refresh_token | type == "string" and length > 0' "$req" >/dev/null 2>&1; then
        rm -f "$req" "$resp"
        REFRESH_HTTP_CODE="none"
        return 1
    fi

    # Content-Type and nothing else, which is what the CLI's own refresh sends. The beta
    # header belongs on /usage and was on this request too until it was checked; an extra
    # header on a token grant is a way to be rejected for a reason that has nothing to do
    # with the credential.
    REFRESH_HTTP_CODE="$(curl -sS -m "$HTTP_TIMEOUT" -o "$resp" -w '%{http_code}' \
        -H 'Content-Type: application/json' \
        --data @"$req" "$OAUTH_TOKEN_URL" 2>/dev/null || true)"
    REFRESH_HTTP_CODE="$(http_code_or_000 "$REFRESH_HTTP_CODE")"
    rm -f "$req"

    if [ "$REFRESH_HTTP_CODE" = "200" ]; then
        FRESH_ACCESS_TOKEN="$(jq -r '.access_token // empty' "$resp" 2>/dev/null || true)"
    else
        # What the endpoint said, not just that it said no. An OAuth error body is an
        # `error` and an `error_description` and no credential material, and the whole
        # lesson of this file is that "it did not work" is not a diagnosis: 429 means
        # throttled and try later, invalid_grant means the login is actually gone, and a
        # log that cannot tell them apart sends the next reader to the wrong place.
        # Two shapes, because this endpoint answers in both: the flat OAuth
        # {error, error_description} for a refused grant, and Anthropic's nested
        # {error: {type, message}} for a rate limit. Reading only the first one is how the
        # 429 that turned up during testing arrived in the log as a bare status code.
        REFRESH_ERROR="$(jq -r '
            (if (.error | type) == "object"
             then [.error.type, .error.message]
             else [(.error // .type), (.error_description // .message)] end)
            | map(select(type == "string" and . != "")) | join(": ")' "$resp" 2>/dev/null || true)"
        REFRESH_ERROR="${REFRESH_ERROR:0:200}"
    fi
    rm -f "$resp"
    [ -n "$FRESH_ACCESS_TOKEN" ]
}

# Sets USAGE_JSON on success and USAGE_FAILURE on failure, and the failures are worth
# telling apart in the log: "there was no network", "your token was old and I fixed it",
# and "your token was old and I could not" are three different mornings.
fetch_usage() {
    USAGE_JSON=""; USAGE_FAILURE=""; USAGE_REFRESHED=0
    local tok
    tok="$(jq -r '.claudeAiOauth.accessToken // empty' "$CREDS" 2>/dev/null || true)"
    if [ -z "$tok" ]; then
        USAGE_FAILURE="no access token in $CREDS"
        return 1
    fi

    if usage_call_patiently "$tok"; then return 0; fi

    # A 401, and only a 401. A timeout or a 500 says something about the network and
    # nothing about the token, and spending a refresh on one would write "your login is
    # broken" in the log on a morning the wifi was slow.
    if [ "$USAGE_HTTP_CODE" != "401" ]; then
        USAGE_FAILURE="the usage endpoint could not be read (HTTP $USAGE_HTTP_CODE)"
        return 1
    fi

    if ! refresh_access_token; then
        USAGE_FAILURE="the access token is expired and refreshing it was refused (token endpoint HTTP $REFRESH_HTTP_CODE${REFRESH_ERROR:+, $REFRESH_ERROR}) — run any claude session to refresh it, or re-login"
        return 1
    fi

    if usage_call_patiently "$FRESH_ACCESS_TOKEN"; then
        FRESH_ACCESS_TOKEN=""
        USAGE_REFRESHED=1
        return 0
    fi
    FRESH_ACCESS_TOKEN=""
    USAGE_FAILURE="the usage endpoint still answered HTTP $USAGE_HTTP_CODE with a freshly refreshed access token"
    return 1
}

QUOTA_VERDICT=""; QUOTA_REASON=""; QUOTA_5H=""; QUOTA_7D=""; QUOTA_REFRESHED=0

# Verdict is ok, over or unknown, in QUOTA_VERDICT, with QUOTA_REFRESHED saying whether
# reading it took a new token -- see the note on fetch_usage's globals for why this is not
# a printed tuple any more.
#
# `>` and not `>=`: the thresholds name the last utilisation that is still fine, so a
# default of 80 permits a run at exactly 80% and refuses 81%. The comparison is jq's
# because the endpoint reports floats and bash cannot compare them.
quota_verdict() {
    QUOTA_VERDICT=""; QUOTA_REASON=""; QUOTA_5H=""; QUOTA_7D=""; QUOTA_REFRESHED=0
    if ! fetch_usage; then
        QUOTA_VERDICT=unknown
        QUOTA_REASON="$USAGE_FAILURE"
        return 0
    fi
    QUOTA_REFRESHED="$USAGE_REFRESHED"
    local line
    line="$(jq -r --argjson m5 "$MAX_5H" --argjson m7 "$MAX_7D" '
        (.five_hour.utilization // null) as $f |
        (.seven_day.utilization // null) as $s |
        if $f == null or $s == null then
            "unknown|the usage response carried no utilisation figures||"
        elif $f > $m5 then
            "over|5-hour quota at \($f)%, over the \($m5)% ceiling|\($f)|\($s)"
        elif $s > $m7 then
            "over|7-day quota at \($s)%, over the \($m7)% ceiling|\($f)|\($s)"
        else
            "ok||\($f)|\($s)"
        end' "$USAGE_JSON" 2>/dev/null || printf 'unknown|the usage response was not JSON||')"
    rm -f "$USAGE_JSON"; USAGE_JSON=""
    IFS='|' read -r QUOTA_VERDICT QUOTA_REASON QUOTA_5H QUOTA_7D <<<"$line" || true
}

# --- preflight ---------------------------------------------------------------------------

# Checked before the run rather than diagnosed after it, because the failure this catches
# does not announce itself: a missing `claude` produces a complete page with no arc names
# on it and an exit status of 0. Every name here is invoked by bare name somewhere in the
# pipeline, so every one of them is a way for PATH to be silently wrong.
PREFLIGHT_CMDS=(claude git glab jq python3 curl flock)

preflight() {
    local missing=() c
    for c in "${PREFLIGHT_CMDS[@]}" "${PIPELINE%% *}"; do
        command -v "$c" >/dev/null 2>&1 || missing+=("$c")
    done
    [ ${#missing[@]} -eq 0 ] && return 0
    printf '%s\n' "${missing[*]}"
    return 1
}

# --- the crontab line ----------------------------------------------------------------------

# Installed as one self-identifying line rather than a file in /etc/cron.d, because this is
# a user's job with a user's environment and it belongs in a user's crontab. The marker is a
# trailing shell comment, not a cron comment line: cron hands the whole command to /bin/sh,
# which ignores everything after the `#`, and keeping it on the command line means the
# marker cannot become orphaned from the entry it names the way a comment above it can.
#
# Output goes to /dev/null and that is deliberate rather than careless. cron mails on
# output, not on exit status; this script has a log of its own and a notifier for the cases
# worth interrupting for, so anything cron captured would be a duplicate delivered by an
# MTA that may not exist.
cron_line() {
    local time="$1" hh mm self
    hh="${time%%:*}"; mm="${time##*:}"
    self="$(readlink -f "${BASH_SOURCE[0]}")"
    printf '%d %d * * * %s >/dev/null 2>&1  %s\n' \
        "$((10#$mm))" "$((10#$hh))" "$self" "$CRON_MARKER"
}

# `crontab -l` exits 1 with "no crontab for kyle" when there is none, which is not an error
# here; it is the empty case, and the difference between the two is a crontab that gets
# wiped by an install.
current_crontab() {
    crontab -l 2>/dev/null || true
}

# Shared by both installers, because "06:05" must be read as five past six and not as
# octal 5, and "breakfast" must be refused by whichever flag was typed.
validate_time() {
    local time="$1" flag="$2"
    if ! printf '%s' "$time" | grep -Eq '^[0-9]{1,2}:[0-9]{2}$'; then
        echo "arcs-refresh: $flag wants HH:MM, got '$time'" >&2
        return 2
    fi
    local hh="${time%%:*}" mm="${time##*:}"
    if [ "$((10#$hh))" -gt 23 ] || [ "$((10#$mm))" -gt 59 ]; then
        echo "arcs-refresh: '$time' is not a time of day" >&2
        return 2
    fi
}

install_cron() {
    local time="${1:-$CRON_DEFAULT_TIME}"
    validate_time "$time" --install-cron || return 2
    # Add-or-replace: every line that is not ours is copied through untouched, and exactly
    # one of ours comes out the far end however many went in.
    #
    # Materialised before `crontab -` is started rather than piped into it, because the
    # reader and the writer are the same crontab. A pipeline starts both ends at once, so
    # anything that truncates its destination early would be truncating the file the left
    # side is still reading. vixie's crontab buffers stdin first and would survive that;
    # depending on it is a bet on an implementation detail with a wiped crontab as the
    # stake.
    local new
    new="$(mktemp)"
    { current_crontab | grep -vF "$CRON_MARKER" || true; cron_line "$time"; } >"$new"
    crontab - <"$new"
    rm -f "$new"
    echo "installed:"
    cron_line "$time"
}

uninstall_cron() {
    local kept
    kept="$(current_crontab | grep -vF "$CRON_MARKER" || true)"
    printf '%s\n' "$kept" | grep -v '^$' | crontab - || true
    echo "removed any $CRON_MARKER line; $(printf '%s\n' "$kept" | grep -c '[^[:space:]]' || true) other line(s) kept"
}

# --- the systemd user timer --------------------------------------------------------------

# The schedule the crontab line used to hold, and the reason it does not any more:
# `10 7 * * *` does not fire on a laptop that is asleep at 07:10, and cron keeps no memory
# of a run it owes you. A closed lid over a weekend produced no line in refresh.log at all
# -- not a failure, an absence, which is the harder thing to notice. Persistent=true fires
# on the next wake for a run it missed, and that single property is the whole move.
#
# The units are files in systemd/ rather than a here-doc in this script because a unit is
# configuration and belongs somewhere `systemd-analyze verify` can be pointed at it. Only
# the two lines that depend on this machine -- ExecStart and OnCalendar -- are rewritten on
# the way in, so the shipped files stay readable and correct for this checkout as they are.
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
SERVICE_UNIT="work-arcs-refresh.service"
TIMER_UNIT="work-arcs-refresh.timer"

# `systemctl --user` exists on machines with no user manager running for it to talk to, so
# the question is not whether the binary is there but whether the bus answers.
have_systemd_user() {
    command -v systemctl >/dev/null 2>&1 &&
        systemctl --user show-environment >/dev/null 2>&1
}

install_timer() {
    local time="${1:-$CRON_DEFAULT_TIME}"
    validate_time "$time" --install-timer || return 2

    local tmpl="$REPO_DIR/systemd"
    if [ ! -f "$tmpl/$SERVICE_UNIT" ] || [ ! -f "$tmpl/$TIMER_UNIT" ]; then
        echo "arcs-refresh: no unit files in $tmpl" >&2
        return 2
    fi
    if ! have_systemd_user; then
        echo "arcs-refresh: no systemd user manager answering here." >&2
        echo "              --install-cron is the fallback, but read the header first:" >&2
        echo "              a crontab line does not catch up after the machine sleeps." >&2
        return 2
    fi

    local self
    self="$(readlink -f "${BASH_SOURCE[0]}")"
    mkdir -p "$UNIT_DIR"
    sed "s|^ExecStart=.*|ExecStart=$self|" "$tmpl/$SERVICE_UNIT" >"$UNIT_DIR/$SERVICE_UNIT"
    sed "s|^OnCalendar=.*|OnCalendar=$time|"  "$tmpl/$TIMER_UNIT"  >"$UNIT_DIR/$TIMER_UNIT"

    systemctl --user daemon-reload
    systemctl --user enable --now "$TIMER_UNIT"

    # Two schedulers for one job is a race dressed up as redundancy: the lock would make it
    # a coin toss over which run's snapshot baseline survives, and the loser's interval of
    # changes is what the page is for.
    if current_crontab | grep -qF "$CRON_MARKER"; then
        uninstall_cron
        echo "the crontab line is gone; the timer owns the schedule now"
    fi

    echo "installed: $UNIT_DIR/$TIMER_UNIT (OnCalendar=$time, Persistent=true)"
    systemctl --user list-timers --all --no-pager "$TIMER_UNIT" 2>/dev/null || true
}

uninstall_timer() {
    if have_systemd_user; then
        systemctl --user disable --now "$TIMER_UNIT" >/dev/null 2>&1 || true
    fi
    rm -f "$UNIT_DIR/$TIMER_UNIT" "$UNIT_DIR/$SERVICE_UNIT"
    if have_systemd_user; then
        systemctl --user daemon-reload || true
    fi
    echo "removed $TIMER_UNIT and $SERVICE_UNIT from $UNIT_DIR"
}

# The one piece of this workstream that is deliberately not installed for him. arc-record
# turns the nightly transcript archaeology into a log written as it happens, but it is a
# Stop hook, and ~/.claude/settings.json is his file to edit. So the block is printed
# rather than applied, already merged with the notification hook that is in there now.
print_hook() {
    cat <<'HOOK'
arc-record is a Stop hook and is NOT installed -- deliberately: settings.json is yours.
To turn it on, ~/.claude/settings.json "hooks" becomes:

  "Stop": [
    {"hooks": [{"type": "command", "command": "~/bin/notification/claude-stop-hook.sh", "async": true}]},
    {"hooks": [{"type": "command", "command": "~/bin/dev-workflow-tools/bin/arc-record", "async": true}]}
  ]

The first entry is what is already there. Until then work-arcs keeps reconstructing the
same facts by rescanning transcripts, which works and costs a great deal more.
HOOK
}

hook_installed() {
    jq -e '[.. | strings] | any(test("arc-record"))' \
        "$HOME/.claude/settings.json" >/dev/null 2>&1
}

# --- the run -------------------------------------------------------------------------------

# Written after a successful build so the page can say how old it is without anyone timing
# it. `published_at` is carried through rather than rewritten: this script cannot publish
# -- only a Claude session can -- so whatever last stamped it knows something this does not.
write_state() {
    local dur="$1" bytes="$2" five="$3" seven="$4" page="$5" prev='{}'
    [ -f "$STATE_FILE" ] && prev="$(cat "$STATE_FILE" 2>/dev/null || echo '{}')"
    printf '%s' "$prev" | jq \
        --argjson at "$(date +%s)" \
        --arg iso "$(date -Is)" \
        --arg page "$page" \
        --argjson bytes "$bytes" \
        --argjson dur "$dur" \
        --arg five "$five" \
        --arg seven "$seven" \
        '{published_at: (.published_at // null)}
         + {built_at: $at, built_at_iso: $iso, page: $page, bytes: $bytes,
            duration_s: $dur,
            five_hour: ($five | if . == "" then null else tonumber end),
            seven_day: ($seven | if . == "" then null else tonumber end)}' \
        >"$STATE_FILE.tmp" 2>/dev/null && mv "$STATE_FILE.tmp" "$STATE_FILE" || rm -f "$STATE_FILE.tmp"
}

do_run() {
    local force="$1"

    log "--- refresh starting (pid $$, ${PIPELINE})"

    local missing
    if ! missing="$(preflight)"; then
        log "preflight failed: not on PATH: $missing"
        log "    PATH=$PATH"
        notify "cannot run: $missing not on PATH"
        return 5
    fi

    # Three outcomes and three sentences, because the log is the only witness. The one
    # that used to be missing is the middle one: for eight days every morning read
    # "stood down: the usage endpoint could not be read", which is what a dead network
    # says too, and so nobody went looking for an expired token.
    quota_verdict
    case "$QUOTA_VERDICT" in
        ok)
            if [ "$QUOTA_REFRESHED" = 1 ]; then
                log "quota ok after refreshing the access token: 5h ${QUOTA_5H}% (max ${MAX_5H}), 7d ${QUOTA_7D}% (max ${MAX_7D})"
            else
                log "quota ok: 5h ${QUOTA_5H}% (max ${MAX_5H}), 7d ${QUOTA_7D}% (max ${MAX_7D})"
            fi ;;
        over)
            if [ "$force" = 1 ]; then
                log "quota over: $QUOTA_REASON — running anyway (--force)"
            else
                log "stood down: $QUOTA_REASON"
                notify "skipped — $QUOTA_REASON"
                return 3
            fi ;;
        *)
            if [ "$force" = 1 ] || [ "$ON_UNKNOWN" = run ]; then
                log "quota unknown: $QUOTA_REASON — running anyway"
            else
                log "stood down: $QUOTA_REASON (WORK_ARCS_REFRESH_ON_UNKNOWN=run to run regardless)"
                notify "skipped — $QUOTA_REASON"
                return 3
            fi ;;
    esac

    local out started rc=0
    out="$(mktemp)"
    started="$(date +%s)"

    # Stamped line by line as it arrives rather than in a block at the end, so the log
    # says when each stage happened and a run that hangs is visible in the timestamps.
    set +e
    $PIPELINE 2>&1 | while IFS= read -r line; do
        printf '%s  | %s\n' "$(date '+%Y-%m-%d %H:%M:%S%z')" "$line" >>"$LOG_FILE"
        printf '%s\n' "$line" >>"$out"
        [ -t 1 ] && printf '  %s\n' "$line"
    done
    rc="${PIPESTATUS[0]}"
    set -e

    local elapsed=$(( $(date +%s) - started ))

    if [ "$rc" -ne 0 ]; then
        log "FAILED after ${elapsed}s (exit $rc)"
        notify "failed after ${elapsed}s — see $LOG_FILE"
        rm -f "$out"
        return 1
    fi

    # An exit status of 0 is not the same as a good page. Every model call in the pipeline
    # is wrapped so that its failure degrades a name rather than breaking a build, which is
    # right for a person watching the output and wrong for a job nobody reads: the page
    # comes out complete, anonymous and published. This is the one string that says it
    # happened, and finding it counts as a failed run.
    if grep -q "could not run claude" "$out"; then
        local n
        n="$(grep -c "could not run claude" "$out" || true)"
        log "FAILED: the page built, but $n model call(s) could not reach claude — the"
        log "        arcs on it have no names. Treated as a failure; see $LOG_FILE"
        notify "built a page with no arc names ($n model calls failed) — see $LOG_FILE"
        rm -f "$out"
        return 1
    fi

    local page bytes=0
    page="${WORK_ARCS_PAGE:-$STATE/page.html}"
    [ -f "$page" ] && bytes="$(stat -c %s "$page")"
    write_state "$elapsed" "$bytes" "$QUOTA_5H" "$QUOTA_7D" "$page"

    log "refreshed in ${elapsed}s — $page ($bytes bytes)"
    if [ -n "${WORK_ARCS_ARTIFACT_URL:-}" ]; then
        log "publish: from a Claude Code session, \`publish $page to $WORK_ARCS_ARTIFACT_URL\`"
        log "         or just /arcs — the build is already done, so it is upload-only"
    else
        log "publish: no WORK_ARCS_ARTIFACT_URL in .env, so a publish would make a new artifact"
    fi
    hook_installed || log "note: the arc-record Stop hook is not installed — \`arcs-refresh --hook\`"

    rm -f "$out"
    return 0
}

# --- arguments -------------------------------------------------------------------------------

force=0
case "${1:-}" in
    # Every leading comment line, so the header can grow without this going stale --
    # which is what the old hard-coded line range did the first time it grew.
    -h|--help)     awk 'NR > 1 && /^#/ {sub(/^# ?/, ""); print; next} NR > 1 {exit}' "$0"; exit 0 ;;
    --hook)        print_hook; exit 0 ;;
    --install-timer)   install_timer "${2:-}"; exit $? ;;
    --uninstall-timer) uninstall_timer; exit $? ;;
    --install-cron)   install_cron "${2:-}"; exit $? ;;
    --uninstall-cron) uninstall_cron; exit $? ;;
    # The credential half of --check-quota, on its own. Worth a flag because the log line
    # it answers -- "refreshing it was refused" -- is the one a person has to act on, and
    # the question "can this mint a token right now?" should not require corrupting a
    # credentials file to ask. It prints the outcome and never the token.
    --check-refresh)
        if refresh_access_token; then
            FRESH_ACCESS_TOKEN=""
            echo "ok — the stored refresh token minted a new access token"
            exit 0
        fi
        echo "failed — token endpoint HTTP $REFRESH_HTTP_CODE${REFRESH_ERROR:+, $REFRESH_ERROR}"
        exit 4 ;;
    --check-quota)
        quota_verdict
        case "$QUOTA_VERDICT" in
            ok)   echo "ok — 5h ${QUOTA_5H}% (max ${MAX_5H}), 7d ${QUOTA_7D}% (max ${MAX_7D})$([ "$QUOTA_REFRESHED" = 1 ] && echo " (after refreshing the access token)" || true)"; exit 0 ;;
            over) echo "over — $QUOTA_REASON"; exit 3 ;;
            *)    echo "unknown — $QUOTA_REASON"; exit 4 ;;
        esac ;;
    --force)       force=1 ;;
    "")            ;;
    *)             echo "arcs-refresh: unknown argument '$1' (try --help)" >&2; exit 2 ;;
esac

# On the way out however we leave, because every exit past this point has written a line
# and the skips are the ones that repeat: a month of "another run holds the lock" would
# otherwise grow the log without any run ever reaching the trim at the end.
trap trim_log EXIT

# Non-blocking, and a held lock is reported rather than waited on. Waiting would mean two
# runs of a 40-second pipeline queued behind each other for no gain -- the second one would
# rebuild a page the first had just rebuilt -- and the interesting case is not "later" but
# "somebody is already doing this".
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    log "skipped: another arcs-refresh holds $LOCK_FILE"
    exit 4
fi

rc=0
do_run "$force" || rc=$?
exit "$rc"
