#!/usr/bin/env -S python3 -u
"""
loose-ends-page: render `loose-ends --json` as a page worth glancing at.

A ranked list in a terminal only exists while you are looking at it. This turns
the same data into a standing surface -- one page, one URL, republished in place --
so the state of your loose work is somewhere you pass by rather than somewhere you
have to remember to go and ask.

Layout is deterministic and lives here, in code, so the page looks identical every
time it is regenerated. The one part that needs judgment -- the lede, the sentence
that says which of 386 findings actually matters today -- is passed in with --lede
by whoever knows. That split is deliberate: a renderer cannot form an opinion, and
an opinion regenerated from scratch each run would never look the same twice.

Reads JSON on stdin. Writes HTML to stdout, or to --out.

  loose-ends --json --slack | loose-ends-page --lede "..." --out page.html

Pass --previous with the last run's JSON to mark findings that are new since then;
a recurring page is mostly read for what changed.
"""

import argparse
import html
import json
import sys
from datetime import datetime
from pathlib import Path

# Severity is information, not decoration: it answers "would I be upset to lose
# this?". Stashes lead because a stash is the only place work can exist with no
# ref pointing at it -- that is where a diagnosed prod bug once sat unnoticed.
CLASS_INFO = {
    "stash": (
        "Stashes",
        "Work with no branch pointing at it. The only place a fix can exist "
        "while being invisible to every git command you would normally run.",
    ),
    "unpushed": (
        "Unpushed work",
        "Commits that exist on this machine and nowhere else. A disk failure "
        "is the whole backup story.",
    ),
    "mr-quiet": (
        "Waiting on review",
        "Open, no comments, not moving. Nobody has picked these up.",
    ),
    "main-behind": ("Local main", "Behind its remote, so every new branch starts stale."),
    "dup-tip": (
        "Duplicate branches",
        "Two names on the same commit — the same work, tracked twice.",
    ),
    "session-no-branch": (
        "Sessions with no branch",
        "Substantive sessions that recorded no branch, usually because they ran "
        "from $HOME. Invisible to any search scoped to a repo.",
    ),
    "mr-unavailable": ("Not checked", "GitLab could not be reached this run."),
}

# The order the page reads in, most-likely-to-hurt first.
CLASS_ORDER = [
    "stash",
    "unpushed",
    "mr-quiet",
    "main-behind",
    "dup-tip",
    "session-no-branch",
    "mr-unavailable",
]


def severity(finding):
    """critical / warning / quiet, from what the finding actually is.

    Someone else having mentioned the work is the strongest escalation available:
    unpushed commits nobody knows about are a private risk, and the same commits
    with a Slack thread attached are somebody waiting on you.
    """
    cls = finding["class"]
    meta = finding.get("meta", {})
    slack = int(meta.get("slack") or 0)

    if slack > 0 and cls in ("unpushed", "stash", "mr-quiet"):
        return "critical"
    if cls == "stash":
        return "critical" if (int(meta.get("src") or 0) > 0 or meta.get("stranded")) else "warning"
    if cls == "unpushed":
        return "warning" if int(meta.get("sessions") or 0) > 0 else "quiet"
    if cls == "mr-quiet":
        return "warning"
    return "quiet"


def subject_and_facts(finding):
    """Split a finding into the thing it is about and the figures about it.

    The prose line from loose-ends stays available, but a page wants the branch
    name set apart from the numbers so both can be scanned in a column.
    """
    cls = finding["class"]
    m = finding.get("meta", {})
    facts = []

    if cls == "unpushed":
        subject = m.get("branch", "?")
        facts = [f"{m.get('commits', '?')} commits", f"idle {m.get('age', '?')}d"]
        if int(m.get("sessions") or 0) > 0:
            facts.append(f"{m['sessions']} session" + ("s" if m["sessions"] != "1" else ""))
        if m.get("worktree"):
            facts.append("worktree")
    elif cls == "stash":
        subject = m.get("ref", "?")
        facts = [f"on {m.get('base', '?')}", f"{m.get('age', '?')}d old"]
        if int(m.get("src") or 0) > 0:
            facts.append(f"{m['src']} source files")
        if m.get("stranded"):
            facts.append(m["stranded"])
    elif cls == "mr-quiet":
        subject = f"!{m.get('mr', '?')}"
        facts = [f"idle {m.get('age', '?')}d", m.get("title", "")]
    elif cls == "main-behind":
        subject = f"{m.get('repo', '?')}/main"
        facts = [f"{m.get('behind', '?')} commits behind origin/main"]
    elif cls == "dup-tip":
        subject = m.get("sha", "?")
        facts = [m.get("branches", "")]
    elif cls == "session-no-branch":
        subject = (m.get("session") or "?")[:8]
        facts = [f"{m.get('turns', '?')} turns", f"{m.get('age', '?')}d ago"]
    else:
        subject = m.get("repo", "?")
        facts = [finding.get("text", "")]

    return subject, [f for f in facts if f]


CSS = """
/* Neutrals carry a blue bias so they read as chosen rather than inherited, and
   sit under an indigo accent. Severity hues stay separate from the accent: the
   accent is structure and interaction, severity is state. */
:root {
  --ground:#F6F7FA; --surface:#FFFFFF; --surface-2:#F0F2F7;
  --ink:#161922; --ink-soft:#59616F; --ink-faint:#8A91A0;
  --hairline:#E2E5EC; --accent:#4453C4;
  --critical:#A93826; --warning:#9C6414; --quiet:#3F6E52;
  --critical-wash:#FBF0EE; --warning-wash:#FBF5EC; --quiet-wash:#EFF5F1;
  --shadow:0 1px 2px rgba(22,25,34,.05), 0 8px 24px -12px rgba(22,25,34,.12);
}
/* Only tokens are redefined per theme. Guarded so an explicit light choice still
   beats a dark OS, and repeated under the stamp so the toggle wins both ways. */
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --ground:#0F1218; --surface:#161A22; --surface-2:#1C212B;
    --ink:#E3E6EC; --ink-soft:#8F97A6; --ink-faint:#6B7382;
    --hairline:#262B36; --accent:#93A0F7;
    --critical:#E27B63; --warning:#DFA24C; --quiet:#7CB690;
    --critical-wash:#241A18; --warning-wash:#241E14; --quiet-wash:#16211A;
    --shadow:0 1px 2px rgba(0,0,0,.3), 0 8px 24px -12px rgba(0,0,0,.5);
  }
}
:root[data-theme="dark"] {
  --ground:#0F1218; --surface:#161A22; --surface-2:#1C212B;
  --ink:#E3E6EC; --ink-soft:#8F97A6; --ink-faint:#6B7382;
  --hairline:#262B36; --accent:#93A0F7;
  --critical:#E27B63; --warning:#DFA24C; --quiet:#7CB690;
  --critical-wash:#241A18; --warning-wash:#241E14; --quiet-wash:#16211A;
  --shadow:0 1px 2px rgba(0,0,0,.3), 0 8px 24px -12px rgba(0,0,0,.5);
}

/* Three type roles: a serif for the human voice, a sans for chrome, a mono for
   machine facts. Branch names and shas are mono data, not prose. */
:root {
  --serif: ui-serif, Charter, "Bitstream Charter", Georgia, serif;
  --sans: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
}

*,*::before,*::after { box-sizing:border-box; }
body {
  margin:0; background:var(--ground); color:var(--ink);
  font-family:var(--sans); font-size:15px; line-height:1.55;
  -webkit-font-smoothing:antialiased;
}
.page { max-width:60rem; margin:0 auto; padding:3.5rem 1.5rem 5rem; }

header.masthead { display:flex; flex-direction:column; gap:.4rem; margin-bottom:2.5rem; }
h1 {
  font-family:var(--serif); font-weight:500; font-size:clamp(1.9rem,4vw,2.6rem);
  letter-spacing:-.015em; margin:0; text-wrap:balance;
}
.stamp {
  font-family:var(--mono); font-size:.75rem; color:var(--ink-faint);
  display:flex; flex-wrap:wrap; gap:.25rem 1rem;
}

/* The lede is the whole reason the page exists, so it gets the largest serif on
   the page and a measure short enough to actually read. */
.lede {
  font-family:var(--serif); font-size:clamp(1.15rem,2.2vw,1.4rem); line-height:1.5;
  max-width:34em; margin:0 0 2.5rem; color:var(--ink); text-wrap:pretty;
}
.lede em { color:var(--accent); font-style:normal; font-weight:600; }

.tiles { display:grid; grid-template-columns:repeat(auto-fit,minmax(8.5rem,1fr));
         gap:.75rem; margin-bottom:3rem; }
.tile {
  background:var(--surface); border:1px solid var(--hairline); border-radius:3px;
  padding:.85rem .9rem; display:flex; flex-direction:column; gap:.15rem;
  border-top:2px solid var(--tile-hue,var(--hairline));
}
.tile .n {
  font-family:var(--mono); font-size:1.55rem; line-height:1.1;
  font-variant-numeric:tabular-nums; color:var(--tile-hue,var(--ink));
}
.tile .k { font-size:.7rem; text-transform:uppercase; letter-spacing:.07em; color:var(--ink-soft); }
.tile.is-critical { --tile-hue:var(--critical); }
.tile.is-warning  { --tile-hue:var(--warning); }
.tile.is-quiet    { --tile-hue:var(--quiet); }

section.group { margin-bottom:3rem; }
.group-head { display:flex; align-items:baseline; gap:.6rem; margin-bottom:.3rem; }
h2 { font-family:var(--serif); font-weight:500; font-size:1.3rem; margin:0; letter-spacing:-.01em; }
.count {
  font-family:var(--mono); font-size:.8rem; color:var(--ink-faint);
  font-variant-numeric:tabular-nums;
}
.group-note { color:var(--ink-soft); font-size:.85rem; max-width:52em; margin:0 0 1rem; }

.rows { display:flex; flex-direction:column; gap:1px; background:var(--hairline);
        border:1px solid var(--hairline); border-radius:3px; overflow:hidden; }
.row {
  background:var(--surface); display:grid;
  grid-template-columns:3px minmax(0,14rem) minmax(0,1fr) auto;
