  display:flex; flex-wrap:wrap; gap:.2rem .9rem; padding:.7rem 0;
  font-size:.78rem; color:var(--ink-soft); min-width:0;
}
.facts span { font-family:var(--mono); font-variant-numeric:tabular-nums; }
.marks { display:flex; align-items:center; gap:.4rem; padding:.7rem .9rem .7rem 0; }

.pill {
  font-family:var(--sans); font-size:.68rem; text-transform:uppercase;
  letter-spacing:.06em; padding:.15rem .45rem; border-radius:2px;
  border:1px solid currentColor; white-space:nowrap;
}
.pill.new { color:var(--accent); }
.pill.slack { color:var(--critical); text-decoration:none; }
