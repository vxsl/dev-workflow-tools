  margin-top:4rem; padding-top:1.5rem; border-top:1px solid var(--hairline);
  color:var(--ink-soft); font-size:.85rem; display:flex; flex-direction:column; gap:.8rem;
}
footer h3 { font-family:var(--serif); font-weight:500; font-size:1rem; margin:0; color:var(--ink); }
.cmds { display:flex; flex-direction:column; gap:.35rem; overflow-x:auto; }
.cmds code {
  font-family:var(--mono); font-size:.78rem; color:var(--ink);
  background:var(--surface-2); border:1px solid var(--hairline);
  padding:.25rem .45rem; border-radius:2px; white-space:pre;
}
.cmds code b { font-weight:400; color:var(--ink-faint); }

a { color:var(--accent); }
:focus-visible { outline:2px solid var(--accent); outline-offset:2px; }
.empty { font-family:var(--serif); font-size:1.25rem; color:var(--ink-soft); }
@media (prefers-reduced-motion:reduce) { * { transition:none !important; animation:none !important; } }
@media (max-width:34rem) {
  .row { grid-template-columns:3px minmax(0,1fr); }
  .facts, .marks { padding-left:.9rem; }
  .marks { padding-bottom:.8rem; }
}
"""


def esc(s):
    return html.escape(str(s), quote=True)


def render(data, lede, previous_ids):
    findings = data.get("findings", [])
    totals = data.get("totals", {})
    gen = data.get("generated", "")
    try:
        stamp = datetime.fromisoformat(gen).strftime("%a %-d %b %Y, %-I:%M %p")
    except (ValueError, TypeError):
        stamp = gen or "unknown"

    grand = sum(totals.values())
    out = []
    a = out.append

    a("<title>Loose Ends</title>")
    a(f"<style>{CSS}</style>")
    a('<div class="page">')

    a('<header class="masthead">')
    a("<h1>Loose Ends</h1>")
    a('<div class="stamp">')
    a(f"<span>{esc(stamp)}</span>")
    a(f"<span>idle &ge; {esc(data.get('threshold_days', '?'))}d</span>")
    a(f"<span>{grand} open</span>")
    if data.get("dismissed"):
        a(f"<span>{esc(data['dismissed'])} dismissed</span>")
    a("</div></header>")

    if lede:
        a(f'<p class="lede">{lede}</p>')

    if not findings:
        a('<p class="empty">Nothing outstanding. Everything you have written down is '
          "somewhere other than this laptop.</p>")
        a("</div>")
        return "\n".join(out)

    # Tiles summarise before the detail, and carry the worst severity present in
    # each class so the row of numbers is scannable on its own.
    worst = {}
    for f in findings:
        rank = {"critical": 3, "warning": 2, "quiet": 1}
        s = severity(f)
        if rank[s] > rank.get(worst.get(f["class"], "quiet"), 1):
            worst[f["class"]] = s
    a('<div class="tiles">')
    for cls in CLASS_ORDER:
        if cls not in totals:
            continue
        label = CLASS_INFO.get(cls, (cls, ""))[0]
        sev = worst.get(cls, "quiet")
        a(f'<div class="tile is-{sev}"><span class="n">{totals[cls]}</span>'
          f'<span class="k">{esc(label)}</span></div>')
    a("</div>")

    for cls in CLASS_ORDER:
        rows = [f for f in findings if f["class"] == cls]
        if not rows:
            continue
        label, note = CLASS_INFO.get(cls, (cls, ""))
        total = totals.get(cls, len(rows))

        a('<section class="group">')
        a('<div class="group-head">')
        a(f"<h2>{esc(label)}</h2>")
        a(f'<span class="count">{total}</span>')
        a("</div>")
        if note:
            a(f'<p class="group-note">{esc(note)}</p>')

        a('<div class="rows">')
        for f in rows:
            sev = severity(f)
            subject, facts = subject_and_facts(f)
            meta = f.get("meta", {})
            a(f'<div class="row is-{sev}">')
            a('<div class="stripe"></div>')
            a(f'<div class="subject">{esc(subject)}</div>')
            a('<div class="facts">'
              + "".join(f"<span>{esc(x)}</span>" for x in facts)
              + "</div>")
            a('<div class="marks">')
            if previous_ids is not None and f["id"] not in previous_ids:
                a('<span class="pill new">new</span>')
            slack = int(meta.get("slack") or 0)
            if slack > 0:
                url = meta.get("slack_url", "")
                text = f"slack &times;{slack}"
                if url:
                    a(f'<a class="pill slack" href="{esc(url)}">{text}</a>')
                else:
                    a(f'<span class="pill slack">{text}</span>')
            elif "slack" in meta:
                a('<span class="pill alone">unmentioned</span>')
            a("</div></div>")
        a("</div>")

        if total > len(rows):
            a(f'<p class="withheld">+{total - len(rows)} more not shown</p>')
        a("</section>")

    a("<footer>")
    a("<h3>Acting on this</h3>")
    a('<div class="cmds">')
    a("<code>loose-ends --all <b># everything, no caps</b></code>")
    a("<code>git stash show -p 'stash@{N}' <b># read one before dropping it</b></code>")
    a("<code>loose-ends --dismiss <b># acknowledge what is here; quiet until it changes</b></code>")
    a("</div>")
    a("<p>Dismissing is fingerprinted by content, so anything you acknowledge comes "
      "back the moment the work behind it changes.</p>")
    a("</footer>")
    a("</div>")
    return "\n".join(out)


def main():
    p = argparse.ArgumentParser(
        description="Render loose-ends --json as an HTML page.",
        epilog="loose-ends --json --slack | loose-ends-page --lede '...' --out page.html",
    )
    p.add_argument("--lede", default="",
                   help="the sentence that says what matters today; inline HTML allowed "
                        "(wrap the key phrase in <em> to accent it)")
    p.add_argument("--previous", type=Path,
                   help="last run's JSON; findings absent from it are marked new")
    p.add_argument("--out", type=Path, help="write here instead of stdout")
    args = p.parse_args()

    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError as e:
        sys.exit(f"loose-ends-page: stdin is not the JSON from `loose-ends --json`: {e}")

    previous_ids = None
    if args.previous and args.previous.exists():
        try:
            prev = json.loads(args.previous.read_text())
            previous_ids = {f["id"] for f in prev.get("findings", [])}
        except (json.JSONDecodeError, KeyError, TypeError):
            # A corrupt snapshot should cost the "new" badges, not the page.
            print("loose-ends-page: unreadable --previous, not marking new findings",
                  file=sys.stderr)

    page = render(data, args.lede, previous_ids)
    if args.out:
        args.out.write_text(page)
        print(f"✓ Wrote {args.out} ({len(page)} bytes)", file=sys.stderr)
    else:
        print(page)


if __name__ == "__main__":
    main()
