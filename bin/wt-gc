#!/usr/bin/env bash
# wt-gc: Reclaim disk from stale worktree build artifacts.
#
# Worktrees are cheap to make and never clean themselves up. Each one accretes a
# Rust target/ (5-55G) and a node_modules/ (~900M) that nothing ever reaps, so
# ~/work/repos grows without bound.
#
# An artifact directory is "stale" when its own mtime is older than --days, i.e.
# you have not built or installed there recently. That is independent of whether
# you still edit the worktree -- a target/ untouched for weeks is dead weight
# even in an active worktree.
#
# A fixed age window cannot keep up on its own: a fleet of parallel agent
# worktrees can regenerate 100G+ of target/ in a few hours, so whatever the
# window is, the disk refills. --free-target instead evicts least-recently-built
# artifacts until df reports enough free space, which self-corrects against
# whatever rate the agents happen to be running at.
#
# Usage: wt-gc [--days N | --free-target SIZE] [--apply] [--repos DIR]
#              [--artifacts "a b c"]
# Default is a dry run; pass --apply to actually delete.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$(type -P "$0" || echo "$0")")")" && pwd)"
if [ -f "$SCRIPT_DIR/../.env" ]; then
    set -a; source "$SCRIPT_DIR/../.env"; set +a
fi

DAYS="${WT_GC_DAYS:-21}"
REPOS_DIR="${WT_GC_REPOS:-$HOME/work/repos}"
ARTIFACTS="${WT_GC_ARTIFACTS:-target node_modules}"
FREE_TARGET="${WT_GC_FREE_TARGET:-}"
APPLY=0

while [ $# -gt 0 ]; do
    case "$1" in
        --days)        DAYS="${2:?--days needs a value}"; shift 2 ;;
        --free-target) FREE_TARGET="${2:?--free-target needs a value}"; shift 2 ;;
        --repos)       REPOS_DIR="${2:?--repos needs a value}"; shift 2 ;;
        --artifacts)   ARTIFACTS="${2:?--artifacts needs a value}"; shift 2 ;;
        --apply)       APPLY=1; shift ;;
        -h|--help)     sed -n '2,24p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *)             echo "✗ Unknown argument: $1" >&2; exit 1 ;;
    esac
done

if [ ! -d "$REPOS_DIR" ]; then
    echo "✗ No such repos directory: $REPOS_DIR" >&2
    exit 1
fi

cutoff=$(date -d "$DAYS days ago" +%s)

# Never reap the worktree we are standing in -- it is almost certainly in use.
current_wt=""
if current_root=$(git rev-parse --show-toplevel 2>/dev/null); then
    current_wt="$current_root"
fi

# Worktrees nest (ul.hotfix/<slug>, ul.review/<slug>), so search a few levels
# deep, but never descend into an artifact directory we may be about to delete.
find_args=()
for name in $ARTIFACTS; do
    find_args+=(-o -name "$name")
done
mapfile -t candidates < <(
    find "$REPOS_DIR" -mindepth 2 -maxdepth 5 -type d \
        \( "${find_args[@]:1}" \) -prune -print 2>/dev/null | sort
)

# A cargo build holds target/.cargo-lock open. Never delete underneath one.
build_in_progress() {
    [ -e "$1/.cargo-lock" ] || return 1
    fuser -s "$1/.cargo-lock" 2>/dev/null
}

avail_bytes() { df --output=avail -B1 "$REPOS_DIR" | tail -1; }

protected=0
eligible=()
for dir in "${candidates[@]}"; do
    mtime=$(stat -c %Y "$dir" 2>/dev/null) || continue

    if [ -n "$current_wt" ] && [[ "$dir" == "$current_wt"/* ]]; then
        protected=$((protected + 1)); continue
    fi
    if build_in_progress "$dir"; then
        echo "skipping ${dir#"$REPOS_DIR"/} -- build in progress" >&2
        protected=$((protected + 1)); continue
    fi

    eligible+=("$mtime	$dir")
done

total_bytes=0
reaped=0
REAPED_BYTES=0

reap() {
    local dir=$1 mtime=$2 bytes human verb="would remove"
    bytes=$(du -sb "$dir" 2>/dev/null | cut -f1) || bytes=0
    human=$(numfmt --to=iec --suffix=B "$bytes" 2>/dev/null || echo "${bytes}B")
    [ "$APPLY" -eq 1 ] && verb="removing"
    printf '%s %s (%s du, last built %s)\n' \
        "$verb" "${dir#"$REPOS_DIR"/}" "$human" "$(date -d "@$mtime" +%Y-%m-%d)" >&2
    [ "$APPLY" -eq 1 ] && rm -rf "$dir"
    total_bytes=$((total_bytes + bytes))
    reaped=$((reaped + 1))
    REAPED_BYTES=$bytes
}

if [ -n "$FREE_TARGET" ]; then
    want=$(numfmt --from=iec "$FREE_TARGET" 2>/dev/null) \
        || { echo "✗ Bad --free-target: $FREE_TARGET (try 120G)" >&2; exit 1; }

    # Evict least-recently-built first. Under --apply we re-read df after each
    # removal, so the stopping point reflects bytes actually returned rather
    # than du's uncompressed figures.
    simulated=$(avail_bytes)
    while IFS=$'\t' read -r mtime dir; do
        if [ "$APPLY" -eq 1 ]; then
            [ "$(avail_bytes)" -ge "$want" ] && break
        else
            [ "$simulated" -ge "$want" ] && break
        fi
        reap "$dir" "$mtime"
        simulated=$((simulated + REAPED_BYTES))
    done < <(printf '%s\n' "${eligible[@]}" | sort -n)
else
    while IFS=$'\t' read -r mtime dir; do
        [ "$mtime" -lt "$cutoff" ] || continue
        reap "$dir" "$mtime"
    done < <(printf '%s\n' "${eligible[@]}")
fi

kept=$(( ${#eligible[@]} - reaped + protected ))
total_human=$(numfmt --to=iec --suffix=B "$total_bytes" 2>/dev/null || echo "${total_bytes}B")
if [ "$APPLY" -eq 1 ]; then
    echo "✓ Removed $reaped artifact dir(s) totalling $total_human du; kept $kept" >&2
    echo "  $(numfmt --to=iec --suffix=B "$(avail_bytes)" 2>/dev/null) now free" >&2
else
    echo "✓ Would remove $reaped artifact dir(s) totalling $total_human du; kept $kept" >&2
    echo "  (dry run -- re-run with --apply to delete)" >&2
    echo "  note: du overstates on this zstd-compressed btrfs; real reclaim is smaller" >&2
fi
