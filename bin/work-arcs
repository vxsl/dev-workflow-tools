#!/usr/bin/env -S python3 -u
"""
work-arcs: group a repo's loose work into the arcs it actually belongs to.

A flat report of branches, stashes and MRs is unreadable at real scale, because the
unit is wrong. Measured in ~/work/repos/ul: 389 unmerged branches, but UB-6919 alone
owns 20 of them and UB-6918 owns another 20. Shown as 40 unrelated rows that is
noise; shown as two arcs it is two pieces of work.

So this derives the graph instead of listing the artifacts:

  root  -- a ticket key, or a shared name prefix for work that never got a ticket
  |- branch          (commits ahead, whether any remote has them, how stale)
  |  '- branch       stacked on the one above it -- real parent edges, and a branch
  |                  can sit on several, so this is a DAG rather than a tree
  |- stash           with the files in it, because `stash@{38}` alone says nothing
  |- merge request   with whether anyone has commented
  |- session         Claude sessions that touched any branch in the arc
  '- Slack thread    threads you posted in that name one of the above, and what they
                     decided -- the one edge whose evidence exists nowhere else here

Every edge here is derived, nothing is declared. The one thing that cannot be
derived is a name for work that never got a ticket: `adaptive`, `adaptive-bak`,
`adaptive-bak-bak-bak` is obviously one arc, but only reading it tells you what it
was for. Those come out as kind="prefix" with a provisional label for a session to
rename.

  work-arcs --json                 the graph
  work-arcs                        a summary, most recently touched first
  work-arcs --active 14            only arcs touched in the last 14 days
  work-arcs --json --snapshot      the graph, and leave a baseline for the next run
  work-arcs --curate               answer what it is least sure of

Two things the derivation cannot settle, and neither is a bug to be tuned out.

The first is WHICH WORK a branch belongs to: two tickets that edit the same module are
identical by file overlap however the weights are set. The model split pass reads the
commits and covers the readable part of that; what survives it needs a person. So the
doubt is published rather than hidden -- every clustered membership carries a confidence,
and answering a question either pins the membership or pries the branch out.

The second is WHETHER IT IS WORK AT ALL. Every figure here about unpublished work assumes
the work was meant to land, and in agentic development much of what accumulates locally
never was -- experiments, churn, branches a model opened and left. Counting all of it as
debt is what made the local-only numbers read inflated, and no derivation can fix it:
intent is not in git. So a second question type asks it, and only where every other
explanation has been ruled out -- cold against the arc's own rhythm, never proposed, no
sprint carrying it, no promise naming it. "Residue" leaves every commit where it is and
stops calling it debt; a commit on the work undoes the answer by itself.

Five questions of both kinds together, and both answers to each append to
curation-labels.jsonl -- which is what makes the next proposed change to the clustering
measurable instead of arguable: `arc-cluster --score-labels` replays a clustering against
every judgement already made about grouping.

Read-only by default. Runs git, glab, Jira and Slack; the two nuances are that an MR with no
cached mergeability verdict gets a recompute requested (see collect_mrs), which changes no
state anyone can see, only whether GitLab knows its own answer -- and that --snapshot writes
the run-over-run baseline that `since_last_run` is diffed against. That write is opt-in for
a reason: see write_snapshot.

The Slack side reads only conversations you yourself posted in, on your own user token, and
only where that token can see a whole thread -- see slack_threads for what it therefore
cannot read and why that is left alone rather than approximated. `--no-slack-threads` skips
it entirely.

The ledger's third leg reads Gemini meeting transcripts out of Google Drive for promises
you made out loud, which nothing else in this pipeline can see -- a room is not a channel.
It reaches Drive through the claude.ai connector on your Anthropic account rather than
through a Google credential on this machine, because there is no Google credential on this
machine; see ledger_meetings. `--no-meetings`, or WORK_ARCS_NO_MEETINGS, skips it.
"""

import argparse
import base64
import concurrent.futures as futures
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
import unicodedata
import urllib.error
import urllib.parse
import urllib.request
from collections import defaultdict
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import headless_claude  # noqa: E402
from commitments import COMMITMENT_KINDS  # noqa: E402
from statefile import load_store  # noqa: E402
from workscale import work_scale  # noqa: E402

# Built from JIRA_PROJECTS rather than a generic [A-Z]{2,4}, which matched things
# like "UTF-8" and "IPV-4" as ticket keys. Falls back to the generic form only if
# .env declares nothing.
#
# JIRA_EXTRA_PROJECTS widens this alternation and nothing else, which is the whole
# reason it exists as a second variable. JIRA_PROJECTS means "boards I file tickets
# on": jira-fzf and rr.sh interpolate it into `project IN (...)`, and
# create-jira-ticket offers each entry in its board picker. SBX is the initiative
# project -- measured, 45 non-Epic issues of which 40 are company Initiatives, and no
# sprints at all -- so putting it there would flood the daily ticket picker with
# initiatives and offer "file this bug against an initiative" as a menu item, to buy a
# key that appears in zero branches and zero commit subjects in the repo. Recognising a
# key when it turns up in prose is a strictly smaller claim than being able to file
# against it, and this is where the smaller claim lives.
def _ticket_re():
    keys = list(dict.fromkeys(
        k.strip().upper() for k in
        (os.environ.get("JIRA_PROJECTS", os.environ.get("JIRA_PROJECT", ""))
         + "," + os.environ.get("JIRA_EXTRA_PROJECTS", "")).split(",")
        if k.strip()))
    if keys:
        return re.compile(r"\b(" + "|".join(map(re.escape, keys)) + r")-(\d{2,5})\b")
    return re.compile(r"\b([A-Z]{2,4})-(\d{2,5})\b")


TICKET_RE = re.compile(r"\b([A-Z]{2,4})-(\d{2,5})\b")  # replaced after load_env()
# Branch names like `6919-review` and `6802-<initials>` carry the number but not the
# project, so they look unkeyed. They are resolved against the keys that do appear.
BARE_NUM_RE = re.compile(r"(?:^|[^0-9A-Za-z])(\d{4,5})(?:[^0-9]|$)")

SRC_SUFFIXES = (
    ".rs", ".ts", ".tsx", ".js", ".jsx", ".py", ".sql", ".go",
    ".java", ".kt", ".swift", ".c", ".cc", ".cpp", ".h", ".hpp",
)

# Names that announce a branch is a copy of another rather than work of its own. Only
# ever a tie-break: a branch is called superseded because its commits are already
# somewhere else, never because of what it is called. `UB-6938-preX` is a variant and
# `hotfix/query-telemetry-to-thor` is not, and no regex can be trusted with that call.
VARIANT_RE = re.compile(
    r"(?:^|[-/_.])(bak|backup|old|orig|copy|before[-_]?squash|pre[-_]?squash"
    r"|pre\d+|wip|tmp|temp|squash|stash)(?:[-/_.]|\d*$)", re.I)


ENV_FILE = Path(__file__).resolve().parent.parent / ".env"


def load_env():
    """Same .env contract as the rest of the repo's tools; existing vars win."""
    if not ENV_FILE.exists():
        return
    for line in ENV_FILE.read_text().splitlines():
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            key, _, value = line.partition("=")
            value = value.strip().strip('"').strip("'")
            os.environ.setdefault(key.strip(), os.path.expandvars(value))


def git(repo, *args, check=False):
    """Run git, returning stdout. Failures are normal here (missing refs, etc)."""
    r = subprocess.run(
        ["git", "-C", str(repo), *args],
        capture_output=True, text=True,
    )
    if check and r.returncode != 0:
        sys.exit(f"work-arcs: git {' '.join(args)} failed: {r.stderr.strip()}")
    return r.stdout


def lines(s):
    return [x for x in s.splitlines() if x.strip()]


DAY = 86400
# Local midnights, not UTC ones. An evening's work at UTC-7 runs past 00:00 UTC, so
# bucketing on UTC splits one sitting across two days -- which inflates "active days" and
# therefore deflates the per-day intensity that is the whole distinction between a burst
# and a trickle. Measured on this corpus: UTC buckets turn 178 (branch, day) pairs into
# 184, and every one of those six extra days is a late-night sitting counted twice --
# which is exactly the hardest work, on exactly the arcs this is trying to see. One
# offset for the whole run; DST moves it by an hour twice a year, which cannot move a day
# boundary by a day.
LOCAL_OFFSET = int(datetime.now().astimezone().utcoffset().total_seconds())


def day_no(epoch):
    """An epoch as a local day number. Only differences between these are ever used."""
    return int((int(epoch) + LOCAL_OFFSET) // DAY)


def day_str(day):
    """A day number back as YYYY-MM-DD, for anything a person reads."""
    return time.strftime("%Y-%m-%d", time.localtime(day * DAY - LOCAL_OFFSET + DAY // 2))


def days_ago(epoch):
    """How many local days back something is. The ONE age arithmetic in this file.

    There used to be two, and they disagreed on 107 of 111 arcs. `age_days` counted
    elapsed 24-hour blocks -- `(now - ts) // 86400` -- while `activity_of` bucketed the
    same instants by local midnight, so a row showed "8d ago" beside a sprint chip
    reading "sprint · 9d" about the same silence. Measured: at 05:22 local, every commit
    made after 06:00 on its day produced that mismatch, which is nearly every commit
    anyone makes. Two numbers on one row that cannot both be right is worse than either
    being wrong, because it tells the reader the page does not know.

    Midnight bucketing is the one that survives, for two reasons beyond consistency.
    First it is what a person means: work at 23:00 last night is "yesterday", and elapsed
    blocks call it "today" for another 23 hours. Second, it restores the invariant
    `activity_of` already documents -- cliff_days is measured over everything in the arc
    and age_days over its lineage alone, so cliff is asked of a superset and must come out
    <= age. Under mixed arithmetic it came out *greater* on 90-odd rows, and that
    over-claim was pointed straight at the sprint strip, which accuses you of neglect.

    Deliberately not applied to `late` in close_commitments: that is the interval between
    two named instants ("!10481 merged 2d after you promised"), not the age of a thing
    against now, and bucketing it would report a promise kept two hours later as a day.
    """
    return day_no(time.time()) - day_no(epoch)


def session_index(projects_dir):
    """branch -> {"paths": set, "last": epoch, "entries": int, "days": {...}}, from one
    rg pass over every project.

    Sessions run from $HOME record gitBranch=HEAD and land in a project dir named
    after $HOME rather than the repo, so scanning every dir is the only way to see
    them. Transcripts reach 18M; this never parses one, it only scans for two fields.

    Recency comes from the timestamp on the *entry* the branch appears in, not the
    file's mtime. A session that touched a branch once in its first hour and then ran
    all day would otherwise make that branch look like today's work. `timestamp`
    always precedes `gitBranch` on a line, so one pattern captures the pair; the 20k
    gap covers 99% of entries, and since only the maximum per branch matters, the
    remainder cannot change the answer.

    `days` buckets the same entries by the day they happened on, which is what turns a
    total into a shape: `entries` alone cannot tell 19 sessions over three days from 19
    sessions over three weeks, and that difference is the whole of forgotten-work
    detection. It costs nothing extra to collect -- the timestamp is already parsed for
    recency, so this is a second use of a number this loop had in hand. Nor does it cost
    memory: measured over the real corpus, 76,060 branch-tagged entries collapse to 178
    (branch, day) pairs and 341 (branch, day, session) triples, because a branch is
    worked on a handful of days and hammered on each of them.
    """
    idx = defaultdict(lambda: {"paths": set(), "last": 0, "entries": 0,
                               "days": defaultdict(lambda: {"entries": 0,
                                                            "paths": set()})})
    if not projects_dir.is_dir() or not shutil.which("rg"):
        return idx
    r = subprocess.run(
        ["rg", "-oN", "--with-filename",
         r'"timestamp":"([^"]*)".{0,20000}?"gitBranch":"([^"]*)"',
         "-r", "$1\t$2", str(projects_dir)],
        capture_output=True, text=True,
    )
    for line in r.stdout.splitlines():
        path, _, rest = line.partition(":")
        stamp, _, branch = rest.partition("\t")
        if not branch or branch == "HEAD":
            continue
        entry = idx[branch]
        entry["paths"].add(path)
        # How many entries mention the branch, not just whether one did. A branch
        # named three times in a sweep is incidental; one named four hundred times
        # is what the session was actually about.
        entry["entries"] += 1
        try:
            epoch = int(datetime.fromisoformat(stamp.replace("Z", "+00:00")).timestamp())
        except ValueError:
            continue
        if epoch > entry["last"]:
            entry["last"] = epoch
        bucket = entry["days"][day_no(epoch)]
        bucket["entries"] += 1
        bucket["paths"].add(path)
    return idx


def collect_branches(repo, main_ref):
    """Every unmerged local branch with the facts that decide its state."""
    fmt = "%(refname:short)\t%(objectname)\t%(committerdate:unix)"
    out = git(repo, "for-each-ref", "--no-merged", main_ref, f"--format={fmt}", "refs/heads")
    branches = {}
    for line in lines(out):
        parts = line.split("\t")
        if len(parts) != 3:
            continue
        name, sha, ts = parts
        branches[name] = {
            "name": name,
            "sha": sha[:9],
            "committed": int(ts),
            "age_days": days_ago(ts),
        }

    worktrees = set()
    for line in lines(git(repo, "worktree", "list", "--porcelain")):
        if line.startswith("branch refs/heads/"):
            worktrees.add(line[len("branch refs/heads/"):])

    for name, b in branches.items():
        ahead = git(repo, "rev-list", "--count", f"{main_ref}..{name}").strip()
        b["commits_ahead"] = int(ahead) if ahead.isdigit() else 0
        unpushed = git(repo, "rev-list", "--count", name, "--not", "--remotes").strip()
        b["unpushed"] = int(unpushed) if unpushed.isdigit() else 0
        b["pushed"] = b["unpushed"] == 0
        b["worktree"] = name in worktrees
        # Parents = branches contained in this one that still have unmerged work.
        # Both filters matter: --merged alone returns every long-merged branch whose
        # tip sits in main's history, which invents a parent edge for everything.
        parents = lines(git(
            repo, "for-each-ref", "--merged", name, "--no-merged", main_ref,
            "--format=%(refname:short)", "refs/heads",
        ))
        b["parents"] = [p for p in parents if p != name]
        # What the branch's commits say they did, and when each was made. Carried here
        # rather than fetched per arc because it is what tells a superseded copy from live
        # work, and every consumer downstream -- the duplicate pass, the split prompt, the
        # brief -- wants the same list. 394 branches cost ~1.1s, once.
        #
        # The date and the sha ride along on the same call, so the activity series costs no
        # git invocation of its own. The depth goes to 200 while `subjects` stays capped at
        # 20, because the two want opposite things: mark_duplicates compares whole subject
        # sets and only trusts its containment test under 20, whereas an activity series
        # built from a truncated log lies in the worst direction -- it keeps the recent,
        # dense days and drops the sparse early ones, which shrinks the arc's apparent
        # rhythm and makes every silence look longer against it. Measured: 73 of 405
        # branches carry more than 20 commits and the deepest carries 94, so 200 clears the
        # corpus with room; measured again, the whole for-each-ref sweep costs 1.14s at -20
        # and 1.28s at -200.
        b["subjects"], b["commits"] = [], []
        for line in lines(git(repo, "log", "--format=%ct%x09%h%x09%s", "-200",
                              f"{main_ref}..{name}")):
            when, _, rest = line.partition("\t")
            sha, _, subject = rest.partition("\t")
            # An empty subject stays dropped, which is what `lines()` did back when the
            # format was %s alone and the whole line went blank. It matters: mark_duplicates
            # tests subject-set containment, and a branch whose only subject were "" would
            # be contained in every set and so declared a copy of whatever outranked it.
            if subject.strip():
                b["subjects"].append(subject)
            if when.isdigit():
                b["commits"].append({"at": int(when), "sha": sha})
        b["subjects"] = b["subjects"][:20]
    return branches


def unpushed_authored(repo, names):
    """The author date of every commit an arc has on no remote, counted once each.

    Summing per branch double-counts every stack: `dove-boot-churn-backup` is an ancestor
    of `dove-boot-churn`, so its 32 unpushed commits ARE 32 of that branch's, and adding
    them made one arc claim 130 where the truth is 98. Union first, then count -- which is
    what the revision walk does natively given every tip at once.

    Dates rather than a count, because a count of commits is not a measure of work. In an
    afternoon of agentic development one arc takes 50 commits and a backup branch doubles
    them; the days those commits were authored on is the same afternoon either way. Every
    caller that wants the count still gets it as the length of this list, so the walk is
    the one it always was -- `--format` costs nothing that `--count` did not.
    """
    names = [n for n in names if not n.startswith("-")]
    if not names:
        return []
    out = git(repo, "log", "--format=%ad", "--date=short", *names, "--not", "--remotes")
    return [ln.strip() for ln in out.splitlines() if ln.strip()]


def distinct_unpushed(repo, names):
    """How many commits an arc actually has on no remote, counted once each."""
    return len(unpushed_authored(repo, names))


def landed_as_squash(repo, branches, main_ref, depth=None):
    """Branches whose whole delta is already sitting on main as one squashed commit.

    The test the other two could not do. `git cherry` compares patch-ids commit by commit,
    so a squash defeats it by construction: many commits become one, and none of the
    originals matches. Every merge request in this project squashes, which made the gap
    systematic rather than occasional -- Kyle kept finding finished work on the page and was
    right to, even where the two examples he named turned out to be live.

    A squash commit's patch is exactly the branch's combined delta, so index main's recent
    patch-ids once and look each branch's delta up in it. Validated with controls: it finds
    `geo_filter_collection` (!10367) and `at-timezone-accept-zoned-columns` (!10416), both
    known-landed and both invisible to every earlier check, and across 394 branches it flags
    76 -- while leaving the branches confirmed live untouched.

    Cheaper as well as stronger: one pass over main plus one diff per branch is ~5s for the
    whole repo, against ~10s for a per-commit cherry sweep that had to be bounded to 25
    commits and skipped 58 branches.

    The index depth is the limit worth knowing about: work that landed longer ago than this
    many commits of main cannot be recognised, so the depth is reported rather than implied.
    """
    depth = depth or int(os.environ.get("WORK_ARCS_MAIN_DEPTH", "1500"))
    log = subprocess.run(
        ["git", "-C", str(repo), "log", "--patch", "--no-merges", f"-{depth}", main_ref],
        capture_output=True, text=True)
    ids = subprocess.run(["git", "patch-id", "--stable"], input=log.stdout,
                         capture_output=True, text=True)
    on_main = {ln.split()[0] for ln in ids.stdout.splitlines() if ln.strip()}
    if not on_main:
        return {}, depth

    def delta_id(name):
        d = git(repo, "diff", f"{main_ref}...{name}")
        if not d:
            return name, None
        r = subprocess.run(["git", "patch-id", "--stable"], input=d,
                           capture_output=True, text=True)
        line = r.stdout.split("\n", 1)[0]
        return name, (line.split()[0] if line.strip() else None)

    hit = {}
    with futures.ThreadPoolExecutor(max_workers=8) as pool:
        for name, pid in pool.map(delta_id, branches):
            if pid and pid in on_main:
                hit[name] = pid
    return hit, depth


def already_upstream(repo, branches, main_ref):
    """Branches whose every commit is already in main by patch equivalence.

    The third and last way work lands without the branch showing it. Matching MR source
    branches catches the squash-merge case; supersession catches a copy of a branch that
    landed. Neither can see !10367, which merged from `UL-1738` -- a branch that no longer
    exists on this laptop -- while the local `geo_filter_collection` still holds the same
    change. There is no name to match and no sibling to be a copy of.

    `git cherry` answers it directly: it compares patch-ids against upstream and marks a
    commit `-` when an equivalent change is already there. Measured across all 394 branches
    it flags `geo_filter_collection` 1-of-1 and nothing else, so it is specific as well as
    the only thing that could have known.
    """
    def one(name):
        out = git(repo, "cherry", main_ref, name)
        marks = [ln[:1] for ln in out.splitlines() if ln[:1] in "+-"]
        return name, bool(marks) and all(m == "-" for m in marks), len(marks)

    landed = {}
    with futures.ThreadPoolExecutor(max_workers=8) as pool:
        for name, all_up, n in pool.map(one, branches):
            if all_up:
                landed[name] = n
    return landed


def patch_ids(repo, branch, main_ref, limit=20):
    """The content-identity of each commit, independent of its sha.

    Two branches can carry byte-identical commit subjects over different changes -- a
    cherry-pick that was then amended reads exactly like its original. Subjects find the
    candidate pair; this is what says whether the copy is truly redundant or whether it
    holds a version of the change that the other branch does not.
    """
    out = git(repo, "log", "--patch", f"-{limit}", f"{main_ref}..{branch}")
    if not out:
        return set()
    r = subprocess.run(["git", "patch-id", "--stable"],
                       input=out, capture_output=True, text=True)
    return {line.split()[0] for line in r.stdout.splitlines() if line.strip()}


def collect_stashes(repo):
    """Stashes with their contents. The ref alone is useless; the files are the point."""
    out = git(repo, "stash", "list", "--format=%gd\t%H\t%ct\t%gs")
    stashes = []
    for line in lines(out):
        parts = line.split("\t")
        if len(parts) != 4:
            continue
        ref, sha, ts, subject = parts
        m = re.match(r"^(?:WIP on|On) ([^:]+):", subject)
        base = m.group(1) if m else ""
        files = lines(git(repo, "stash", "show", "--name-only", sha))
        stashes.append({
            "ref": ref,
            "sha": sha[:9],
            "base": base,
            "age_days": days_ago(ts),
            "files": files[:8],
            "file_count": len(files),
            "src_count": sum(1 for f in files if f.endswith(SRC_SUFFIXES)),
        })
    return stashes


def project_url(repo, mrs):
    """The project's web root, so commits and branches can be linked.

    Taken off an MR's own URL where there is one -- it is already fetched, and it is the
    authority on where this project lives. The remote is the fallback and needs unpicking:
    `git@host:group/proj.git` is not a URL.
    """
    for m in mrs:
        url = m.get("url") or ""
        if "/-/merge_requests/" in url:
            return url.split("/-/merge_requests/")[0]
    remote = git(repo, "remote", "get-url", "origin").strip()
    if not remote:
        return ""
    remote = re.sub(r"\.git$", "", remote)
    m = re.match(r"^(?:ssh://)?git@([^:/]+)[:/](.+)$", remote)
    if m:
        return f"https://{m.group(1)}/{m.group(2)}"
    return remote if remote.startswith("http") else ""


def glab(repo, path, timeout=40):
    """One GitLab call, returning parsed JSON or None. Failures are survivable here."""
    try:
        r = subprocess.run(["glab", "api", path], capture_output=True, text=True,
                           cwd=str(repo), timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return None
    if r.returncode != 0 or not r.stdout.strip():
        return None
    try:
        return json.loads(r.stdout)
    except json.JSONDecodeError:
        return None


def gitlab_me(repo, _cache={}):
    """Your GitLab username, so "who spoke last" is answerable."""
    if "u" not in _cache:
        me = glab(repo, "user") or {}
        _cache["u"] = me.get("username") or ""
    return _cache["u"]


def unresolved_threads(repo, iid, me=""):
    """Review threads on your own MR that nobody has resolved.

    Unresolved is not the same as unanswered, and calling them the same was a wrong
    reminder of the worst kind -- it reported four of a reviewer's questions on !10398 as
    waiting on you when you had replied to every one. GitLab's `resolved` flag flips only
    when somebody clicks Resolve, and nothing on this project forces that. All four
    threads read reviewer → author → reviewer → author.

    So each thread also records who spoke last. If it was you, the thread is answered and
    merely unresolved, which needs nothing from you beyond perhaps a click. If it was them,
    you owe a reply. Those are different obligations and the page must not merge them.

    `blocking_discussions_resolved` is the field that looks like it answers this and it
    does not: on !10398 it reads True while four reviewer threads sit unresolved, because
    this project does not require resolution to merge. It reports mergeability, not whether
    anyone is waiting on you.

    So the threads have to be read. Only the first note of each is kept, quoted, because
    anything claiming you owe someone an answer has to show what they asked.
    """
    threads = glab(repo, f"projects/:id/merge_requests/{iid}/discussions?per_page=100")
    open_ = []
    for t in threads or []:
        notes = [n for n in (t.get("notes") or []) if n.get("resolvable")]
        if not notes or all(n.get("resolved") for n in notes):
            continue
        first = notes[0]
        body = _clean_note(first.get("body"))
        last = notes[-1]
        last_by = (last.get("author") or {}).get("username", "?")
        open_.append({
            "author": (first.get("author") or {}).get("username", "?"),
            "quote": body,
            "notes": len(notes),
            "at": (first.get("created_at") or "")[:10],
            "last_by": last_by,
            "last_at": (last.get("created_at") or "")[:10],
            "answered": bool(me) and last_by == me,
        })
    return open_


def branch_mr_states(repo, pages=8):
    """branch -> the fate of the MR that was opened from it, whatever state it ended in.

    Without this the tool cannot tell finished work from live work, and it was not telling
    them apart. `for-each-ref --no-merged origin/main` is an ancestry test, and every MR in
    this project squash-merges: the squash lands one new commit on main and the branch's own
    commits are never in main's history, so a fully-merged branch stays "unmerged" forever.
    `collect_mrs` asked only for `state=opened`, so nothing downstream could see it either.

    Measured: of 183 branches on the page, 37 had a merged MR and 8 a closed one, and 9
    whole arcs consisted of nothing else -- finished work rendered as live. The page told
    you to open a merge request for UL-1835, which had merged as !10449.

    One paginated sweep of every MR he has ever opened (500 of them, ~2s) answers it
    outright, which is cheaper and far more certain than inferring it from the graph.
    """
    out = {}
    for page in range(1, pages + 1):
        batch = glab(repo, "projects/:id/merge_requests?scope=created_by_me&state=all"
                           f"&per_page=100&page={page}")
        if not batch:
            break
        for m in batch:
            branch, state = m.get("source_branch"), m.get("state")
            if not branch or state not in ("merged", "closed"):
                continue
            prev = out.get(branch)
            # A branch can carry several MRs over its life -- reopened, retargeted,
            # superseded. Merged beats closed: if any attempt landed, the work landed.
            if prev is None or (prev["state"] == "closed" and state == "merged"):
                settled = m.get("merged_at") or m.get("closed_at") or ""
                out[branch] = {"iid": m.get("iid"), "state": state,
                               "at": settled[:10],
                               # The same instant undivided, because one consumer needs
                               # to order it against another event rather than print it.
                               # close_commitments asks whether the merge came after a
                               # promise, and at day resolution a promise made in the
                               # morning and kept that afternoon is unorderable -- which
                               # would have to be resolved as "no evidence", losing the
                               # cleanest fulfilment there is.
                               "at_ts": settled,
                               "url": m.get("web_url", "")}
    return out


def branch_pipelines(repo):
    """Latest pipeline per ref, from one sweep of the project's recent pipelines.

    Cheap and partial by design. The window covers about a day and a half, so it finds a
    failure on a branch you were just on -- `UL-1774` failed here with no MR to hang it
    off -- and says nothing about older refs. MR pipelines are fetched per MR instead,
    because those matter whatever their age.
    """
    pipes = glab(repo, "projects/:id/pipelines?per_page=100&order_by=updated_at&sort=desc")
    by_ref = {}
    for p in pipes or []:
        ref = p.get("ref") or ""
        if ref.startswith("refs/"):
            continue
        by_ref.setdefault(ref, {"status": p.get("status", ""),
                                "url": p.get("web_url", ""),
                                "at": (p.get("updated_at") or "")[:10]})
    return by_ref


REVIEW_REQ_RE = re.compile(r"^requested review from", re.I)


def _clean_note(body):
    """A note's text fit to quote. An inline attachment is most of a note's characters
    and none of its meaning: one reviewer's question spent 90 of its first 180 characters
    on `![image](/uploads/bc04.../image.png){width=200...}`, which pushed the actual
    question out of the excerpt. The quote has to carry what was asked."""
    body = re.sub(r"!?\[[^\]]*\]\([^)]*\)(\{[^}]*\})?", " ", body or "")
    body = re.sub(r"</?[a-z][^>]*>", " ", body)
    body = " ".join(body.split())
    return body[:180] + ("…" if len(body) > 180 else "")


def _mr_notes(repo, iid):
    """The notes on one MR, or None where GitLab would not say.

    The `or []` this used to end with fabricated ledger rows. ledger_they_owe reads an
    empty note list as "nobody has said a word", which IS the review-silence claim, so one
    failed glab call invented a row accusing five reviewers of ignoring a merge request
    they had already discussed. None is the honest answer and the caller drops the MR.
    """
    return glab(repo, f"projects/:id/merge_requests/{iid}/notes?per_page=100&sort=asc")


def _approved_by(repo, iid):
    """Who has approved, or None where GitLab would not say. See _mr_notes for why None.

    Same fabrication by a second door: an unreadable approvals call read as "nobody has
    approved", which is half of what puts a review-owed row on the ledger.
    """
    a = glab(repo, f"projects/:id/merge_requests/{iid}/approvals")
    if a is None or not isinstance(a, dict):
        return None
    return [(x.get("user") or {}).get("username", "") for x in a.get("approved_by") or []]


def _asked_at(notes, who=None):
    """When review was last requested, from the system note GitLab writes at that moment.

    The MR's `updated_at` is not a substitute: your own push updates it, so it answers
    "when did anything happen" when the question is "how long have they had it". The
    request writes its own note -- "requested review from @a, @b and @c" -- and the last
    one is the clock's start, because a re-request after changes honestly restarts it.
    With `who`, only requests naming that person count.
    """
    asked = ""
    for n in notes:
        if not n.get("system") or not REVIEW_REQ_RE.match(n.get("body") or ""):
            continue
        if who and not re.search(rf"@{re.escape(who)}\b", n.get("body") or ""):
            continue
        asked = (n.get("created_at") or "")[:10]
    return asked


def _days_since(day):
    # Through `days_ago` like every other age, even though `_day_epoch` returns a local
    # midnight and the old `(now - epoch) // 86400` therefore already agreed with it to the
    # day. Agreeing by arithmetic accident is how the age_days/cliff_days split survived
    # two releases: the formulas were equivalent on the inputs anyone tested, until one
    # input arrived mid-afternoon instead of at midnight. One formula, no accidents.
    #
    # Clamped: GitLab stamps in UTC, so tonight's activity carries tomorrow's date and
    # an unclamped clock read "-1d", which is a strange thing to owe anybody.
    epoch = _day_epoch(day)
    return max(0, days_ago(epoch)) if epoch else None


def ledger_they_owe(repo, mrs, me):
    """Review you asked for and never got: the direction nobody's tooling reports.

    A reviewer's silence is invisible by construction -- nothing fails, nothing turns
    red, the MR just sits there aging while you believe it is being read. Per MR rather
    than per reviewer, because reviewers here arrive five at a time from a default list:
    "you asked brian, vadym, ajit, Matt and ella 7 days ago" five times over is noise,
    and the operative fact is that NOBODY has responded.

    Responded means: approved, or said anything a human says (a non-system note). Either
    one, by anyone who is not you, and the MR is attended -- the threads machinery takes
    over from there. Only total silence lands in the ledger.
    """
    asked_for = [m for m in mrs if m.get("reviewers") and not m.get("draft")]
    UNKNOWN = object()          # this MR could not be read, as distinct from "attended"

    def one(m):
        # Notes first, approvals only when the notes leave it open: a note already
        # proves the MR is attended, and each skipped call is real wall clock here.
        notes = _mr_notes(repo, m["iid"])
        if notes is None:
            return UNKNOWN
        spoke = {(n.get("author") or {}).get("username", "")
                 for n in notes if not n.get("system")} - {me, ""}
        if spoke:
            return None
        approvers = _approved_by(repo, m["iid"])
        if approvers is None:
            return UNKNOWN
        if set(approvers) - {me, ""}:
            return None
        asked = _asked_at(notes)
        entry = {"kind": "review-silence", "ref": f"!{m['iid']}",
                 "title": m.get("title", ""), "who": m.get("reviewers", []),
                 "url": m.get("url", "")}
        if asked:
            entry["asked"] = asked
        else:
            # Reviewers set at creation write no request note; the MR's birth is then
            # the honest clock, and it is labelled as the proxy it is.
            entry["asked"] = (m.get("updated") or "")[:10]
            entry["asked_is_proxy"] = True
        entry["days"] = _days_since(entry["asked"])
        return entry

    with futures.ThreadPoolExecutor(max_workers=16) as pool:
        seen = list(pool.map(one, asked_for))
    missed = sum(1 for e in seen if e is UNKNOWN)
    if missed:
        print(f"  ledger: GitLab would not answer for {missed} merge request(s) — they "
              "are left off rather than guessed at, so nothing is pruned on their "
              "absence", file=sys.stderr)
    return [e for e in seen if e and e is not UNKNOWN], not missed


def ledger_you_owe(repo, me):
    """Their merge requests waiting on something of yours, and how long they have waited.

    Two ways to owe on someone else's MR, and the first version saw only one. A review
    you never gave is the obvious one. The subtler one is a conversation you started and
    walked away from: you comment, the author answers, and "I spoke" is exactly the
    wrong test for done -- speaking is what created the debt. So having spoken routes
    the MR into a thread check rather than out of the queue: an unresolved discussion
    you took part in whose last human word is theirs is a reply you owe, quoted.

    A review request where somebody else already approved is dropped but counted: this
    project needs one approval, so yours is no longer what stands between the author and
    a merge. Bounded to MRs that name you a reviewer -- a thread you opened on an MR you
    were never a reviewer of is invisible here, and saying so beats sweeping every open
    MR in the project for your name.
    """
    raw = glab(repo, "projects/:id/merge_requests?state=opened&per_page=100"
                     f"&reviewer_username={urllib.parse.quote(me, safe='')}")
    if raw is None or not isinstance(raw, list):
        # No queue means no rows on this side at all, and reporting that as an empty
        # queue would let a prune delete every acknowledgement on it.
        print("  ledger: GitLab would not list the merge requests awaiting you — that "
              "side of the ledger is absent this run, not empty", file=sys.stderr)
        return [], 0, False
    queue = [m for m in raw
             if not (m.get("draft") or m.get("work_in_progress"))
             and (m.get("author") or {}).get("username") != me]
    out, covered = [], 0
    UNKNOWN = object()          # this MR could not be read, as distinct from "attended"

    def one(m):
        iid = m.get("iid")
        # Discussions rather than flat notes: same single call, but it keeps the thread
        # structure, which is what "whose turn is it in this conversation" needs.
        discussions = glab(repo,
                           f"projects/:id/merge_requests/{iid}/discussions?per_page=100")
        if discussions is None or not isinstance(discussions, list):
            return UNKNOWN
        notes = [n for d in discussions for n in (d.get("notes") or [])]
        i_spoke = any((n.get("author") or {}).get("username") == me
                      for n in notes if not n.get("system"))
        base = {"ref": f"!{iid}", "title": m.get("title", ""),
                "url": m.get("web_url", "")}
        if not i_spoke:
            approvers = _approved_by(repo, iid)
            if approvers is None:
                return UNKNOWN
            if approvers:
                return None
            asked = _asked_at(notes, who=me) or (m.get("created_at") or "")[:10]
            return {**base, "kind": "review-owed",
                    "who": (m.get("author") or {}).get("username", "?"),
                    "asked": asked, "days": _days_since(asked)}
        for d in discussions:
            ns = [n for n in (d.get("notes") or []) if not n.get("system")]
            if not ns or not any((n.get("author") or {}).get("username") == me
                                 for n in ns):
                continue
            resolvable = [n for n in ns if n.get("resolvable")]
            if resolvable and all(n.get("resolved") for n in resolvable):
                continue
            last = ns[-1]
            who = (last.get("author") or {}).get("username", "?")
            if who == me:
                continue
            at = (last.get("created_at") or "")[:10]
            # One entry per MR, not per thread, same as the demands: whose turn it is
            # is the fact; the quote is its evidence.
            return {**base, "kind": "reply-owed", "who": who,
                    "asked": at, "days": _days_since(at),
                    "quote": _clean_note(last.get("body"))}
        return None

    missed = 0
    with futures.ThreadPoolExecutor(max_workers=16) as pool:
        for entry in pool.map(one, queue):
            if entry is UNKNOWN:
                missed += 1
            elif entry:
                out.append(entry)
            else:
                # "Covered" is a claim -- somebody approved, or you already spoke -- so an
                # MR that could not be read must not land here either. It would inflate the
                # "+N review requests already handled" count with requests nobody handled.
                covered += 1
    if missed:
        print(f"  ledger: GitLab would not discuss {missed} merge request(s) awaiting "
              "you — left off rather than guessed at, and nothing is pruned on their "
              "absence", file=sys.stderr)
    return out, covered, not missed


def ledger_jira_stalled(days_min=None):
    """Tickets you filed that now sit with someone else, and how long they have sat.

    The todo.md entries this replaces were `blocked by neville` and `waiting on Logan`
    -- social debts recorded nowhere on the machine. This is the derivable core of them:
    reporter is you, assignee is not, still open, and nothing has happened for a while.
    The threshold exists because a ticket somebody touched this week is moving, not owed.
    """
    days_min = days_min or int(os.environ.get("WORK_ARCS_STALL_DAYS", "7"))
    domain = os.environ.get("JIRA_DOMAIN")
    email = os.environ.get("JIRA_EMAIL")
    token = os.environ.get("JIRA_API_TOKEN")
    if not (domain and email and token):
        # Not configured is a complete answer: there are no Jira rows and there never
        # were, so nothing can be missing. Contrast the failures below.
        return [], True
    jql = ("reporter = currentUser() AND assignee != currentUser() AND "
           "assignee is not EMPTY AND statusCategory != Done ORDER BY updated ASC")
    url = (f"https://{domain}/rest/api/3/search/jql?jql=" + urllib.parse.quote(jql)
           + "&fields=key,summary,status,assignee,updated&maxResults=50")
    req = urllib.request.Request(url, headers={"Accept": "application/json"})
    auth = base64.b64encode(f"{email}:{token}".encode()).decode()
    req.add_header("Authorization", f"Basic {auth}")
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            raw = json.load(r)
    except (urllib.error.URLError, json.JSONDecodeError, TimeoutError, OSError):
        print("  ledger: Jira would not answer for the tickets you filed — that side of "
              "the ledger is absent this run, not empty", file=sys.stderr)
        return [], False
    if not isinstance(raw, dict):
        # Same shape trap as the state files: a valid JSON list here used to reach
        # raw.get() and raise AttributeError. See lib/statefile.py.
        print("  ledger: Jira answered with something other than a search result — "
              "that side of the ledger is absent this run", file=sys.stderr)
        return [], False
    out = []
    for i in raw.get("issues", []):
        f = i.get("fields", {})
        updated = (f.get("updated") or "")[:10]
        days = _days_since(updated)
        if days is None or days < days_min:
            continue
        out.append({"kind": "ticket-stalled", "ref": i.get("key", ""),
                    "title": " ".join((f.get("summary") or "").split()),
                    "who": (f.get("assignee") or {}).get("displayName", "?"),
                    "status": (f.get("status") or {}).get("name", ""),
                    "asked": updated, "days": days,
                    "url": f"https://{domain}/browse/{i.get('key','')}"})
    return out, True


def _slack_raw(method, **params):
    """One Slack Web API call, and its whole answer whether or not Slack liked the call.

    Only for callers that have to tell Slack's refusals apart, which so far means one:
    `missing_scope` on a conversation is a permanent wall -- this token will never read a
    DM's history and no amount of retrying changes that -- while a timeout or a 429 is an
    outage. The same absence means "there is nothing here to see" in the first case and
    "nobody looked" in the second, and slack_threads decides whether an acknowledgement may
    be pruned on exactly that difference, so it cannot be collapsed into the None that
    `_slack` collapses it into.
    """
    token = os.environ.get("SLACK_USER_TOKEN")
    if not token:
        return None
    url = f"https://slack.com/api/{method}?" + urllib.parse.urlencode(params)
    req = urllib.request.Request(url, headers={"Authorization": f"Bearer {token}"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.load(r)
    except (urllib.error.URLError, json.JSONDecodeError, TimeoutError, OSError):
        return None


def _slack(method, **params):
    """One Slack Web API call on the user token, or None. Same contract as glab()."""
    d = _slack_raw(method, **params)
    return d if d and d.get("ok") else None


SLACK_PEOPLE = (Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
                / "work-arcs" / "slack-people.json")

# How long a resolved name and face are trusted. Neither moves often, and a users.info per
# person per morning buys nothing; a month is short enough that somebody who renamed
# themselves is not misquoted under the old name for a year.
PEOPLE_TTL = 30 * 86400

# Smallest first. Slack offers a 512px original and the page draws an 18px chip, and every
# byte of it is inlined -- see _avatar for why there is no third option.
AVATAR_FIELDS = ("image_24", "image_32", "image_48")
AVATAR_MAX = 24_000

# Resolved people, id -> entry, for this process. A lookup table and not state: it only ever
# gains entries, an id it does not hold renders as itself, and nothing downstream behaves
# differently for having consulted it. That is what lets `_slack_text` read it directly
# rather than every one of its eight callers threading a directory through.
_PEOPLE = {}


def _avatar(profile):
    """A Slack avatar as an inline data URI, or "" if that cannot be had cheaply.

    Inline because the page is a Claude Code artifact and its CSP refuses every external
    host: an avatar served from avatars.slack-edge.com is not a slow avatar, it is no
    avatar. The smallest size Slack offers is asked for and anything over AVATAR_MAX is
    dropped rather than embedded -- twenty faces are worth ~60KB on a 240KB page, and a
    workspace where someone uploaded a 2MB PNG must not quietly triple it.
    """
    for f in AVATAR_FIELDS:
        url = profile.get(f)
        if not url:
            continue
        try:
            with urllib.request.urlopen(url, timeout=15) as r:
                raw = r.read(AVATAR_MAX + 1)
                mime = (r.headers.get("Content-Type") or "").split(";")[0].strip()
        except (urllib.error.URLError, TimeoutError, OSError, ValueError):
            continue
        if not raw or len(raw) > AVATAR_MAX or not mime.startswith("image/"):
            continue
        return f"data:{mime};base64," + base64.b64encode(raw).decode()
    return ""


def _one_person(uid):
    d = _slack("users.info", user=uid)
    u = (d or {}).get("user") or {}
    if not u:
        return None
    p = u.get("profile") or {}
    name = (p.get("display_name") or p.get("real_name") or u.get("real_name")
            or u.get("name") or "").strip()
    return {"at": int(time.time()), "name": name, "avatar": _avatar(p),
            "bot": bool(u.get("is_bot"))}


def _learn_people(ids):
    """Resolve Slack user ids to a name and a face, cached across runs.

    conversations.replies names a message's author `U0A5LKV7E0K` and nothing else, and a
    mention inside the text arrives the same way -- so every quote the thread lens printed
    was attributed to a machine identifier, or to nobody. search.messages happens to carry
    `username`, which is the whole reason the ledger's rows have names on them and these
    did not.

    A refusal is cached like an answer, for the same month. A bot with no profile, or a
    member of a workspace this token cannot enumerate, is a permanent no, and asking again
    every morning is a call a day to be told it.
    """
    want = {i for i in ids if isinstance(i, str)
            and re.fullmatch(r"[UWB][A-Z0-9]{6,}", i)}
    if not want:
        return _PEOPLE
    store = load_store(SLACK_PEOPLE, "the Slack people cache")
    now = int(time.time())
    for i, e in store.items():
        if isinstance(e, dict) and now - (e.get("at") or 0) < PEOPLE_TTL:
            _PEOPLE.setdefault(i, e)
    missing = sorted(want - set(_PEOPLE))
    if not missing:
        return _PEOPLE
    jobs = max(1, int(os.environ.get("WORK_ARCS_SLACK_THREAD_JOBS", "6")))
    with futures.ThreadPoolExecutor(max_workers=jobs) as pool:
        got = list(pool.map(_one_person, missing))
    for i, e in zip(missing, got):
        store[i] = _PEOPLE[i] = e or {"at": now, "name": "", "avatar": ""}
    try:
        SLACK_PEOPLE.parent.mkdir(parents=True, exist_ok=True)
        SLACK_PEOPLE.write_text(json.dumps(store, indent=1, sort_keys=True))
    except OSError:
        # A cache that cannot be written costs a call next run, and nothing else.
        pass
    return _PEOPLE


def _person(uid):
    """What is known about one Slack id: a name and a face, either possibly empty."""
    e = _PEOPLE.get(uid) or {}
    return {"who": e.get("name") or "", "avatar": e.get("avatar") or ""}


def _slack_day(ts):
    """A message ts as the day a reader recognises, or "" where it is not a time."""
    try:
        return datetime.fromtimestamp(float(ts)).strftime("%-d %b")
    except (TypeError, ValueError, OSError, OverflowError):
        return ""


def _ids_in(text):
    """Every user id a message's raw text mentions, so they resolve with its author."""
    return re.findall(r"<@([A-Z0-9]+)(?:\|[^>]*)?>", text or "")


# Slack shortcodes worth rendering, and the deliberate blanks. Kyle's own bot posts
# `:pencil: … :heavy_check_mark: … :mag:` around every line it writes, and unrendered that
# is the largest single source of noise in a quote on this page.
#
# Unknown shortcodes are left exactly as they arrived. That is the whole safety rule here:
# `ratio 3:4:5` holds a shortcode-shaped `:4:`, and a substitution that fires on anything it
# cannot name would silently print `ratio 35`. Only a name this table or unicodedata can
# resolve is ever replaced.
EMOJI = {
    "+1": "\N{THUMBS UP SIGN}", "-1": "\N{THUMBS DOWN SIGN}",
    "tada": "\N{PARTY POPPER}", "eyes": "\N{EYES}", "mag": "\N{LEFT-POINTING MAGNIFYING GLASS}",
    "white_check_mark": "\N{WHITE HEAVY CHECK MARK}", "heavy_check_mark": "\u2714",
    "x": "\u2716", "warning": "\u26a0", "rocket": "\N{ROCKET}", "fire": "\N{FIRE}",
    "pencil": "\u270f", "pencil2": "\u270f", "memo": "\N{MEMO}",
    "arrow_down": "\u2193", "arrow_up": "\u2191", "arrow_right": "\u2192",
    "arrow_left": "\u2190", "point_right": "\N{WHITE RIGHT POINTING BACKHAND INDEX}",
    "bulb": "\N{ELECTRIC LIGHT BULB}", "bug": "\N{BUG}", "wave": "\N{WAVING HAND SIGN}",
    "clap": "\N{CLAPPING HANDS SIGN}", "pray": "\N{PERSON WITH FOLDED HANDS}",
    "raised_hands": "\N{PERSON RAISING BOTH HANDS IN CELEBRATION}",
    "thinking_face": "\N{THINKING FACE}", "joy": "\N{FACE WITH TEARS OF JOY}",
    "sob": "\N{LOUDLY CRYING FACE}", "ok_hand": "\N{OK HAND SIGN}",
    "muscle": "\N{FLEXED BICEPS}", "100": "\N{HUNDRED POINTS SYMBOL}",
    "green_circle": "\N{LARGE GREEN CIRCLE}", "red_circle": "\N{LARGE RED CIRCLE}",
    "large_blue_circle": "\N{LARGE BLUE CIRCLE}", "no_entry": "\N{NO ENTRY}",
    "hourglass": "\u231b", "hourglass_flowing_sand": "\N{HOURGLASS WITH FLOWING SAND}",
    "calendar": "\N{TEAR-OFF CALENDAR}", "link": "\N{LINK SYMBOL}",
    "lock": "\N{LOCK}", "key": "\N{KEY}", "wrench": "\N{WRENCH}",
    "hammer": "\N{HAMMER}", "gear": "\u2699", "package": "\N{PACKAGE}",
    "chart_with_upwards_trend": "\N{CHART WITH UPWARDS TREND}",
    "inbox_tray": "\N{INBOX TRAY}", "outbox_tray": "\N{OUTBOX TRAY}",
    # Rendered as nothing on purpose: an animated workspace emoji is decoration in a chat
    # window and pure noise in a quote, and a skin-tone modifier has nothing to modify once
    # the emoji before it is a plain codepoint.
    "party_parrot": "", "spinner": "", "loading": "", "blob-wave": "",
}


def _emoji(name):
    if name in EMOJI:
        return EMOJI[name]
    if re.fullmatch(r"skin-tone-\d+", name):
        return ""
    try:
        return unicodedata.lookup(name.replace("_", " ").replace("-", " ").upper())
    except KeyError:
        return None


# Sweeps already made this process, by query. Two features want the same `from:me` window --
# the ledger reads it for commitments and answered mentions, slack_threads reads it for
# which threads Kyle took part in -- and they run at different points in main for reasons of
# their own. Asking search the identical question twice would double the Slack budget of the
# run to buy nothing, and worse, the two answers could disagree: a page that arrives for one
# caller and 429s for the other puts a thread in the ledger and not on the card, or the
# reverse, with nothing visible from either end to say which sweep was the short one. One
# sweep, one completeness verdict, shared. In-process only, and deliberately: this is not a
# cache of Slack between runs, it is one run not asking twice.
_SWEEPS = {}


def _slack_sweep(query, pages=4):
    """Every match for a search, newest first, and whether that "every" is true.

    Search is the one scope this token has, so the whole Slack side is built from sweeps
    rather than per-conversation reads.

    The second return value is the load-bearing one and it was missing. A failed page used
    to `break` and hand back whatever had arrived, which is indistinguishable from a
    complete sweep that happened to be short -- so a token expiring between page 1 and
    page 2 produced a ledger silently missing three quarters of its Slack rows, and a
    dismissal-prune then deleted the acknowledgements on the rows that never arrived,
    announcing "the fact under it moved" about a fact nobody had looked at. Absence of a
    section over a wrong section: a caller that cannot say whether it saw everything must
    not be trusted to say what is gone.
    """
    if (query, pages) in _SWEEPS:
        return _SWEEPS[(query, pages)]
    out = []
    for page in range(1, pages + 1):
        d = _slack("search.messages", query=query, count=100, page=page,
                   sort="timestamp", sort_dir="desc")
        if not d:
            # Not memoised: a sweep that failed halfway is the one answer worth asking for
            # again, and the two callers are minutes apart in a run.
            return out, False
        matches = (d.get("messages") or {}).get("matches") or []
        out += matches
        if len(matches) < 100:
            break
    _SWEEPS[(query, pages)] = (out, True)
    return out, True


def _slack_window():
    """The lookback in days and the `after:` date every sweep shares.

    One place, because the two features that sweep must agree to the day: a thread joined
    from a window one day wider than the ledger's would carry a decision the ledger's own
    rows cannot corroborate, and the mismatch would only ever show up as a card that
    disagrees with itself.
    """
    lookback = int(os.environ.get("WORK_ARCS_SLACK_LOOKBACK", "14"))
    after = datetime.fromtimestamp(time.time() - 86400 * (lookback + 1)).strftime("%Y-%m-%d")
    return lookback, after


def _slack_text(body):
    """Slack markup fit to quote: links keep their label, mentions name a person.

    A mention resolves through `_PEOPLE` where that id has been resolved and falls back to
    the id itself where it has not, which is the pre-existing behaviour and the only honest
    one: `@U0A5LKV7E0K` is unreadable, and inventing a name for it would be worse.

    Emoji shortcodes are replaced only where they can be named -- see EMOJI for why a
    substitution that fires on anything shortcode-shaped corrupts `ratio 3:4:5`.

    The three entities go last, and they were missing entirely. Slack escapes exactly `&`,
    `<` and `>` in message text, so `A -> B` arrives as `A -&gt; B` -- and every Slack quote
    in the ledger showed it that way, while on the page esc() escaped the ampersand a second
    time and made it `A -&amp;gt; B`. Found on a real one: "the sequence of MRs is
    UL-1637-&gt;UL-1790".

    Order carries the whole subtlety. The three regexes above read *unescaped* angle
    brackets, because that is what Slack's own markup is written in (`<@U1>`,
    `<url|label>`) -- so unescaping before them would turn a quoted `&lt;@U1&gt;` into a
    mention. And `&amp;` comes last of the three, or `&amp;gt;`, which Slack means as the
    literal text "&gt;", would arrive as a bare `>`.
    """
    body = re.sub(r"<@([A-Z0-9]+)(?:\|[^>]*)?>",
                  lambda m: "@" + (_person(m.group(1))["who"] or m.group(1)), body or "")
    body = re.sub(r"<!(here|channel|everyone)\b[^>]*>", r"@\1", body)
    body = re.sub(r"<[^|>]+\|([^>]+)>", r"\1", body)
    body = re.sub(r"<([^>]+)>", r"\1", body)
    body = re.sub(r":([a-z0-9_+'-]{2,}):",
                  lambda m: m.group(0) if _emoji(m.group(1)) is None else _emoji(m.group(1)),
                  body)
    body = body.replace("&lt;", "<").replace("&gt;", ">").replace("&amp;", "&")
    return _clean_note(body)


def _thread_of(match):
    """The thread a search match sits in, recovered from its permalink -- the only
    place a search result admits it. A message with no thread is its own root."""
    m = re.search(r"[?&]thread_ts=([0-9.]+)", match.get("permalink") or "")
    return m.group(1) if m else (match.get("ts") or "")


COMMIT_CACHE = (Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
                / "work-arcs" / "commitments.json")

COMMIT_PROMPT = """\
These are Kyle's own Slack messages from the last two weeks, numbered. Find the ones
that are clear first-person commitments to do something another person is relying on --
promises like "I'll take that", "I can pick this up", "leave it with me", "I'll send
you the doc tomorrow".

Count ONLY messages where all three hold:
- first person future: Kyle himself will do the thing
- concrete: a nameable action or deliverable, not a vague intention
- someone else plausibly depends on it happening

Exclude questions, opinions, past-tense reports, hypotheticals, jokes, "I'll look into
it at some point" vagueness, and anything you are not sure about. A wrong claim that
Kyle owes something costs more trust than ten right ones earn: prefer returning nothing
over guessing.

Reply with ONLY a JSON array, one object per commitment:
[{"i": <message number>, "promised": "<3-8 word restatement of what he said he'd do>",
  "to": "<who is relying on it, or empty>"}]

Empty array if none qualify.

Messages:
{messages}
"""


COMMIT_CLOSE_CACHE = (Path(os.environ.get("XDG_STATE_HOME",
                                          Path.home() / ".local/state"))
                      / "work-arcs" / "commitment-closes.json")

COMMIT_CLOSE_PROMPT = """\
Each numbered block is a promise Kyle made in Slack, followed by ONE later message Kyle
himself wrote in the same conversation. For each block, decide whether that later
message shows the promise was KEPT.

Kept looks like: "here you go", "done", "pushed", "merged", "have a look", the link or
document he promised, a report of the result, handing the thing over.

NOT kept: more discussion of the same problem, another promise or a new deadline, a
question, an apology for the delay, "still working on it", or unrelated talk that merely
happens to come later in the same thread. Being present in the conversation is not
delivering.

Reply with ONLY a JSON array of the block numbers whose later message plainly delivers
the promise, e.g. [0, 2]. Leave out every block you are not sure about: a listed block
DELETES a reminder, and a promise quietly forgotten is worse than a reminder that stays
a day too long. Empty array if none.

Blocks:
{blocks}
"""


def _commitment_delivered(pairs, mine):
    """Which promises Kyle can be shown to have kept in the same conversation.

    The cheapest fulfilment signal there is, because it needs no new network call: the
    `from:me` sweep is already in hand for the answered-index, covers the same lookback,
    and therefore already contains whatever Kyle said after the promise. What it does not
    contain is a judgment, and the judgment is the whole difficulty -- "I'll take a look
    on Monday" followed by ten more messages in that thread proves he was in the room, not
    that he looked.

    So the candidate set is narrow and the judge is asked one question per pair:

    * SAME THREAD ONLY in a channel. `_thread_of` is recovered from the permalink, which
      is the only place a search match admits its thread. Later chatter anywhere else in
      #tech-backend is not evidence about a promise made in one of its threads, and
      treating it as evidence is exactly how this feature would start deleting real
      reminders.
    * THE WHOLE CHANNEL in a DM, because a DM's channel *is* the conversation. Slack gives
      every top-level DM message its own thread id, so a same-thread rule would make a
      promise made in a DM structurally unclosable -- and a DM has no ambient traffic for
      a reply to be confused with.
    * NEWER THAN THE PROMISE, and at most the last few, since a wrap-up is the last thing
      said rather than the first.

    The default is the opposite of `_dm_needs_reply`'s, and deliberately so. There, an
    unjudged row is kept because a missed reminder is cheaper than a false one; here, an
    unjudged pair closes nothing, because the two failures have swapped places. A stale
    reminder shows its own quote and can be read and dismissed in a second. A promise
    silently deleted on a guess is a tool that has quietly stopped telling you things --
    the one failure from which no amount of correctness later recovers.

    Verdicts cache per (promise, candidate) pair with the prompt in the key, so a re-run
    is free and a reworded question cannot reuse yesterday's answers (item 1c).
    """
    if not pairs:
        return
    cands = {}
    for i, (row, m) in enumerate(pairs):
        chan = (m.get("channel") or {}).get("id", "")
        if not chan:
            continue
        thread, ts = _thread_of(m), float(m.get("ts") or 0)
        dm = chan.startswith("D")
        later = [c for c in mine
                 if (c.get("channel") or {}).get("id") == chan
                 and float(c.get("ts") or 0) > ts
                 and (dm or _thread_of(c) == thread)
                 and (c.get("text") or "").strip()]
        later.sort(key=lambda c: float(c.get("ts") or 0))
        for c in later[-int(os.environ.get("WORK_ARCS_CLOSE_CANDIDATES", "4")):]:
            cands[(i, c.get("ts") or "")] = c
    if not cands:
        return

    prompt_sha = hashlib.sha256(COMMIT_CLOSE_PROMPT.encode()).hexdigest()[:16]
    cache = load_store(COMMIT_CLOSE_CACHE, "the commitment close-out cache")
    if cache.get("prompt") != prompt_sha:
        cache = {"prompt": prompt_sha, "verdicts": {}}
    verdicts = cache.setdefault("verdicts", {})

    def key(i, c):
        row, m = pairs[i]
        return hashlib.sha256(
            f"{m.get('ts','')}\x00{m.get('text','')}\x00"
            f"{c.get('ts','')}\x00{c.get('text','')}".encode()).hexdigest()[:16]

    fresh = [(i, c) for (i, _), c in sorted(cands.items())
             if key(i, c) not in verdicts]
    if fresh:
        model = os.environ.get("WORK_ARCS_COMMIT_MODEL", "sonnet")
        print(f"  ledger: judging {len(fresh)} later message(s) of yours for whether a "
              f"commitment was kept ({model})", file=sys.stderr)
        blocks = []
        for n, (i, c) in enumerate(fresh):
            row, m = pairs[i]
            where = row.get("ref") or "a DM"
            blocks.append(
                f"[{n}] PROMISE ({row.get('asked','?')} in {where}): "
                + _slack_text(m.get("text"))
                + f"\n    LATER, same conversation ({_day_str(c)}): "
                + _slack_text(c.get("text")))
        try:
            r = headless_claude.run(
                ["--model", model, "--dangerously-skip-permissions",
                 COMMIT_CLOSE_PROMPT.replace("{blocks}", "\n".join(blocks))],
                timeout=180)
            hits = set(json.loads(re.search(r"\[.*?\]", r.stdout, re.S).group(0))) \
                if r.returncode == 0 else None
        except (OSError, subprocess.SubprocessError, ValueError,
                AttributeError, TypeError):
            hits = None
        # Nothing cached on a failed or unparseable call: the next run asks again rather
        # than remembering an accident as a verdict. And nothing closes on this run,
        # which is the honest degradation -- the rows simply stand.
        if hits is not None:
            for n, (i, c) in enumerate(fresh):
                verdicts[key(i, c)] = n in hits
            try:
                COMMIT_CLOSE_CACHE.parent.mkdir(parents=True, exist_ok=True)
                COMMIT_CLOSE_CACHE.write_text(json.dumps(cache))
            except OSError:
                pass

    # Newest delivering message wins the evidence slot: if he said "on it" and later
    # "done", the later one is the one worth quoting back.
    for (i, cts), c in sorted(cands.items(), key=lambda kv: float(kv[0][1] or 0)):
        if verdicts.get(key(i, c)):
            row = pairs[i][0]
            text = _slack_text(c.get("text"))
            row["closed_how"] = "thread"
            # When it was closed, not only that it was. Every close path below computes
            # this instant to decide whether the evidence postdates the promise and then
            # threw it away, which left "you did what you said you would" as a fact with
            # no date on it -- unusable to anything asking about an interval rather than
            # about the standing state.
            row["closed_ts"] = float(cts or 0)
            row["closed_by"] = f'you posted in-thread: "{_clip(text, 64)}"'
            # The whole message as well as the sentence, because the two have different
            # readers: the sentence is a line on a page and this is what an audit of "why
            # did that reminder go away" actually wants. Neither is a truncation of the
            # evidence itself -- only of the version that has a column to fit into.
            row["closed_quote"] = text
            row["closed_url"] = c.get("permalink", "")


def _clip(text, n):
    """Shorten to about n characters at a word boundary, with an ellipsis if it shortened.

    Quotes inside a sentence, only. A fragment cut mid-word reads as a bug in the tool
    rather than as a quotation, which matters here because the sentence it lands in is
    the reason a reminder was deleted -- the one sentence that has to look trustworthy.
    """
    text = " ".join((text or "").split())
    if len(text) <= n:
        return text
    head = text[:n].rsplit(" ", 1)[0]
    return (head or text[:n]) + "…"


def _day_str(m):
    """The day a Slack match was posted, for a prompt to read."""
    try:
        return datetime.fromtimestamp(float(m.get("ts") or 0)).strftime("%Y-%m-%d")
    except (ValueError, TypeError):
        return "?"


DM_REPLY_CACHE = (Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
                  / "work-arcs" / "dm-replies.json")

DM_REPLY_PROMPT = """\
Each numbered line is the LAST message in a Slack DM conversation with Kyle, written by
the other person. Which of them still need a reply or an action from Kyle?

Needing a reply means a question, a request, or something left explicitly hanging.
Exclude closing pleasantries ("thanks", "all good", "sounds good"), FYIs that ask
nothing, and automated messages. When you are not sure, exclude it: a wrong claim that
Kyle owes a reply costs more than a missed one.

Reply with ONLY a JSON array of the numbers that need something from Kyle, e.g. [0, 3].
Empty array if none.

Messages:
{messages}
"""


def _dm_needs_reply(rows):
    """Whether a DM's last word actually asks anything, judged once and cached.

    "Whoever spoke last" is the right turn-taking rule and the wrong debt rule in DMs:
    a conversation's last word is very often "thanks" or "all good", and rendering
    those as things Kyle owes is exactly the wrong reminder the plan warns about. The
    judge defaults to dropping -- a real ask that also arrived as an @-mention is still
    caught by the mention sweep -- and a failed model call keeps the rows unfiltered,
    which is the honest degradation.
    """
    if not rows:
        return rows
    prompt_sha = hashlib.sha256(DM_REPLY_PROMPT.encode()).hexdigest()[:16]
    cache = load_store(DM_REPLY_CACHE, "the DM-reply verdict cache")
    if cache.get("prompt") != prompt_sha:
        cache = {"prompt": prompt_sha, "verdicts": {}}
    verdicts = cache.setdefault("verdicts", {})

    def key(r):
        return hashlib.sha256(
            f"{r.get('url','')}\x00{r.get('quote','')}".encode()).hexdigest()[:16]

    fresh = [r for r in rows if key(r) not in verdicts]
    if fresh:
        model = os.environ.get("WORK_ARCS_COMMIT_MODEL", "sonnet")
        numbered = "\n".join(f"[{i}] (from {r.get('who','?')}) {r.get('quote','')}"
                             for i, r in enumerate(fresh))
        try:
            r = headless_claude.run(
                ["--model", model, "--dangerously-skip-permissions",
                 DM_REPLY_PROMPT.replace("{messages}", numbered)], timeout=120)
            hits = set(json.loads(re.search(r"\[.*?\]", r.stdout, re.S).group(0))) \
                if r.returncode == 0 else None
        except (OSError, subprocess.SubprocessError, ValueError,
                AttributeError, TypeError):
            hits = None
        if hits is not None:
            for i, row in enumerate(fresh):
                verdicts[key(row)] = i in hits
            try:
                DM_REPLY_CACHE.parent.mkdir(parents=True, exist_ok=True)
                DM_REPLY_CACHE.write_text(json.dumps(cache))
            except OSError:
                pass
    return [r for r in rows if verdicts.get(key(r), True)]


def ledger_commitments(mine):
    """Things you said you'd do, read out of your own messages. The one inferred thing
    in the ledger, and it wears that on its sleeve.

    "You said you'd take responsibility for that 4 days ago" is not derivable -- no
    API marks a sentence as a promise -- so this is a model call, held to the rules the
    plan sets for exactly this feature: every row quotes the message it is a claim
    about with a permalink to it, and the prompt prefers silence over a guess, because
    a wrong "you owe" costs more trust than ten right ones earn.

    Judged once per message, cached by content: the sliding window only ever pays for
    messages the model has not seen, so this is one small call a day, not a sweep. The
    cache keys on the prompt too -- rewording the question must not reuse old answers,
    which is the exact way an evidence-keyed cache went stale once already (item 1c).

    A row that survives its own fulfilment is a wrong reminder, so two fields go out
    with each one for the closing pass to use. `asked_ts` is the promise's own instant,
    because "did this merge come after the promise" cannot be answered at day
    resolution. `expires_in` is how many days the row has left before the lookback
    window slides past its message and takes it away -- the honest ending for a promise
    nothing can be shown about, and something the page should say out loud rather than
    let a row vanish unexplained.
    """
    rows = []
    candidates = [m for m in mine
                  if len((m.get("text") or "").strip()) >= 12][:200]
    if not candidates:
        return rows
    prompt_sha = hashlib.sha256(COMMIT_PROMPT.encode()).hexdigest()[:16]
    cache = load_store(COMMIT_CACHE, "the commitment-detection cache")
    if cache.get("prompt") != prompt_sha:
        cache = {"prompt": prompt_sha, "verdicts": {}}
    verdicts = cache.setdefault("verdicts", {})

    def key(m):
        return hashlib.sha256(
            f"{m.get('ts','')}\x00{m.get('text','')}".encode()).hexdigest()[:16]

    fresh = [m for m in candidates if key(m) not in verdicts]
    if fresh:
        model = os.environ.get("WORK_ARCS_COMMIT_MODEL", "sonnet")
        print(f"  ledger: reading {len(fresh)} new Slack messages of yours for "
              f"commitments ({model})", file=sys.stderr)
        numbered = "\n".join(
            f"[{i}] (in {(m.get('channel') or {}).get('name') or 'a DM'}) "
            + _slack_text(m.get("text"))
            for i, m in enumerate(fresh))
        try:
            r = headless_claude.run(
                ["--model", model, "--dangerously-skip-permissions",
                 COMMIT_PROMPT.replace("{messages}", numbered)], timeout=240)
            found = json.loads(re.search(r"\[.*\]", r.stdout, re.S).group(0)) \
                if r.returncode == 0 else None
        except (OSError, subprocess.SubprocessError, ValueError, AttributeError):
            found = None
        # Nothing is cached on a failed or unparseable call, so the next run asks again
        # rather than remembering an accident as a verdict.
        if isinstance(found, list):
            hits = {}
            for f in found:
                try:
                    hits[int(f["i"])] = {"promised": str(f.get("promised", ""))[:80],
                                         "to": str(f.get("to", ""))[:40]}
                except (KeyError, TypeError, ValueError):
                    continue
            for i, m in enumerate(fresh):
                verdicts[key(m)] = hits.get(i, False)
            try:
                COMMIT_CACHE.parent.mkdir(parents=True, exist_ok=True)
                COMMIT_CACHE.write_text(json.dumps(cache))
            except OSError:
                pass

    settle = 86400 * int(os.environ.get("WORK_ARCS_SLACK_SETTLE_DAYS", "1"))
    lookback = int(os.environ.get("WORK_ARCS_SLACK_LOOKBACK", "14"))
    now = time.time()
    pairs = []
    for m in candidates:
        v = verdicts.get(key(m))
        if not isinstance(v, dict):
            continue
        ts = float(m.get("ts") or 0)
        if now - ts < settle:
            continue
        day = datetime.fromtimestamp(ts).strftime("%Y-%m-%d")
        name = (m.get("channel") or {}).get("name", "")
        # A DM's channel "name" is the other party's raw user id, which is not a name.
        if re.fullmatch(r"[UDW][A-Z0-9]{8,}", name or ""):
            name = ""
        days = _days_since(day)
        row = {"kind": "commitment", "ref": f"#{name}" if name else "DM",
               "title": "", "who": v.get("to", ""),
               "promised": v.get("promised", ""),
               "asked": day, "days": days,
               "asked_ts": ts,
               "expires_in": max(0, lookback - (days or 0)),
               "window_days": lookback,
               "quote": _slack_text(m.get("text")),
               "url": m.get("permalink", "")}
        rows.append(row)
        pairs.append((row, m))
    # The rows and the messages they came from, together, because the closing judge needs
    # the message: only the raw match carries the channel id and the thread its permalink
    # encodes. Marked here, removed later -- see close_commitments for why the removal is
    # one place and not three.
    _commitment_delivered(pairs, mine)
    return rows


def _doc_url(file_id):
    """The document, as a person opens it. The transcript lives in a tab whose id the
    connector does not hand back, so the link lands on the doc and the reader clicks
    across -- an honest link to the right document beats a fabricated anchor."""
    return f"https://docs.google.com/document/d/{file_id}/edit"


MEETING_CACHE = (Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
                 / "work-arcs" / "meeting-commitments.json")

# `FE standup - 2026/08/24 10:29 PDT - Notes by Gemini`. The meeting's own name is what
# the ledger shows as the row's reference, and the timestamp is the promise's instant --
# which close_commitments needs at better than day resolution, because "did the MR merge
# after he promised" is unanswerable when both fall on the same afternoon.
MEETING_TITLE_RE = re.compile(
    r"^(?P<name>.+?)\s*-\s*(?P<date>\d{4}/\d{2}/\d{2})\s+"
    r"(?P<time>\d{1,2}:\d{2})\s*(?P<zone>[A-Z]{2,4})?\s*-\s*Notes by Gemini\s*$")

# Zone abbreviations Gemini writes, as UTC offsets in seconds. A zone this does not know
# falls back to local time, which is the right failure: Kyle's meetings are in his own
# day, and being an hour out on a promise made at 10:29 cannot reorder it against a merge
# that happened tomorrow.
MEETING_ZONES = {"PDT": -7 * 3600, "PST": -8 * 3600, "MDT": -6 * 3600,
                 "MST": -7 * 3600, "CDT": -5 * 3600, "CST": -6 * 3600,
                 "EDT": -4 * 3600, "EST": -5 * 3600, "UTC": 0, "GMT": 0}

MEETING_DOCS_PROMPT = """\
Call the Google Drive tool `search_files` exactly once with this query, verbatim:

  title contains 'Notes by Gemini' and mimeType = 'application/vnd.google-apps.document' \
and modifiedTime > '{after}'

Then reply with ONLY a JSON array, one object per file the tool returned, copying the
values EXACTLY as the tool gave them -- do not correct, shorten, re-format or invent any
field:

[{"id":"<file id>","title":"<title>","modified":"<modifiedTime>"}]

Do not explain, do not summarise the files, do not comment on what you found. Empty array
if the tool returned no files or failed. No prose, no code fence.
"""

MEETING_PROMPT = """\
Call the Google Drive tool `read_file_content` exactly once, with fileId {file_id}.

The document is a Gemini meeting record with two sections: a "Notes" section Gemini
wrote, and a "Transcript" section of what people actually said, with each line labelled
by speaker name.

THE TRANSCRIPT IS THE ONLY GROUND TRUTH. The Notes section's attributions are
demonstrably wrong -- it has assigned one person's ticket to another. You may read the
Notes "Next steps" list as a hint about where to look, but you must NOT report anything
from it that you cannot find Kyle saying himself in the transcript. If the Notes claim
Kyle owns something and the transcript does not show him saying so, it does not exist.

Find the places where KYLE GRIMSRUD-MANZ HIMSELF commits to doing something. Only his own
lines -- the ones labelled "Kyle Grimsrud-Manz:". Never anyone else's, never something
someone else says Kyle will do, never something Kyle asks another person to do.

Count ONLY where all three hold:
- first person future: Kyle himself will do the thing
- concrete: a nameable action or deliverable, not a vague intention
- someone else plausibly depends on it happening

Exclude questions, opinions, past-tense reports of work already finished, hypotheticals,
thinking out loud, offers to be available ("I'm around if you want to chat"), and
anything you are not sure about. This is a spoken transcript with transcription errors in
it; where the words are garbled enough that you cannot tell what was promised, say
nothing. A wrong claim that Kyle owes something costs more trust than ten right ones
earn: prefer returning nothing over guessing.

Reply with ONLY a JSON array, one object per commitment:
[{"promised": "<3-8 word restatement of what he said he'd do>",
  "to": "<the person relying on it, if he named or addressed one, else empty>",
  "deadline": "<the timeframe HE stated, verbatim and nothing else, e.g. 'today', \
'in the next couple days', 'next sprint'; empty string if he stated none>",
  "quote": "<his own words, verbatim from the transcript, at most 180 characters>"}]

Every object MUST carry a `quote` that appears verbatim in the transcript. Empty array if
none qualify. No prose, no code fence.
"""


def _drive(prompt, model, timeout=300):
    """A `claude -p` call that may read Google Drive, and nothing else.

    The access path, and the reason this is a model call at all: Kyle has no Google
    credential on this machine. No rclone remote, no gcalcli, no gcloud, no OAuth token
    under ~/.config, and no google-api-python-client to use one with. What he does have is
    the claude.ai Google Drive connector, already authorised against his work account --
    and its grant lives with the Anthropic account rather than in a file here, so a
    `claude -p` subprocess inherits it with no setup at all. Measured under `env -i` with
    only HOME and arcs-refresh's PATH, which is the condition cron actually runs in.

    So the model is the transport, not just the judge, and `--allowedTools` is spelled out
    per call: this may read a Drive file and it may not write one, edit the tree, or touch
    the network any other way. `--dangerously-skip-permissions` would grant all three, and
    a prompt built from a meeting transcript is text Kyle did not write.

    The `=` in `--allowedTools=...` is load-bearing. The flag is variadic, so the space
    form swallows the prompt as a second tool name and `claude` exits with "Input must be
    provided either through stdin or as a prompt argument" -- a failure that looks like a
    broken prompt rather than a broken flag.
    """
    return headless_claude.run(
        ["--model", model,
         "--allowedTools=mcp__claude_ai_Google_Drive__search_files,"
         "mcp__claude_ai_Google_Drive__read_file_content",
         prompt], timeout=timeout)


def _json_array(text):
    """The first JSON array in a model's reply, or None. None means "no answer", never
    "no commitments" -- the caller must not cache one as the other."""
    m = re.search(r"\[.*\]", text or "", re.S)
    if not m:
        return None
    try:
        v = json.loads(m.group(0))
    except ValueError:
        return None
    return v if isinstance(v, list) else None


def _meeting_instant(title):
    """(meeting name, epoch) from a Gemini doc title, or (title, 0).

    0 is load-bearing rather than a sentinel nobody checks, the same way `_iso_epoch`'s
    is: a promise with no instant orders before every merge and every status move, so an
    unparseable title closes nothing and expires normally.
    """
    m = MEETING_TITLE_RE.match(title or "")
    if not m:
        return (title or "").strip(), 0
    name = m.group("name").strip()
    stamp = f"{m.group('date')} {m.group('time')}"
    try:
        naive = datetime.strptime(stamp, "%Y/%m/%d %H:%M")
    except ValueError:
        return name, 0
    off = MEETING_ZONES.get((m.group("zone") or "").upper())
    if off is None:
        return name, int(naive.timestamp())
    return name, int(naive.replace(tzinfo=timezone.utc).timestamp()) - off


# A Drive file id as Drive writes them. The discovery call relays ids through a model, and
# a relayed id is the one field a model could plausibly "tidy": validating the shape means
# a garbled id is dropped here rather than spending a read call to find out.
DRIVE_ID_RE = re.compile(r"^[A-Za-z0-9_-]{20,}$")


def _meeting_docs(after_iso, model):
    """The Gemini meeting docs modified since `after_iso`, newest first.

    One uncached call per run, deliberately: this is the question whose answer must be
    allowed to change, and a cache on it would make a new morning's standup invisible
    until something else invalidated it. It is also the cheap call -- a title query and a
    relay, no document body -- so paying it every run costs almost nothing.

    Returns (docs, complete). `complete` is the same distinction `ledger_slack` draws and
    for the same reason: a run where Drive would not answer has an unknown meeting
    universe, not an empty one, and the dismissal prune may not delete an acknowledgement
    on the grounds that its row is gone.
    """
    r = None
    try:
        r = _drive(MEETING_DOCS_PROMPT.replace("{after}", after_iso), model, timeout=180)
        found = _json_array(r.stdout) if r.returncode == 0 else None
    except (OSError, subprocess.SubprocessError) as e:
        print(f"  ledger: could not run claude to list meeting docs ({e}) — no meeting "
              "rows this run, and nothing pruned on their absence", file=sys.stderr)
        return [], False
    if found is None:
        print("  ledger: Drive would not list the meeting docs — no meeting rows this "
              "run, and nothing pruned on their absence", file=sys.stderr)
        return [], False
    docs = []
    for f in found:
        if not isinstance(f, dict):
            continue
        fid = str(f.get("id") or "").strip()
        title = str(f.get("title") or "").strip()
        modified = str(f.get("modified") or "").strip()
        # All three or none. A doc with no modifiedTime has no revision to key a cache on,
        # and re-reading it every morning would pay for the same transcript daily.
        if not (DRIVE_ID_RE.match(fid) and title and modified):
            continue
        name, at = _meeting_instant(title)
        docs.append({"id": fid, "title": title, "modified": modified,
                     "name": name, "at": at})
    docs.sort(key=lambda d: (-d["at"], d["title"], d["id"]))
    return docs[:int(os.environ.get("WORK_ARCS_MEETING_DOCS", "12"))], True


def ledger_meetings():
    """Promises Kyle made out loud, read off the transcripts of his own meetings.

    The third leg. Derived work is in git and declared work is in Jira, and neither holds
    the sentence "I'll get it in the next couple days" -- said at a standup on a Monday,
    heard by six people, written down nowhere. The Slack ledger cannot see it either: the
    room is not a channel. So a promise made in a meeting was the one open loop with a
    person on the other end that nothing in this pipeline could ever notice, and the only
    one whose *deadline* Kyle set himself and out loud.

    Two calls, and only the second is cached:

      discovery   which Gemini docs exist in the window. Uncached, once per run, because
                  this morning's standup must be able to appear.
      extraction  one call per (doc, revision), reading the transcript for Kyle's own
                  commitments. Cached, so a fortnight's window costs one call a day.

    The revision is `modifiedTime`, because there is nothing better: the Drive connector
    exposes no revision id, only that stamp. It behaves the way a revision needs to --
    Gemini writes the doc once when the meeting ends and never touches it again, so the
    key is stable, and a doc somebody edits by hand is re-read, which is correct. The
    prompt's own hash is in the key too, for the reason item 1c cost a release: rewording
    the question must not reuse yesterday's answers.

    THE TRANSCRIPT TAB IS GROUND TRUTH, and this is the whole reason the feature reads a
    document instead of a to-do list. Gemini's Notes tab already writes a "Next steps"
    list with names against it, and it is wrong: it assigned UL-1640 to the wrong person,
    and it has since been caught twice more. It is also lossy in exactly the direction
    that matters here -- on 2026-08-24 Kyle said of the Dove workspace migration "it's
    kind of non-trivial, but I think I'll get it in the next couple days", and the Notes
    tab rendered that as "Migrate Workspaces: Transition all Dove workspaces to utilize
    case inputs". The clock, which is the only thing a commitment has, is not in the
    summary. It is in the transcript, in his own voice, and that is what gets quoted.

    Returns (rows, complete), the same contract as `ledger_slack`'s last two values.
    """
    # The one source with no credential to gate itself on. `ledger_slack` returns early
    # without a token and the Jira rows without a domain, so a caller that has not set up
    # those universes simply has none of them; this one always runs, and the first thing
    # that cost was degradation.bats -- a file about what glab does, which from the moment
    # this leg landed made a real model call through a real Drive connector and then did
    # not fail but HANG, for as long as the suite was given.
    #
    # So the off switch is readable from the environment as well as from the CLI, because
    # a consumer that imports this module has no argv to put --no-meetings on. Complete
    # and empty, exactly like the no-token case: turned off means there were never any
    # meeting rows, so nothing is missing and a dismissal prune stays safe.
    if os.environ.get("WORK_ARCS_NO_MEETINGS"):
        return [], True
    # Haiku, and measured rather than assumed. Every call here carries the whole Claude
    # Code session prefix plus the schemas of every connector on the account -- 180-350k
    # cached tokens per call against a transcript of maybe 12k -- so the price is set by
    # the harness, not by the document, and the model tier is the only lever that moves
    # it. Sonnet cost $0.32 a call and haiku $0.09, which turns a cold 14-day sweep from
    # about $4 into about $1.20.
    #
    # The quality difference lands on the cheap side of the ledger's asymmetry, which is
    # why this is affordable. On the 2026-08-24 standup sonnet found two promises and
    # haiku one, and the one haiku left out was "today I'm probably just going to be doing
    # a lot of code review" -- an intention hedged with "probably", which the prompt
    # already tells it to leave alone. A missed promise costs a reminder that never
    # appears; a wrong one costs trust in every row. And the expensive direction is not
    # this model's to get wrong at all: close_commitments removes rows on merges and
    # status moves, with no model in it anywhere.
    model = os.environ.get("WORK_ARCS_MEETING_MODEL", "haiku")
    lookback = int(os.environ.get("WORK_ARCS_MEETING_LOOKBACK", "14"))
    settle = 3600 * int(os.environ.get("WORK_ARCS_MEETING_SETTLE_HOURS", "3"))
    now = time.time()
    after = datetime.fromtimestamp(now - lookback * 86400, timezone.utc)
    docs, whole = _meeting_docs(after.strftime("%Y-%m-%dT%H:%M:%SZ"), model)
    if not docs:
        return [], whole

    prompt_sha = hashlib.sha256(MEETING_PROMPT.encode()).hexdigest()[:16]
    cache = load_store(MEETING_CACHE, "the meeting-commitment cache")
    if cache.get("prompt") != prompt_sha:
        cache = {"prompt": prompt_sha, "found": {}}
    found = cache.setdefault("found", {})

    def key(d):
        return hashlib.sha256(f"{d['id']}\x00{d['modified']}".encode()).hexdigest()[:16]

    # A meeting still in progress, or one whose doc Gemini is still writing, is not a
    # settled record. The Slack side waits a day for the same reason; three hours is
    # enough here because the doc is written once at the end rather than accumulating.
    ready = [d for d in docs if d["at"] and now - d["at"] >= settle]
    fresh = [d for d in ready if key(d) not in found]
    if fresh:
        print(f"  ledger: reading {len(fresh)} meeting transcript(s) for promises you "
              f"made out loud ({model})", file=sys.stderr)
    for d in fresh:
        try:
            r = _drive(MEETING_PROMPT.replace("{file_id}", d["id"]), model, timeout=420)
            got = _json_array(r.stdout) if r.returncode == 0 else None
        except (OSError, subprocess.SubprocessError):
            got = None
        # Nothing is cached on a failed or unparseable call, so the next run asks again
        # rather than remembering an accident as "this meeting held no promises".
        if got is None:
            whole = False
            print(f"  ledger: could not read “{d['name']}” — its promises are unknown "
                  "this run, not absent", file=sys.stderr)
            continue
        keep = []
        for c in got:
            if not isinstance(c, dict):
                continue
            quote = _clean_note(str(c.get("quote") or ""))
            promised = str(c.get("promised") or "").strip()[:80]
            # No quote, no row. The plan's rule is that every inferred claim shows the
            # words it is about, and it is held here by construction rather than trusted:
            # a commitment the model cannot quote is one it cannot show Kyle saying, which
            # is the failure mode the Notes tab already demonstrates.
            if not (quote and promised):
                continue
            keep.append({"promised": promised,
                         "to": str(c.get("to") or "").strip()[:40],
                         "deadline": str(c.get("deadline") or "").strip()[:60],
                         "quote": quote})
        found[key(d)] = keep
        try:
            MEETING_CACHE.parent.mkdir(parents=True, exist_ok=True)
            MEETING_CACHE.write_text(json.dumps(cache))
        except OSError:
            pass

    rows = []
    for d in ready:
        for c in found.get(key(d)) or []:
            day = datetime.fromtimestamp(d["at"]).strftime("%Y-%m-%d")
            days = _days_since(day)
            rows.append({
                "kind": "meeting-commitment", "ref": d["name"][:24], "title": "",
                "who": c.get("to", ""), "promised": c.get("promised", ""),
                # The timeframe he set for himself, kept apart from the restatement so
                # `promised_due` reads a phrase that is *only* about the promise. It is
                # the cleanest input that function has ever had: the Slack side has to
                # mine a three-to-eight word paraphrase for a date, where this is the
                # model's isolated answer to "what clock did he name".
                "deadline": c.get("deadline", ""),
                "asked": day, "days": days, "asked_ts": float(d["at"]),
                "expires_in": max(0, lookback - (days or 0)),
                "window_days": lookback,
                "quote": c.get("quote", ""), "url": _doc_url(d["id"]),
                # Worn on its sleeve, like the Slack commitment it sits beside. Nothing
                # here is a fact an API asserted; it is a sentence a model heard.
                "inferred": True,
            })
    return rows, whole


def ledger_slack():
    """Slack's side of the ledger, from search alone -- the token has no history scope,
    and it turns out none is needed for whose-turn-is-it.

    Three sweeps: everything I said, everywhere I was mentioned, every DM. My own
    messages become the answered-index -- a mention is answered if I spoke in its thread
    after it, or anywhere in its channel after it (the channel-level catch-all errs
    toward silence, because a wrong "you owe" costs more than a missed one). A DM is
    judged like a review thread: whoever spoke last says whose turn it is.

    One deliberate heuristic, the only one in the ledger: a DM where MY last word ends
    in a question mark is somebody owing me an answer. Judging whether their trailing
    word needs anything from me at all is left to the reader -- which is why every row
    here quotes the message it is a claim about, verbatim.

    Bot noise is dropped structurally, not by name: automation mentions arrive as
    attachment-only messages with empty text, and an empty quote is no claim at all.

    Returns (they_owe, you_owe, consulted, complete). The last two are not the same
    question and the ledger needs both:

      consulted  a token existed and Slack said who it belonged to. The page's caveat is
                 read off this -- "Slack was not consulted this run, these are GitLab and
                 Jira only" is a sentence about whether to expect Slack rows at all.
      complete   the Slack universe in this ledger is the WHOLE Slack universe. The
                 dismissal prune is read off this, because pruning means deleting an
                 acknowledgement on the grounds that its row is gone, and a sweep that
                 half-answered cannot support that claim about anything.

    They come apart in both directions, which is the point. No token at all is
    (False, True): there are no Slack rows and there never were, so nothing can be missing
    and a prune is perfectly safe. A token that fails auth, or answers page 1 and not page
    2, is (False, False) / (True, False): rows are missing and no one knows which.
    """
    # Two different falsehoods, and conflating them cost Kyle his acknowledgements. See the
    # return contract in the docstring: no token means the Slack universe is empty and
    # correctly so, which is a complete answer; a token that fails to answer means the
    # universe is unknown, which is not.
    if not os.environ.get("SLACK_USER_TOKEN"):
        return [], [], False, True
    who_am_i = _slack("auth.test") or {}
    me = who_am_i.get("user_id")
    if not me:
        print("  ledger: Slack has a token and would not say who it belongs to — no "
              "Slack rows this run, and nothing pruned on their absence",
              file=sys.stderr)
        return [], [], False, False
    lookback, after = _slack_window()
    settle = 86400 * int(os.environ.get("WORK_ARCS_SLACK_SETTLE_DAYS", "1"))

    # All three sweeps, and whether each of them saw everything. auth.test succeeding proves
    # a token existed a moment ago and nothing whatsoever about the three searches after it:
    # a rate limit between page 1 and page 2 of the from:me sweep silently drops three
    # quarters of the commitment candidates.
    mine, ok_mine = _slack_sweep(f"from:<@{me}> after:{after}")
    mentions, ok_mentions = _slack_sweep(f"<@{me}> after:{after}", pages=1)
    dms, ok_dms = _slack_sweep(f"is:dm after:{after}")
    complete = ok_mine and ok_mentions and ok_dms
    # Before a word of any of it is quoted. A search match carries `username`, so these rows
    # always had a name on the row -- but the message text is written in ids, and a quote
    # reading "@U0A5LKV7E0K not sure how undefined made it here" names nobody at all.
    _learn_people([i for m in mine + mentions + dms for i in _ids_in(m.get("text"))])
    if not complete:
        print("  ledger: Slack answered some of its sweeps and not others — the Slack "
              "rows this run are incomplete, so nothing is pruned on their absence",
              file=sys.stderr)

    my_last_in_thread, my_last_in_chan = {}, {}
    for m in mine:
        chan, ts = (m.get("channel") or {}).get("id", ""), float(m.get("ts") or 0)
        key = (chan, _thread_of(m))
        my_last_in_thread[key] = max(my_last_in_thread.get(key, 0), ts)
        my_last_in_chan[chan] = max(my_last_in_chan.get(chan, 0), ts)

    def day_of(ts):
        return datetime.fromtimestamp(float(ts)).strftime("%Y-%m-%d")

    now = time.time()
    you = []
    for m in mentions:
        chan = (m.get("channel") or {}).get("id", "")
        ts = float(m.get("ts") or 0)
        text = (m.get("text") or "").strip()
        if m.get("user") == me or not text or now - ts < settle:
            continue
        answered = max(my_last_in_thread.get((chan, _thread_of(m)), 0),
                       my_last_in_chan.get(chan, 0))
        if answered > ts:
            continue
        name = (m.get("channel") or {}).get("name", "")
        if re.fullmatch(r"[UDW][A-Z0-9]{8,}", name or ""):
            name = ""
        you.append({"kind": "slack-mention", "ref": f"#{name}" if name else "DM",
                    "title": "", "who": m.get("username", "?"),
                    "asked": day_of(ts), "days": _days_since(day_of(ts)),
                    "quote": _slack_text(text), "url": m.get("permalink", "")})

    latest = {}
    for m in dms:
        chan = (m.get("channel") or {}).get("id", "")
        if chan and float(m.get("ts") or 0) > float(
                (latest.get(chan) or {}).get("ts") or 0):
            latest[chan] = m
    they, dm_candidates = [], []
    for chan, m in latest.items():
        ts, text = float(m.get("ts") or 0), (m.get("text") or "").strip()
        if not text or now - ts < settle:
            continue
        who = m.get("username") or ""
        # Slackbot's channel-hygiene nags are structurally indistinguishable from a
        # person's last word; by name is the only way to drop them.
        if who.lower() == "slackbot":
            continue
        counterpart = next((x.get("username", "?") for x in dms
                            if (x.get("channel") or {}).get("id") == chan
                            and x.get("user") != me), "?")
        row = {"ref": "DM", "title": "", "asked": day_of(ts),
               "days": _days_since(day_of(ts)),
               "quote": _slack_text(text), "url": m.get("permalink", "")}
        if m.get("user") != me:
            dm_candidates.append({**row, "kind": "slack-dm", "who": who or "?"})
        elif text.rstrip().endswith("?"):
            they.append({**row, "kind": "slack-asked", "who": counterpart})
    you += _dm_needs_reply(dm_candidates)

    # And the one inferred entry: promises read out of your own words. Reuses the
    # from:me sweep already in hand, so commitments cost no extra Slack calls at all.
    you += ledger_commitments(mine)
    return they, you, True, complete


# ── what Slack decided, joined to the work it decided about ────────────────────────────
#
# The last lens, and the only one whose evidence exists nowhere else on this machine. The
# page can already read what the code says (branches, MRs, commits) and what the tickets
# say (Jira status, sprints) -- and both of those are records of decisions already taken.
# The taking happens in Slack, and a week later the only trace of "we agreed to drop the
# array_has calls" is thirty messages deep in #tech-backend.
#
# The privacy line the plan draws (Kean sync, 01:04:30) is satisfied by construction rather
# than by policy: only threads Kyle himself posted in, fetched with his own token, rendered
# on a page only he can open. There is no version of this that reads a room he was not in.
#
# WHAT THE TOKEN CAN ACTUALLY SEE, measured 2026-08-14 rather than assumed:
#
#   scopes            identify, channels:history, groups:history, channels:read,
#                     groups:read, search:read, users:read
#   channel threads   conversations.replies works. 68 of the 78 channel threads Kyle posted
#                     in over the window returned whole (has_more was false on every one)
#   DMs               missing_scope, needed im:history
#   group DMs         missing_scope, needed mpim:history -- the 10 of 78 that failed
#
# So the coverage question has a clean answer, and it decides the design. In a channel we
# hold every message; in a DM we hold only what search happened to return, which measured
# a median of about a fifth of the thread (1 of 86, 3 of 22, 15 of 34). A synthesis over a
# fifth of a conversation is not a partial synthesis, it is a wrong one -- the message that
# reverses the decision is exactly the one search did not return. So this synthesises only
# threads it holds whole, says how many it therefore left alone, and never hedges an item.
# The two scopes it lacks are the two most private places in Slack, which is a coincidence
# worth keeping.
#
# The join is measured too. Reading only what the sweeps already hold (free, no new call)
# joins 8 threads; reading each thread whole joins 18 of the same 68. More than half the
# joins are ticket keys somebody OTHER than Kyle typed, in a thread he replied to without
# repeating the key -- which is the normal shape of a conversation. So the fetch happens
# before the join, not after it, and costs 78 calls in 18s sequentially, a few seconds
# eight-wide.

SLACK_THREAD_CACHE = (Path(os.environ.get("XDG_STATE_HOME",
                                          Path.home() / ".local/state"))
                      / "work-arcs" / "slack-threads.json")

# A branch name is only usable as a join key if it could not plausibly be typed as prose.
# Measured on this repo: of 405 branches, 291 clear both bars, and the 114 that do not are
# almost all bare ticket keys (`UB-6802`) which the stronger ticket join already owns. What
# the bars keep out is `main`, `fix`, `wip` -- names that would attach "this is the main
# problem" to a workstream.
BRANCH_JOIN_MIN = 8
# Branch-shaped runs of text, to look up rather than to trust. Long enough to exclude
# ordinary words, and a lookup against real branch names does the actual deciding.
BRANCHY_RE = re.compile(r"[A-Za-z0-9][\w./-]{6,90}")


def _thread_join_index(arcs):
    """Every identifier that can attach a Slack thread to a workstream, and the arc it
    belongs to.

    Three kinds of key, and the order they are tried in is the order of how much a match
    proves. A ticket key is a name for the work itself. A branch name is a name for one
    piece of it, exact but only if the name is distinctive enough to survive being typed in
    a sentence. An MR iid is exact and narrow -- it identifies a proposal rather than the
    work, so it comes last.

    First arc wins each key, matching tickets_to_arcs: where two arcs both name a key the
    older mapping stands rather than flipping between runs.
    """
    tickets = tickets_to_arcs(arcs)
    branches, mrs = {}, {}
    for a in arcs:
        for b in a.get("branches", []):
            n = b["name"]
            if len(n) >= BRANCH_JOIN_MIN and re.search(r"[-_/.]", n):
                branches.setdefault(n.lower(), a)
        for m in a.get("mrs") or []:
            if m.get("iid") is not None:
                mrs.setdefault(str(m["iid"]), a)
    return {"tickets": tickets, "branches": branches, "mrs": mrs}


def _join_thread(text, index):
    """The arc a thread is about, how it was decided, and the identifier that decided it.

    Returns (arc, "ticket UL-1744", "UL-1744") or (None, "", "").

    A thread that names several arcs goes to the one it names most, because a passing
    cross-reference is one mention and the subject is usually more. A dead tie goes to
    whichever was mentioned first, and then -- because two arcs can be mentioned in the
    same sentence -- to the lower arc id, so the answer does not depend on the order arcs
    happen to arrive in. An unstable join would re-fingerprint a card's Slack block on
    alternate runs and quietly un-acknowledge it.
    """
    hits = {}   # arc id -> [count, first position, arc, how, token]

    def note(arc, how, token, at):
        h = hits.get(arc["id"])
        if h:
            h[0] += 1
            h[1] = min(h[1], at)
        else:
            hits[arc["id"]] = [1, at, arc, how, token]

    upper = text.upper()
    for m in TICKET_RE.finditer(upper):
        arc = index["tickets"].get(m.group(0))
        if arc:
            note(arc, "ticket", m.group(0), m.start())
    if not hits:
        for m in BRANCHY_RE.finditer(text):
            tok = m.group(0).lower().strip("./-")
            # `origin/UB-6802-fix` is how a branch is quoted half the time it is quoted at
            # all, and the remote prefix is not part of its name.
            for cand in (tok, tok.split("/", 1)[1] if tok.startswith("origin/") else tok):
                arc = index["branches"].get(cand)
                if arc:
                    note(arc, "branch", cand, m.start())
                    break
    if not hits:
        for m in MR_MENTION_RE.finditer(text):
            iid = m.group(1) or m.group(2)
            arc = index["mrs"].get(iid)
            if arc:
                note(arc, "mr", "!" + iid, m.start())
    if not hits:
        return None, "", ""
    n, at, arc, how, token = max(hits.values(), key=lambda h: (h[0], -h[1], h[2]["id"]))
    return arc, f"{how} {token}", token


def _thread_link(base, chan, ts, thread_ts=""):
    """A permalink for a message conversations.replies returned, which carries none.

    Slack's archive URL is derivable from the three ids, and derivable beats another API
    call: every item this feature renders has to link the message it quotes, and asking
    chat.getPermalink per message would be one call per rendered line.
    """
    link = f"{base}/archives/{chan}/p{ts.replace('.', '')}"
    if thread_ts and thread_ts != ts:
        link += f"?thread_ts={thread_ts}"
    return link


def _perma_id(url):
    """(channel, ts) out of a Slack archive permalink, or None.

    The identity of a message, for comparing two URLs that name it. Search writes
    `?thread_ts=…&cid=…` on the end and our own constructed links do not, so string
    equality would let the same message through twice -- once as a ledger row, once as a
    decision -- which is the same fact in two registers reading as two facts.
    """
    m = re.search(r"/archives/([A-Z0-9]+)/p(\d{10})(\d{6})", url or "")
    return (m.group(1), f"{m.group(2)}.{m.group(3)}") if m else None


def _ledger_permalinks(ledger):
    """Every Slack message the ledger already shows, as (channel, ts).

    Both directions and both fields: a commitment quotes the promise, and a commitment
    closed on evidence also quotes the message that closed it. Neither should come back as
    a decision -- "you said you'd rerun the job" and "he will rerun the job" are one fact,
    and the ledger's version has a clock on it.
    """
    seen = set()
    for e in ((ledger or {}).get("they_owe") or []) + \
             ((ledger or {}).get("you_owe") or []) + \
             ((ledger or {}).get("you_owe_closed") or []):
        for field in ("url", "closed_url"):
            pid = _perma_id(e.get(field))
            if pid:
                seen.add(pid)
    return seen


def _drop_seen(items, chan, seen):
    """Items whose message the ledger has not already spoken for."""
    return [i for i in items if (chan, i.get("ts")) not in seen]


SLACK_THREAD_PROMPT = """\
Below is one Slack thread from a channel at Kyle's work, in order, one numbered line per
message. It has already been matched to a piece of work he is doing: {arc}.

Answer two questions about this thread and nothing else.

DECIDED — what was settled here that somebody picking the work up would need to know: a
choice made, an approach ruled out, a cause identified, a number agreed, an owner named.

OPEN — what this thread raised and left standing: a question nobody answered, a blocker
still in the way, something explicitly put off.

At most two of each, and fewer is usually right. One good item beats two thin ones, and
nothing at all beats a guess — this is read months later to remember what happened, and an
invented decision is worse than a missing one. If you are unsure, leave it out.

Leave out:
- the thread's subject restated ("the team discussed the metric catalog")
- greetings, thanks, scheduling, who is out, anything social
- anything you have to infer more than one step to assert
- an OPEN item that a later message in this same thread answers
- a DECIDED item that no single message in the thread actually states
- anything an automated post announces: a merge request opened, a build, a deploy, a
  ticket created. "Kyle posted MR !10468" is not a decision, and the page it is going on
  already lists that merge request two lines above this
- somebody wondering aloud whether a thing is possible. That is an OPEN item at most, and
  usually nothing

Every item must name the ONE message number where the thing is said. If no single message
says it, it is not an item.

Reply with ONLY JSON, no prose:
{"decided": [{"what": "<one short sentence>", "i": <message number>}],
 "open": [{"what": "<one short sentence>", "i": <message number>}]}

Both lists may be empty, and often should be.

Thread:
{thread}
"""


def _synthesise_threads(items, ledger):
    """What each joined thread decided and left open, judged once per thread and cached.

    One model call per thread rather than one per arc, and that is a decision against the
    obvious batching. Batching an arc's three threads into one call saves two calls and
    costs the cache: the key would then cover all three, so one new message in one thread
    would invalidate the verdicts on the other two and re-pay for them. Over a sliding
    14-day window that is not an edge case, it is most days. Per-thread keys are what make
    a re-run free, and the calls run concurrently anyway, so the wall clock is one call
    either way.

    The permalink is not the model's to give. It returns a message NUMBER, and the quote
    and the link are then read out of the message list here -- so principle 5 ("no claim
    without its source one click away") is held by construction rather than trusted. An
    item naming a message that does not exist is dropped rather than rendered bare.

    The cache keys on the prompt and on every message in the thread, so a reworded question
    cannot reuse yesterday's answers (item 1c) and a thread that grew is a new question.
    Nothing is cached from a failed or unparseable call: the next run asks again rather than
    remembering an accident as a verdict.

    Extended thinking is left ON, and this is the obvious saving that must not be taken.
    Measured on three of the live threads, the same input twice: with thinking, output is
    1400-8900 tokens a call and the pass costs $0.13 a thread; with MAX_THINKING_TOKENS=0 it
    is 130-185 tokens and about $0.08. A third cheaper, and on the 34-message UB-6802 thread
    the cheap run reported "Sentry can't be used for repro data" as a DECISION, where the
    thread says only "I wonder if there are alternatives, or if we can hand roll stuff". A
    decision asserted where somebody merely wondered is exactly the failure this whole
    section is built to avoid -- one wrong claim costs more trust than ten right ones earn --
    and a third of $2 a day is not the price of buying it.
    """
    if not items:
        return []
    prompt_sha = hashlib.sha256(SLACK_THREAD_PROMPT.encode()).hexdigest()[:16]
    cache = load_store(SLACK_THREAD_CACHE, "the Slack thread synthesis cache")
    if cache.get("prompt") != prompt_sha:
        cache = {"prompt": prompt_sha, "verdicts": {}}
    verdicts = cache.setdefault("verdicts", {})

    def numbered(t):
        return "\n".join(
            f"[{i}] {_slack_text(m.get('text'))}" for i, m in enumerate(t["msgs"]))

    def key(t):
        body = "\x00".join(f"{m.get('ts','')}\x1f{m.get('text','')}" for m in t["msgs"])
        return hashlib.sha256(f"{t['arc']}\x00{body}".encode()).hexdigest()[:16]

    fresh = [t for t in items if key(t) not in verdicts]
    if fresh:
        model = os.environ.get("WORK_ARCS_SLACK_THREAD_MODEL",
                               os.environ.get("WORK_ARCS_COMMIT_MODEL", "sonnet"))
        print(f"  slack: reading {len(fresh)} thread(s) for what they decided ({model})",
              file=sys.stderr)

        def ask(t):
            prompt = (SLACK_THREAD_PROMPT
                      .replace("{arc}", t["arc"])
                      .replace("{thread}", numbered(t)))
            try:
                r = headless_claude.run(
                    ["--model", model, "--dangerously-skip-permissions", prompt],
                    timeout=180)
                if r.returncode != 0:
                    return None
                return json.loads(re.search(r"\{.*\}", r.stdout, re.S).group(0))
            except (OSError, subprocess.SubprocessError, ValueError,
                    AttributeError, TypeError):
                return None

        jobs = max(1, int(os.environ.get("WORK_ARCS_SLACK_THREAD_JOBS", "6")))
        with futures.ThreadPoolExecutor(max_workers=jobs) as pool:
            answers = list(pool.map(ask, fresh))
        wrote = False
        for t, ans in zip(fresh, answers):
            if not isinstance(ans, dict):
                continue
            keep = {}
            for side in ("decided", "open"):
                out = []
                for f in (ans.get(side) or [])[:6]:
                    try:
                        i, what = int(f["i"]), str(f.get("what", "")).strip()
                    except (KeyError, TypeError, ValueError):
                        continue
                    if what and 0 <= i < len(t["msgs"]):
                        out.append({"what": what[:160], "ts": t["msgs"][i].get("ts", "")})
                keep[side] = out[:2]
            verdicts[key(t)] = keep
            wrote = True
        if wrote:
            try:
                SLACK_THREAD_CACHE.parent.mkdir(parents=True, exist_ok=True)
                SLACK_THREAD_CACHE.write_text(json.dumps(cache))
            except OSError:
                pass

    seen = _ledger_permalinks(ledger)
    blocks = []
    for t in items:
        v = verdicts.get(key(t))
        if not isinstance(v, dict):
            continue
        by_ts = {m.get("ts"): m for m in t["msgs"]}
        sides = {}
        for side in ("decided", "open"):
            rows, used = [], set()
            for f in _drop_seen(v.get(side) or [], t["chan"], seen):
                m = by_ts.get(f.get("ts"))
                # One message states one thing per side. Two DECIDED items projecting the
                # same message are one decision the model split in half, and they render as
                # the identical quote twice under two headings -- which reads as the page
                # padding. Measured on the first live run: one block in eighteen, showing
                # `#1 design team is working on this #2 future ticket #3 I can't reproduce?`
                # three times over. Across sides is a different matter and stays: a message
                # can settle one thing and leave another standing.
                if not m or f.get("ts") in used:
                    continue
                used.add(f.get("ts"))
                rows.append({"what": f["what"],
                             "quote": _clip(_slack_text(m.get("text")), 220),
                             # Who said it, and their face where Slack gives us one. A
                             # quote with no name on it makes the reader work out whose
                             # voice it is from the words, four times a card.
                             **_person(m.get("user")),
                             "at": _slack_day(m.get("ts")),
                             "url": _thread_link(t["base"], t["chan"],
                                                 m.get("ts", ""), t["ts"])})
            sides[side] = rows[:2]
        if not (sides["decided"] or sides["open"]):
            continue
        last = t["msgs"][-1].get("ts", "")
        blocks.append({
            "arc": t["arc"], "arc_id": t.get("arc_id", t["arc"]),
            "chan": t["chan"], "channel": t["name"],
            "ts": t["ts"], "last_ts": last, "how": t["how"],
            "messages": len(t["msgs"]),
            "asked": datetime.fromtimestamp(float(last or 0)).strftime("%Y-%m-%d"),
            "url": _thread_link(t["base"], t["chan"], t["ts"]),
            "decided": sides["decided"], "open": sides["open"],
            # The thread and its last word, so a reply revives an acknowledged block: a ✕
            # means "I have read this thread", and a thread somebody has added to since is
            # not the thread that was read.
            "fp": _dfp("slack-thread", t["chan"], t["ts"], last)})
    return blocks


def _thread_messages(chan, ts):
    """A thread's messages, and whether they are all of them.

    Returns (messages, "whole" | "partial" | "denied" | "unknown"). The last two are the
    ones that matter downstream and they are not the same absence: "denied" is this token
    lacking im:history or mpim:history, which is permanent and structural -- that thread
    will never be a row, so nothing is missing from a run that skipped it. "unknown" is a
    timeout or a rate limit, where a row that should exist is absent and no one can say
    which, and an acknowledgement must not be pruned on that.
    """
    d = _slack_raw("conversations.replies", channel=chan, ts=ts, limit=200)
    if d is None:
        return [], "unknown"
    if not d.get("ok"):
        return [], "denied" if d.get("error") == "missing_scope" else "unknown"
    msgs = [m for m in (d.get("messages") or []) if (m.get("text") or "").strip()]
    msgs.sort(key=lambda m: float(m.get("ts") or 0))
    # Paged threads are excluded rather than paged. Measured, nothing in the window reaches
    # 200 messages; a thread that did would be a channel-wide argument rather than a
    # decision about one workstream, and half of one is the half that gets it wrong.
    return msgs, ("partial" if d.get("has_more") else "whole")


def slack_threads(arcs, ledger):
    """Attach to each workstream what the Slack threads about it decided and left open.

    Fills `arc["slack"]` and returns a report of what this cost and what it could not see.
    The report is the load-bearing part: these blocks are ✕-acknowledgeable, so a run that
    silently saw fewer threads than the last one would let apply_dismissals delete the
    acknowledgements on the ones that never arrived -- the exact failure the hardening pass
    closed for the ledger's own sweeps. `complete` here means every thread Kyle posted in
    was either read whole or refused for a reason that will refuse it forever.
    """
    report = {"consulted": False, "complete": True, "threads": 0, "readable": 0,
              "denied": 0, "unreadable": 0, "over_cap": 0, "joined": 0, "blocks": 0,
              "why": ""}
    if not os.environ.get("SLACK_USER_TOKEN"):
        report["why"] = "no Slack token"
        return report
    who = _slack("auth.test") or {}
    me = who.get("user_id")
    if not me:
        report.update(complete=False, why="Slack would not say who the token belongs to")
        print("  slack: no thread lens this run — Slack would not say who the token "
              "belongs to, and nothing is pruned on its absence", file=sys.stderr)
        return report
    report["consulted"] = True
    _, after = _slack_window()
    mine, ok_mine = _slack_sweep(f"from:<@{me}> after:{after}")
    if not ok_mine:
        report.update(complete=False, why="the from:me sweep did not finish")

    # Threads Kyle himself posted in, newest first -- the whole population this feature is
    # allowed to look at.
    order, base = [], ""
    threads = {}
    for m in sorted(mine, key=lambda m: -float(m.get("ts") or 0)):
        chan = (m.get("channel") or {}).get("id", "")
        if not chan:
            continue
        if not base:
            b = re.match(r"(https://[^/]+)/archives/", m.get("permalink") or "")
            base = b.group(1) if b else ""
        key = (chan, _thread_of(m))
        if key not in threads:
            name = (m.get("channel") or {}).get("name", "")
            if re.fullmatch(r"[UDW][A-Z0-9]{8,}", name or ""):
                name = ""
            threads[key] = {"chan": chan, "name": name, "ts": key[1]}
            order.append(key)
    report["threads"] = len(order)
    # The workspace address, which no message carries and every constructed link needs. Read
    # off any permalink search returned, so it costs nothing and cannot be misconfigured; the
    # loop above assigns `base` on whichever match has one, and it is stamped on the threads
    # afterwards because the first few may have been seen before it was known.
    if not base:
        report.update(complete=False,
                      why="no Slack permalink to read the workspace address from")
        return report
    for t in threads.values():
        t["base"] = base

    # DMs are refused before they are asked. This token holds channels:history and
    # groups:history and neither im:history nor mpim:history, so conversations.replies on a
    # `D…` channel is a certain missing_scope -- and measured, 141 of the 219 threads in the
    # window are DMs. Asking anyway would treble the Slack calls of this feature to be told
    # no 141 times. Group DMs cannot be recognised from their id (they are `C…` like any
    # channel), so those are found the only way available, by being refused.
    denied_upfront = [k for k in order if k[0].startswith("D")]
    report["denied"] += len(denied_upfront)
    order = [k for k in order if not k[0].startswith("D")]

    # A ceiling on the fetch, said out loud when it bites. 78 channel threads is what the
    # window holds today; a run that hits this has an incomplete Slack lens, and must say so
    # rather than look like a quiet fortnight.
    cap = int(os.environ.get("WORK_ARCS_SLACK_THREADS_MAX", "150"))
    if len(order) > cap:
        report["over_cap"] = len(order) - cap
        report["complete"] = False
        report["why"] = f"{len(order) - cap} thread(s) over the {cap}-thread ceiling"
        print(f"  slack: {len(order)} channel threads in the window, reading the {cap} "
              f"newest (WORK_ARCS_SLACK_THREADS_MAX) — the thread lens is incomplete "
              "this run", file=sys.stderr)
        order = order[:cap]

    jobs = max(1, int(os.environ.get("WORK_ARCS_SLACK_THREAD_JOBS", "6")))
    with futures.ThreadPoolExecutor(max_workers=jobs) as pool:
        fetched = list(pool.map(lambda k: _thread_messages(k[0], k[1]), order))

    # Names and faces first, because everything after this reads message text: the join, the
    # model prompt and the quote on the card. conversations.replies is the one Slack call
    # here that gives an author as a bare id, so without this pass the thread lens was the
    # one lens on the page whose quotes were attributed to nobody.
    _learn_people([m.get("user") for msgs, _ in fetched for m in msgs]
                  + [i for msgs, _ in fetched for m in msgs
                     for i in _ids_in(m.get("text"))])

    index = _thread_join_index(arcs)
    by_arc = defaultdict(list)
    for key, (msgs, how) in zip(order, fetched):
        if how == "denied":
            report["denied"] += 1
            continue
        if how != "whole":
            report["unreadable"] += 1
            report["complete"] = False
            continue
        report["readable"] += 1
        # Read whole, and holding nothing anyone could quote: a thread of attachment-only
        # messages, an alert with no caption. Counted with the outages -- as it was, for one
        # commit -- it made `complete` false, and that freezes the dismissal prune for every
        # universe on the page. Not for a run: forever, because such a thread is in the
        # window every day and comes back the same way every day. Measured, exactly one in
        # the live window, and one was enough.
        if not msgs:
            continue
        t = threads[key]
        arc, why, _ = _join_thread(
            " ".join(_slack_text(m.get("text")) for m in msgs), index)
        if not arc:
            continue
        report["joined"] += 1
        # The label is what the prompt is told the thread is about, because "UB-6802" or
        # "release notes cherry-pick" is what a reader would call the work; the id is what
        # the block is handed back on, because two arcs can carry the same label and only
        # the id is an identity.
        by_arc[arc["id"]].append({**t, "msgs": msgs, "arc": arc["label"],
                                  "arc_id": arc["id"], "how": why})
    if report["unreadable"]:
        report["why"] = (report["why"]
                         or f"{report['unreadable']} thread(s) Slack would not return")
        print(f"  slack: {report['unreadable']} thread(s) could not be read this run — "
              "the thread lens is incomplete, and nothing is pruned on its absence",
              file=sys.stderr)

    # One flat pass so every thread is judged in one pool, then handed back to its arc.
    flat = [t for key in sorted(by_arc) for t in by_arc[key]]
    blocks = _synthesise_threads(flat, ledger)
    on = defaultdict(list)
    for b in blocks:
        on[b["arc_id"]].append(b)
    for arc in arcs:
        got = on.get(arc["id"]) or []
        # Newest thread first, and a total tiebreak: two threads that end in the same second
        # must not swap places between runs, or their blocks re-fingerprint for nothing.
        got.sort(key=lambda b: (-float(b["last_ts"] or 0), b["chan"], b["ts"]))
        arc["slack"] = got
    report["blocks"] = len(blocks)
    return report


DISMISSED = (Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
             / "work-arcs" / "dismissed.json")


def _dfp(*parts):
    """A dismissable row's identity: the fact it asserts, not the day it was rendered.

    Built from everything that would change if the fact moved -- a re-requested review
    restarts its date, a new message replaces the quote, an answered thread changes the
    count in its own text -- and nothing that changes on its own (a `days` counter
    ticks daily). This is what makes a dismissal safe to persist: it acknowledges THIS
    fact, and dies with it.
    """
    h = hashlib.sha256("|".join(str(p or "") for p in parts).encode())
    return h.hexdigest()[:16]


def _ledger_fp(e):
    return _dfp(e.get("kind"), e.get("ref"), e.get("url"),
                e.get("asked"), e.get("quote"))


def apply_dismissals(ledger, arcs=None, gap=None, prune=False):
    """Acknowledged rows stay counted but stop shouting, until their fact moves.

    The plan's principle 1 names this the one safe form of persisted human input: a
    content-fingerprinted acknowledgement expires itself. An entry whose fingerprint no
    longer matches any live row is deleted on sight -- either the loop closed (nothing
    to show) or the fact changed (a new row, undismissed, takes its place).

    One store for every dismissable thing -- ledger rows, an arc's demands, an arc's Slack
    thread blocks, a Jira status-mismatch row -- so the page and the CLI cannot disagree
    about what has been acknowledged. Pruning only runs when every universe was actually
    computed this run:
    a --no-mr run sees no ledger rows, and deleting their acknowledgements for that
    would punish a cheap run for being cheap.

    "Actually computed" has to mean completely, not attempted, and for two releases it
    meant attempted. The gate read `ledger and gap is not None and args.json` -- and a
    ledger dict is truthy whether or not its Slack half arrived. So a token that expired
    between auth.test and the first search, or a rate limit between page 1 and page 2,
    produced a ledger whose Slack rows were quietly absent, and this function then deleted
    every acknowledgement on them while printing "the fact under it moved" about facts it
    had not managed to read. The next good run brought the rows back undismissed, which is
    the one thing a dismissal is supposed to be safe from. `ledger["slack"]` now reports
    completeness rather than attempt, and the caller ANDs it into the gate.

    An acknowledged demand still decides the arc's stage and urgency -- a click must
    never change what is derived, only what shouts -- but it does leave `notify`: news
    you have acknowledged is no longer news.
    """
    store = load_store(DISMISSED, "the dismissal store")
    live = {}
    for e in (ledger["they_owe"] + ledger["you_owe"]) if ledger else []:
        live[e["fp"]] = e
    for arc in arcs or []:
        for d in arc.get("demands", []):
            if d.get("fp"):
                live[d["fp"]] = d
        # And the Slack blocks, one acknowledgement per thread rather than per item: a ✕
        # there means "I have read this thread", and reading it is one act. Its fingerprint
        # carries the thread's last message, so a reply revives the whole block.
        for s in arc.get("slack") or []:
            if s.get("fp"):
                live[s["fp"]] = s
    for m in (gap or {}).get("status_mismatch") or []:
        if m.get("fp"):
            live[m["fp"]] = m
    # Only a positive verdict is dismissable. The negative ones exist so a consumer can ask
    # why an arc was *not* called forgotten, and there is nothing there to acknowledge --
    # putting them in this universe would fill the store with rows nobody can ever click.
    for arc in arcs or []:
        f = (arc.get("activity") or {}).get("forgotten") or {}
        if f.get("verdict") and f.get("fp"):
            live[f["fp"]] = f
    if prune:
        expired = {k: v for k, v in store.items() if k not in live}
        for k, v in expired.items():
            del store[k]
            print(f"  dismissal of {v.get('ref', k)} expired — the fact under it "
                  "moved", file=sys.stderr)
        if expired:
            try:
                DISMISSED.write_text(json.dumps(store, indent=1, sort_keys=True))
            except OSError:
                pass
    for k in store:
        if k in live:
            live[k]["dismissed"] = True
    for arc in arcs or []:
        arc["notify"] = [d for d in arc.get("notify", [])
                         if not d.get("dismissed")]


def set_dismissed(ledger, spec, undo=False):
    """`--dismiss REF[=note]` / `--undismiss REF`, stamped with the row it acknowledges."""
    label, _, note = spec.partition("=")
    label = label.strip()
    rows = ledger["they_owe"] + ledger["you_owe"]
    match = [e for e in rows if e.get("ref") == label or e["fp"].startswith(label)]
    if not match:
        sys.exit("work-arcs: no ledger row matches " + repr(label) + "\n  "
                 + "\n  ".join(f"{e['ref']:<16} {e['fp']}  {e.get('kind','')}"
                               for e in rows))
    store = load_store(DISMISSED, "the dismissal store")
    for e in match:
        if undo:
            store.pop(e["fp"], None)
        else:
            store[e["fp"]] = {"ref": e["ref"], "at": int(time.time()),
                              "note": note.strip()}
    n = len(match)
    if undo:
        print(f"✓ {n} row{'' if n == 1 else 's'} back on the ledger", file=sys.stderr)
    else:
        print(f"✓ acknowledged {n} row{'' if n == 1 else 's'} ({label})",
              file=sys.stderr)
        print("  comes back on its own the moment the fact under it changes — "
              f"{DISMISSED}", file=sys.stderr)
    DISMISSED.parent.mkdir(parents=True, exist_ok=True)
    DISMISSED.write_text(json.dumps(store, indent=1, sort_keys=True))


def build_ledger(repo, mrs, meetings=True):
    """The waiting-on ledger, both directions, every row a counterparty and a clock.

    This is what todo.md was actually for. The load-bearing entries there were `blocked
    by neville` and `waiting on Logan` -- open loops with a person on the other end --
    and the file rotted because the part worth writing by hand is exactly the part that
    changes most often. Every row here is derived, so it vanishes the moment the other
    person moves: Neville replies, the row is gone, and nothing was checked off.

    GitLab and Jira only, deliberately -- facts, no model judgment, so no false-positive
    risk on claims of the form "you owe X". An unanswered thread on your own MR appears
    both here and as a demand on its workstream, on purpose: the demand is the
    by-workstream view and the ledger is the by-person one, and leaving threads out of
    the ledger made "you owe them" read as nothing but a review queue -- which was
    noticed within the hour. Deliberately absent: your own assigned-but-stalled tickets.
    The mirror of "I filed this with you" is not "somebody filed this near me" -- a
    backlog is not a personal debt, and rendering 30 idle tickets as debts to their
    reporters would drown the three rows that are.
    """
    me = gitlab_me(repo)
    if not me:
        # glab can die between collect_mrs and here -- a token refresh, a network blip --
        # and "who am I" is what both GitLab halves are built on. Without it they are
        # unknown rather than empty, and the difference decides whether a dismissal on
        # one of their rows may be pruned.
        print("  ledger: GitLab would not say who you are — both GitLab sides of the "
              "ledger are absent this run, not empty", file=sys.stderr)
    # The three sources share nothing, so they run at once -- measured serially they cost
    # 14s of wall clock, which is most of the whole tool's budget spent on one section.
    with futures.ThreadPoolExecutor(max_workers=4) as pool:
        f_they = pool.submit(ledger_they_owe, repo, mrs, me) if me else None
        f_you = pool.submit(ledger_you_owe, repo, me) if me else None
        f_jira = pool.submit(ledger_jira_stalled)
        f_slack = pool.submit(ledger_slack)
        # The one source that reaches outside GitLab, Jira and Slack. It is submitted here
        # rather than run as its own stage for the sake of `complete` below: pruning a
        # dismissal deletes an acknowledgement on the grounds that its row is gone, and a
        # meeting sweep that half-answered cannot support that claim about anything. A
        # collector outside this pool could not contribute to that conjunction, and a
        # meeting row's acknowledgement would then be pruned on a run that never looked.
        f_meet = pool.submit(ledger_meetings) if meetings else None
        they, they_whole = f_they.result() if f_they else ([], False)
        you, covered, you_whole = f_you.result() if f_you else ([], 0, False)
        jira_rows, jira_whole = f_jira.result()
        they += jira_rows
        slack_they, slack_you, slack_seen, slack_whole = f_slack.result()
        they += slack_they
        you += slack_you
        # --no-meetings is (True) for the same reason no Slack token is: there are no
        # meeting rows and there never were, so nothing is missing and a prune is safe.
        meet_rows, meet_whole = f_meet.result() if f_meet else ([], True)
        you += meet_rows
    # Questions on your own MRs that the reviewer is still waiting on. Already fetched
    # and already judged by unresolved_threads -- whoever spoke last says whose turn it
    # is -- so this costs nothing and cannot disagree with the card.
    for m in mrs:
        for t in m.get("threads") or []:
            if t.get("answered"):
                continue
            at = t.get("last_at") or t.get("at") or ""
            you.append({"kind": "thread-reply", "ref": f"!{m.get('iid')}",
                        "title": m.get("title", ""),
                        "who": t.get("last_by") or t.get("author") or "?",
                        "asked": at, "days": _days_since(at),
                        "quote": t.get("quote", ""), "url": m.get("url", "")})
    they.sort(key=lambda e: (-(e.get("days") or 0), e["ref"]))
    you.sort(key=lambda e: (-(e.get("days") or 0), e["ref"]))
    for e in they + you:
        e["fp"] = _ledger_fp(e)
    return {"they_owe": they, "you_owe": you, "you_owe_covered": covered,
            # Always present when the ledger is, empty or not, because a --json consumer
            # cannot tell a missing key from "nothing closed" and would have to guess.
            # close_commitments fills it; see there for why it cannot be filled here.
            "you_owe_closed": [], "slack": slack_seen,
            # Whether the Slack rows above are all of them. Separate from `slack` because
            # "not consulted" and "consulted and half-answered" support opposite decisions
            # about pruning an acknowledgement -- see ledger_slack's return contract.
            "slack_complete": slack_whole,
            # And the same question about the ledger as a whole: did every source it draws
            # on answer for everything it holds. This is what the dismissal prune is gated
            # on, because pruning deletes an acknowledgement on the grounds that its row is
            # gone, and a source that half-answered cannot support that claim about
            # anything. Four independent doors were open to it -- glab refusing `user`,
            # glab refusing one MR's notes, Jira timing out, Slack losing a page -- and all
            # four looked from here exactly like a quiet week.
            "complete": bool(they_whole and you_whole and jira_whole
                                and slack_whole and meet_whole)}


# `!10481` as it is written in prose, and the merge request URL that carries the same
# number. The lookbehind keeps `foo!10481` and `wow!!10481` out while letting `(!10481)`
# and `see !10481` in, and three digits is the floor because `!5` is punctuation here.
MR_MENTION_RE = re.compile(r"(?<![\w!])!(\d{3,6})\b|/merge_requests/(\d{3,6})\b")


def jira_status_moves(keys):
    """For a handful of ticket keys: their status now, its category, and when it moved.

    Its own call rather than a join onto `collect_jira`'s list, for the two things that
    list cannot carry. It asks for `statusCategory != Done`, so a ticket that reached
    Done -- the only status move that can close a promise -- is absent from it by
    construction, and an absence is not evidence: a key missing from that list is equally
    a ticket reassigned to somebody else. And it carries `updated`, which moves when
    anyone edits a label; `statuscategorychangedate` is the only field that dates the
    move itself, which is what "moved status AFTER the commitment" needs.

    One GET per key rather than one `key in (...)` JQL, because a single key that does
    not exist makes the whole JQL a 400 and would take the other keys' answers down with
    it. Bounded, and only called with keys a commitment actually names, so on a normal
    day this is nothing or one call.
    """
    domain = os.environ.get("JIRA_DOMAIN")
    email = os.environ.get("JIRA_EMAIL")
    token = os.environ.get("JIRA_API_TOKEN")
    keys = list(keys)[:int(os.environ.get("WORK_ARCS_CLOSE_KEYS", "8"))]
    if not (domain and email and token and keys):
        return {}
    auth = base64.b64encode(f"{email}:{token}".encode()).decode()

    def one(key):
        url = (f"https://{domain}/rest/api/3/issue/{urllib.parse.quote(key)}"
               "?fields=status,statuscategorychangedate,resolutiondate")
        req = urllib.request.Request(url, headers={"Accept": "application/json"})
        req.add_header("Authorization", f"Basic {auth}")
        try:
            with urllib.request.urlopen(req, timeout=20) as r:
                d = json.load(r)
        except (urllib.error.URLError, json.JSONDecodeError, TimeoutError, OSError):
            return None
        f = d.get("fields") or {}
        status = (f.get("status") or {})
        moved = f.get("statuscategorychangedate") or f.get("resolutiondate") or ""
        return {"key": key, "status": status.get("name", ""),
                "category": ((status.get("statusCategory") or {}).get("name") or ""),
                "moved": moved,
                "url": f"https://{domain}/browse/{key}"}

    with futures.ThreadPoolExecutor(max_workers=4) as pool:
        return {d["key"]: d for d in pool.map(one, keys) if d}


def close_commitments(ledger, fates):
    """Take off the ledger the promises that can be shown to have been kept.

    The gap this closes: nothing noticed the promised thing being *done*, so a commitment
    row aged out through the 14-day Slack window instead of through its own fulfilment.
    A row that outlives the promise it is about is a wrong reminder, and those cost more
    trust than ten right ones earn -- the reader learns that the list contains stale
    things, and from then on reads none of it carefully.

    Three signals, cheapest first, and the order is also strongest-first by accident of
    what is cheap:

    1. You said so yourself, in the same conversation. Free -- `_commitment_delivered`
       has already run inside the ledger build off the `from:me` sweep -- and it arrives
       here as `closed_by` already set.
    2. The merge request you named merged after you promised. No call at all: the fates
       of every MR you have ever opened are already in hand for the branch list, so this
       is a join. Merged only, never closed: a closed MR is work abandoned, which is the
       opposite of a promise kept.
    3. The ticket you named reached Done after you promised. One small Jira call, and
       only for keys a surviving row actually names.

    Done, and not merely "moved". Jira's three status categories make the line clean: To
    Do -> In Progress is the promise being *worked*, not kept, and a reminder that dies
    when you start the thing would delete itself at the exact moment it became true. So
    only the category reaching Done counts, and only strictly after the promise -- a
    ticket already Done when the promise was made is evidence about something else, and
    with `asked_ts` and `statuscategorychangedate` both carrying real instants, a promise
    kept the same afternoon is still orderable.

    REMOVED, not dismissed. A dismissal is a human saying "I know"; this is the tool
    saying "it happened", and the two must not share a store -- an acknowledgement
    expires when its fact changes, whereas a derivation has no fact left to expire. The
    row leaves `you_owe` and lands in `you_owe_closed` with the evidence that removed it,
    so --json, the page and any later audit can all ask why a reminder is gone. Nothing
    about the surviving rows changes, fingerprints included.
    """
    if not ledger:
        return
    rows = ledger.get("you_owe") or []
    commits = [e for e in rows if e.get("kind") in COMMITMENT_KINDS]
    ledger.setdefault("you_owe_closed", [])
    if not commits:
        return

    # Merged MRs by iid, out of the branch-keyed fates already collected. Only ever the
    # ones you opened yourself, which is the safe half anyway: for somebody else's MR
    # there is no fate here and the row correctly stands.
    merged = {}
    for f in (fates or {}).values():
        if f.get("iid") and f.get("state") == "merged":
            merged[int(f["iid"])] = f

    def refs(e):
        text = f"{e.get('quote','')} {e.get('promised','')}"
        iids = {int(a or b) for a, b in MR_MENTION_RE.findall(text)}
        keys = {m.group(0) for m in TICKET_RE.finditer(text.upper())}
        return iids, keys

    open_rows = [e for e in commits if not e.get("closed_by")]
    for e in open_rows:
        iids, _ = refs(e)
        at = float(e.get("asked_ts") or _day_epoch(e.get("asked", "")))
        for iid in sorted(iids):
            f = merged.get(iid)
            when = _iso_epoch(f.get("at_ts") or f.get("at")) if f else 0
            if not f or when <= at:
                continue
            late = max(0, int((when - at) // 86400))
            e["closed_how"] = "mr"
            e["closed_ts"] = float(when)
            e["closed_by"] = (f"!{iid} merged "
                              + ("the same day" if late == 0 else f"{late}d after"))
            e["closed_url"] = f.get("url", "")
            break

    still = [e for e in open_rows if not e.get("closed_by")]
    wanted = sorted({k for e in still for k in refs(e)[1]})
    moves = jira_status_moves(wanted) if wanted else {}
    for e in still:
        at = float(e.get("asked_ts") or _day_epoch(e.get("asked", "")))
        for key in sorted(refs(e)[1]):
            d = moves.get(key)
            if not d or (d.get("category") or "").strip().lower() != "done":
                continue
            when = _iso_epoch(d.get("moved"))
            if when <= at:
                continue
            late = max(0, int((when - at) // 86400))
            e["closed_how"] = "ticket"
            e["closed_ts"] = float(when)
            e["closed_by"] = (f"{key} moved to {d.get('status') or 'Done'} "
                              + ("the same day" if late == 0 else f"{late}d after"))
            e["closed_url"] = d.get("url", "")
            break

    closed = [e for e in commits if e.get("closed_by")]
    if not closed:
        return
    ledger["you_owe"] = [e for e in rows
                        if not (e.get("kind") in COMMITMENT_KINDS
                                and e.get("closed_by"))]
    ledger["you_owe_closed"] = closed
    for e in closed:
        print(f"  commitment closed on evidence: “{(e.get('promised') or '')[:40]}” — "
              f"{e['closed_by']}", file=sys.stderr)


def annotate_stacks(repo, mrs, main_ref):
    """For an MR aimed at another branch rather than main: what it waits on, and whether it
    could simply go onto main instead.

    "!10269 is approved and still open — merge it" was wrong advice, and wrong in the way
    that costs a day rather than a click: merging it would have merged UL-1633 into
    UL-1692, whose own MR !10398 is open, unapproved, and carrying four unresolved review
    threads. Approved work sat there looking one button from landing while the button did
    something else. The target branch was already being collected and never read.

    The escape hatch is the part worth deriving automatically, because it is what nobody
    checks by hand. A three-way merge with the current target as the base replays exactly
    the commits this MR adds and nothing underneath them, so "could this be rebased onto
    main" is answerable with no worktree, no checkout and no rebase attempted. Measured
    here: !10269 is one commit and lands clean, !10398 is twenty-one and lands clean, and
    !10419 hits three conflicts — which is the difference between "retarget it now" and
    "this one really is stacked".

    Nothing is asserted where the refs are missing: a target that is not on the remote
    cannot be compared against, and an unknown is recorded as an unknown.

    What it waits on is asked of GitLab rather than of the MR list already in hand. That
    list is `scope=created_by_me`, and a branch you stacked onto is very often not yours --
    !10398 waits on !10407 and !10419 on !10380, both somebody else's, and looking only at
    your own open MRs reported each of them as blocked by nothing at all.
    """
    main_branch = main_ref.split("/")[-1]
    by_source = {m.get("branch"): m for m in mrs}
    for m in mrs:
        tgt, src = m.get("target") or "", m.get("branch") or ""
        if not tgt or not src or tgt == main_branch:
            continue
        src_ref, tgt_ref = f"origin/{src}", f"origin/{tgt}"
        if not all(git(repo, "rev-parse", "--verify", "-q", r).strip()
                   for r in (src_ref, tgt_ref)):
            continue
        blocker = by_source.get(tgt)
        if blocker is None:
            found = glab(repo, f"projects/:id/merge_requests?source_branch="
                               f"{urllib.parse.quote(tgt, safe='')}&state=all&per_page=20")
            # An open one is what is actually in the way; a merged one means the target has
            # already landed and this MR is simply pointed at a stale branch.
            for want in ("opened", "merged", "closed"):
                hit = next((x for x in (found or []) if x.get("state") == want), None)
                if hit:
                    blocker = {"iid": hit.get("iid"),
                               "approved": (hit.get("detailed_merge_status")
                                            or "") == "mergeable",
                               "state": want}
                    break
        r = subprocess.run(["git", "-C", str(repo), "merge-tree", "--write-tree",
                            f"--merge-base={tgt_ref}", main_ref, src_ref],
                           capture_output=True, text=True)
        # 0 clean, 1 conflicted, anything else is git failing rather than answering.
        clean = r.returncode == 0 if r.returncode in (0, 1) else None
        paths = sorted({ln.split(" in ", 1)[-1].strip() for ln in r.stdout.splitlines()
                        if ln.startswith("CONFLICT")})
        m["stack"] = {
            "target": tgt,
            "blocked_by": blocker.get("iid") if blocker else None,
            "blocker_approved": bool(blocker.get("approved")) if blocker else None,
            "blocker_state": (blocker.get("state", "opened") if blocker else None),
            "own": len(lines(git(repo, "rev-list", f"{tgt_ref}..{src_ref}"))),
            "rebase_clean": clean,
            "conflicts": paths[:8],
        }


def collect_mrs(repo, deep=True):
    """Open MRs of mine, with enough state to say whose court the ball is in.

    The list call already carries most of it -- conflicts, merge state, reviewers,
    approvals -- and the previous version read four fields out of forty-eight. What it
    cannot carry is unresolved threads and pipeline status, so those are fetched per MR,
    threaded, and gated: threads only where the MR has user notes at all, which on 19 open
    MRs is 3 of them.

    `with_merge_status_recheck=true` is deliberately NOT passed. It looks like the way to
    resolve the eight MRs reading `unchecked`, and instead it discards the cached verdict
    and returns `checking` -- measured, it turned !10391's known `conflict` into an
    unknown. An unknown is reported as unknown rather than guessed at.
    """
    if not shutil.which("glab"):
        return [], "glab not installed"
    raw = glab(repo,
               "projects/:id/merge_requests?scope=created_by_me&state=opened&per_page=100")
    if raw is None:
        return [], "glab could not read merge requests"
    mrs = []
    for m in raw:
        state = m.get("detailed_merge_status") or m.get("merge_status") or ""
        mrs.append({
            "iid": m.get("iid"),
            "title": m.get("title", ""),
            "branch": m.get("source_branch", ""),
            "target": m.get("target_branch", ""),
            "notes": m.get("user_notes_count", 0),
            "draft": bool(m.get("draft") or m.get("work_in_progress")),
            "updated": m.get("updated_at", ""),
            "url": m.get("web_url", ""),
            "sha": (m.get("sha") or "")[:9],
            "merge_state": state,
            # A conflict is asserted by either field; `has_conflicts` was False on
            # !10391 while detailed_merge_status already said `conflict`.
            "conflicts": bool(m.get("has_conflicts")) or state == "conflict",
            "approved": state == "mergeable",
            "reviewers": [r.get("username", "") for r in (m.get("reviewers") or [])],
            # Assignees, because "who has this" is answered by either field and a project
            # can use either. An MR nobody is named on is the thing worth knowing, and
            # reading only one of the two fields would assert it on half the evidence.
            "assignees": [x.get("username", "") for x in (m.get("assignees") or [])],
            "approvals": m.get("upvotes", 0),
            "threads": [],
            "pipeline": None,
        })
    if not deep or not mrs:
        return mrs, None

    me = gitlab_me(repo)

    def enrich(mr):
        if mr["notes"]:
            mr["threads"] = unresolved_threads(repo, mr["iid"], me)
        pipes = glab(repo, f"projects/:id/merge_requests/{mr['iid']}/pipelines?per_page=1")
        if pipes:
            mr["pipeline"] = {"status": pipes[0].get("status", ""),
                              "url": pipes[0].get("web_url", ""),
                              "at": (pipes[0].get("updated_at") or "")[:10]}
        # The two-pass answer to `unchecked`. The flag on the LIST call was measured making
        # things worse -- it discards every cached verdict and returns `checking`, turning
        # !10391's known `conflict` into an unknown. But an MR that reads `unchecked` HAS no
        # cached verdict to lose, so asking GitLab to compute one costs nothing and cannot
        # lie. The response still says `checking`, so it is thrown away: the point is that
        # the verdict exists by the NEXT run. A recheck triggered on one run is answerable
        # on the next, which is the only shape of fix the measurement left open.
        if mr.get("merge_state") in ("", "unchecked"):
            glab(repo, f"projects/:id/merge_requests/{mr['iid']}"
                       "?with_merge_status_recheck=true")
            mr["recheck_requested"] = True

    with futures.ThreadPoolExecutor(max_workers=8) as pool:
        list(pool.map(enrich, mrs))
    rechecked = sum(1 for m in mrs if m.get("recheck_requested"))
    if rechecked:
        print(f"  {rechecked} MR(s) had no cached mergeability verdict; a recheck was "
              "requested, so the next run will know", file=sys.stderr)
    return mrs, None


# Statuses that assert the work has left your hands. If a ticket claims one of these
# while its branch still holds unpushed commits, Jira is describing a world that does
# not exist -- which is the whole thing this reconciliation is for.
HANDED_OFF = {"in review", "mr", "in qualification", "releasing", "ready for review",
              "code review", "qa", "in qa", "verifying"}

# The subset of those where somebody is testing the branch *right now*, and the merge is
# the thing they are testing towards. Here qualification happens before the merge, not
# after it: of the eleven MRs merged in the last ten days, every ticket that reached
# In Qualification reached it before its own merge, never after -- UL-1773's moved at
# 19:41 on the 5th and its !10391 was approved at 23:04 the same evening. So an approval
# on a ticket in this set is not a cue to merge; it is a cue to wait for a verdict.
#
# Deliberately not all of HANDED_OFF. `releasing` and `done` sit on the far side of the
# merge, so an open MR under those is a real contradiction and still worth shouting
# about, and `passed qa` is exactly the moment the ball comes back -- matched whole
# rather than by substring so it does not get swept up with `qa`.
QUALIFYING = {"in qualification", "qualification", "qa", "in qa", "verifying",
              "in verification", "testing", "in testing"}


def mr_ticket(mr):
    """The ticket a merge request is about: its branch first, its title second.

    Per-MR rather than per-arc, because an arc holds several of each. This one's arc
    carries fifteen branches and two MRs, and asking "is this arc in QA" would have
    silenced the Playwright MR's demands on the strength of a ticket that has nothing
    to do with it.
    """
    for text in (mr.get("branch") or "", mr.get("title") or ""):
        m = TICKET_RE.search(text.upper())
        if m:
            return m.group(0)
    return None


def collect_jira():
    """Open issues assigned to me. Jira is the declared picture of my work."""
    domain = os.environ.get("JIRA_DOMAIN")
    email = os.environ.get("JIRA_EMAIL")
    token = os.environ.get("JIRA_API_TOKEN")
    if not (domain and email and token):
        return [], "JIRA_DOMAIN / JIRA_EMAIL / JIRA_API_TOKEN not set in .env"
    url = (f"https://{domain}/rest/api/3/search/jql"
           "?jql=" + urllib.parse.quote(
               "assignee = currentUser() AND statusCategory != Done ORDER BY updated DESC")
           + "&fields=key,summary,status,updated,priority&maxResults=100")
    req = urllib.request.Request(url, headers={"Accept": "application/json"})
    auth = base64.b64encode(f"{email}:{token}".encode()).decode()
    req.add_header("Authorization", f"Basic {auth}")
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            raw = json.load(r)
    except (urllib.error.URLError, json.JSONDecodeError, TimeoutError) as e:
        return [], f"could not reach Jira: {e}"
    issues = []
    for i in raw.get("issues", []):
        f = i.get("fields", {})
        status = (f.get("status") or {}).get("name", "")
        issues.append({
            "key": i.get("key", ""),
            "summary": " ".join((f.get("summary") or "").split()),
            "status": status,
            "handed_off": status.strip().lower() in HANDED_OFF,
            "updated": (f.get("updated") or "")[:10],
            # The link belongs with the ticket, not with whatever renders it. Only this
            # function knows the Jira domain, and a page that has to reconstruct the URL
            # from a key is a page that will get it wrong for one project.
            "url": f"https://{domain}/browse/{i.get('key','')}",
        })
    return issues, None


# How long a sprint arc may sit still before the page says so. Five days is a working
# week: inside a two-week sprint it is half the sprint gone with nothing to show, which
# is the point at which the fact is worth a line and not before.
SPRINT_IDLE_DAYS = int(os.environ.get("WORK_ARCS_SPRINT_IDLE_DAYS", "5"))

# What a Sprint field *is*, as opposed to what it is called or where it happens to live.
# Jira Cloud assigns Sprint a per-instance customfield id -- customfield_10018 on this
# instance, customfield_10020 on a stock site -- so a hardcoded id is a bug that reports
# "no sprint" forever on anybody else's Jira and looks exactly like an empty backlog. The
# name is no better an identity: an admin can rename a field, and some instances carry
# more than one thing called Sprint. The greenhopper schema tag is what survives both.
SPRINT_SCHEMA = "com.pyxis.greenhopper.jira:gh-sprint"


def _jira_get(path, params=None):
    """One authenticated GET against the Jira REST API, or None.

    New code only -- collect_jira and collect_initiatives each predate this and each
    build the request by hand. Left alone deliberately: they work, and rewriting two
    proven callers to save a dozen lines is how a working Jira integration acquires a
    bug on a morning when nobody is reading the page.
    """
    domain = os.environ.get("JIRA_DOMAIN")
    email = os.environ.get("JIRA_EMAIL")
    token = os.environ.get("JIRA_API_TOKEN")
    if not (domain and email and token):
        return None
    url = f"https://{domain}/rest/api/3/{path}"
    if params:
        url += "?" + urllib.parse.urlencode(params)
    req = urllib.request.Request(url, headers={"Accept": "application/json"})
    auth = base64.b64encode(f"{email}:{token}".encode()).decode()
    req.add_header("Authorization", f"Basic {auth}")
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.load(r)
    except (urllib.error.URLError, json.JSONDecodeError, TimeoutError, ValueError):
        return None


def _sprint_field():
    """The id of this instance's Sprint field, discovered rather than assumed.

    Measured against urbanlogiq.atlassian.net on 2026-08-14: `GET /rest/api/3/field`
    returns 143 fields in 48KB and 0.29s, and exactly one of them carries the
    greenhopper schema -- `customfield_10018`, named "Sprint". One call, no disk cache:
    a third of a second is not worth buying with a staleness bug, and this sits beside a
    pipeline that already spends minutes.
    """
    for f in _jira_get("field") or []:
        if ((f.get("schema") or {}).get("custom") or "") == SPRINT_SCHEMA:
            return f.get("id")
    return None


def _sprint_end(iso):
    """Jira's sprint endDate as the sprint's last *day*.

    The field is the instant the sprint closes, not the last day of it: this sprint is
    named "Aug 10 - Aug 21, 2026" and stamps `2026-08-22T07:00:00.000Z`, which is
    midnight on the 22nd in this timezone -- an exclusive boundary. Printing that date
    would put the page a day out of step with the name Jira itself gives the sprint, on
    every sprint, forever. So a boundary landing exactly on local midnight is walked
    back a day and anything else is taken as it stands, which is the only reading that
    covers a sprint configured to end at 5pm on the Friday.
    """
    try:
        dt = datetime.fromisoformat((iso or "").replace("Z", "+00:00")).astimezone()
    except ValueError:
        return None
    if (dt.hour, dt.minute, dt.second) == (0, 0, 0):
        dt = datetime.fromtimestamp(dt.timestamp() - DAY)
    return dt.strftime("%Y-%m-%d")


def collect_sprint():
    """The tickets the current sprint says are mine, as the declared plan for the fortnight.

    The page already answers "what have I been doing" from the derived evidence and
    "what is assigned to me" from Jira. Neither answers "what am I supposed to be doing
    *this sprint*", because an assignee list is a backlog: 21 of these tickets are open
    against me and the sprint claims 21 of them for the next ten working days.

    ON THE JQL, WHICH IS NOT THE ONE THE PLAN GUESSED. `sprint in openSprints() AND
    project in (SBX, UL)` was the assumed shape; measured, it returns the entire team's
    board -- 100 issues (the page cap, so more) across twelve assignees, of which
    fourteen are mine. That is somebody else's sprint, and rendering it on a page about
    one person's work is both wrong and a small privacy leak. Two further facts kill the
    project axis outright: SBX has *no sprints at all* (`project = SBX AND sprint is not
    EMPTY` returns nothing, and nothing in SBX is assigned to me -- it is the initiative
    project, as collect_initiatives already says), and my own sprint work spans UL *and*
    UB, so a project list built for this would have had to differ from JIRA_PROJECTS
    anyway. `assignee = currentUser()` is narrower, needs no list to maintain, and is
    the axis the whole page is already about.

    ON PLURALITY. There is not one active sprint. Measured: "Aug 10 - Aug 21, 2026 (UL)"
    and "Aug 10 - Aug 21, 2026 (UB)" run concurrently on two boards over the same dates,
    holding 19 and 2 of my tickets. So the boards are kept and the displayed name is the
    one they agree on once the board suffix comes off -- and where they do not agree,
    every name is printed rather than one being picked, because "which sprint am I in"
    answered with a coin toss is worse than answered with two names.

    ON THE FIELD BEING A HISTORY. The Sprint field holds every sprint an issue has ever
    been in, closed ones included -- these 21 issues carry ten distinct sprints between
    them, back to May. Only `state == "active"` entries are the current sprint. Reading
    the array's last element instead, which is the obvious shortcut, would have been
    right here and wrong the first time a ticket was pulled forward.

    Done tickets are kept rather than filtered, unlike collect_jira's list: the sprint's
    own arithmetic needs them (four of mine are Done), and a ticket that is finished and
    has no branch left on this laptop is a success, not a gap.

    Returns None -- never a half-built dict -- when there is no Jira, no Sprint field or
    no open sprint. The strip that renders this is absent in exactly those cases.
    """
    field = _sprint_field()
    if not field:
        return None
    raw = _jira_get("search/jql", {
        "jql": "sprint in openSprints() AND assignee = currentUser()",
        "fields": f"key,summary,status,updated,{field}",
        "maxResults": 100,
    })
    if not raw or "issues" not in raw:
        return None

    domain = os.environ.get("JIRA_DOMAIN")
    issues, sprints = [], {}
    for i in raw["issues"]:
        f = i.get("fields") or {}
        active = [s for s in (f.get(field) or []) if s.get("state") == "active"]
        if not active:
            # openSprints() matched on *some* sprint of this issue's history. Without an
            # active entry there is nothing to claim it for this fortnight.
            continue
        for s in active:
            sprints.setdefault(s.get("name") or "?", s)
        status = (f.get("status") or {}).get("name", "")
        cat = ((f.get("status") or {}).get("statusCategory") or {}).get("key", "")
        issues.append({
            "key": i.get("key", ""),
            "summary": " ".join((f.get("summary") or "").split()),
            "status": status,
            # The category, not the name: "Done" is one of a dozen strings a workflow can
            # call its terminal column, and this instance already uses "Releasing" and
            # "MR" for states that are emphatically not finished.
            "done": cat == "done",
            "handed_off": status.strip().lower() in HANDED_OFF,
            "updated": (f.get("updated") or "")[:10],
            "url": f"https://{domain}/browse/{i.get('key','')}",
            "sprint": sorted(s.get("name") or "?" for s in active),
        })
    if not issues:
        return None

    names = sorted(sprints)
    # The board suffix off the end -- "Aug 10 - Aug 21, 2026 (UL)" -> "Aug 10 - Aug 21,
    # 2026". Two boards running the same fortnight is one sprint as far as a person is
    # concerned, and printing both names would say there are two of everything.
    bare = {re.sub(r"\s*\([A-Z]{2,5}\)\s*$", "", n) for n in names}
    ends = sorted(filter(None, (_sprint_end(s.get("endDate")) for s in sprints.values())))
    out = {
        "name": bare.pop() if len(bare) == 1 else " + ".join(names),
        "boards": names,
        # The soonest close, where two boards disagree: the deadline that binds is the
        # first one to arrive.
        "ends": ends[0] if ends else None,
        "tickets": sum(1 for i in issues if not i["done"]),
        "done": sum(1 for i in issues if i["done"]),
        "issues": issues,
        "idle_days": SPRINT_IDLE_DAYS,
    }
    out["days_left"] = _days_until(out["ends"])
    return out


def _days_until(day):
    epoch = _day_epoch(day)
    return int(-(-(epoch - time.time()) // 86400)) if epoch else None


def join_sprint(sprint, arcs):
    """Hang the declared sprint on the derived arcs, and say where they fail to meet.

    Three answers the page could not give before, and they are three different actions:
    a sprint ticket with an arc is work in flight, a sprint ticket with no arc anywhere
    is work that has not started (or started somewhere this machine cannot see), and a
    sprint arc that has not moved in a working week is the sprint quietly not happening.

    The join is `tickets_to_arcs`'s, which is reconcile's -- one author for the rule that
    a ticket key lives in an arc's branch names and not only in its label. Written twice
    it would have drifted the first time an arc was renamed.

    Pure, and called after apply_parked and mark_forgotten rather than inside reconcile,
    because `stage` and `parked` are what decide whether silence is neglect: an arc that
    landed is silent because it is finished, and one that is parked is silent on purpose.
    Both are excluded from `untouched` for that reason. `in-review` is not: a sprint
    ticket sitting unread for a working week is exactly the sprint risk this exists to
    surface, even though the next move belongs to somebody else.
    """
    by_key = tickets_to_arcs(arcs)
    seen, members = set(), []
    for i in sprint["issues"]:
        arc = by_key.get(i["key"])
        if arc is None:
            continue
        # One arc can carry several sprint tickets; it is one workstream either way.
        if arc["id"] not in seen:
            seen.add(arc["id"])
            members.append(arc)
        # On the arc as well as in the roll-up, so a row can wear a chip without the
        # renderer having to carry the sprint's membership list around with it.
        arc["sprint"] = {"name": sprint["name"], "ends": sprint["ends"]}

    def idle(a):
        # cliff_days first: it is measured over everything in the arc, so a colleague's
        # commit today makes it read 0 and keeps this quiet. age_days is the fallback for
        # an arc with no dated evidence at all, and over-claims by construction -- which
        # is the wrong direction for an accusation, so it is only reached when there is
        # nothing better.
        act = a.get("activity") or {}
        d = act.get("cliff_days")
        return a.get("age_days", 0) if d is None else d

    def in_play(a):
        return (a.get("stage") not in ("landed", "abandoned", "parked", "residue")
                and not a.get("parked") and not a.get("residue"))

    # Total tiebreak on id, like every other ordering here: two arcs idle the same number
    # of days must not swap places between runs.
    untouched = sorted((a for a in members
                        if in_play(a) and idle(a) >= SPRINT_IDLE_DAYS),
                       key=lambda a: (-idle(a), a["id"]))

    members.sort(key=lambda a: (-a.get("engagement", 0), a["id"]))
    sprint["arcs"] = [a["id"] for a in members]
    # The subset that still wants something, kept separately rather than left for a
    # renderer to re-derive. Both numbers are true and they answer different questions:
    # "19 workstreams carry this sprint's tickets" is the sprint's size, and "7 of them
    # are still in play" is the answer to what the page is actually asked every morning.
    sprint["in_play"] = [a["id"] for a in members if in_play(a)]
    sprint["untouched"] = [{"id": a["id"], "label": a.get("label"), "days": idle(a),
                            "ticket": a.get("ticket"), "stage": a.get("stage")}
                           for a in untouched]
    # Not derived from gap's list of the same name: that one is scoped to collect_jira's
    # window and drops Done tickets before this can see them, and a sprint ticket that is
    # finished with nothing left on disk is the sprint working, not a hole in it.
    sprint["tickets_without_work"] = [i for i in sprint["issues"]
                                      if not i["done"] and i["key"] not in by_key]
    return sprint


def collect_initiatives(issues):
    """Map each issue to the initiative(s) it rolls up to.

    The chain is task -> parent Epic -> Initiative, and the last hop is NOT the parent
    field: epics report `parent: none` while still belonging to an initiative. The link
    is a Polaris work item link ("implements"), which is many-to-many -- UL-1533
    implements both SBX-2 and UL-1825 -- so a parent field could not express it even in
    principle. Initiatives also live in SBX, a project absent from JIRA_PROJECTS, which
    is why the hierarchy looked missing until Trellis's own JQL turned up.
    """
    domain = os.environ.get("JIRA_DOMAIN")
    email = os.environ.get("JIRA_EMAIL")
    token = os.environ.get("JIRA_API_TOKEN")
    if not (domain and email and token):
        return {}, {}
    auth = base64.b64encode(f"{email}:{token}".encode()).decode()

    def get(path):
        req = urllib.request.Request(f"https://{domain}/rest/api/3/{path}",
                                     headers={"Accept": "application/json"})
        req.add_header("Authorization", f"Basic {auth}")
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                return json.load(r)
        except (urllib.error.URLError, json.JSONDecodeError, TimeoutError, ValueError):
            return None

    epics = {}
    for i in issues:
        key = i["key"]
        d = get(f"issue/{key}?fields=parent")
        if d:
            par = (d.get("fields") or {}).get("parent")
            if par:
                epics.setdefault(par["key"], []).append(key)

    issue_to_init, initiatives = {}, {}
    for epic, children in epics.items():
        d = get(f"issue/{epic}?fields=issuelinks,summary")
        if not d:
            continue
        inits = []
        for link in (d.get("fields") or {}).get("issuelinks") or []:
            other = link.get("outwardIssue") or link.get("inwardIssue") or {}
            f = other.get("fields") or {}
            if (f.get("issuetype") or {}).get("name") == "Initiative":
                inits.append(other["key"])
                initiatives[other["key"]] = " ".join((f.get("summary") or "").split())
        for child in children:
            issue_to_init[child] = inits
    return issue_to_init, initiatives


def tickets_to_arcs(arcs):
    """ticket key -> the arc that owns it.

    An arc's ticket keys live in its member branches, not in its label: clustering
    names an arc after its evidence, so UL-1692's arc may be called something else
    entirely. Keying off the label alone silently emptied this map and made every
    issue look like work that never started.

    Extracted so reconcile and join_sprint share one author for the rule. Both ask the
    same question of the same arcs, and the two answers drifting apart -- an arc that
    holds a ticket for the gap report but not for the sprint strip -- would be a bug
    nobody could see from either end.

    First branch wins, deliberately: where two arcs both name a ticket the older
    mapping stands rather than flipping between runs.
    """
    by_key = {}
    for a in arcs:
        for b in a["branches"]:
            m = TICKET_RE.search(b["name"].upper())
            if m:
                by_key.setdefault(m.group(0), a)
        m = TICKET_RE.search((a.get("label") or "").upper())
        if m:
            by_key.setdefault(m.group(0), a)
    return by_key


def reconcile(arcs, issues):
    """Where the derived picture and the declared one disagree.

    Three gaps, and they want different actions: work with no ticket AND SOMETHING STILL
    OUTSTANDING needs one filing, a ticket with no work needs closing or starting, and a
    ticket claiming to be handed off while its commits sit on this laptop needs a push.

    The capitalised clause is the one that had to be added. `unticketed_work` used to ask
    only whether an arc had a ticket, was busy enough and was recent enough -- never
    whether anything was left to file a ticket *about* -- so on the 24th it offered a
    one-step `--jira-ify` command for "App framework brief next beats backend message",
    which the same page listed under Landed, having merged as !10348. A ticket opened for
    work that already shipped is paperwork nobody will ever close, and one nonsense row
    costs the other two their credibility.
    """
    by_key = tickets_to_arcs(arcs)
    issue_keys = {i["key"] for i in issues}

    # An arc that owns a ticket owns its summary too. Without this the arc knows only
    # the key, so anything rendering an arc can print `UL-1692` and nothing about what
    # UL-1692 *is* -- the summary existed all along, but only inside the gap report.
    for i in issues:
        arc = by_key.get(i["key"])
        if arc is not None:
            arc.setdefault("issues", []).append(i)
    for a in arcs:
        a.setdefault("issues", [])
        # Most-recently-updated ticket first: on an arc holding several, that is the
        # one the work is currently about.
        a["issues"].sort(key=lambda i: i.get("updated", ""), reverse=True)

    def has_ticket(a):
        if a["kind"] == "ticket":
            return True
        return any(TICKET_RE.search(b["name"].upper()) for b in a["branches"])

    def outstanding(a):
        """Whether there is still work here for a ticket to be about.

        Resolved through `settled` rather than by asking the branches again, because
        `settled` is finalize's single author for "every branch of this arc has landed or
        been abandoned" -- and it is already the thing that empties an arc's demands and
        exempts it from the forgotten verdict. A second derivation of the same question is
        a second answer waiting to disagree with the first, on the same page, about the
        same workstream.

        `pre-landing` is the third settled shape and needs naming separately: the work
        shipped as a reshape, and what survives are drafts from before it. `settled` is
        None there because those drafts have no merge request of their own, but they are
        residue rather than an open loop -- the same exemption `mark_forgotten` makes, for
        the same reason.

        Then the positive test, so an arc with nothing pushed, nothing proposed and
        nothing asked of it does not get a command either: unpushed commits no remote has,
        an open merge request (`collect_mrs` asks for `state=opened`, so every entry here
        is live), or any demand at all.
        """
        if a.get("settled") or a.get("stage") == "pre-landing":
            return False
        return bool(a["unpushed_live"] or a["mrs"] or a.get("demands"))

    unticketed = [
        a for a in arcs
        if not has_ticket(a) and outstanding(a)
        and a["engagement"] >= 200 and a["age_days"] <= 30
    ]
    # Total tiebreak on id, as everywhere else: engagement is a coarse integer, ties are
    # ordinary, and two builds of the same data must not shuffle the table.
    unticketed.sort(key=lambda a: (-a["engagement"], a["id"]))

    no_work = [i for i in issues if i["key"] not in by_key]

    mismatched = []
    for i in issues:
        a = by_key.get(i["key"])
        if not a:
            continue
        # How long the record has been wrong, as a lower bound. `updated` moves when anyone
        # edits any field on the ticket, so a status change would have bumped it: nothing
        # having touched this ticket for 34 days means this status has stood for at least
        # 34. Understating is the safe direction for a figure the page prints as
        # "uncorrected for 34 days", and it needs no field this call does not already ask
        # for -- `statuscategorychangedate` dates the category move rather than the status
        # one, so it would read the same across "In Progress" -> "In Review" and overstate.
        stale = _days_since(i.get("updated")) or 0
        # Days of work over the distinct unlanded commits, not a per-branch sum of commits.
        # "240 commits never pushed" against a ticket that has 114 is the kind of
        # overstatement that costs the whole page its credibility -- and this row exists to
        # tell someone their ticket is lying. The distinct count fixed the overstatement;
        # saying it in days fixes the unit, which double-counted an afternoon's rewrite as
        # thirty separate pieces of hidden work.
        if i["handed_off"] and a["unpushed_live"] > 0:
            scale = work_scale(a.get("unpushed_days", 0), a["unpushed_live"])[0]
            mismatched.append({"issue": i, "arc": a, "ref": i["key"], "stale_days": stale,
                               "why": f"status '{i['status']}' but {scale} never pushed"})
        elif not i["handed_off"] and a["age_days"] > 21:
            mismatched.append({"issue": i, "arc": a, "ref": i["key"], "stale_days": stale,
                               "why": f"status '{i['status']}' but untouched {a['age_days']}d"})
    # One ranking, made here, because this list had three orders and two authors. The table
    # rendered it in whatever order Jira happened to return the issues and then cut the
    # tail at fourteen rows, while the page's lede and the morning brief each ran their own
    # `max()` over the whole list -- so the ticket both sentences called the worst one could
    # be a row the truncation had already removed, and the anchor they linked to pointed at
    # nothing on the page.
    #
    # Ranked on how long the record has been wrong, not on how much unpushed work the wrong
    # status is hiding, and that is a change of subject as much as of key: "the tool is too
    # obsessed with me having commits on my laptop. i guess i do want that information
    # somewhere but it's not the main signal of unfinished work". The size of the pile on
    # this laptop was deciding which ticket the page called out to the team. A status nobody
    # has corrected in two months is wrong in a way that compounds while it waits -- every
    # standup, every rollup, every capacity number reads it -- and a fortnight of local work
    # behind a ticket somebody touched this morning is not. What is on the disk has its own
    # home in `only_here`, which is where that number is answerable.
    #
    # Days of work stays as the tiebreak, then commits, then the key: the order has to be
    # total, because two builds of the same data that rank differently make the superlative
    # in the brief move for no reason anybody can see.
    mismatched.sort(key=lambda m: (-m["stale_days"],
                                   -m["arc"].get("unpushed_days", 0),
                                   -m["arc"].get("unpushed_live", 0),
                                   m["ref"]))
    # The why-text carries the status and the scale, so the fingerprint expires the
    # moment either moves -- Jira gets corrected, or another day's work piles up. The
    # staleness is deliberately NOT in it: a fingerprint that changed every midnight would
    # reopen an acknowledged row every morning, which is the one thing a ✕ must not do.
    for m in mismatched:
        m["fp"] = _dfp("gap", m["issue"]["key"], m["why"])
    return {"unticketed_work": unticketed, "tickets_without_work": no_work,
            "status_mismatch": mismatched}


OVERRIDES = (Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
             / "work-arcs" / "authoritative.json")


def load_overrides():
    if not OVERRIDES.exists():
        return {}
    return load_store(OVERRIDES, "the authoritative-branch store")


def apply_overrides(arcs, store):
    """Let a human name the authoritative branch, in the one form that cannot rot.

    Nothing here may DEPEND on this: 0 of 38 open tickets carry an estimate, which is the
    measured fate of every optional field, so the derivation has to be right on its own
    and this only ever corrects it. That is also why the override is not simply an
    assertion. It records what it was overriding at the time, and it applies only while
    that is still what the derivation says. Once the evidence moves -- an MR opens, a
    branch is squashed -- the override has been overtaken by facts it never saw, and it
    reports itself stale instead of quietly outvoting them.

    Returns the labels whose override was ignored, so the page can say so.
    """
    stale = []
    for arc in arcs:
        entry = store.get(arc.get("label")) or store.get(arc.get("id"))
        if not entry:
            continue
        # A filing already names the branch -- it is the source of the merge request under
        # the ticket -- and it is the more specific statement of the two. Two hand-set
        # answers fighting over one field is the one outcome neither can survive.
        ta = arc.get("ticket_authority") or {}
        if ta.get("key"):
            stale.append({"label": arc.get("label"), "branch": entry.get("branch"),
                          "why": f"you have filed this workstream as {ta['key']}, which "
                                 f"names {ta.get('branch')} as its own branch"})
            continue
        want = entry.get("branch")
        if want not in {b["name"] for b in arc.get("branches", [])}:
            stale.append({"label": arc.get("label"), "branch": want,
                          "why": "that branch is no longer in this arc"})
            continue
        was = entry.get("over")
        if was and was != arc.get("authoritative"):
            stale.append({"label": arc.get("label"), "branch": want,
                          "why": f"derivation moved from {was} to "
                                 f"{arc.get('authoritative')} since you set this"})
            continue
        arc["authoritative"] = want
        arc["authoritative_via"] = "set by hand"
        for b in arc["branches"]:
            b["authoritative"] = b["name"] == want
        arc["demands"] = demands(arc)
    return stale


PARKED = (Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
          / "work-arcs" / "parked.json")


def apply_parked(arcs):
    """Workstreams deliberately set aside, and the evidence that says they still are.

    The one thing this cannot derive. "I have unpublished work but I am not planning to do
    anything with it soon" is a statement about intent, and nothing in git or Jira knows it
    -- it is exactly the distinction between deliberately parked and forgotten that the
    forgotten-work detection needs and cannot make on its own.

    Persisted in the only safe form: keyed to a fingerprint of the arc's branch tips, so a
    single new commit expires it and the workstream comes back on its own. Parked is a rung,
    not a filter -- these stay on the page, counted, in their own section.

    Returns the entries whose fingerprint no longer matches, so the page can say so.
    """
    store = load_store(PARKED, "the parked store")
    stale = []
    for arc in arcs:
        entry = store.get(arc.get("label")) or store.get(arc.get("id"))
        if not entry or arc.get("settled"):
            continue
        if entry.get("fingerprint") != arc.get("fingerprint"):
            stale.append({"label": arc.get("label"),
                          "why": "the work has moved since you parked it"})
            continue
        arc["parked"] = {"at": entry.get("at"), "note": entry.get("note", "")}
        arc["stage"] = "parked"
        arc["state"] = "parked" + (f" — {entry['note']}" if entry.get("note") else "")
    return stale


def set_parked(arcs, spec, unpark=False):
    """`--park ARC[=note]`, stamped with the fingerprint it is a claim about."""
    label, _, note = spec.partition("=")
    label = label.strip()
    match = [a for a in arcs if a.get("label") == label or a.get("id") == label]
    if not match:
        sys.exit(f"work-arcs: no workstream named {label!r}")
    arc = match[0]
    store = load_store(PARKED, "the parked store")
    if unpark:
        store.pop(label, None)
        print(f"✓ {label} is back in the run of play", file=sys.stderr)
    else:
        store[label] = {"fingerprint": arc["fingerprint"], "at": int(time.time()),
                        "note": note.strip()}
        print(f"✓ parked {label}", file=sys.stderr)
        print(f"  comes back on its own as soon as a commit lands on it — {PARKED}",
              file=sys.stderr)
    PARKED.parent.mkdir(parents=True, exist_ok=True)
    PARKED.write_text(json.dumps(store, indent=1, sort_keys=True))


def set_override(arcs, spec):
    """`--authoritative ARC=BRANCH`, stamped with what it is overriding."""
    label, _, branch = spec.partition("=")
    label, branch = label.strip(), branch.strip()
    match = [a for a in arcs if a.get("label") == label or a.get("id") == label]
    if not match:
        sys.exit(f"work-arcs: no arc named {label!r}")
    arc = match[0]
    names = [b["name"] for b in arc["branches"]]
    if branch not in names:
        sys.exit(f"work-arcs: {branch!r} is not a branch of {label!r}\n  "
                 + "\n  ".join(names))
    store = load_overrides()
    store[label] = {"branch": branch, "over": arc.get("authoritative"),
                    "at": int(time.time())}
    OVERRIDES.parent.mkdir(parents=True, exist_ok=True)
    OVERRIDES.write_text(json.dumps(store, indent=1, sort_keys=True))
    print(f"✓ {label}: authoritative branch is {branch} "
          f"(was deriving {arc.get('authoritative')})", file=sys.stderr)
    print(f"  expires itself if that derivation changes — {OVERRIDES}", file=sys.stderr)


TICKET_AUTHORITY = (Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
                    / "work-arcs" / "authoritative-ticket.json")


def _ta_lineage(arc, branch):
    """The declared branch and everything already inside it.

    Its ancestors, because a stack's lower branches are commits the tip already contains;
    and anything superseded by a member, transitively, because a pre-squash copy of the work
    is the work. Everything outside this set is what the declaration calls history.
    """
    lineage = {branch}
    by_name = {b["name"]: b for b in arc.get("branches", [])}
    lineage |= {p for p in (by_name.get(branch, {}).get("parents") or []) if p in by_name}
    for _ in range(len(by_name)):
        grew = {n for n, b in by_name.items()
                if b.get("superseded_by") in lineage} - lineage
        if not grew:
            break
        lineage |= grew
    return lineage


def _ta_residue_fp(arc, lineage):
    """A fingerprint of the tips the declaration is setting aside.

    The expiry mechanism, and it expires in the one direction that matters. "The work of
    this arc is UL-1852 and the rest is history" stops being true the moment a commit lands
    on one of those other branches -- you went back to it, so it is not history. Keyed on
    the tips rather than on the arc's name, exactly as parking is, so going back expires the
    declaration on its own and nothing has to remember to.
    """
    h = hashlib.sha256()
    for b in sorted(arc.get("branches", []), key=lambda x: x["name"]):
        if b["name"] not in lineage:
            h.update(f'{b["name"]}:{b["sha"]}\n'.encode())
    return h.hexdigest()[:16]


def _ta_resolve(arc, key):
    """Which branch of this arc IS ticket `key`, and why, or (None, why not).

    The merge request first, because that is what "up for review" means and it is the whole
    point of the declaration: filing the work as a ticket is filing it as the merge request
    under that ticket. A branch naming the key is the fallback for work not yet proposed.
    """
    names = {b["name"] for b in arc.get("branches", [])}
    for m in arc.get("mrs", []):
        if mr_ticket(m) == key and m.get("branch") in names:
            return m["branch"], f"source of !{m.get('iid')}"
    named = [n for n in sorted(names)
             if TICKET_RE.search(n.upper())
             and TICKET_RE.search(n.upper()).group(0) == key]
    if len(named) == 1:
        return named[0], f"the one branch naming {key}"
    if named:
        return None, f"{len(named)} branches name {key} and no merge request picks one"
    return None, f"nothing in this workstream is {key}"


def apply_ticket_authority(arcs, store, repo=None, main_ref="origin/main"):
    """Let a human say what an arc's work IS, when the clustering has buried it.

    The one thing neither git nor Jira can settle. `UL-1852` reached review as one merge
    request; file overlap had already gathered eleven other branches into the same arc --
    experiments, backups, a pre-squash copy, a spike that went nowhere -- and every one of
    them kept the arc on the `local-only` rung, reporting "85 commits exist only here" about
    work that had shipped. The counts were right. What they were counts *of* was the
    question, and nothing on the machine could answer it.

    So this says it: the work is this ticket, and the branches outside its lineage are
    history. They are not hidden -- they stay in the tree, struck through, and the card says
    how many and under whose declaration -- but they stop being counted as risk, stop
    holding the rung down, and stop asking for anything. The rung then falls to whatever the
    merge request says, which is what "it is up for review" means.

    Held to the same contract as every other declaration here. It records the residue it was
    declared about and applies only while that is still the residue: a commit on any branch
    it set aside means you went back to that branch, and a branch you went back to is not
    history. Then it reports itself stale rather than quietly outvoting the evidence.

    Returns the entries that could not be applied, so the page can say so.
    """
    stale = []
    for arc in arcs:
        entry = store.get(arc.get("label")) or store.get(arc.get("id"))
        if not entry:
            continue
        key = (entry.get("key") or "").upper()
        branch, why = _ta_resolve(arc, key)
        if not branch:
            stale.append({"label": arc.get("label"), "key": key, "why": why})
            continue
        lineage = _ta_lineage(arc, branch)
        residue = sorted(b["name"] for b in arc["branches"] if b["name"] not in lineage)
        now = _ta_residue_fp(arc, lineage)
        was = entry.get("residue")
        if was and was != now:
            stale.append({"label": arc.get("label"), "key": key,
                          "why": "a commit has landed on work you set aside, so it is "
                                 "not history"})
            continue
        for b in arc["branches"]:
            b["historical"] = None if b["name"] in lineage else key
        arc["ticket_authority"] = {"key": key, "branch": branch, "via": why,
                                   "at": entry.get("at"), "residue": residue}
        # Everything the mark changes is computed in finalize, so it is recomputed rather
        # than patched: the rung, the live commit count, the arc's own age, the demands.
        finalize(arc, repo, main_ref)
    return stale


def _ta_candidates(arc):
    """Every ticket key this workstream could honestly be filed as, best first.

    Its own ticket leads, because that is the key the derivation already picked out of the
    five an arc can carry. After it come the keys its merge requests are about, then the
    rest of its Jira issues.
    """
    keys = []
    if arc.get("ticket"):
        keys.append(arc["ticket"])
    for m in arc.get("mrs") or []:
        k = mr_ticket(m)
        if k and k not in keys:
            keys.append(k)
    for i in arc.get("issues") or []:
        if i.get("key") and i["key"] not in keys:
            keys.append(i["key"])
    return keys


def _ta_outcome(arc):
    """The part of a workstream's state a filing moves, as the page needs to see it."""
    return {"stage": arc.get("stage") or "", "state": arc.get("state") or "",
            "live": arc.get("unpushed_live", 0),
            "copies": arc.get("unpushed_only_on_copies", 0),
            "history": sorted(b["name"] for b in arc["branches"]
                              if b.get("historical")),
            "demands": [d.get("fp") for d in arc.get("demands") or [] if d.get("fp")]}


def _ta_mark(arc, key, branch, why, repo, main_ref):
    """Apply a filing (or clear one, with key=None) and recompute what it changes."""
    lineage = _ta_lineage(arc, branch) if key else set()
    for b in arc["branches"]:
        b["historical"] = None if (not key or b["name"] in lineage) else key
    arc["ticket_authority"] = ({"key": key, "branch": branch, "via": why} if key
                               else None)
    finalize(arc, repo, main_ref)
    return lineage


def filing(arc, repo=None, main_ref="origin/main"):
    """What filing this workstream as each of its keys would do, worked out here.

    The page is where this decision gets made -- a workstream is filed by clicking the row
    it is wrong on, not by retyping its derived name into a shell -- and the page must not
    work out the consequences for itself. The rung, the live commit count, which branches
    become history and which demands fall silent are all `finalize`'s answers, and a second
    implementation of that ladder in JavaScript is a ladder that eventually disagrees with
    this one.

    So every state the control can reach is computed here, by actually applying the filing
    and reading the result: one entry per offerable key, plus `off` for the underived state,
    so the page can move in either direction and only ever record intent. Each carries the
    residue fingerprint the store entry is keyed on, so a filing made on the page expires
    on exactly the evidence one made anywhere else does.

    The arc is left exactly as found. finalize recomputes every field it owns from the
    branch marks, so applying, reading and putting back is a no-op on everything else.
    """
    # Screened before anything is recomputed. Every arc on the page reaches this and only
    # a dozen have anything to offer, so the pure set work goes first and the finalize
    # passes are paid for the few -- measured, 4.8s over the corpus against 0.6s.
    offerable = []
    for key in _ta_candidates(arc):
        branch, why = _ta_resolve(arc, key)
        if not branch:
            continue
        lineage = _ta_lineage(arc, branch)
        if len(lineage) < len(arc["branches"]):
            offerable.append((key, branch, why, lineage))
    # Three at most. A workstream can hold five keys and a control with five ways to be
    # wrong is one nobody uses; these are in _ta_candidates' order, which puts the key the
    # derivation already chose first.
    offerable = offerable[:3]
    if not offerable:
        return None
    was_ta = arc.get("ticket_authority") or None
    was_marks = {b["name"]: b.get("historical") for b in arc["branches"]}

    _ta_mark(arc, None, None, "", repo, main_ref)
    off = _ta_outcome(arc)

    options = []
    for key, branch, why, _ in offerable:
        lineage = _ta_mark(arc, key, branch, why, repo, main_ref)
        residue = sorted(b["name"] for b in arc["branches"]
                         if b["name"] not in lineage)
        got = _ta_outcome(arc)
        # A key whose filing changes nothing is not offered. Every branch is already the
        # work, or the rung and the counts land where they already are -- and a control
        # that does nothing when clicked is worse than no control.
        if residue and got != off:
            options.append({**got, "key": key, "branch": branch, "via": why,
                            "residue": residue,
                            "residue_fp": _ta_residue_fp(arc, lineage)})

    for b in arc["branches"]:
        b["historical"] = was_marks[b["name"]]
    arc["ticket_authority"] = was_ta
    finalize(arc, repo, main_ref)
    if not options:
        return None
    return {"filed": (was_ta or {}).get("key") or "", "off": off, "options": options}


def _ta_holders(arcs, key):
    """Every workstream that could honestly be called `key`'s.

    Only exact evidence, the same rule the Slack join is held to: the arc's own ticket, an
    issue joined onto it, or a branch or merge request that names the key. A near miss here
    would file the wrong workstream and suppress its counts, which is the one failure this
    whole feature has to avoid.
    """
    out = []
    for a in arcs:
        if a.get("ticket") == key or any(i.get("key") == key for i in a.get("issues") or []):
            out.append(a)
            continue
        if _ta_resolve(a, key)[0]:
            out.append(a)
    return out


def _ta_named(arcs, spec, store):
    """(arc, key) for `ARC=KEY`, or for a bare `KEY` where one workstream holds it.

    The bare form exists because the other one asks you to type the arc's derived name --
    "Derive dataset geometry from metadata declarations" -- beside the key, which is saying
    the same thing twice and getting it wrong once. A key is already an identity; where
    exactly one workstream holds it, that is the whole spec.
    """
    left, sep, right = spec.partition("=")
    left, right = left.strip(), right.strip().upper()
    if sep:
        match = [a for a in arcs if a.get("label") == left or a.get("id") == left]
        if not match:
            sys.exit(f"work-arcs: no workstream named {left!r}")
        return match[0], right
    key = left.upper()
    if not TICKET_RE.search(key):
        sys.exit(f"work-arcs: {left!r} is neither a ticket key nor ARC=KEY "
                 "(JIRA_PROJECTS decides what a key looks like)")
    # An entry already filed under this key names its own workstream, so undoing one never
    # depends on the derivation still agreeing about who holds the key.
    filed = [lbl for lbl, e in store.items() if (e.get("key") or "").upper() == key]
    if len(filed) == 1:
        match = [a for a in arcs if a.get("label") == filed[0] or a.get("id") == filed[0]]
        if match:
            return match[0], key
    holders = _ta_holders(arcs, key)
    if not holders:
        sys.exit(f"work-arcs: no workstream holds {key}")
    if len(holders) > 1:
        sys.exit(f"work-arcs: {len(holders)} workstreams hold {key} — name the one you "
                 "mean as ARC=KEY:\n  "
                 + "\n  ".join(a.get("label", "?") for a in holders))
    return holders[0], key


def set_ticket_authority(arcs, spec, undo=False):
    """`--authoritative-ticket ARC=KEY` (or a bare KEY), stamped with what it sets aside."""
    store = load_store(TICKET_AUTHORITY, "the ticket-authority store")
    arc, key = _ta_named(arcs, spec, store)
    label = arc.get("label")
    if undo:
        if label not in store:
            print(f"⚠ {label} was not filed as anything", file=sys.stderr)
        store.pop(label, None)
        print(f"✓ {label} is derived again", file=sys.stderr)
    else:
        branch, why = _ta_resolve(arc, key)
        if not branch:
            sys.exit(f"work-arcs: cannot file {label!r} as {key} — {why}\n  "
                     + "\n  ".join(b["name"] for b in arc["branches"]))
        lineage = _ta_lineage(arc, branch)
        residue = sorted(b["name"] for b in arc["branches"] if b["name"] not in lineage)
        store[label] = {"key": key, "branch": branch,
                        "residue": _ta_residue_fp(arc, lineage),
                        "at": int(time.time())}
        print(f"✓ {label} is {key} — {branch} ({why})", file=sys.stderr)
        if residue:
            print(f"  {len(residue)} branch(es) become history and stop being counted:",
                  file=sys.stderr)
            for n in residue[:8]:
                print(f"    {n}", file=sys.stderr)
            if len(residue) > 8:
                print(f"    … and {len(residue) - 8} more", file=sys.stderr)
        print(f"  comes back on its own if a commit lands on any of them — "
              f"{TICKET_AUTHORITY}", file=sys.stderr)
    TICKET_AUTHORITY.parent.mkdir(parents=True, exist_ok=True)
    TICKET_AUTHORITY.write_text(json.dumps(store, indent=1, sort_keys=True))


def jira_ify(repo, arc, dry_run):
    """File a ticket for work that already exists, using what the arc already knows."""
    branches = ", ".join(b["name"] for b in arc["branches"][:6])
    subjects = []
    for b in arc["branches"][:3]:
        out = git(repo, "log", "--format=%s", "-3", f"origin/main..{b['name']}")
        subjects += [f"  - {x}" for x in lines(out)[:3]]
    desc = "\n".join([
        f"Work already in progress under the name '{arc['label']}'.",
        "",
        f"Branches: {branches}",
        f"Unpushed commits: {arc['unpushed']}",
        f"Claude sessions touching this work: {arc['counts']['sessions']}",
        f"Last activity: {arc['age_days']}d ago",
        "",
        "Recent commit subjects:",
        *subjects,
    ])
    cmd = ["create-jira-ticket", "--summary", arc["label"], "--description", desc]
    if dry_run:
        cmd.append("--dry-run")
    script = Path(__file__).resolve().parent / "create-jira-ticket"
    if script.exists():
        cmd[0] = str(script)
    print(f"→ {' '.join(cmd[:3])} ...", file=sys.stderr)
    return subprocess.run(cmd).returncode


CLUSTER_CACHE = (Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
                 / "work-arcs" / "cluster-cache.json")


def load_clusters(repo, main, resolution):
    """Arc membership from arc-cluster, i.e. from what the work touched.

    Branch names are a fallback now, not the mechanism. A name describes the change;
    the files describe the intent, which is why one investigation used to come out as
    nine arcs. Returns {branch_name: arc_label} plus each arc's session ids.

    Cached on everything the clustering reads: the branch tips, where main is, the turn
    log, the tuning knobs, and the tool's own mtime. arc-cluster was ~4s of a 9.5s run
    recomputing an answer whose inputs had not moved -- and between two runs of a morning
    they almost never have. Anything moves and the key no longer matches, so the cache
    can be wrong in only one direction: slower than it had to be, never stale.
    """
    tool = Path(__file__).resolve().parent / "arc-cluster"
    if not tool.exists():
        return {}, {}, {}
    turns = CLUSTER_CACHE.parent / "turns.jsonl"
    try:
        st = turns.stat()
        turn_sig = f"{st.st_mtime_ns}:{st.st_size}"
    except OSError:
        turn_sig = "no turn log"
    knobs = ":".join(os.environ.get(k, "") for k in
                     ("ARC_HUB_SHARE", "ARC_MIN_SHARED", "ARC_STACK_SIM",
                      "ARC_CONTAIN_AT"))
    key = hashlib.sha256("\n".join([
        git(repo, "for-each-ref", "--format=%(refname:short) %(objectname)",
            "refs/heads"),
        git(repo, "rev-parse", main).strip(),
        turn_sig, str(resolution), knobs, str(tool.stat().st_mtime_ns),
    ]).encode()).hexdigest()
    cached = load_store(CLUSTER_CACHE, "the clustering cache")
    if cached.get("key") == key and isinstance(cached.get("assign"), dict) \
            and isinstance(cached.get("sessions"), dict) \
            and isinstance(cached.get("membership"), dict):
        return cached["assign"], cached["sessions"], cached["membership"]
    try:
        r = subprocess.run(
            [str(tool), "--repo", str(repo), "--main", main,
             "--resolution", str(resolution), "--json"],
            capture_output=True, text=True, timeout=180)
        data = json.loads(r.stdout)
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError, ValueError):
        return {}, {}, {}

    assign, sessions, member = {}, {}, {}
    for arc in data.get("arcs", []):
        label = arc.get("label") or "?"
        # Two clusters can derive the same label; keep them distinct so their members
        # are not silently merged back together.
        if label in sessions and sessions[label] != arc.get("sessions", []):
            label = f"{label} ({len(sessions)})"
        sessions[label] = arc.get("sessions", [])
        for b in arc.get("branches", []):
            assign[b] = label
        # Flattened by branch rather than kept per arc: every consumer here holds a
        # branch and wants to know how it got where it is, and a branch is in exactly
        # one arc, so the arc key would only ever be a second way to spell `assign`.
        for b, m in (arc.get("membership") or {}).items():
            member[b] = m
    if assign:
        try:
            CLUSTER_CACHE.parent.mkdir(parents=True, exist_ok=True)
            CLUSTER_CACHE.write_text(json.dumps(
                {"key": key, "assign": assign, "sessions": sessions,
                 "membership": member}))
        except OSError:
            pass  # a cache that cannot be written is just a cache miss next time
    return assign, sessions, member


DETACHED = (Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
            / "work-arcs" / "detached.json")

# The other half of the same contract: branches a human confirmed DO belong where the
# clustering put them. A detachment corrects the derivation; a confirmation ratifies it,
# and both expire the same way -- see still_applies.
CONFIRMED = DETACHED.parent / "confirmed.json"

# The other question type's two stores, and they are the same contract as the pair above
# pointing at a different claim. Membership asks "is this branch this work?"; residue asks
# "is this still intended work?" -- and the second question exists because the first cannot
# reach it. Kyle's verdict on the local-only numbers was that they read inflated, and the
# reason is not a grouping error: in agentic development a great deal of what is on the
# disk is RESIDUE, experiments and churn that were never meant to land, and the tool was
# counting every one of them as debt. Without a way to say so, five days of dead
# experiments outrank a meaningful half-day fix in the `only_here` ranking forever.
#
# INTENDED is the ratification, RESIDUE the correction, exactly as CONFIRMED and DETACHED
# are. Both are keyed on the arc rather than on a branch -- see residue_queue for why the
# unit is the workstream -- and both expire against `arc_fingerprint`, the tips: working on
# something proves it was intended better than any answer about it, and a commit on a
# branch you called residue means you went back to it, so it was not residue. Same
# self-expiring contract as parking and as a filing, for the same reason.
INTENDED = DETACHED.parent / "intended.json"
RESIDUE = DETACHED.parent / "residue.json"

# Every answer, in the order it was given. Not a store and never read back to decide an
# arc: this is the eval set. "Should we go on massaging the detection algorithm?" is the
# question the whole curation loop exists to make answerable, and it cannot be answered
# by argument -- only by scoring a proposed change against judgements a human already
# made. Append-only, one JSON object per line, so a run can only ever add to it.
CURATION_LABELS = DETACHED.parent / "curation-labels.jsonl"

# How many co-members an answer records as its referent. The same cap the detachment
# store has always used, hoisted so the confirmation store cannot pick a different one --
# two stores with the same expiry rule and different sample sizes would expire at
# different times over the same event.
PEERS_RECORDED = 12

# The line under which a membership is worth asking a human about. Scoring is
# arc-cluster's job -- it is the only thing that saw the graph -- and where to draw the
# line is this file's, because this is where the four never-question classes it cannot
# see are applied and where the queue is actually built.
#
# Measured on this repo's corpus (794 entities, 358 memberships in 41 multi-branch arcs,
# `arc-cluster --json`): 0.34 makes 56 memberships eligible. That is more than a queue
# and deliberately so -- eligibility is not the same as being asked. The cap decides what
# is asked, pins remove answered questions, and the ranking decides the order; the line
# only decides what may ever come up. It sits where it does because the two known live
# errors sit at 0.25 -- `UL-1852` (the geo_filter migration) and `UB-6981` in the UB-6802
# metadata-geometry arc, both held by exactly the two-file corroboration floor -- and any
# line below 0.25 excludes precisely the errors this exists to catch. Above ~0.5 the
# eligible set doubles with memberships whose only weakness is a close modularity call,
# which is common and usually right.
CONFIDENCE_AT = float(os.environ.get("ARC_CONFIDENCE_AT", "0.34"))

# Questions per build. Five is not a tuning parameter, it is the whole design: the
# corpus has 56 memberships under the confidence line and would have more on a bigger
# repo, and a queue that showed all of them would be a backlog nobody opens. Five is
# what fits on a screen without scrolling and what a person will actually answer between
# two other things. Answered ones pin and drop out; skipped ones come back.
CURATION_CAP = int(os.environ.get("ARC_CURATION_CAP", "5"))

# How cold local-only work has to be before it is worth asking whether it was ever meant
# to land, as a multiple of the arc's OWN typical gap between active days. The arithmetic
# is `activity_of`'s and deliberately not a second staleness measure -- the absolute floor
# and the ratio both come from FORGOTTEN_KNOBS, so there is one place in this file that
# knows what "quiet for this arc" means and a change to it moves both readers together.
#
# The ratio is the one number that differs, 2x here against the cliff's 4x, and the
# difference is a difference in what the number decides. The cliff's 4x gates an
# ACCUSATION -- "you were deep in this and then you were not" -- and a false one of those
# costs trust. This gates a QUESTION whose skip is free and whose wrong answer is one
# keystroke to reverse, so it can afford to be asked one missed beat earlier. It is still
# a ratio and not an age: an arc worked every third day and quiet for five days is running
# normally, and nothing here may call that residue.
RESIDUE_COLD_RATIO = float(os.environ.get("WORK_ARCS_RESIDUE_RATIO", "2.0"))


def question_fp(branch, peers):
    """What makes two builds' questions the same question.

    The claim, not the wording: this branch, kept with this company. A label reword
    leaves it alone and a changed neighbourhood changes it, which is the same referent
    the stores expire on. Used to key a pin, to dedupe a label, and to let the page and
    the CLI recognise each other's answers.
    """
    h = hashlib.sha256()
    h.update(branch.encode())
    h.update(b"\0")
    h.update("\n".join(sorted(peers)).encode())
    return h.hexdigest()[:16]


def apply_confirmed(cluster_assign):
    """Memberships a human has already ratified, so they are not asked about again.

    A pin is not an override. It changes no assignment and moves no branch -- everything
    it touches is somewhere the clustering already put it, which is the whole content of
    the answer. All it does is take the question off the queue, and only while the answer
    still refers to something: the moment the branch's company changes, the ratified
    claim is about a grouping that no longer exists and the pin expires by itself rather
    than silently vouching for work it never saw.

    That self-expiry is what makes the pin safe to be permanent. A confirmation with no
    expiry would be a human answer outliving its evidence, which is exactly the failure
    the detachment contract was built to avoid.
    """
    store = load_store(CONFIRMED, "the confirmation store")
    pinned, stale = set(), []
    for branch, entry in list(store.items()):
        live, why = still_applies(entry, cluster_assign, branch)
        if live:
            pinned.add(branch)
        else:
            stale.append({"branch": branch, "why": why})
            del store[branch]
    if stale:
        try:
            CONFIRMED.write_text(json.dumps(store, indent=1, sort_keys=True))
        except OSError:
            pass
    return pinned, stale


def log_answer(row):
    """Append one answer to the eval set. Never fails a build."""
    try:
        CURATION_LABELS.parent.mkdir(parents=True, exist_ok=True)
        with CURATION_LABELS.open("a") as f:
            f.write(json.dumps(row, sort_keys=True) + "\n")
    except OSError:
        pass


def log_from_stores():
    """Answers the stores hold that the eval set has not seen, added to it.

    The CLI writes a label as it writes a store, but it is not the only thing that
    answers a question. The page saves confirmed.json and detached.json through the
    browser's own download, which cannot append to a log; `--detach` predates the eval
    set entirely and is the same kind of judgement. An eval set missing every answer
    given anywhere but one command is an eval set that under-counts exactly the
    surface a person actually used, so the stores are the record and the log is caught
    up from them.

    Keyed on (branch, answer, timestamp), which is what a store entry and its label
    share. Idempotent by construction: a row already logged is recognised whichever
    surface wrote it, so a build can only ever add answers that were genuinely new.
    """
    seen = set()
    try:
        with CURATION_LABELS.open(errors="replace") as f:
            for line in f:
                try:
                    r = json.loads(line)
                except ValueError:
                    continue
                if isinstance(r, dict):
                    seen.add((r.get("branch"), r.get("answer"), r.get("at")))
    except OSError:
        pass
    added = 0
    for path, answer in ((CONFIRMED, "keep"), (DETACHED, "pry")):
        store = load_store(path, "the confirmation store" if answer == "keep"
                           else "the detachment store")
        for branch, e in sorted(store.items()):
            if not isinstance(e, dict):
                continue
            at = e.get("at")
            if (branch, answer, at) in seen:
                continue
            peers = list(e.get("with") or ())
            log_answer({"at": at, "answer": answer, "branch": branch,
                        "arc": e.get("from"), "fp": question_fp(branch, peers),
                        "with": peers,
                        # Surface unknown, and said so rather than guessed at: the
                        # store does not record which control wrote it, and the eval
                        # set is worth less if one of its fields is a supposition.
                        "via": "store"})
            added += 1
    return added


def answer_question(q, keep, cluster_assign):
    """Record one verdict: a pin if the membership is right, a detachment if it is not.

    Both answers write to the eval set, and that is the point of asking at all. A `pry`
    alone would make the loop a correction mechanism, which fixes today's page and
    teaches nothing -- the disagreements are only half the signal, and a clusterer that
    scores well on them by splitting everything would look perfect. The agreements are
    what stop that.
    """
    branch, label = q["branch"], q["arc"]
    peers = sorted(co_members(cluster_assign, branch) or ())[:PEERS_RECORDED]
    entry = {"from": label, "with": peers, "at": int(time.time())}
    path = CONFIRMED if keep else DETACHED
    store = load_store(path, "the confirmation store" if keep
                       else "the detachment store")
    store[branch] = entry
    if keep:
        # A branch cannot be both pinned and pried. Answering one way clears the other,
        # so the two stores can never disagree about the same membership.
        other = load_store(DETACHED, "the detachment store")
        if other.pop(branch, None) is not None:
            DETACHED.write_text(json.dumps(other, indent=1, sort_keys=True))
    else:
        other = load_store(CONFIRMED, "the confirmation store")
        if other.pop(branch, None) is not None:
            CONFIRMED.write_text(json.dumps(other, indent=1, sort_keys=True))
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(store, indent=1, sort_keys=True))
    log_answer({"at": entry["at"], "kind": "membership",
                "answer": "keep" if keep else "pry",
                "branch": branch, "arc": label, "fp": q["fp"], "with": peers,
                "confidence": q.get("confidence"), "why": q.get("why"),
                "shared": q.get("shared"), "files": q.get("files") or [],
                "via": q.get("via") or "cli"})


def fzf_bin():
    """The same fzf lib/fzf-helpers resolves, in the same order.

    $FZP_FZF first, because that is the override the shell library already documents and
    two resolvers that disagree about which fzf is in use are worse than either. It is
    also the only way to drive this flow from a test: without it the resolution is
    whatever is installed, and a keystroke interface that cannot be scripted is a
    keystroke interface nobody can regression-test.
    """
    override = os.environ.get("FZP_FZF")
    if override:
        return override
    local = Path.home() / ".zsh/fzf/bin/fzf"
    if local.is_file() and os.access(local, os.X_OK):
        return str(local)
    return shutil.which("fzf")


def question_line(q):
    """One row: what is being asked about, its size, and the claim being tested.

    The subject first because it is what the eye is scanning for; the claim last because
    it is the longest and reads as a sentence. One shape for both question types, and
    deliberately so -- they share a keystroke vocabulary and a screen, and two row layouts
    in one list would make the reader work out which kind of question they are on before
    reading it.
    """
    if q.get("kind") == "residue":
        return (f"{q['arc'][:38]:<38}  {q['scale']:>10}  "
                f"still intended work?  ({q['why']})")
    size = f"+{q['commits']}" if q["commits"] else "no commits"
    mark = " ← the arc's own MR" if q.get("authoritative") else ""
    return (f"{q['branch'][:38]:<38}  {size:>10}  "
            f"same work as {q['arc']}?{mark}  ({q['why']})")


def residue_preview(q):
    """The evidence for an intent question: how much, how cold, and what nobody claimed.

    Every exclusion the queue applied is stated as a fact rather than implied by the
    question's existence, because the answer a person gives depends on trusting them. "No
    merge request ever, no sprint, no promise" is the case FOR asking, and a reader who
    cannot see it has no way to notice the day one of those tests is wrong.
    """
    out = [f"{q['arc']}", ""]
    out.append(f"  {q['scale']} on no remote, across "
               f"{len(q['branches'])} branch"
               f"{'' if len(q['branches']) == 1 else 'es'}.")
    out.append("")
    out.append(f"  quiet                   {q['cliff_days']} days, "
               f"{q['beats']}× its own {q['gap_days']}-day rhythm")
    out.append("  never proposed          no merge request exists and none ever did")
    out.append("  unclaimed               no sprint carries it and no promise names it")
    out.append(f"  rung                    {q['stage']}")
    out.append("")
    for n in q["branches"][:8]:
        out.append(f"    {n}")
    if len(q["branches"]) > 8:
        out.append(f"    … and {len(q['branches']) - 8} more")
    out.append("")
    out.append("  y  yes, still intended — keeps counting; asked again only if it goes")
    out.append("     cold again after you next touch it")
    out.append("  n  no, residue — the commits stay exactly where they are and stop")
    out.append("     counting as debt: struck through on the card, out of the days-of-")
    out.append("     work figures and out of the only-here ranking. One commit on any")
    out.append("     branch of it undoes this by itself.")
    out.append("  s  skip — no record either way; it comes back next build")
    return "\n".join(out)


def question_preview(q):
    """The evidence, as a person would want to check it: what is shared, and with what.

    Both sides of the tie, because "these two branches share these files" is the entire
    claim and showing one side of it asks the reader to take the other on faith.
    """
    out = [f"{q['branch']}", ""]
    out.append(f"  the clustering put this in the arc {q['arc']!r},")
    out.append(f"  alongside {q['peers']} other branch"
               f"{'' if q['peers'] == 1 else 'es'}.")
    out.append("")
    out.append(f"  why it is being asked   {q['why']}")
    out.append(f"  confidence              {q['confidence']:.2f}")
    if q.get("with"):
        out.append(f"  strongest tie           {q['with']}")
    if q.get("files"):
        out.append(f"  shared files            {', '.join(q['files'])}")
    out.append("")
    if q.get("authoritative"):
        out.append("  this is the branch the arc's merge request points at, so prying it")
        out.append("  out takes the arc's subject and ticket with it.")
        out.append("")
    out.append("  y  yes, same work — pin it, and stop asking while it keeps this company")
    out.append("  n  no, different work — pry it out; it falls back to its own name")
    out.append("  s  skip — no record either way; it comes back next build")
    return "\n".join(out)


def curate(queue, cluster_assign):
    """`--curate`: answer what this build is least sure of, one keystroke each.

    Two kinds of question and one keystroke vocabulary. Membership asks "is this branch
    this work?" and residue asks "is this still intended work?", and in both `y` means the
    derivation is right and `n` means it is not -- so a person answers a mixed queue
    without having to hold two mappings in their head. Which question they are on is said
    by the row and spelled out in full by its preview.

    The whole loop exists because the clustering's residual error needs a human and an
    unguided human does not curate. So the rules are about the asking, not the answering:
    never more than CURATION_CAP questions of both kinds together, skip costs nothing and
    leaves no record, and an empty queue prints one line and exits rather than opening
    anything. Nothing here notifies, mails or nags -- a queue nobody opens today is simply
    a queue that is the same size tomorrow.

    One fzf per question rather than a persistent list with callbacks: the answer has to
    be recorded by a process that holds the current assignment, and a callback shelling
    back into work-arcs would rebuild the arcs -- minutes of git and GitLab -- to write
    one line. Re-running fzf over the remaining rows costs nothing and keeps every write
    in the process that already knows what it is writing.
    """
    if not queue:
        print("✓ nothing worth asking about — every membership is either a fact or "
              "well enough corroborated, and every workstream holding local-only work "
              "is warm, proposed, claimed or promised", file=sys.stderr)
        return
    fzf = fzf_bin()
    if not fzf:
        print("work-arcs: fzf is not installed; the questions this build would ask:",
              file=sys.stderr)
        for q in queue:
            print(f"  {question_line(q)}", file=sys.stderr)
        return

    tmp = Path(tempfile.mkdtemp(prefix="work-arcs-curate."))
    try:
        # The fingerprint rides in a first tab-separated column that fzf is told not to
        # display. A branch name can hold anything a ref can hold, so recovering the
        # question by parsing the rendered line back would be a parser waiting to meet a
        # branch called `a b`; carrying the key is not.
        for q in queue:
            (tmp / q["fp"]).write_text(residue_preview(q)
                                       if q.get("kind") == "residue"
                                       else question_preview(q))
        pending = list(queue)
        answered = 0
        while pending:
            lines = [f"{q['fp']}\t{question_line(q)}" for q in pending]
            r = subprocess.run(
                [fzf, "--ansi", "--reverse", "--height=100%", "--info=inline",
                 "--pointer=▶", "--no-multi", "--no-sort", "--cycle",
                 "--delimiter=\t", "--with-nth=2..", "--expect=y,n,s",
                 "--header", f"y yes · n no · s skip · esc done   "
                             f"({len(pending)} left, {answered} answered)",
                 "--prompt", "is the derivation right? > ",
                 "--preview", f"cat {shlex.quote(str(tmp))}/{{1}}",
                 "--preview-window", "down,60%,wrap"],
                input="\n".join(lines), capture_output=True, text=True)
            parts = r.stdout.split("\n")
            key = parts[0].strip() if parts else ""
            fp = parts[1].split("\t", 1)[0] if len(parts) > 1 else ""
            q = next((x for x in pending if x["fp"] == fp), None)
            if not q or key not in ("y", "n"):
                break                       # esc, s, or nothing selected: leave it be
            if q.get("kind") == "residue":
                answer_residue(q, key == "y")
                print(f"  {'✓ intended' if key == 'y' else '✕ residue '}  {q['arc']}"
                      + ("" if key == "y"
                         else f" — {q['scale']} stops counting as debt"),
                      file=sys.stderr)
            else:
                answer_question(q, key == "y", cluster_assign)
                print(f"  {'✓ kept' if key == 'y' else '✕ pried'}  {q['branch']}"
                      f" {'in' if key == 'y' else 'out of'} {q['arc']!r}",
                      file=sys.stderr)
            answered += 1
            pending = [x for x in pending if x["fp"] != q["fp"]]
        if answered:
            print(f"✓ {answered} answered — applied on the next build. "
                  f"{CURATION_LABELS}", file=sys.stderr)
        else:
            print("nothing answered.", file=sys.stderr)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def curation_queue(arcs, membership, cluster_assign, uncertain=(), cap=CURATION_CAP):
    """The memberships worth a human's attention, least confident first.

    Kyle's verdict on the arcs was that they hold a lot of false positives, and the
    repo's own history says threshold tuning is exhausted for the shape that is left:
    two tickets editing the same module are structurally identical however the weights
    are set, and the model split pass already covers the readable part. What remains is
    curation -- and curation that is not guided is curation that does not happen. So the
    system publishes where it is least sure and asks exactly there.

    Three classes are never asked about, and each is a fact rather than an inference:

      superseded copies         a backup or pre-squash copy belongs wherever the branch
                                it copies belongs -- checked by patch-id, not guessed at
                                from the name -- so asking about it is asking the same
                                question twice
      ancestry and aliases      a branch cut from another, or the same commit under a
                                second name (arc-cluster settles these)
      the arc's own ticket      a branch whose name carries the key the arc is named for

    The authoritative branch was a fourth, on the reasoning that it IS the work and an arc
    cannot be wrong about its own subject. That reasoning fails in precisely the case this
    queue exists for. `UL-1852` is two commits of geo_filter migration, held into a
    fifteen-branch metadata-geometry arc by the two-file corroboration floor, and it is
    that arc's authoritative branch -- because authority follows the newest merge request,
    not the weight of the work. Excluding it did not protect a fact; it hid the one arc
    whose *subject* had been decided by a stranger, which is worse than a stranger merely
    standing in it.

    So authority is reported with the question rather than suppressing it. It costs
    nothing to leave in: measured on this corpus, 51 of 64 authoritative branches in
    clustered arcs score above the line on their own evidence and are never asked about
    anyway. The thirteen that do not are thirteen arcs whose subject rests on two shared
    files. What the flag is for is the answer: prying an authoritative branch out takes
    the arc's merge request with it, and a person should be told that before pressing n.

    Superseded copies and authority both need merge requests and squash detection to see,
    which is why they are applied here and not in the clusterer.

    Ranked by confidence ascending, then by how recently the branch was touched, then by
    how much work is on it, then by name so the order is total and two runs over one
    graph ask in the same sequence.

    Recency is the tiebreak and not arc size, which is what it was first. The corpus has
    eleven memberships at the identical lowest score -- all the same shape, a branch held
    by the two-file floor whose name is filed under a different ticket from its arc's --
    and nothing structural separates them, because there is nothing structural left to
    separate: that is the shape the plan says no threshold fixes. What separates them is
    whether the person can answer. A branch touched last week is one you remember; a
    seventy-day-old stub is one you would have to go and read the diff for, and a
    question you have to research is a question that gets skipped. Size sorted by how
    much a wrong answer costs, which is the wrong end -- a question nobody answers costs
    everything it might have fixed.

    One question per arc per build, and that rule earns its keep on the first corpus it
    saw: `UL-1810` and `UL-1810-prerebase` are each other's only evidence, and the queue
    asked about both -- two keystrokes to settle one thing, and the second asked after
    the first had already changed the answer. More generally the answers within an arc
    are not independent: prying one branch out changes what is left for the rest to be
    corroborated against, so the second question in an arc is being asked against
    evidence the first has already invalidated. Five questions across five arcs cover
    five times the ground and every one of them is answered against what is currently
    true. An arc with four strangers in it is asked again next build, one at a time,
    which is slower and right.

    Capped, and absent entirely when nothing falls below the line.
    """
    unsure = set(uncertain or ())
    out = []
    for arc in arcs:
        if arc.get("kind") != "cluster" or len(arc.get("branches") or []) < 2:
            continue
        members = [b["name"] for b in arc["branches"]]
        for b in arc["branches"]:
            name = b["name"]
            if b.get("superseded_by"):
                continue
            m = membership.get(name)
            if not m:
                continue
            # The model kept this branch and said it could not justify keeping it. That
            # is a verdict about content, which is the one thing file overlap cannot see,
            # so it makes the membership *eligible* whatever the structure says. It does
            # not make it first: the ranking stays the measured one, so a flagged branch
            # with solid structural evidence is asked only if there is room after the
            # ones the clusterer is genuinely unsure about. A model that turned talkative
            # can therefore lengthen the tail but never take over the queue.
            flagged = name in unsure
            conf = m.get("confidence", 1.0)
            if not flagged and conf >= CONFIDENCE_AT:
                continue
            # The evidence a question shows is the tie it is really asking about, so a
            # question whose named neighbour has since left the arc is a question about
            # a claim nobody is making. The split pass separating the two IS the answer.
            with_b = m.get("with")
            if with_b and with_b not in members:
                continue
            peers = sorted(n for n in members if n != name)
            out.append({
                # Which question this is. Absent on every label written before residue
                # questions existed, so every reader of the eval set defaults to
                # "membership" rather than testing for the key -- see score_labels.
                "kind": "membership",
                "branch": name,
                "arc": arc.get("label") or arc["id"],
                "arc_id": arc["id"],
                "fp": question_fp(name, peers[:PEERS_RECORDED]),
                "confidence": round(conf, 3),
                "why": ("the split pass kept it but could not say why" if flagged
                        else m.get("why") or ""),
                "with": with_b,
                "shared": m.get("shared", 0),
                "files": m.get("files") or [],
                "links": m.get("links", 0),
                "peers": len(peers),
                # The referent an answer will be recorded against, sent with the
                # question so the page writes the same `with` list the CLI would. A page
                # that rebuilt it from the rows it rendered would record a different
                # referent whenever the arc's tree was truncated, and the two stores
                # would then expire at different times over the same event.
                "co_members": peers[:PEERS_RECORDED],
                "commits": b.get("commits_ahead", 0),
                "age_days": b.get("age_days", 999),
                "flagged_by_model": flagged,
                # Not a reason to ask and not a reason to stay silent -- a warning about
                # the answer. Prying this one out takes the arc's merge request, its
                # ticket and its subject with it.
                "authoritative": bool(b.get("authoritative")),
            })
    out.sort(key=lambda q: (q["confidence"], q["age_days"], -q["commits"], q["branch"]))
    seen, once = set(), []
    for q in out:
        if q["arc_id"] in seen:
            continue
        seen.add(q["arc_id"])
        once.append(q)
    return once[:cap]


# ── is this still intended work? ───────────────────────────────────────────────
#
# The second question type. Everything above asks whether the derivation put a branch in
# the right arc; nothing above can ask whether the work is work at all, and that is the
# question Kyle's verdict on the local-only numbers was actually about: "much local
# content in agentic development is residue -- experiments and churn that should never
# land -- and the tool counts all of it as debt." The missing judgement is INTENT, and
# intent is the one thing this pipeline has never been able to derive.
#
# The unit is the workstream, not the branch, and that is a decision with three reasons
# rather than a convenience:
#
#   the tests are arc-level    every exclusion below is a fact about a workstream -- its
#                              own rhythm, whether a sprint claims it, whose clock is
#                              running, whether a promise names it. A branch has no
#                              rhythm and no sprint of its own to be asked about.
#   the branch-level answer    already exists. `--authoritative-ticket` says "the work of
#                              this arc is this ticket and the branches outside its
#                              lineage are history", which IS per-branch residue, with
#                              its own store and its own expiry. A second per-branch
#                              mechanism for the same sentence would be two stores that
#                              can disagree about one branch.
#   the asked set has no       a workstream is only asked about when it has never been
#   mixed arcs in it           proposed and holds nothing but local-only work, so there
#                              is no arc in the queue whose answer would need to be
#                              "these three branches but not those two".
#
# It is not park, either, though it borrows park's expiry. Park says "I am not touching
# this for a while" and keeps the work in play, counted, on a rung of its own; residue
# says "this was never going to land" and takes it out of the debt figures while leaving
# every commit exactly where it is. Two different sentences with two different
# consequences cannot share one store without one of them being silently mis-stated.


def _arc_store_entry(store, arc):
    """One arc's entry in a fingerprint-keyed store, however it was keyed.

    Three lookups, in the order of how much each proves. The id first, because that is
    what a write here keys on. The label second, for an entry written before this did.
    And the fingerprint last, by scanning -- which is the one that earns its keep: an
    arc's `id` is its cluster label, and the split pass rewords those between runs
    ("selected state" became "selected-state" within an evening). Keyed on the id alone,
    a rewording would lose the answer silently, which is precisely the failure
    `still_applies` exists to rule out for the other pair of stores. The tips are the
    referent, so they are also the last resort for finding the entry about them.
    """
    fp = arc.get("fingerprint")
    for key in (arc.get("id"), arc.get("label")):
        if key and isinstance(store.get(key), dict):
            return key, store[key]
    if fp:
        for key, entry in sorted(store.items()):
            if isinstance(entry, dict) and entry.get("fingerprint") == fp:
                return key, entry
    return None, None


def _apply_arc_answer(arcs, path, what):
    """The half of both stores that is the same: which arcs an answer still applies to.

    Returns (the arcs it holds for, the entries it no longer holds for). One expiry test,
    `arc_fingerprint`, and it expires in the only direction that matters -- a commit on
    any branch of the arc means you went back to the work, and work you went back to is
    neither residue nor a question that needed answering. So the answer dies of being
    disproved by the thing it was a claim about, which is the same contract parking, a
    filing and the authoritative override are all held to.

    Out loud, not silently: a caller prints the stale ones. An answer that quietly
    outlived its evidence is worse than no answer, because nothing on the page would say
    the numbers had been suppressed by a judgement nobody remembers making.
    """
    store = load_store(path, what)
    live, stale, drop = {}, [], []
    for arc in arcs:
        if not arc.get("branches"):
            continue
        key, entry = _arc_store_entry(store, arc)
        if entry is None:
            continue
        if entry.get("fingerprint") != arc.get("fingerprint"):
            stale.append({"label": arc.get("label") or arc.get("id"),
                          "why": "a commit has landed on it since you answered, and "
                                 "work you went back to is work you meant"})
            drop.append(key)
            continue
        live[arc["id"]] = entry
    # Only entries this run positively matched to a workstream and found overtaken. An
    # entry no arc claimed is left alone rather than swept: an arc absent from one run is
    # usually a --no-cluster run, a branch checked out elsewhere or a repo half-fetched,
    # and deleting a human judgement on that evidence is the one thing these stores may
    # never do.
    if drop:
        for key in drop:
            store.pop(key, None)
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(json.dumps(store, indent=1, sort_keys=True))
        except OSError:
            pass
    return live, stale


def apply_intended(arcs):
    """Workstreams a human has already said are real work, so they are not asked again.

    A pin, and it changes nothing else -- the arc keeps every commit, every day of work
    and its place in the `only_here` ranking, because the answer was that all of that is
    genuinely outstanding. All it removes is the question, and only while it still refers
    to the work it was an answer about.

    Which is what makes it safe to be permanent, and what makes its expiry the *right*
    behaviour rather than a limitation: the answer expires the moment a commit lands, and
    a commit landing is a better proof of intent than the answer ever was. So the arc
    comes back off the pin having already re-earned it, and is not asked again until it
    has gone cold a second time.
    """
    return _apply_arc_answer(arcs, INTENDED, "the intended store")


def apply_residue(arcs, repo=None, main_ref="origin/main"):
    """Workstreams a human said were never meant to land, and what that stops counting.

    Nothing is hidden and nothing is deleted. Every branch stays on the disk, in the
    tree, and on the page; what changes is that its commits stop being called debt --
    excluded from `unpushed_live` and so from `unpushed_days`, from the `only_here`
    ranking and from the lede's figures, and shown struck through rather than absent, on
    the same reasoning the historical marks are drawn: de-emphasis is not hiding, and a
    number that vanished is a number a reader cannot check.

    Mechanically it is `--authoritative-ticket`'s mechanism with the lineage empty: a
    per-branch mark that `dead` reads, and then finalize recomputes everything that
    depends on it -- the rung, the live count, the days of work, the demands. Marking the
    branches rather than patching the totals is the whole of why this cannot drift: there
    is still exactly one place that knows how to count an arc's outstanding work.

    Reversible without a command, which is the property that matters most. A commit on
    any branch of the arc expires the declaration, so going back to the work un-residues
    it on its own -- derived beats declared, and the one thing a person should never have
    to remember is to withdraw a judgement the evidence has already withdrawn.
    """
    live, stale = _apply_arc_answer(arcs, RESIDUE, "the residue store")
    for arc in arcs:
        entry = live.get(arc["id"])
        if not entry:
            continue
        for b in arc["branches"]:
            b["residue"] = True
        arc["residue"] = {"at": entry.get("at"), "note": entry.get("note", ""),
                          "branches": sorted(b["name"] for b in arc["branches"])}
        # Everything the mark changes is finalize's to compute, so it is recomputed rather
        # than patched -- the same order apply_ticket_authority uses, and for the same
        # reason: a second implementation of the ladder is a ladder that will disagree.
        finalize(arc, repo, main_ref)
    return stale


def _residue_promised(arcs, ledger):
    """Which arcs an open promise names, joined the way a Slack thread is joined.

    `_join_thread` is the one author of the rule that a workstream is named by its ticket
    keys, its branch names or its merge request iids, and it is reused here rather than
    re-derived: a promise is a sentence about work, exactly as a thread is, and two
    implementations of "which work is this sentence about" would disagree the first time
    one of them was improved.

    Both promise kinds, because `COMMITMENT_KINDS` exists for exactly this -- a meeting
    promise and a Slack promise differ only in the room they were made in. Closed ones are
    already off the ledger by the time this runs, so every row here is still open.
    """
    if not ledger:
        return set()
    index = _thread_join_index(arcs)
    out = set()
    for e in ledger.get("you_owe") or ():
        if e.get("kind") not in COMMITMENT_KINDS:
            continue
        text = " ".join(str(e.get(f) or "") for f in ("quote", "promised", "title", "ref"))
        arc, _, _ = _join_thread(text, index)
        if arc is not None:
            out.add(arc["id"])
    return out


def residue_queue(arcs, ledger, jira_known, pinned=(), cap=CURATION_CAP):
    """The workstreams worth asking "was this ever meant to land?", coldest first.

    Derived, not asked about wholesale. The whole queue's rule is that asking about a
    fact is worse than asking nothing, and four kinds of work are intended BY
    CONSTRUCTION -- there is no answer to give but yes, and asking spends the day's one
    unit of attention on it:

      warm            touched within its own rhythm. Work in progress is not residue,
                      whatever it looks like; the arithmetic is activity_of's, so
                      "quiet" means quiet for THIS arc rather than quiet by the calendar.
      proposed        a merge request exists, or one ever did. Putting work up for review
                      is the act of declaring it meant to land, and nothing this can ask
                      overrides it.
      sprint-claimed  a sprint carries its ticket. That is the team's declaration that
                      the work is wanted, which outranks a guess about intent.
      promised        a Slack message or a sentence in a meeting says you would do it.
                      Your own words, and the most direct evidence of intent there is.

    Then the cliff's own exemptions, which are already the list of reasons silence does
    not mean neglect: in-review and pre-landing come from FORGOTTEN_EXEMPT rather than
    being restated, settled work is finished, and parked work is intent already declared
    the other way. An arc that is already residue is not asked either -- it has answered.

    Two abstentions, and they are refusals to ask rather than reasons to be silent. Every
    test above is an EXCLUSION, so a source that did not answer does not make the queue
    shorter -- it makes it wrong, by letting through exactly the work that would have
    been excluded. Where GitLab was not asked, "never proposed" cannot be established;
    where the ledger was not built or came back short, "nothing promised it" cannot be.
    Both then produce no residue questions at all, which is the same judgement
    mark_forgotten makes about accusing an arc on a --no-mr run and the same one
    apply_dismissals makes about pruning on a half-answered ledger. Said out loud by the
    caller, so a quiet queue is never mistaken for a clean one.

    Coldest first, measured as multiples of the arc's own rhythm rather than in days, so
    two arcs quiet for the same fortnight are ordered by which of them that fortnight is
    stranger for. Then by the days of work at stake, descending -- if only some of these
    get answered, the ones whose answer moves the numbers most should be the ones asked.
    Then the id, so the order is total and two runs over one graph ask in the same
    sequence.
    """
    if not any(a.get("mrs_known", True) for a in arcs):
        return [], ("GitLab was not asked, so whether this work was ever proposed cannot "
                    "be known — nothing asked about intent this run")
    if not (ledger and ledger.get("complete")):
        return [], ("the waiting-on ledger is incomplete, so whether a promise names "
                    "this work cannot be known — nothing asked about intent this run")
    if not jira_known:
        return [], ("Jira was not asked, so whether a sprint claims this work cannot be "
                    "known — nothing asked about intent this run")

    promised = _residue_promised(arcs, ledger)
    out = []
    for arc in arcs:
        if arc.get("residue") or arc["id"] in pinned:
            continue
        if not arc.get("unpushed_live"):
            continue                        # nothing on the disk to be residue
        if arc.get("settled") or arc.get("parked"):
            continue
        if arc.get("stage") in FORGOTTEN_EXEMPT:
            continue
        if not arc.get("mrs_known", True):
            continue
        # Ever proposed, not merely proposed now: a merged or closed merge request is
        # still the act of having put the work up, and `mr_fate` is the only record of
        # one that is no longer open.
        if arc.get("mrs") or any(b.get("mr_fate") for b in arc["branches"]):
            continue
        if arc.get("sprint") or arc["id"] in promised:
            continue
        act = arc.get("activity") or {}
        if not act.get("invested"):
            # No evidence of activity at all, so there is no rhythm to be cold against.
            # Abstaining is the honest form: a question built on knowing nothing would be
            # asked about every arc whose commits predate the log window.
            continue
        k, gap = act.get("cliff_days") or 0, act.get("typical_gap_days") or 1
        if k < _knob("cliff_days") or k < RESIDUE_COLD_RATIO * gap:
            continue
        days = arc.get("unpushed_days", 0)
        scale = work_scale(days, arc["unpushed_live"])[0]
        out.append({
            "kind": "residue",
            "arc": arc.get("label") or arc["id"],
            "arc_id": arc["id"],
            "fp": _dfp("residue", arc["id"], arc.get("fingerprint")),
            "fingerprint": arc.get("fingerprint"),
            "branches": sorted(b["name"] for b in arc["branches"]),
            "scale": scale,
            "days": days,
            "commits": arc["unpushed_live"],
            "cliff_days": k,
            "gap_days": gap,
            "beats": round(k / gap, 1),
            "why": (f"{scale} on no remote, quiet {k} days against a {gap}-day "
                    f"rhythm, never proposed"),
            "stage": arc.get("stage") or "",
        })
    out.sort(key=lambda q: (-q["beats"], -q["days"], -q["commits"], q["arc_id"]))
    return out[:cap], ""


def answer_residue(q, intended):
    """Record one verdict about intent: a pin if the work is meant, a residue mark if not.

    Both answers are written, and for the reason the membership pair is: an eval set of
    corrections alone would score a detector that called everything residue as perfect.
    "Yes, this is real work" is the half that makes the other half mean something.

    Keyed on the arc id and stamped with the fingerprint it is a claim about, so it can
    only ever apply to the work it was an answer to. Answering one way clears the other,
    so the two stores can never disagree about one workstream.
    """
    entry = {"fingerprint": q.get("fingerprint"), "at": int(time.time()),
             "label": q.get("arc"), "branches": list(q.get("branches") or ())}
    path = INTENDED if intended else RESIDUE
    other = RESIDUE if intended else INTENDED
    store = load_store(path, "the intended store" if intended else "the residue store")
    store[q["arc_id"]] = entry
    off = load_store(other, "the residue store" if intended else "the intended store")
    if off.pop(q["arc_id"], None) is not None or off.pop(q["arc"], None) is not None:
        try:
            other.write_text(json.dumps(off, indent=1, sort_keys=True))
        except OSError:
            pass
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(store, indent=1, sort_keys=True))
    log_answer({"at": entry["at"], "kind": "residue",
                "answer": "intended" if intended else "residue",
                "arc": q["arc"], "arc_id": q["arc_id"], "fp": q["fp"],
                "fingerprint": q.get("fingerprint"),
                "branches": entry["branches"], "days": q.get("days"),
                "commits": q.get("commits"), "cliff_days": q.get("cliff_days"),
                "gap_days": q.get("gap_days"), "why": q.get("why"),
                "via": q.get("via") or "cli"})


def combined_queue(memberships, residues, cap=CURATION_CAP):
    """One queue of at most `cap` questions, membership first.

    The cap is shared rather than one each, because it is a budget of attention and not a
    budget of question types: five is what fits on a screen and what a person will answer
    between two other things, and ten questions in two sections is the backlog the whole
    loop was designed not to become.

    Membership outranks residue when they compete, and the ranking is about what a wrong
    answer costs. A branch in the wrong arc poisons everything downstream of the
    grouping -- the arc's subject, its ticket, its brief, its rung and every count on it
    -- and it poisons the residue question too, because "is this workstream intended?" is
    unanswerable about a workstream that is two pieces of work in a trenchcoat. A stale
    branch counted as debt for one more day is a number slightly too large. So the
    questions that fix the foundation are asked first, and intent is asked with whatever
    room is left.
    """
    return (list(memberships) + list(residues))[:cap]


def co_members(cluster_assign, branch):
    """Everything the clustering currently groups this branch with."""
    label = cluster_assign.get(branch)
    if label is None:
        return None
    return {n for n, lbl in cluster_assign.items() if lbl == label and n != branch}


def still_applies(entry, cluster_assign, branch):
    """Whether a recorded judgement about a branch's arc still refers to that arc.

    The referent of every human answer in this pipeline -- a detachment, and now a
    confirmation -- is the *company a branch is keeping*, never the arc's name. The split
    pass rewords labels between runs ("selected state" became "selected-state" within an
    evening) and an answer must not expire over a rewording; equally it must expire the
    moment the grouping genuinely changes, because then it is an answer to a question
    nobody asked.

    So the co-members are tested first and the label is only the fallback for an answer
    that recorded none. That order is a correction: the detachment store used to accept a
    matching label as sufficient and consult the co-members only when the label had
    changed, which sounds equivalent and is not. An arc labelled from a ticket key keeps
    that label for as long as any branch carries the key, while every other member of it
    comes and goes -- `UB-6802` has held the metadata-geometry family and the geo_filter
    migration under one name. A detachment recorded against the first would have gone on
    applying to the second, which is precisely the case the contract exists to rule out,
    and it would have done so silently because a label match never reaches the check that
    reports expiry.

    Extracted so the two stores cannot drift apart. They are the same contract pointing
    in opposite directions -- "not this work" and "yes, this work" -- and a confirmation
    that outlived a detachment under the same circumstances would be a pin that quietly
    outvotes the evidence it was checked against.
    """
    cur = cluster_assign.get(branch)
    if cur is None:
        return False, "the clustering no longer files it anywhere"
    recorded = set(entry.get("with") or [])
    if recorded:
        current = co_members(cluster_assign, branch) or set()
        if len(recorded & current) / len(recorded) >= 0.5:
            return True, ""
        return False, ("the work it was grouped with has moved on"
                       if cur == entry.get("from")
                       else f"the clustering now groups it with different work ({cur!r})")
    # No company was recorded, so the arc it names is all there is to test against. Only
    # an answer about a branch that was alone in its arc can be in this state.
    if cur == entry.get("from"):
        return True, ""
    return False, f"the clustering now groups it with different work ({cur!r})"


def apply_detached(cluster_assign):
    """Branches a human pried out of the arc the file overlap put them in.

    The residual clustering error has one shape -- two tickets editing the same module
    look identical by files, and past the split pass no threshold fixes it -- so this is
    the human backstop, held to the --authoritative contract: it records what assignment
    it was correcting and applies only while the clustering still says that. The moment
    the derivation moves the branch anywhere else, the detachment has been overtaken by
    evidence it never saw, and it expires out loud instead of quietly outvoting it.

    A detached branch is not hidden. It falls back to what its name declares -- its
    ticket, its prefix, or itself -- exactly as if the clustering had never spoken.
    """
    store = load_store(DETACHED, "the detachment store")
    removed, stale = [], []
    for branch, entry in list(store.items()):
        # The claim is "not the same work as THESE", so it is tested against the
        # co-members and not the label -- see still_applies, which both human stores
        # share so neither can outlive the other's circumstances.
        live, why = still_applies(entry, cluster_assign, branch)
        if live:
            del cluster_assign[branch]
            removed.append(branch)
        else:
            stale.append({"branch": branch, "why": why})
            del store[branch]
    if stale:
        try:
            DETACHED.write_text(json.dumps(store, indent=1, sort_keys=True))
        except OSError:
            pass
    return removed, stale


def set_detached(cluster_assign, branches, spec, undo=False):
    """`--detach BRANCH` / `--undetach BRANCH`, stamped with what it corrects."""
    branch = spec.strip()
    store = load_store(DETACHED, "the detachment store")
    if undo:
        if branch not in store:
            sys.exit(f"work-arcs: {branch!r} is not detached")
        was = store.pop(branch)
        print(f"✓ {branch} may rejoin {was.get('from')!r} on the next build",
              file=sys.stderr)
    else:
        if branch in store:
            sys.exit(f"work-arcs: {branch!r} is already detached "
                     f"(from {store[branch].get('from')!r})")
        if branch not in branches:
            sys.exit(f"work-arcs: no branch named {branch!r}")
        label = cluster_assign.get(branch)
        if not label:
            sys.exit(f"work-arcs: {branch!r} is not grouped by file overlap — its arc "
                     "comes from its own name (ticket or prefix), and the only way to "
                     "detach a branch from its own name is to rename it")
        # The co-members are the real referent -- see still_applies. Capped, sorted,
        # so the entry stays small and stable.
        peers = sorted(co_members(cluster_assign, branch) or ())[:PEERS_RECORDED]
        store[branch] = {"from": label, "with": peers, "at": int(time.time())}
        print(f"✓ {branch} detached from {label!r}", file=sys.stderr)
        print("  it falls back to what its name declares; expires itself if the "
              f"clustering ever reassigns it — {DETACHED}", file=sys.stderr)
    DETACHED.parent.mkdir(parents=True, exist_ok=True)
    DETACHED.write_text(json.dumps(store, indent=1, sort_keys=True))


def split_assignment(arcs, args):
    """arc-brief's verdict on which arcs hold more than one body of work.

    Returns (assignment, uncertain) -- the refined branch -> arc-label map, and the
    branches the model kept in a body while saying it could not justify keeping them.
    The second is what the model knows that no structural signal does: it read the
    commits, decided not to cut, and is not sure. Those become eligible for the curation
    queue whatever their structural confidence says, because "the evidence I have does
    not settle this" is a reason to ask a human that no amount of file overlap supplies.
    Eligible, not first: see curation_queue for why a talkative model must not be able
    to take the queue over.

    Degrades the same way every other step does: no arc-brief, no model, or a reply that
    fails to account for every branch leaves the clustering exactly as it was.
    """
    tool = Path(__file__).resolve().parent / "arc-brief"
    if not tool.exists():
        return {}, []
    payload = json.dumps({"repo": str(args.repo), "main": args.main, "arcs": arcs})
    cmd = [str(tool), "--split", "--jobs", str(args.split_jobs)]
    if args.split_model:
        cmd += ["--model", args.split_model]
    try:
        r = subprocess.run(cmd, input=payload, capture_output=True, text=True,
                           timeout=args.split_timeout)
    except (OSError, subprocess.SubprocessError):
        return {}, []
    if r.stderr:
        print(r.stderr.rstrip(), file=sys.stderr)
    if r.returncode != 0:
        return {}, []
    try:
        out = json.loads(r.stdout)
    except json.JSONDecodeError:
        return {}, []
    if not isinstance(out, dict):
        return {}, []
    # Two shapes, told apart by a key no branch can be named: the flat branch -> label
    # map this returned before the uncertainty list existed, and the envelope that
    # carries both. Tolerated rather than versioned because the only cost of reading an
    # old reply is a run with no model-flagged questions in it.
    if isinstance(out.get("assign"), dict):
        unsure = out.get("uncertain")
        return out["assign"], (unsure if isinstance(unsure, list) else [])
    return out, []


def ticket_of(name, known_projects):
    """The arc a branch name declares, if it declares one."""
    m = TICKET_RE.search(name.upper())
    if m:
        return f"{m.group(1)}-{m.group(2)}"
    # `6919-review` names a ticket without its project. Resolve the number against
    # projects that appear elsewhere, and only when it is unambiguous.
    m = BARE_NUM_RE.search(name)
    if m:
        num = m.group(1)
        hits = {p for (p, n) in known_projects if n == num}
        if len(hits) == 1:
            return f"{hits.pop()}-{num}"
    return None


# `hotfix/`, `fix/`, `review/` are categories every unrelated branch shares -- as an
# arc name, `hotfix` collected 37 branches with nothing in common. Skip past them to
# the token that actually names the work.
PREFIX_STOPWORDS = {
    "hotfix", "fix", "fixes", "review", "wip", "temp", "tmp", "test", "tests",
    "feat", "feature", "chore", "bak", "backup", "old", "new", "try", "spike",
    "misc", "draft", "release",
}


def own_name_tokens(repo):
    """Your own name as branch-name tokens, so `alice-backup/...` is not an arc called
    "alice".

    A personal prefix describes who owns the branch, never what the work is -- the same
    reason `hotfix` is stopped. This used to be one hardcoded username in the set above,
    which worked for exactly one person and silently did nothing for anyone else. Taken
    from git's own config instead, so it is derived and it generalises.
    """
    out = set()
    for key in ("user.name", "user.email"):
        val = git(repo, "config", "--get", key).strip().lower()
        if not val:
            continue
        val = val.split("@")[0]
        for tok in re.split(r"[^a-z0-9]+", val):
            if len(tok) >= 3 and not tok.isdigit():
                out.add(tok)
    return out


def prefix_of(name, stop=frozenset()):
    """A provisional arc name for work that never got a ticket.

    Groups the `adaptive` / `adaptive-bak` / `adaptive-bak-bak-bak` family that a
    ticket-key grouping cannot see at all. Conventional prefixes are stepped over,
    since they describe the kind of branch rather than the work in it.
    """
    for token in re.split(r"[-/_.]", name):
        t = token.lower()
        if len(t) >= 4 and t not in PREFIX_STOPWORDS and t not in stop and not t.isdigit():
            return t
    return None


def build_arcs(branches, stashes, mrs, sessions, main_ref, cluster_assign=None,
               repo=None, mrs_known=True, own_tokens=frozenset()):
    known_projects = set()
    for name in branches:
        m = TICKET_RE.search(name.upper())
        if m:
            known_projects.add((m.group(1), m.group(2)))

    # Assign every branch to an arc: a ticket if it names one, else a shared name
    # prefix, else itself.
    assign, prefix_members = {}, defaultdict(list)
    cluster_assign = cluster_assign or {}
    for name in branches:
        # Files first, names only where the clustering had nothing to say.
        if name in cluster_assign:
            assign[name] = ("cluster", cluster_assign[name])
            continue
        key = ticket_of(name, known_projects)
        if key:
            assign[name] = ("ticket", key)
        else:
            p = prefix_of(name, own_tokens)
            if p:
                prefix_members[p].append(name)
            else:
                assign[name] = ("single", name)
    for p, members in prefix_members.items():
        # A prefix shared by one branch is not a cluster, it is just a branch.
        kind = "prefix" if len(members) > 1 else "single"
        for name in members:
            assign[name] = (kind, p if kind == "prefix" else name)

    arcs = {}
    for name, b in branches.items():
        kind, key = assign[name]
        arc = arcs.setdefault(key, {
            "id": key, "kind": kind, "label": key,
            "branches": [], "stashes": [], "mrs": [], "sessions": [],
        })
        arcs[key]["branches"].append(b)

    branch_to_arc = {n: assign[n][1] for n in branches}

    # A stash belongs to the arc of the branch it was taken on. Stashes are a weak
    # signal here by policy: meaningful work is kept unstashed, so a stash is
    # usually scratch. One with no arc to belong to is listed as unattached rather
    # than promoted to an arc of its own -- inventing 97 single-stash arcs was the
    # tail wagging the dog.
    unattached = []
    for s in stashes:
        key = branch_to_arc.get(s["base"])
        if key is None:
            if s["src_count"] > 0:
                unattached.append(s)
            continue
        arcs[key]["stashes"].append(s)

    for m in mrs:
        key = branch_to_arc.get(m["branch"]) or ticket_of(m["title"], known_projects)
        if key and key in arcs:
            arcs[key]["mrs"].append(m)

    seen_session = defaultdict(set)
    # branch -> arc, then day -> arc: the same rollup, one axis further. Kept beside the
    # arcs rather than on them because it holds sets of transcript paths, and everything
    # hung on an arc ends up in --json.
    arc_days = defaultdict(lambda: defaultdict(lambda: {"entries": 0, "paths": set()}))
    for branch, info in sessions.items():
        key = branch_to_arc.get(branch)
        if not key or key not in arcs:
            continue
        # Once per branch. Adding it per session multiplied a branch's mentions by
        # how many sessions mentioned it, which put a 109,272 on a five-branch arc.
        arcs[key]["engagement"] = arcs[key].get("engagement", 0) + info["entries"]
        for day, seen in info.get("days", {}).items():
            into = arc_days[key][day]
            into["entries"] += seen["entries"]
            into["paths"] |= seen["paths"]
        # sorted(), because `paths` is a set of strings and set iteration order varies
        # between processes. That randomness reached the brief: prompts are emitted in
        # session order, so 16 of 55 arcs produced different evidence text on two
        # back-to-back runs and re-briefed for no reason at all.
        for p in sorted(info["paths"]):
            if p in seen_session[key]:
                continue
            seen_session[key].add(p)
            arcs[key]["sessions"].append({
                "id": Path(p).stem,
                "age_days": days_ago(info["last"]) if info["last"] else 999,
                "last": info["last"],
                "via": branch,
            })

    for arc in arcs.values():
        arc["mrs_known"] = mrs_known
        finalize(arc, repo, main_ref)
        # After finalize, because the series counts only a live copy's commits and
        # mark_duplicates is what says which copies those are. Before the verdict, which
        # cannot run until `parked` and the second finalize have had their say -- see
        # mark_forgotten.
        arc["activity"] = activity_of(arc, arc_days.get(arc["id"]))
    ordered = sorted(arcs.values(), key=lambda a: (a["age_days"], -a["at_risk"]))
    return ordered, unattached


def mark_duplicates(arc, repo=None, main_ref="origin/main"):
    """Say which branches in an arc are copies of another rather than work of their own.

    An arc has always been a bag of branches with no notion of which one IS the work, and
    the cost of that is not cosmetic. Measured: the brief for UL-1634 asserted "the lint
    work is on a separate branch that isn't stacked onto the fix", and the truth is the
    opposite -- all four commits of the MR ARE the lint work, while
    `lint-metric-instance-stability` holds a single commit whose subject is byte-identical
    to one of them. A superseded cherry-pick drawn as an independent root reads as a second
    piece of work, and the model read it exactly that way.

    The test is containment: if every commit subject on B also appears on a branch ranked
    above it, B adds nothing. Ranking first is what keeps this acyclic -- a branch can only
    ever be superseded by a stronger one. Patch-ids then say whether the copy is redundant
    to the byte or merely reads the same, which is the difference between "delete this" and
    "check what diverched".

    Containment alone is not enough, and the difference is the whole distinction being
    drawn. A stack parent's commits are contained in its child too -- measured, `UB-6829`
    is an ancestor of `dove-test-utils`, so subject containment alone called the ticket
    branch a duplicate of the branch stacked on top of it. Same commits, same shas: that is
    a stack, it is already drawn as an edge, and it is not supersession. A superseded copy
    is the other case -- the same *content* under different shas, which is what a
    cherry-pick, a rebase or a squash leaves behind.
    """
    branches = arc.get("branches", [])
    if len(branches) < 2:
        return
    mr_branches = {m.get("branch") for m in arc.get("mrs", [])}

    def rank(b):
        # Having carried a merge request outranks everything except carrying an open one:
        # of two names for a single tip, the one somebody reviewed is the real branch. Left
        # to a name tie-break, `at-timezone-accept-zoned-columns` beat `UL-1795` on ASCII
        # order and was declared canonical, so the arc's only merged MR sat on the branch
        # marked as the copy -- and the arc reported "pushed, no merge request" with !10416
        # merged.
        #
        # Then name before size, and that order is load-bearing too. A `-before-squash`
        # branch has more commits than the squashed version by construction, so ranking on
        # commit count first nominates the pre-squash copy and declares the real one a
        # duplicate of it. Names only ever pick which of two branches is canonical; what
        # makes one superseded at all is its content.
        return (b["name"] in mr_branches, bool(b.get("mr_fate")),
                not VARIANT_RE.search(b["name"]),
                b.get("commits_ahead", 0), b.get("pushed", False),
                -b.get("age_days", 999), b["name"])

    ordered = sorted(branches, key=rank, reverse=True)
    for b in ordered:
        # Recomputed from scratch, never accumulated: finalize runs again once tickets are
        # joined on, and a mark left over from the previous pass would outlive its reason.
        b.pop("superseded_by", None)
        b.pop("superseded_kind", None)
    ids = {}

    def pids(name):
        if name not in ids:
            ids[name] = patch_ids(repo, name, main_ref) if repo is not None else set()
        return ids[name]

    for i, b in enumerate(ordered):
        subs = set(b.get("subjects") or [])
        if not subs:
            continue
        for a in ordered[:i]:
            asubs = set(a.get("subjects") or [])
            if not asubs or not subs <= asubs:
                continue
            if b["sha"] == a["sha"]:
                # Two names for one tip. These are each other's ancestor, so the stack test
                # below excluded them -- and that is how `at-timezone-accept-zoned-columns`
                # and `UL-1795` stayed separate while being the same two shas with an empty
                # diff between them, leaving the arc claiming no merge request when !10416
                # had merged it. A stack means one branch is strictly ahead of the other;
                # equal tips are aliases.
                kind = "same tip"
            elif b["name"] in (a.get("parents") or []):
                continue  # a genuine stack edge, drawn as one; not a copy
            else:
                kind = "same subjects"
            if repo is not None and len(subs) <= 20 and len(asubs) <= 20:
                mine = pids(b["name"])
                if mine and mine <= pids(a["name"]):
                    kind = "identical content"
            b["superseded_by"] = a["name"]
            b["superseded_kind"] = kind
            break


def mark_predates_landing(arc):
    """Branches whose last commit is older than a sibling's merge: drafts from before it.

    The case no content test can reach. Kyle twice named a workstream as already done and
    twice the evidence said otherwise, because the landing was a RESHAPE rather than a
    carry-over -- same intent, different diff, so no patch-id matches anywhere and both
    `git cherry` and the squash index are blind by construction.

    Dates settle what content cannot. In the Dove catalog-gating arc the surviving branches
    are 14-15 July and the slices that landed merged on 8 August; in the AOI geo_filter arc
    every survivor predates !10417's merge on 11 August. Work does not flow backwards, so a
    branch that stopped before its sibling landed is a draft from before the landing, not
    outstanding work that the landing left undone.

    Recorded as a fact -- "older than the merge of X" -- rather than as a verdict that the
    branch is finished. Kyle's own instruction: this is a valuable signal and must not be
    papered over to force the rows out of sight. Two branches can share an arc without
    sharing a fate, and where the derivation is only probably right the page should say what
    it measured and let a person conclude.
    """
    landings = [(b["name"], (b.get("mr_fate") or {}))
                for b in arc.get("branches", [])
                if (b.get("mr_fate") or {}).get("state") == "merged"
                and (b.get("mr_fate") or {}).get("at")]
    if not landings:
        for b in arc.get("branches", []):
            b.pop("predates_landing", None)
        return
    # The most recent landing: a branch older than that is older than every landing here.
    newest = max(landings, key=lambda x: x[1]["at"])
    when = _day_epoch(newest[1]["at"])
    for b in arc.get("branches", []):
        b.pop("predates_landing", None)
        if b.get("mr_fate") or b.get("superseded_by"):
            continue
        if when and b.get("committed", 0) < when:
            b["predates_landing"] = {"branch": newest[0], "at": newest[1]["at"],
                                     "iid": newest[1].get("iid"),
                                     "url": newest[1].get("url", "")}


def authoritative(arc):
    """Which single branch IS this work, and on what evidence.

    Four sources, strongest first, and the reason is recorded with the answer because they
    are not equally trustworthy. An open MR's source branch is a fact -- it is the branch
    under review, which is what "the work" means once it has left your hands. A branch
    naming the arc's ticket is nearly as good and only usable when exactly one does.

    The no-MR fallback used to be "most commits ahead", and that is a heuristic wearing a
    derivation's clothes: a pre-squash branch has more commits than the squashed version by
    construction, which is how `UB-6919-before-squash` came to be called the work. The
    structural answer is the tip of the stack -- the branch no other branch in this arc is
    built on. In a stack the descendant contains its ancestors, so the thing you are
    actually working on is whatever nothing else was cut from. A worktree checkout breaks
    ties ahead of anything else, because standing in a branch is the strongest statement of
    intent available without asking.
    """
    # A hand-filed ticket is the strongest statement there is, because it is the only one
    # that is not an inference. See apply_ticket_authority for what it is allowed to say
    # and how it expires.
    ta = arc.get("ticket_authority") or {}
    if ta.get("branch") in {b["name"] for b in arc.get("branches", [])}:
        return ta["branch"], f"you filed this as {ta['key']} — {ta.get('via', '')}"
    branches = [b for b in arc.get("branches", []) if not b.get("superseded_by")]
    # Branches a declaration set aside as history cannot be what the work currently is.
    outside = [b for b in branches if not b.get("historical")]
    if outside:
        branches = outside
    if not branches:
        branches = arc.get("branches", [])
    # A branch whose MR merged is finished; it cannot be what the work currently is unless
    # nothing else is left.
    live = [b for b in branches if not b.get("mr_fate")]
    if live:
        branches = live
    if not branches:
        return None, None
    by_name = {b["name"]: b for b in branches}

    # An arc can hold several MRs, and then the question is which one the work is currently
    # about. finalize has already ordered them most-recently-updated first with drafts
    # last, which is a better answer than the highest number -- that just means newest filed.
    for m in arc.get("mrs", []):
        if m.get("branch") in by_name:
            return m["branch"], f"source of !{m.get('iid')}"

    for i in arc.get("issues", []):
        named = [b["name"] for b in branches
                 if TICKET_RE.search(b["name"].upper())
                 and TICKET_RE.search(b["name"].upper()).group(0) == i["key"]]
        if len(named) == 1:
            return named[0], f"names {i['key']}"

    # Tips of the stack: nothing else in the arc was cut from these.
    has_child = {p for b in branches for p in (b.get("parents") or [])}
    tips = [b for b in branches if b["name"] not in has_child] or branches
    best = max(tips, key=lambda b: (b.get("worktree", False),
                                    not VARIANT_RE.search(b["name"]),
                                    b.get("committed", 0),
                                    b.get("commits_ahead", 0)))
    why = "checked out in a worktree" if best.get("worktree") else "tip of the stack"
    return best["name"], f"{why}, no MR"


# The order is the whole point: what will bite you soonest, not what is biggest. Nothing
# in this list is here because it is large -- each entry is a thing that cannot move until
# you personally do something. `unrequested` sits below `unpushed` and above `unreviewed`:
# an MR nobody was asked to read is further along than a branch with no MR at all, and the
# commits that exist nowhere but this laptop are the more basic problem than either.
DEMAND_RANK = {"conflict": 0, "threads": 1, "pipeline": 2, "approved": 3, "stacked": 4,
               "unpushed": 5, "unrequested": 6, "unreviewed": 7, "draft": 8,
               "unresolved": 9}

# Which rung a workstream sits on, decided by the worst thing outstanding. Derived from one
# table so the ladder cannot drift from the demands it is meant to describe. `unresolved`
# maps to in-review because a thread you have already answered has not come back to you --
# it is a loose end on work that is still in someone else's hands.
STAGE_OF = {"conflict": "came-back", "threads": "came-back", "pipeline": "came-back",
            "approved": "came-back", "stacked": "came-back", "draft": "came-back",
            "unresolved": "in-review", "unpushed": "local-only",
            "unreviewed": "not-proposed", "unrequested": "no-reviewer"}


def arc_fingerprint(arc):
    """What this workstream is right now, as a short hash of its branch tips.

    The expiry mechanism for parking. "I am not touching this for a while" is a claim about
    the work as it stands, and it stops being true the moment a commit lands on it -- so the
    park is keyed to the tips rather than to the arc's name, and adding a commit expires it
    on its own. Same contract as the authoritative override: a declaration that carries what
    it was declared about, so it cannot quietly outlive its evidence.
    """
    h = hashlib.sha256()
    for b in sorted(arc.get("branches", []), key=lambda x: x["name"]):
        h.update(f'{b["name"]}:{b["sha"]}\n'.encode())
    return h.hexdigest()[:16]


def own_activity(arc):
    """The last time you yourself did anything here, as an epoch.

    The dismissal mechanism for notifications, and the reason none is needed. "It came back
    and I have not looked at it yet" is a comparison, not a checkbox: once he commits or
    opens a session on the arc after the event, he has engaged with it and it stops being
    news. Derived, so it self-heals -- and it expires in the only direction that matters.
    """
    ts = [b.get("committed", 0) for b in arc.get("branches", [])]
    ts += [s.get("last", 0) for s in arc.get("sessions", [])]
    return max(ts) if ts else 0


# ── forgotten work ─────────────────────────────────────────────────────────────
#
# The plan's item 5, and the correction it makes to the loose-ends list that preceded it:
# "here is what is old" was correctly called useless, because age is a fact about the
# calendar and not about you. What is worth saying is where engagement fell off a cliff --
# high investment, then an abrupt zero, on work that never settled. That is a statement
# about the derivative of the activity, and `engagement` as it stood could not carry it:
# it sums transcript entries with no time axis at all, so 941 entries reads identically
# whether they arrived over three days or three months.
#
# What separates this from `--active N` and from the loose-ends list, in one line each:
#
#   old            last touched a long time ago.        Says nothing about investment.
#   parked         you said you were setting it aside.  Declared, and it expires itself.
#   settled        landed or abandoned.                 Finished, not forgotten.
#   in review      somebody else's clock is running.    Silence there is the system working.
#   FORGOTTEN      you were deep in it, and then you were not, and nothing closed it.
#
# Every threshold below has an env knob, because the right value is a property of one
# person's corpus rather than of the idea. The defaults were measured against this one --
# the numbers are in the commit that introduced them.
FORGOTTEN_KNOBS = {
    # The level. Either axis on its own qualifies, and there is deliberately no exchange
    # rate between them: a transcript entry and a commit are not commensurable, and
    # inventing a ratio to add them would be the same mistake `at_risk` used to make.
    #
    # 900 entries is the 87th percentile of per-branch session engagement on this corpus
    # (median 176, p75 386, p90 1,318). The percentile is not the argument; what the
    # percentile marks is. Below it a branch was something a session passed through -- read,
    # grepped, mentioned -- and above it the branch was what the session was about. Losing
    # the second costs a day of thinking that nothing else recorded.
    "min_entries": ("WORK_ARCS_FORGOTTEN_ENTRIES", 900),
    # 20 commits, taken from a gap the data draws itself: across arcs that have any commits
    # at all the counts run 1,1,...,3,4,6,7,8,11,12,14,15 and then jump to 22,23,25,30,41.
    # Fifteen-to-twenty-two is the widest break in the lower half, and it is the break
    # between a branch somebody tried something on and a branch somebody built something on.
    "min_commits": ("WORK_ARCS_FORGOTTEN_COMMITS", 20),
    # The derivative, in two parts. An absolute floor, because a weekend is not a cliff:
    # seven days is a whole working week in which nothing happened at all.
    "cliff_days": ("WORK_ARCS_FORGOTTEN_CLIFF", 7),
    # ...and a floor relative to the arc's own rhythm, which is the part that makes this a
    # derivative rather than another age test. An arc worked every third day for a month
    # and quiet for five days is running normally; one worked daily and quiet for twelve
    # has stopped. Same five and twelve days, opposite readings, and only the ratio to its
    # own typical gap can tell them apart. Measured, this is not decoration: at 4x it is
    # the only test that rejects UB-6828 (73 commits, 260 entries, nine active days) --
    # worked on a four-day rhythm and silent for seven, which is one missed beat.
    "cliff_ratio": ("WORK_ARCS_FORGOTTEN_RATIO", 4.0),
    # And a ceiling, because past some point this stops being forgotten work and becomes
    # archaeology -- which is the loose-ends list this replaces, rebuilt by accident. Eight
    # weeks, for a reason that is about evidence rather than about taste: the transcripts on
    # this machine reach back 57 days, so no arc quieter than that can have session evidence
    # at all, and every verdict beyond the line would rest on commits alone with no idea how
    # much thinking went in. The corpus agrees where the reasoning lands -- eligible arcs run
    # 42, 43, 44, 49, 51 and then a wall of 21 sitting at 58 days and older.
    "cliff_max": ("WORK_ARCS_FORGOTTEN_MAX", 56),
}

# How far back the emitted series reaches. Not a limit on what is measured -- the totals
# and the cliff are taken over everything -- only on what is printed, so a year-old arc
# cannot put 300 pairs into a JSON document that a morning brief has to read.
SERIES_DAYS = int(os.environ.get("WORK_ARCS_ACTIVITY_DAYS", "120"))

# Stages where silence is not forgetting. `in-review` is the load-bearing one: an arc
# whose only quiet is a reviewer's queue must never read as forgotten, or the feature
# accuses you of dropping the ball on the one workflow that is working. `pre-landing` is
# the other: those branches are drafts from before a sibling landed, which is residue
# rather than an open loop. Settled and parked are handled separately, since they carry
# their own sentences.
FORGOTTEN_EXEMPT = {
    "in-review": "out for review — the clock is a reviewer's, not yours",
    "pre-landing": "drafts from before a sibling landed, not an open loop",
}


def _knob(name):
    """One forgotten-work threshold, env first, measured default second."""
    var, default = FORGOTTEN_KNOBS[name]
    raw = os.environ.get(var, "").strip()
    if not raw:
        return default
    try:
        return type(default)(float(raw))
    except ValueError:
        return default


def activity_of(arc, session_days):
    """This arc's engagement as a shape over time, rather than as one number.

    `engagement` answers "how much of you went into this" and answers it well, but it is a
    total, and a total has no derivative. Bucketing the same entries by the day they landed
    on is what turns it into a shape -- and the shape is the whole signal, because the two
    situations that most need telling apart, a sprint that stopped and a slow burn that
    never had a cliff to fall off, are indistinguishable by total.

    Two sources, because either alone has a blind spot big enough to matter. Sessions reach
    back only as far as the transcripts do -- measured, 57 days on this machine -- so an arc
    last worked in April has no session evidence whatsoever, and its commits are the only
    thing that can date it. Commits, conversely, are missing from the first day of anything:
    reading, planning and being told why the last attempt failed produce hundreds of
    transcript entries and no commit at all.

    Both are counted the way the rest of this file counts things -- once. Commits are
    deduplicated by sha and a superseded copy's are not counted at all, because a
    five-branch stack otherwise reports five times the investment it holds; that is the same
    correction `distinct_unpushed` makes for the same reason. Session entries are summed the
    way `engagement` sums them, per branch, so the series and the total can never disagree
    even where both overcount a transcript that named two branches of one arc.

    But a superseded copy's DATES are kept, and the distinction is the whole of a filed bug.
    Skipping the branch outright threw its dates away with its volume, and the newest work
    in an arc frequently sits on exactly the copy that is skipped -- a squash or a
    cherry-pick is made after the original it replaces, and `%ct` is a committer date.
    Measured before the fix: UB-6668 reported a cliff of 119 days against an age of 87, and
    2 of 155 arcs claimed a silence older than the arc itself, pointed straight at the sprint
    strip and the forgotten verdict. The two are different kinds of fact: a date says when
    work happened and a copy was made on the day it was made; volume is the thing that would
    be counted twice. So `days`, the gaps and the cliff see every branch, and `commits` sees
    only the live ones -- which does mean `per_active_day` reads lower on an arc that was
    squashed on a day of its own, correctly, since that day had a person on it and no new
    commits of its own.

    The emitted series is [days_ago, units] pairs, newest first, and only for days that had
    something on them: 90 zeroes are not data, they are the absence of it. `units` is
    entries plus commits, which is an understatement of a commit and known to be one -- the
    series exists to show *when*, and every threshold that decides anything is taken over
    the two axes separately, never over this sum.
    """
    per_day = {}

    def bucket(day):
        return per_day.setdefault(day, {"entries": 0, "sessions": set(), "commits": 0})

    for day, seen in (session_days or {}).items():
        b = bucket(day)
        b["entries"] += seen["entries"]
        b["sessions"] |= seen["paths"]
    shas = set()
    # Live branches first, so a sha on both a live branch and a superseded one is claimed by
    # the live one and keeps its volume. Sorted rather than merely partitioned, because the
    # branch list's own order decides which copy claims a shared sha and two runs must agree.
    for br in sorted(arc.get("branches", []),
                     key=lambda b: (bool(b.get("superseded_by")), b.get("name") or "")):
        counts = not br.get("superseded_by")
        for c in br.get("commits", []):
            if c["sha"] in shas:
                continue
            shas.add(c["sha"])
            day = bucket(day_no(c["at"]))
            if counts:
                day["commits"] += 1

    if not per_day:
        # Not "no activity" -- no *evidence* of activity. An arc can be real and leave
        # nothing here: a branch whose commits all predate the log window this reads, with
        # no session that ever named it. Saying so is the honest form; a zero series would
        # invite the verdict below to call it forgotten on the strength of knowing nothing.
        return {"series": [], "invested": None, "first_active": None,
                "last_active": None, "cliff_days": None, "typical_gap_days": None}

    days = sorted(per_day)
    today = day_no(time.time())
    entries = sum(v["entries"] for v in per_day.values())
    commits = sum(v["commits"] for v in per_day.values())
    sessions = len(set().union(*(v["sessions"] for v in per_day.values())))
    gaps = sorted(b - a for a, b in zip(days, days[1:]))
    # A single active day is a rhythm of "daily" for this purpose: it says the work moved
    # within one day, so a week of silence after it is already four of its own beats. The
    # alternative -- no rhythm, so no ratio test -- would exempt precisely the arcs the
    # plan names, the ones hammered for one sitting and dropped.
    typical = gaps[len(gaps) // 2] if gaps else 1
    series = [[today - d, per_day[d]["entries"] + per_day[d]["commits"]]
              for d in sorted(days, reverse=True) if today - d <= SERIES_DAYS]
    out = {
        "series": series,
        "invested": {"entries": entries, "sessions": sessions, "commits": commits,
                     "days": len(days), "span_days": days[-1] - days[0] + 1,
                     "per_active_day": round((entries + commits) / len(days), 1)},
        "first_active": day_str(days[0]),
        "last_active": day_str(days[-1]),
        # Always <= arc["age_days"], and deliberately so where they differ. `age_days` is
        # asked of the arc's lineage alone so a branch the clustering swept in cannot date
        # it; this is asked of everything in the arc, so a stranger's commit today makes
        # the cliff read 0 and the verdict stay silent. Under-claiming is the right
        # direction for a sentence that accuses you of forgetting something.
        #
        # That "always" is an invariant and has now been a false claim twice, both times
        # because "everything in the arc" quietly was not. First `age_days` counted elapsed
        # 24-hour blocks while this counts local-midnight buckets, so the subset came out
        # *larger* on 90-odd of 111 arcs and the page showed "8d ago" beside "sprint · 9d";
        # both sides now go through `days_ago`. Then the superseded skip above dropped the
        # dates of branches `age_days` still reads through its lineage, which is the same
        # over-claim from the other end -- 2 of 155 arcs, worst at 119 against 87. Keep both:
        # any new age comes from `days_ago` and never from a fresh division by 86400, and
        # anything excluded from the volume here still contributes its dates.
        "cliff_days": today - days[-1],
        "typical_gap_days": typical,
    }
    older = sum(1 for d in days if today - d > SERIES_DAYS)
    if older:
        out["older_active_days"] = older
    return out


def _forgotten_why(arc, act):
    """The evidence sentence, in the shape the plan asked for it.

    "19 sessions across 3 days of work, then nothing for 12 days, never landed." One
    sentence carrying the level, the derivative and the reason it is still open, which is
    the whole verdict -- so a reader can disagree with it on the facts rather than having
    to trust it.

    It used to open on a commit count: "83 commits across 19 days, then nothing for 14
    days". That led with the churn and buried the scale -- in agentic development the
    number of commits is a fact about how the work was typed, and this sentence is about
    how much of it there was to lose. The days were already here and already right:
    distinct active days, a stack counted once, a superseded copy's volume excluded. So
    the fix is to lead with them and drop the number that stood in front of them. The
    transcript-entry fallback goes with it, for the same reason and one more: the days
    cover the case it existed for, since an arc with entries and no commits still has the
    days it was worked on.
    """
    inv = act["invested"]
    d, k = inv["days"], act["cliff_days"]
    work = f"{d} day" + ("" if d == 1 else "s") + " of work"
    lead = (f"{inv['sessions']} session" + ("" if inv["sessions"] == 1 else "s")
            + f" across {work}") if inv["sessions"] else work
    sentence = lead + f", then nothing for {k} day" + ("" if k == 1 else "s")
    # "never landed" would flatly contradict the row above it on an arc that is part
    # merged and part not, and that mixture is common enough to have its own line in
    # finalize. Say which it is.
    n = arc.get("landed_branches") or 0
    if n:
        return (sentence + f" — {n} branch{'' if n == 1 else 'es'} landed, "
                "what is left never did.")
    return sentence + ", never landed."


def mark_forgotten(arc):
    """Did engagement here fall off a cliff, and on what evidence.

    Three tests, and every one of them is needed to keep this from collapsing back into the
    loose-ends list it replaces:

      level        enough went in that losing it costs something. Either axis alone --
                   transcript entries or commits -- because they are not commensurable.
      derivative   the silence is long in absolute terms AND long against this arc's own
                   rhythm. The second half is what makes it a cliff rather than an age: a
                   fortnight's quiet on something worked every third day is normal, and on
                   something worked daily it is a stop.
      unsettled    nothing closed it, nobody else is holding it, you did not park it.

    Deliberately absent: a fourth test on intensity. It reads as though it should be here --
    "hammered for three days" is half the plan's own example -- but it is already implied.
    Light work fails the level test and heavy work passes it, whatever shape it arrived in;
    an extra threshold on entries-per-day would only reject heavily-worked arcs for having
    been worked patiently, which is not a fault. The rate is emitted as a fact for anything
    downstream that wants it, and gates nothing.

    Runs after apply_parked and after the second finalize, because two of its three tests
    read `stage` and `parked` -- and recomputed rather than accumulated, so a verdict from
    an earlier pass can never outlive the facts that produced it.

    And it abstains where it cannot see. `stage` is what carries the in-review and
    pre-landing exemptions, both of which are derived from merge requests, so an arc whose
    MRs were never fetched has no exemption available to it and would be accused by default.
    See the mrs_known check at the bottom.
    """
    act = arc.get("activity")
    if not act:
        return
    act.pop("forgotten", None)
    if not act.get("invested"):
        return

    fp = _dfp("forgotten", arc.get("id"), arc.get("label"), act.get("last_active"))

    def verdict(ok, why, because=()):
        act["forgotten"] = {"verdict": ok, "why": why, "because": list(because),
                            "fp": fp}

    inv, k = act["invested"], act["cliff_days"]
    if arc.get("settled"):
        return verdict(False, {"landed": "landed", "abandoned": "abandoned"}
                       [arc["settled"]] + " — finished, not forgotten")
    if arc.get("parked"):
        return verdict(False, "parked on purpose — the one thing this cannot derive")
    if arc.get("residue"):
        # The other thing this cannot derive, and the stronger of the two. Parking says
        # "not yet"; residue says "never", and there is nothing in work nobody meant to
        # finish to have been forgotten. Accusing it would be the feature's own worst
        # failure mode -- a false accusation, on the one arc a person has already told it
        # about.
        return verdict(False, "residue — you said this was never meant to land, so "
                              "there is nothing here to have dropped")
    if arc.get("stage") in FORGOTTEN_EXEMPT:
        return verdict(False, FORGOTTEN_EXEMPT[arc["stage"]])

    invested = (inv["entries"] >= _knob("min_entries")
                or inv["commits"] >= _knob("min_commits"))
    if not invested:
        return verdict(False, f"only {inv['entries']} entries and {inv['commits']} "
                       f"commits went in — too little to have been lost")
    if k < _knob("cliff_days"):
        return verdict(False, f"still live — last touched {k} day"
                       + ("" if k == 1 else "s") + " ago")
    if k > _knob("cliff_max"):
        return verdict(False, f"silent {k} days — past recovering from memory, which is "
                       "a different problem from forgetting it")
    gap = act["typical_gap_days"] or 1
    if k < _knob("cliff_ratio") * gap:
        return verdict(False, f"quiet {k} days against a {gap}-day rhythm — a pause, "
                       "not a cliff")
    # Last, and it is a refusal to answer rather than an answer. Two of the three exemptions
    # above -- in-review and pre-landing -- are stages that only merge-request data can
    # establish, so where GitLab was not asked or would not answer, `stage` collapses to
    # local-only and both exemptions become unreachable. Measured on this corpus: 3 of the 5
    # arcs a --no-mr run calls forgotten are pre-landing residue that the full run correctly
    # exempts. Those are false accusations of exactly the kind this feature's own docstring
    # says must never happen, and they arrive without anybody choosing a cheap run -- a
    # GitLab outage during the 07:10 cron sets mrs_known False all by itself.
    #
    # Placed after every derivable negative rather than before them, deliberately. An arc can
    # still be told it is NOT forgotten for any reason that needs no MR -- settled, parked,
    # too little invested, still live, archaeology, a pause -- because those answers are
    # sound and a reader asking "why not?" should still get one. It is only the accusation
    # that needs the whole picture.
    if not arc.get("mrs_known", True):
        return verdict(False, "GitLab was not asked, so whether a reviewer or a landed "
                       "sibling explains this silence cannot be known — not accused")

    verdict(True, _forgotten_why(arc, act), [
        f"{inv['entries']} transcript entries and {inv['commits']} commits over "
        f"{inv['days']} active day" + ("" if inv["days"] == 1 else "s"),
        f"silent {k} days, {k // gap}× its own {gap}-day rhythm",
        f"{arc.get('stage') or 'unsettled'} — not landed, not parked, "
        "nobody else's clock is running",
    ])


def fell_off_a_cliff(arcs, include_dismissed=True):
    """The forgotten arcs, freshest cliff first.

    Freshest first rather than biggest first, and that is a judgement about what the list is
    for: you resume one of these, and the one you can still resume is the one you fell off
    most recently. Ranking by size would put a two-month-old 240-commit arc above last
    week's, which is the order in which they are impressive rather than the order in which
    they are recoverable.

    It is also the only ranking available honestly. Size would mean ranking entries against
    commits, and there is no exchange rate between them -- the same reason the page never
    sorts a stalled review against a swathe of unpublished work. They break ties here and
    nothing more. Total tiebreak down to the label, because arc-brief fingerprints evidence
    text and any order that reaches output has to be the same order twice.
    """
    out = [a for a in arcs
           if ((a.get("activity") or {}).get("forgotten") or {}).get("verdict")
           and (include_dismissed
                or not a["activity"]["forgotten"].get("dismissed"))]
    out.sort(key=lambda a: (a["activity"]["cliff_days"],
                            -a["activity"]["invested"]["entries"],
                            -a["activity"]["invested"]["commits"],
                            str(a.get("label") or ""), str(a.get("id") or "")))
    return out


def only_here(arcs):
    """Work that exists nowhere but this laptop, most at stake first.

    The page could say how much unpublished work there was -- "24 exist only on this
    laptop, 31 days of work" -- and then had nowhere to say WHICH. That is the one
    question a count of at-risk work has to be able to answer, because a number you cannot
    cash in is a number you stop reading. The alarm used to be diffused instead, as a
    commit count under every card, which is the shape Kyle rejected outright: "the goal is
    to keep track of the broad strokes of my work, not every singular commit everywhere".
    One ranked list, capped where it is rendered, is the opposite arrangement of the same
    concern -- and it is the arrangement that survives "i do often have a dangling commit
    that _is_ meaningful and i dont want to lose track of".

    Ranked on expected loss: DAYS OF WORK times how long nothing has touched the arc. Both
    halves are load-bearing and neither is sufficient. Days of work alone ranks by what
    would be lost and says nothing about whether you are about to lose it -- a fortnight
    you committed this morning is not at risk, it is in progress. Staleness alone ranks a
    forgotten one-line scratch branch above a month of unpushed work. The product is the
    only combination of the two that says "how much would this cost, and how likely am I
    to have forgotten it".

    `max(age_days, 1)` rather than `age_days`, because an arc touched today has age 0 and
    a score of zero would sort the biggest live body of work to the bottom of a list about
    risk. A day is the floor of the unit either way.

    Ids only, in order, exactly as `forgotten` is emitted -- the ranking, not the data. The
    arcs themselves already carry `unpushed_days`, `unpushed_dates` and `authoritative`, so
    a renderer that got rows here would be reading two copies of the same workstream. And
    total tiebreak down to the id, because a ranking that reaches output has to be the same
    ranking twice.

    Over every arc with local-only content rather than over the `local-only` rung alone: an
    arc out for review with a fortnight of unpushed work on top of its merge request is
    holding exactly as much unrecoverable work as one that never pushed. The rung says
    whose move it is; this says what is on the disk. A renderer scoped to a window (the
    page is) intersects with its own set and keeps this order.
    """
    at = [a for a in arcs if a.get("unpushed_live")]
    at.sort(key=lambda a: (-(a.get("unpushed_days", 0) * max(a.get("age_days", 0), 1)),
                           -a.get("unpushed_days", 0),
                           -a.get("unpushed_live", 0),
                           str(a.get("id") or "")))
    return [a["id"] for a in at]


def _day_epoch(text):
    """A YYYY-MM-DD from the API as an epoch. Day resolution is all these carry."""
    try:
        return int(datetime.strptime(text[:10], "%Y-%m-%d").timestamp())
    except (ValueError, TypeError):
        return 0


def _iso_epoch(text):
    """A full API timestamp as an epoch, or 0. The precise sibling of `_day_epoch`.

    GitLab stamps `2026-08-12T19:41:07.000Z` and Jira `2026-08-12T19:41:07.000-0700`;
    fromisoformat handles both once the trailing Z is spelled the way it means. Falls
    back to the day, then to 0 -- and 0 is load-bearing rather than a sentinel nobody
    checks: close_commitments only ever compares "did this happen after that", so an
    unparseable date orders before everything and closes nothing.
    """
    if not text:
        return 0
    try:
        return int(datetime.fromisoformat(
            str(text).strip().replace("Z", "+00:00")).timestamp())
    except (ValueError, TypeError):
        return _day_epoch(text)


def demands(arc):
    """What this arc needs from *you*, worst first. Empty means it is someone else's turn.

    The correction this makes: an arc whose only state is "up for review" was rendering as
    the hottest thing on the page, level with work that is genuinely stuck. Getting a
    discrete piece of work up for review is most of the job done -- the counterparty is a
    reviewer and the clock is theirs. It belongs at the bottom.

    What belongs at the top is the small set of things where the work has come back: a
    branch that no longer merges, a question nobody answered, a pipeline that went red, an
    approval that never turned into a merge, and commits that exist on this laptop only.
    """
    out = []
    for m in arc.get("mrs", []):
        ref = f"!{m.get('iid')}"
        # `at` is when the thing happened, and it is what decides whether something is news
        # or just a state. Conflicts and approvals carry no timestamp of their own, so the
        # MR's own last-update stands in -- a proxy, and labelled as one rather than passed
        # off as the moment the branch stopped merging.
        mr_at = _day_epoch(m.get("updated", ""))
        if m.get("conflicts"):
            out.append({"kind": "conflict", "what": f"{ref} no longer merges into "
                        f"{m.get('target') or 'main'} — rebase", "url": m.get("url", ""),
                        "at": mr_at, "at_is_proxy": True})
        # One demand per MR, not per thread. Four threads produced four rows reading
        # "asked, unanswered since 2026-08-13" with only the quote to tell them
        # apart, which is a list of the same sentence. Who is waiting and since when is
        # the demand; the questions are its evidence.
        # Two different obligations, and merging them produced the worst kind of wrong
        # reminder: four reviewer threads reported as awaiting you when you had replied to
        # every one. Whoever spoke last says whose turn it is.
        threads = m.get("threads", [])
        for answered, kind in ((False, "threads"), (True, "unresolved")):
            group = [t for t in threads if bool(t.get("answered")) is answered]
            if not group:
                continue
            n = len(group)
            if answered:
                who = sorted({t["author"] for t in group})
                what = (f"{ref}: {n} thread{'' if n == 1 else 's'} you answered that "
                        f"nobody resolved — {', '.join(who)} raised "
                        f"{'it' if n == 1 else 'them'}")
            else:
                who = sorted({t["last_by"] for t in group})
                oldest = min((t["last_at"] for t in group if t["last_at"]), default="")
                what = (f"{ref}: {n} thread{'' if n == 1 else 's'} awaiting your reply — "
                        f"{', '.join(who)} spoke last"
                        + (f", oldest {oldest}" if oldest else ""))
            newest = max((_day_epoch(t.get("last_at", "")) for t in group), default=0)
            # `sig` exists only to sharpen the run-over-run fingerprint below, and is
            # folded into it and dropped. `what` alone is too blunt for that job: only the
            # first note of a thread is quoted, so a reviewer adding a third comment to an
            # existing thread leaves the count, the names and the oldest date all
            # unchanged. Who spoke last and how many notes deep it is are the fields that
            # actually move, so they are what the fingerprint is taken over.
            out.append({"kind": kind, "what": what,
                        # Who asked, with what they asked. The names were already in the
                        # sentence and the quotes underneath it were anonymous, so on a
                        # thread with three reviewers the page stated who was waiting and
                        # then showed three unattributed slabs for the reader to match up.
                        "quotes": [{"text": t["quote"], "who": t.get("author") or "",
                                    "at": t.get("at") or ""}
                                   for t in group if t.get("quote")],
                        "url": m.get("url", ""), "at": newest,
                        "sig": sorted(
                            "|".join((t.get("author", ""), t.get("at", ""),
                                      t.get("last_by", ""), t.get("last_at", ""),
                                      str(t.get("notes", 0)))) for t in group)})
        pipe = m.get("pipeline") or {}
        if pipe.get("status") in ("failed", "canceled"):
            out.append({"kind": "pipeline",
                        "what": f"{ref} pipeline {pipe['status']} on {pipe.get('at','')}",
                        "url": pipe.get("url") or m.get("url", ""),
                        "at": _day_epoch(pipe.get("at", ""))})
        stack = m.get("stack")
        # Not while QA has the branch. "!10391 is approved and still open — merge it" was
        # the same shape of wrong as the stacked case below: an instruction to press a
        # button that is not his to press yet. UL-1773 was approved, mergeable, targeting
        # main and green -- and its ticket had moved to In Qualification, which in this
        # workflow means somebody is testing that branch and the merge follows their
        # verdict. Merging it would have pulled the thing out from under them.
        if (m.get("approved") and not m.get("draft") and not stack
                and not m.get("qualifying")):
            out.append({"kind": "approved",
                        "what": f"{ref} is approved and still open — merge it",
                        "url": m.get("url", ""), "at": mr_at, "at_is_proxy": True})
        elif m.get("approved") and not m.get("draft") and stack:
            # Approved and unmergeable, which is a different obligation from approved and
            # ready. What it needs is a decision about the stack, and the demand carries the
            # evidence for that decision rather than sending you to the MR to work it out.
            if not stack.get("blocked_by"):
                waits = f"{stack['target']} has to land first"
            elif stack.get("blocker_state") == "opened":
                waits = f"!{stack['blocked_by']} has to land first"
            else:
                # The target's own MR is already finished, so nothing is in the way at all
                # -- the MR is just still pointed at a branch that has served its purpose.
                waits = (f"its target's own !{stack['blocked_by']} already "
                         f"{stack['blocker_state']}, so nothing is waiting on anything")
            n = stack.get("own") or 0
            if stack.get("rebase_clean") is True:
                how = (f"rebasing its {n} commit onto main is clean" if n == 1
                       else f"rebasing its {n} commits onto main is clean")
                how += " — retarget it and merge today"
            elif stack.get("rebase_clean") is False:
                c = len(stack.get("conflicts") or [])
                how = (f"rebasing onto main conflicts in {c} file"
                       + ("" if c == 1 else "s") + ", so the stack is real")
            else:
                how = "whether it rebases onto main could not be determined"
            out.append({"kind": "stacked",
                        "what": f"{ref} is approved but targets {stack['target']}, not "
                                f"main — {waits}; {how}",
                        "quotes": stack.get("conflicts") or [],
                        "url": m.get("url", ""), "at": mr_at, "at_is_proxy": True})
        if m.get("draft") and arc.get("age_days", 0) > 14:
            out.append({"kind": "draft",
                        "what": f"{ref} has been a draft for {arc['age_days']}d — nobody "
                                "will review it", "url": m.get("url", "")})
        # An open merge request nobody has been asked to look at. "In review" was asserted
        # from the existence of the MR and nothing else, which made it the one claim on the
        # page that could be false in the direction that costs days: work you believe is with
        # a reviewer, that no reviewer has been told about. Measured here: of 18 open MRs, 5
        # had no reviewer, no assignee and no comment, and every one was filed in the last
        # three days -- the exact window in which you still think you handed it off.
        #
        # Narrow on purpose, because this accuses you of forgetting something. A draft is not
        # meant to carry reviewers yet; an approval is proof somebody read it; a comment is
        # proof somebody found it. Any of those and the MR is attended, whatever the reviewer
        # field says.
        if not (m.get("draft") or m.get("reviewers") or m.get("assignees")
                or m.get("approvals") or m.get("notes")):
            out.append({"kind": "unrequested",
                        "what": f"{ref} has no reviewer and no comment — nobody has been "
                                "asked to look at it",
                        "url": m.get("url", ""), "at": mr_at, "at_is_proxy": True})

    for b in arc.get("branches", []):
        pipe = b.get("pipeline") or {}
        if (pipe.get("status") == "failed" and not b.get("superseded_by")
                and not b.get("historical")):
            out.append({"kind": "pipeline",
                        "what": f"{b['name']} pipeline failed on {pipe.get('at','')}",
                        "url": pipe.get("url", "")})

    # Only commits that are the live work. A superseded copy's commits already exist on
    # the branch that supersedes it, so counting them as at-risk invents risk: the one
    # unpushed commit on `lint-metric-instance-stability` is a cherry-pick of a commit
    # that is pushed, reviewed and in an MR.
    if arc.get("unpushed_live"):
        scale, verb = work_scale(arc.get("unpushed_days", 0), arc["unpushed_live"])
        out.append({"kind": "unpushed",
                    "what": f"{scale} {verb} nowhere but this laptop"})

    auth = arc.get("authoritative")
    # Only when GitLab was actually asked. With --no-mr, or when glab is missing or the API
    # call failed, every arc has an empty MR list -- and this fired on all of them, telling
    # you 8 arcs had no merge request when the truth was that nobody looked. A wrong
    # reminder costs more trust than ten right ones earn.
    if auth and arc.get("mrs_known", True) and not arc.get("mrs"):
        b = next((x for x in arc["branches"] if x["name"] == auth), None)
        # Never for a branch whose MR already merged or closed. 11 of 17 of these claims
        # were false for exactly that reason: squash-merge hides the landing from ancestry,
        # so UL-1835 was told to open the merge request it had already merged as !10449.
        if (b and b.get("pushed") and b.get("commits_ahead", 0) > 0
                and not b.get("mr_fate")):
            # No number at all, where the two above carry a scale. Nothing is at risk here
            # -- the branch is pushed -- so the size of it changes nothing about what to do,
            # and the only number available was a commit count, which is the unit this page
            # no longer speaks in. The branch name is the fact worth carrying.
            out.append({"kind": "unreviewed",
                        "what": f"{auth} is pushed and has no merge request"})

    out.sort(key=lambda d: DEMAND_RANK.get(d["kind"], 9))
    # The arc's label disambiguates: "3 days of work exist nowhere but this laptop" is
    # the same sentence on many arcs, and without the label one ✕ would acknowledge all of
    # them at once.
    #
    # `rfp` is the same fact fingerprinted for a different question -- did this move
    # since the last build -- and it deliberately leaves the label OUT. Measured this
    # week: the split pass reworded one arc "selected state" -> "selected-state" -> back
    # within an evening, and a run-over-run comparison keyed on `fp` would have reported
    # every demand on it as brand new both times. The label is presentation; the MR ref,
    # the sentence and the thread signature are the fact.
    for d in out:
        d["fp"] = _dfp("demand", arc.get("label"), d.get("kind"), d.get("what"),
                       d.get("url"))
        d["rfp"] = _dfp("run", d.get("kind"), d.get("what"), d.get("url"),
                        *(d.pop("sig", None) or []))
    return out


def finalize(arc, repo=None, main_ref="origin/main"):
    # Runs twice: once as arcs are built, and again after Jira issues are joined on, since
    # which branch is authoritative can depend on which ticket the arc owns. Every field
    # here is recomputed rather than added to, so the second pass is a no-op where nothing
    # changed and a correction where something did.
    # Most recently updated first, drafts last: on an arc holding several MRs that is the
    # one the work is currently about, and everything downstream reads mrs[0] as the one
    # that speaks for the arc. Two stable sorts rather than one composite key.
    arc["mrs"].sort(key=lambda m: m.get("updated") or "", reverse=True)
    arc["mrs"].sort(key=lambda m: m.get("draft", False))

    mark_duplicates(arc, repo, main_ref)
    mark_predates_landing(arc)

    # Two different ages, because they answer different questions. The newest
    # touch says "is this live"; the median says "how much of this has gone cold".
    # Min alone made every large arc look active: one commit today in a 17-branch
    # cluster is not the same as the cluster being worked on.
    ages = sorted(
        [b["age_days"] for b in arc["branches"]]
        + [s["age_days"] for s in arc["sessions"]]
    )
    # ...and the newest touch is asked of the work itself, not of everything clustered
    # with it. File overlap puts foreign branches in an arc and the split pass does not
    # catch every one, so `min` over all members let a stranger date the arc: the thor
    # telemetry arc read `today` off a UL-1633 commit while its own branch had not moved
    # in seven days and its merge request had been open, unreviewed, for as long. The
    # lineage is the authoritative branch plus anything superseded by something in it --
    # the backups and pre-squash copies of the same work -- and sessions are scoped the
    # same way, by the branch they were held on.
    lineage = {b["name"] for b in arc["branches"] if b.get("authoritative")}
    if lineage:
        for _ in range(len(arc["branches"])):
            grew = {b["name"] for b in arc["branches"]
                    if b.get("superseded_by") in lineage} - lineage
            if not grew:
                break
            lineage |= grew
        own = ([b["age_days"] for b in arc["branches"] if b["name"] in lineage]
               + [s["age_days"] for s in arc["sessions"] if s.get("via") in lineage])
        arc["age_days"] = min(own) if own else (ages[0] if ages else 999)
    else:
        arc["age_days"] = ages[0] if ages else 999
    arc["median_age_days"] = ages[len(ages) // 2] if ages else 999

    # Two numbers, because they answer different questions. `unpushed` is the per-branch
    # sum -- the fact about the refs, and what every earlier version of this reported.
    # `unpushed_live` is how many commits are genuinely only here: counted once each rather
    # than once per branch that contains them, and over live branches only, since a
    # superseded copy's commits already exist on the branch that supersedes it. The gap
    # between the two is how much of this arc's apparent risk is the same work recounted.
    # A workstream every branch of which has landed or been abandoned is finished, and its
    # only honest place on a page about live work is a count. Any branch still without a
    # settled MR keeps the arc alive -- work continuing on top of a merged branch is normal
    # and is exactly the case a whole-arc test must not swallow.
    #
    # A superseded copy is not such a branch. !10332 merged the bound-sources hotfix and the
    # arc still read "pushed, no merge request", because one member was a cherry-picked
    # duplicate that had never had an MR of its own -- its content had landed on the branch
    # it copies. A copy is accounted for by whatever accounts for its original, so the test
    # resolves through supersession before asking whether anything is left.
    by_name = {b["name"]: b for b in arc["branches"]}
    fate_of = {n: (b.get("mr_fate") or {}).get("state") for n, b in by_name.items()}
    settled_names = {n for n, f in fate_of.items() if f in ("merged", "closed")}
    # A branch a declaration set aside is accounted for by the branch that shipped, exactly
    # as a superseded copy is. Without this the arc could never reach `landed`: the merge
    # request would merge and eleven drafts from before it would keep the workstream open
    # forever, which is the shape of wrongness the declaration exists to correct.
    settled_names |= {n for n, b in by_name.items() if b.get("historical")}
    for _ in range(len(by_name)):
        grew = False
        for n, b in by_name.items():
            sup = b.get("superseded_by")
            if n not in settled_names and sup in settled_names:
                settled_names.add(n)
                grew = True
        if not grew:
            break
    if by_name and settled_names == set(by_name) and any(
            f == "merged" for f in fate_of.values()):
        arc["settled"] = "landed"
    elif by_name and settled_names == set(by_name):
        arc["settled"] = "abandoned"
    else:
        arc["settled"] = None

    # Counted over the whole arc still, because it is the fact about the refs. What the
    # declaration changes is `unpushed_live` below -- what is genuinely outstanding.
    arc["unpushed"] = sum(b["unpushed"] for b in arc["branches"])
    # Commits on a branch whose MR already merged are not work waiting to be pushed. Both
    # this and supersession answer the same question -- is this commit's content already
    # somewhere safe -- and both have to be excluded before a number is called risk.
    def dead(b):
        # `historical` is the third way a commit can already be accounted for, and the only
        # one a person rather than the repo asserts: the work went out as another branch and
        # this one is a draft from before it. Same consequence as supersession -- its commits
        # are not risk and its absence of an MR is not a demand.
        # `residue` is the fourth, and the only one that is a claim about intent rather
        # than about where the content already is. The other three say "these commits are
        # somewhere safe"; this one says "these commits were never going to land". Same
        # consequence for every number below -- not risk, not a demand -- because debt you
        # are not going to pay is not debt either.
        return bool(b.get("superseded_by")) or bool(b.get("historical")) or \
            bool(b.get("residue")) or \
            b.get("mr_fate", {}).get("state") in ("merged", "closed")

    # Residue is out of `held` as well as out of `live`, where the other three exclusions
    # are only out of `live`. The gap between the two is reported as "only on a superseded
    # copy", which is a claim about the repo, and leaving declared residue inside it would
    # credit a person's judgement to a derivation -- and inflate the one number on the card
    # that exists to say what deleting the copies would cost.
    held = [b["name"] for b in arc["branches"]
            if b["unpushed"] and not b.get("residue")]
    live = [b["name"] for b in arc["branches"] if b["unpushed"] and not dead(b)]
    if repo is not None:
        # One walk, two facts. `unpushed_live` is the count it always was; the dates it
        # rides on are what the page says out loud, since days of work is a scale a person
        # can feel and a commit count is not. No extra subprocess: the same walk that used
        # to answer --count now prints one author date per commit.
        authored = unpushed_authored(repo, live)
        arc["unpushed_live"] = len(authored)
        arc["unpushed_dates"] = sorted(set(authored))
        # What deleting only the copies would cost: distinct commits that exist on a
        # superseded branch and nowhere else. Reporting `unpushed - unpushed_live` as
        # "on superseded copies" conflated two different corrections and overstated this
        # by an order of magnitude -- most of that gap is one stack counted per branch.
        arc["unpushed_only_on_copies"] = (distinct_unpushed(repo, held)
                                          - arc["unpushed_live"])
    else:
        # No repo to ask, so commits cannot be counted once each across branches -- but
        # WHICH branches count is the same question either way, and it is `dead` that
        # answers it. This used to test supersession alone, which meant the degraded path
        # disagreed with the real one about merged branches as well as about declared
        # history.
        arc["unpushed_live"] = sum(b["unpushed"] for b in arc["branches"]
                                   if not dead(b))
        # Over `held` rather than over `unpushed`, so the degraded path draws the same
        # line the real one does: `unpushed` is the whole arc, declared residue included,
        # and subtracting the live count from it would report a person's judgement about
        # intent as a fact about superseded copies.
        arc["unpushed_only_on_copies"] = (
            sum(b["unpushed"] for b in arc["branches"]
                if b["unpushed"] and not b.get("residue")) - arc["unpushed_live"])
        # No repo means no author dates, and there is no second source for them. The scale
        # degrades to naming none rather than to guessing one -- see work_scale.
        arc["unpushed_dates"] = []
    arc["unpushed_days"] = len(arc["unpushed_dates"])
    # What the residue declaration set aside, counted in the same units as the live work
    # and on its own walk. Neither number above can stand in for it: `unpushed_live`
    # excludes it by design and `unpushed_only_on_copies` is now a statement about copies
    # alone. And de-emphasis needs a figure to de-emphasise -- the card strikes this
    # through rather than dropping it, because a number that vanished is a number a reader
    # cannot check, and "these commits stopped counting" is the whole claim being made.
    res_names = [b["name"] for b in arc["branches"]
                 if b.get("residue") and b["unpushed"]]
    if res_names and repo is not None:
        dated = unpushed_authored(repo, res_names)
        arc["residue_commits"], arc["residue_days"] = len(dated), len(set(dated))
    else:
        # Same degradation as `unpushed_dates`: with no repo the commits can still be
        # summed per branch, and the days are named as none rather than guessed at.
        arc["residue_commits"] = sum(b["unpushed"] for b in arc["branches"]
                                     if b.get("residue"))
        arc["residue_days"] = 0
    arc["superseded"] = sum(1 for b in arc["branches"] if b.get("superseded_by"))
    arc["landed_branches"] = sum(1 for b in arc["branches"]
                                 if b.get("mr_fate", {}).get("state") == "merged")
    # Stashes contribute a token amount: they break ties, they do not set priority.
    arc["at_risk"] = arc["unpushed_live"] + min(
        sum(s["src_count"] for s in arc["stashes"]), 3)
    arc["stacked"] = sum(1 for b in arc["branches"] if b["parents"])

    auth, via = authoritative(arc)
    arc["authoritative"], arc["authoritative_via"] = auth, via
    for b in arc["branches"]:
        b["authoritative"] = b["name"] == auth
    # The ticket the work is filed under, kept apart from the rest. An arc can carry five
    # keys; exactly one of them is the one this branch is answering, and a subhead that
    # prints all five with no distinction between them says nothing about which.
    arc["ticket"] = None
    if auth:
        m = TICKET_RE.search(auth.upper())
        if m:
            arc["ticket"] = m.group(0)
    if not arc["ticket"] and arc.get("issues"):
        arc["ticket"] = arc["issues"][0]["key"]
    # And a hand-filed ticket is the ticket, whatever the branch name happens to say.
    if (arc.get("ticket_authority") or {}).get("key"):
        arc["ticket"] = arc["ticket_authority"]["key"]
    arc["historical_branches"] = sum(1 for b in arc["branches"] if b.get("historical"))

    # Which merge requests are out being qualified, joined per MR through its own ticket.
    # Empty on the first pass, when no Jira call has happened yet -- like everything else
    # here it is recomputed rather than added to, so the pass after reconcile is where it
    # lands and nothing has to remember to clear it.
    in_qa = {i["key"]: i.get("status") for i in arc.get("issues", [])
             if (i.get("status") or "").strip().lower() in QUALIFYING}
    for m in arc["mrs"]:
        m["qualifying"] = in_qa.get(mr_ticket(m))

    # How far this workstream has got, which is a fact about it rather than a verdict on
    # it. The old vocabulary was `at risk` / `idle` / `active`, and `at risk` was correctly
    # called useless: it is a severity word standing where a fact should be, and it told you
    # nothing about what the work needs or where it had reached. Every value below names
    # either a rung of the ladder or the specific thing that came back.
    settled = arc.get("settled")
    arc["demands"] = [] if settled else demands(arc)
    arc["fingerprint"] = arc_fingerprint(arc)
    # News is a comparison, not a checkbox. Something that came back is news only while it
    # postdates your own last commit or session here; work on it and it stops being news
    # without anything being clicked or dismissed.
    mine = own_activity(arc)
    arc["own_activity"] = mine
    arc["notify"] = [d for d in arc["demands"]
                     if d.get("at", 0) > mine and STAGE_OF.get(d["kind"]) == "came-back"]
    # Ranks WITHIN a rung only. There is no defensible exchange rate between "a reviewer asked
    # question six days ago" and "nine days of work exist nowhere but this laptop", so the
    # page never sorts one against the other -- see `stage`.
    arc["urgency"] = (DEMAND_RANK.get(arc["demands"][0]["kind"], 9)
                      if arc["demands"] else 99)

    # Every surviving branch older than the landing, and at least one landing: the work
    # shipped as a reshape and what is left are drafts from before it. Its own rung, above
    # `landed` in the ladder but distinctly not it -- these branches are residue you can
    # probably delete, which is a different statement from "this is finished" and a very
    # different one from "this is outstanding". Not hidden: the whole reason to derive it is
    # that it is a signal, and papering over it was explicitly not wanted.
    live_b = [b for b in arc["branches"]
              if not b.get("mr_fate") and not b.get("superseded_by")
              and not b.get("historical") and not b.get("residue")]
    arc["predates_landing"] = sum(1 for b in live_b if b.get("predates_landing"))
    stale_draft = bool(live_b) and all(b.get("predates_landing") for b in live_b)

    worst = arc["demands"][0]["kind"] if arc["demands"] else None
    if settled:
        arc["stage"] = settled
        arc["state"] = {"landed": "landed", "abandoned": "abandoned"}[settled]
    elif arc.get("residue"):
        # Its own rung, and it has to be one. With the marks in place every count on this
        # arc is zero and the ladder's last branch would call it "nothing outstanding" --
        # which is true and useless, since it makes a workstream a person wrote off
        # indistinguishable from one that is pushed and clean. The same conflation `at
        # risk` / `idle` was rejected for. Named rather than hidden, and it carries the
        # size it stopped counting, because "de-emphasis is not hiding" is only honest if
        # the figure is still on the row.
        arc["stage"] = "residue"
        n, d = arc.get("residue_commits", 0), arc.get("residue_days", 0)
        arc["state"] = ("residue — " + (work_scale(d, n)[0] if n else "nothing")
                        + " not counted")
    elif stale_draft:
        arc["stage"] = "pre-landing"
        ref = next(b["predates_landing"] for b in live_b if b.get("predates_landing"))
        n = len(live_b)
        arc["state"] = (f"{n} branch{'' if n == 1 else 'es'} older than "
                        + (f"!{ref['iid']}" if ref.get("iid") else ref["branch"])
                        + f", merged {ref['at']}")
    elif STAGE_OF.get(worst) == "came-back":
        arc["stage"] = "came-back"
        arc["state"] = {
            "conflict": "no longer merges", "threads": "awaiting your reply",
            "pipeline": "pipeline failed", "approved": "approved, not merged",
            # Not "approved, not merged", which reads as an oversight. Nothing was
            # overlooked here: it is approved and it cannot be merged where it points.
            "stacked": "approved, stacked", "draft": "still a draft",
        }[worst]
    elif worst == "unpushed":
        # The rung follows the worst thing outstanding, MR or no MR: an arc holding an open
        # merge request AND a fortnight of work that no remote has is not simply
        # "in review". Said in days rather than commits, so this fragment measures the same
        # kind of thing every other state on the ladder does -- a condition and its human
        # size, not a tally of how the work happened to be typed.
        arc["stage"] = "local-only"
        arc["state"] = work_scale(arc.get("unpushed_days", 0),
                                  arc["unpushed_live"])[0] + ", only here"
    elif worst == "unrequested":
        # Its own rung, between "no merge request" and "out for review", because it is
        # neither. The merge request is filed, so the work is not unproposed; no reviewer
        # has it, so it is not under review. Collapsing it into either neighbour loses the
        # only thing that makes it worth saying: this one looks handed off and is not.
        arc["stage"] = "no-reviewer"
        arc["state"] = "no reviewer asked"
    elif worst == "unreviewed":
        arc["stage"] = "not-proposed"
        arc["state"] = "pushed, no merge request"
    elif arc["mrs"]:
        # An MR open with nothing outstanding and somebody named on it: his end of the deal
        # is done and the clock belongs to a reviewer. This used to read "waiting on review"
        # and rank first. It also used to be asserted from the MR's existence alone, which
        # is how work nobody had been asked to review reported as being reviewed.
        arc["stage"] = "in-review"
        # The same rung either way -- somebody else has it -- but not the same somebody,
        # and "in review" about work a reviewer has already approved is a step behind
        # where it has got to. The ticket's own word is used rather than a word of ours.
        qa = next((m["qualifying"] for m in arc["mrs"] if m.get("qualifying")), None)
        arc["state"] = qa.lower() if qa else "in review"
    elif arc["unpushed_live"]:
        arc["stage"] = "local-only"
        arc["state"] = work_scale(arc.get("unpushed_days", 0),
                                  arc["unpushed_live"])[0] + ", only here"
    else:
        auth_b = next((b for b in arc["branches"]
                       if b["name"] == arc["authoritative"]), None)
        # The demand guards against this and the fallback did not, so the same false claim
        # arrived by a second route: "pushed, no merge request" about a branch whose MR had
        # merged. Anything asserting an absence has to check for the thing first.
        if (arc.get("mrs_known", True) and arc["authoritative"]
                and not (auth_b or {}).get("mr_fate")):
            arc["stage"] = "not-proposed"
            arc["state"] = "pushed, no merge request"
        else:
            arc["stage"] = "not-proposed"
            arc["state"] = "nothing outstanding"

    arc.setdefault("engagement", 0)
    arc["counts"] = {
        "branches": len(arc["branches"]),
        "stashes": len(arc["stashes"]),
        "mrs": len(arc["mrs"]),
        "sessions": len(arc["sessions"]),
    }
    # Every ordering here needs a total tiebreak, because arc-brief fingerprints the
    # evidence text and these orders decide it. `age_days` is a coarse integer, so ties are
    # the common case rather than the exception, and a stable sort then preserves whatever
    # order the input happened to arrive in.
    arc["branches"].sort(key=lambda b: (-b["unpushed"], b["age_days"], b["name"]))
    arc["stashes"].sort(key=lambda s: (-s["src_count"], s["ref"]))
    arc["sessions"].sort(key=lambda s: (-s["last"], s["id"]))


# ── what moved since the last build ────────────────────────────────────────────
#
# The plan's load-bearing rule for the background layer: it is silent unless something
# changed under you. Not "here are 155 arcs" but "of your 58 background arcs, 3 changed
# overnight: a pipeline failed, one got a review comment, one was reassigned to you."
# That sentence is not derivable from one run, so each run leaves a snapshot behind and
# the next one diffs against it.
#
# Two clocks must not be confused. `notify` already answers "what came back since *I*
# last touched this", and its clock is your own last commit or session. This one answers
# "what moved since the page was last built", and its clock is the previous run. The same
# fact can be news to one and not the other, and the page renders them in separate
# sections for exactly that reason.
#
# Nothing here is dismissable, deliberately. A dismissal is a content-fingerprinted
# acknowledgement that has to outlive the thing it acknowledges long enough to be useful;
# a diff line describes one interval and is gone on the next run whether or not anybody
# looked at it. There is nothing for an acknowledgement to expire against, so adding the
# machinery would only give the store rows that can never be pruned.
SNAPSHOT = (Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
            / "work-arcs" / "snapshot.json")
# Bumped whenever a field below changes meaning. A snapshot at any other version is
# discarded with a note rather than read: half-understood state is worse than none,
# because it produces confident sentences about changes that never happened.
#
# Deliberately NOT bumped when a whole new universe is *added* -- the Slack lens arrived
# after v1 and this still reads v1. `known` is what makes that safe and is the reason it
# exists: a v1 snapshot carries no `known["slack"]`, so the gate reads false and the lens
# is silent for exactly one run while every other comparison goes on working. Bumping
# would have thrown a morning's whole diff away to protect against a field that already
# protects itself.
SNAPSHOT_V = 1

# Merge-status values that mean "GitLab has not worked it out yet". They must never be
# one end of a reported transition. collect_mrs deliberately asks GitLab to recompute the
# verdict for any MR reading `unchecked`, precisely so the NEXT run knows -- so
# unchecked → conflict is the recheck landing, not the branch breaking, and reporting it
# as "stopped merging" would make this feature lie on a schedule of its own making.
MERGE_UNKNOWN = frozenset(("", "unchecked", "checking", "preparing", "unknown"))

# Worst first. Within an arc these order its sentences; across arcs the best sentence
# orders the arc. Every value is distinct except merged/closed, which are the same event
# from the page's point of view.
#
# `slack` sits just under `ledger` and over `merged`, which is a judgement worth stating.
# It is the same family as the two above it -- a person said something about this work --
# and it differs in not being addressed to Kyle, so it ranks below a debt with his name on
# it and above the news that something landed. Its two sides, a decision and a question left
# standing, deliberately share one rank for the same reason merged and closed do: from the
# page's point of view they are one event, the lens saying something about this arc it was
# not saying at the last build, and the sentence itself says which.
CHANGE_RANK = {
    "conflict": 0,         # the branch stopped merging
    "pipeline": 1,         # it went red
    "threads": 2,          # a reviewer asked you something and is waiting
    "ledger": 3,           # a new open loop with a person on the other end
    "slack": 4,            # a conversation about it settled or opened something
    "merged": 5,           # it landed
    "closed": 5,           # it was closed without landing
    "ticket": 6,           # its ticket moved in Jira
    "stage": 7,            # the rung it sits on moved
    "mergeable": 8,        # it became mergeable
    "unconflict": 9,       # it merges again
    "pipeline-green": 10,  # it went green again
}

MR_REF_RE = re.compile(r"^!(\d+)$")


def arc_mr_state(arc):
    """Every merge request this arc has, open or finished, keyed by iid as a string.

    Open ones come from the list call; finished ones exist only as the fate stamped on a
    branch, because collect_mrs asks for state=opened and a merged MR simply stops being
    returned. Both have to be recorded or "!10398 merged" is indistinguishable from
    "!10398 vanished", which is the one transition a morning brief most needs to state.

    Open state is written second on purpose: it comes from the fresher call, so where the
    two disagree about one iid the live one wins.
    """
    out = {}
    for b in arc.get("branches", []):
        f = b.get("mr_fate") or {}
        if f.get("iid"):
            out[str(f["iid"])] = {"state": f.get("state") or "", "merge_state": "",
                                  "conflicts": False, "pipeline": "",
                                  "url": f.get("url") or "", "at": f.get("at") or ""}
    for m in arc.get("mrs", []):
        if not m.get("iid"):
            continue
        out[str(m["iid"])] = {
            "state": "opened",
            "merge_state": m.get("merge_state") or "",
            "conflicts": bool(m.get("conflicts")),
            "pipeline": (m.get("pipeline") or {}).get("status") or "",
            "url": m.get("url") or "",
            "at": (m.get("updated") or "")[:10],
        }
    return out


def _ledger_rows(ledger):
    return ((ledger or {}).get("they_owe") or []) + ((ledger or {}).get("you_owe") or [])


# What the lens says about one arc, keyed on the message it quotes rather than on its words.
SLACK_SAYS = {"decided": "decided", "open": "left open"}


def slack_marks(arc):
    """The arc's Slack lens items, each keyed on the message it quotes and never its words.

    Three properties this key has to hold at once, and they pull against each other:

    * A model re-wording an item is not a change. The synthesis re-runs whenever a prompt
      changes or a cache is lost, and "the design team owns this" versus "design owns this"
      is the same decision. So the wording is not in the key at all -- the *quoted message*
      is, as (channel, ts) recovered from its permalink by `_perma_id`, which is the same
      identity the ledger dedupe already recovers there. Search writes `?thread_ts=&cid=`
      on its links and the ones built here do not, so string equality on the URL would
      compare two spellings of one message.
    * A revived thread IS a change. The block's own fingerprint carries the thread's last
      message, so a reply moves it, and the fingerprint is the first component of every key
      -- the same act that retires the ✕ on a block also makes its items new. That is the
      point: a thread somebody added to is not the thread that was read, and whether the
      re-synthesis happened to land on the same quotes is not what changed.
    * The side is part of the identity. One message can be the question at the last build
      and the answer at this one, and "that got settled" is a development.

    An acknowledged block is excluded outright rather than filtered later, so it is absent
    from the snapshot on both sides -- a ✕ before this build and a ✕ after it produce no
    row, no sentence and no arc in the changed count. That is the own-activity gate applied
    to the reader instead of the author: an aggregate claim ("16 workstreams moved under
    you") must not be built out of a fact its reader has already told the page he has seen.
    """
    out = {}
    for b in arc.get("slack") or []:
        if b.get("dismissed"):
            continue
        chan = b.get("channel") or ""
        where = f"#{chan}" if chan else ""
        for side, verb in SLACK_SAYS.items():
            for it in b.get(side) or []:
                pid = _perma_id(it.get("url"))
                if not pid:
                    continue
                out["\x1f".join((b.get("fp") or "", side, pid[0], pid[1]))] = {
                    "what": (f"a thread in {where} " if where else "a Slack thread ")
                            + f"{verb}: {it.get('what') or ''}",
                    "ref": where,
                    "url": it.get("url") or "",
                    "quotes": [{"text": it.get("quote"), "who": it.get("who") or "",
                                "avatar": it.get("avatar") or "",
                                "at": it.get("at") or "", "url": it.get("url") or ""}],
                }
    return out


def _mr_ref(ref):
    m = MR_REF_RE.match(str(ref or ""))
    return int(m.group(1)) if m else None


def snapshot_of(arcs, ledger, known, repo, generated):
    """The smallest per-arc state the next run needs to say what moved, and no more.

    Everything here is either an identity (the branch set), a fact that can move on its
    own (a merge state, a pipeline, a ticket status, an MR's fate), or a fingerprint of
    one (review threads, ledger rows). Notably absent: every counter that ticks by itself.
    `days`, `age_days` and `engagement` change on every run without anything happening,
    and storing them would guarantee a snapshot that always differs from the next one.

    Ledger rows are attributed to an arc through its merge requests, which is the only
    join that exists -- the ledger is a by-person view and an arc is a by-work one, and
    `!10438` is the single ref they share. Rows about other people's merge requests
    therefore attach to no arc at all, correctly: reviewing someone else's branch is not
    a development on any workstream of yours.

    The Slack lens is the one universe here that needs no such join, because it arrives
    already attached: a thread is matched to a workstream by the branch names, ticket keys
    and MR iids in its own text. What it needs instead is an identity per item that survives
    a re-wording, and that is `slack_marks`.
    """
    by_fp = {}
    for e in _ledger_rows(ledger):
        iid = _mr_ref(e.get("ref"))
        if iid is not None and e.get("fp"):
            by_fp.setdefault(iid, []).append(e["fp"])
    rows = []
    for arc in arcs:
        mrs = arc_mr_state(arc)
        iids = {int(k) for k in mrs}
        led = sorted({fp for iid in iids for fp in by_fp.get(iid, [])})
        rows.append({
            "id": arc.get("id"),
            # Kept for the stderr notes and for reading the file by hand. Nothing compares
            # on it -- see match_runs for why the label is not an identity.
            "label": arc.get("label"),
            "ticket": arc.get("ticket"),
            "branches": sorted(b["name"] for b in arc.get("branches", [])),
            "stage": arc.get("stage"),
            "state": arc.get("state"),
            "settled": arc.get("settled"),
            "own_activity": arc.get("own_activity", 0),
            "mrs": mrs,
            # Only the bucket where the counterparty spoke last. The `unresolved` bucket
            # -- threads you answered that nobody clicked Resolve on -- grows when *you*
            # reply, so reporting it would turn your own reply into news.
            "threads": sorted({d["rfp"] for d in arc.get("demands", [])
                               if d.get("kind") == "threads" and d.get("rfp")}),
            "ledger": led,
            # The Slack lens, keyed on the messages it quotes -- see slack_marks for why the
            # model's wording is nowhere in here. Unlike every other field on this row it
            # joins to the arc directly rather than through a merge request: a thread is
            # matched to a workstream by its branch names, ticket keys and MR iids, which is
            # a join the lens has already made and this need not repeat.
            "slack": sorted(slack_marks(arc)),
            "issues": {i["key"]: (i.get("status") or "")
                       for i in arc.get("issues", []) if i.get("key")},
        })
    rows.sort(key=lambda r: (r["label"] or "", r["id"] or ""))
    return {"v": SNAPSHOT_V, "generated": generated, "repo": repo,
            # Which universes this run actually consulted. A --no-mr run knows nothing
            # about merge requests, and the difference between "no MRs" and "nobody
            # looked" is the difference between a fact and a fabrication -- so the diff
            # skips any comparison whose universe was missing on either side, the same
            # discipline apply_dismissals uses before it prunes.
            "known": known, "arcs": rows}


def load_snapshot(repo):
    """The previous run's snapshot, or None with the reason it is not being used."""
    try:
        snap = json.loads(SNAPSHOT.read_text())
    except FileNotFoundError:
        return None, "no previous snapshot to compare against"
    except (OSError, ValueError) as e:
        print(f"work-arcs: ignoring {SNAPSHOT} — it could not be read ({e})",
              file=sys.stderr)
        return None, "the previous snapshot could not be read"
    if not isinstance(snap, dict) or snap.get("v") != SNAPSHOT_V:
        got = snap.get("v") if isinstance(snap, dict) else "?"
        print(f"work-arcs: discarding snapshot v{got} — this build writes v{SNAPSHOT_V}, "
              "so nothing is compared this run", file=sys.stderr)
        return None, f"the previous snapshot is v{got}, this build reads v{SNAPSHOT_V}"
    if snap.get("repo") and repo and snap.get("repo") != repo:
        print(f"work-arcs: discarding a snapshot of {snap['repo']!r} — this run is "
              f"{repo!r}", file=sys.stderr)
        return None, f"the previous snapshot was taken of a different repo ({snap['repo']})"
    return snap, None


def match_runs(prev_arcs, cur_arcs):
    """Pair last run's arcs with this run's by branch membership, never by label.

    The label cannot be the identity. Measured this week: the split pass reworded the same
    arc "selected state" -> "selected-state" -> back within one evening, so a comparison
    keyed on the name would have reported that arc as deleted and recreated twice, with
    every fact on it fresh news both times. The branch set is what the arc actually is.

    Same referent as apply_detached, and for the same reason: a detachment records the
    co-members it was declared against rather than the label, and applies while most of
    them are still what the branch is grouped with. Here the test is applied in both
    directions and made strict -- a *majority* of each side's branches shared, more than
    half rather than at least half -- which buys a property worth the extra character:
    the pairing is unique and needs no tie-breaking at all. Two disjoint subsets cannot
    each be more than half of the same set, so no old arc can qualify against two new
    ones and no new arc against two old ones. A 50/50 split of a two-branch arc, the one
    case a >= test would have had to guess at, falls out as unmatched instead.

    Everything unmatched is classified but never compared. Last run's side (`was`):

      split       its branches now spread across two or more new arcs
      absorbed    all its branches went to one new arc, as a minority of it
      disappeared none of its branches survive at all

    and this run's side (`now`):

      merged      it holds branches from two or more of last run's arcs
      split_off   it holds the minority half of one arc that split
      appeared    it holds no branch the last run had seen

    A regrouped arc is silent on purpose. Its stage, its state and its demands are all
    derived from its membership, so when the membership is what moved there is no honest
    way to say whether anything changed *under* you -- and the plan's fifth principle
    prices that trade explicitly: a wrong "changed under you" costs more trust than a
    missed one.
    """
    prev_sets = [set(a.get("branches") or []) for a in prev_arcs]
    cur_sets = [set(a.get("branches") or []) for a in cur_arcs]
    where = defaultdict(list)
    for i, s in enumerate(prev_sets):
        for b in s:
            where[b].append(i)
    shared = defaultdict(int)
    for j, s in enumerate(cur_sets):
        for b in s:
            for i in where.get(b, ()):
                shared[(i, j)] += 1

    pairs, took_prev, took_cur = [], set(), set()
    for (i, j), n in shared.items():
        if n * 2 > len(prev_sets[i]) and n * 2 > len(cur_sets[j]):
            pairs.append((i, j))
            took_prev.add(i)
            took_cur.add(j)
    # Uniqueness is a property of the test above, not of this ordering -- but the output
    # is ordered anyway, on the identity rather than on dict insertion, so two runs over
    # the same data produce byte-identical JSON.
    pairs.sort(key=lambda p: ((prev_arcs[p[0]].get("label") or "",
                               prev_arcs[p[0]].get("id") or ""),
                              (cur_arcs[p[1]].get("label") or "",
                               cur_arcs[p[1]].get("id") or "")))

    was = []
    for i, s in enumerate(prev_sets):
        if i in took_prev:
            continue
        lands = {j for b in s for j in range(len(cur_sets)) if b in cur_sets[j]}
        how = "disappeared" if not lands else ("split" if len(lands) > 1 else "absorbed")
        was.append({"label": prev_arcs[i].get("label"), "how": how,
                    "into": sorted(cur_arcs[j].get("label") or "" for j in lands)})
    now = []
    for j, s in enumerate(cur_sets):
        if j in took_cur:
            continue
        came = {i for b in s for i in where.get(b, ())}
        # One source that did not qualify as a match means this arc holds the smaller half
        # of something that split -- not a merge, whatever the count of sources says.
        how = "appeared" if not came else ("merged" if len(came) > 1 else "split_off")
        now.append({"label": cur_arcs[j].get("label"), "how": how,
                    "from": sorted(prev_arcs[i].get("label") or "" for i in came)})
    was.sort(key=lambda r: (r["how"], r["label"] or ""))
    now.sort(key=lambda r: (r["how"], r["label"] or ""))
    return pairs, {"was": was, "now": now}


LEDGER_SAYS = {
    "review-owed": lambda w, r: f"{w} asked for your review of {r}",
    "reply-owed": lambda w, r: f"{w} answered your comment on {r} — your turn",
    "review-silence": lambda w, r: f"still no response from {w} on {r}",
}


def _who(e):
    w = e.get("who")
    return ", ".join(w) if isinstance(w, list) else (w or "someone")


def diff_runs(prev, cur, arcs, ledger):
    """What moved between the previous snapshot and this run, one entry per arc.

    Grouped by arc rather than by fact, because that is the shape of the sentence the plan
    asks for: "3 of your background arcs changed overnight" needs a count of arcs, and a
    reader scanning the strip wants one line per workstream with its clauses attached, not
    the same workstream named four times.

    `what` is a plain list of sentences so the morning brief can lift them straight into
    prose; `evidence` is the same list with the ref, the URL and any quotes attached, so
    the page can link every clause to the thing it is a claim about. One is a projection
    of the other -- `what == [e["what"] for e in evidence]` -- rather than two lists that
    can drift apart.

    Three suppression rules, all of them there because the alternative is a confident
    wrong sentence:

    * An artifact is compared only where both runs saw it. An MR whose iid the previous
      snapshot never held arrived because a branch joined the arc, which is a regrouping
      and not a development.
    * A transition with an unknown at either end is not a transition. See MERGE_UNKNOWN:
      this tool asks GitLab to recompute the verdicts it lacks, so a verdict arriving is
      the most common apparent "change" there is, and it is not one.
    * Aggregate claims -- the rung the arc sits on -- are made only when the membership
      held still and only when you did nothing here yourself. `stage` is derived from
      branches and commits, so a stage that moved after your own commit moved because of
      your own commit. This is `notify`'s own_activity test, applied to the aggregate
      rather than to each fact: the facts keep their own clock, so a conflict that
      appeared on a branch you also committed to is still reported.
    """
    prev_arcs = prev.get("arcs") or []
    cur_arcs = cur.get("arcs") or []
    pairs, regroup = match_runs(prev_arcs, cur_arcs)
    pk, ck = prev.get("known") or {}, cur.get("known") or {}
    cmp_mrs = bool(pk.get("mrs")) and bool(ck.get("mrs"))
    cmp_issues = bool(pk.get("issues")) and bool(ck.get("issues"))
    cmp_ledger = bool(pk.get("ledger")) and bool(ck.get("ledger"))
    cmp_slack = bool(pk.get("slack")) and bool(ck.get("slack"))

    live = {a.get("id"): a for a in arcs}
    demand_by_rfp = {d["rfp"]: d for a in arcs for d in a.get("demands", [])
                     if d.get("rfp")}
    ledger_by_fp = {e["fp"]: e for e in _ledger_rows(ledger) if e.get("fp")}
    slack_by_mark = {}
    for a in arcs:
        slack_by_mark.update(slack_marks(a))

    changes = []
    for i, j in pairs:
        o, n = prev_arcs[i], cur_arcs[j]
        arc = live.get(n.get("id")) or {}
        stable = set(o.get("branches") or []) == set(n.get("branches") or [])
        mine_moved = (n.get("own_activity") or 0) > (o.get("own_activity") or 0)
        items = []

        def add(kind, text, ref="", url="", quotes=()):
            items.append({"kind": kind, "what": text, "ref": ref, "url": url,
                          "quotes": [q for q in quotes if q]})

        o_mrs, n_mrs = o.get("mrs") or {}, n.get("mrs") or {}
        settled_mr = False
        if cmp_mrs:
            for iid in sorted(set(o_mrs) & set(n_mrs), key=int):
                om, nm = o_mrs[iid], n_mrs[iid]
                ref, url = f"!{iid}", nm.get("url") or om.get("url") or ""
                if om.get("state") == "opened" and nm.get("state") in ("merged",
                                                                      "closed"):
                    settled_mr = True
                    when = nm.get("at") or ""
                    if nm["state"] == "merged":
                        add("merged", f"{ref} merged" + (f" on {when}" if when else ""),
                            ref, url)
                    else:
                        add("closed", f"{ref} was closed without merging"
                            + (f" on {when}" if when else ""), ref, url)
                    continue
                if nm.get("state") != "opened":
                    continue
                o_ms, n_ms = om.get("merge_state") or "", nm.get("merge_state") or ""
                known_both = (o_ms not in MERGE_UNKNOWN and n_ms not in MERGE_UNKNOWN)
                target = next((m.get("target") for m in arc.get("mrs", [])
                               if str(m.get("iid")) == iid), None) or "main"
                if known_both and nm.get("conflicts") and not om.get("conflicts"):
                    add("conflict", f"{ref} no longer merges into {target} — a conflict "
                        "appeared since the last build", ref, url)
                elif known_both and om.get("conflicts") and not nm.get("conflicts"):
                    add("unconflict", f"{ref} merges into {target} again", ref, url)
                elif known_both and n_ms == "mergeable" and o_ms != "mergeable":
                    add("mergeable", f"{ref} became mergeable — approved, with nothing "
                        "in the way", ref, url)
                o_p, n_p = om.get("pipeline") or "", nm.get("pipeline") or ""
                bad = ("failed", "canceled")
                if o_p and n_p in bad and o_p not in bad:
                    add("pipeline", f"{ref} pipeline turned {n_p} — it was {o_p} at the "
                        "last build", ref, url)
                elif o_p in bad and n_p == "success":
                    add("pipeline-green", f"{ref} pipeline is green again after {o_p}",
                        ref, url)

        # A new thread demand. The fingerprint moves when a reviewer speaks, and only
        # then -- see the `sig` it is taken over in demands().
        for rfp in sorted(set(n.get("threads") or []) - set(o.get("threads") or [])):
            d = demand_by_rfp.get(rfp)
            if not d:
                continue
            add("threads", d.get("what") or "a review thread is waiting on you",
                "", d.get("url") or "", d.get("quotes") or [])

        if cmp_ledger:
            for fp in sorted(set(n.get("ledger") or []) - set(o.get("ledger") or [])):
                e = ledger_by_fp.get(fp)
                # `thread-reply` is the same fact as the thread demand above, once by
                # person and once by work. On this strip it would be the same sentence
                # twice, so the by-work one speaks and the by-person one stays quiet.
                if not e or e.get("kind") == "thread-reply":
                    continue
                say = LEDGER_SAYS.get(e.get("kind"))
                text = (say(_who(e), e.get("ref") or "")
                        if say else f"{e.get('ref','')}: {e.get('kind','')} ({_who(e)})")
                add("ledger", text, e.get("ref") or "", e.get("url") or "",
                    [{"text": e.get("quote"), "who": _who(e)}] if e.get("quote") else [])

        # The Slack lens. A new item, or an item on a thread somebody has replied to since
        # the last build -- see slack_marks for what is and is not in that key. Read off the
        # live arc rather than the snapshot, like the thread demands above it: the snapshot
        # holds identities and the sentence needs the quote and the permalink, and principle
        # 5 says a claim of this kind is only worth making with its source one click away.
        if cmp_slack:
            for mark in sorted(set(n.get("slack") or []) - set(o.get("slack") or [])):
                it = slack_by_mark.get(mark)
                if not it:
                    continue
                add("slack", it["what"], it["ref"], it["url"], it["quotes"])

        if cmp_issues:
            o_is, n_is = o.get("issues") or {}, n.get("issues") or {}
            for key in sorted(set(o_is) & set(n_is)):
                was, now = o_is[key], n_is[key]
                if was and now and was != now:
                    i = next((x for x in arc.get("issues", [])
                              if x.get("key") == key), {})
                    add("ticket", f"{key} moved from {was} to {now}", key,
                        i.get("url") or "")

        # The rung. Last, and hedged three ways: only where the membership held still,
        # only where you did nothing here yourself, and never as a second telling of a
        # merge that has already been reported in its own words.
        if (stable and not mine_moved and o.get("stage") and n.get("stage")
                and o["stage"] != n["stage"]
                and not (settled_mr and n["stage"] in ("landed", "abandoned"))):
            was, now = o.get("state") or o["stage"], n.get("state") or n["stage"]
            if was == now:
                was, now = o["stage"], n["stage"]
            add("stage", f"moved from {was} to {now}")

        if not items:
            continue
        items.sort(key=lambda it: (CHANGE_RANK.get(it["kind"], 99), it["ref"],
                                   it["what"]))
        changes.append({
            "id": n.get("id"), "label": n.get("label"), "ticket": n.get("ticket"),
            "branches": n.get("branches") or [],
            "stage": n.get("stage"), "state": n.get("state"),
            "age_days": arc.get("age_days"), "urgency": arc.get("urgency", 99),
            "engagement": arc.get("engagement", 0),
            "membership": "stable" if stable else "shifted",
            "kinds": sorted({it["kind"] for it in items},
                            key=lambda k: CHANGE_RANK.get(k, 99)),
            "what": [it["what"] for it in items],
            "evidence": items,
        })
    # Worst first, and a total order: the rank alone ties constantly (six arcs can all
    # have gone red), and a stable sort then hands the page whatever order the arcs
    # happened to arrive in. Ordering feeds the brief, and the brief caches on the text
    # it is given -- the same lesson arc-brief's evidence fingerprint taught.
    changes.sort(key=lambda c: (CHANGE_RANK.get(c["kinds"][0], 99),
                                -(c["engagement"] or 0), c["label"] or "", c["id"] or ""))
    return {
        "v": SNAPSHOT_V,
        "previous_generated": prev.get("generated"),
        "interval_seconds": _interval(prev.get("generated"), cur.get("generated")),
        "compared": len(pairs),
        "changed": len(changes),
        # Counts first, because a consumer wants "3 of 152 moved, 4 were regrouped" and
        # not a wall of names -- these are facts about the derivation rather than about the
        # work. `detail` is kept for whoever is asking why a line they expected is missing.
        "not_compared": {
            "arcs": len(regroup["now"]),
            "how": {k: sum(1 for r in regroup["was"] + regroup["now"]
                           if r["how"] == k)
                    for k in sorted({r["how"] for r in
                                     regroup["was"] + regroup["now"]})},
            "detail": regroup,
        },
        "skipped_universes": sorted(
            k for k, ok in (("mrs", cmp_mrs), ("issues", cmp_issues),
                            ("ledger", cmp_ledger), ("slack", cmp_slack)) if not ok),
        "changes": changes,
    }


def _interval(a, b):
    """Seconds between two `generated` stamps, or None if either cannot be read."""
    try:
        fmt = "%Y-%m-%dT%H:%M:%S%z"
        return int((datetime.strptime(b, fmt) - datetime.strptime(a, fmt))
                   .total_seconds())
    except (ValueError, TypeError):
        return None


def write_snapshot(snap):
    """Replace the baseline the next run diffs against. Only ever behind --snapshot.

    An ad-hoc run must not move this. The baseline is "the state the page last showed
    you", and any experiment, test or one-off `work-arcs --json` that overwrote it would
    silently consume an interval's worth of changes -- the diff would come out empty and
    look like a quiet night. So the read is unconditional and the write is opt-in, and
    `arcs` is the only caller that passes the flag.

    Renamed into place rather than written in place: a run interrupted halfway through the
    dump would otherwise leave a truncated file, and the next run would report the whole
    graph as new work.
    """
    try:
        SNAPSHOT.parent.mkdir(parents=True, exist_ok=True)
        tmp = SNAPSHOT.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(snap, indent=1, sort_keys=True))
        os.replace(tmp, SNAPSHOT)
        return True
    except OSError as e:
        print(f"work-arcs: could not write {SNAPSHOT} ({e}) — the next run will have "
              "nothing to compare against", file=sys.stderr)
        return False


def main():
    p = argparse.ArgumentParser(description="Group a repo's loose work into arcs.")
    p.add_argument("--repo", type=Path, default=None,
                   help="defaults to JIRA_REPO from .env — the work repo is already "
                        "declared there, so it is not re-declared here")
    p.add_argument("--main", default=os.environ.get("WORK_ARCS_MAIN", "origin/main"))
    p.add_argument("--projects", type=Path,
                   default=Path(os.environ.get("WORK_ARCS_PROJECTS",
                                               Path.home() / ".claude/projects")))
    p.add_argument("--active", type=int, metavar="DAYS",
                   help="only arcs touched this recently")
    p.add_argument("--focus", nargs="?", type=int, const=7, metavar="DAYS",
                   help="what you are actually working on: arcs with real activity "
                        "in the last DAYS (default 7), newest first")
    p.add_argument("--focus-limit", type=int, default=8,
                   help="how many arcs the focus view shows (default 8)")
    p.add_argument("--initiatives", action="store_true",
                   help="resolve each ticket's initiative via Polaris links (extra "
                        "Jira calls, so opt-in)")
    p.add_argument("--no-cluster", action="store_true",
                   help="fall back to branch-name grouping (the old, wrong way)")
    p.add_argument("--resolution", type=float, default=2.0,
                   help="arc-cluster granularity passed through (see arc-cluster for why "
                        "2.0 rather than the 3.0 that predated session segments)")
    p.add_argument("--no-mr", action="store_true", help="skip the GitLab call")
    p.add_argument("--no-slack-threads", action="store_true",
                   help="skip the Slack thread lens: one conversations.replies per channel "
                        "thread you posted in, plus a cached model pass per thread that "
                        "joined a workstream. The ledger's own Slack rows are unaffected")
    p.add_argument("--no-meetings", action="store_true",
                   help="skip reading Gemini meeting transcripts for promises you made "
                        "out loud. Two model calls plus one per unseen transcript, and "
                        "the only source that reaches Google Drive. WORK_ARCS_NO_MEETINGS "
                        "does the same for a caller that imports the module")
    p.add_argument("--shallow-mr", action="store_true",
                   help="skip the per-MR calls for unresolved review threads and pipeline "
                        "status; the list call alone still gives conflicts and approvals")
    p.add_argument("--park", metavar="ARC[=NOTE]",
                   help="set a workstream aside as backlog. Expires itself as soon as a "
                        "commit lands on it, so it can never quietly outlive its reason")
    p.add_argument("--unpark", metavar="ARC", help="put a parked workstream back in play")
    p.add_argument("--detach", metavar="BRANCH",
                   help="pry a branch out of the arc the file overlap put it in; it "
                        "falls back to what its name declares. Expires itself if the "
                        "clustering ever reassigns the branch")
    p.add_argument("--undetach", metavar="BRANCH",
                   help="let a detached branch rejoin whatever the clustering says")
    p.add_argument("--curate", action="store_true",
                   help="answer what this build is least sure about, one keystroke each: "
                        "whether a branch belongs to the arc it was put in, and whether "
                        "a cold pile of local-only work was ever meant to land. y is "
                        "always 'the derivation is right', n always 'it is not', skip "
                        "asks again next time. Silent when there is nothing worth "
                        "asking. Runs the full pipeline, because the intent question is "
                        "only askable once the ledger and the sprint have answered")
    p.add_argument("--dismiss", metavar="REF[=NOTE]",
                   help="acknowledge a ledger row (by its !MR / ticket ref or "
                        "fingerprint prefix). Expires itself the moment the fact "
                        "under it changes, so it can never hide a new development")
    p.add_argument("--undismiss", metavar="REF", help="bring a ledger row back")
    p.add_argument("--authoritative", metavar="ARC=BRANCH",
                   help="name the branch that IS an arc's work when the derivation gets it "
                        "wrong. Optional: it only corrects, nothing depends on it, and it "
                        "expires itself once the derivation changes underneath")
    p.add_argument("--authoritative-ticket", metavar="KEY|ARC=KEY",
                   help="say what an arc's work IS: the ticket it is filed under, and so "
                        "the merge request under that ticket. Branches outside that "
                        "lineage become history — still drawn, no longer counted as risk, "
                        "no longer holding the rung down. Expires itself the moment a "
                        "commit lands on any of them. The key alone is enough where "
                        "one workstream holds it")
    p.add_argument("--derive-ticket", metavar="KEY|ARC",
                   help="drop the hand-filed ticket and derive it again")
    p.add_argument("--no-split", action="store_true",
                   help="skip arc-brief's pass over arcs that hold several bodies of "
                        "work; file overlap alone decides membership")
    p.add_argument("--split-model", default=None, help="model alias for the split pass")
    p.add_argument("--split-jobs", type=int, default=6,
                   help="concurrent model calls in the split pass")
    p.add_argument("--split-timeout", type=int, default=900,
                   help="seconds for the whole split pass")
    p.add_argument("--gap", action="store_true",
                   help="where Jira and reality disagree: work with no ticket, "
                        "tickets with no work, tickets claiming to be handed off")
    p.add_argument("--snapshot", action="store_true",
                   help="leave this run's state behind as the baseline the NEXT run "
                        "diffs against. Off by default so an ad-hoc run cannot consume "
                        "an interval's changes; `arcs` passes it. Reading the previous "
                        "snapshot always happens, flag or no flag")
    p.add_argument("--jira-ify", metavar="ARC",
                   help="file a ticket for an arc, prefilled from what it already is")
    p.add_argument("--dry-run", action="store_true",
                   help="with --jira-ify, show the ticket without creating it")
    p.add_argument("--json", action="store_true", help="emit the graph")
    args = p.parse_args()
    load_env()

    global TICKET_RE
    TICKET_RE = _ticket_re()

    if args.repo is None:
        declared = os.environ.get("JIRA_REPO") or os.environ.get("WORK_ARCS_REPO")
        if not declared:
            sys.exit("work-arcs: set JIRA_REPO in .env (the work repo this tracks)")
        args.repo = Path(declared)

    if not (args.repo / ".git").exists():
        sys.exit(f"work-arcs: not a git repo: {args.repo}")
    git(args.repo, "rev-parse", "--verify", args.main, check=True)

    cluster_assign, membership = {}, {}
    if not args.no_cluster:
        cluster_assign, _, membership = load_clusters(
            args.repo, args.main, args.resolution)

    branches = collect_branches(args.repo, args.main)
    stashes = collect_stashes(args.repo)
    mrs, mr_error = ([], None) if args.no_mr else collect_mrs(args.repo, not args.shallow_mr)
    annotate_stacks(args.repo, mrs, args.main)
    if not args.no_mr:
        for name, pipe in branch_pipelines(args.repo).items():
            if name in branches:
                branches[name]["pipeline"] = pipe
    own_tokens = own_name_tokens(args.repo)
    mrs_known = not args.no_mr and mr_error is None
    # The waiting-on ledger wants the same depth of MR access the thread fetch needed, so
    # it follows the same gate. Nothing downstream depends on it -- a None renders as an
    # absent section, which is the honest degradation when GitLab was not asked. It is
    # network-bound while everything from here to the output is git-bound, so it runs
    # underneath the squash index and the session scan instead of after them: measured,
    # that turns 9s of its own wall clock into none. The write-side commands skip it --
    # --park does not need to know who owes whom.
    # `--curate` is deliberately NOT here any more. It was, on the reasoning that a
    # write-side command does not need to know who owes whom -- true of every other one,
    # and false of this one the moment it started asking about intent. "No promise names
    # this work" is one of the four exclusions that make a residue question askable at
    # all, and a promise lives in the ledger; a --curate run without it would either ask
    # about work Kyle had promised out loud or, honestly, ask nothing. It costs no wall
    # clock either way: the ledger runs in its own thread underneath the git work that
    # was going to happen regardless.
    writing = (args.park or args.unpark or args.authoritative or args.jira_ify
               or args.detach or args.undetach or args.authoritative_ticket
               or args.derive_ticket)
    ledger_f = None
    if mrs_known and not args.shallow_mr and not writing:
        ledger_f = futures.ThreadPoolExecutor(max_workers=1).submit(
            build_ledger, args.repo, mrs, not args.no_meetings)
    # Kept rather than consumed into the branches: close_commitments asks whether an MR
    # a promise named has merged since, and this sweep is the only place that knows the
    # fate of a merge request that is no longer open. Refetching it for the ledger would
    # be a second 500-MR pass for facts already on the desk.
    fates = branch_mr_states(args.repo) if mrs_known else {}
    for name, fate in fates.items():
        if name in branches:
            branches[name]["mr_fate"] = fate
    # Squash first, because it is both the stronger test and the cheaper one, and because
    # every merge request in this project squashes -- which is what made finished work keep
    # surfacing as live. See landed_as_squash for the controls it was validated against.
    unaccounted = [n for n, b in branches.items() if not b.get("mr_fate")]
    squashed, depth = landed_as_squash(args.repo, unaccounted, args.main)
    for name in squashed:
        branches[name]["mr_fate"] = {
            "state": "merged", "iid": None, "at": "", "url": "",
            "via": f"its whole delta is a squashed commit on {args.main}"}
    if squashed:
        print(f"  {len(squashed)} branch(es) already landed as a squash on {args.main} "
              f"(searched its last {depth} commits)", file=sys.stderr)
    # Then per-commit equivalence, for work that went in commit by commit rather than
    # squashed. Still bounded: unlike the squash index, `git cherry` recomputes main's
    # patch-ids on every call, and unbounded it cost 60s on its own.
    CHERRY_MAX = int(os.environ.get("WORK_ARCS_CHERRY_MAX", "25"))
    rest = [n for n, b in branches.items()
            if not b.get("mr_fate") and b["commits_ahead"] <= CHERRY_MAX]
    skipped = sum(1 for n, b in branches.items()
                  if not b.get("mr_fate") and b["commits_ahead"] > CHERRY_MAX)
    if skipped:
        print(f"  {skipped} branch(es) over {CHERRY_MAX} commits not checked commit-by-"
              f"commit (WORK_ARCS_CHERRY_MAX); the squash test above covered them all",
              file=sys.stderr)
    for name, n in already_upstream(args.repo, rest, args.main).items():
        branches[name]["mr_fate"] = {"state": "merged", "iid": None, "at": "",
                                     "url": "", "via": f"all {n} commits already in main"}
    # Everything below a merged tip merged with it. `metadata-latlng-geometry-full` holds
    # six commits that are the same shas as six of `UL-1801`'s eight -- it is an ancestor,
    # not a copy, so supersession correctly left it alone, and `git cherry` could not see it
    # either because !10422 squash-merged: main gained one commit whose patch equals the
    # branch's combined diff, so no individual commit matches. Ancestry answers it outright
    # and the edges are already derived. Repo-wide rather than per-arc, since a stack can
    # straddle two arcs.
    for name, b in list(branches.items()):
        if (b.get("mr_fate") or {}).get("state") != "merged":
            continue
        for anc in b.get("parents") or []:
            if anc in branches and not branches[anc].get("mr_fate"):
                branches[anc]["mr_fate"] = {
                    "state": "merged", "iid": (b["mr_fate"] or {}).get("iid"),
                    "at": (b["mr_fate"] or {}).get("at", ""),
                    "url": (b["mr_fate"] or {}).get("url", ""),
                    "via": f"an ancestor of {name}, which merged"}
    sessions = session_index(args.projects)
    arcs, unattached = build_arcs(branches, stashes, mrs, sessions, args.main,
                                  cluster_assign, args.repo, mrs_known, own_tokens)

    # File overlap cannot separate two tickets that edit the same module -- measured,
    # UB-6938 migrating the metric catalogs and UL-1634 hardening a lint rule over those
    # same catalogs are structurally identical. The last discriminator is what the
    # changes say they are for, so arc-brief reads the commit subjects and returns a
    # refined assignment. Applied by re-clustering rather than by carving up finished
    # arcs, so every count stays computed in one place. Human detachments come last,
    # after the split, because they correct the assignment the page actually showed --
    # which is the post-split one.
    refined, unsure = ({}, []) if args.no_split else split_assignment(arcs, args)
    if refined:
        cluster_assign = {**cluster_assign, **refined}
    detached, stale_detached = apply_detached(cluster_assign)
    for s in stale_detached:
        print(f"⚠ {s['branch']} is no longer detached: {s['why']}", file=sys.stderr)
    # After the split and after the detachments, because a pin is a judgement about the
    # grouping the page showed -- which is the one those two have finished with.
    pinned, stale_confirmed = apply_confirmed(cluster_assign)
    for s in stale_confirmed:
        print(f"⚠ {s['branch']} is no longer confirmed in its arc: {s['why']}",
              file=sys.stderr)
    # Before the stores can expire anything else out from under them: an answer given
    # on the page and saved yesterday is a judgement whether or not the clustering has
    # since moved past it, and the eval set is the one place that must keep it.
    caught_up = log_from_stores()
    if caught_up:
        print(f"  {caught_up} answer(s) given elsewhere added to the eval set",
              file=sys.stderr)
    if refined or detached:
        arcs, unattached = build_arcs(branches, stashes, mrs, sessions, args.main,
                                      cluster_assign, args.repo, mrs_known, own_tokens)

    # Built here, once, from the arcs the page and the CLI both show. Pins and
    # detachments have already had their say, so a question can only ever be about a
    # membership that survived them -- which is what makes "skip is free" true: a
    # skipped question is simply one nobody pinned, and it comes back next build.
    #
    # The residue half of the queue cannot be built here, and the split is not tidiness:
    # every one of its exclusions -- the sprint, the ledger, `parked`, the rung -- is
    # settled hundreds of lines below this, so it is assembled where those are known and
    # merged in there. Membership questions have no such dependency and are built where
    # their inputs are freshest.
    curation = curation_queue(arcs, {k: v for k, v in membership.items()
                                     if k not in pinned},
                              cluster_assign, unsure)

    if args.detach or args.undetach:
        set_detached(cluster_assign, branches, args.detach or args.undetach,
                     undo=bool(args.undetach))
        return

    if args.park or args.unpark:
        set_parked(arcs, args.park or args.unpark, unpark=bool(args.unpark))
        return

    if args.authoritative:
        set_override(arcs, args.authoritative)
        return

    if args.authoritative_ticket or args.derive_ticket:
        set_ticket_authority(arcs, args.authoritative_ticket or args.derive_ticket,
                             undo=bool(args.derive_ticket))
        return

    if args.jira_ify:
        match = [a for a in arcs if a["label"] == args.jira_ify or a["id"] == args.jira_ify]
        if not match:
            sys.exit(f"work-arcs: no arc named {args.jira_ify!r} "
                     f"(try `work-arcs --gap` for the candidates)")
        arc = match[0]
        if arc["kind"] == "ticket":
            sys.exit(f"work-arcs: {arc['label']} already is a ticket")
        sys.exit(jira_ify(args.repo, arc, args.dry_run))

    ledger = ledger_f.result() if ledger_f else None
    # Immediately, and before anything can act on the ledger: a commitment shown to have
    # been kept must not be dismissable, diffable or renderable, because it is not a row.
    close_commitments(ledger, fates)

    if args.dismiss or args.undismiss:
        if ledger is None:
            sys.exit("work-arcs: the ledger was not built, so there is nothing to "
                     "dismiss (GitLab unreachable, or --no-mr / --shallow-mr)")
        set_dismissed(ledger, args.dismiss or args.undismiss,
                      undo=bool(args.undismiss))
        return

    gap = None
    sprint = None
    # `--curate` joins these two for the same reason it joined the ledger: a residue
    # question may not be asked about work a sprint claims, and only Jira can say.
    if args.gap or args.json or args.curate:
        issues, jira_error = collect_jira()
        gap = reconcile(arcs, issues) if not jira_error else None
        # Fetched here, beside the other Jira call, and joined much further down. The
        # split is not tidiness: the join's whole judgement is whether an arc's silence
        # is neglect, and `stage` and `parked` -- the two things that answer that -- are
        # not settled until finalize, apply_parked and mark_forgotten have all run.
        # --json only: `--gap` prints and returns before apply_parked, so the join could
        # not be made honestly there, and a network call whose result is thrown away is
        # a network call not worth making.
        if gap is not None and (args.json or args.curate):
            sprint = collect_sprint()
        if gap is not None:
            # Which branch is authoritative can depend on which ticket the arc owns, and
            # reconcile is where tickets arrive. Recomputing beats guessing earlier from
            # branch names alone.
            for arc in arcs:
                finalize(arc, args.repo, args.main)
        if gap and args.initiatives:
            i2i, inits = collect_initiatives(issues)
            gap["initiatives"] = inits
            for m in gap["status_mismatch"]:
                m["initiatives"] = [inits.get(k, k) for k in i2i.get(m["issue"]["key"], [])]
            for i in gap["tickets_without_work"]:
                i["initiatives"] = [inits.get(k, k) for k in i2i.get(i["key"], [])]

    if args.gap:
        if jira_error:
            sys.exit(f"work-arcs: {jira_error}")
        print("── real work with no ticket ─────────────────────────────")
        for a in gap["unticketed_work"][:10]:
            print(f"  {a['label']:<28} {a['counts']['branches']}b, "
                  f"{a['counts']['sessions']}sess, {a['engagement']}ref, "
                  f"{a['unpushed']} unpushed, {a['age_days']}d")
            # Quoted, as the page's copy of this command already is. Since arc-brief
            # started deriving labels they are phrases, so unquoted this printed
            # `--jira-ify SMP Neighborhoods ODX journeys` and the shell handed --jira-ify
            # one word of four.
            print(f"    └ work-arcs --jira-ify '{a['label']}'")
        print("\n── Jira says handed off, but the work is still here ─────")
        for m in gap["status_mismatch"][:10]:
            print(f"  {m['issue']['key']:<10} {m['why']}")
            print(f"    └ {m['issue']['summary'][:64]}")
        print("\n── assigned tickets with no branch or session ───────────")
        for i in gap["tickets_without_work"][:12]:
            print(f"  {i['key']:<10} {i['status']:<18} {i['summary'][:44]}")
            if "initiatives" in i:
                print(f"    └ {', '.join(i['initiatives']) or 'no initiative'}"[:76])
        print(f"\n✓ {len(gap['unticketed_work'])} unticketed, "
              f"{len(gap['status_mismatch'])} mismatched, "
              f"{len(gap['tickets_without_work'])} tickets with no work",
              file=sys.stderr)
        return

    # Before apply_parked, and that order is load-bearing: both this and `filing` below
    # re-run finalize, which recomputes `stage` from scratch -- and `parked` IS a stage,
    # asserted by apply_parked and derived by nothing. Run either of these after it and the
    # park is silently recomputed away while `arc["parked"]` still says it is parked.
    # Conceptually the same order: a filing says what the work IS, and parking is intent
    # layered on top of that.
    filing_store = load_store(TICKET_AUTHORITY, "the ticket-authority store")
    stale_tickets = apply_ticket_authority(arcs, filing_store, args.repo, args.main)
    for s in stale_tickets:
        print(f"⚠ ignoring authoritative-ticket={s['key']} for {s['label']}: {s['why']}",
              file=sys.stderr)
    # What survived, which is what the page seeds its own store from. The stale ones are
    # left out deliberately: the page would otherwise carry a filing this run refused, and
    # the next thing it saved would write it straight back.
    filings_live = {k: v for k, v in filing_store.items()
                    if k not in {s["label"] for s in stale_tickets}}

    # Beside the filing and above the park, for the two reasons the comment on the filing
    # gives. It re-runs finalize, so it must come before anything that asserts a stage
    # finalize does not derive -- `parked` is exactly that. And conceptually it is the same
    # order: a filing says what the work IS, residue says whether it is work at all, and
    # parking is intent layered on top of whatever the answer to both was.
    stale_residue = apply_residue(arcs, args.repo, args.main)
    for s in stale_residue:
        print(f"⚠ {s['label']} is no longer residue: {s['why']}", file=sys.stderr)
    intended, stale_intended = apply_intended(arcs)
    for s in stale_intended:
        print(f"⚠ {s['label']} is no longer pinned as intended: {s['why']}",
              file=sys.stderr)

    # What the page's own filing control would do, per workstream and per key. Computed
    # here because the page must record intent and never derive consequences -- see filing.
    for arc in arcs:
        f = filing(arc, args.repo, args.main)
        if f:
            arc["filing"] = f

    stale_parks = apply_parked(arcs)
    for s in stale_parks:
        print(f"⚠ {s['label']} is no longer parked: {s['why']}", file=sys.stderr)

    stale_overrides = apply_overrides(arcs, load_overrides())
    for s in stale_overrides:
        print(f"⚠ ignoring authoritative={s['branch']} for {s['label']}: {s['why']}",
              file=sys.stderr)

    # Both of its exclusions -- parked, and whose clock is running -- are only settled by
    # now: apply_parked has just run, and `stage` came from the finalize pass after
    # reconcile. Before apply_dismissals, which needs the verdicts to know what is
    # acknowledgeable.
    for arc in arcs:
        mark_forgotten(arc)

    # The Slack lens, after every other derivation, because the join reads a settled arc: a
    # thread attaches through the arc's branch names, ticket keys and MR iids, and the second
    # finalize pass, the split and the hand-set authoritative branch have all had their say
    # by here. It is also the only pass that puts a model's words on a card, so it goes last
    # for the plainer reason too -- everything above it is derived, and if it fails the page
    # loses one section and nothing else.
    # complete=False when the flag skipped it, and that is the opposite of what "no Slack
    # token" reports. A token that does not exist means there are no blocks and never were,
    # so nothing is missing; a flag means the blocks exist and this run chose not to look,
    # and pruning their acknowledgements would punish a cheap run for being cheap. Same
    # distinction --no-mr already makes for the ledger.
    # `--curate` skips it, and that is not a cheap run being cheap: the thread lens is the
    # one pass that calls a model per thread, it puts words on cards nothing here renders,
    # and no question in the queue is decided by it. The ledger's own Slack rows -- which
    # are what a residue question needs -- are a different collector and unaffected, the
    # same distinction --no-slack-threads has always made.
    skip_lens = args.no_slack_threads or args.curate
    slack_lens = {"consulted": False, "complete": False,
                  "why": "--curate" if args.curate else "--no-slack-threads"}
    if not skip_lens:
        slack_lens = slack_threads(arcs, ledger)

    # Last of the finalize-order corrections, because everything before this point --
    # the second finalize pass, a hand-set authoritative branch -- recomputes demands
    # from scratch, and a mark applied any earlier would be recomputed away. Pruning
    # only on the full pipeline run, where every dismissable universe exists.
    #
    # `ledger["complete"]` and not just `ledger`: a truthy dict says the ledger was BUILT,
    # and every source it draws on can half-answer without saying so. Four doors were open
    # to this gate -- glab refusing `user`, glab refusing one MR's notes, Jira timing out,
    # Slack losing a page of a sweep -- and through any of them the run deleted Kyle's
    # acknowledgements while announcing that their facts had moved. See apply_dismissals.
    #
    # Note it is completeness and not presence: with no Slack token and no Jira credentials
    # there are no rows from either and there never were, so nothing can be missing and a
    # stale GitLab acknowledgement must still be able to expire. Gating on "was it
    # consulted" would freeze the store forever on a machine configured for less.
    #
    # Nothing else is conditional on this: the rows that DID arrive still get their
    # `dismissed` mark, so an outage costs a prune, never a shout.
    # `slack_lens["complete"]` joins the gate for the same reason `ledger["complete"]` did:
    # the thread blocks are a fifth dismissable universe, and a run where three
    # conversations.replies calls timed out has blocks quietly missing. Note it is again
    # completeness and not presence -- no token, or --no-slack-threads, means there are no
    # blocks and there never were, so nothing can be missing and a stale acknowledgement on
    # some OTHER universe must still be able to expire.
    apply_dismissals(ledger, arcs, gap,
                     prune=bool(ledger and ledger.get("complete")
                                and slack_lens.get("complete")
                                and gap is not None and args.json))

    # Before --active and --focus, and that is the whole point of the feature. The arcs
    # this diff exists to speak about are the ones the window hides: "of your 58
    # background arcs, 3 changed overnight" is a sentence about arcs that are not on the
    # page, and computing the diff over a filtered list would have made it structurally
    # impossible to say. The snapshot is taken over every arc for the same reason -- a
    # baseline of only the recent ones would report the rest as appearing and vanishing
    # every time the window moved.
    generated = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    # `slack` is the one universe gated on having been consulted AND complete, where the
    # other three are gated on presence. The two failures it has to tell apart both produce
    # blocks that are simply absent: a run with no token or --no-slack-threads never looked,
    # and a run where three conversations.replies calls timed out looked and came back
    # short. Either way the NEXT run reads them all and every block reads as new -- a
    # morning of "a thread on this arc decided X" about conversations that had been sitting
    # there for a week. Note this is the opposite trade from apply_dismissals, which gates on
    # completeness alone precisely so a machine configured for less does not freeze the
    # store forever: there, refusing to act costs an expiry that never happens; here it
    # costs one silent morning that heals itself on the next run.
    snap = snapshot_of(arcs, ledger, {"mrs": mrs_known, "ledger": ledger is not None,
                                      "issues": gap is not None,
                                      "slack": bool(slack_lens.get("consulted")
                                                    and slack_lens.get("complete"))},
                       args.repo.name, generated)
    prev, no_prev = load_snapshot(args.repo.name)
    if prev is None:
        since = {"v": SNAPSHOT_V, "previous_generated": None, "interval_seconds": None,
                 "compared": 0, "changed": 0, "why": no_prev,
                 "not_compared": {"arcs": 0, "how": {}, "detail": {}},
                 "skipped_universes": [], "changes": []}
    else:
        since = diff_runs(prev, snap, arcs, ledger)
    if args.snapshot:
        write_snapshot(snap)
    # Said out loud on every run, because a diff that quietly stops finding anything looks
    # exactly like a quiet night.
    if prev is None:
        print(f"  nothing to compare against — {no_prev}", file=sys.stderr)
    else:
        print(f"  {since['changed']} of {since['compared']} workstreams moved since the "
              f"last build ({since['not_compared']['arcs']} regrouped or new, so not "
              "compared)", file=sys.stderr)

    # Taken before the window filters, for the same reason the run-over-run diff is: an arc
    # that fell off a cliff five weeks ago is by construction outside a two-week window, so
    # computing this over the filtered list would make the section structurally unable to
    # hold the arcs it exists for.
    fell = fell_off_a_cliff(arcs, include_dismissed=False)
    forgotten_ids = [a["id"] for a in fell_off_a_cliff(arcs)]
    # Before the window filters too, and for a sharper version of the same reason: work
    # that exists only here is at its most dangerous precisely when it has been quiet long
    # enough to fall out of a recency window. Ranked over everything; a renderer scoped to
    # a window intersects with its own set.
    only_here_ids = only_here(arcs)

    # Here for the same reason as the two lines above it: before the window filters. A
    # sprint arc nobody has touched for a working week is by construction the one most
    # likely to have fallen out of a recency window, so joining after the filter would
    # make the strip structurally unable to hold the arcs it exists for.
    if sprint is not None:
        join_sprint(sprint, arcs)

    # The second question type, assembled here because here is the first line at which
    # every one of its exclusions is knowable: the rung and `parked` are settled, the
    # sprint has been joined, and the ledger has been built and had its kept promises
    # closed out. Before the window filters, like the two rankings above it and for the
    # same reason -- work that has gone cold enough to be worth asking about is by
    # construction the work a recency window hides.
    # Only where the queue is going to be looked at. A plain summary run renders no
    # questions, and a run that builds a queue nobody sees would spend a Slack join on it
    # and then announce an abstention about a section it was never going to print.
    residues = []
    if args.curate or args.json:
        residues, why_not = residue_queue(arcs, ledger, gap is not None, intended)
        if why_not:
            print(f"  {why_not}", file=sys.stderr)
    curation = combined_queue(curation, residues)

    if args.curate:
        return curate(curation, cluster_assign)

    if args.active is not None:
        arcs = [a for a in arcs if a["age_days"] <= args.active]

    if args.focus is not None:
        # Recency decides eligibility, engagement decides order. Sorting focus by
        # recency alone returned 28 arcs for a two-day window, which is a list of
        # everything git noticed rather than a picture of what you are doing.
        arcs = [a for a in arcs if a["age_days"] <= args.focus]
        arcs.sort(key=lambda a: (-a["engagement"], a["age_days"], -a["at_risk"]))
        arcs = arcs[:args.focus_limit]

    if args.json:
        # Working material, not output. Every commit's date and sha is read once, by
        # activity_of, and has been by now; left in it would put ~8,000 two-field objects
        # into a document whose whole point is to be read by the next tool along. The
        # shape it produced -- a handful of [day, count] pairs per arc -- is what survives.
        for arc in arcs:
            for b in arc.get("branches", []):
                b.pop("commits", None)
        json.dump({
            "generated": generated,
            "repo": args.repo.name,
            # The path, separately from the name. `repo` is the label a page prints, and
            # arc-brief was resolving it as a working directory: `git -C ul log` fails from
            # anywhere but the parent of the repo, silently, so 0 of 54 briefs had ever
            # seen a commit subject -- the richest evidence they are given after the
            # prompts. The split pass was unaffected because work-arcs hands it a real path.
            "repo_path": str(args.repo),
            "main": args.main,
            # Your GitLab username, already resolved for "who spoke last" on every review
            # thread. Emitted because a consumer that needs to tell your reply from a
            # reviewer's cannot derive it: `last_by` is a name, and the only thing that
            # makes one of those names yours is this call. A downstream stage guessing --
            # from the commit author, from the most frequent speaker -- would be a second
            # author for an identity that already has one, and would be wrong on exactly
            # the MRs where somebody else pushed to your branch. Empty string when GitLab
            # was skipped, so a reader can tell "not me" from "we never asked".
            "me": gitlab_me(args.repo) if not args.no_mr else "",
            "project_url": project_url(args.repo, mrs),
            "mr_error": mr_error,
            "arc_count": len(arcs),
            # Top-level rather than a field on each arc, because it is a fact about the
            # interval and not about any one workstream -- and because the arcs list is
            # about to be filtered by --active while this deliberately is not.
            "since_last_run": since,
            # The forgotten arcs in their canonical order, as ids, so the ranking has one
            # author. The verdict itself lives on the arc where it belongs -- this is the
            # order, not the data. Every consumer that instead re-derived it from the arcs
            # list would be re-implementing fell_off_a_cliff's tiebreaks, and a ranking
            # written three times is a ranking that will differ in two of them. Ids only,
            # and dismissed rows included: acknowledgement is a display question, and a
            # complete ranking is the only one a consumer can choose from -- one filtered
            # here could never be un-filtered. arcs-page shows them behind a disclosure;
            # arc-morning drops them, because a ✕ that still opens the morning brief is a
            # ✕ that does nothing.
            "forgotten": forgotten_ids,
            # The other ranking, and the answer to the one question the at-risk count on
            # the page could not answer: which work exists nowhere but this laptop, most at
            # stake first. Ids in order, like `forgotten` and for the same reasons -- the
            # arcs carry `unpushed_days`, `unpushed_dates` and `authoritative` already, and
            # a ranking re-derived by each consumer is a ranking that will differ in one of
            # them. Ranked on days of work times staleness; see `only_here` for why neither
            # half alone would do. Complete rather than capped: the cap belongs where the
            # rendering is, and a list truncated here could never be un-truncated.
            "only_here": only_here_ids,
            "arcs": arcs,
            "ledger": ledger,
            # What the Slack thread lens saw and what it could not, top-level because it is
            # a fact about the run rather than about any one workstream -- and because the
            # page's boundary note is read off it. `denied` is the two scopes this token
            # will never hold (DMs and group DMs), which is why the count is large and
            # stable rather than alarming; `unreadable` is an outage, and the only one of
            # the two that makes `complete` false.
            "slack_threads": slack_lens,
            # Top-level and beside `gap`, not inside it: the gap report is about
            # disagreement between the derived and declared pictures, and a sprint is
            # not a disagreement -- it is a second declared picture, with its own
            # membership. Absent (null) whenever Jira, the Sprint field or an open
            # sprint is missing, so the strip that reads it can be absent rather than
            # wrong. Deliberately outside the snapshot: a ticket moving between sprints
            # is not a workstream moving, and reporting it as one would put a line in
            # the run-over-run diff every time somebody groomed the board.
            "sprint": sprint,
            "unattached_stashes": unattached,
            "stale_overrides": stale_overrides,
            "stale_tickets": stale_tickets,
            # The filings in force, whole. The page keeps its own copy and cannot rebuild
            # this from the rows it renders: a workstream outside the focus window has no
            # row, and a store built from rows alone would drop its filing the first time
            # the page saved one.
            "filings": filings_live,
            "stale_parks": stale_parks,
            "stale_detached": stale_detached,
            "stale_confirmed": stale_confirmed,
            # Both halves of the intent contract expiring, said out loud on the page for
            # the reason every other stale list here is: a judgement that suppressed
            # numbers and has stopped applying must announce that the numbers are back,
            # or the page silently changes its mind and nothing accounts for it.
            "stale_residue": stale_residue,
            "stale_intended": stale_intended,
            # The questions this build would like answered, least confident first, or
            # absent when it has none. Top-level rather than on the arcs, because the
            # queue is ranked across every arc at once -- the five worth asking are the
            # five worst anywhere, and a per-arc list could not express that. Absent and
            # not empty when there is nothing to ask, so a renderer can test for the key
            # rather than for a length and a silent build stays silent.
            **({"curation": curation} if curation else {}),
            "gap": gap,
        }, sys.stdout, indent=1)
        print()
        return

    if mr_error:
        print(f"⚠ {mr_error}", file=sys.stderr)
    if ledger and (ledger["they_owe"] or ledger["you_owe"]):
        dismissed = sum(1 for e in ledger["they_owe"] + ledger["you_owe"]
                        if e.get("dismissed"))
        ledger = {**ledger,
                  "they_owe": [e for e in ledger["they_owe"]
                               if not e.get("dismissed")],
                  "you_owe": [e for e in ledger["you_owe"]
                              if not e.get("dismissed")]}
        print("── the ledger ───────────────────────────────────────────")
        for e in ledger["they_owe"]:
            who = ", ".join(e["who"]) if isinstance(e["who"], list) else e["who"]
            what = {"review-silence": f"no response from {who}",
                    "ticket-stalled": f"with {who} ({e.get('status','')})",
                    "slack-asked": f"you asked {who}, no reply",
                    }.get(e["kind"], who)
            print(f"  they owe you  {e['ref']:<9} {e.get('days','?'):>4}d  {what}")
            if e.get("quote"):
                print(f"                          “{e['quote'][:56]}”")
            if e.get("title"):
                print(f"                          └ {e['title'][:58]}")
        for e in ledger["you_owe"]:
            what = {"review-owed": f"{e['who']} asked for your review",
                    "reply-owed": f"{e['who']} answered your comment — your turn",
                    "thread-reply": f"{e['who']} awaits your reply on your own MR",
                    "slack-mention": f"{e['who']} mentioned you, nothing from you since",
                    "slack-dm": f"{e['who']} has the last word in your DM",
                    "commitment": "you said you'd " + (e.get("promised") or "do this")
                                  + (f" ({e['who']})" if e.get("who") else ""),
                    "meeting-commitment":
                        "you said you'd " + (e.get("promised") or "do this")
                        + (f" ({e['who']})" if e.get("who") else "")
                        + (f" — “{e['deadline']}”" if e.get("deadline") else "")
                        + " (said out loud, quoted)",
                    }.get(e["kind"], e["who"])
            print(f"  you owe them  {e['ref']:<9} {e.get('days','?'):>4}d  {what}")
            if e.get("quote"):
                print(f"                          “{e['quote'][:56]}”")
            if e.get("title"):
                print(f"                          └ {e['title'][:58]}")
            # A commitment nothing can be shown about says how it will die, because the
            # alternative is a row that disappears one morning for no visible reason.
            if e["kind"] in COMMITMENT_KINDS and e.get("expires_in") is not None:
                where = "Slack" if e["kind"] == "commitment" else "transcript"
                print(f"                          nothing shows it landed; expires with "
                      f"the {e.get('window_days', 14)}-day {where} window in "
                      f"{e['expires_in']}d")
        if ledger["you_owe_covered"]:
            print(f"  (+{ledger['you_owe_covered']} review requests already handled — "
                  "you spoke or someone approved)")
        for e in ledger.get("you_owe_closed") or []:
            print(f"  ✓ closed on evidence: you said you'd "
                  f"{e.get('promised') or 'do this'} — {e['closed_by']}")
        if dismissed:
            print(f"  (+{dismissed} acknowledged — `work-arcs --undismiss REF` brings "
                  "one back; any change brings it back on its own)")
        print()
    for a in arcs:
        c = a["counts"]
        bits = [f"{c['branches']}b"]
        if c["stashes"]:
            bits.append(f"{c['stashes']}stash")
        if c["mrs"]:
            bits.append(f"{c['mrs']}mr")
        if c["sessions"]:
            bits.append(f"{c['sessions']}sess")
        if a["stacked"]:
            bits.append(f"{a['stacked']}stacked")
        if a["engagement"]:
            bits.append(f"{a['engagement']}ref")
        if a["superseded"]:
            bits.append(f"{a['superseded']}dup")
        risk = f"  {a['unpushed_live']} unpushed" if a["unpushed_live"] else ""
        print(f"{a['age_days']:>4}d  {a['state']:<18} {a['label']:<28} "
              f"{','.join(bits):<28}{risk}")
        for d in a["demands"][:2]:
            print(f"        └ {d['what']}")
        for s in a.get("slack") or []:
            if s.get("dismissed"):
                continue
            for what in [f"decided: {x['what']}" for x in s["decided"]] \
                    + [f"still open: {x['what']}" for x in s["open"]]:
                print(f"        ⌁ #{s['channel'] or '?'} {what}")
    if fell:
        print("\n── fell off a cliff ─────────────────────────────────────")
        for a in fell:
            print(f"  {a['label']:<28} {a['activity']['forgotten']['why']}")
    print(f"\n✓ {len(arcs)} arcs from {len(branches)} branches, "
          f"{len(mrs)} MRs; {len(unattached)} stashes attached to no arc",
          file=sys.stderr)


if __name__ == "__main__":
    main()
