#!/usr/bin/env -S python3 -u
"""
work-arcs: group a repo's loose work into the arcs it actually belongs to.

A flat report of branches, stashes and MRs is unreadable at real scale, because the
unit is wrong. Measured in ~/work/repos/ul: 389 unmerged branches, but UB-6919 alone
owns 20 of them and UB-6918 owns another 20. Shown as 40 unrelated rows that is
noise; shown as two arcs it is two pieces of work.

So this derives the graph instead of listing the artifacts:

  root  -- a ticket key, or a shared name prefix for work that never got a ticket
  |- branch          (commits ahead, whether any remote has them, how stale)
  |  '- branch       stacked on the one above it -- real parent edges, and a branch
  |                  can sit on several, so this is a DAG rather than a tree
  |- stash           with the files in it, because `stash@{38}` alone says nothing
  |- merge request   with whether anyone has commented
  '- session         Claude sessions that touched any branch in the arc

Every edge here is derived, nothing is declared. The one thing that cannot be
derived is a name for work that never got a ticket: `adaptive`, `adaptive-bak`,
`adaptive-bak-bak-bak` is obviously one arc, but only reading it tells you what it
was for. Those come out as kind="prefix" with a provisional label for a session to
rename.

  work-arcs --json                 the graph
  work-arcs                        a summary, most recently touched first
  work-arcs --active 14            only arcs touched in the last 14 days

Read-only. Runs git and glab, writes nothing.
"""

import argparse
import base64
import concurrent.futures as futures
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from collections import defaultdict
from datetime import datetime
from pathlib import Path

# Built from JIRA_PROJECTS rather than a generic [A-Z]{2,4}, which matched things
# like "UTF-8" and "IPV-4" as ticket keys. Falls back to the generic form only if
# .env declares nothing.
def _ticket_re():
    keys = [k.strip().upper() for k in
            os.environ.get("JIRA_PROJECTS", os.environ.get("JIRA_PROJECT", "")).split(",")
            if k.strip()]
    if keys:
        return re.compile(r"\b(" + "|".join(map(re.escape, keys)) + r")-(\d{2,5})\b")
    return re.compile(r"\b([A-Z]{2,4})-(\d{2,5})\b")


TICKET_RE = re.compile(r"\b([A-Z]{2,4})-(\d{2,5})\b")  # replaced after load_env()
# Branch names like `6919-review` and `6802-kyle` carry the number but not the
# project, so they look unkeyed. They are resolved against the keys that do appear.
BARE_NUM_RE = re.compile(r"(?:^|[^0-9A-Za-z])(\d{4,5})(?:[^0-9]|$)")

SRC_SUFFIXES = (
    ".rs", ".ts", ".tsx", ".js", ".jsx", ".py", ".sql", ".go",
    ".java", ".kt", ".swift", ".c", ".cc", ".cpp", ".h", ".hpp",
)

# Names that announce a branch is a copy of another rather than work of its own. Only
# ever a tie-break: a branch is called superseded because its commits are already
# somewhere else, never because of what it is called. `UB-6938-preX` is a variant and
# `hotfix/query-telemetry-to-thor` is not, and no regex can be trusted with that call.
VARIANT_RE = re.compile(
    r"(?:^|[-/_.])(bak|backup|old|orig|copy|before[-_]?squash|pre[-_]?squash"
    r"|pre\d+|wip|tmp|temp|squash|stash)(?:[-/_.]|\d*$)", re.I)


ENV_FILE = Path(__file__).resolve().parent.parent / ".env"


def load_env():
    """Same .env contract as the rest of the repo's tools; existing vars win."""
    if not ENV_FILE.exists():
        return
    for line in ENV_FILE.read_text().splitlines():
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            key, _, value = line.partition("=")
            value = value.strip().strip('"').strip("'")
            os.environ.setdefault(key.strip(), os.path.expandvars(value))


def git(repo, *args, check=False):
    """Run git, returning stdout. Failures are normal here (missing refs, etc)."""
    r = subprocess.run(
        ["git", "-C", str(repo), *args],
        capture_output=True, text=True,
    )
    if check and r.returncode != 0:
        sys.exit(f"work-arcs: git {' '.join(args)} failed: {r.stderr.strip()}")
    return r.stdout


def lines(s):
    return [x for x in s.splitlines() if x.strip()]


def session_index(projects_dir):
    """branch -> {"paths": set, "last": epoch}, from one rg pass over every project.

    Sessions run from $HOME record gitBranch=HEAD and land in a project dir named
    after $HOME rather than the repo, so scanning every dir is the only way to see
    them. Transcripts reach 18M; this never parses one, it only scans for two fields.

    Recency comes from the timestamp on the *entry* the branch appears in, not the
    file's mtime. A session that touched a branch once in its first hour and then ran
    all day would otherwise make that branch look like today's work. `timestamp`
    always precedes `gitBranch` on a line, so one pattern captures the pair; the 20k
    gap covers 99% of entries, and since only the maximum per branch matters, the
    remainder cannot change the answer.
    """
    idx = defaultdict(lambda: {"paths": set(), "last": 0, "entries": 0})
    if not projects_dir.is_dir() or not shutil.which("rg"):
        return idx
    r = subprocess.run(
        ["rg", "-oN", "--with-filename",
         r'"timestamp":"([^"]*)".{0,20000}?"gitBranch":"([^"]*)"',
         "-r", "$1\t$2", str(projects_dir)],
        capture_output=True, text=True,
    )
    for line in r.stdout.splitlines():
        path, _, rest = line.partition(":")
        stamp, _, branch = rest.partition("\t")
        if not branch or branch == "HEAD":
            continue
        entry = idx[branch]
        entry["paths"].add(path)
        # How many entries mention the branch, not just whether one did. A branch
        # named three times in a sweep is incidental; one named four hundred times
        # is what the session was actually about.
        entry["entries"] += 1
        try:
            epoch = int(datetime.fromisoformat(stamp.replace("Z", "+00:00")).timestamp())
        except ValueError:
            continue
        if epoch > entry["last"]:
            entry["last"] = epoch
    return idx


def collect_branches(repo, main_ref):
    """Every unmerged local branch with the facts that decide its state."""
    fmt = "%(refname:short)\t%(objectname)\t%(committerdate:unix)"
    out = git(repo, "for-each-ref", "--no-merged", main_ref, f"--format={fmt}", "refs/heads")
    branches = {}
    for line in lines(out):
        parts = line.split("\t")
        if len(parts) != 3:
            continue
        name, sha, ts = parts
        branches[name] = {
            "name": name,
            "sha": sha[:9],
            "committed": int(ts),
            "age_days": int((time.time() - int(ts)) // 86400),
        }

    worktrees = set()
    for line in lines(git(repo, "worktree", "list", "--porcelain")):
        if line.startswith("branch refs/heads/"):
            worktrees.add(line[len("branch refs/heads/"):])

    for name, b in branches.items():
        ahead = git(repo, "rev-list", "--count", f"{main_ref}..{name}").strip()
        b["commits_ahead"] = int(ahead) if ahead.isdigit() else 0
        unpushed = git(repo, "rev-list", "--count", name, "--not", "--remotes").strip()
        b["unpushed"] = int(unpushed) if unpushed.isdigit() else 0
        b["pushed"] = b["unpushed"] == 0
        b["worktree"] = name in worktrees
        # Parents = branches contained in this one that still have unmerged work.
        # Both filters matter: --merged alone returns every long-merged branch whose
        # tip sits in main's history, which invents a parent edge for everything.
        parents = lines(git(
            repo, "for-each-ref", "--merged", name, "--no-merged", main_ref,
            "--format=%(refname:short)", "refs/heads",
        ))
        b["parents"] = [p for p in parents if p != name]
        # What the branch's commits say they did. Carried here rather than fetched per
        # arc because it is what tells a superseded copy from live work, and every
        # consumer downstream -- the duplicate pass, the split prompt, the brief --
        # wants the same list. 394 branches cost ~1.1s, once.
        b["subjects"] = lines(git(repo, "log", "--format=%s", "-20",
                                  f"{main_ref}..{name}"))
    return branches


def distinct_unpushed(repo, names):
    """How many commits an arc actually has on no remote, counted once each.

    Summing per branch double-counts every stack: `dove-boot-churn-backup` is an ancestor
    of `dove-boot-churn`, so its 32 unpushed commits ARE 32 of that branch's, and adding
    them made one arc claim 130 where the truth is 98. Union first, then count -- which is
    what rev-list does natively given every tip at once.
    """
    names = [n for n in names if not n.startswith("-")]
    if not names:
        return 0
    out = git(repo, "rev-list", "--count", *names, "--not", "--remotes").strip()
    return int(out) if out.isdigit() else 0


def patch_ids(repo, branch, main_ref, limit=20):
    """The content-identity of each commit, independent of its sha.

    Two branches can carry byte-identical commit subjects over different changes -- a
    cherry-pick that was then amended reads exactly like its original. Subjects find the
    candidate pair; this is what says whether the copy is truly redundant or whether it
    holds a version of the change that the other branch does not.
    """
    out = git(repo, "log", "--patch", f"-{limit}", f"{main_ref}..{branch}")
    if not out:
        return set()
    r = subprocess.run(["git", "patch-id", "--stable"],
                       input=out, capture_output=True, text=True)
    return {line.split()[0] for line in r.stdout.splitlines() if line.strip()}


def collect_stashes(repo):
    """Stashes with their contents. The ref alone is useless; the files are the point."""
    out = git(repo, "stash", "list", "--format=%gd\t%H\t%ct\t%gs")
    stashes = []
    for line in lines(out):
        parts = line.split("\t")
        if len(parts) != 4:
            continue
        ref, sha, ts, subject = parts
        m = re.match(r"^(?:WIP on|On) ([^:]+):", subject)
        base = m.group(1) if m else ""
        files = lines(git(repo, "stash", "show", "--name-only", sha))
        stashes.append({
            "ref": ref,
            "sha": sha[:9],
            "base": base,
            "age_days": int((time.time() - int(ts)) // 86400),
            "files": files[:8],
            "file_count": len(files),
            "src_count": sum(1 for f in files if f.endswith(SRC_SUFFIXES)),
        })
    return stashes


def project_url(repo, mrs):
    """The project's web root, so commits and branches can be linked.

    Taken off an MR's own URL where there is one -- it is already fetched, and it is the
    authority on where this project lives. The remote is the fallback and needs unpicking:
    `git@host:group/proj.git` is not a URL.
    """
    for m in mrs:
        url = m.get("url") or ""
        if "/-/merge_requests/" in url:
            return url.split("/-/merge_requests/")[0]
    remote = git(repo, "remote", "get-url", "origin").strip()
    if not remote:
        return ""
    remote = re.sub(r"\.git$", "", remote)
    m = re.match(r"^(?:ssh://)?git@([^:/]+)[:/](.+)$", remote)
    if m:
        return f"https://{m.group(1)}/{m.group(2)}"
    return remote if remote.startswith("http") else ""


def glab(repo, path, timeout=40):
    """One GitLab call, returning parsed JSON or None. Failures are survivable here."""
    try:
        r = subprocess.run(["glab", "api", path], capture_output=True, text=True,
                           cwd=str(repo), timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return None
    if r.returncode != 0 or not r.stdout.strip():
        return None
    try:
        return json.loads(r.stdout)
    except json.JSONDecodeError:
        return None


def unresolved_threads(repo, iid):
    """Review threads on your own MR that nobody has resolved.

    `blocking_discussions_resolved` is the field that looks like it answers this and it
    does not: on !10398 it reads True while four of ella's threads sit unresolved, because
    this project does not require resolution to merge. It reports mergeability, not whether
    anyone is waiting on you.

    So the threads have to be read. Only the first note of each is kept, quoted, because
    anything claiming you owe someone an answer has to show what they asked.
    """
    threads = glab(repo, f"projects/:id/merge_requests/{iid}/discussions?per_page=100")
    open_ = []
    for t in threads or []:
        notes = [n for n in (t.get("notes") or []) if n.get("resolvable")]
        if not notes or all(n.get("resolved") for n in notes):
            continue
        first = notes[0]
        body = first.get("body") or ""
        # An inline attachment is most of a note's characters and none of its meaning:
        # one of ella's questions spent 90 of its first 180 on
        # `![image](/uploads/bc04.../image.png){width=200...}`, which pushed the actual
        # question out of the excerpt. The quote has to carry what was asked.
        body = re.sub(r"!?\[[^\]]*\]\([^)]*\)(\{[^}]*\})?", " ", body)
        body = re.sub(r"</?[a-z][^>]*>", " ", body)
        body = " ".join(body.split())
        open_.append({
            "author": (first.get("author") or {}).get("username", "?"),
            "quote": body[:180] + ("…" if len(body) > 180 else ""),
            "notes": len(notes),
            "at": (first.get("created_at") or "")[:10],
        })
    return open_


def branch_mr_states(repo, pages=8):
    """branch -> the fate of the MR that was opened from it, whatever state it ended in.

    Without this the tool cannot tell finished work from live work, and it was not telling
    them apart. `for-each-ref --no-merged origin/main` is an ancestry test, and every MR in
    this project squash-merges: the squash lands one new commit on main and the branch's own
    commits are never in main's history, so a fully-merged branch stays "unmerged" forever.
    `collect_mrs` asked only for `state=opened`, so nothing downstream could see it either.

    Measured: of 183 branches on the page, 37 had a merged MR and 8 a closed one, and 9
    whole arcs consisted of nothing else -- finished work rendered as live. The page told
    Kyle to open a merge request for UL-1835, which had merged as !10449.

    One paginated sweep of every MR he has ever opened (500 of them, ~2s) answers it
    outright, which is cheaper and far more certain than inferring it from the graph.
    """
    out = {}
    for page in range(1, pages + 1):
        batch = glab(repo, "projects/:id/merge_requests?scope=created_by_me&state=all"
                           f"&per_page=100&page={page}")
        if not batch:
            break
        for m in batch:
            branch, state = m.get("source_branch"), m.get("state")
            if not branch or state not in ("merged", "closed"):
                continue
            prev = out.get(branch)
            # A branch can carry several MRs over its life -- reopened, retargeted,
            # superseded. Merged beats closed: if any attempt landed, the work landed.
            if prev is None or (prev["state"] == "closed" and state == "merged"):
                out[branch] = {"iid": m.get("iid"), "state": state,
                               "at": (m.get("merged_at") or m.get("closed_at") or "")[:10],
                               "url": m.get("web_url", "")}
    return out


def branch_pipelines(repo):
    """Latest pipeline per ref, from one sweep of the project's recent pipelines.

    Cheap and partial by design. The window covers about a day and a half, so it finds a
    failure on a branch you were just on -- `UL-1774` failed here with no MR to hang it
    off -- and says nothing about older refs. MR pipelines are fetched per MR instead,
    because those matter whatever their age.
    """
    pipes = glab(repo, "projects/:id/pipelines?per_page=100&order_by=updated_at&sort=desc")
    by_ref = {}
    for p in pipes or []:
        ref = p.get("ref") or ""
        if ref.startswith("refs/"):
            continue
        by_ref.setdefault(ref, {"status": p.get("status", ""),
                                "url": p.get("web_url", ""),
                                "at": (p.get("updated_at") or "")[:10]})
    return by_ref


def collect_mrs(repo, deep=True):
    """Open MRs of mine, with enough state to say whose court the ball is in.

    The list call already carries most of it -- conflicts, merge state, reviewers,
    approvals -- and the previous version read four fields out of forty-eight. What it
    cannot carry is unresolved threads and pipeline status, so those are fetched per MR,
    threaded, and gated: threads only where the MR has user notes at all, which on 19 open
    MRs is 3 of them.

    `with_merge_status_recheck=true` is deliberately NOT passed. It looks like the way to
    resolve the eight MRs reading `unchecked`, and instead it discards the cached verdict
    and returns `checking` -- measured, it turned !10391's known `conflict` into an
    unknown. An unknown is reported as unknown rather than guessed at.
    """
    if not shutil.which("glab"):
        return [], "glab not installed"
    raw = glab(repo,
               "projects/:id/merge_requests?scope=created_by_me&state=opened&per_page=100")
    if raw is None:
        return [], "glab could not read merge requests"
    mrs = []
    for m in raw:
        state = m.get("detailed_merge_status") or m.get("merge_status") or ""
        mrs.append({
            "iid": m.get("iid"),
            "title": m.get("title", ""),
            "branch": m.get("source_branch", ""),
            "target": m.get("target_branch", ""),
            "notes": m.get("user_notes_count", 0),
            "draft": bool(m.get("draft") or m.get("work_in_progress")),
            "updated": m.get("updated_at", ""),
            "url": m.get("web_url", ""),
            "sha": (m.get("sha") or "")[:9],
            "merge_state": state,
            # A conflict is asserted by either field; `has_conflicts` was False on
            # !10391 while detailed_merge_status already said `conflict`.
            "conflicts": bool(m.get("has_conflicts")) or state == "conflict",
            "approved": state == "mergeable",
            "reviewers": [r.get("username", "") for r in (m.get("reviewers") or [])],
            "approvals": m.get("upvotes", 0),
            "threads": [],
            "pipeline": None,
        })
    if not deep or not mrs:
        return mrs, None

    def enrich(mr):
        if mr["notes"]:
            mr["threads"] = unresolved_threads(repo, mr["iid"])
        pipes = glab(repo, f"projects/:id/merge_requests/{mr['iid']}/pipelines?per_page=1")
        if pipes:
            mr["pipeline"] = {"status": pipes[0].get("status", ""),
                              "url": pipes[0].get("web_url", ""),
                              "at": (pipes[0].get("updated_at") or "")[:10]}

    with futures.ThreadPoolExecutor(max_workers=8) as pool:
        list(pool.map(enrich, mrs))
    return mrs, None


# Statuses that assert the work has left your hands. If a ticket claims one of these
# while its branch still holds unpushed commits, Jira is describing a world that does
# not exist -- which is the whole thing this reconciliation is for.
HANDED_OFF = {"in review", "mr", "in qualification", "releasing", "ready for review",
              "code review", "qa", "in qa", "verifying"}


def collect_jira():
    """Open issues assigned to me. Jira is the declared picture of my work."""
    domain = os.environ.get("JIRA_DOMAIN")
    email = os.environ.get("JIRA_EMAIL")
    token = os.environ.get("JIRA_API_TOKEN")
    if not (domain and email and token):
        return [], "JIRA_DOMAIN / JIRA_EMAIL / JIRA_API_TOKEN not set in .env"
    url = (f"https://{domain}/rest/api/3/search/jql"
           "?jql=" + urllib.parse.quote(
               "assignee = currentUser() AND statusCategory != Done ORDER BY updated DESC")
           + "&fields=key,summary,status,updated,priority&maxResults=100")
    req = urllib.request.Request(url, headers={"Accept": "application/json"})
    auth = base64.b64encode(f"{email}:{token}".encode()).decode()
    req.add_header("Authorization", f"Basic {auth}")
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            raw = json.load(r)
    except (urllib.error.URLError, json.JSONDecodeError, TimeoutError) as e:
        return [], f"could not reach Jira: {e}"
    issues = []
    for i in raw.get("issues", []):
        f = i.get("fields", {})
        status = (f.get("status") or {}).get("name", "")
        issues.append({
            "key": i.get("key", ""),
            "summary": " ".join((f.get("summary") or "").split()),
            "status": status,
            "handed_off": status.strip().lower() in HANDED_OFF,
            "updated": (f.get("updated") or "")[:10],
            # The link belongs with the ticket, not with whatever renders it. Only this
            # function knows the Jira domain, and a page that has to reconstruct the URL
            # from a key is a page that will get it wrong for one project.
            "url": f"https://{domain}/browse/{i.get('key','')}",
        })
    return issues, None


def collect_initiatives(issues):
    """Map each issue to the initiative(s) it rolls up to.

    The chain is task -> parent Epic -> Initiative, and the last hop is NOT the parent
    field: epics report `parent: none` while still belonging to an initiative. The link
    is a Polaris work item link ("implements"), which is many-to-many -- UL-1533
    implements both SBX-2 and UL-1825 -- so a parent field could not express it even in
    principle. Initiatives also live in SBX, a project absent from JIRA_PROJECTS, which
    is why the hierarchy looked missing until Trellis's own JQL turned up.
    """
    domain = os.environ.get("JIRA_DOMAIN")
    email = os.environ.get("JIRA_EMAIL")
    token = os.environ.get("JIRA_API_TOKEN")
    if not (domain and email and token):
        return {}, {}
    auth = base64.b64encode(f"{email}:{token}".encode()).decode()

    def get(path):
        req = urllib.request.Request(f"https://{domain}/rest/api/3/{path}",
                                     headers={"Accept": "application/json"})
        req.add_header("Authorization", f"Basic {auth}")
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                return json.load(r)
        except (urllib.error.URLError, json.JSONDecodeError, TimeoutError, ValueError):
            return None

    epics = {}
    for i in issues:
        key = i["key"]
        d = get(f"issue/{key}?fields=parent")
        if d:
            par = (d.get("fields") or {}).get("parent")
            if par:
                epics.setdefault(par["key"], []).append(key)

    issue_to_init, initiatives = {}, {}
    for epic, children in epics.items():
        d = get(f"issue/{epic}?fields=issuelinks,summary")
        if not d:
            continue
        inits = []
        for link in (d.get("fields") or {}).get("issuelinks") or []:
            other = link.get("outwardIssue") or link.get("inwardIssue") or {}
            f = other.get("fields") or {}
            if (f.get("issuetype") or {}).get("name") == "Initiative":
                inits.append(other["key"])
                initiatives[other["key"]] = " ".join((f.get("summary") or "").split())
        for child in children:
            issue_to_init[child] = inits
    return issue_to_init, initiatives


def reconcile(arcs, issues):
    """Where the derived picture and the declared one disagree.

    Three gaps, and they want different actions: work with no ticket needs one
    filing, a ticket with no work needs closing or starting, and a ticket claiming
    to be handed off while its commits sit on this laptop needs a push.
    """
    # An arc's ticket keys live in its member branches, not in its label: clustering
    # names an arc after its evidence, so UL-1692's arc may be called something else
    # entirely. Keying off the label alone silently emptied this map and made every
    # issue look like work that never started.
    by_key = {}
    for a in arcs:
        for b in a["branches"]:
            m = TICKET_RE.search(b["name"].upper())
            if m:
                by_key.setdefault(m.group(0), a)
        m = TICKET_RE.search((a.get("label") or "").upper())
        if m:
            by_key.setdefault(m.group(0), a)
    issue_keys = {i["key"] for i in issues}

    # An arc that owns a ticket owns its summary too. Without this the arc knows only
    # the key, so anything rendering an arc can print `UL-1692` and nothing about what
    # UL-1692 *is* -- the summary existed all along, but only inside the gap report.
    for i in issues:
        arc = by_key.get(i["key"])
        if arc is not None:
            arc.setdefault("issues", []).append(i)
    for a in arcs:
        a.setdefault("issues", [])
        # Most-recently-updated ticket first: on an arc holding several, that is the
        # one the work is currently about.
        a["issues"].sort(key=lambda i: i.get("updated", ""), reverse=True)

    def has_ticket(a):
        if a["kind"] == "ticket":
            return True
        return any(TICKET_RE.search(b["name"].upper()) for b in a["branches"])

    unticketed = [
        a for a in arcs
        if not has_ticket(a) and a["engagement"] >= 200 and a["age_days"] <= 30
    ]
    unticketed.sort(key=lambda a: -a["engagement"])

    no_work = [i for i in issues if i["key"] not in by_key]

    mismatched = []
    for i in issues:
        a = by_key.get(i["key"])
        if not a:
            continue
        # The distinct count, not the per-branch sum. "240 commits never pushed" against a
        # ticket that has 114 is the kind of overstatement that costs the whole page its
        # credibility -- and this row exists to tell someone their ticket is lying.
        if i["handed_off"] and a["unpushed_live"] > 0:
            n = a["unpushed_live"]
            mismatched.append({"issue": i, "arc": a,
                               "why": f"status '{i['status']}' but {n} "
                                      f"commit{'' if n == 1 else 's'} never pushed"})
        elif not i["handed_off"] and a["age_days"] > 21:
            mismatched.append({"issue": i, "arc": a,
                               "why": f"status '{i['status']}' but untouched {a['age_days']}d"})
    return {"unticketed_work": unticketed, "tickets_without_work": no_work,
            "status_mismatch": mismatched}


OVERRIDES = (Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
             / "work-arcs" / "authoritative.json")


def load_overrides():
    if not OVERRIDES.exists():
        return {}
    try:
        data = json.loads(OVERRIDES.read_text())
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def apply_overrides(arcs, store):
    """Let a human name the authoritative branch, in the one form that cannot rot.

    Nothing here may DEPEND on this: 0 of 38 open tickets carry an estimate, which is the
    measured fate of every optional field, so the derivation has to be right on its own
    and this only ever corrects it. That is also why the override is not simply an
    assertion. It records what it was overriding at the time, and it applies only while
    that is still what the derivation says. Once the evidence moves -- an MR opens, a
    branch is squashed -- the override has been overtaken by facts it never saw, and it
    reports itself stale instead of quietly outvoting them.

    Returns the labels whose override was ignored, so the page can say so.
    """
    stale = []
    for arc in arcs:
        entry = store.get(arc.get("label")) or store.get(arc.get("id"))
        if not entry:
            continue
        want = entry.get("branch")
        if want not in {b["name"] for b in arc.get("branches", [])}:
            stale.append({"label": arc.get("label"), "branch": want,
                          "why": "that branch is no longer in this arc"})
            continue
        was = entry.get("over")
        if was and was != arc.get("authoritative"):
            stale.append({"label": arc.get("label"), "branch": want,
                          "why": f"derivation moved from {was} to "
                                 f"{arc.get('authoritative')} since you set this"})
            continue
        arc["authoritative"] = want
        arc["authoritative_via"] = "set by hand"
        for b in arc["branches"]:
            b["authoritative"] = b["name"] == want
        arc["demands"] = demands(arc)
    return stale


def set_override(arcs, spec):
    """`--authoritative ARC=BRANCH`, stamped with what it is overriding."""
    label, _, branch = spec.partition("=")
    label, branch = label.strip(), branch.strip()
    match = [a for a in arcs if a.get("label") == label or a.get("id") == label]
    if not match:
        sys.exit(f"work-arcs: no arc named {label!r}")
    arc = match[0]
    names = [b["name"] for b in arc["branches"]]
    if branch not in names:
        sys.exit(f"work-arcs: {branch!r} is not a branch of {label!r}\n  "
                 + "\n  ".join(names))
    store = load_overrides()
    store[label] = {"branch": branch, "over": arc.get("authoritative"),
                    "at": int(time.time())}
    OVERRIDES.parent.mkdir(parents=True, exist_ok=True)
    OVERRIDES.write_text(json.dumps(store, indent=1, sort_keys=True))
    print(f"✓ {label}: authoritative branch is {branch} "
          f"(was deriving {arc.get('authoritative')})", file=sys.stderr)
    print(f"  expires itself if that derivation changes — {OVERRIDES}", file=sys.stderr)


def jira_ify(repo, arc, dry_run):
    """File a ticket for work that already exists, using what the arc already knows."""
    branches = ", ".join(b["name"] for b in arc["branches"][:6])
    subjects = []
    for b in arc["branches"][:3]:
        out = git(repo, "log", "--format=%s", "-3", f"origin/main..{b['name']}")
        subjects += [f"  - {x}" for x in lines(out)[:3]]
    desc = "\n".join([
        f"Work already in progress under the name '{arc['label']}'.",
        "",
        f"Branches: {branches}",
        f"Unpushed commits: {arc['unpushed']}",
        f"Claude sessions touching this work: {arc['counts']['sessions']}",
        f"Last activity: {arc['age_days']}d ago",
        "",
        "Recent commit subjects:",
        *subjects,
    ])
    cmd = ["create-jira-ticket", "--summary", arc["label"], "--description", desc]
    if dry_run:
        cmd.append("--dry-run")
    script = Path(__file__).resolve().parent / "create-jira-ticket"
    if script.exists():
        cmd[0] = str(script)
    print(f"→ {' '.join(cmd[:3])} ...", file=sys.stderr)
    return subprocess.run(cmd).returncode


def load_clusters(repo, main, resolution):
    """Arc membership from arc-cluster, i.e. from what the work touched.

    Branch names are a fallback now, not the mechanism. A name describes the change;
    the files describe the intent, which is why one investigation used to come out as
    nine arcs. Returns {branch_name: arc_label} plus each arc's session ids.
    """
    tool = Path(__file__).resolve().parent / "arc-cluster"
    if not tool.exists():
        return {}, {}
    try:
        r = subprocess.run(
            [str(tool), "--repo", str(repo), "--main", main,
             "--resolution", str(resolution), "--json"],
            capture_output=True, text=True, timeout=180)
        data = json.loads(r.stdout)
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError, ValueError):
        return {}, {}

    assign, sessions = {}, {}
    for arc in data.get("arcs", []):
        label = arc.get("label") or "?"
        # Two clusters can derive the same label; keep them distinct so their members
        # are not silently merged back together.
        if label in sessions and sessions[label] != arc.get("sessions", []):
            label = f"{label} ({len(sessions)})"
        sessions[label] = arc.get("sessions", [])
        for b in arc.get("branches", []):
            assign[b] = label
    return assign, sessions


def split_assignment(arcs, args):
    """arc-brief's verdict on which arcs hold more than one body of work.

    Degrades the same way every other step does: no arc-brief, no model, or a reply that
    fails to account for every branch leaves the clustering exactly as it was.
    """
    tool = Path(__file__).resolve().parent / "arc-brief"
    if not tool.exists():
        return {}
    payload = json.dumps({"repo": str(args.repo), "main": args.main, "arcs": arcs})
    cmd = [str(tool), "--split", "--jobs", str(args.split_jobs)]
    if args.split_model:
        cmd += ["--model", args.split_model]
    try:
        r = subprocess.run(cmd, input=payload, capture_output=True, text=True,
                           timeout=args.split_timeout)
    except (OSError, subprocess.SubprocessError):
        return {}
    if r.stderr:
        print(r.stderr.rstrip(), file=sys.stderr)
    if r.returncode != 0:
        return {}
    try:
        out = json.loads(r.stdout)
    except json.JSONDecodeError:
        return {}
    return out if isinstance(out, dict) else {}


def ticket_of(name, known_projects):
    """The arc a branch name declares, if it declares one."""
    m = TICKET_RE.search(name.upper())
    if m:
        return f"{m.group(1)}-{m.group(2)}"
    # `6919-review` names a ticket without its project. Resolve the number against
    # projects that appear elsewhere, and only when it is unambiguous.
    m = BARE_NUM_RE.search(name)
    if m:
        num = m.group(1)
        hits = {p for (p, n) in known_projects if n == num}
        if len(hits) == 1:
            return f"{hits.pop()}-{num}"
    return None


# `hotfix/`, `fix/`, `review/` are categories every unrelated branch shares -- as an
# arc name, `hotfix` collected 37 branches with nothing in common. Skip past them to
# the token that actually names the work.
PREFIX_STOPWORDS = {
    "hotfix", "fix", "fixes", "review", "wip", "temp", "tmp", "test", "tests",
    "feat", "feature", "chore", "bak", "backup", "old", "new", "try", "spike",
    "kyle", "misc", "draft", "release",
}


def prefix_of(name):
    """A provisional arc name for work that never got a ticket.

    Groups the `adaptive` / `adaptive-bak` / `adaptive-bak-bak-bak` family that a
    ticket-key grouping cannot see at all. Conventional prefixes are stepped over,
    since they describe the kind of branch rather than the work in it.
    """
    for token in re.split(r"[-/_.]", name):
        t = token.lower()
        if len(t) >= 4 and t not in PREFIX_STOPWORDS and not t.isdigit():
            return t
    return None


def build_arcs(branches, stashes, mrs, sessions, main_ref, cluster_assign=None,
               repo=None, mrs_known=True):
    known_projects = set()
    for name in branches:
        m = TICKET_RE.search(name.upper())
        if m:
            known_projects.add((m.group(1), m.group(2)))

    # Assign every branch to an arc: a ticket if it names one, else a shared name
    # prefix, else itself.
    assign, prefix_members = {}, defaultdict(list)
    cluster_assign = cluster_assign or {}
    for name in branches:
        # Files first, names only where the clustering had nothing to say.
        if name in cluster_assign:
            assign[name] = ("cluster", cluster_assign[name])
            continue
        key = ticket_of(name, known_projects)
        if key:
            assign[name] = ("ticket", key)
        else:
            p = prefix_of(name)
            if p:
                prefix_members[p].append(name)
            else:
                assign[name] = ("single", name)
    for p, members in prefix_members.items():
        # A prefix shared by one branch is not a cluster, it is just a branch.
        kind = "prefix" if len(members) > 1 else "single"
        for name in members:
            assign[name] = (kind, p if kind == "prefix" else name)

    arcs = {}
    for name, b in branches.items():
        kind, key = assign[name]
        arc = arcs.setdefault(key, {
            "id": key, "kind": kind, "label": key,
            "branches": [], "stashes": [], "mrs": [], "sessions": [],
        })
        arcs[key]["branches"].append(b)

    branch_to_arc = {n: assign[n][1] for n in branches}

    # A stash belongs to the arc of the branch it was taken on. Stashes are a weak
    # signal here by policy: Kyle keeps meaningful work unstashed, so a stash is
    # usually scratch. One with no arc to belong to is listed as unattached rather
    # than promoted to an arc of its own -- inventing 97 single-stash arcs was the
    # tail wagging the dog.
    unattached = []
    for s in stashes:
        key = branch_to_arc.get(s["base"])
        if key is None:
            if s["src_count"] > 0:
                unattached.append(s)
            continue
        arcs[key]["stashes"].append(s)

    for m in mrs:
        key = branch_to_arc.get(m["branch"]) or ticket_of(m["title"], known_projects)
        if key and key in arcs:
            arcs[key]["mrs"].append(m)

    seen_session = defaultdict(set)
    for branch, info in sessions.items():
        key = branch_to_arc.get(branch)
        if not key or key not in arcs:
            continue
        # Once per branch. Adding it per session multiplied a branch's mentions by
        # how many sessions mentioned it, which put a 109,272 on a five-branch arc.
        arcs[key]["engagement"] = arcs[key].get("engagement", 0) + info["entries"]
        # sorted(), because `paths` is a set of strings and set iteration order varies
        # between processes. That randomness reached the brief: prompts are emitted in
        # session order, so 16 of 55 arcs produced different evidence text on two
        # back-to-back runs and re-briefed for no reason at all.
        for p in sorted(info["paths"]):
            if p in seen_session[key]:
                continue
            seen_session[key].add(p)
            arcs[key]["sessions"].append({
                "id": Path(p).stem,
                "age_days": int((time.time() - info["last"]) // 86400)
                if info["last"] else 999,
                "last": info["last"],
                "via": branch,
            })

    for arc in arcs.values():
        arc["mrs_known"] = mrs_known
        finalize(arc, repo, main_ref)
    ordered = sorted(arcs.values(), key=lambda a: (a["age_days"], -a["at_risk"]))
    return ordered, unattached


def mark_duplicates(arc, repo=None, main_ref="origin/main"):
    """Say which branches in an arc are copies of another rather than work of their own.

    An arc has always been a bag of branches with no notion of which one IS the work, and
    the cost of that is not cosmetic. Measured: the brief for UL-1634 asserted "the lint
    work is on a separate branch that isn't stacked onto the fix", and the truth is the
    opposite -- all four commits of the MR ARE the lint work, while
    `lint-metric-instance-stability` holds a single commit whose subject is byte-identical
    to one of them. A superseded cherry-pick drawn as an independent root reads as a second
    piece of work, and the model read it exactly that way.

    The test is containment: if every commit subject on B also appears on a branch ranked
    above it, B adds nothing. Ranking first is what keeps this acyclic -- a branch can only
    ever be superseded by a stronger one. Patch-ids then say whether the copy is redundant
    to the byte or merely reads the same, which is the difference between "delete this" and
    "check what diverched".

    Containment alone is not enough, and the difference is the whole distinction being
    drawn. A stack parent's commits are contained in its child too -- measured, `UB-6829`
    is an ancestor of `dove-test-utils`, so subject containment alone called the ticket
    branch a duplicate of the branch stacked on top of it. Same commits, same shas: that is
    a stack, it is already drawn as an edge, and it is not supersession. A superseded copy
    is the other case -- the same *content* under different shas, which is what a
    cherry-pick, a rebase or a squash leaves behind.
    """
    branches = arc.get("branches", [])
    if len(branches) < 2:
        return
    mr_branches = {m.get("branch") for m in arc.get("mrs", [])}

    def rank(b):
        # Name before size, and the order is load-bearing. A `-before-squash` branch has
        # more commits than the squashed version by construction, so ranking on commit
        # count first nominates the pre-squash copy as the canonical branch and then
        # declares the real one a duplicate of it. The name only ever picks which of two
        # branches is canonical; what makes one superseded at all is its content.
        return (b["name"] in mr_branches, not VARIANT_RE.search(b["name"]),
                b.get("commits_ahead", 0), b.get("pushed", False),
                -b.get("age_days", 999), b["name"])

    ordered = sorted(branches, key=rank, reverse=True)
    for b in ordered:
        # Recomputed from scratch, never accumulated: finalize runs again once tickets are
        # joined on, and a mark left over from the previous pass would outlive its reason.
        b.pop("superseded_by", None)
        b.pop("superseded_kind", None)
    ids = {}

    def pids(name):
        if name not in ids:
            ids[name] = patch_ids(repo, name, main_ref) if repo is not None else set()
        return ids[name]

    for i, b in enumerate(ordered):
        subs = set(b.get("subjects") or [])
        if not subs:
            continue
        for a in ordered[:i]:
            asubs = set(a.get("subjects") or [])
            if not asubs or not subs <= asubs:
                continue
            if b["name"] in (a.get("parents") or []):
                continue  # a stack edge, drawn as one; not a copy
            kind = "same subjects"
            if repo is not None and len(subs) <= 20 and len(asubs) <= 20:
                mine = pids(b["name"])
                if mine and mine <= pids(a["name"]):
                    kind = "identical content"
            b["superseded_by"] = a["name"]
            b["superseded_kind"] = kind
            break


def authoritative(arc):
    """Which single branch IS this work, and on what evidence.

    Four sources, strongest first, and the reason is recorded with the answer because they
    are not equally trustworthy. An open MR's source branch is a fact -- it is the branch
    under review, which is what "the work" means once it has left your hands. A branch
    naming the arc's ticket is nearly as good and only usable when exactly one does.

    The no-MR fallback used to be "most commits ahead", and that is a heuristic wearing a
    derivation's clothes: a pre-squash branch has more commits than the squashed version by
    construction, which is how `UB-6919-before-squash` came to be called the work. The
    structural answer is the tip of the stack -- the branch no other branch in this arc is
    built on. In a stack the descendant contains its ancestors, so the thing you are
    actually working on is whatever nothing else was cut from. A worktree checkout breaks
    ties ahead of anything else, because standing in a branch is the strongest statement of
    intent available without asking.
    """
    branches = [b for b in arc.get("branches", []) if not b.get("superseded_by")]
    if not branches:
        branches = arc.get("branches", [])
    # A branch whose MR merged is finished; it cannot be what the work currently is unless
    # nothing else is left.
    live = [b for b in branches if not b.get("mr_fate")]
    if live:
        branches = live
    if not branches:
        return None, None
    by_name = {b["name"]: b for b in branches}

    # An arc can hold several MRs, and then the question is which one the work is currently
    # about. finalize has already ordered them most-recently-updated first with drafts
    # last, which is a better answer than the highest number -- that just means newest filed.
    for m in arc.get("mrs", []):
        if m.get("branch") in by_name:
            return m["branch"], f"source of !{m.get('iid')}"

    for i in arc.get("issues", []):
        named = [b["name"] for b in branches
                 if TICKET_RE.search(b["name"].upper())
                 and TICKET_RE.search(b["name"].upper()).group(0) == i["key"]]
        if len(named) == 1:
            return named[0], f"names {i['key']}"

    # Tips of the stack: nothing else in the arc was cut from these.
    has_child = {p for b in branches for p in (b.get("parents") or [])}
    tips = [b for b in branches if b["name"] not in has_child] or branches
    best = max(tips, key=lambda b: (b.get("worktree", False),
                                    not VARIANT_RE.search(b["name"]),
                                    b.get("committed", 0),
                                    b.get("commits_ahead", 0)))
    why = "checked out in a worktree" if best.get("worktree") else "tip of the stack"
    return best["name"], f"{why}, no MR"


# The order is the whole point: what will bite you soonest, not what is biggest. Nothing
# in this list is here because it is large -- each entry is a thing that cannot move until
# you personally do something.
DEMAND_RANK = {"conflict": 0, "threads": 1, "pipeline": 2, "approved": 3,
               "unpushed": 4, "unreviewed": 5, "draft": 6}


def demands(arc):
    """What this arc needs from *you*, worst first. Empty means it is someone else's turn.

    The correction this makes: an arc whose only state is "up for review" was rendering as
    the hottest thing on the page, level with work that is genuinely stuck. Getting a
    discrete piece of work up for review is most of the job done -- the counterparty is a
    reviewer and the clock is theirs. It belongs at the bottom.

    What belongs at the top is the small set of things where the work has come back: a
    branch that no longer merges, a question nobody answered, a pipeline that went red, an
    approval that never turned into a merge, and commits that exist on this laptop only.
    """
    out = []
    for m in arc.get("mrs", []):
        ref = f"!{m.get('iid')}"
        if m.get("conflicts"):
            out.append({"kind": "conflict", "what": f"{ref} no longer merges into "
                        f"{m.get('target') or 'main'} — rebase", "url": m.get("url", "")})
        # One demand per MR, not per thread. Four threads produced four rows reading
        # "ella asked, unanswered since 2026-08-13" with only the quote to tell them
        # apart, which is a list of the same sentence. Who is waiting and since when is
        # the demand; the questions are its evidence.
        threads = m.get("threads", [])
        if threads:
            who = sorted({t["author"] for t in threads})
            oldest = min(t["at"] for t in threads if t["at"]) if any(
                t["at"] for t in threads) else ""
            n = len(threads)
            out.append({
                "kind": "threads",
                "what": f"{ref}: {n} unanswered question{'' if n == 1 else 's'} from "
                        f"{', '.join(who)}" + (f", oldest {oldest}" if oldest else ""),
                "quotes": [t["quote"] for t in threads if t.get("quote")],
                "url": m.get("url", "")})
        pipe = m.get("pipeline") or {}
        if pipe.get("status") in ("failed", "canceled"):
            out.append({"kind": "pipeline",
                        "what": f"{ref} pipeline {pipe['status']} on {pipe.get('at','')}",
                        "url": pipe.get("url") or m.get("url", "")})
        if m.get("approved") and not m.get("draft"):
            out.append({"kind": "approved",
                        "what": f"{ref} is approved and still open — merge it",
                        "url": m.get("url", "")})
        if m.get("draft") and arc.get("age_days", 0) > 14:
            out.append({"kind": "draft",
                        "what": f"{ref} has been a draft for {arc['age_days']}d — nobody "
                                "will review it", "url": m.get("url", "")})

    for b in arc.get("branches", []):
        pipe = b.get("pipeline") or {}
        if pipe.get("status") == "failed" and not b.get("superseded_by"):
            out.append({"kind": "pipeline",
                        "what": f"{b['name']} pipeline failed on {pipe.get('at','')}",
                        "url": pipe.get("url", "")})

    # Only commits that are the live work. A superseded copy's commits already exist on
    # the branch that supersedes it, so counting them as at-risk invents risk: the one
    # unpushed commit on `lint-metric-instance-stability` is a cherry-pick of a commit
    # that is pushed, reviewed and in an MR.
    if arc.get("unpushed_live"):
        n = arc["unpushed_live"]
        out.append({"kind": "unpushed",
                    "what": (f"{n} commit exists" if n == 1 else f"{n} commits exist")
                            + " nowhere but this laptop"})

    auth = arc.get("authoritative")
    # Only when GitLab was actually asked. With --no-mr, or when glab is missing or the API
    # call failed, every arc has an empty MR list -- and this fired on all of them, telling
    # you 8 arcs had no merge request when the truth was that nobody looked. A wrong
    # reminder costs more trust than ten right ones earn.
    if auth and arc.get("mrs_known", True) and not arc.get("mrs"):
        b = next((x for x in arc["branches"] if x["name"] == auth), None)
        # Never for a branch whose MR already merged or closed. 11 of 17 of these claims
        # were false for exactly that reason: squash-merge hides the landing from ancestry,
        # so UL-1835 was told to open the merge request it had already merged as !10449.
        if (b and b.get("pushed") and b.get("commits_ahead", 0) > 0
                and not b.get("mr_fate")):
            n = b["commits_ahead"]
            out.append({"kind": "unreviewed",
                        "what": f"{auth} is pushed with {n} "
                                f"commit{'' if n == 1 else 's'} and has no merge request"})

    out.sort(key=lambda d: DEMAND_RANK.get(d["kind"], 9))
    return out


def finalize(arc, repo=None, main_ref="origin/main"):
    # Runs twice: once as arcs are built, and again after Jira issues are joined on, since
    # which branch is authoritative can depend on which ticket the arc owns. Every field
    # here is recomputed rather than added to, so the second pass is a no-op where nothing
    # changed and a correction where something did.
    # Most recently updated first, drafts last: on an arc holding several MRs that is the
    # one the work is currently about, and everything downstream reads mrs[0] as the one
    # that speaks for the arc. Two stable sorts rather than one composite key.
    arc["mrs"].sort(key=lambda m: m.get("updated") or "", reverse=True)
    arc["mrs"].sort(key=lambda m: m.get("draft", False))

    mark_duplicates(arc, repo, main_ref)

    # Two different ages, because they answer different questions. The newest
    # touch says "is this live"; the median says "how much of this has gone cold".
    # Min alone made every large arc look active: one commit today in a 17-branch
    # cluster is not the same as the cluster being worked on.
    ages = sorted(
        [b["age_days"] for b in arc["branches"]]
        + [s["age_days"] for s in arc["sessions"]]
    )
    arc["age_days"] = ages[0] if ages else 999
    arc["median_age_days"] = ages[len(ages) // 2] if ages else 999

    # Two numbers, because they answer different questions. `unpushed` is the per-branch
    # sum -- the fact about the refs, and what every earlier version of this reported.
    # `unpushed_live` is how many commits are genuinely only here: counted once each rather
    # than once per branch that contains them, and over live branches only, since a
    # superseded copy's commits already exist on the branch that supersedes it. The gap
    # between the two is how much of this arc's apparent risk is the same work recounted.
    # A workstream every branch of which has landed or been abandoned is finished, and its
    # only honest place on a page about live work is a count. Any branch still without a
    # settled MR keeps the arc alive -- work continuing on top of a merged branch is normal
    # and is exactly the case a whole-arc test must not swallow.
    fates = [b.get("mr_fate", {}).get("state") for b in arc["branches"]]
    if fates and all(f in ("merged", "closed") for f in fates):
        arc["settled"] = "landed" if "merged" in fates else "abandoned"
    else:
        arc["settled"] = None

    arc["unpushed"] = sum(b["unpushed"] for b in arc["branches"])
    # Commits on a branch whose MR already merged are not work waiting to be pushed. Both
    # this and supersession answer the same question -- is this commit's content already
    # somewhere safe -- and both have to be excluded before a number is called risk.
    def dead(b):
        return bool(b.get("superseded_by")) or \
            b.get("mr_fate", {}).get("state") in ("merged", "closed")

    held = [b["name"] for b in arc["branches"] if b["unpushed"]]
    live = [b["name"] for b in arc["branches"] if b["unpushed"] and not dead(b)]
    if repo is not None:
        arc["unpushed_live"] = distinct_unpushed(repo, live)
        # What deleting only the copies would cost: distinct commits that exist on a
        # superseded branch and nowhere else. Reporting `unpushed - unpushed_live` as
        # "on superseded copies" conflated two different corrections and overstated this
        # by an order of magnitude -- most of that gap is one stack counted per branch.
        arc["unpushed_only_on_copies"] = (distinct_unpushed(repo, held)
                                          - arc["unpushed_live"])
    else:
        arc["unpushed_live"] = sum(b["unpushed"] for b in arc["branches"]
                                   if not b.get("superseded_by"))
        arc["unpushed_only_on_copies"] = arc["unpushed"] - arc["unpushed_live"]
    arc["superseded"] = sum(1 for b in arc["branches"] if b.get("superseded_by"))
    arc["landed_branches"] = sum(1 for b in arc["branches"]
                                 if b.get("mr_fate", {}).get("state") == "merged")
    # Stashes contribute a token amount: they break ties, they do not set priority.
    arc["at_risk"] = arc["unpushed_live"] + min(
        sum(s["src_count"] for s in arc["stashes"]), 3)
    arc["stacked"] = sum(1 for b in arc["branches"] if b["parents"])

    auth, via = authoritative(arc)
    arc["authoritative"], arc["authoritative_via"] = auth, via
    for b in arc["branches"]:
        b["authoritative"] = b["name"] == auth
    # The ticket the work is filed under, kept apart from the rest. An arc can carry five
    # keys; exactly one of them is the one this branch is answering, and a subhead that
    # prints all five with no distinction between them says nothing about which.
    arc["ticket"] = None
    if auth:
        m = TICKET_RE.search(auth.upper())
        if m:
            arc["ticket"] = m.group(0)
    if not arc["ticket"] and arc.get("issues"):
        arc["ticket"] = arc["issues"][0]["key"]

    # How far this workstream has got, which is a fact about it rather than a verdict on
    # it. The old vocabulary was `at risk` / `idle` / `active`, and `at risk` was correctly
    # called useless: it is a severity word standing where a fact should be, and it told you
    # nothing about what the work needs or where it had reached. Every value below names
    # either a rung of the ladder or the specific thing that came back.
    settled = arc.get("settled")
    arc["demands"] = [] if settled else demands(arc)
    # Ranks WITHIN a rung only. There is no defensible exchange rate between "ella asked a
    # question six days ago" and "79 commits exist nowhere but this laptop", so the page
    # never sorts one against the other -- see `stage`.
    arc["urgency"] = (DEMAND_RANK.get(arc["demands"][0]["kind"], 9)
                      if arc["demands"] else 99)

    if settled:
        arc["stage"] = settled
        arc["state"] = {"landed": "landed", "abandoned": "abandoned"}[settled]
    elif arc["demands"] and arc["demands"][0]["kind"] in (
            "conflict", "threads", "pipeline", "approved", "draft"):
        arc["stage"] = "came-back"
        arc["state"] = {
            "conflict": "no longer merges", "threads": "questions unanswered",
            "pipeline": "pipeline failed", "approved": "approved, not merged",
            "draft": "still a draft",
        }[arc["demands"][0]["kind"]]
    elif arc["mrs"]:
        # An MR open with nothing outstanding: his end of the deal is done and the clock
        # belongs to a reviewer. This used to read "waiting on review" and rank first.
        arc["stage"] = "in-review"
        arc["state"] = "in review"
    elif arc["unpushed_live"]:
        arc["stage"] = "local-only"
        n = arc["unpushed_live"]
        arc["state"] = (f"{n} commit exists" if n == 1 else f"{n} commits exist") + \
                       " only here"
    elif arc.get("mrs_known", True) and arc["authoritative"]:
        arc["stage"] = "not-proposed"
        arc["state"] = "pushed, no merge request"
    else:
        arc["stage"] = "not-proposed"
        arc["state"] = "nothing outstanding"

    arc.setdefault("engagement", 0)
    arc["counts"] = {
        "branches": len(arc["branches"]),
        "stashes": len(arc["stashes"]),
        "mrs": len(arc["mrs"]),
        "sessions": len(arc["sessions"]),
    }
    # Every ordering here needs a total tiebreak, because arc-brief fingerprints the
    # evidence text and these orders decide it. `age_days` is a coarse integer, so ties are
    # the common case rather than the exception, and a stable sort then preserves whatever
    # order the input happened to arrive in.
    arc["branches"].sort(key=lambda b: (-b["unpushed"], b["age_days"], b["name"]))
    arc["stashes"].sort(key=lambda s: (-s["src_count"], s["ref"]))
    arc["sessions"].sort(key=lambda s: (-s["last"], s["id"]))


def main():
    p = argparse.ArgumentParser(description="Group a repo's loose work into arcs.")
    p.add_argument("--repo", type=Path, default=None,
                   help="defaults to JIRA_REPO from .env — the work repo is already "
                        "declared there, so it is not re-declared here")
    p.add_argument("--main", default=os.environ.get("WORK_ARCS_MAIN", "origin/main"))
    p.add_argument("--projects", type=Path,
                   default=Path(os.environ.get("WORK_ARCS_PROJECTS",
                                               Path.home() / ".claude/projects")))
    p.add_argument("--active", type=int, metavar="DAYS",
                   help="only arcs touched this recently")
    p.add_argument("--focus", nargs="?", type=int, const=7, metavar="DAYS",
                   help="what you are actually working on: arcs with real activity "
                        "in the last DAYS (default 7), newest first")
    p.add_argument("--focus-limit", type=int, default=8,
                   help="how many arcs the focus view shows (default 8)")
    p.add_argument("--initiatives", action="store_true",
                   help="resolve each ticket's initiative via Polaris links (extra "
                        "Jira calls, so opt-in)")
    p.add_argument("--no-cluster", action="store_true",
                   help="fall back to branch-name grouping (the old, wrong way)")
    p.add_argument("--resolution", type=float, default=3.0,
                   help="arc-cluster granularity passed through")
    p.add_argument("--no-mr", action="store_true", help="skip the GitLab call")
    p.add_argument("--shallow-mr", action="store_true",
                   help="skip the per-MR calls for unresolved review threads and pipeline "
                        "status; the list call alone still gives conflicts and approvals")
    p.add_argument("--authoritative", metavar="ARC=BRANCH",
                   help="name the branch that IS an arc's work when the derivation gets it "
                        "wrong. Optional: it only corrects, nothing depends on it, and it "
                        "expires itself once the derivation changes underneath")
    p.add_argument("--no-split", action="store_true",
                   help="skip arc-brief's pass over arcs that hold several bodies of "
                        "work; file overlap alone decides membership")
    p.add_argument("--split-model", default=None, help="model alias for the split pass")
    p.add_argument("--split-jobs", type=int, default=6,
                   help="concurrent model calls in the split pass")
    p.add_argument("--split-timeout", type=int, default=900,
                   help="seconds for the whole split pass")
    p.add_argument("--gap", action="store_true",
                   help="where Jira and reality disagree: work with no ticket, "
                        "tickets with no work, tickets claiming to be handed off")
    p.add_argument("--jira-ify", metavar="ARC",
                   help="file a ticket for an arc, prefilled from what it already is")
    p.add_argument("--dry-run", action="store_true",
                   help="with --jira-ify, show the ticket without creating it")
    p.add_argument("--json", action="store_true", help="emit the graph")
    args = p.parse_args()
    load_env()

    global TICKET_RE
    TICKET_RE = _ticket_re()

    if args.repo is None:
        declared = os.environ.get("JIRA_REPO") or os.environ.get("WORK_ARCS_REPO")
        if not declared:
            sys.exit("work-arcs: set JIRA_REPO in .env (the work repo this tracks)")
        args.repo = Path(declared)

    if not (args.repo / ".git").exists():
        sys.exit(f"work-arcs: not a git repo: {args.repo}")
    git(args.repo, "rev-parse", "--verify", args.main, check=True)

    cluster_assign = {}
    if not args.no_cluster:
        cluster_assign, _ = load_clusters(args.repo, args.main, args.resolution)

    branches = collect_branches(args.repo, args.main)
    stashes = collect_stashes(args.repo)
    mrs, mr_error = ([], None) if args.no_mr else collect_mrs(args.repo, not args.shallow_mr)
    if not args.no_mr:
        for name, pipe in branch_pipelines(args.repo).items():
            if name in branches:
                branches[name]["pipeline"] = pipe
    mrs_known = not args.no_mr and mr_error is None
    if mrs_known:
        for name, fate in branch_mr_states(args.repo).items():
            if name in branches:
                branches[name]["mr_fate"] = fate
    sessions = session_index(args.projects)
    arcs, unattached = build_arcs(branches, stashes, mrs, sessions, args.main,
                                  cluster_assign, args.repo, mrs_known)

    # File overlap cannot separate two tickets that edit the same module -- measured,
    # UB-6938 migrating the metric catalogs and UL-1634 hardening a lint rule over those
    # same catalogs are structurally identical. The last discriminator is what the
    # changes say they are for, so arc-brief reads the commit subjects and returns a
    # refined assignment. Applied by re-clustering rather than by carving up finished
    # arcs, so every count stays computed in one place.
    if not args.no_split:
        refined = split_assignment(arcs, args)
        if refined:
            cluster_assign = {**cluster_assign, **refined}
            arcs, unattached = build_arcs(branches, stashes, mrs, sessions, args.main,
                                          cluster_assign, args.repo, mrs_known)

    if args.authoritative:
        set_override(arcs, args.authoritative)
        return

    if args.jira_ify:
        match = [a for a in arcs if a["label"] == args.jira_ify or a["id"] == args.jira_ify]
        if not match:
            sys.exit(f"work-arcs: no arc named {args.jira_ify!r} "
                     f"(try `work-arcs --gap` for the candidates)")
        arc = match[0]
        if arc["kind"] == "ticket":
            sys.exit(f"work-arcs: {arc['label']} already is a ticket")
        sys.exit(jira_ify(args.repo, arc, args.dry_run))

    gap = None
    if args.gap or args.json:
        issues, jira_error = collect_jira()
        gap = reconcile(arcs, issues) if not jira_error else None
        if gap is not None:
            # Which branch is authoritative can depend on which ticket the arc owns, and
            # reconcile is where tickets arrive. Recomputing beats guessing earlier from
            # branch names alone.
            for arc in arcs:
                finalize(arc, args.repo, args.main)
        if gap and args.initiatives:
            i2i, inits = collect_initiatives(issues)
            gap["initiatives"] = inits
            for m in gap["status_mismatch"]:
                m["initiatives"] = [inits.get(k, k) for k in i2i.get(m["issue"]["key"], [])]
            for i in gap["tickets_without_work"]:
                i["initiatives"] = [inits.get(k, k) for k in i2i.get(i["key"], [])]

    if args.gap:
        if jira_error:
            sys.exit(f"work-arcs: {jira_error}")
        print("── real work with no ticket ─────────────────────────────")
        for a in gap["unticketed_work"][:10]:
            print(f"  {a['label']:<28} {a['counts']['branches']}b, "
                  f"{a['counts']['sessions']}sess, {a['engagement']}ref, "
                  f"{a['unpushed']} unpushed, {a['age_days']}d")
            print(f"    └ work-arcs --jira-ify {a['label']}")
        print("\n── Jira says handed off, but the work is still here ─────")
        for m in gap["status_mismatch"][:10]:
            print(f"  {m['issue']['key']:<10} {m['why']}")
            print(f"    └ {m['issue']['summary'][:64]}")
        print("\n── assigned tickets with no branch or session ───────────")
        for i in gap["tickets_without_work"][:12]:
            print(f"  {i['key']:<10} {i['status']:<18} {i['summary'][:44]}")
            if "initiatives" in i:
                print(f"    └ {', '.join(i['initiatives']) or 'no initiative'}"[:76])
        print(f"\n✓ {len(gap['unticketed_work'])} unticketed, "
              f"{len(gap['status_mismatch'])} mismatched, "
              f"{len(gap['tickets_without_work'])} tickets with no work",
              file=sys.stderr)
        return

    stale_overrides = apply_overrides(arcs, load_overrides())
    for s in stale_overrides:
        print(f"⚠ ignoring authoritative={s['branch']} for {s['label']}: {s['why']}",
              file=sys.stderr)

    if args.active is not None:
        arcs = [a for a in arcs if a["age_days"] <= args.active]

    if args.focus is not None:
        # Recency decides eligibility, engagement decides order. Sorting focus by
        # recency alone returned 28 arcs for a two-day window, which is a list of
        # everything git noticed rather than a picture of what you are doing.
        arcs = [a for a in arcs if a["age_days"] <= args.focus]
        arcs.sort(key=lambda a: (-a["engagement"], a["age_days"], -a["at_risk"]))
        arcs = arcs[:args.focus_limit]

    if args.json:
        json.dump({
            "generated": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
            "repo": args.repo.name,
            # The path, separately from the name. `repo` is the label a page prints, and
            # arc-brief was resolving it as a working directory: `git -C ul log` fails from
            # anywhere but the parent of the repo, silently, so 0 of 54 briefs had ever
            # seen a commit subject -- the richest evidence they are given after the
            # prompts. The split pass was unaffected because work-arcs hands it a real path.
            "repo_path": str(args.repo),
            "main": args.main,
            "project_url": project_url(args.repo, mrs),
            "mr_error": mr_error,
            "arc_count": len(arcs),
            "arcs": arcs,
            "unattached_stashes": unattached,
            "stale_overrides": stale_overrides,
            "gap": gap,
        }, sys.stdout, indent=1)
        print()
        return

    if mr_error:
        print(f"⚠ {mr_error}", file=sys.stderr)
    for a in arcs:
        c = a["counts"]
        bits = [f"{c['branches']}b"]
        if c["stashes"]:
            bits.append(f"{c['stashes']}stash")
        if c["mrs"]:
            bits.append(f"{c['mrs']}mr")
        if c["sessions"]:
            bits.append(f"{c['sessions']}sess")
        if a["stacked"]:
            bits.append(f"{a['stacked']}stacked")
        if a["engagement"]:
            bits.append(f"{a['engagement']}ref")
        if a["superseded"]:
            bits.append(f"{a['superseded']}dup")
        risk = f"  {a['unpushed_live']} unpushed" if a["unpushed_live"] else ""
        print(f"{a['age_days']:>4}d  {a['state']:<18} {a['label']:<28} "
              f"{','.join(bits):<28}{risk}")
        for d in a["demands"][:2]:
            print(f"        └ {d['what']}")
    print(f"\n✓ {len(arcs)} arcs from {len(branches)} branches, "
          f"{len(mrs)} MRs; {len(unattached)} stashes attached to no arc",
          file=sys.stderr)


if __name__ == "__main__":
    main()
