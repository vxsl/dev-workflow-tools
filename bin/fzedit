#!/usr/bin/env bash
# fzedit - fzf-based file editor, worktree-aware.
#
# Scope of the listing is a single axis, widest-last, because these sets are strictly
# nested rather than independent toggles:
#
#     conflicts  ⊂  changed  ⊂  worktree  ⊂  home
#
#   TAB    widen one rung        S-TAB  narrow one rung
#   ^G     new tab (a whole separate instance)
#   ^R     browse worktrees on their own, most recent first (r for rr)
#   ^F     search file CONTENTS (ripgrep), landing on the matching line
#   F1     the whole keymap, without leaving the pad
#
# Tabs are tmux windows in the pad session: bare C-x / C-b move left / right,
# matching their keyboard positions, and C-M-w closes one. That needs `prefix None`
# on this session, which sync_tab_chrome sets -- a root-table binding is shadowed by
# the prefix key, so with the default prefix C-b would never reach its binding.
#
# ^R for the rr picker, and refresh pushed out to F5: r is the letter this tool is
# named after, and reaching for the rr key is a hundred times more frequent here than
# reaching for a refresh -- everything that can change the listing already rebuilds it,
# so ^R-as-refresh was only ever for a file that appeared behind the pad's back. Not M-w
# (nor any Alt key): Alt is the WM's mod key, xmonad grabs Alt-w for NSP_slack, and an
# Alt binding is a coin flip on whether the keystroke reaches the terminal at all. ^W is
# left alone deliberately -- it is delete-word in the query, which is worth keeping.
#
#   enter  open file / switch worktree     ^O cursor    ^S tmux window here
#   ^space mark a row    ^E open every marked row in ONE nvim
#   ^A     stage / unstage                 esc clear the query
#   F5     refresh       ^C copy abs path  ^Y copy repo-relative path
#
# Launches on `home`: the pad is a general "open a file" tool first, and starting
# narrow means the file you want is often simply not in the list. S-TAB narrows from
# there. FZEDIT_DEFAULT_RUNG=conflicts|changed|files|home changes it. The rung is
# remembered across fzf's reloads but deliberately NOT across launches -- opening the
# pad and landing in a rung set days ago is just confusing.
#
# Worktrees are first-class rows (⊙, tinted per worktree) inlined into every mode, so switching
# worktree and opening a file are the same gesture: type what you want. They are
# appended after the files so a filename query never surfaces one, while a branch or
# ticket-shaped query (TICKET-1001) does. enter dispatches on the row's type column --
# a ⊙ row re-scopes the picker instead of opening an editor.
#
# Why scoping matters here: this runs in the NSP_fileedit alacritty+tmux scratchpad,
# whose cwd is fixed, so $PWD tells us nothing. Unscoped, `fd ~/` yields ~2.86M files,
# 2.02M of them across 154 sibling worktrees of one repo -- 166k .tsx files for 1080
# unique names, so every search returned the same file over and over. One worktree is
# ~12.6k files. We therefore infer the worktree from the most recently active tmux
# pane outside this session, which is where the actual work is happening, and the home
# rung prunes the OTHER worktrees of that repo (see sibling_exclude_args).
#
# Usage:
#   fzedit              # FZF_PERSIST_MODE env var (default: persist)
#   fzedit --persist    # force persist mode (stays open)
#   fzedit --one-shot   # force one-shot mode (exits after selection)
#   fzedit --keys       # print the keymap and exit
#
# Config:
#   .env                     machine-specific paths; see .env.example
#   ~/.config/fzedit/ignore  extra fd --exclude patterns for the home sweep, seeded
#                            on first run and meant to be edited

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$(type -P "$0" || echo "$0")")")" && pwd)"
source "$SCRIPT_DIR/../lib/fzf-helpers"
# One "which worktree did I last go to" log, shared with rr -- see the header there.
source "$SCRIPT_DIR/../lib/worktree-access.sh"
# One palette and one hash for "which worktree is this", shared with the p10k prompt
# segment, so a checkout is the same colour here and in the prompt -- see the header
# there for why that is worth sharing rather than reimplementing.
source "$SCRIPT_DIR/../lib/worktree-colour.sh"
# And one rule for "this checkout is not on the branch its name promises", so the header
# raises the same alarm the prompt does rather than a second opinion about it.
source "$SCRIPT_DIR/../lib/worktree-mismatch.sh"

SELF_BIN="$(readlink -f "$(type -P "$0" || echo "$0")")"

# Machine-specific paths live in the repo's .env (gitignored); .env.example documents
# them. Nothing here should hardcode a particular checkout.
[ -f "$SCRIPT_DIR/../.env" ] && . "$SCRIPT_DIR/../.env"

HISTORY_FILE="${FZEDIT_HISTORY_FILE:-$HOME/.fzedit_history}"
STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/fzedit"
IGNORE_FILE="${FZEDIT_IGNORE_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/fzedit/ignore}"

# The picker draws as an inset panel rather than filling the pad window.
#
# The window is a scratchpad at 80% of the screen with a 24pt font, and a picker that
# paints all of it reads as an application you are now inside rather than a thing you
# summoned to answer one question. The inset is the whole difference, and it is free
# where it would have cost something: fzf's execute() hands the terminal to the child,
# so nvim, tig and the pager still get the full window. Sizing the WINDOW smaller
# cannot do this -- the editor opens inline in this same tmux window, so a smaller pad
# is a smaller editor too.
#
# Set FZEDIT_MARGIN= (empty) to go back to filling the window.
FZEDIT_MARGIN="${FZEDIT_MARGIN:-1,8%}"
FZEDIT_BORDER="${FZEDIT_BORDER:-rounded}"
FZEDIT_PANEL=()
[ -n "$FZEDIT_MARGIN" ] && FZEDIT_PANEL=(--margin="$FZEDIT_MARGIN" --border="$FZEDIT_BORDER")

# Each tab is an independent instance, so scope and rung are per-instance rather than
# global -- otherwise two tabs fight over one scope file and switching worktree in one
# silently retargets the other. Keyed by tmux pane, which is unique and stable for the
# life of the tab.
INSTANCE="${FZEDIT_INSTANCE:-${TMUX_PANE:-default}}"
INSTANCE="${INSTANCE#%}"
SCOPE_FILE="$STATE_DIR/scope-$INSTANCE"
MODE_FILE="$STATE_DIR/mode-$INSTANCE"
# Set by pin_scope, read and cleared by --switched. A one-shot flag rather than a
# return code because the key bindings that can switch worktree all run us under fzf's
# execute(), which hands the child the terminal and throws its exit status away.
SWITCHED_FILE="$STATE_DIR/switched-$INSTANCE"
PERSIST_MODE="--persist"

mkdir -p "$STATE_DIR"

# Drop state belonging to panes that no longer exist, or the directory grows forever.
prune_dead_instances() {
    local live f id
    [ -n "${TMUX:-}" ] || return 0
    live=$(tmux list-panes -a -F '#{pane_id}' 2>/dev/null | tr -d '%' | tr '\n' ' ') || return 0
    for f in "$STATE_DIR"/scope-* "$STATE_DIR"/mode-* "$STATE_DIR"/switched-*; do
        [ -e "$f" ] || continue
        id="${f##*-}"
        [ "$id" = "default" ] && continue
        case " $live " in *" $id "*) ;; *) rm -f "$f" ;; esac
    done
}
[ ! -f "$HISTORY_FILE" ] && touch "$HISTORY_FILE"

# Our own tmux session, so we don't mistake it for where work is happening, and so
# tabs land in the pad. Overridable mostly so tests don't have to squat on the real
# session name.
SELF_SESSION="${FZEDIT_SESSION:-fileedit}"

# Whose worktrees to offer when we can't infer a repo at all (cold start), and what
# the ⊙ rows name themselves relative to. Set FZEDIT_DEFAULT_REPO in .env; empty
# simply means "no worktree rows until you are somewhere that resolves a repo".
DEFAULT_REPO="${FZEDIT_DEFAULT_REPO:-}"

# Structural exclusions: build output and package trees. Always on, everywhere.
# Deliberately separate from IGNORE_FILE, which is user-editable -- emptying that file
# should not be able to put a million node_modules paths back into every rung.
EXCLUDE_DIRS=(
    -E node_modules -E .git -E dist -E build -E .next -E .cache
    -E target -E vendor -E __pycache__ -E .venv -E venv -E .stack-work
)

# Swept ahead of the rest of $HOME on the home rung, so their files rank above an
# incidental match somewhere else. FZEDIT_PREFERRED_DIRS is a colon-separated list
# prepended to these, for whatever tree you actually work in.
PREFERRED_DIRS=(
    "$HOME/work"
    "$HOME/.config"
    "$HOME/.xmonad"
    "$HOME/bin"
)
if [ -n "${FZEDIT_PREFERRED_DIRS:-}" ]; then
    IFS=':' read -r -a _extra_dirs <<< "$FZEDIT_PREFERRED_DIRS"
    PREFERRED_DIRS=("${_extra_dirs[@]}" "${PREFERRED_DIRS[@]}")
fi

PREFERRED_EXTS=(-e hs -e js -e ts -e tsx -e py -e sh -e md -e yaml -e toml)

# Everything under $HOME that is a file but is never a thing you open in an editor.
# Measured on this machine: ~1.05M of the 2.86M paths a bare `fd ~/` returns, and not
# one of them has ever been the answer to "open a file".
#
# Seeded rather than documented elsewhere, because the noise list is the one thing
# here that is genuinely per-machine, and a file that already exists with comments in
# it gets edited where a README section does not.
DEFAULT_IGNORE='# fzedit ignore -- one fd --exclude pattern per line, "#" starts a comment.
#
# Applied to the $HOME sweep on the `home` rung only. A leading "/" anchors the
# pattern to $HOME; a bare name matches a directory at any depth. Structural
# exclusions (node_modules, .git, dist, build, target, ...) are built into fzedit and
# are NOT listed here, so emptying this file cannot resurrect them.
#
# Package caches and language toolchains. .bun/install alone was 76k paths.
/.bun
/.npm
/.yarn
/.cache
/.rustup
/.cargo
/.pyenv
/.nvm
/.antigen
/.ghcup
/.cabal
/.stack
/.deno
/.local/share
/.local/state
/.local/lib
/.gradle
/.m2
/snap
/go/pkg
# Browser and editor profile data: thousands of files, none of them yours.
/.var
/.mozilla
/.thunderbird
/.cursor
/.vscode-server
/.config/chromium
/.config/chromium-pads
/.config/firefox-pads
/.config/mozilla
/.config/Cursor
/.config/Code
/.config/obsidian
# Claude Code keeps every session transcript and every file snapshot under here.
/.claude/projects
/.claude/file-history
/.claude/plugins
'

seed_ignore_file() {
    [ -e "$IGNORE_FILE" ] && return 0
    mkdir -p "$(dirname "$IGNORE_FILE")" 2>/dev/null || return 0
    printf '%s' "$DEFAULT_IGNORE" > "$IGNORE_FILE" 2>/dev/null
    return 0
}
seed_ignore_file

# ---------------------------------------------------------------------------
# Caching the slow, slow-changing half of a redraw
# ---------------------------------------------------------------------------
#
# TAB felt laggy, and the profile said why. One press costs a --widen (9ms, fine), a
# --generate-list and a --header, and those last two were doing real work every time:
#
#   generate-list  changed 300ms · files 450ms · home 830ms
#   header         250ms   (git status ×2, plus a walk over all 154 worktrees)
#
# so every TAB was half a second to a second of nothing happening. Almost all of it is
# recomputing things that had not changed: the filesystem sweep, the worktree list,
# and "is anything mid-rebase elsewhere".
#
# What is cached is chosen by how fast it goes stale, not by how slow it is:
#
#   the fd sweeps        30s  -- new files on disk are rare, and ^R forces a refresh
#   the worktree rows     5s  -- branches move, but not between two TAB presses
#   in-flight elsewhere   5s  -- ditto
#   history               never cached; it changes on every single enter, and it is
#                               the part that decides what sits at the top
#   changed / conflicts   never cached; they ARE the live git state, and once the
#                               worktree rows above are cached they are cheap anyway
#
# That last split is the important one. Caching the whole listing would mean a file
# you just opened does not move to the top for 30 seconds, and a file you just staged
# keeps its old badge -- so the cache stops at the sweep, and the volatile rows are
# merged in live on every redraw.
cache_key() {
    printf '%s' "$*" | cksum | cut -d' ' -f1
}

# Two tiers, because the two things that go stale go stale for different reasons.
#
#   tier sweep    the fd walk of the filesystem. Only a file being CREATED or DELETED
#                 invalidates it, which editing one does not.
#   tier derived  everything computed on top: the formatted listing, the worktree
#                 rows, the in-flight check. Invalidated by editing, staging,
#                 switching worktree -- i.e. by most keys.
#
# So there are two strengths of refresh. Coming back from the editor rebuilds the
# derived tier and reuses the sweep (~0.3s instead of ~1.0s, and the sweep could not
# have changed by editing a file anyway); ^R rebuilds everything, which is what you
# press when something DID appear on disk behind fzedit's back.
cached() {
    local tier="$1" key="$2" ttl="$3"; shift 3
    local f="$STATE_DIR/cache-$key" age
    local bypass=""
    [ "${FZEDIT_NO_CACHE:-}" = 1 ] && bypass=1
    [ "${FZEDIT_RELIST:-}" = 1 ] && [ "$tier" = derived ] && bypass=1
    if [ -z "$bypass" ] && [ -s "$f" ]; then
        age=$(( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0) ))
        if [ "$age" -ge 0 ] && [ "$age" -lt "$ttl" ]; then
            cat "$f"
            return 0
        fi
    fi
    # Write to a temp and rename, so a concurrent reader never sees a half-built list
    # (fzf fires reloads faster than a sweep of $HOME completes).
    if "$@" > "$f.$$" 2>/dev/null; then
        mv -f "$f.$$" "$f"
    else
        rm -f "$f.$$"
    fi
    cat "$f" 2>/dev/null
}

git_root_of() {
    [ -d "$1" ] || return 1
    git -C "$1" rev-parse --show-toplevel 2>/dev/null
}

# The worktree we're "in": an explicit pin wins, then our own cwd, then the most
# recently active tmux pane elsewhere, then give up and use $HOME.
resolve_scope() {
    local pinned root path
    pinned=$(cat "$SCOPE_FILE" 2>/dev/null)
    if [ -n "$pinned" ] && [ -d "$pinned" ]; then
        echo "$pinned"
        return
    fi
    if root=$(git_root_of "$PWD"); then
        echo "$root"
        return
    fi
    while read -r _ path; do
        if root=$(git_root_of "$path"); then
            echo "$root"
            return
        fi
    done < <(tmux list-panes -a -F '#{window_activity} #{pane_current_path}' \
                 -f "#{!=:#{session_name},$SELF_SESSION}" 2>/dev/null | sort -rn)
    echo "$HOME"
}

# Emit "<type>\t<abspath>\t<display>", type being f(ile) or w(orktree). fzf gets
# --with-nth=3.. so it shows and matches only the display column, while {1}/{2} hand
# us the row type and an unambiguous, shell-quoted real path. The type column is what
# lets enter mean two different things without guessing from the path.
#
# $1 = root to strip from display ("" to just tilde-collapse).
# $2..$4 = the current worktree's root, display name and tint, for the block below.
#
# Every row is styled, including the home rung's ~50k. The whole formatted listing is
# cached (see generate_list), so this runs on a cold build and on the mutating keys,
# not on a redraw -- and the styling is what makes a wall of near-identical paths
# scannable at all, which is the pad's entire job. Both splits and the extension
# lookup are why it is a table and an index() rather than a chain of string compares:
# that shape costs ~60ms over emitting the paths raw, where the old if-ladder cost
# ~100ms and was skipped on `home` for it.
format_lines() {
    awk -F'\t' -v home="$HOME" -v root="$1" \
        -v curroot="$2" -v curname="$3" -v curcol="$4" \
        -v wtbase="${DEFAULT_REPO:+$(dirname "$DEFAULT_REPO")}" '
    # git status two-letter code -> badge
    function badge(xy) {
        if (xy == "")                       return ""
        if (xy ~ /^(U.|.U|AA|DD)$/)         return sprintf("\033[1;38;5;196m%-3s\033[0m", "!!")
        if (xy == "??")                     return sprintf("\033[38;5;244m%-3s\033[0m", "?")
        if (substr(xy,1,1) != " ")          return sprintf("\033[38;5;114m%-3s\033[0m", xy)
        return sprintf("\033[38;5;221m%-3s\033[0m", xy)
    }
    BEGIN {
        DIM = "\033[2m"; OFF = "\033[0m"
        split("hs 141 lhs 141 js 221 jsx 221 ts 221 tsx 221 py 81 sh 114 bash 114" \
              " zsh 114 yaml 173 yml 173 toml 173 json 173 md 250 markdown 250" \
              " txt 250 rs 208 go 86 rb 204", K, " ")
        for (i = 1; i in K; i += 2) TINT[K[i]] = "\033[38;5;" K[i+1] "m"

        # The current checkout gets its block instead of its path prefix: on the home
        # rung ~/work/repos/<worktree>/ is the longest and least informative part of
        # every row that matters most, and it is the same 25 characters every time. The
        # block says the same thing in one glance, in the colour the header and the p10k
        # prompt already use for this checkout, and leaves the row to say which file.
        # Still matchable by worktree name, since the name is in the display text.
        if (curroot != "")
            block = (curcol != "") \
                ? "\033[48;5;" curcol "m\033[30m⊙ " curname OFF " " \
                : "\033[1m⊙ " curname OFF " "
    }
    {
        type = $1
        abs  = $2
        xy   = (NF > 2) ? $3 : ""
        # Only worktree rows carry a 4th column: the xterm colour this checkout is
        # tinted with, the same one the p10k prompt segment uses. Empty for the primary
        # worktree, which is deliberately untinted.
        wcol = (NF > 3) ? $4 : ""

        if (type == "w") {
            # Name a worktree by its path under the worktree parent, not its basename:
            # some are nested (repo.hotfix/return-400-...) and the basename collides.
            name = abs
            if (wtbase != "" && index(name, wtbase "/") == 1) {
                name = substr(name, length(wtbase) + 2)
            } else if (index(name, home) == 1) {
                name = "~" substr(name, length(home) + 1)
            }
            # The label is "<branch> ⟳ <op>", and for most worktrees the branch is
            # already the directory name -- ul.UL-1671 / UL-1671 printed side by side,
            # twice the width to say one thing. Drop the branch when the name implies
            # it and keep whatever is in flight, which the name never says.
            lbl = xy
            opi = index(lbl, " ⟳ ")
            br  = opi ? substr(lbl, 1, opi - 1) : lbl
            if (br != "" && length(name) >= length(br) &&
                substr(name, length(name) - length(br) + 1) == br)
                lbl = opi ? substr(lbl, opi + 1) : ""
            # A filled block, the same one the header and the p10k prompt segment draw,
            # rather than a tinted glyph: on a list this long a foreground tint reads as
            # "some syntax colour" and a block reads as "this is a checkout". No block at
            # all on the primary, which is how it says so everywhere else.
            if (wcol == "")
                printf "%s\t%s\t\033[1m⊙ %s" OFF "%s\n", type, abs, name,
                       (lbl == "" ? "" : "  " DIM lbl OFF)
            else
                printf "%s\t%s\t\033[48;5;%sm\033[30m⊙ %s" OFF "%s\n", type, abs, wcol, name,
                       (lbl == "" ? "" : "  " DIM lbl OFF)
            next
        }

        disp = abs
        pre  = ""
        if (root != "" && index(disp, root "/") == 1) {
            disp = substr(disp, length(root) + 2)
        } else if (curroot != "" && index(disp, curroot "/") == 1) {
            disp = substr(disp, length(curroot) + 2)
            pre  = block
        } else if (index(disp, home) == 1) {
            disp = "~" substr(disp, length(home) + 1)
        }

        # Dim directory, lit basename: the query is nearly always a basename, so the
        # part being matched is the part that should carry the ink.
        n  = split(disp, P, "/")
        fn = P[n]
        m  = split(fn, E, ".")
        printf "%s\t%s\t%s%s%s%s%s%s%s%s\n", type, abs, badge(xy), pre,
               DIM, substr(disp, 1, length(disp) - length(fn)), OFF,
               (m > 1 ? TINT[E[m]] : ""), fn, OFF
    }'
}

# Changed + untracked files. -z avoids git quoting paths with spaces; renames emit a
# second NUL-terminated field (the old name) that we have to consume.
list_changed() {
    local root="$1" entry xy path
    while IFS= read -r -d '' entry; do
        xy=${entry:0:2}
        path=${entry:3}
        case "$xy" in
            R*|C*) IFS= read -r -d '' _old ;;
        esac
        [ -f "$root/$path" ] || continue
        printf 'f\t%s\t%s\n' "$root/$path" "$xy"
    done < <(git -C "$root" status --porcelain=v1 -z --untracked-files=all 2>/dev/null)
}

list_conflicts() {
    local root="$1" path
    while IFS= read -r -d '' path; do
        [ -f "$root/$path" ] || continue
        printf 'f\t%s\t%s\n' "$root/$path" "UU"
    done < <(git -C "$root" diff --name-only --diff-filter=U -z 2>/dev/null)
}

# ---------------------------------------------------------------------------
# History: frecency-ranked, and portable between worktrees
# ---------------------------------------------------------------------------
#
# The file is an append-only log of "<epoch>\t<abspath>", aggregated at read time.
# Append-only because recording an open happens on every enter, and re-ranking a file
# there would put a sort on the hot path for no benefit -- the read side has to group
# the duplicates anyway.
#
# Ranked by frecency (z/fasd's weighting), not recency: a file you touch twenty times
# a week should outrank one you opened once yesterday, and a plain tail cannot say
# that. This ordering is what fzf's `index` tiebreak falls back on, so it decides
# which of two equally good fuzzy matches you see first -- not just what the list
# looks like before you type.
#
# Then the rows are REWRITTEN INTO THE CURRENT SCOPE. With 154 worktrees of one repo,
# the history recorded in repo.feature-a is roughly the same twelve files you are
# about to want in repo.feature-b: the absolute paths differ, the repo-relative paths
# do not. So an entry under any sibling worktree scores the same relative path here.
# That is the difference between "recently opened" meaning something and meaning
# nothing at all, ten seconds after you switch worktree.
HISTORY_CAP=2000

record_history() {
    printf '%s\t%s\n' "$(date +%s)" "$1" >> "$HISTORY_FILE"
    # Trimmed amortised, so the common case is a single append.
    local n
    n=$(wc -l < "$HISTORY_FILE" 2>/dev/null || echo 0)
    if [ "$n" -gt $(( HISTORY_CAP + HISTORY_CAP / 2 )) ]; then
        tail -n "$HISTORY_CAP" "$HISTORY_FILE" > "$HISTORY_FILE.tmp" \
            && mv "$HISTORY_FILE.tmp" "$HISTORY_FILE"
    fi
}

# Frecent paths, best first, remapped into $1 (a worktree root, or "" for no
# remapping). $2 is a newline-separated list of sibling worktree roots whose paths
# should be rewritten into $1.
history_ranked() {
    local scope="$1" siblings="$2"
    [ -s "$HISTORY_FILE" ] || return 0
    printf '%s\n' "$siblings" | awk -v scope="$scope" -v now="$(date +%s)" '
    # Phase 1 reads the sibling roots (already longest-first, so a nested worktree
    # wins over its parent when both are prefixes of the same path).
    NR == FNR { if ($0 != "") sib[++nsib] = $0; next }
    function remap(p,   i, r, rel) {
        if (scope == "") return p
        for (i = 1; i <= nsib; i++) {
            r = sib[i]
            if (index(p, r "/") == 1) return scope "/" substr(p, length(r) + 2)
        }
        return p
    }
    # z/fasd frecency: a recent hit is worth more, but a hit is still a hit.
    function weight(age) {
        if (age < 3600)   return 4
        if (age < 86400)  return 2
        if (age < 604800) return 0.5
        return 0.25
    }
    {
        # Tolerate the pre-frecency format (a bare path, no timestamp column).
        if (NF >= 2 && $1 ~ /^[0-9]+$/) { ts = $1 + 0; p = $2 }
        else                            { ts = 0;      p = $0 }
        if (p == "") next
        p = remap(p)
        score[p] += weight(now - ts)
        if (ts > last[p]) last[p] = ts
    }
    END { for (p in score) printf "%.4f\t%d\t%s\n", score[p], last[p], p }
    ' FS='\t' - "$HISTORY_FILE" \
      | sort -t$'\t' -k1,1gr -k2,2nr \
      | cut -f3- \
      | while IFS= read -r f; do [ -f "$f" ] && printf '%s\n' "$f"; done
}

# ---------------------------------------------------------------------------
# Listings
# ---------------------------------------------------------------------------

# The sibling worktree roots a history entry may be remapped from, longest first so
# that a nested worktree (repo.nested/deep) wins over its parent.
sibling_roots() {
    local root="$1" wt
    [ "$root" = "$HOME" ] && return 0
    while IFS=$'\t' read -r _ wt; do
        printf '%s\n' "$wt"
    done < <(worktree_dirs "$root") | awk '{ print length, $0 }' | sort -rn | cut -d' ' -f2-
}

# The ignore file, split by how the pattern has to be applied.
#
# A pattern with no "/" is a bare directory name and matches at any depth, so it can
# be handed to every sweep unchanged. A pattern with a "/" is a PATH, anchored at
# $HOME -- and fd anchors leading-"/" patterns to whatever directory it was pointed
# at, so those have to be resolved to absolute paths and re-anchored per search root.
# Same machinery as the sibling worktrees, which is the point: one anchoring rule, in
# one place, rather than a second one to get subtly wrong.
ignore_bare() {
    local line
    [ -f "$IGNORE_FILE" ] || return 0
    while IFS= read -r line; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [ -n "$line" ] || continue
        case "$line" in */*) ;; *) printf '%s\n%s\n' -E "$line" ;; esac
    done < "$IGNORE_FILE"
}

ignore_paths() {
    local line
    [ -f "$IGNORE_FILE" ] || return 0
    while IFS= read -r line; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [ -n "$line" ] || continue
        case "$line" in
            /*)  printf '%s\n' "$HOME$line" ;;
            */*) printf '%s\n' "$HOME/$line" ;;
        esac
    done < "$IGNORE_FILE"
}

# Every worktree of the scope's repo EXCEPT the scope itself.
#
# Pruning these is the single biggest thing the home rung does. They were ~2.02M of
# the 2.86M paths under $HOME, and they are the same ~12.6k repo-relative paths over
# and over: 166k .tsx files for 1080 distinct names. Listing them all did not make
# more files reachable -- it made every filename query return the same file 154 times
# with nothing on the row to tell the copies apart. The gesture for "a file in a
# different worktree" is the ⊙ row: pick the worktree, then the file. Which is exactly
# why worktree rows are inlined into every rung.
#
# Cost: ~154 --exclude patterns, measured at no detectable difference in fd's runtime,
# against 2.86M rows / 637MB / 5.0s becoming ~207k rows / 46MB / 0.15s.
sibling_worktrees() {
    local scope="$1" repo="$scope" wt
    [ "$scope" = "$HOME" ] && repo="${DEFAULT_REPO:-}"
    [ -n "$repo" ] && [ -d "$repo" ] || return 0
    while IFS=$'\t' read -r _ wt; do
        [ "$wt" = "$scope" ] && continue
        printf '%s\n' "$wt"
    done < <(worktree_dirs "$repo")
}

# Those of $1's descendants, as fd --exclude patterns ANCHORED AT $1.
#
# Per search root, not once for $HOME, because fd anchors a leading-"/" pattern to the
# directory it was pointed at. Getting this wrong is silent: the pattern simply never
# matches, and the preferred-dirs sweep quietly puts three quarters of a million
# sibling-worktree paths back into a listing the $HOME sweep had just pruned.
exclude_args_under() {
    local base="$1" wt
    shift
    for wt in "$@"; do
        case "$wt" in "$base"/*) printf '%s\n%s\n' -E "${wt#"$base"}" ;; esac
    done
}

# The filesystem half of the two wide rungs, split out so it can be cached without
# also freezing the history rows that get merged in on top of it.
SWEEP_TTL="${FZEDIT_SWEEP_TTL:-30}"

sweep_files() {
    local root="$1"
    fd . "$root" --type f --follow --hidden --no-ignore-vcs "${EXCLUDE_DIRS[@]}" "${PREFERRED_EXTS[@]}"
    fd . "$root" --type f --follow --hidden --no-ignore-vcs "${EXCLUDE_DIRS[@]}"
}

sweep_home() {
    local scope="$1" dir
    local -a prunable=() bare=() ex=()
    # Everything that has to be pruned by path, in one list, re-anchored per sweep.
    mapfile -t prunable < <(sibling_worktrees "$scope"; ignore_paths)
    mapfile -t bare     < <(ignore_bare)
    # The scope worktree ahead of everything else: it is where the work is, and the
    # $HOME sweep below would otherwise bury it under whatever sorts first.
    if [ "$scope" != "$HOME" ] && [ -d "$scope" ]; then
        fd . "$scope" --type f --follow --hidden --no-ignore-vcs \
            "${EXCLUDE_DIRS[@]}" "${bare[@]}"
    fi
    # These sweeps exist purely for RANKING -- the $HOME pass below finds everything
    # they find. So they have to prune exactly what it prunes, or the ranking pass
    # quietly undoes the pruning.
    for dir in "${PREFERRED_DIRS[@]}"; do
        [ -d "$dir" ] || continue
        mapfile -t ex < <(exclude_args_under "$dir" "${prunable[@]}")
        fd . "$dir" --type f --follow --hidden --no-ignore-vcs \
            "${EXCLUDE_DIRS[@]}" "${bare[@]}" "${ex[@]}" "${PREFERRED_EXTS[@]}"
    done
    # One pass over $HOME, not two. The extra preferred-extensions sweep only
    # reordered results that the full sweep repeats anyway.
    mapfile -t ex < <(exclude_args_under "$HOME" "${prunable[@]}")
    fd . "$HOME" --type f --follow --hidden --no-ignore-vcs \
        "${EXCLUDE_DIRS[@]}" "${bare[@]}" "${ex[@]}"
}

# History first (it's the "recently opened" prior), then the cached sweep, deduped.
list_files() {
    local root="$1"
    {
        history_ranked "$root" "$(sibling_roots "$root")" | while IFS= read -r f; do
            case "$f" in "$root"/*) printf '%s\n' "$f" ;; esac
        done
        cached sweep "files-$(cache_key "$root")" "$SWEEP_TTL" sweep_files "$root"
    } | awk '!seen[$0]++ { print "f\t" $0 }'
}

list_home() {
    local scope="$1"
    {
        history_ranked "$scope" "$(sibling_roots "$scope")"
        cached sweep "home-$(cache_key "$scope")" "$SWEEP_TTL" sweep_home "$scope"
    } | awk '!seen[$0]++ { print "f\t" $0 }'
}

# "<gitdir>\t<worktree path>" for every worktree of the scope repo, primary first.
# Reads the per-worktree gitdir pointers directly rather than shelling out to git once
# per worktree -- there are 154 of them, so that would be seconds.
worktree_dirs() {
    local root="$1" common d gd wt
    common=$(git -C "$root" rev-parse --git-common-dir 2>/dev/null) || return
    case "$common" in /*) ;; *) common="$(cd "$root" && cd "$(dirname "$common")" && pwd)/$(basename "$common")" ;; esac
    wt=$(dirname "$common")
    [ -d "$wt" ] && printf '%s\t%s\n' "$common" "$wt"
    for d in "$common"/worktrees/*/; do
        [ -f "$d/gitdir" ] || continue
        gd=$(cat "$d/gitdir" 2>/dev/null) || continue
        wt=$(dirname "$gd")
        [ -d "$wt" ] || continue
        printf '%s\t%s\n' "${d%/}" "$wt"
    done
}

# Cheap test for "git has something half-finished here", so the caller can skip the
# work below for the overwhelming majority of worktrees that are idle.
wt_in_flight() {
    [ -d "$1/rebase-merge" ] || [ -d "$1/rebase-apply" ] || [ -f "$1/MERGE_HEAD" ] \
        || [ -f "$1/CHERRY_PICK_HEAD" ] || [ -f "$1/REVERT_HEAD" ] || [ -f "$1/BISECT_LOG" ]
}
# Describe a worktree from its gitdir, into WT_BRANCH / WT_OP / WT_LABEL / WT_KEY.
#
# Sets globals rather than printing because this runs once per worktree and there are
# ~154 of them: a command substitution per call costs more than the rest of the listing
# put together. Everything here is a builtin -- `read <file`, no cat, no fork.
#
# A worktree mid-rebase has a bare SHA in HEAD rather than a ref, and printing all 40
# characters of it just pushes the useful part off the row. Worse, the branch name
# vanishes from the row entirely -- exactly when you are most likely to be hunting for
# that worktree, and a branch-shaped query ("smp-") then fails to match it at all. So
# prefer the branch git parked in rebase-{merge,apply}/head-name, and say what is in
# flight: "smp-selected-state ⟳ rebase 2/6", not "detached a41d6b62".
read_wt_state() {
    local gd="$1" head n="" end=""
    WT_BRANCH=""; WT_OP=""; WT_LABEL=""; WT_KEY=""
    # The colour key: git's own name for this worktree, i.e. the directory under
    # .git/worktrees. Set before the HEAD read so a worktree we cannot describe is still
    # tinted. The primary worktree's gitdir is the common dir itself and has no such
    # name, so it gets no key and no tint -- see lib/worktree-colour.sh.
    case "$gd" in */worktrees/*) WT_KEY="${gd##*/}" ;; esac
    read -r head < "$gd/HEAD" 2>/dev/null || return 1

    if wt_in_flight "$gd"; then
        if [ -d "$gd/rebase-merge" ]; then
            read -r WT_BRANCH < "$gd/rebase-merge/head-name" 2>/dev/null
            read -r n         < "$gd/rebase-merge/msgnum"    2>/dev/null
            read -r end       < "$gd/rebase-merge/end"       2>/dev/null
            WT_OP="rebase"
            [ -n "$n" ] && [ -n "$end" ] && WT_OP="rebase $n/$end"
        elif [ -d "$gd/rebase-apply" ]; then
            read -r WT_BRANCH < "$gd/rebase-apply/head-name" 2>/dev/null
            read -r n         < "$gd/rebase-apply/next"      2>/dev/null
            read -r end       < "$gd/rebase-apply/last"      2>/dev/null
            WT_OP="rebase"
            [ -n "$n" ] && [ -n "$end" ] && WT_OP="rebase $n/$end"
        elif [ -f "$gd/MERGE_HEAD" ];       then WT_OP="merging"
        elif [ -f "$gd/CHERRY_PICK_HEAD" ]; then WT_OP="cherry-pick"
        elif [ -f "$gd/REVERT_HEAD" ];      then WT_OP="revert"
        else                                     WT_OP="bisect"
        fi
        WT_BRANCH="${WT_BRANCH#refs/heads/}"
    fi

    if [ -z "$WT_BRANCH" ]; then
        case "$head" in
            "ref: refs/heads/"*) WT_BRANCH="${head#ref: refs/heads/}" ;;
            *)                   WT_BRANCH="detached ${head:0:8}" ;;
        esac
    fi
    WT_LABEL="$WT_BRANCH${WT_OP:+ ⟳ $WT_OP}"
}

# Worktrees of the scope repo as "<path>\t<label>\t<colour key>", most recently used
# first.
#
# "Recently used" is the shared navigation log that rr writes (and that pin_scope
# below writes too), falling back to the mtime of the worktree's index for one that
# has never been navigated to. It used to be index mtime alone, which is a bad proxy
# twice over: a background `git status` touches the index without you going anywhere,
# and going somewhere to READ code doesn't touch it at all. So fzedit's "most recent"
# and rr's "most recent" disagreed, and neither matched where you had actually been.
list_worktrees() {
    local root="$1" gd wt ts nav
    local -A navtime=()
    while IFS=$'\t' read -r ts wt; do
        [ -n "$wt" ] && navtime["$wt"]="$ts"
    done < <(wta_all)
    while IFS=$'\t' read -r gd wt; do
        nav="${navtime[$wt]:-}"
        if [ -n "$nav" ]; then
            # Ahead of any never-navigated worktree, whatever its index says.
            ts=$(( nav + 10000000000 ))
        else
            ts=$(stat -c %Y "$gd/index" 2>/dev/null || echo 0)
        fi
        read_wt_state "$gd"
        printf '%s\t%s\t%s\t%s\n' "$ts" "$wt" "$WT_LABEL" "$WT_KEY"
    done < <(worktree_dirs "$root") | sort -rn | cut -f2,3,4
}

# Worktrees as pickable rows, for inlining into whatever mode is showing. Appended
# after the files so that a filename query never surfaces one, while a branch or
# ticket-shaped query (TICKET-1001) does.
#
# Cached briefly: this is 154 gitdir reads plus a stat each, ~160ms, and it runs on
# EVERY rung -- it was most of what made even the tiny `changed` rung take 300ms to
# redraw. Branches do not move between two TAB presses.
WT_ROWS_TTL="${FZEDIT_WT_ROWS_TTL:-5}"

list_worktree_rows() {
    local root="$1"
    [ "$root" = "$HOME" ] && root="${DEFAULT_REPO:-}"
    [ -n "$root" ] && [ -d "$root" ] || return
    cached derived "wtrows-$(cache_key "$root")" "$WT_ROWS_TTL" _worktree_rows "$root"
}

# The tint is resolved here, in the one awk pass that already exists, rather than by
# calling into the shell per row: there are ~154 rows and that would be ~154 forks on
# the redraw path everything above works to keep cheap.
_worktree_rows() {
    list_worktrees "$1" | awk -F'\t' "$WTC_AWK"'{ printf "w\t%s\t%s\t%s\n", $1, $2, wtc_colour($3) }'
}

# The rungs, narrowest first. Index into this is the whole mode model.
RUNGS=(conflicts changed files home)

rung_index() {
    local want="$1" i
    for i in "${!RUNGS[@]}"; do
        [ "${RUNGS[$i]}" = "$want" ] && { printf '%s' "$i"; return; }
    done
    printf '%s' -1
}

# Default rung. `home` on purpose: the pad is a general "open a file" tool first, and
# starting narrow means the file you want is often simply not in the list. TAB narrows
# from here (S-TAB/TAB walk the axis in both directions).
#
# Override with FZEDIT_DEFAULT_RUNG=conflicts|changed|files|home to start narrower.
auto_rung() {
    local scope="$1" want="${FZEDIT_DEFAULT_RUNG:-home}"
    [ "$scope" = "$HOME" ] && { printf 'home'; return; }
    case "$want" in
        conflicts|changed|files|home) printf '%s' "$want" ;;
        *)                            printf 'home' ;;
    esac
}

current_rung() {
    local scope="$1" mode
    mode=$(cat "$MODE_FILE" 2>/dev/null)
    [ -z "$mode" ] && mode=$(auto_rung "$scope")
    # Outside a repo only the widest rung means anything.
    [ "$scope" = "$HOME" ] && mode=home
    printf '%s' "$mode"
}

# Move along the axis and clamp; wrapping would make TAB unpredictable.
shift_rung() {
    local delta="$1" scope i
    scope=$(resolve_scope)
    i=$(rung_index "$(current_rung "$scope")")
    i=$((i + delta))
    [ "$i" -lt 0 ] && i=0
    [ "$i" -ge "${#RUNGS[@]}" ] && i=$(( ${#RUNGS[@]} - 1 ))
    printf '%s' "${RUNGS[$i]}" > "$MODE_FILE"
}

build_list() {
    local scope="$1" mode="$2" curname="" curcol=""
    # Worktrees are first-class alongside files: same list, same query, but appended
    # last so they rank below the mode's own rows. enter dispatches on the type
    # column, so selecting one re-scopes instead of opening an editor.
    #
    # Only on the wide rungs, though. `conflicts` and `changed` are counts of THIS
    # checkout's git state, and appending 154 worktrees under a header that reads
    # "conflicts (0)" says the opposite of what it means -- a screen of worktrees where
    # the rung just promised there was nothing. Where the rung is "find me anything",
    # a worktree is one of the things you might be looking for; where it is "show me
    # what is broken here", it is 154 rows of noise. ^R is the switcher either way.
    {
        case "$mode" in
            changed)   list_changed   "$scope" ;;
            conflicts) list_conflicts "$scope" ;;
            files)     list_files     "$scope"; list_worktree_rows "$scope" ;;
            *)         list_home      "$scope"; list_worktree_rows "$scope" ;;
        esac
    } | {
        # The block that replaces the current checkout's path prefix. Resolved once
        # here rather than per row: it is two file reads and a hash, and format_lines
        # is the one pass that must stay cheap.
        if [ "$mode" = home ] && [ "$scope" != "$HOME" ]; then
            curname="${scope##*/}"
            worktree_colour_key "$scope"
            wtc_colour "$WTC_KEY"
            curcol="$WTC_COLOUR"
            format_lines "" "$scope" "$curname" "$curcol"
        else
            format_lines "$([ "$mode" = home ] && echo "" || echo "$scope")"
        fi
    }
}

# The finished, formatted listing is cached too, not just the sweep underneath it.
#
# Even served from a cached sweep, the home rung still had to push 32k rows through a
# dedup pass and a formatting pass on every redraw -- ~0.3s, which is exactly the TAB
# lag this is here to remove. Formatting is a pure function of the sweep, the history
# and the git state, so it is cacheable; what makes it SAFE to cache is that every
# binding which can change any of those three refreshes hard (FZEDIT_NO_CACHE=1) and
# rebuilds from scratch. TAB and S-TAB, which change nothing, are the only things that
# ever read this. So correctness comes from the mutating keys, not from the clock, and
# the TTL is only a backstop against edits made outside the pad entirely.
generate_list() {
    local scope mode
    scope=$(resolve_scope)
    mode=$(current_rung "$scope")
    cached derived "list-$mode-$(cache_key "$scope")" "$SWEEP_TTL" build_list "$scope" "$mode"
}

# Worktrees OTHER than the scope with something half-finished, as "name (rebase 2/6)".
#
# Why the header cares: "conflicts (0)" on a clean worktree is indistinguishable from
# "you are pointed at the wrong worktree", and pointing at the wrong one is easy when
# two branches share a prefix (smp-select vs smp-selected-state). The scope is right
# there in the header, but a near-identical name reads as correct. So name the worktree
# that actually has a rebase going, rather than reporting zero and leaving it at that.
in_flight_elsewhere() {
    local root="$1" gd wt base name entry names=() joined
    # Most recently touched first: with several rebases parked at once, the one you just
    # came from is the one you meant. stat only the few that are actually in flight.
    while IFS=$'\t' read -r _ entry; do
        names+=("$entry")
    done < <(
        while IFS=$'\t' read -r gd wt; do
            # worktree_dirs puts the primary first, so its parent is the directory all
            # the sibling worktrees live in -- what to name them relative to.
            [ -n "$base" ] || base="$(dirname "$wt")/"
            [ "$wt" = "$root" ] && continue
            wt_in_flight "$gd" || continue
            read_wt_state "$gd" || continue
            name=$(wt_display_name "$wt" "$base")
            # Some branch-named worktrees are enormous; a hint is a nudge, not a target.
            [ "${#name}" -gt 32 ] && name="${name:0:31}…"
            printf '%s\t%s ⟳ %s\n' "$(stat -c %Y "$gd/index" 2>/dev/null || echo 0)" \
                "$name" "$WT_OP"
        done < <(worktree_dirs "$root") | sort -rn
    )

    # One name, not a list. Two comma-separated worktree names with their counters in
    # brackets is wider than the scope banner it sits beside, and reads as a report on
    # other people's checkouts; the question it answers is only ever "am I pointed at
    # the wrong one", which the most recently touched candidate answers by itself.
    [ "${#names[@]}" -gt 0 ] || return
    joined="${names[0]}"
    [ "${#names[@]}" -gt 1 ] && joined="$joined +$(( ${#names[@]} - 1 ))"
    printf '%s' "$joined"
}

# Name a worktree the way its row does: relative to where the worktrees live ($2), not
# by basename, since nested ones (repo.hotfix/foo) collide on basename alone.
wt_display_name() {
    local p="$1" base="$2"
    case "$p" in
        "$base"*)  printf '%s' "${p#"$base"}" ;;
        "$HOME"/*) printf '~%s' "${p#"$HOME"}" ;;
        *)         printf '%s' "$p" ;;
    esac
}

# Which worktree you are pointed at, as a filled block -- the same shape the p10k prompt
# segment draws (shell/p10k-worktree.zsh), in the same colour, from the same palette.
#
# A block rather than a tinted glyph because this is the header's one job. The pad is a
# full-screen scratchpad with a fixed cwd, so unlike every other window on the desktop it
# gives you no ambient clue which of ~154 checkouts you are about to edit -- and the rung
# ladder, the counts and the keymap all compete for the same two lines. A solid colour
# block is the one thing on the line you cannot fail to notice.
#
# The bytes are p10k's, on purpose: SGR 48;5;<c> for the background and plain 30 for
# black text (not 38;5;0), which is what the segment actually emits. Matching it means
# the pad and the shell you came from are recognisably the same indicator rather than two
# things that happen to be the same colour.
#
# $1 = the worktree root. Everything else comes off the WT_* globals read_wt_state has
# just set, the way in_flight_elsewhere reads them -- there are four and threading them
# all through positional parameters would buy nothing.
scope_banner() {
    local root="$1" branch="$WT_BRANCH"
    # Separate statement: every word of a `local` is expanded before the builtin assigns
    # any of them, so `name=${root##*/}` on the line above would silently read the OUTER
    # root and come out empty.
    local name="${root##*/}"

    # Nothing half-finished, so the branch means what it says and can be held to the
    # promise in the directory name. Mid-rebase and mid-bisect are skipped for the reason
    # lib/worktree-mismatch.sh gives: an alarm that fires on every rebase gets ignored,
    # and WT_LABEL below already says what is in flight.
    if [ -z "$WT_OP" ]; then
        # read_wt_state renders a detached HEAD as "detached <sha>", which is not a branch
        # and must not be compared to one.
        case "$branch" in "detached "*) branch=HEAD ;; esac
        wtm_check "$name" "$branch"
        if [ -n "$WTM_MISMATCH" ]; then
            wtm_ticket "$WTM_EXPECTED"
            # No branch beside the alarm: the alarm is the branch, said louder.
            printf '\033[48;5;196m\033[38;5;255m⚠ WRONG BRANCH: %s (expected %s)\033[0m' \
                   "$WTM_MISMATCH" "${WTM_TICKET:-$WTM_EXPECTED}"
            return
        fi
    fi

    # The block names the checkout; the branch goes beside it, dimmed, and only when the
    # directory name does not already say it. "⊙ ul.UL-1671  UL-1671" is two thirds of
    # the line spent saying one thing, and it is the common case -- the branch is worth
    # the width exactly when it is a surprise (a hotfix parked in a slack-* checkout),
    # or when it is carrying "⟳ rebase 2/6".
    local side="$WT_LABEL" D=$'\033[2m' O=$'\033[0m'
    case "$name" in *"$WT_BRANCH") side="${WT_OP:+⟳ $WT_OP}" ;; esac
    side="${side:+  $D$side$O}"

    wtc_colour "$WT_KEY"
    if [ -z "$WTC_COLOUR" ]; then
        # The primary checkout, which the prompt gives no segment at all. No block here
        # either, so "no block" keeps meaning "you are on main" in both windows.
        printf '\033[1m⊙ %s\033[0m%s' "$name" "$side"
        return
    fi
    printf '\033[48;5;%sm\033[30m⊙ %s\033[0m%s' "$WTC_COLOUR" "$name" "$side"
}

# Show the whole ladder with the current rung bracketed, so where you are and where
# TAB will take you are both visible without remembering any letters.
header_line() {
    local scope mode label ladder r n
    # $'...' so these are real escape bytes; printf '%s' will not expand \033 for us.
    local ESC_ON=$'\033[1;38;5;221m' ESC_DIM=$'\033[2m' ESC_OFF=$'\033[0m'
    # 208 rather than 214: 214 is in the worktree palette, so the "rebase parked
    # elsewhere" hint used to come out the same shade as the block beside it for one
    # checkout in ten -- which is the one situation where the two must not be confused.
    local ESC_WARN=$'\033[38;5;208m'
    scope=$(resolve_scope)
    mode=$(current_rung "$scope")

    if [ "$scope" = "$HOME" ]; then
        label="no worktree detected — searching \$HOME"
    else
        local gd elsewhere
        label="$(basename "$scope")"
        gd=$(git -C "$scope" rev-parse --absolute-git-dir 2>/dev/null)
        if [ -n "$gd" ] && read_wt_state "$gd"; then
            label="$(scope_banner "$scope")"
            # Only on the rungs that count this checkout's git state. There the hint is
            # the answer to a question the rung has just raised -- "conflicts (0), so is
            # it clean or am I in the wrong checkout?" -- and it is the only thing on
            # screen that can answer it. On `files` and `home` the worktree rows are
            # right there in the list carrying their own ⟳, so the same sentence at the
            # top is a second copy competing with the one line that says where you are.
            case "$mode" in
                conflicts|changed)
                    # Same 154-worktree walk as the rows above, and the same reasoning
                    # for caching it: a rebase does not start and finish between two TAB
                    # presses.
                    elsewhere=$(cached derived "inflight-$(cache_key "$scope")" \
                                       "$WT_ROWS_TTL" in_flight_elsewhere "$scope")
                    [ -n "$elsewhere" ] &&
                        label="$label  ${ESC_WARN}⚠ also $elsewhere${ESC_OFF}"
                    ;;
            esac
        fi
    fi

    ladder=""
    for r in "${RUNGS[@]}"; do
        n=$(count_rung "$scope" "$r")
        [ -n "$n" ] && n=" $n"
        if [ "$r" = "$mode" ]; then
            ladder="${ladder} ${ESC_ON}[${r}${n}]${ESC_OFF}"
        else
            ladder="${ladder} ${ESC_DIM}${r}${n}${ESC_OFF}"
        fi
    done

    # No "TAB widen · S-TAB narrow" spelled out: the bracket around the current rung
    # already says the ladder is walkable, F1 says how, and this line is two rows of the
    # list that the list is not getting.
    printf '%s\n%s %s· ^F grep · ^R rr · ^G tab · F1 keys%s\n' \
        "$label" "$ladder" "$ESC_DIM" "$ESC_OFF"
}

# Cheap counts for the header. Bounded work: we only need "how many", and for the two
# wide rungs an exact count would mean walking the tree on every keystroke.
count_rung() {
    local scope="$1" r="$2"
    case "$r" in
        conflicts) printf '(%s)' "$(git -C "$scope" diff --name-only --diff-filter=U 2>/dev/null | wc -l)" ;;
        changed)   printf '(%s)' "$(git -C "$scope" status --porcelain 2>/dev/null | wc -l)" ;;
        *)         printf '' ;;
    esac
}

pin_scope() {
    printf '%s' "$1" > "$SCOPE_FILE"
    : > "$MODE_FILE"
    # The query that found the worktree is nearly never a query about its contents --
    # you type "1633" to get to ul.UL-1633, and then every file in it is filtered by
    # "1633", which matches almost none of them. Switching scope is arriving somewhere
    # new, so the picker should look like it does on arrival. See --switched.
    : > "$SWITCHED_FILE"
    # Into the log rr also reads, so a switch made here shows up as "most recent"
    # over there too, and vice versa.
    wta_record "$1"
}

# Consume the flag pin_scope leaves, printing the actions fzf should run as a result.
#
# fzf's transform() takes the command's stdout as an action list, which is the only way
# a binding can decide at press time whether it is opening a file or arriving in a new
# worktree -- enter is bound once and means both. Printing nothing is a valid empty
# action list, so the file case costs one fork and changes nothing.
took_switch() {
    [ -f "$SWITCHED_FILE" ] || return 0
    rm -f "$SWITCHED_FILE"
    printf 'clear-query'
}

# enter means "open this file" or "switch to this worktree" depending on the row.
open_row() {
    local type="$1" path="$2" line="${3:-}"
    # tig's main view has no %(file); don't try to open the empty string.
    [ -n "$path" ] || return 0
    if [ "$type" = "w" ]; then
        pin_scope "$path"
        return
    fi
    record_history "$(abspath "$path")"
    open_in_editor "$path" "$line"
}

# ^E: every marked row in ONE editor, so the LSP starts once instead of once per file.
# On this monorepo that is the difference between a second and most of a minute when
# you are working through four files of a review.
#
# With nothing marked fzf expands {+2} to the row under the cursor, so this is also
# just "open this file" -- there is no separate empty-selection case to handle.
# Worktree rows are directories, and get dropped rather than opened.
open_many() {
    local f root
    local -a files=()
    for f in "$@"; do
        [ -f "$f" ] && files+=("$(abspath "$f")")
    done
    [ "${#files[@]}" -gt 0 ] || return 0
    for f in "${files[@]}"; do record_history "$f"; done

    if [ -n "${FZEDIT_EDITOR:-}" ]; then
        "$FZEDIT_EDITOR" "${files[@]}"
        return
    fi
    root=$(root_of_file "${files[0]}")
    cd "$root" 2>/dev/null || cd "$(dirname "${files[0]}")" || return
    nvim -- "${files[@]}"
}

# The plain, fast worktree list: just the worktrees of this repo, most recent first.
# Prints the chosen path. Used by ^K, where the question is narrow ("which checkout")
# and rr's whole branch/ticket world would be in the way -- and as the fallback for
# ^T when rr can't run.
choose_worktree() {
    local scope="$1" prompt="${2:-worktree (most recent first) > }"
    list_worktrees "$scope" \
        | awk -F'\t' -v home="$HOME" "$WTC_AWK"'{
              d = $1; sub("^" home, "~", d)
              c = wtc_colour($3)
              # Same block as the ⊙ rows and the prompt, so the plain picker is not the
              # one place in the loop where a worktree loses its colour.
              if (c != "") d = "\033[48;5;" c "m\033[30m" d "\033[0m"
              printf "%s\t%s\t%s\n", $1, d, $2
          }' \
        | "$FZP_FZF" --ansi --delimiter='\t' --with-nth=2.. --height=100% --reverse \
              "${FZEDIT_PANEL[@]}" \
              --prompt="$prompt" \
              --preview='git -C {1} status --short --branch 2>/dev/null | head -40' \
              --preview-window=down:50%:wrap \
        | cut -f1
}

# ^T: rr's picker, not a reimplementation of it.
#
# rr already answers "which worktree" far better than anything worth rebuilding here:
# Jira title and status, MR state, assignee, dirty and pane indicators, branches with
# no worktree yet, and creating one on the spot. It is also already designed to be
# driven this way -- the UI goes to stderr and the answer comes back on stdout as
# "RR_CD:<path>", which is exactly how the zsh wrapper consumes it. So: stdin and
# stderr to the terminal, stdout captured.
#
# It runs with cwd set to the scope worktree because rr resolves its repo from $PWD,
# and the pad's own cwd is fixed and meaningless.
#
# -f (--full) because the pad is a full-screen scratchpad -- rr's default sizing assumes
# it is sharing a terminal with your shell, and here it isn't. Full height, but the same
# inset as the file picker: ^R should land in the box you were already looking at, not
# repaint the whole pad. RR_MARGIN is rr's knob for that, and it is this one.
#
# FZEDIT_NO_RR=1 forces the plain picker, which is also what happens if rr is missing
# or exits without choosing.
RR_BIN="${FZEDIT_RR_BIN:-$SCRIPT_DIR/rr.sh}"
RR_ARGS="${FZEDIT_RR_ARGS:--f}"
export RR_MARGIN="${RR_MARGIN:-$FZEDIT_MARGIN}"
export RR_BORDER="${RR_BORDER:-$FZEDIT_BORDER}"

pick_worktree() {
    local scope choice out
    scope=$(resolve_scope)
    [ "$scope" = "$HOME" ] && scope="${DEFAULT_REPO:-$HOME}"
    [ -d "$scope" ] || return 0

    if [ -z "${FZEDIT_NO_RR:-}" ] && [ -x "$RR_BIN" ] && git -C "$scope" rev-parse --git-dir >/dev/null 2>&1; then
        # shellcheck disable=SC2086 -- RR_ARGS is a deliberate word-split list.
        if { : >/dev/tty; } 2>/dev/null; then
            out=$(cd "$scope" && "$RR_BIN" $RR_ARGS </dev/tty 2>/dev/tty)
        else
            # No controlling terminal (a test, a pipe): rr can't draw, but it can
            # still answer, so take the answer and drop the UI.
            out=$(cd "$scope" && "$RR_BIN" $RR_ARGS 2>/dev/null)
        fi
        choice=$(printf '%s\n' "$out" | grep -m1 'RR_CD:' | sed 's/.*RR_CD://' | tr -d '\r\n')
        # rr can also create a worktree and hand it back, so accept anything that is
        # now a directory rather than only paths that existed when we started.
        if [ -n "$choice" ] && [ -d "$choice" ]; then
            pin_scope "$choice"
        fi
        return 0
    fi

    choice=$(choose_worktree "$scope")
    if [ -n "$choice" ] && [ -d "$choice" ]; then
        pin_scope "$choice"
    fi
}

# ^K: this file, over in a different worktree.
#
# The inverse of a ⊙ row, and in a 154-worktree checkout it is the gesture you want
# more often than the forward one: you have already found the file, and what you
# actually want is the same file on the branch you are about to work on. Switching
# worktree first means finding the file all over again.
carry_file() {
    local path="$1" root rel target
    [ -f "$path" ] || return 0
    path=$(abspath "$path")
    root=$(git_root_of "$(dirname "$path")") || return 0
    rel="${path#"$root"/}"

    target=$(choose_worktree "$root" "open ${rel##*/} in which worktree > ")
    [ -n "$target" ] && [ -d "$target" ] || return 0
    pin_scope "$target"

    if [ -f "$target/$rel" ]; then
        record_history "$target/$rel"
        open_in_editor "$target/$rel"
    else
        # The path doesn't exist on that branch -- a file added since it forked, or
        # renamed. Re-scoping is still the useful half of the gesture, so keep it
        # rather than silently doing nothing, and say why nothing opened.
        printf '\nfzedit: %s does not exist in %s — switched anyway\n' \
            "$rel" "$(basename "$target")" >&2
        sleep 1.5
    fi
}

# ^L: tig, on whatever the row is.
#
# The other half of a hand-off that only went one way. tig's E already opens the file
# under its cursor in a new fzedit tab, on its line (see .tigrc) -- so with this the
# loop closes: find a file here, read how it got that way in tig, jump back into the
# exact line that interests you. Quitting tig drops you back on the picker, the same
# way quitting nvim does.
#
# Dispatches on the row type, like enter does, because the useful view differs:
#   file row  tig -- <path>, this file's history
#   ⊙ row     tig status in that worktree, which is the review view for a whole
#             checkout and the reason to have gone there
# Anything that goes wrong under fzf's execute() is invisible: fzf repaints the moment
# the child exits, so a tig that refuses to start is indistinguishable from a key that
# did nothing -- the screen just flashes. Say what happened and wait to be dismissed.
bail() {
    printf '\033[38;5;214mfzedit: %s\033[0m\n' "$1" >&2
    printf '\033[2mpress any key\033[0m' >&2
    read -rsn1 </dev/tty 2>/dev/null || sleep 1.5
    printf '\n' >&2
    return 0
}

open_tig() {
    local type="$1" path="$2" root rc
    [ -n "$path" ] || return 0
    if [ -n "${FZEDIT_TIG:-}" ]; then
        "$FZEDIT_TIG" "$type" "$path"
        return
    fi
    command -v tig >/dev/null 2>&1 || { bail "tig is not installed"; return 0; }

    if [ "$type" = "w" ]; then
        [ -d "$path" ] || { bail "not a directory: $path"; return 0; }
        ( cd "$path" && tig status ) || rc=$?
        [ -n "${rc:-}" ] && bail "tig status exited $rc in $(basename "$path")"
        return 0
    fi

    [ -f "$path" ] || { bail "not a file: $path"; return 0; }
    path=$(abspath "$path")
    root=$(root_of_file "$path")
    # tig needs a repo, and on the home rung plenty of rows are not in one -- ~/.config
    # files, downloads, notes. That is the most likely reason for a flash.
    git -C "$root" rev-parse --git-dir >/dev/null 2>&1 \
        || { bail "not in a git repository: $(dirname "$path")"; return 0; }

    # Relative to the repo root: tig hands the pathspec to git, and an absolute path
    # is fragile across worktrees that share a common gitdir.
    ( cd "$root" && tig -- "${path#"$root"/}" ) || rc=$?
    [ -n "${rc:-}" ] && bail "tig exited $rc"
    return 0
}

# ---------------------------------------------------------------------------
# Working-tree actions
# ---------------------------------------------------------------------------

# ^A, the half of the source-control sidebar that isn't navigation. A toggle rather
# than two keys: what you want after looking at a diff is to flip this file's
# staged-ness, and which direction that is, is already on the row's badge.
#
# Nothing here discards anything. Reverting a file is one keystroke away in the editor
# (<leader>gR resets the buffer, <leader>gr a single hunk) with the diff in front of
# you, which is the right place to be when you throw work away -- not a fat-fingered
# neighbour of the stage key in a fuzzy finder.
stage_toggle() {
    local path="$1" root rel staged
    [ -f "$path" ] || return 0
    path=$(abspath "$path")
    root=$(git_root_of "$(dirname "$path")") || return 0
    rel="${path#"$root"/}"
    staged=$(git -C "$root" diff --cached --name-only -- "$rel" 2>/dev/null)
    if [ -n "$staged" ]; then
        git -C "$root" restore --staged -- "$rel" 2>/dev/null
    else
        git -C "$root" add -- "$rel" 2>/dev/null
    fi
}

# ---------------------------------------------------------------------------
# Clipboard
# ---------------------------------------------------------------------------
#
# Wayland-aware because the xmonad→Hyprland migration means this has to work on both
# for a while: under Hyprland there is no X selection for xclip to own, so ^C would
# silently do nothing.
copy_text() {
    local text="$1"
    [ -n "$text" ] || return 0
    if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null 2>&1; then
        printf '%s' "$text" | wl-copy >/dev/null 2>&1
    elif command -v xclip >/dev/null 2>&1; then
        printf '%s' "$text" | xclip -selection clipboard -i >/dev/null 2>&1
    fi
}

# ^Y: the path you paste into an import, a review comment or a message -- almost never
# the absolute one, which is what ^C stays for.
rel_of() {
    local f="$1" root
    f=$(abspath "$f")
    root=$(git_root_of "$(dirname "$f")") || { printf '%s' "$f"; return; }
    case "$f" in
        "$root"/*) printf '%s' "${f#"$root"/}" ;;
        *)         printf '%s' "$f" ;;
    esac
}

# ---------------------------------------------------------------------------
# Content search
# ---------------------------------------------------------------------------
#
# The one thing the pad could not do that an IDE could: find a string, not a filename.
# ripgrep re-runs on every keystroke (fzf's --disabled plus change:reload), so the
# query is a real regex against file contents rather than a fuzzy match over a static
# list.
#
# Rows carry the line number in a column of their own, so enter lands the cursor on
# the match instead of at the top of the file. ^E sends the whole result set to nvim's
# quickfix list, which is the "search results panel" equivalent -- :cnext walks them.
#
# --field-match-separator so the split is unambiguous for a path containing a colon,
# and the path/line/column fields are stripped of colour in awk rather than trusted to
# come out plain. `--colors path:none` does NOT make them plain -- rg still brackets
# each field with a reset sequence, and those bytes end up inside {2} and {3}, so the
# preview gets "\033[0m/path/to/file\033[0m" and the relative-path rewrite below never
# matches its own root. Strip explicitly; only the matched text keeps its highlight.
grep_list() {
    local query="$1" root="$2"
    [ -n "$query" ] || return 0
    rg --line-number --column --no-heading --smart-case --hidden --follow \
       --color=always --field-match-separator=$'\t' \
       --glob '!.git' --glob '!node_modules' --glob '!dist' --glob '!build' \
       -- "$query" "$root" 2>/dev/null \
    | awk -F'\t' -v root="$root" -v home="$HOME" '
        function plain(s) { gsub(/\033\[[0-9;]*m/, "", s); return s }
        NF >= 4 {
            abs = plain($1)
            ln  = plain($2)
            if (abs == "" || ln !~ /^[0-9]+$/) next
            text = $4
            for (i = 5; i <= NF; i++) text = text "\t" $i
            disp = abs
            if (index(disp, root "/") == 1)  disp = substr(disp, length(root) + 2)
            else if (index(disp, home) == 1) disp = "~" substr(disp, length(home) + 1)
            # Trim leading indentation, so the match rather than the whitespace is
            # what lands on screen in a deeply nested file.
            sub(/^[ \t]+/, "", text)
            printf "f\t%s\t%s\t\033[2m%s\033[0m\033[38;5;244m:%s:\033[0m %s\n", abs, ln, disp, ln, text
        }'
}

grep_preview() {
    local f="$1" line="${2:-1}" from to
    [ -f "$f" ] || { echo "not a file: $f"; return; }
    case "$line" in ''|*[!0-9]*) line=1 ;; esac
    from=$(( line > 12 ? line - 12 : 1 ))
    to=$(( line + 40 ))
    bat --color=always --style=numbers --highlight-line "$line" \
        --line-range="$from:$to" "$f" 2>/dev/null || sed -n "$from,${to}p" "$f"
}

# Every match for the query as a quickfix file nvim can read with -q: the default
# errorformat already understands "path:line:col: text".
grep_quickfix() {
    local query="$1" root="$2" qf
    [ -n "$query" ] || return 0
    qf="$STATE_DIR/quickfix-$INSTANCE"
    rg --line-number --column --no-heading --smart-case --hidden --follow --color=never \
       --glob '!.git' --glob '!node_modules' --glob '!dist' --glob '!build' \
       -- "$query" "$root" 2>/dev/null | head -5000 > "$qf"
    [ -s "$qf" ] || return 0
    if [ -n "${FZEDIT_EDITOR:-}" ]; then
        "$FZEDIT_EDITOR" "$qf"
        return
    fi
    cd "$root" 2>/dev/null || true
    nvim -q "$qf" +copen
}

grep_mode() {
    local scope selected type path line qscope
    scope=$(resolve_scope)
    qscope=$(printf '%q' "$scope")

    # --disabled: the query belongs to ripgrep, not to fzf. ^F swaps that round,
    # freezing the current result set and fuzzy-filtering it instead -- the two-stage
    # search you want when a common identifier matches four hundred lines.
    selected=$("$FZP_FZF" --ansi --disabled --height=100% --reverse --info=inline \
        "${FZEDIT_PANEL[@]}" \
        --delimiter=$'\t' --with-nth='4..' \
        --prompt="rg [$(basename "$scope")] > " \
        --header=$'^F fuzzy-filter these results · ^E all matches → quickfix · esc back' \
        --bind "start:reload:$SELF_BIN --grep-list {q} $qscope" \
        --bind "change:reload:sleep 0.15; $SELF_BIN --grep-list {q} $qscope || true" \
        --bind "ctrl-f:unbind(change)+change-prompt(filter > )+enable-search+clear-query+first" \
        --bind "ctrl-e:execute($SELF_BIN --grep-qf {q} $qscope < /dev/tty > /dev/tty 2>&1)+abort" \
        --bind 'ctrl-/:toggle-preview' \
        --bind 'ctrl-n:down' --bind 'ctrl-p:up' \
        --bind 'ctrl-d:half-page-down' --bind 'ctrl-u:half-page-up' \
        --bind 'shift-up:preview-up' --bind 'shift-down:preview-down' \
        --preview "$SELF_BIN --grep-preview {2} {3}" \
        --preview-window=down:60%:wrap \
        --tiebreak=begin,index)

    [ -n "$selected" ] || return 0
    IFS=$'\t' read -r type path line _ <<< "$selected"
    [ -n "$path" ] || return 0
    record_history "$path"
    open_in_editor "$path" "$line"
}

# ---------------------------------------------------------------------------
# Preview
# ---------------------------------------------------------------------------

# Preview: a diff is far more useful than file contents for changed/conflicted files,
# and for a conflicted file we want to land on the markers rather than line 1.
preview_row() {
    local type="$1" f="$2" root

    if [ "$type" = "w" ]; then
        local gd
        gd=$(git -C "$f" rev-parse --absolute-git-dir 2>/dev/null)
        # `status --branch` says only "HEAD (no branch)" mid-rebase, so lead with the
        # label that knows better.
        if [ -n "$gd" ] && read_wt_state "$gd"; then
            wtc_colour "$WT_KEY"
            if [ -n "$WTC_COLOUR" ]; then
                printf '\033[48;5;%sm\033[30m⊙ %s\033[0m  \033[2m%s\033[0m\n' \
                       "$WTC_COLOUR" "$f" "$WT_LABEL"
            else
                printf '\033[1m⊙ %s\033[0m  \033[2m%s\033[0m\n' "$f" "$WT_LABEL"
            fi
        else
            printf '\033[1m⊙ %s\033[0m\n' "$f"
        fi
        git -C "$f" status --short --branch 2>/dev/null | head -40
        return
    fi

    [ -f "$f" ] || { echo "not a file: $f"; return; }
    root=$(git_root_of "$(dirname "$f")")

    if [ -n "$root" ] && grep -qm1 '^<<<<<<<' "$f" 2>/dev/null; then
        local line
        line=$(grep -nm1 '^<<<<<<<' "$f" | cut -d: -f1)
        echo -e "\033[1;38;5;196m── conflict at line $line ──\033[0m"
        bat --color=always --style=numbers --highlight-line "$line" \
            --line-range="$(( line > 8 ? line - 8 : 1 )):$(( line + 40 ))" "$f" 2>/dev/null
        return
    fi

    if [ -n "$root" ]; then
        local diff
        diff=$(git -C "$root" diff --no-ext-diff HEAD -- "$f" 2>/dev/null)
        if [ -n "$diff" ]; then
            if command -v delta >/dev/null 2>&1; then
                printf '%s\n' "$diff" | delta --paging=never --width="${FZF_PREVIEW_COLUMNS:-120}"
            else
                printf '%s\n' "$diff"
            fi
            return
        fi
    fi

    bat --color=always --style=numbers --line-range=:200 "$f" 2>/dev/null || cat "$f" 2>/dev/null
}

# ---------------------------------------------------------------------------
# Editor and tabs
# ---------------------------------------------------------------------------

# nvim must be launched with cwd == the repo root, not the scratchpad's fixed cwd:
# git-conflict.nvim only activates when getcwd()/.git exists, and the eslint LSP and
# diffview both resolve their root from cwd too.
root_of_file() {
    local d
    d=$(dirname "$1")
    git_root_of "$d" || printf '%s' "$d"
}

abspath() {
    case "$1" in
        /*) printf '%s' "$1" ;;
        *)  printf '%s/%s' "$(cd "$(dirname "$1")" 2>/dev/null && pwd)" "$(basename "$1")" ;;
    esac
}

# Raising the pad.
#
# Which key summons the pad is the window manager's business, not fzedit's, and fzedit
# does not define it. What fzedit needs is narrower: when tig hands a file over, the
# pad has to come to the FRONT, or the new tab is silently queued behind a hidden
# window. That is a request to the WM, and each WM takes it differently:
#
#   Hyprland  pad.sh toggle <name> -- a real command, which is the right shape.
#   xmonad    this xmonad has no ServerMode/xmonadctl, so there is no command to
#             call and the only channel available is to synthesise the keystroke the
#             user has bound. FZEDIT_PAD_KEY says which one that is; it is a mirror
#             of the WM's config, not a decision taken here, and nothing else in
#             fzedit refers to it. Set it in .env if you rebind the pad.
#
# Either way the request is a TOGGLE, so visibility is checked first -- otherwise a
# hand-off from tig would *hide* a pad that was already up.
#
# Both backends are here because the xmonad→Hyprland migration is in progress and this
# script has to keep working under whichever session is booted.
#
# FZEDIT_NO_PAD exists so the test suite can never poke the real desktop.
PAD_CLASS="${FZEDIT_PAD_CLASS:-NSP_fileedit}"
PAD_KEY="${FZEDIT_PAD_KEY:-ctrl+alt+space}"
HYPR_PAD="${FZEDIT_HYPR_PAD:-$HOME/.config/hypr/scripts/pad.sh}"

on_hyprland() {
    [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && [ -x "$HYPR_PAD" ]
}

pad_visible() {
    if on_hyprland; then
        # Dismissed pads are parked on special:padhidden rather than closed, so
        # "does a window exist" is not the question -- "is it somewhere you can see"
        # is.
        hyprctl clients -j 2>/dev/null \
            | jq -e --arg c "$PAD_CLASS" \
                'any(.[]; (.class == $c or .initialClass == $c)
                          and (.workspace.name // "") != "special:padhidden")' >/dev/null 2>&1
        return $?
    fi
    [ -n "$(xdotool search --onlyvisible --class "$PAD_CLASS" 2>/dev/null)" ]
}

# 0 if we asked the WM to show it, 1 if we couldn't or it was already up.
show_pad() {
    [ -z "${FZEDIT_NO_PAD:-}" ] || return 1
    if on_hyprland; then
        pad_visible && return 1
        "$HYPR_PAD" toggle "$PAD_CLASS" >/dev/null 2>&1 || return 1
        return 0
    fi
    [ -n "${DISPLAY:-}" ] || return 1
    command -v xdotool >/dev/null 2>&1 || return 1
    pad_visible && return 1
    xdotool key --clearmodifiers "$PAD_KEY" 2>/dev/null || return 1
    return 0
}

# Where to put a new tab: the scratchpad session if it exists (so a hand-off from
# elsewhere, e.g. tig, lands in the pad), else whatever session we are in.
editor_session() {
    if tmux has-session -t "$SELF_SESSION" 2>/dev/null; then
        printf '%s' "$SELF_SESSION"
        return 0
    fi
    [ -n "${TMUX:-}" ] && tmux display-message -p '#{session_name}' 2>/dev/null && return 0
    return 1
}

# A tab is one whole fzedit instance -- a tmux window in the pad session -- so the
# editor runs inline inside it. Quitting nvim drops you back on that tab's picker,
# with that tab's own scope and rung intact.
open_in_editor() {
    local path line root
    path=$(abspath "$1")
    line="${2:-}"
    [ "$line" = "0" ] && line=""

    # Test seam: assert dispatch without spawning an editor.
    if [ -n "${FZEDIT_EDITOR:-}" ]; then
        "$FZEDIT_EDITOR" "$path"
        return
    fi

    root=$(root_of_file "$path")
    cd "$root" 2>/dev/null || cd "$(dirname "$path")" || return
    if [ -n "$line" ]; then
        nvim "+$line" -- "$path"
    else
        nvim -- "$path"
    fi
}

# Tab label: the worktree name, so the tmux status line reads as a tab bar.
tab_label() {
    local b="${1:-$HOME}"
    b="${b##*/}"
    # printf, not echo/basename: a trailing newline would become a stray dash.
    printf '%s' "$b" | tr -c '[:alnum:]._-' '-'
}

# Keep this window's name in step with its scope, and make sure the tab bar is
# actually visible -- status is off globally in this setup.
#
# One tmux invocation, not fifteen. This runs on every header refresh, i.e. on every
# enter and every TAB, and a tmux client is a process spawn rather than a cheap IPC --
# fifteen of them is most of a redraw's budget spent restating options that were already
# correct. tmux takes a whole command list in one go, with ';' as its own argument.
sync_tab_chrome() {
    local sess scope label cur oth
    local -a t=()
    [ -n "${TMUX:-}" ] || return 0
    scope=$(resolve_scope)
    label=$(tab_label "$scope")

    # Each tab in its own checkout's colour, so the bar answers "which checkouts do I
    # have open" in the vocabulary the rest of the pad already uses: ⊙ means a checkout,
    # the block means the one you are on, a tint means one you are not. Set per WINDOW,
    # which is the only way a tab can carry its own colour -- the formats are session
    # options, the styles are window options, and every tab runs this for itself.
    worktree_colour_key "$scope"
    wtc_colour "$WTC_KEY"
    if [ -n "$WTC_COLOUR" ]; then
        cur="bg=colour$WTC_COLOUR,fg=colour232,bold"
        oth="fg=colour$WTC_COLOUR"
    else
        # The primary checkout, which gets no colour in the prompt or the rows either.
        cur="bg=colour250,fg=colour232,bold"
        oth="fg=colour245"
    fi

    t+=(set-window-option -t "${TMUX_PANE}" automatic-rename off)
    t+=(';' rename-window -t "${TMUX_PANE}" "$label")
    t+=(';' set-window-option -t "${TMUX_PANE}" window-status-current-style "$cur")
    t+=(';' set-window-option -t "${TMUX_PANE}" window-status-style "$oth")

    if sess=$(editor_session); then
        t+=(';' set-option -t "$sess" status on)
        # Tabs above the picker, not below it. They are a tab BAR -- the one thing on
        # screen that says how many fzedits are open and which one this is -- and at the
        # bottom they sit under fzf's prompt and preview, which is where the eye is
        # already busy. Per-session, like the prefix below.
        t+=(';' set-option -t "$sess" status-position top)
        # The bar is bg=white globally, which over the pad is a slab of daylight above a
        # dark window, and it drowns the tab colours. Transparent bar, no clock, no
        # session name: the tabs ARE the bar, and everything they need to say they say
        # in their own colour.
        t+=(';' set-option -t "$sess" status-style 'bg=default,fg=colour244')
        t+=(';' set-option -t "$sess" status-justify left)
        t+=(';' set-option -t "$sess" status-left '')
        t+=(';' set-option -t "$sess" status-right '')
        t+=(';' set-option -t "$sess" window-status-separator '')
        t+=(';' set-option -t "$sess" window-status-format ' ⊙ #W ')
        t+=(';' set-option -t "$sess" window-status-current-format ' ⊙ #W ')
        # A root-table binding is shadowed by the prefix key, so bare C-b/C-x can
        # only reach their bindings if this session has no prefix. Per-session
        # option: every other session keeps C-b as prefix.
        t+=(';' set-option -t "$sess" prefix None)
    fi
    tmux "${t[@]}" 2>/dev/null
    return 0
}

# C-b is "forward through the tabs", and past the last tab forward means a new one.
#
# tmux's next-window wraps, which is the wrong answer twice over: with two tabs it is
# indistinguishable from C-x, and "keep going right until I have the tab I want"
# becomes inexpressible. Opening one instead is what every tabbed thing does.
#
# $1 is the pane, for the same reason close_tab takes one -- run-shell does not
# reliably export TMUX_PANE. The re-exec is how the new tab inherits the scope of the
# tab you asked from: instance state is keyed by pane, so handing FZEDIT_INSTANCE the
# calling pane makes resolve_scope inside --tab read that tab's scope file.
next_tab_or_new() {
    local pane="${1:-${TMUX_PANE:-}}"
    [ -n "${TMUX:-}" ] || return 0
    [ -n "$pane" ] || return 0
    if [ "$(tmux display-message -p -t "$pane" '#{window_end_flag}' 2>/dev/null)" = 1 ]; then
        FZEDIT_INSTANCE="${pane#%}" "$SELF_BIN" --tab
    else
        tmux next-window -t "$pane" 2>/dev/null
    fi
}

# A new tab is a whole new instance with its own scope and rung, seeded via the
# environment. With a file argument it opens straight into it.
open_tab() {
    local target="${1:-}" line="${2:-}" root label sess
    [ "$line" = "0" ] && line=""
    if [ -n "$target" ]; then
        target=$(abspath "$target")
        root=$(root_of_file "$target")
    else
        root=$(resolve_scope)
    fi
    label=$(tab_label "$root")

    if ! sess=$(editor_session); then
        # Not running at all: the pad's key spawns it. Give it a moment to come up.
        if show_pad; then
            local i
            for i in $(seq 1 24); do
                sess=$(editor_session) && break
                sleep 0.25
            done
        fi
        if [ -z "${sess:-}" ]; then
            echo "fzedit: no tmux session available to open a tab in" >&2
            return 1
        fi
    fi
    if [ -n "$target" ]; then
        tmux new-window -t "$sess:" -n "$label" \
            -e "FZEDIT_SCOPE=$root" -e "FZEDIT_OPEN=$target" ${line:+-e "FZEDIT_OPEN_LINE=$line"} \
            "$SELF_BIN" || return 1
    else
        tmux new-window -t "$sess:" -n "$label" -e "FZEDIT_SCOPE=$root" "$SELF_BIN" || return 1
    fi
    tmux set-option -t "$sess" status on 2>/dev/null
    # Bring the pad forward, so a hand-off from tig is visible rather than silently
    # queued behind a hidden window.
    show_pad || true
    return 0
}

# Refuse to close the last tab: that would take the whole pad down with it -- the
# session dies, the scratchpad window closes, and the next summon is a cold start.
#
# $1 is the pane to close, because tmux.conf calls this from `run-shell`, which does
# not reliably export TMUX_PANE the way an interactive shell in the pane does. Falls
# back to TMUX_PANE for a direct call.
close_tab() {
    local pane="${1:-${TMUX_PANE:-}}" sess n
    [ -n "${TMUX:-}" ] || return 0
    [ -n "$pane" ] || return 0
    sess=$(editor_session) || return 0
    n=$(tmux list-windows -t "$sess" 2>/dev/null | wc -l)
    [ "$n" -le 1 ] && return 0
    tmux kill-window -t "$pane" 2>/dev/null
}

# ---------------------------------------------------------------------------
# Help
# ---------------------------------------------------------------------------
#
# On F1 rather than `?`, which is an ordinary character in a fuzzy query and cannot be
# stolen without breaking search. This exists for the same reason which-key is on in
# the editor half: a keymap you cannot recall is a keymap you do not use.
help_text() {
    local B=$'\033[1;38;5;221m' D=$'\033[2m' C=$'\033[38;5;81m' O=$'\033[0m'
    cat <<EOF
${B}fzedit${O} ${D}— the file pad.${O}

${B}scope — the rung ladder${O}   ${D}conflicts ⊂ changed ⊂ files ⊂ home${O}
  ${D}the block above is the worktree you are scoped to, in its own colour — the${O}
  ${D}same block the p10k prompt draws. White on red means that checkout is NOT${O}
  ${D}on the branch its name promises.${O}
  TAB / S-TAB    widen / narrow one rung
  ${C}⊙ rows${O}         switch worktree — type a branch or a ticket id
                 ${D}each checkout has its own colour, the same one the p10k${O}
                 ${D}prompt segment gives it, so it is recognisable on sight${O}
  ^R             the full rr picker: tickets, MR state, dirty flags, and
                 ${D}branches with no worktree yet (it can create one)${O}
  ^K             ${C}this file, over in another worktree${O} — pick the checkout,
                 ${D}land on the same path there. The inverse of a ⊙ row, and${O}
                 ${D}the one you want once you have already found the file.${O}

${B}open${O}
  enter          open the file  ${D}(or switch to the ⊙ worktree)${O}
  ^space         mark a row     ${D}(marks accumulate)${O}
  ^E             open every marked row in ONE nvim ${D}— one LSP start, not N${O}
  ^O             open in cursor
  ^S             new tmux window at this file's repo root

${B}find${O}
  type           fuzzy-match the path
  ^F             ripgrep file CONTENTS; enter lands on the matching line
                 ${D}in grep: ^F freezes the results and fuzzy-filters them,${O}
                 ${D}^E sends every match to nvim's quickfix list (:cn / :cp)${O}
  esc            clear the query
  F5             refresh

${B}git${O}
  ^A             stage / unstage this file ${D}(the badge says which way)${O}
  ^L             tig ${D}— this file's history, or `tig status` on a ⊙ row.${O}
                 ${D}tig's E jumps back here, on the line, so the loop closes.${O}
  ${D}badges: M modified · A added · ?  untracked · !! conflicted${O}
  ${D}discarding is deliberately not here — do it in nvim with the diff in front${O}
  ${D}of you: <leader>gr resets a hunk, <leader>gR the buffer${O}

${B}tabs${O}  ${D}(a tab is a whole fzedit instance, with its own scope and rung)${O}
  ^G             new tab
  ^X / ^B        previous / next tab
  ^M-w           close this tab ${D}(refuses to close the last one)${O}
  ${D}from tig: E opens the file under the cursor in a new tab, on its line${O}

${B}misc${O}
  ^C / ^Y        copy absolute / repo-relative path
  ^/             toggle the preview
  S-up / S-down  scroll the preview
  ^N / ^P        down / up      ${D}(^D / ^U for half a page)${O}
  F5             refresh, ignoring every cache below
  F1             this page

${D}config: .env (paths, FZEDIT_MARGIN) · ~/.config/fzedit/ignore (home-sweep noise)${O}
${D}the fd sweeps are cached ${SWEEP_TTL}s and the worktree list ${WT_ROWS_TTL}s, so TAB is instant;${O}
${D}history, changed and conflicts are never cached and are always live.${O}
EOF
}

show_help() {
    help_text | ${PAGER:-less} -R 2>/dev/null || help_text
}

# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

case "${1:-}" in
    --rootof)        root_of_file "$2"; exit 0 ;;
    --generate-list) generate_list; exit 0 ;;
    --header)        sync_tab_chrome; header_line; exit 0 ;;
    --pick-worktree) pick_worktree; exit 0 ;;
    --preview)       preview_row "$2" "$3"; exit 0 ;;
    --open)          open_row "$2" "$3" "${4:-}"; exit 0 ;;
    --open-many)     shift; open_many "$@"; exit 0 ;;
    --pin)           pin_scope "$(git_root_of "${2:-$PWD}" || abspath "${2:-$PWD}")"; exit 0 ;;
    --switched)      took_switch; exit 0 ;;
    --record)        record_history "$2"; exit 0 ;;
    --widen)         shift_rung 1;  exit 0 ;;
    --narrow)        shift_rung -1; exit 0 ;;
    --stage)         stage_toggle "${2:-}"; exit 0 ;;
    --copy)          copy_text "${2:-}"; exit 0 ;;
    --copy-rel)      [ -n "${2:-}" ] && copy_text "$(rel_of "$2")"; exit 0 ;;
    --carry)         carry_file "${2:-}"; exit 0 ;;
    --tig)           open_tig "${2:-}" "${3:-}"; exit 0 ;;
    --grep)          grep_mode; exit 0 ;;
    --grep-list)     grep_list "${2:-}" "${3:-$(resolve_scope)}"; exit 0 ;;
    --grep-preview)  grep_preview "${2:-}" "${3:-1}"; exit 0 ;;
    --grep-qf)       grep_quickfix "${2:-}" "${3:-$(resolve_scope)}"; exit 0 ;;
    --help-keys)     show_help; exit 0 ;;
    --keys)          help_text; exit 0 ;;
    --pad-status)
        # Report what show_pad WOULD do. Exists so this can be verified without
        # actually poking the WM and disturbing the desktop.
        if [ -n "${FZEDIT_NO_PAD:-}" ]; then echo "disabled (FZEDIT_NO_PAD)"
        elif on_hyprland; then
            if pad_visible; then echo "already-visible (would do nothing)"
            else echo "hidden (would run $HYPR_PAD toggle $PAD_CLASS)"; fi
        elif [ -z "${DISPLAY:-}" ]; then echo "disabled (no DISPLAY)"
        elif ! command -v xdotool >/dev/null 2>&1; then echo "disabled (no xdotool)"
        elif pad_visible; then echo "already-visible (would do nothing)"
        else echo "hidden (would press $PAD_KEY)"
        fi
        exit 0 ;;
    --tab)           open_tab "${2:-}" "${3:-}"; exit $? ;;
    --close-tab)     close_tab "${2:-}"; exit $? ;;
    --next-tab)      next_tab_or_new "${2:-}"; exit $? ;;
esac

while [[ "$#" -gt 0 ]]; do
    case $1 in
        --persist)  PERSIST_MODE="--persist";  shift ;;
        --one-shot) PERSIST_MODE="--one-shot"; shift ;;
        *)
            echo "Unknown option: $1" >&2
            echo "Usage: fzedit [--persist|--one-shot|--keys]" >&2
            exit 1
            ;;
    esac
done

# Seeded by `fzedit --tab`: this instance's scope, and optionally a file to open
# straight away (the tig hand-off lands here).
if [ -n "${FZEDIT_SCOPE:-}" ] && [ -d "$FZEDIT_SCOPE" ]; then
    printf '%s' "$FZEDIT_SCOPE" > "$SCOPE_FILE"
fi
prune_dead_instances
sync_tab_chrome
if [ -n "${FZEDIT_OPEN:-}" ] && [ -f "$FZEDIT_OPEN" ]; then
    record_history "$(abspath "$FZEDIT_OPEN")"
    open_in_editor "$FZEDIT_OPEN" "${FZEDIT_OPEN_LINE:-}"
fi

REFRESH="reload($0 --generate-list)+transform-header($0 --header)"
# ^R is the escape hatch from every TTL above: regenerate, do not serve a cache.
REFRESH_MED="reload(FZEDIT_RELIST=1 $0 --generate-list)+transform-header(FZEDIT_RELIST=1 $0 --header)"
# ^R only: rebuild the filesystem sweep too, for when a file appeared behind us.
REFRESH_HARD="reload(FZEDIT_NO_CACHE=1 $0 --generate-list)+transform-header(FZEDIT_NO_CACHE=1 $0 --header)"
# Chained after every binding that can land you in a different worktree: clears the
# query if it did, and is a no-op if it did not. See took_switch.
SWITCHED="transform($0 --switched)"

# A fresh launch always starts from the auto-chosen rung; the file only exists to
# carry the choice across fzf's reloads within this session.
: > "$MODE_FILE"

generate_list | fzp_run $PERSIST_MODE \
    "${FZEDIT_PANEL[@]}" \
    --delimiter=$'\t' \
    --with-nth='3..' \
    `# fzf-helpers sets --sync, which renders NOTHING until the whole stream ends.` \
    `# The home rung is far smaller than it used to be but is still ~207k rows, and` \
    `# a blank pad reads as a hung tab. Later options win, so this turns it back off.` \
    --no-sync \
    `# These are paths, not arbitrary strings: --scheme=path puts the bonus on the` \
    `# character after a "/", so a query that matches a basename beats the same` \
    `# characters scattered through a long directory prefix.` \
    --scheme=path \
    --multi \
    --prompt="edit > " \
    --header="$(header_line)" \
    --preview="$0 --preview {1} {2}" \
    --preview-window=down:55%:wrap \
    --bind "enter:execute($0 --open {1} {2} < /dev/tty > /dev/tty 2>&1)+$SWITCHED+$REFRESH_MED" \
    --bind "ctrl-e:execute($0 --open-many {+2} < /dev/tty > /dev/tty 2>&1)+deselect-all+$REFRESH_MED" \
    --bind "ctrl-space:toggle+down" \
    --bind "ctrl-o:execute-silent($0 --record {2}; cursor -r {2})" \
    --bind "ctrl-s:execute-silent(tmux new-window -c \"\$($0 --rootof {2})\")" \
    --bind "ctrl-c:execute-silent($0 --copy {2})" \
    --bind "ctrl-y:execute-silent($0 --copy-rel {2})" \
    --bind "ctrl-a:execute-silent($0 --stage {2})+$REFRESH_MED" \
    --bind "ctrl-f:execute($0 --grep < /dev/tty > /dev/tty 2>&1)+$REFRESH_MED" \
    --bind "f5:$REFRESH_HARD" \
    --bind "ctrl-g:execute-silent($0 --tab)" \
    --bind "tab:execute-silent($0 --widen)+$REFRESH" \
    --bind "btab:execute-silent($0 --narrow)+$REFRESH" \
    --bind "ctrl-r:execute($0 --pick-worktree < /dev/tty > /dev/tty 2>&1)+$SWITCHED+$REFRESH_MED" \
    --bind "ctrl-k:execute($0 --carry {2} < /dev/tty > /dev/tty 2>&1)+$SWITCHED+$REFRESH_MED" \
    --bind "ctrl-l:execute($0 --tig {1} {2} < /dev/tty > /dev/tty 2>&1)+$REFRESH_MED" \
    --bind "f1:execute($0 --help-keys < /dev/tty > /dev/tty 2>&1)" \
    --bind "esc:clear-query" \
    --bind "shift-up:preview-up" \
    --bind "shift-down:preview-down" \
    --header-lines=0 \
    --tiebreak=begin,index
