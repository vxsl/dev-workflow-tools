#!/usr/bin/env -S python3 -u
"""
arc-cluster: work out what the arcs actually are, from the files work touched.

Branch names describe the change, not the intent. `mvdb-half-open-bounds` is a good
name for a diff and says nothing about chasing a slow TDAT query, so name-based
grouping split one investigation across nine arcs. What the work touched is a better
signal than what it was called: the sessions behind those branches all read the same
query-path files.

So branches and sessions are both treated as bags of filenames and clustered together.
Nothing is declared, nothing is named by hand, and a session that ran from $HOME joins
the right arc because of what it edited rather than where it was launched.

Clustering went through three algorithms, and the failures are worth keeping. Union-find
over a similarity threshold chains A~B~C~D into one blob: it fused 313 of 378 branches,
because one large refactor branch shares something with nearly everything. Mutual
k-nearest-neighbour fixed the chaining but traded one fault for another -- no global k
could both hold the TDAT investigation together and stop a 45% component forming.

Modularity communities resolve it, because they adapt per neighbourhood instead of
applying one k everywhere: a hub needs proportionally more evidence to pull a neighbour
in. At resolution 3.0 the nine-way TDAT fragmentation becomes one arc while the largest
component is 6% of entities -- both at once, which neither earlier method managed.

Every membership also carries how confident it is, because the residual error has a
shape none of the three algorithms can reach: two tickets that edit the same module are
structurally identical however the weights are set. Rather than tune past that, the
clusterer states where it is guessing -- what evidence holds each branch in its arc, and
how thin that evidence is -- and work-arcs turns the thinnest into questions a person
answers. See membership() and placement_margin(); --score-labels replays this clustering
against the answers already given, which is how a change to any knob above is shown to be
an improvement rather than argued to be one.

Read-only, and deliberately so: this tool and its siblings never write to Jira, Slack,
or a repo. Anything outward-facing happens only when you run it yourself.

  arc-cluster                 the arcs, largest first
  arc-cluster --json          the full graph, with per-branch membership confidence
  arc-cluster --explain NAME  why a branch landed where it did
  arc-cluster --why A B       the chain of evidence joining two branches
  arc-cluster --score-labels  this clustering against the memberships a human ruled on

Reads $XDG_STATE_HOME/work-arcs/turns.jsonl (see arc-backfill) and git. Read-only.
"""

import argparse
import collections
import json
import math
import os
import re
import subprocess
import sys
from pathlib import Path

STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "work-arcs"
LOG = STATE / "turns.jsonl"
SRC = (".rs", ".ts", ".tsx", ".js", ".jsx", ".py", ".sql", ".toml", ".go",
       ".java", ".kt", ".swift", ".c", ".cc", ".cpp", ".h", ".hpp")

# Filenames so common they identify nothing. Kept as a floor for the pathological
# names, but the real ceiling is derived per-run from document frequency -- see HUB_SHARE.
UBIQUITOUS = {"index.ts", "index.tsx", "types.ts", "constants.ts", "utils.ts",
              "mod.rs", "lib.rs", "main.rs", "__init__.py", "index.js"}

# A file held by this share of entities or more contributes nothing. Derived per run so
# it tracks the codebase instead of a list someone has to remember to update.
HUB_SHARE = float(os.environ.get("ARC_HUB_SHARE", "0.10"))

# Distinct files two entities must share before an edge exists between them.
MIN_SHARED = int(os.environ.get("ARC_MIN_SHARED", "2"))

# Similarity floor for "this branch was cut from that one". High enough to dominate the
# file-overlap score, because ancestry is a fact and overlap is an inference.
STACK_SIM = float(os.environ.get("ARC_STACK_SIM", "0.9"))

# Containment: how much of the SMALLER branch's distinctive weight sits inside the larger.
# Cosine is symmetric and divides by both magnitudes, so a small branch wholly inside a big
# one scores low purely because the big one is big -- `smp-selected-state` has 8 of its 10
# files in the UL-1692 family, all of them feature-specific (NeighborhoodsMiniReport,
# neighborhoodsMetricInstanceCatalog), and cosine still called it 0.375 while containment
# calls it 0.973. The engineer identified that pair as one workstream; cosine could not.
#
# Containment alone is dangerous in exactly the way the plan documents: the recharts hotfix
# scores 1.0 against UL-1773 on a single shared file. So it is gated on corroboration --
# strictly more than MIN_SHARED, because a floor this strong should need better evidence
# than an ordinary edge -- and applied only between branches, since it is a claim about one
# branch's changes sitting inside another's.
CONTAIN_AT = float(os.environ.get("ARC_CONTAIN_AT", "0.6"))
CONTAIN_MIN_SHARED = int(os.environ.get("ARC_CONTAIN_MIN_SHARED", "3"))

# A ticket key in a branch name. Hoisted to a constant because two callers now read it:
# label(), which names an arc after the ticket its branches carry, and membership(),
# which never questions a branch whose own name carries that same key.
TICKET_RE = re.compile(r"\b(UB|UL|DE|SBX)-\d{2,5}\b")

# How much of a child's history must be its parent's before the two count as one stack.
# Below this the parent is just the base that happened to be checked out.
STACK_INHERIT = float(os.environ.get("ARC_STACK_INHERIT", "0.5"))


def env_file():
    """Same .env contract as the rest of the repo."""
    f = Path(__file__).resolve().parent.parent / ".env"
    if not f.exists():
        return
    for line in f.read_text().splitlines():
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            k, _, v = line.partition("=")
            os.environ.setdefault(k.strip(), v.strip().strip('"').strip("'"))


def git(repo, *a):
    return subprocess.run(["git", "-C", str(repo), *a],
                          capture_output=True, text=True).stdout


def base(p):
    b = p.rsplit("/", 1)[-1].strip().strip('"\'')
    return b if b.endswith(SRC) and b not in UBIQUITOUS else None


def aliases(repo, names):
    """Branches that are two names for one commit, as (other, first) pairs.

    Stronger evidence than ancestry and it was being thrown away by the corroboration
    rule. `at-timezone-accept-zoned-columns` and `UL-1795` are the same tip, sha
    fd40716f7, with an empty diff between them -- but their change touches a single file,
    so requiring two shared files deleted the only edge they had and each became its own
    arc. One of them carried the merged !10416 and the other therefore reported "pushed,
    no merge request".

    Corroboration exists to stop one incidental shared file inventing a relationship.
    An identical tip is not an inference that needs corroborating; it is the same commit.
    """
    out, first = [], {}
    fmt = "%(objectname)\t%(refname:short)"
    for line in git(repo, "for-each-ref", f"--format={fmt}", "refs/heads").splitlines():
        sha, _, name = line.partition("\t")
        if name not in names:
            continue
        if sha in first:
            out.append((name, first[sha]))
        else:
            first[sha] = name
    return out


def stacking(repo, main, names, branch_files):
    """Which branches were cut from which, as (child, parent) pairs.

    The strongest statement that two branches are the same body of work is that one
    was cut from the other, and until now the clusterer could not see it: it compared
    bags of filenames while work-arcs derived the ancestry separately and kept it to
    itself. Requiring two shared files then split UB-6938-preX away from UB-6939-preX
    -- branches that are literally a stack -- because their overlap was mostly in files
    common enough to be discounted.

    A branch's tip appearing in another's commit list is ancestry, no heuristics. Only
    the nearest ancestor is kept: everything below a stack's tip is an ancestor of it,
    and joining a branch to its whole stack would recreate the chaining that fused 313
    branches into one component.
    """
    tips = {}
    for line in git(repo, "for-each-ref", "--format=%(objectname) %(refname:short)",
                    "refs/heads").splitlines():
        sha, _, n = line.partition(" ")
        if n in names:
            tips[n.strip()] = sha.strip()
    by_sha = collections.defaultdict(list)
    for n, sha in tips.items():
        by_sha[sha].append(n)

    depth, ancestors = {}, {}
    for n in names:
        revs = git(repo, "rev-list", f"{main}..{n}").split()
        depth[n] = len(revs)
        seen = set(revs)
        # A branch sharing a tip is not an ancestor of anything -- it is the same
        # commit under another name, and treating that as a stack makes a cycle.
        ancestors[n] = {o for o in names
                        if o != n and tips.get(o) in seen and tips.get(o) != tips.get(n)}

    # Being cut from a branch is not the same as continuing it. You branch from whatever
    # is checked out, so ancestry alone says where a branch started, not what it is
    # about, and two independent tests are needed to tell those apart.
    #
    # How much of the child IS the parent catches the case where the base is incidental
    # to a branch that is mostly its own work -- `UB-6938-before-squash-for-real` on
    # `dove-incremental-catalog-render`, 3 commits of 16, which dragged the whole
    # adaptive-charts family into the dual-map arc. Real stacks measure 0.53-1.00 there.
    #
    # But that ratio is highest exactly when the child is smallest, so a one-line change
    # committed on top of a large unrelated base scores 0.98 -- maximum confidence,
    # completely wrong. Nine such pairs exist here, `attr-popup` on
    # `UB-6958-before-squash` among them. The ratio cannot see it because it only counts
    # commits; what settles it is whether the child's OWN work touches what the base is
    # about. A continuation revisits its base's files. A change that merely sits on top
    # does not.
    pairs, nearest = [], {}
    for n, anc in ancestors.items():
        if not anc or not depth.get(n):
            continue
        best = max(anc, key=lambda a: depth.get(a, 0))
        # Recorded for every branch with an ancestor, not just the ones that qualify as
        # a stack: what a branch *added* is a fact about it either way, and the caller
        # needs it to stop counting inherited files as evidence of subject.
        nearest[n] = best
        if depth.get(best, 0) / depth[n] < STACK_INHERIT:
            continue
        own = {b for p in git(repo, "diff", "--name-only", f"{best}...{n}").splitlines()
               if (b := base(p))}
        # No own files at all means the child is its parent under another name, which
        # is a stack by any reading.
        if own and not (own & branch_files.get(best, set())):
            continue
        pairs.append((n, best))
    return pairs, nearest


def segment(rows):
    """Cut a session where the work stops overlapping. Yields (files, turn-rows).

    A branch is a unit of work. A session is a unit of conversational continuity -- one
    resumed thread -- which is neither a unit of work nor even a unit of time: measured
    here, 22% of sessions span more than a day, 10% more than a week, and one runs 41
    days. That is exactly why a session cannot be assumed to be about one thing. Coming
    back to a thread across months makes it *more* likely to have changed subject, so
    the cut has to follow the subject rather than any clock.

    Treating the whole thread as one bag lets it weld unrelated arcs together. Traced
    live: branch UL-1634 sat in the adaptive-line-charts arc with no shared ancestry and
    only two catalog files, because its strongest link was a session that had also been
    in UB-6938's files.

    Splitting per turn would fix the bridging by destroying the evidence -- a turn's
    median bag is 3 files, too few to corroborate under MIN_SHARED, so sessions would
    stop contributing at all. Cutting on topic shift instead leaves 70% of sessions
    whole (measured: 114 of 164) and produces 380 segments rather than 986 turns, with
    a p90 bag of 26 files -- still large enough to form real edges.

    A turn that shares no file with the run so far is where the subject changed.
    """
    cur_files, cur_rows = set(), []
    for _, files, row in rows:
        if not files:
            cur_rows.append(row)          # conversation, not a subject change
            continue
        if cur_files and not (cur_files & files):
            yield cur_files, cur_rows
            cur_files, cur_rows = set(files), [row]
        else:
            cur_files |= files
            cur_rows.append(row)
    if cur_files or cur_rows:
        yield cur_files, cur_rows


def load_entities(repo, main, max_files):
    """Branches and sessions, both as bags of filenames."""
    ents = {}

    for name in git(repo, "for-each-ref", "--no-merged", main,
                    "--format=%(refname:short)", "refs/heads").split():
        files = {b for p in git(repo, "diff", "--name-only", f"{main}...{name}").splitlines()
                 if (b := base(p))}
        # A branch touching hundreds of files is a refactor or a merge artefact. It
        # overlaps with everything, so as a cluster member it only creates bridges.
        if 0 < len(files) <= max_files:
            ents[("branch", name)] = files

    if LOG.exists():
        turns = collections.defaultdict(list)
        for line in LOG.open(errors="replace"):
            try:
                r = json.loads(line)
            except json.JSONDecodeError:
                continue
            sid = r.get("session")
            if not sid:
                continue
            files = {cb for b in (r.get("basenames") or []) if (cb := base(b))}
            turns[sid].append((r.get("at") or 0, files, r))

        meta = {}
        for sid, rows in turns.items():
            rows.sort(key=lambda t: t[0])
            for n, (seg_files, seg_rows) in enumerate(segment(rows)):
                name = f"{sid}#{n}"
                m = meta.setdefault(name, {"prompts": [], "branches": set(), "at": 0,
                                           "session": sid})
                for r in seg_rows:
                    if r.get("prompt"):
                        m["prompts"].append(r["prompt"])
                    if r.get("branch"):
                        m["branches"].add(r["branch"])
                    m["at"] = max(m["at"], r.get("at") or 0)
                if 0 < len(seg_files) <= max_files:
                    ents[("session", name)] = seg_files
        load_entities.meta = meta
    else:
        load_entities.meta = {}
    return ents


def attach_sessions(comp, ents, sim):
    """Put each session in the one arc it most resembles, joining nothing.

    Sessions carry the best evidence of what work was *about* -- the prompts are how the
    arc gets named -- so they belong in an arc. They are simply not allowed to decide
    which branches share one, because a thread that wandered would otherwise merge
    everything it wandered across.
    """
    home = {m: root for root, members in comp.items() for m in members}
    out = collections.defaultdict(list, {r: list(ms) for r, ms in comp.items()})
    for key in ents:
        if key[0] != "session":
            continue
        score = collections.defaultdict(float)
        for other, root in home.items():
            s = sim.get((key, other) if key < other else (other, key), 0)
            if s:
                score[root] += s
        if score:
            out[max(score, key=score.get)].append(key)
    return out


def enforce_stacks(comp, stacks, present):
    """Put every branch in the same arc as the stack it was cut from.

    Weighting ancestry heavily is not enough, because modularity is relative: adding
    session segments as entities raised the graph's total edge weight, and at a fixed
    resolution that alone re-split the UB-6938/UB-6939 stack that a strong edge had been
    holding together. Whether two branches are one stack cannot depend on how many
    sessions happened to be logged that week, so ancestry is applied as a constraint
    after the communities are found rather than as a hint the partition may overrule.

    It moves the *branches of a stack*, never their communities. Unioning the two
    communities instead pulled UL-1634 -- which has no ancestors at all -- into the
    adaptive-line-charts arc, because some other pair spanned the two: one ancestry edge
    dragged every unrelated member with it. Relocating only the stack keeps the
    invariant without inventing membership for its neighbours.
    """
    home = {}
    for root, members in comp.items():
        for m in members:
            home[m] = root

    parent = {}
    for child, anc in stacks:
        a, b = ("branch", child), ("branch", anc)
        if a in present and b in present:
            parent[a] = b

    def root_of(x, guard=64):
        seen = {x}
        while x in parent and guard > 0:
            x = parent[x]
            if x in seen:
                break
            seen.add(x)
            guard -= 1
        return x

    # The whole stack lands wherever its base already sits, so a stack is one arc and
    # nothing else moves.
    for child in parent:
        home[child] = home[root_of(child)]

    out = collections.defaultdict(list)
    for member, root in home.items():
        out[root].append(member)
    return out


def cluster(ents, k, min_sim, stacks=()):
    keys = list(ents)
    df = collections.Counter()
    for s in ents.values():
        for f in s:
            df[f] += 1
    N = len(keys)
    idf = {f: math.log(N / (1 + n)) for f, n in df.items()}
    norm = {kk: math.sqrt(sum(idf.get(f, 0) ** 2 for f in ents[kk])) or 1.0 for kk in keys}

    # Invert to file -> entities so pairs are only scored when they share something.
    by_file = collections.defaultdict(list)
    for kk in keys:
        for f in ents[kk]:
            by_file[f].append(kk)

    # A file most of the codebase touches is not evidence of anything, and idf alone
    # does not say so loudly enough: at 441 branches, a file in a third of them still
    # scored ~3% of a unique file's weight rather than 0. That was enough to put
    # UL-1797 in the adaptive-line-charts arc on `useMetric.tsx` alone. The ceiling is
    # derived rather than a hand-kept list of names, so it tracks the codebase.
    hub_at = max(3, int(N * HUB_SHARE))

    sim = collections.defaultdict(float)
    shared = collections.defaultdict(int)
    for f, holders in by_file.items():
        w = idf.get(f, 0) ** 2
        if w <= 0 or len(holders) >= hub_at:
            continue
        for i, a in enumerate(holders):
            for b in holders[i + 1:]:
                pair = (a, b) if a < b else (b, a)
                sim[pair] += w
                shared[pair] += 1

    # One file in common is a coincidence: a drive-by fix, a rebase artefact, or a
    # component two unrelated changes both had to touch. Measured on 441 branches, a
    # recharts-animation hotfix, a workspace-picker redesign and two AOI tickets were
    # one arc because every pair shared exactly ULWorkspacePickerView.tsx and nothing
    # else. Corroboration is the cheap discriminator -- and it is a floor on *count*,
    # not on weight, precisely because a single very rare file can outweigh two
    # ordinary ones and still mean nothing.
    for pair, n in shared.items():
        if n < MIN_SHARED:
            del sim[pair]

    raw = dict(sim)
    for pair in list(sim):
        a, b = pair
        sim[pair] /= (norm[a] * norm[b])

    # Containment, as a floor rather than a contribution -- the same shape as the ancestry
    # floor below, and for the same reason: "this branch's changes are inside that one's" is
    # closer to a fact than to a similarity. It is the asymmetric case cosine cannot see,
    # and it also recovers stacks on its own (UB-6938/UB-6939 score 0.898 here against a
    # cosine of 0.187), which is evidence the measure is picking up real structure rather
    # than being tuned to one example.
    for pair, w in raw.items():
        a, b = pair
        if a[0] != "branch" or b[0] != "branch":
            continue
        if shared[pair] < CONTAIN_MIN_SHARED:
            continue
        small = min(norm[a], norm[b]) ** 2
        if small <= 0:
            continue
        ov = w / small
        if ov >= CONTAIN_AT:
            sim[pair] = max(sim[pair], min(ov, 1.0))

    # Ancestry outranks anything the filenames can say, so it is applied after
    # normalisation and as a floor rather than a contribution: a branch cut from
    # another belongs with it even when the two barely overlap on disk, which is the
    # usual case for the tip of a long stack.
    present = set(keys)
    for child, parent in stacks:
        a, b = ("branch", child), ("branch", parent)
        if a in present and b in present:
            pair = (a, b) if a < b else (b, a)
            sim[pair] = max(sim[pair], STACK_SIM)

    nbrs = collections.defaultdict(list)
    for (a, b), s in sim.items():
        if s >= min_sim:
            nbrs[a].append((s, b))
            nbrs[b].append((s, a))
    top = {kk: {b for _, b in sorted(v, reverse=True)[:k]} for kk, v in nbrs.items()}

    # Mutual kNN: an edge only if each ranks the other. This is what prevents the
    # chain A~B~C~D that fused 313 branches into one component.
    parent = {kk: kk for kk in keys}

    def find(x):
        while parent[x] != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x

    for a, ns in top.items():
        for b in ns:
            if a in top.get(b, ()):
                ra, rb = find(a), find(b)
                if ra != rb:
                    parent[rb] = ra

    comp = collections.defaultdict(list)
    for kk in keys:
        comp[find(kk)].append(kk)
    # df and hub_at travel with the result rather than being recomputed by the caller:
    # they are what decided which files counted as evidence, and a membership explained
    # in terms of a second, separately-derived ceiling would be explaining a different
    # graph from the one that was clustered.
    return comp, sim, idf, keys, df, hub_at


def louvain(keys, sim, resolution, passes=12):
    """Modularity communities, which is what mutual-kNN was approximating badly.

    A global k cannot be right everywhere: the same value that keeps a dense
    refactor-adjacent neighbourhood from fusing also splits a legitimately broad arc.
    Modularity compares each node's edges against what a random graph with the same
    degrees would give, so a hub needs proportionally more evidence to pull a
    neighbour in, and it adapts per neighbourhood instead of per run.

    Resolution tunes granularity: higher splits more. Single-level local moving is
    enough here -- the graph is small and sparse, and full aggregation buys little.
    """
    adj = collections.defaultdict(dict)
    for (a, b), w in sim.items():
        if w <= 0:
            continue
        adj[a][b] = w
        adj[b][a] = w
    deg = {n: sum(d.values()) for n, d in adj.items()}
    m2 = sum(deg.values()) or 1.0            # 2m
    comm = {n: n for n in keys}
    ctot = collections.defaultdict(float)
    for n in keys:
        ctot[comm[n]] += deg.get(n, 0.0)

    for _ in range(passes):
        moved = False
        for n in keys:
            if n not in adj:
                continue
            dn = deg.get(n, 0.0)
            here = comm[n]
            ctot[here] -= dn
            # Weight from n into each candidate community.
            wc = collections.defaultdict(float)
            for nb, w in adj[n].items():
                wc[comm[nb]] += w
            best, gain = here, wc.get(here, 0.0) - resolution * ctot[here] * dn / m2
            for c, w in wc.items():
                g = w - resolution * ctot[c] * dn / m2
                if g > gain:
                    best, gain = c, g
            ctot[best] += dn
            if best != here:
                comm[n] = best
                moved = True
        if not moved:
            break

    out = collections.defaultdict(list)
    for n in keys:
        out[comm[n]].append(n)
    return out, placement_margin(keys, adj, deg, comm, ctot, m2, resolution)


def placement_margin(keys, adj, deg, comm, ctot, m2, resolution):
    """How decisively modularity put each node where it did, in [0, 1].

    Everything else about a membership is evidence the clusterer weighed; this is the
    clusterer's own verdict on how close the call was, which is the one number nothing
    downstream can reconstruct. A node whose community beat the runner-up by a hair was
    placed by a coin-flip over a graph that cannot see intent, and that is exactly the
    membership worth asking a human about. Reading the objective the partition was
    chosen by means the confidence is the algorithm's, not a second opinion invented
    beside it -- a separate heuristic would disagree with the placement it is grading.

    Measured on this corpus (794 entities, 41 multi-branch arcs): the UB-6802 arc holds
    the metadata-geometry family at margin 1.0 and `UL-1852` -- the geo_filter migration,
    a different effort on the same files -- near zero. That is the error the plan says no
    threshold can fix, ranked to the top by the clusterer's own arithmetic.

    Gains are the same expression the local-moving loop maximises. At convergence the
    home gain is the largest, so the difference is non-negative; normalising by it gives
    a share rather than a modularity delta, which is comparable across arcs of any size.
    A runner-up that is not even positive means no alternative community wanted this node
    at all, which is the strongest placement there is.
    """
    out = {}
    for n in keys:
        if n not in adj:
            continue
        dn = deg.get(n, 0.0)
        here = comm[n]
        # Excluding the node from its own community, exactly as the loop does before it
        # compares -- otherwise a node is scored against a community it is inflating.
        ctot[here] -= dn
        wc = collections.defaultdict(float)
        for nb, w in adj[n].items():
            wc[comm[nb]] += w
        gains = {c: w - resolution * ctot[c] * dn / m2 for c, w in wc.items()}
        gains.setdefault(here, -resolution * ctot[here] * dn / m2)
        ctot[here] += dn
        mine = gains.pop(here)
        alt = max(gains.values(), default=0.0)
        out[n] = 0.0 if mine <= 0 else max(0.0, min(1.0, 1.0 - max(0.0, alt) / mine))
    return out


# The most a doubt signal may discount a membership's confidence. Half, so doubt can
# reorder the queue and never fill it: what a membership is worth is decided by its
# evidence, and a signal that could sink solid evidence on its own would be a threshold
# by another name -- which is the tuning the plan calls exhausted.
DOUBT_MAX = float(os.environ.get("ARC_DOUBT_MAX", "0.5"))

# Shared distinctive files at which corroboration stops being the binding constraint.
# MIN_SHARED (2) is the floor an edge must clear to exist at all, so a membership resting
# on exactly 2 is resting on the weakest admissible evidence; by 5 the overlap is a
# module's worth of files and no longer a coincidence.
CORROBORATED_AT = int(os.environ.get("ARC_CORROBORATED_AT", "5"))


def membership(members, ents, idf, df, N, hub_at, sim, margin, stackset, ticket):
    """Per-branch: how this branch is held into this arc, and how confident that is.

    The clustering's residual error has one shape -- two tickets that edit the same module
    are structurally identical -- and the plan calls threshold tuning measured-exhausted
    for it. What is left is a human, and a human is only worth asking where the machine is
    least sure. So rather than tune the placement, publish the doubt: every membership
    carries the evidence that put it there and a score for how thin that evidence is, and
    the thinnest become questions.

    Evidence first, doubt second, and they are not the same kind of thing. Two terms say
    how much there is to stand on, and the membership is worth only the weaker of them:

      corroboration  distinct non-hub files shared with its strongest in-arc neighbour,
                     against MIN_SHARED. This is the evidence the edge exists on at all.
      reach          how many members of the arc it links to at all. A branch hanging off
                     one neighbour is in the arc on one relationship; three is enough to
                     be embedded. Scaled against the arc's size so a two-branch arc, where
                     one link IS every link, is not punished for being small.

    Two more argue against, and they discount rather than floor:

      near-tie       the clusterer's own placement margin -- see placement_margin. A
                     branch modularity placed by a hair was placed by a coin-flip.
      foreign ticket the branch's name carries a ticket key, and it is not the arc's.
                     The split prompt calls this the single most reliable signal for
                     telling two bodies of work apart, and it is precisely the residual
                     error: two tickets editing the same module.

    They discount because both are routinely true of correct memberships. Modularity
    margins are small for every well-connected node at the boundary of two dense arcs,
    and a stack legitimately carries one ticket's commits across branches named for
    another; as floors they buried the thin-evidence cases under boundary artefacts.
    Measured: as a minimum term, near-tie filled the first five questions with branches
    holding 24 and 45 shared files -- memberships nothing was wrong with -- while
    `UL-1852` at two shared files in the UB-6802 arc, the live error this exists to
    catch, sat outside the cap. As a discount, both of those score above the line and
    UL-1852 comes first.

    The discount is bounded at DOUBT_MAX so doubt can halve a membership's confidence and
    never sink it: sinking it is what evidence is for. Only the larger of the two applies
    -- they are two readings of the same worry, and a branch that is both a near-tie and
    foreign-ticketed is not twice as suspicious, it is suspicious for a reason that has
    been noticed twice.

    Never questioned, and short-circuited to 1.0: ancestry- and alias-backed members,
    because a branch cut from another is a fact and not an inference, and members whose
    own name carries the arc's ticket key, because the arc is named after them. work-arcs
    adds two more classes it alone can see -- the authoritative branch and superseded
    copies -- since which branch IS the work depends on merge requests this tool never
    reads.

    Sessions carry no membership question. attach_sessions places them by argmax with no
    floor at all, so they are genuinely the weakest attachment in the system -- but the
    answer to a question is a detachment, and detached.json is a per-branch contract with
    a per-branch expiry. A second store for sessions would be a fork of a contract the
    plan says to reuse, and a session id is not a thing anybody can be asked about in one
    keystroke. Recorded here so the omission is a decision rather than an oversight.
    """
    br = [m for m in members if m[0] == "branch"]
    out = {}
    if len(br) < 2:
        return out                     # a branch alone in an arc has no membership to doubt
    peers = len(br) - 1
    for m in br:
        here, links = [], 0
        for o in br:
            if o == m:
                continue
            s = sim.get((m, o) if m < o else (o, m), 0)
            if not s:
                continue
            links += 1
            # Counted the way cluster() counts it: files at or above the hub ceiling
            # contribute no weight, so they are not corroboration either.
            w = [f for f in (ents[m] & ents[o]) if df[f] < hub_at and idf.get(f, 0) > 0]
            here.append((len(w), s, o, w))
        here.sort(key=lambda t: (-t[0], -t[1], t[2]))
        shared, _, best, files = here[0] if here else (0, 0.0, None, [])
        files = sorted(files, key=lambda f: (-idf.get(f, 0), f))

        anc = any((m, o) in stackset for o in br if o != m)
        mine = TICKET_RE.search(m[1].upper())
        named = bool(ticket) and bool(mine) and mine.group(0) == ticket
        foreign = bool(ticket) and bool(mine) and mine.group(0) != ticket
        # No recorded margin means nothing measured the placement, which is not the same
        # as measuring it and finding it close. --method mknn has no objective to read
        # one off, and a node with no edges at all never reaches the local-moving loop;
        # in both cases the absence is silence, so it contributes no doubt. Reading it as
        # maximum doubt halved every membership in the mknn comparison, which would have
        # made the two methods look different for a reason that was not about either.
        dec = margin.get(m, 1.0)
        corr = max(0.0, min(1.0, (shared - MIN_SHARED + 1)
                            / float(max(1, CORROBORATED_AT - MIN_SHARED + 1))))
        reach = min(1.0, links / float(max(1, min(3, peers))))
        evidence = {"corroboration": round(corr, 3), "reach": round(reach, 3)}
        doubt = {"near_tie": round(1.0 - dec, 3),
                 "foreign_ticket": 1.0 if foreign else 0.0}

        if anc or named:
            score, why = 1.0, ("cut from another branch in this arc" if anc
                               else "its own name carries this arc's ticket")
        else:
            # Ties broken by a fixed order so the reason a membership is questioned is
            # the same on two runs over the same graph.
            why_of = {
                "corroboration": (
                    "it shares no distinctive file with any branch here" if not shared
                    else f"held by {shared} shared file"
                         f"{'' if shared == 1 else 's'}"
                         + (" — the corroboration floor" if shared <= MIN_SHARED else "")),
                "reach": ("it links to nothing else here" if not links
                          else f"it links to {links} of the {peers} other branch"
                               f"{'' if peers == 1 else 'es'} here"),
            }
            key = min(("corroboration", "reach"), key=lambda k: evidence[k])
            base, why = evidence[key], why_of[key]
            worst = max(doubt, key=lambda k: doubt[k])
            score = base * (1.0 - DOUBT_MAX * doubt[worst])
            if doubt[worst] > 0:
                why += ("; and its name is filed under "
                        f"{mine.group(0)}, not {ticket}" if worst == "foreign_ticket"
                        else "; and the clustering placed it here by a hair")
        out[m[1]] = {
            "confidence": round(score, 3),
            "why": why,
            "evidence": evidence,
            "doubt": doubt,
            "with": best[1] if best else None,
            "shared": shared,
            "files": files[:5],
            "links": links,
            "peers": peers,
            "ancestry": anc,
            "named": named,
        }
    return out


def label(members, ents, idf, meta):
    """Name an arc from its own evidence: distinctive files, then prompt words."""
    files = collections.Counter()
    for kind, name in members:
        for f in ents[(kind, name)]:
            files[f] += idf.get(f, 0)
    top_files = [f for f, _ in files.most_common(4)]

    words = collections.Counter()
    for kind, name in members:
        if kind != "session":
            continue
        for p in (meta.get(name, {}).get("prompts") or []):
            for w in re.findall(r"[a-zA-Z][\w-]{4,}", p.lower()):
                words[w] += 1
    stop = {"should","would","could","there","which","where","about","think","because",
            "thing","things","really","actually","instead","though","still","maybe",
            "these","those","after","before","while","claude","please","right","looks",
            "seems","using","based","doesn","didn","files","file","change","changes"}
    top_words = [w for w, _ in words.most_common(30) if w not in stop][:3]

    branches = [n for k, n in members if k == "branch"]
    ticket = next((m.group(0) for n in branches
                   if (m := TICKET_RE.search(n.upper()))), None)
    if ticket:
        return ticket
    if top_words:
        return " ".join(top_words)
    return top_files[0] if top_files else (branches[0] if branches else "?")


LABELS = STATE / "curation-labels.jsonl"


def score_labels(arcs, path=None):
    """This clustering against every membership a human has already ruled on.

    The point of recording the answers, and the answer to the question that started all
    of this: is it worth going on massaging the detection algorithm? That cannot be
    settled by argument, and it has been argued about for three revisions of the plan.
    It can be settled by a number. Every keep and every pry is a labelled example, and a
    proposed change to the weights, the resolution, the hub ceiling or the corroboration
    floor either scores better against them or it does not.

    Both halves are scored, and that is deliberate. Scoring only the prys would reward a
    clusterer that split everything into singletons -- it would agree with every
    correction and be useless. The keeps are what stop that, which is why answering "yes,
    same work" writes a record at all rather than merely silencing a question.

    Agreement is tested against the co-members the answer named, never the label: the
    same referent the stores expire on, for the same reason -- a reworded arc is not a
    regrouped one. A `keep` agrees while most of the company it was recorded with is
    still there; a `pry` agrees while most of it is not. Labels whose branch has since
    left the corpus entirely are unscorable rather than wrong, and are counted apart so a
    deleted branch never reads as a regression.
    """
    path = path or LABELS
    latest = {}
    try:
        with path.open(errors="replace") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    row = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if not isinstance(row, dict) or not row.get("branch"):
                    continue
                # Last answer wins. A question can legitimately be asked again after its
                # pin expires, and a person is allowed to change their mind; scoring both
                # verdicts would score the clusterer against a contradiction.
                latest[row.get("fp") or row["branch"]] = row
    except OSError:
        print(f"arc-cluster: no answers recorded yet ({path})", file=sys.stderr)
        return

    home = {}
    for a in arcs:
        for b in a["branches"]:
            home[b] = a
    agree, disagree, unscorable = [], [], []
    for row in sorted(latest.values(), key=lambda r: (r.get("at") or 0, r["branch"])):
        branch, want = row["branch"], row.get("answer")
        arc = home.get(branch)
        if arc is None:
            unscorable.append((branch, "no longer in the corpus"))
            continue
        recorded = set(row.get("with") or ())
        if not recorded:
            unscorable.append((branch, "the answer recorded no co-members"))
            continue
        current = set(arc["branches"]) - {branch}
        together = len(recorded & current) / len(recorded) >= 0.5
        ok = together if want == "keep" else not together
        (agree if ok else disagree).append((row, arc, together))

    n = len(agree) + len(disagree)
    if not n:
        print(f"arc-cluster: {len(unscorable)} answer(s) recorded, none scorable "
              f"against this clustering")
        return
    print(f"{len(agree)}/{n} agree ({100 * len(agree) / n:.0f}%)"
          + (f", {len(unscorable)} unscorable" if unscorable else ""))
    for row, arc, together in disagree:
        said = ("you said it belongs here" if row.get("answer") == "keep"
                else "you pried it out")
        now = ("still grouped with that work" if together
               else "no longer grouped with that work")
        print(f"  ✗ {row['branch']}  {said}, and it is {now}")
        print(f"      recorded against {row.get('arc', '?')!r}; "
              f"now in {arc.get('label', '?')!r}")
    for branch, why in unscorable:
        print(f"  · {branch} — {why}")


def main():
    env_file()
    p = argparse.ArgumentParser(description="Derive work arcs from files touched.")
    p.add_argument("--repo", type=Path,
                   default=Path(os.environ.get("JIRA_REPO", Path.home() / "work/repos/ul")))
    p.add_argument("--main", default=os.environ.get("WORK_ARCS_MAIN", "origin/main"))
    # Only used by --method mknn, kept for comparison. Measured on 534 entities, no
    # global k got both properties: k=3 killed the blob but split TDAT four ways,
    # k=6 held TDAT together but fused 45% of entities. That is what motivated
    # modularity, which gets both.
    p.add_argument("-k", type=int, default=4, help="neighbours considered (default 4)")
    p.add_argument("--min-sim", type=float, default=0.10)
    p.add_argument("--max-files", type=int, default=150,
                   help="entities touching more than this are bridges, not members")
    p.add_argument("--method", choices=("louvain", "mknn"), default="louvain",
                   help="louvain adapts per neighbourhood; mknn is the earlier "
                        "global-k approximation, kept for comparison")
    # Measured: 1.6 → largest 11%, TDAT across 2. 3.0 → largest 6%, TDAT across 1.
    # 4.0 → largest 5%, but starts shaving genuine members off real arcs.
    # 3.0 was tuned before session segments existed, and segments made Louvain stricter at
    # any fixed resolution -- more total edge weight raises the bar a community must clear.
    # Nobody re-tuned after they landed, and the cost was real: at 3.0 the smp-selected-state
    # family sat in a different arc from the UL-1692 branch carrying its merge request, and
    # the UB-6938/UB-6939 stack came apart. The direction matters more than the number: the
    # split pass can only ever cut an arc, never join two, so a clusterer that separates one
    # workstream creates an error nothing downstream can repair. Recall first; the model cuts.
    p.add_argument("--resolution", type=float, default=2.0,
                   help="louvain granularity; higher splits more (default 2.0)")
    p.add_argument("--json", action="store_true")
    p.add_argument("--explain", metavar="NAME", help="why this branch landed where it did")
    p.add_argument("--why", nargs=2, metavar=("A", "B"),
                   help="the chain of evidence putting A and B in one arc")
    p.add_argument("--score-labels", action="store_true",
                   help="replay this clustering against every membership a human has "
                        "answered, and print where the two disagree")
    args = p.parse_args()

    ents = load_entities(args.repo, args.main, args.max_files)
    meta = load_entities.meta
    # Only modularity has an objective to read a placement margin off. mknn is kept for
    # comparison and answers a different question, so it contributes no near-tie doubt
    # rather than inventing one -- see membership() on why an unmeasured placement is
    # silence and not suspicion.
    margin = {}
    if not ents:
        sys.exit("arc-cluster: nothing to cluster (run arc-backfill first?)")
    branch_names = {n for kind, n in ents if kind == "branch"}
    branch_files = {n: f for (kind, n), f in ents.items() if kind == "branch"}
    stacks, nearest = stacking(args.repo, args.main, branch_names, branch_files)
    # Aliases ride the ancestry machinery: same relation shape, and same need to survive
    # the partition rather than merely influence it.
    stacks = list(stacks) + aliases(args.repo, branch_names)

    # A branch's bag is its diff against main, so a branch cut from another carries its
    # base's whole diff as well as its own. `attr-popup` shares 83 files with the base it
    # sits on and changes exactly one of its own, and file similarity cannot tell those
    # apart -- every stacked branch looks like its base whatever it did. Re-bag each
    # branch that has a real parent with only the work it added; the stack itself is
    # already held together by ancestry, so nothing is lost by no longer counting
    # inherited files as evidence of subject.
    for child, parent in nearest.items():
        key = ("branch", child)
        if key not in ents:
            continue
        own = {b for p in git(args.repo, "diff", "--name-only",
                              f"{parent}...{child}").splitlines() if (b := base(p))}
        if own:
            ents[key] = own
    comp, sim, idf, keys, df, hub_at = cluster(ents, args.k, args.min_sim, stacks)
    if args.method == "louvain":
        # Branches decide the arcs; sessions only join one. A session is a thread of
        # thought and thought drifts: session 8a4dc542 opens on roadMonitoring chart
        # renames, notices a reference-stability problem eight turns later, and ends on
        # the eslint rule that became UL-1634. Every consecutive turn overlaps the last,
        # so segmentation never cuts it, and as one entity it linked UL-1634 to UB-6938
        # across two hops -- the same chaining that fused 313 branches, one level down.
        #
        # That the two came out of one conversation is true and worth keeping. What it
        # is evidence *of* is that one spawned the other, not that they are the same
        # work, so a session may attach to an arc but never merge two.
        bkeys = [k for k in keys if k[0] == "branch"]
        bsim = {(a, b): s for (a, b), s in sim.items()
                if a[0] == "branch" and b[0] == "branch"}
        comp, margin = louvain(bkeys, bsim, args.resolution)
        comp = attach_sessions(comp, ents, sim)
    comp = enforce_stacks(comp, stacks, set(ents))

    # Ancestry and aliases as an undirected lookup, since "is this membership a fact"
    # does not care which of the pair was cut from the other.
    stackset = set()
    for child, anc in stacks:
        a, b = ("branch", child), ("branch", anc)
        stackset.add((a, b))
        stackset.add((b, a))

    arcs = []
    for members in comp.values():
        br = sorted(n for k, n in members if k == "branch")
        # Segments are an internal device for keeping one session's two subjects apart.
        # Everything downstream joins on session id, so they never leave this file.
        se = sorted({n.rsplit("#", 1)[0] for k, n in members if k == "session"})
        if not br and not se:
            continue
        lbl = label(members, ents, idf, meta)
        arcs.append({
            "label": lbl,
            "branches": br,
            "sessions": se,
            "size": len(members),
            # Why each branch is here and how thin that reason is. Emitted always rather
            # than behind a flag: it is derived from the same pass that produced the
            # arcs, costs one dictionary per branch, and a consumer that had to ask for
            # it separately would be re-running the clustering to get it.
            "membership": membership(members, ents, idf, df, len(keys), hub_at, sim,
                                     margin, stackset,
                                     lbl if TICKET_RE.fullmatch(lbl) else None),
        })
    arcs.sort(key=lambda a: (-len(a["branches"]), -len(a["sessions"]), a["label"]))

    if args.explain:
        me = ("branch", args.explain)
        if me not in ents:
            sys.exit(f"arc-cluster: no such branch in scope: {args.explain}")
        pairs = sorted(((s, a if b == me else b) for (a, b), s in sim.items()
                        if me in (a, b)), reverse=True)[:8]
        print(f"{args.explain}: {len(ents[me])} distinctive files")
        for s, other in pairs:
            shared = sorted(ents[me] & ents[other], key=lambda f: -idf.get(f, 0))[:4]
            print(f"  {s:.3f}  {other[0]}:{other[1][:44]}  ← {', '.join(shared)}")
        return

    if args.why:
        a_key, b_key = None, None
        for kind, n in ents:
            if n == args.why[0]:
                a_key = (kind, n)
            if n == args.why[1]:
                b_key = (kind, n)
        if not a_key or not b_key:
            sys.exit(f"arc-cluster: not in scope: "
                     f"{args.why[0] if not a_key else args.why[1]}")

        home = {m: root for root, ms in comp.items() for m in ms}
        if home.get(a_key) != home.get(b_key):
            print(f"{args.why[0]} and {args.why[1]} are in different arcs.")
            return

        # The widest path: of every chain joining the two, the one whose weakest link
        # is strongest. "Why are these together" is answered by that weakest link --
        # it is the single edge that, removed, would separate them along this route.
        adj = collections.defaultdict(list)
        for (x, y), s in sim.items():
            if home.get(x) == home.get(a_key) and home.get(y) == home.get(a_key):
                adj[x].append((s, y))
                adj[y].append((s, x))
        best = {a_key: float("inf")}
        prev, seen = {}, set()
        while True:
            cur = max((k for k in best if k not in seen), key=lambda k: best[k],
                      default=None)
            if cur is None or cur == b_key:
                break
            seen.add(cur)
            for s, nxt in adj.get(cur, ()):
                w = min(best[cur], s)
                if w > best.get(nxt, 0):
                    best[nxt] = w
                    prev[nxt] = cur
        if b_key not in best:
            print(f"{args.why[0]} and {args.why[1]} share an arc but no similarity "
                  f"path — they were joined by an ancestry constraint.")
            return

        chain = [b_key]
        while chain[-1] != a_key:
            chain.append(prev[chain[-1]])
        chain.reverse()
        print(f"{args.why[0]} → {args.why[1]}: {len(chain) - 1} hops, "
              f"weakest link {best[b_key]:.3f}")
        for x, y in zip(chain, chain[1:]):
            s = sim.get((x, y) if x < y else (y, x), 0)
            shared = sorted(ents[x] & ents[y], key=lambda f: -idf.get(f, 0))
            mark = " ←weakest" if abs(s - best[b_key]) < 1e-9 else ""
            print(f"  {s:.3f}  {x[1][:36]:38s} → {y[1][:36]:38s} "
                  f"{len(shared)} shared{mark}")
            print(f"         {', '.join(shared[:5])}")
        return

    if args.score_labels:
        return score_labels(arcs)

    if args.json:
        json.dump({"arcs": arcs, "entities": len(ents)}, sys.stdout, indent=1)
        print()
        return

    multi = [a for a in arcs if a["size"] > 1]
    print(f"{len(ents)} entities → {len(arcs)} arcs "
          f"({len(multi)} with more than one member)")
    for a in arcs[:24]:
        if a["size"] < 2:
            continue
        print(f"\n  {a['label']}  [{len(a['branches'])}b {len(a['sessions'])}s]")
        if a["branches"]:
            print(f"    {', '.join(a['branches'][:6])}"
                  f"{' …' if len(a['branches']) > 6 else ''}")


if __name__ == "__main__":
    main()
