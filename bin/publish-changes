#!/usr/bin/env bash
# Create a GitLab Merge Request with optional Jira integration
#
# Usage:
#   publish-changes                           Interactive MR creation from current branch
#   publish-changes PROJ-1234                 Create MR and link to Jira ticket
#   publish-changes PROJ-1234 PROJ-5678       Link MR to multiple Jira tickets
#   publish-changes --branch feature/foo      Create MR for specific branch
#   publish-changes --target main             Pre-select target branch
#   publish-changes --draft                   Create as draft MR
#   publish-changes --no-jira                 Skip Jira integration even if ticket detected
#   publish-changes --include-ticket-description  Include ticket description in MR description
#   publish-changes --slack-url <url>         Post MR link to the given Slack thread/channel (no prompt)
#   publish-changes --no-autofix              Skip the pre-push hook's prettier/eslint autofix stage
#   publish-changes --no-verify               Skip the pre-push hook entirely (implies --no-autofix)
#
# Features:
#   - Interactive branch selection with fzf
#   - Preview of commits in MR
#   - Auto-push to origin
#   - Clipboard copy of MR URL
#   - Opens MR in browser
#   - Jira integration: adds MR link comment, updates status, sets QA branch
#   - Resumable Slack post: if a run is interrupted at the "paste a Slack URL"
#     prompt, re-running it on the same branch skips straight back to that prompt
#     instead of re-pushing and re-creating an MR that already exists
#
# Requirements:
#   - glab (GitLab CLI)
#   - fzf
#   - jq (for Jira integration)
#   - curl (for Jira integration)
#   - bin/jira-transition (every status move goes through it; this script POSTs
#     no transition of its own)
#
# Environment variables (for Jira integration):
#   JIRA_EMAIL          - Your Jira email
#   JIRA_API_TOKEN      - Jira API token
#   JIRA_DOMAIN         - Jira domain (e.g., company.atlassian.net)
#   JIRA_PROJECT        - Jira project key (e.g., PROJ)
#   JIRA_QA_BRANCH_FIELD - Custom field ID for QA branch (optional, auto-detected)
#   JIRA_QA_BRANCH_DOMAIN - Domain for QA branches (required for QA branch update)
#                           Can be a single domain or array (space/comma-separated)
#                           Multiple domains will show an fzf menu to select
#                           Example: "qa.example.com" or "qa1.example.com,qa2.example.com"

set -e

# Detect if running interactively (has a controlling terminal)
is_interactive() { [ -c /dev/tty ] 2>/dev/null && [ -t 2 ]; }

# Safe read from tty — returns empty string when non-interactive
read_tty() {
    if is_interactive; then
        read "$@" < /dev/tty
    else
        # Set the variable to empty
        local _varname="${@: -1}"
        eval "$_varname=''"
    fi
}

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$(type -P "$0" || echo "$0")")")" && pwd)"
source "$SCRIPT_DIR/../lib/ticket-selection.sh"
source "$SCRIPT_DIR/../lib/slack.sh"

# Load environment from parent directory
if [ -f "$SCRIPT_DIR/../.env" ]; then
    source "$SCRIPT_DIR/../.env"
fi
source "$SCRIPT_DIR/../lib/env-validate.sh"

# Configuration
JIRA_DOMAIN="${JIRA_DOMAIN}"
JIRA_PROJECT="${JIRA_PROJECT}"
CACHE_DIR="$HOME/.cache/jira-fzf"
TICKETS_CACHE="$CACHE_DIR/tickets.json"

MR_CACHE_FILE="$CACHE_DIR/mr_cache.json"

# Arguments
TICKET_KEY=""
EXTRA_TICKET_KEYS=()
SOURCE_BRANCH=""
TARGET_BRANCH=""
IS_DRAFT=""
NO_JIRA=false
SKIP_PUSH=false
OUTPUT_URL=false
NO_DRAFT_PROMPT=false
FORCE_PUSH=false
# --no-autofix: push with SKIP_PRE_PUSH_AUTOFIX=true so the pre-push hook runs its
# checks but doesn't rewrite files and tack on "autofix:" commits.
NO_AUTOFIX=false
# --no-verify: push with git's own --no-verify, so the hook never runs at all.
# Supersedes --no-autofix, and unlike SKIP_PRE_PUSH_CHECKS it doesn't rely on the
# hook cooperating — it covers pre-commit-managed hooks too.
NO_VERIFY=false
INCLUDE_TICKET_DESCRIPTION=false
TICKET_DESCRIPTION=""
MR_TITLE_OVERRIDE=""
MR_DESCRIPTION_OVERRIDE=""
SLACK_URL=""
SLACK_CHANNEL=""
SLACK_THREAD_TS=""
# Set by --ticket-created: the caller (oneshot) created the Jira ticket this run,
# so a late-pasted Slack URL should also get the ticket link, not just the MR.
TICKET_CREATED=false

# Colors
RED='\033[38;5;167m'
GREEN='\033[38;5;114m'
YELLOW='\033[38;5;221m'
BLUE='\033[38;5;81m'
PURPLE='\033[38;5;141m'
CYAN='\033[38;5;109m'
DIM='\033[2m'
UNDERLINE='\033[4m'
RESET='\033[0m'

# Parse arguments
while [[ "$#" -gt 0 ]]; do
    case $1 in
        --branch|-b)
            SOURCE_BRANCH="$2"
            shift 2
            ;;
        --target|-t)
            TARGET_BRANCH="$2"
            shift 2
            ;;
        --draft|-d)
            IS_DRAFT="--draft"
            shift
            ;;
        --no-jira)
            NO_JIRA=true
            shift
            ;;
        --skip-push)
            SKIP_PUSH=true
            shift
            ;;
        --output-url)
            OUTPUT_URL=true
            shift
            ;;
        --no-draft-prompt)
            NO_DRAFT_PROMPT=true
            shift
            ;;
        --no-autofix)
            NO_AUTOFIX=true
            shift
            ;;
        --no-verify)
            NO_VERIFY=true
            shift
            ;;
        --force-push)
            FORCE_PUSH=true
            shift
            ;;
        --include-ticket-description)
            INCLUDE_TICKET_DESCRIPTION=true
            shift
            ;;
        --ticket-description)
            TICKET_DESCRIPTION="$2"
            shift 2
            ;;
        --title)
            MR_TITLE_OVERRIDE="$2"
            shift 2
            ;;
        --description)
            MR_DESCRIPTION_OVERRIDE="$2"
            shift 2
            ;;
        --slack-url)
            SLACK_URL="$2"
            shift 2
            ;;
        --ticket-created)
            TICKET_CREATED=true
            shift
            ;;
        --help|-h)
            # Print the leading comment header — everything between the shebang and
            # the first line of code. No line counts to keep in sync with edits.
            sed -n '2,/^[^#]/{/^[^#]/!p;}' "$0"
            exit 0
            ;;
        *)
            # Check if it looks like a Jira ticket
            if [[ "$1" =~ ^${JIRA_PROJECT_REGEX}-[0-9]+$ ]] || [[ "$1" =~ ^[A-Z]+-[0-9]+$ ]]; then
                if [ -z "$TICKET_KEY" ]; then
                    TICKET_KEY="$1"
                else
                    EXTRA_TICKET_KEYS+=("$1")
                fi
            else
                echo "Unknown argument: $1" >&2
                exit 1
            fi
            shift
            ;;
    esac
done

# Validate env vars (Jira creds not required if --no-jira)
require_env JIRA_DOMAIN JIRA_PROJECT
if [ "$NO_JIRA" != "true" ]; then
    warn_env "Jira integration" JIRA_EMAIL JIRA_API_TOKEN
fi

if [ -n "$ENV_WARNINGS" ]; then
    echo -e "\033[38;5;208m${ENV_WARNINGS}\033[0m" >&2
    echo "" >&2
fi

# Find fzf
if [ -x "$HOME/.zsh/fzf/bin/fzf" ]; then
    FZF="$HOME/.zsh/fzf/bin/fzf"
elif command -v fzf &> /dev/null; then
    FZF="fzf"
else
    echo "Error: fzf not found. Please install fzf first." >&2
    exit 1
fi

# Add vim-style scroll bindings
export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS} --bind 'ctrl-d:half-page-down,ctrl-u:half-page-up'"

# Check required tools
if ! command -v glab &> /dev/null; then
    echo -e "${RED}Error: glab CLI not found${RESET}" >&2
    echo -e "${DIM}Install: https://gitlab.com/gitlab-org/cli${RESET}" >&2
    exit 1
fi

# Verify glab is authenticated
if ! glab auth status >/dev/null 2>&1; then
    echo -e "${RED}Error: glab is not authenticated${RESET}" >&2
    echo -e "${DIM}Run: glab auth login${RESET}" >&2
    echo -e "${DIM}Token needs scopes: api, write_repository${RESET}" >&2
    exit 1
fi

# Ensure we're in a git repo
if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo -e "${RED}Error: Not in a git repository${RESET}" >&2
    exit 1
fi

# Function to open URL in browser
open_url() {
    local url="$1"
    
    # Try to find Firefox window with firefox_scm class using wmctrl
    if command -v wmctrl &> /dev/null; then
        local win_id=$(wmctrl -lx | grep -i "firefox_scm" | head -1 | awk '{print $1}')
        if [ -n "$win_id" ]; then
            wmctrl -i -a "$win_id"
            setsid firefox --new-tab "$url" </dev/null >/dev/null 2>&1 &
            return 0
        fi
    fi
    
    # Fallback to xdg-open (setsid fully detaches from parent)
    if command -v xdg-open &> /dev/null; then
        setsid xdg-open "$url" </dev/null >/dev/null 2>&1 &
    elif command -v open &> /dev/null; then
        setsid open "$url" </dev/null >/dev/null 2>&1 &
    else
        echo "$url"
    fi
}

# Function to copy to clipboard
copy_to_clipboard() {
    local text="$1"
    if command -v xclip &> /dev/null; then
        echo -n "$text" | xclip -selection clipboard
        return 0
    elif command -v wl-copy &> /dev/null; then
        echo -n "$text" | wl-copy
        return 0
    fi
    return 1
}

# Initialize MR cache
init_mr_cache() {
    mkdir -p "$CACHE_DIR"
    if [ ! -f "$MR_CACHE_FILE" ]; then
        echo '{}' > "$MR_CACHE_FILE"
    fi
}

# Save MR info to cache
save_mr_to_cache() {
    local ticket_key="$1"
    local mr_url="$2"
    local branch="$3"
    init_mr_cache
    local tmp_file=$(mktemp)
    jq --arg key "$ticket_key" --arg url "$mr_url" --arg branch "$branch" \
        '.[$key] = {url: $url, branch: $branch, created: now | todate}' \
        "$MR_CACHE_FILE" > "$tmp_file" 2>/dev/null && mv "$tmp_file" "$MR_CACHE_FILE"
}

# Check if Jira integration is available
has_jira_credentials() {
    [ -n "$JIRA_EMAIL" ] && [ -n "$JIRA_API_TOKEN" ]
}

# Get ticket summary from Jira
get_ticket_summary() {
    local key="$1"
    if ! has_jira_credentials; then
        return 1
    fi
    curl -s -u "${JIRA_EMAIL}:${JIRA_API_TOKEN}" \
        "https://${JIRA_DOMAIN}/rest/api/3/issue/${key}?fields=summary" \
        -H "Content-Type: application/json" 2>/dev/null | \
        jq -r '.fields.summary // empty' 2>/dev/null
}

# Get ticket description from Jira
get_ticket_description() {
    local key="$1"
    if ! has_jira_credentials; then
        return 1
    fi
    curl -s -u "${JIRA_EMAIL}:${JIRA_API_TOKEN}" \
        "https://${JIRA_DOMAIN}/rest/api/3/issue/${key}?fields=description" \
        -H "Content-Type: application/json" 2>/dev/null | \
        jq -r '.fields.description.content[]? | 
            if .type == "paragraph" then 
                (.content[]?.text // "") + "\n"
            else 
                ""
            end' 2>/dev/null | \
        sed '/^$/d'
}

# Every transition in a `jira-transition --list` array that lands on a review STATUS,
# one compact JSON object per line.
#
# The match is on `.to` -- the status the arrow leads to -- and never on `.name`. This
# script used to match the same regex against transition NAMES, which is a different
# string: DE's arrow onto "Peer Review" is named "Ready for review", and UL's arrow
# onto "In Qualification" is named "Qualifying". The only thing this caller knows is
# the status it wants the ticket to be in, so that is what is matched. The regex is the
# old one, unchanged, because the three boards spell that status three ways: "MR" on
# UB, "In Review" on UL, "Peer Review" on DE.
review_transitions() {
    local list_json="$1"
    printf '%s' "$list_json" | jq -c \
        '[.[]? | select(((.to) // "") | test("MR|merge|review"; "i"))][]' 2>/dev/null || true
}

# Of several arrows that already agree on where they land, the one whose own name IS
# that status.
#
# This is not a name match, and it is not the bug this arm was rewritten to remove. The
# destination is still the only thing matched: nothing reaches this function that was
# not already selected on `.to`, and it is never consulted while there is one candidate.
# All it decides is which of two arrows onto one agreed status to take.
#
# It takes the arrow named for its destination because that is the board's canonical
# way in. DE offers both 41 "Peer Review" and 5 "Ready for review" onto "Peer Review":
# 41 is offered from everywhere and is named for where it goes, while 5 exists only from
# one status and is a shortcut spelled as an instruction. Naming the destination is the
# workflow author saying "this is the arrow onto that status".
#
# If this leaves nothing, or still leaves several, the caller refuses exactly as it did
# before. A tie-break that cannot break the tie must not invent one.
transitions_named_for_destination() {
    local matches="$1"
    printf '%s' "$matches" | jq -c \
        'select(((((.name) // "") | ascii_downcase)) == ((((.to) // "") | ascii_downcase)))' \
        2>/dev/null || true
}

# Move $key to its board's review status, using bin/jira-transition and judging the
# result only by that tool's exit status and its last-line JSON.
#
# Returns 0 only when the ticket actually moved. Every other outcome -- no tool, no
# match, several matches, a refusal from the tool -- prints one line and returns
# non-zero. It never fails the run: the MR exists by the time this is called, and a
# status that would not move is a line on the screen, not a reason to unwind an MR.
move_ticket_to_review() {
    local key="$1"
    local current_status="$2"
    local jt="$SCRIPT_DIR/jira-transition"

    # No silent fallback to an inline POST. The reason this call exists is that the
    # inline version could not tell a dead network from a moved ticket.
    if [ ! -x "$jt" ]; then
        echo -e "  ${RED}✗${RESET} Status: jira-transition not found in ${SCRIPT_DIR}; ${key} left in ${current_status}" >&2
        return 1
    fi

    # jira-transition says where the issue stands on stderr and refuses in one sentence
    # there too, so stderr is kept and quoted back only when something went wrong.
    local err_file
    err_file=$(mktemp)
    local list_json=""
    local rc=0
    list_json=$("$jt" "$key" --list 2>"$err_file") || rc=$?
    if [ "$rc" -ne 0 ]; then
        echo -e "  ${RED}✗${RESET} Status: Could not read ${key}'s transitions ($(tail -n 1 "$err_file"))" >&2
        rm -f "$err_file"
        return 1
    fi

    local matches
    matches=$(review_transitions "$list_json")
    local match_count
    match_count=$(printf '%s' "$matches" | grep -c . || true)

    if [ "$match_count" -eq 0 ]; then
        local reachable
        reachable=$(printf '%s' "$list_json" | jq -r '[.[]? | .to] | unique | join(", ")' 2>/dev/null || true)
        echo -e "  ${YELLOW}⚠${RESET} Status: No transition from ${current_status} reaches a review status (reachable: ${reachable:-none})" >&2
        rm -f "$err_file"
        return 1
    fi
    if [ "$match_count" -ne 1 ]; then
        # Several arrows reach a review status. Try the one tie-break that requires no
        # guessing before refusing -- and only where every candidate already agrees on
        # the destination, because two arrows onto two different statuses is a
        # disagreement about where the ticket should GO, which no rule about names is
        # entitled to settle.
        local destination_count
        destination_count=$(printf '%s' "$matches" | jq -r '((.to) // "") | ascii_downcase' 2>/dev/null | sort -u | grep -c . || true)
        local canonical=""
        local canonical_count=0
        if [ "$destination_count" -eq 1 ]; then
            canonical=$(transitions_named_for_destination "$matches")
            canonical_count=$(printf '%s' "$canonical" | grep -c . || true)
        fi

        if [ "$canonical_count" -eq 1 ]; then
            matches="$canonical"
        else
            # Still a question this script cannot answer -- two arrows onto one status
            # can differ in post-functions -- so it says which ones and leaves the ticket
            # alone rather than taking whichever the board happened to list first.
            local ambiguous
            ambiguous=$(printf '%s' "$matches" | jq -rs 'map("\(.id) (\(.name) → \(.to))") | join(", ")' 2>/dev/null || true)
            echo -e "  ${YELLOW}⚠${RESET} Status: ${match_count} transitions on ${key} reach review — ${ambiguous} — so it was not moved; run: jira-transition ${key} --transition-id <id>" >&2
            rm -f "$err_file"
            return 1
        fi
    fi

    local tid
    tid=$(printf '%s' "$matches" | jq -r '.id // empty' 2>/dev/null || true)
    local to_status
    to_status=$(printf '%s' "$matches" | jq -r '.to // empty' 2>/dev/null || true)

    local result=""
    rc=0
    result=$("$jt" "$key" --transition-id "$tid" 2>"$err_file") || rc=$?
    if [ "$rc" -ne 0 ]; then
        echo -e "  ${RED}✗${RESET} Status: Could not move ${key} to ${to_status} ($(tail -n 1 "$err_file"))" >&2
        rm -f "$err_file"
        return 1
    fi
    rm -f "$err_file"

    # jira-transition's contract: on success the last line of stdout is the result
    # object, and a refusal never reaches stdout at all. An exit 0 with nothing to read
    # is therefore not a transition, and is not reported as one.
    local landed
    landed=$(printf '%s' "$result" | tail -n 1 | jq -r '.to // empty' 2>/dev/null || true)
    local moved_from
    moved_from=$(printf '%s' "$result" | tail -n 1 | jq -r '.from // empty' 2>/dev/null || true)
    if [ -z "$landed" ]; then
        echo -e "  ${RED}✗${RESET} Status: jira-transition exited 0 without saying where ${key} landed" >&2
        return 1
    fi

    echo -e "  ${GREEN}✓${RESET} Status: ${moved_from:-$current_status} → ${landed}" >&2
    return 0
}

# Assigning the ticket is a different fact from moving it -- jira-transition reads an
# assignee and never writes one -- so it is its own step, run only after a move that
# actually happened, and it can never turn a failed move into a reported success.
assign_ticket_to_me() {
    local key="$1"
    local current_user_id=$(curl -s --max-time 10 -u "${JIRA_EMAIL}:${JIRA_API_TOKEN}" \
        "https://${JIRA_DOMAIN}/rest/api/3/myself" 2>/dev/null | jq -r '.accountId // empty')

    if [ -n "$current_user_id" ]; then
        local assign_result=$(curl -s --max-time 10 -u "${JIRA_EMAIL}:${JIRA_API_TOKEN}" \
            -X PUT \
            "https://${JIRA_DOMAIN}/rest/api/3/issue/${key}" \
            -H "Content-Type: application/json" \
            -d "{\"fields\": {\"assignee\": {\"accountId\": \"$current_user_id\"}}}" 2>/dev/null)
        if [ -z "$assign_result" ]; then
            echo -e "  ${GREEN}✓${RESET} Assignee: Assigned to you" >&2
        fi
    fi
    return 0
}

# Update Jira ticket with MR info
update_jira_ticket() {
    local key="$1"
    local mr_url="$2"
    local branch="$3"
    local is_draft="$4"
    
    if ! has_jira_credentials; then
        echo -e "  ${YELLOW}⚠${RESET} Jira: Credentials not configured" >&2
        return 1
    fi
    
    echo "" >&2
    echo -e "  ${DIM}Updating Jira ticket ${key}...${RESET}" >&2
    
    # Fetch current issue state
    local qa_field_id="${JIRA_QA_BRANCH_FIELD:-}"
    local qa_fields=""
    if [ -n "$qa_field_id" ]; then
        qa_fields=",$qa_field_id"
    fi
    local issue_data=$(curl -s --max-time 10 -u "${JIRA_EMAIL}:${JIRA_API_TOKEN}" \
        "https://${JIRA_DOMAIN}/rest/api/3/issue/${key}?fields=status${qa_fields}" 2>/dev/null)
    local current_status=$(echo "$issue_data" | jq -r '.fields.status.name // "Unknown"')
    
    # Show current state
    echo "" >&2
    echo -e "  ${CYAN}┌─ Current State ─────────────────────────────────────────┐${RESET}" >&2
    printf "  ${CYAN}│${RESET} Status: ${BLUE}%-48s${RESET} ${CYAN}│${RESET}\n" "$current_status" >&2
    echo -e "  ${CYAN}└──────────────────────────────────────────────────────────┘${RESET}" >&2
    echo "" >&2
    
    # 1. Add MR Comment
    local existing_comments=$(curl -s --max-time 10 -u "${JIRA_EMAIL}:${JIRA_API_TOKEN}" \
        "https://${JIRA_DOMAIN}/rest/api/3/issue/${key}/comment" 2>/dev/null)
    
    if echo "$existing_comments" | grep -q "$mr_url"; then
        echo -e "  ${DIM}─${RESET} Comment: ${DIM}MR link already exists${RESET}" >&2
    else
        local comment_body=$(jq -n --arg url "$mr_url" '{
            "body": {
                "type": "doc",
                "version": 1,
                "content": [
                    {
                        "type": "paragraph",
                        "content": [
                            {"type": "text", "text": "MR: "},
                            {"type": "text", "text": $url, "marks": [{"type": "link", "attrs": {"href": $url}}]}
                        ]
                    }
                ]
            }
        }')
        local comment_result=$(curl -s --max-time 10 -u "${JIRA_EMAIL}:${JIRA_API_TOKEN}" \
            -X POST \
            "https://${JIRA_DOMAIN}/rest/api/3/issue/${key}/comment" \
            -H "Content-Type: application/json" \
            -d "$comment_body" 2>/dev/null)
        if echo "$comment_result" | jq -e '.id' >/dev/null 2>&1; then
            echo -e "  ${GREEN}✓${RESET} Comment: Added MR link" >&2
        else
            echo -e "  ${RED}✗${RESET} Comment: Failed to add" >&2
        fi
    fi
    
    # 2. QA Branch field
    local qa_branch_domain=""
    if [ -z "$JIRA_QA_BRANCH_DOMAIN" ]; then
        echo -e "  ${YELLOW}⚠${RESET} QA Branch: JIRA_QA_BRANCH_DOMAIN not set" >&2
    else
        # Support array of domains (space or comma-separated)
        local domains=$(echo "$JIRA_QA_BRANCH_DOMAIN" | sed 's/,/ /g' | tr ' ' '\n' | grep -v '^$')
        local domain_count=$(echo "$domains" | wc -l)
        
        if [ "$domain_count" -gt 1 ]; then
            if is_interactive; then
                # Multiple domains - show fzf menu
                echo -e "  ${CYAN}Select QA domain:${RESET}" >&2
                qa_branch_domain=$(echo "$domains" | $FZF \
                    --prompt="  QA Domain > " \
                    --height=10 \
                    --reverse \
                    --border=rounded \
                    --header="Select QA branch domain")
            else
                # Non-interactive — use first domain
                qa_branch_domain=$(echo "$domains" | head -1)
            fi

            if [ -z "$qa_branch_domain" ]; then
                echo -e "  ${YELLOW}⚠${RESET} QA Branch: No domain selected" >&2
            else
                echo -e "  ${DIM}Selected: ${qa_branch_domain}${RESET}" >&2
            fi
        else
            # Single domain - use it directly
            qa_branch_domain="$domains"
        fi
        
        if [ -n "$qa_branch_domain" ]; then
            local qa_branch="${qa_branch_domain}/branch/${branch}"
            if [ -z "$qa_field_id" ]; then
                local editmeta=$(curl -s --max-time 10 -u "${JIRA_EMAIL}:${JIRA_API_TOKEN}" \
                    "https://${JIRA_DOMAIN}/rest/api/3/issue/${key}/editmeta" 2>/dev/null)
                qa_field_id=$(echo "$editmeta" | jq -r '.fields | to_entries[] | select(.value.name | test("[Qq][Aa].*[Bb]ranch|[Bb]ranch.*[Qq][Aa]"; "i")) | .key' | head -1)
            fi
            
            if [ -n "$qa_field_id" ]; then
                local current_qa=$(echo "$issue_data" | jq -r ".fields.${qa_field_id} // empty")
                if [ "$current_qa" = "$qa_branch" ]; then
                    echo -e "  ${DIM}─${RESET} QA Branch: ${DIM}${qa_branch} (already set)${RESET}" >&2
                else
                    local qa_field_result=$(curl -s --max-time 10 -u "${JIRA_EMAIL}:${JIRA_API_TOKEN}" \
                        -X PUT \
                        "https://${JIRA_DOMAIN}/rest/api/3/issue/${key}" \
                        -H "Content-Type: application/json" \
                        -d "{\"fields\": {\"$qa_field_id\": \"$qa_branch\"}}" 2>/dev/null)
                    if [ -z "$qa_field_result" ]; then
                        if [ -n "$current_qa" ]; then
                            echo -e "  ${GREEN}✓${RESET} QA Branch: ${current_qa} → ${qa_branch}" >&2
                        else
                            echo -e "  ${GREEN}✓${RESET} QA Branch: ${qa_branch}" >&2
                        fi
                    else
                        echo -e "  ${RED}✗${RESET} QA Branch: Could not set" >&2
                    fi
                fi
            else
                echo -e "  ${YELLOW}⚠${RESET} QA Branch: Field not found (set JIRA_QA_BRANCH_FIELD)" >&2
            fi
        fi
    fi
    
    # 3. Status transition and assignee (skip for draft MRs)
    #
    # The move itself is bin/jira-transition's job, not this script's. This arm used to
    # POST the transition inline and read an empty stdout as success -- which `curl -s`
    # also prints when it never reached Jira at all, so an outage was reported here as a
    # moved ticket. Nothing below judges a Jira write by the emptiness of its output.
    if [ -n "$is_draft" ]; then
        echo -e "  ${DIM}─${RESET} Status: ${DIM}${current_status} (draft MR, not moving to review)${RESET}" >&2
    elif echo "$current_status" | grep -qi "MR\|merge\|review"; then
        echo -e "  ${DIM}─${RESET} Status: ${DIM}${current_status} (already in review)${RESET}" >&2
    elif move_ticket_to_review "$key" "$current_status"; then
        assign_ticket_to_me "$key"
    fi
}

# Try to detect ticket from branch name
detect_ticket_from_branch() {
    local branch="$1"
    if [[ "$branch" =~ (${JIRA_PROJECT_REGEX}-[0-9]+) ]]; then
        echo "${BASH_REMATCH[1]}"
    fi
}

# Append a Slack reference to the MR description (idempotent — skips if already present).
# Fetches the current description first so existing content (e.g. "Closes PROJ-1234") is preserved.
add_slack_ref_to_mr() {
    local branch="$1"
    local url="$2"
    local current=""
    current=$(glab mr view "$branch" --output json 2>/dev/null | jq -r '.description // ""' 2>/dev/null) || current=""
    if echo "$current" | grep -qF "$url"; then
        return 0  # already referenced
    fi
    local new_desc
    if [ -n "$current" ]; then
        new_desc="${current}"$'\n\n'"Slack: ${url}"
    else
        new_desc="Slack: ${url}"
    fi
    # Don't let a failed update abort the caller (set -e); the Slack post is what matters.
    glab mr update "$branch" --description "$new_desc" >/dev/null 2>&1 || true
    return 0
}

# Post the MR link — and, when the destination arrived too late for oneshot to
# have done it, the ticket link — to an already-parsed Slack destination.
# Expects parse_slack_url to have set SLACK_CHANNEL / SLACK_THREAD_TS, and
# reads $selected_branch / $mr_url / $mr_title / $TICKET_KEY / $summary.
post_slack_links() {
    local slack_url="$1"
    local post_ticket_link="$2"

    local slack_target="channel"
    [ -n "$SLACK_THREAD_TS" ] && slack_target="thread"

    add_slack_ref_to_mr "$selected_branch" "$slack_url"
    echo -e "  ${GREEN}✓${RESET} Added Slack reference to MR description" >&2

    # A definitive "the bot isn't in that channel" is worth catching before we
    # post: the error it gives is the actionable one.
    if [ -n "$TICKET_CREATOR_BOT_TOKEN" ] && ! verify_slack_channel_access "$SLACK_CHANNEL"; then
        return 1
    fi

    if [ "$post_ticket_link" = "true" ] && [ -n "$TICKET_KEY" ] && [ "$NO_JIRA" != "true" ]; then
        local ticket_title="$TICKET_KEY"
        [ -n "$summary" ] && ticket_title="$TICKET_KEY: $summary"
        if post_to_slack "$SLACK_CHANNEL" "$SLACK_THREAD_TS" "ticket" "https://${JIRA_DOMAIN}/browse/${TICKET_KEY}" "$ticket_title"; then
            echo -e "  ${GREEN}✓${RESET} Posted ticket link to Slack ${slack_target}" >&2
        fi
    fi

    if post_to_slack "$SLACK_CHANNEL" "$SLACK_THREAD_TS" "mr" "$mr_url" "$mr_title"; then
        echo -e "  ${GREEN}✓${RESET} Posted MR link to Slack ${slack_target}" >&2
        return 0
    fi
    return 1
}

# Ask where in Slack the MR should go, then post it there.
#
# One prompt, not two: a y/N gate in front of a paste prompt asks for the same
# decision the paste itself already carries, and answering it is one more thing
# to get wrong at the very end of a long run. An empty line is the "no".
#
# Returns 0 posted, 2 deliberately skipped, 1 failed — the caller keeps the
# pending record only for 1, since only that is worth coming back to.
prompt_and_post_slack() {
    local post_ticket_link="$1"
    local pasted=""

    # The picker first, when it can run: the thread an MR belongs in is nearly
    # always one you're already in, and it can go and find those. It signals
    # "not available here" with exit 2 — no user token, no fzf — which falls
    # through to the paste prompt below. Set SLACK_PICKER=0 to always paste.
    if [ "${SLACK_PICKER:-1}" != "0" ] && [ -x "$SCRIPT_DIR/slack-pick-thread" ]; then
        local picked picker_rc
        if picked=$("$SCRIPT_DIR/slack-pick-thread"); then picker_rc=0; else picker_rc=$?; fi
        case "$picker_rc" in
            0)
                if parse_slack_url "$picked"; then
                    echo "" >&2
                    post_slack_links "$picked" "$post_ticket_link"
                    return $?
                fi
                ;;
            1)
                # Cancelled. The picker takes a pasted URL too, so backing out
                # of it is a decision not to post, not a wish to type instead.
                echo -e "  ${DIM}No Slack post${RESET}" >&2
                return 2
                ;;
        esac
    fi

    while :; do
        printf "  ${CYAN}Post MR link to Slack${RESET} ${DIM}— paste a thread or channel URL (Enter to skip):${RESET} " >&2
        read_tty -r pasted
        if [ -z "$pasted" ]; then
            echo -e "  ${DIM}No Slack post${RESET}" >&2
            return 2
        fi
        parse_slack_url "$pasted" && break
        # Re-ask rather than discard it. Getting here means they meant to post
        # and mistyped, and the MR link is the one thing they can't retrieve
        # from scrollback once the run is over.
        echo -e "  ${YELLOW}⚠ Not a Slack URL${RESET} ${DIM}(expected .../archives/CHANNEL or .../archives/CHANNEL/pTIMESTAMP)${RESET}" >&2
    done

    echo "" >&2
    post_slack_links "$pasted" "$post_ticket_link"
}

# Serve the outstanding Slack post: use a destination we were handed, otherwise
# ask for one. Clears the pending record afterwards unless the attempt actually
# failed — a failure is the one outcome worth coming back to.
serve_slack_post() {
    local post_ticket_link="$1"
    local slack_url="$2"
    local rc

    if [ -n "$slack_url" ]; then
        if parse_slack_url "$slack_url"; then
            if post_slack_links "$slack_url" "$post_ticket_link"; then rc=0; else rc=1; fi
        else
            echo -e "  ${YELLOW}⚠ Invalid Slack URL, skipping Slack post${RESET}" >&2
            rc=2
        fi
    elif is_interactive; then
        if prompt_and_post_slack "$post_ticket_link"; then rc=0; else rc=$?; fi
    else
        # No destination and nobody to ask for one: nothing is outstanding.
        rc=2
    fi

    if [ "$rc" -eq 1 ]; then
        echo -e "  ${DIM}Left pending — run 'publish-changes' on this branch to retry${RESET}" >&2
    else
        clear_pending_slack
    fi
    return 0
}

# ============================================================================
# Main flow
# ============================================================================

echo "" >&2
echo -e "${PURPLE}=== Create Merge Request ===${RESET}" >&2
echo "" >&2

# Step 1: Select source branch
echo -e "${CYAN}┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓${RESET}" >&2
echo -e "${CYAN}┃${RESET} ${BLUE}Step 1/4:${RESET} Select branch to push                        ${CYAN}┃${RESET}" >&2
echo -e "${CYAN}┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛${RESET}" >&2

current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

if [ -n "$SOURCE_BRANCH" ]; then
    selected_branch="$SOURCE_BRANCH"
    echo -e "  ${GREEN}✓${RESET} Branch: ${selected_branch} ${DIM}(from argument)${RESET}" >&2
else
    # Prepare branch list with current branch first
    branches=$(
        echo "$current_branch (current)"
        git branch --format='%(refname:short)' | grep -v "^${current_branch}$"
    )
    
    selected_branch=$(echo "$branches" | $FZF \
        --prompt="  Branch > " \
        --height=15 \
        --reverse \
        --border=rounded \
        --header="Press ESC to cancel")
    
    if [ -z "$selected_branch" ]; then
        echo -e "${RED}  ✗ Cancelled${RESET}" >&2
        exit 1
    fi
    
    # Strip " (current)" suffix if present
    selected_branch=$(echo "$selected_branch" | sed 's/ (current)$//')
    echo -e "  ${GREEN}✓${RESET} Branch: ${selected_branch}" >&2
fi

# A previous run got the MR up and was interrupted before its Slack post landed.
# Everything below — push, MR create, Jira — is already done and would only be
# re-established at the cost of a push and a round of API calls, so serve the one
# thing still outstanding and stop. load_pending_slack refuses the record if HEAD
# has moved since, which is what keeps a branch with new commits on the normal path.
if pending_record=$(load_pending_slack "$selected_branch"); then
    mr_url=$(printf '%s' "$pending_record" | jq -r '.mr_url')
    mr_title=$(printf '%s' "$pending_record" | jq -r '.mr_title')
    TICKET_KEY=$(printf '%s' "$pending_record" | jq -r '.ticket_key // empty')
    summary=$(printf '%s' "$pending_record" | jq -r '.ticket_summary // empty')
    pending_post_ticket=$(printf '%s' "$pending_record" | jq -r '.post_ticket_link // "false"')
    pending_slack_url=$(printf '%s' "$pending_record" | jq -r '.slack_url // empty')

    echo "" >&2
    echo -e "  ${YELLOW}⚠ This branch's MR is already up — only its Slack post is outstanding${RESET}" >&2
    echo -e "  ${DIM}URL:${RESET}  ${UNDERLINE}${BLUE}${mr_url}${RESET}" >&2
    echo "" >&2

    # A destination we already have is one we were told to use; don't re-ask.
    serve_slack_post "$pending_post_ticket" "${SLACK_URL:-$pending_slack_url}"

    echo "" >&2
    if [ "$OUTPUT_URL" = true ]; then
        echo "$mr_url"
    fi
    exit 0
fi

# Auto-detect ticket from branch name if not provided
if [ -z "$TICKET_KEY" ] && [ "$NO_JIRA" != "true" ]; then
    detected_ticket=$(detect_ticket_from_branch "$selected_branch")
    if [ -n "$detected_ticket" ]; then
        TICKET_KEY="$detected_ticket"
        echo -e "  ${DIM}Detected ticket: ${TICKET_KEY}${RESET}" >&2
    fi
fi

# Show ticket info if we have one
if [ -n "$TICKET_KEY" ] && [ "$NO_JIRA" != "true" ]; then
    summary=$(get_ticket_summary "$TICKET_KEY")
    if [ -n "$summary" ]; then
        echo "" >&2
        echo -e "  ${CYAN}Ticket:${RESET} ${TICKET_KEY}" >&2
        echo -e "  ${CYAN}Title:${RESET}  ${summary}" >&2
    fi

    # Prompt for additional tickets (skipped if extras already provided via CLI)
    if [ "${#EXTRA_TICKET_KEYS[@]}" -eq 0 ]; then
        prompt_additional_tickets EXTRA_TICKET_KEYS
    fi
fi

echo "" >&2

# Step 2: Push the branch
if [ "$SKIP_PUSH" != "true" ]; then
    echo -e "${CYAN}┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓${RESET}" >&2
    echo -e "${CYAN}┃${RESET} ${BLUE}Step 2/4:${RESET} Pushing branch to remote                      ${CYAN}┃${RESET}" >&2
    echo -e "${CYAN}┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛${RESET}" >&2

    # Either flag makes the autofix-retry path below dead: --no-autofix leaves the
    # checks running but stops the hook rewriting files, --no-verify skips the hook.
    push_env=()
    push_opts=()
    if [ "$NO_VERIFY" = "true" ]; then
        push_opts=(--no-verify)
        echo -e "  ${YELLOW}⚠${RESET} Skipping pre-push hook (--no-verify)" >&2
    elif [ "$NO_AUTOFIX" = "true" ]; then
        push_env=(env SKIP_PRE_PUSH_AUTOFIX=true)
        echo -e "  ${DIM}Skipping pre-push autofix (--no-autofix)${RESET}" >&2
    fi

    echo -e "  ${DIM}Running: git push -u origin ${selected_branch}${push_opts[*]:+ ${push_opts[*]}}${RESET}" >&2

    push_tmp=$(mktemp)
    trap "rm -f '$push_tmp'" EXIT
    "${push_env[@]}" git push -u origin "$selected_branch" "${push_opts[@]}" 2>&1 | tee "$push_tmp" | while read -r line; do
        echo -e "  ${DIM}${line}${RESET}" >&2
    done
    push_exit_code="${PIPESTATUS[0]}"

    if [ "$push_exit_code" -eq 0 ]; then
        echo -e "  ${GREEN}✓${RESET} Push successful" >&2
    elif grep -q "Autofix commits were added" "$push_tmp"; then
        echo -e "  ${YELLOW}⚠${RESET} Pre-push hook added autofix commits — retrying push (skipping autofix stage)..." >&2
        SKIP_PRE_PUSH_AUTOFIX=true git push -u origin "$selected_branch" 2>&1 | while read -r line; do
            echo -e "  ${DIM}${line}${RESET}" >&2
        done
        if [ ${PIPESTATUS[0]} -eq 0 ]; then
            echo -e "  ${GREEN}✓${RESET} Push successful (after autofix)" >&2
        else
            echo -e "  ${RED}✗${RESET} Push failed" >&2
            exit 1
        fi
    elif grep -q "non-fast-forward\|fetch first\|tip of your current branch is behind" "$push_tmp"; then
        echo -e "  ${RED}✗${RESET} Push rejected (remote has changes not in local branch)" >&2
        force_choice=""
        if [ "$FORCE_PUSH" = "true" ]; then
            force_choice="y"
            echo -e "  ${DIM}Force pushing (--force-push flag)${RESET}" >&2
        elif is_interactive; then
            echo "" >&2
            printf "  ${YELLOW}Force push to overwrite remote?${RESET} ${DIM}(y/N)${RESET} " >&2
            read_tty -n 1 force_choice
            echo "" >&2
        else
            echo -e "  ${RED}✗${RESET} Push cancelled (use --force-push to overwrite)" >&2
            exit 1
        fi
        if [[ "$force_choice" =~ ^[Yy]$ ]]; then
            echo -e "  ${DIM}Running: git push -u origin ${selected_branch} --force-with-lease${RESET}" >&2
            "${push_env[@]}" git push -u origin "$selected_branch" --force-with-lease "${push_opts[@]}" 2>&1 | while read -r line; do
                echo -e "  ${DIM}${line}${RESET}" >&2
            done
            if [ ${PIPESTATUS[0]} -eq 0 ]; then
                echo -e "  ${GREEN}✓${RESET} Force push successful" >&2
            else
                echo -e "  ${RED}✗${RESET} Force push failed" >&2
                exit 1
            fi
        else
            echo -e "  ${RED}✗${RESET} Push cancelled" >&2
            exit 1
        fi
    else
        echo -e "  ${RED}✗${RESET} Push failed" >&2
        exit 1
    fi
    echo "" >&2
fi

# Step 3: Choose target branch
echo -e "${CYAN}┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓${RESET}" >&2
echo -e "${CYAN}┃${RESET} ${BLUE}Step 3/4:${RESET} Select target branch (MR base)                ${CYAN}┃${RESET}" >&2
echo -e "${CYAN}┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛${RESET}" >&2

if [ -n "$TARGET_BRANCH" ]; then
    target_branch="$TARGET_BRANCH"
    echo -e "  ${GREEN}✓${RESET} Target: ${target_branch} ${DIM}(from argument)${RESET}" >&2
else
    # Try to detect default branch
    default_branch=$(git remote show origin 2>/dev/null | grep "HEAD branch" | sed 's/.*: //')
    if [ -z "$default_branch" ]; then
        default_branch="main"
    fi
    
    # Get remote branches, prioritizing common targets
    target_branches=$(
        # Common targets first
        for b in "$default_branch" "main" "master" "develop" "dev"; do
            if git show-ref --verify --quiet "refs/remotes/origin/$b" 2>/dev/null; then
                if [ "$b" = "$default_branch" ]; then
                    echo "$b (default)"
                else
                    echo "$b"
                fi
            fi
        done | sort -u
        # Then other remote branches
        git branch -r --format='%(refname:short)' 2>/dev/null | \
            sed 's|^origin/||' | \
            grep -vE "^(HEAD|$default_branch|main|master|develop|dev)$" | \
            sort
    )
    
    target_branch=$(echo "$target_branches" | $FZF \
        --prompt="  Target branch > " \
        --height=80% \
        --reverse \
        --border=rounded \
        --header="Select target branch │ Preview: commits in MR │ Ctrl-T: open tig" \
        --preview="target=\$(echo {} | sed 's/ (default)\$//'); git log --oneline --graph --color=always \"\$target\"..\"$selected_branch\" 2>/dev/null | head -50 || echo 'No commits or branch not found'" \
        --preview-window=right:60% \
        --bind "ctrl-t:execute(target=\$(echo {} | sed 's/ (default)\$//'); tig \"\$target\"..\"$selected_branch\" < /dev/tty > /dev/tty 2>&1)")
    
    if [ -z "$target_branch" ]; then
        echo -e "${RED}  ✗ Cancelled${RESET}" >&2
        exit 1
    fi
    
    # Strip " (default)" suffix if present
    target_branch=$(echo "$target_branch" | sed 's/ (default)$//')
fi

echo -e "  ${GREEN}✓${RESET} Target: ${target_branch}" >&2
echo "" >&2

# Step 4: Draft option (only if not already set via argument)
if [ -z "$IS_DRAFT" ] && [ "$NO_DRAFT_PROMPT" != "true" ]; then
    echo -e "${CYAN}┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓${RESET}" >&2
    echo -e "${CYAN}┃${RESET} ${BLUE}Step 4/5:${RESET} Create as draft? ${DIM}(y/N)${RESET}                       ${CYAN}┃${RESET}" >&2
    echo -e "${CYAN}┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛${RESET}" >&2
    printf "  ${DIM}Draft MRs cannot be merged until marked ready.${RESET} " >&2
    read_tty -n 1 draft_choice
    echo "" >&2
    if [[ "$draft_choice" =~ ^[Yy]$ ]]; then
        IS_DRAFT="--draft"
        echo -e "  ${GREEN}✓${RESET} Creating as: ${YELLOW}Draft${RESET}" >&2
    else
        echo -e "  ${GREEN}✓${RESET} Creating as: ${GREEN}Ready${RESET}" >&2
    fi
    echo "" >&2
fi

# Step 5: Create the MR
echo -e "${CYAN}┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓${RESET}" >&2
echo -e "${CYAN}┃${RESET} ${BLUE}Step 5/5:${RESET} Creating Merge Request                        ${CYAN}┃${RESET}" >&2
echo -e "${CYAN}┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛${RESET}" >&2

# Set MR title based on whether we have a ticket
if [ -n "$MR_TITLE_OVERRIDE" ]; then
    mr_title="$MR_TITLE_OVERRIDE"
    mr_description="$MR_DESCRIPTION_OVERRIDE"
elif [ -n "$TICKET_KEY" ] && [ "$NO_JIRA" != "true" ] && [ -n "$summary" ]; then
    mr_title="$TICKET_KEY $summary"
    for _extra in "${EXTRA_TICKET_KEYS[@]}"; do
        _extra_summary=$(get_ticket_summary "$_extra")
        if [ -n "$_extra_summary" ]; then
            mr_title+=" | $_extra $_extra_summary"
        else
            mr_title+=" | $_extra"
        fi
    done
    mr_description="Closes $TICKET_KEY"
    for _extra in "${EXTRA_TICKET_KEYS[@]}"; do
        mr_description+=$'\nCloses '"$_extra"
    done

    # Include ticket description if requested
    if [ "$INCLUDE_TICKET_DESCRIPTION" = true ]; then
        # Use passed description if available, otherwise fetch from Jira
        if [ -n "$TICKET_DESCRIPTION" ]; then
            mr_description="$mr_description

$TICKET_DESCRIPTION"
        else
            ticket_description=$(get_ticket_description "$TICKET_KEY")
            if [ -n "$ticket_description" ]; then
                mr_description="$mr_description

$ticket_description"
            fi
        fi
    fi
else
    mr_title="$selected_branch"
    mr_description=""
fi

echo -e "  ${DIM}Title: ${mr_title}${RESET}" >&2
echo -e "  ${DIM}Source: ${selected_branch} → Target: ${target_branch}${RESET}" >&2
echo "" >&2

# First check if an MR already exists for this branch
echo -e "  ${DIM}$ glab mr list --source-branch=\"${selected_branch}\" --output=json${RESET}" >&2
existing_mr_url=$(glab mr list --source-branch="$selected_branch" --output=json 2>/dev/null | jq -r '.[0].web_url // empty' 2>/dev/null)

if [ -n "$existing_mr_url" ]; then
    # MR already exists - reuse its URL
    mr_url="$existing_mr_url"

    echo "" >&2
    echo -e "  ${BLUE}Merge Request already exists${RESET}" >&2
    echo -e "  ${DIM}URL:${RESET}  ${UNDERLINE}${BLUE}${mr_url}${RESET}" >&2

    if [ "$OUTPUT_URL" != "true" ]; then
        if copy_to_clipboard "$mr_url"; then
            echo -e "  ${DIM}(URL copied to clipboard)${RESET}" >&2
        fi
        echo -e "  ${DIM}Opening in browser...${RESET}" >&2
        open_url "${mr_url}/diffs"
    fi
else
    # No existing MR - create one
    draft_flag_display=""
    [ -n "$IS_DRAFT" ] && draft_flag_display="--draft "
    echo -e "  ${DIM}$ glab mr create ${draft_flag_display}--title \"${mr_title}\" --description \"${mr_description}\" \\\\${RESET}" >&2
    echo -e "  ${DIM}    --source-branch \"${selected_branch}\" --target-branch \"${target_branch}\" --push=false${RESET}" >&2
    
    # Use `if` so set -e doesn't kill the script on glab failure;
    # we want to handle "already exists" and other errors below.
    if mr_output=$(glab mr create \
        $IS_DRAFT \
        --title "$mr_title" \
        --description "$mr_description" \
        --source-branch "$selected_branch" \
        --target-branch "$target_branch" \
        --push=false \
        --yes \
        < /dev/null 2>&1); then
        mr_exit_code=0
    else
        mr_exit_code=$?
    fi
    
    if [ $mr_exit_code -eq 0 ]; then
        # Extract MR URL from output
        mr_url=$(echo "$mr_output" | grep -oE 'https://[^ ]+merge_requests/[0-9]+' | head -1)
        
        mr_type="Merge Request"
        [ -n "$IS_DRAFT" ] && mr_type="Draft Merge Request"
        
        echo "" >&2
        echo -e "  ${GREEN}✓ ${mr_type} created!${RESET}" >&2
        
        if [ -n "$mr_url" ]; then
            echo -e "  ${DIM}URL:${RESET}  ${UNDERLINE}${BLUE}${mr_url}${RESET}" >&2
            
            # Cache MR info (only for ticket entries)
            if [ -n "$TICKET_KEY" ]; then
                save_mr_to_cache "$TICKET_KEY" "$mr_url" "$selected_branch"
                for _extra in "${EXTRA_TICKET_KEYS[@]}"; do
                    save_mr_to_cache "$_extra" "$mr_url" "$selected_branch"
                done
            fi

            # Copy to clipboard (skip if --output-url to avoid blocking)
            if [ "$OUTPUT_URL" != "true" ]; then
                if copy_to_clipboard "$mr_url"; then
                    echo -e "  ${DIM}(URL copied to clipboard)${RESET}" >&2
                fi
            fi

            # Update Jira ticket if we have one
            if [ -n "$TICKET_KEY" ] && [ "$NO_JIRA" != "true" ]; then
                update_jira_ticket "$TICKET_KEY" "$mr_url" "$selected_branch" "$IS_DRAFT"
                for _extra in "${EXTRA_TICKET_KEYS[@]}"; do
                    update_jira_ticket "$_extra" "$mr_url" "$selected_branch" "$IS_DRAFT"
                done

                # Open both MR and Jira (skip if --output-url to avoid blocking)
                if [ "$OUTPUT_URL" != "true" ]; then
                    echo "" >&2
                    echo -e "  ${DIM}Opening in browser...${RESET}" >&2
                    open_url "${mr_url}/diffs"
                    sleep 0.3
                    open_url "https://${JIRA_DOMAIN}/browse/${TICKET_KEY}"
                    for _extra in "${EXTRA_TICKET_KEYS[@]}"; do
                        sleep 0.3
                        open_url "https://${JIRA_DOMAIN}/browse/${_extra}"
                    done
                fi
            else
                # Just open MR (skip if --output-url to avoid blocking)
                if [ "$OUTPUT_URL" != "true" ]; then
                    echo "" >&2
                    echo -e "  ${DIM}Opening MR in browser...${RESET}" >&2
                    open_url "${mr_url}/diffs"
                fi
            fi
        else
            echo -e "  ${DIM}${mr_output}${RESET}" >&2
        fi
    elif echo "$mr_output" | grep -qi "already exists"; then
        # MR already exists (409 conflict)
        echo -e "  ${DIM}$ glab mr view \"${selected_branch}\"${RESET}" >&2
        mr_url=$(glab mr view "$selected_branch" 2>/dev/null | grep -oE 'https://[^ ]+merge_requests/[0-9]+' | head -1)
        
        echo "" >&2
        echo -e "  ${BLUE}Merge Request already exists${RESET}" >&2
        
        if [ -n "$mr_url" ]; then
            echo -e "  ${DIM}URL:${RESET}  ${UNDERLINE}${BLUE}${mr_url}${RESET}" >&2
            
            if [ -n "$TICKET_KEY" ]; then
                save_mr_to_cache "$TICKET_KEY" "$mr_url" "$selected_branch"
                for _extra in "${EXTRA_TICKET_KEYS[@]}"; do
                    save_mr_to_cache "$_extra" "$mr_url" "$selected_branch"
                done
            fi

            # Skip clipboard and browser if --output-url to avoid blocking
            if [ "$OUTPUT_URL" != "true" ]; then
                if copy_to_clipboard "$mr_url"; then
                    echo -e "  ${DIM}(URL copied to clipboard)${RESET}" >&2
                fi
                echo -e "  ${DIM}Opening in browser...${RESET}" >&2
                open_url "${mr_url}/diffs"
            fi
        else
            echo -e "  ${DIM}${mr_output}${RESET}" >&2
        fi
    else
        echo -e "${RED}  ✗ Error creating MR:${RESET}" >&2
        echo -e "  ${DIM}${mr_output}${RESET}" >&2
        exit 1
    fi
fi

echo "" >&2

# Post MR link to Slack. Consolidated here so callers (e.g. oneshot) reuse it
# instead of duplicating the prompt. A caller can pass --slack-url to post
# non-interactively; otherwise we ask for a destination.
if [ -n "$mr_url" ]; then
    # Post the ticket link alongside the MR only when the destination arrives at
    # the prompt below: a caller that knew it up front (--slack-url) already
    # posted the ticket link itself, and publishing an MR against a ticket that
    # existed before this run shouldn't announce "a ticket" in the thread at all.
    post_ticket_link=false
    if [ -z "$SLACK_URL" ] && [ "$TICKET_CREATED" = "true" ]; then
        post_ticket_link=true
    fi

    # Write the outstanding post down before attempting it. From here on the MR
    # is real and the only thing that can still be lost is where it should be
    # announced — see lib/slack.sh.
    if [ -n "$SLACK_URL" ] || is_interactive; then
        save_pending_slack "$selected_branch" "$mr_url" "$mr_title" \
            "$TICKET_KEY" "$summary" "$post_ticket_link" "$SLACK_URL"
    fi

    serve_slack_post "$post_ticket_link" "$SLACK_URL"
    echo "" >&2
fi

# Output URL to stdout if requested (for scripting)
if [ "$OUTPUT_URL" = true ] && [ -n "$mr_url" ]; then
    echo "$mr_url"
    exit 0
fi
