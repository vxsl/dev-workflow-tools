#!/usr/bin/env -S python3 -u
"""
arc-standup: what to say at the next standup, assembled from what already happened.

The page answers "what is true about my work". A standup asks a different question --
"what do the other people in this call need to hear from me" -- and the difference is not
a matter of trimming. Three things change at once:

**The window is the cadence, not the build.** Every interval on this page is measured from
the last time `arcs` ran, which is whenever Kyle happened to open it. A standup covers the
interval since the *last standup*, and that boundary is a property of the calendar. It is
derived here from the clock and nothing else -- no state file, no marker, nothing to get
out of step -- so it is right on a laptop that has not been opened for a week.

**The audience is the team.** The rest of this pipeline writes to Kyle: *you* owe, *you*
dropped it, it *fell off a cliff*. None of that is sayable out loud. A rung, a workstream
and an arc are this page's vocabulary for its own structures and mean nothing to a
reviewer; what a reviewer knows is a ticket key, an MR number, a channel and a person's
name. So every line here leads with the reference the room already shares.

**Selection is by what the room can act on.** The morning brief picks what will bite Kyle
soonest, which is why it opens on a 159-day stall: that is a real cost and he is the only
one carrying it. A standup that opens on the same fact for the fortieth consecutive time
is one nobody hears. What earns a standup line is what moved in the window, and what a
person on the call can unstick today.

**The currency is the rung, not the size.** "65 commits still local" is a number out of
this page's own accounting, and in a week where an agent produced them in one afternoon it
is a fact about the tooling rather than about the work. What a room can hear is where the
work got to: it landed, it is out for review, it is written and not pushed anywhere yet.
So no beat says a number of commits. See `rung_clause`.

**The whole block is about eight lines.** Not because eight is a number worth defending
but because this is spoken, from the top, in the forty-five seconds before somebody else
goes. One workstream is one line. Everything Kyle owes is one clause, not four
categories. Every cap sits well under what the ledger could fill it with, and a standing
debt is said on the day it changes rather than on the forty days it does not. A block that
has to be skimmed to be given is one that gets skimmed instead of given.

Four beats, in the order a standup is actually given, each dropped when it holds nothing:

    moved       what happened to the code -- the rung each workstream reached
    discussed   what was worked out in Slack and in review threads
    blocked     the asks the room can act on, and one clause for what you owe
    next        what is in front of you -- a prompt, not a claim

Read `work-arcs --json` (through arc-brief, whose names this uses) on stdin, add one
top-level `standup` key, pass everything else through unchanged.

    work-arcs --json | arc-brief | arc-morning | arc-standup | arcs-page --out page.html

`--text` prints the notes as they will read and is the way to check this without building
a page. It is also, deliberately, exactly the string the page's copy button puts on the
clipboard: one composition, so the spoken version and the pasted version cannot drift.

Nothing here counts or ranks anything that arrived already counted or ranked. The ledger
comes down the wire sorted worst-first and is consumed in that order; `own_activity` is
work-arcs' own answer to "when did Kyle last touch this"; the arc's name is arc-brief's;
the rung a workstream reached is work-arcs' `state` string, said in the words it arrived
in. A ranking re-implemented here would be a second author for the same judgement and the
two would differ inside a month. The partitions this stage does make -- landings ahead of
everything else in `moved`, fresh debts ahead of long-stalled ones in `blocked` -- are
splits on a fact each row already carries rather than competing scores, and each preserves
the incoming order inside its halves. See `moved_beat` and `blocked_beat`.
"""

import argparse
import json
import os
import re
import sys
from datetime import datetime, time as dtime, timedelta
from pathlib import Path

try:
    from zoneinfo import ZoneInfo
except ImportError:                                            # pragma: no cover
    ZoneInfo = None

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from timespan import fmt_interval  # noqa: E402


# --------------------------------------------------------------------------- the cadence

# The standup calendar. Defaults are Kyle's; every one is an env knob because the cadence
# is a property of one team's calendar and not of the idea, and a hard-coded Monday would
# make this tool useless to the next person who reads it.
DAY_NUMS = {"mon": 0, "tue": 1, "wed": 2, "thu": 3, "fri": 4, "sat": 5, "sun": 6}
DAY_NAMES = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]

DEFAULT_DAYS = "mon,wed,fri"
DEFAULT_TIME = "10:30"
DEFAULT_TZ = "America/Los_Angeles"

# How many arcs, conversations, asks and next-ups each beat will say. These add up to the
# eight-line budget the module docstring sets, and they are deliberately far under what the
# ledger could fill them with: on a corpus of 156 workstreams and 30-odd open debts, every
# one of these caps bites. Truncation is always announced -- see `capped` -- so a short
# list never reads as a complete one.
#
# An earlier set of these was 6/6/6/4, which is 22 spoken lines, and Kyle's verdict on it
# was the reason this file changed: "the goal is to keep track of the broad strokes of my
# work, not every singular commit everywhere". A cap that never bites is a cap in name.
CAPS = {
    "moved": int(os.environ.get("STANDUP_MOVED_MAX", "3")),
    "discussed": int(os.environ.get("STANDUP_DISCUSSED_MAX", "3")),
    # Caps the *asks* half of the blocked beat only -- the debts other people owe, which
    # are the lines the room is there to unstick. What Kyle owes is one clause built by
    # `self_debt_line` and sits outside this cap, as does the month-turned tail, because
    # neither can grow with the ledger.
    "blocked": int(os.environ.get("STANDUP_BLOCKED_MAX", "2")),
    "next": int(os.environ.get("STANDUP_NEXT_MAX", "2")),
}

# Where a debt stops being news and becomes weather. Past this a ledger row is no longer
# said every standup -- it is said on the standup where it turns another month, and is
# otherwise the morning brief's business. See `milestone_line`.
STALE_DAYS = int(os.environ.get("STANDUP_STALE_DAYS", "30"))

# The interval a stalled row is allowed to speak on. Once per this many days of silence,
# and never twice for the same crossing.
MILESTONE_DAYS = int(os.environ.get("STANDUP_MILESTONE_DAYS", "30"))

# A window this short means the page was rebuilt within minutes of a standup, so "nothing
# moved" is a fact about the clock rather than about the work, and saying it without the
# caveat would be the page's own stamp line said as an accusation.
JUST_OPENED_SECONDS = 90 * 60


def parse_days(raw):
    """The weekdays a standup happens on, as Python weekday numbers.

    Returns the fallback rather than raising on junk: a typo in `STANDUP_DAYS` should cost
    the correct cadence, not the whole page.
    """
    out, bad = [], []
    for tok in re.split(r"[,\s]+", (raw or "").strip().lower()):
        if not tok:
            continue
        n = DAY_NUMS.get(tok[:3])
        if n is None:
            bad.append(tok)
        elif n not in out:
            out.append(n)
    if not out:
        return sorted(DAY_NUMS[d] for d in ("mon", "wed", "fri")), (
            f"could not read STANDUP_DAYS={raw!r}" if raw else "")
    return sorted(out), (f"ignored {', '.join(bad)} in STANDUP_DAYS" if bad else "")


def parse_time(raw):
    m = re.match(r"^\s*(\d{1,2})[:.]?(\d{2})?\s*$", raw or "")
    if not m:
        return dtime(10, 30), (f"could not read STANDUP_TIME={raw!r}" if raw else "")
    h, mi = int(m.group(1)), int(m.group(2) or 0)
    if not (0 <= h <= 23 and 0 <= mi <= 59):
        return dtime(10, 30), f"STANDUP_TIME={raw!r} is not a time of day"
    return dtime(h, mi), ""


def zone(name):
    """The standup's timezone, or the machine's with a note saying so.

    The timezone is load-bearing and not a nicety: the whole window is defined by a wall
    clock in one city, and computing it in UTC on a laptop that travels would silently
    move the boundary by hours. Where the database is missing, saying which clock was used
    beats being confidently wrong in a way nothing on the page discloses.
    """
    if ZoneInfo is None:
        return None, "no zoneinfo on this python — using the machine's clock"
    try:
        return ZoneInfo(name), ""
    except Exception:
        return None, f"no timezone {name!r} on this machine — using the machine's clock"


def standup_at(day, days, at, tz):
    """The standup instants on and around one date, as an ordered list."""
    return [datetime.combine(day, at, tzinfo=tz)] if day.weekday() in days else []


def window(now, days, at, tz):
    """The interval this script covers, and the standup it is for.

    One rule, and it wants stating because the alternative readings are all worse: **the
    window opens at the most recent standup that has already happened, and runs to now.**

    At 09:00 on a Monday the last standup was Friday, so the window is Friday 10:30 to now
    and the notes are for the meeting in ninety minutes -- which is what he opened the page
    to prepare. At 11:00 that same Monday the meeting is over; the last standup is now this
    morning's, the window collapses to the half hour since it, and the notes are for
    Wednesday. Nothing switches mode and there is no "is he before or after" branch: the
    same sentence describes both, because "since the last one, for the next one" is what a
    standup interval *is*.

    The one rough edge is deliberate. Rebuild the page at 10:35 and the window is five
    minutes long and empty, correctly -- everything before it was said aloud five minutes
    ago. `JUST_OPENED_SECONDS` is what stops that reading as "you did nothing".
    """
    day, opened = now.date(), None
    for back in range(0, 15):                    # a fortnight covers any sane cadence
        d = day - timedelta(days=back)
        for inst in standup_at(d, days, at, tz):
            if inst < now:
                opened = inst
                break
        if opened:
            break
    nxt = None
    for fwd in range(0, 15):
        d = day + timedelta(days=fwd)
        for inst in standup_at(d, days, at, tz):
            if inst >= now:
                nxt = inst
                break
        if nxt:
            break
    return opened, nxt


def cadence(now=None):
    """The whole calendar answer: what the cadence is, what it covers, what it is for."""
    days, why_d = parse_days(os.environ.get("STANDUP_DAYS", DEFAULT_DAYS))
    at, why_t = parse_time(os.environ.get("STANDUP_TIME", DEFAULT_TIME))
    tzname = os.environ.get("STANDUP_TZ", DEFAULT_TZ)
    tz, why_z = zone(tzname)
    now = now or datetime.now(tz)
    if now.tzinfo is None:
        now = now.replace(tzinfo=tz)
    opened, nxt = window(now, days, at, tz)
    why = "; ".join(w for w in (why_d, why_t, why_z) if w)
    hhmm = at.strftime("%H:%M")
    secs = int((now - opened).total_seconds()) if opened else 0
    return {
        "days": days,
        "day_names": [DAY_NAMES[d][:3] for d in days],
        "time": hhmm,
        "tz": tzname if not why_z else "",
        "why": why,
        "now": now,
        "for": ({"iso": nxt.isoformat(), "day": DAY_NAMES[nxt.weekday()],
                 "when": f"{DAY_NAMES[nxt.weekday()]} {hhmm}"} if nxt else {}),
        "since": ({"iso": opened.isoformat(), "day": DAY_NAMES[opened.weekday()],
                   "when": f"{DAY_NAMES[opened.weekday()]} {hhmm}",
                   "epoch": int(opened.timestamp()),
                   "date": opened.date().isoformat(),
                   "seconds": secs, "ago": fmt_interval(secs)} if opened else {}),
        "just_opened": bool(opened) and secs < JUST_OPENED_SECONDS,
    }


# --------------------------------------------------------------------------- in the window
#
# Two clocks, and the difference between them is the one honest compromise in this file.
#
# Commits, sessions and Slack messages carry a real instant, so "did this happen after
# Monday 10:30" is answerable exactly. Merge dates, Jira `updated`, review-thread dates and
# ledger `asked` fields arrive as bare dates -- work-arcs truncates them at the source,
# because everywhere else on the page a day is the resolution anybody reads at.
#
# For a bare date the question is unanswerable at the boundary: a thread stamped the same
# day the window opened might be from an hour before it or six hours after. It is resolved
# toward *inclusion*, and the asymmetry is the argument -- mentioning something on Wednesday
# that you already mentioned on Monday costs a sentence, and forgetting what you did on
# Monday costs the thing the tool was built for.


def in_window(epoch, since):
    return bool(epoch) and bool(since) and epoch >= since.get("epoch", 0)


def date_in_window(datestr, since):
    """A bare `YYYY-MM-DD` against the window, resolved toward including it."""
    d = (datestr or "")[:10]
    return bool(d) and bool(since) and d >= since.get("date", "9999")


PERMA_RE = re.compile(r"/p(\d{10})(\d{6})")


def perma_epoch(url):
    """The instant a Slack permalink points at.

    Slack writes the message ts into the path as sixteen digits with the dot removed, so
    the precise time of a decision is recoverable from the link the lens already carries.
    That matters here more than anywhere else on the page: a thread runs for days and a
    block's own timestamps describe the thread, while a standup needs to know which of its
    conclusions were reached *in this window* and which were already said out loud.
    """
    m = PERMA_RE.search(url or "")
    return int(m.group(1)) if m else 0


# --------------------------------------------------------------------------- composition
#
# The parts convention is arc-morning's, unchanged, so arcs-page resolves a link the same
# way in both blocks: a plain string is text, and a dict is a span that becomes an anchor
# to a row on this page (`arc`), a row in an evidence list (`of` + `fp`) or an outside URL.


def span(t, **kw):
    return {"t": t, **{k: v for k, v in kw.items() if v}}


def text_of(parts):
    return "".join(p if isinstance(p, str) else p.get("t", "") for p in parts)


def line(parts, subs=None):
    parts = [p for p in parts if p != ""]
    return {"parts": parts, "text": text_of(parts),
            "subs": [s for s in (subs or []) if s]}


def capped(items, kind):
    """The first N, plus a line saying what the N left out.

    A cap that says nothing is indistinguishable from a complete list, and a standup given
    off a silently truncated list is one where the thing you forgot was cut by a constant.
    """
    n = CAPS.get(kind, 6)
    if len(items) <= n:
        return items
    rest = len(items) - n
    return items[:n] + [line([f"— {rest} more not listed"])]


def arc_name(arc):
    return ((arc.get("brief") or {}).get("name") or arc.get("label")
            or arc.get("id") or "unnamed")


def arc_ref(arc):
    """How the room refers to this work: its ticket if it has one, its name if not."""
    return arc.get("ticket") or ""


def arc_head(arc):
    """The workstream named the way it would be said: key first, then what it is.

    The key is dropped when the name already is it. arc-brief names an arc after its
    ticket whenever the ticket summary is the best description of the work, which is
    right and produced "UL-1918 UL-1918" here -- a stutter that reads as a bug in the
    page rather than as the two facts it was trying to be.
    """
    ref, name, aid = arc_ref(arc), arc_name(arc), arc.get("id")
    if ref and not name.upper().startswith(ref.upper()):
        name = f"{ref} {name}"
    # One span and not two. Both halves point at the same card, so two spans render as two
    # underlined links with a gap between them, which reads as two destinations.
    return [span(name, arc=aid)]


# --------------------------------------------------------------------------- moved


# The two rungs work-arcs phrases as a number. Everything else in `state` already arrives
# as a phrase a room understands -- "in review", "no longer merges", "approved, not
# merged", "still a draft", "pushed, no merge request" -- and is said in those words rather
# than in words of ours, because a second vocabulary for one rung is a second author for
# one judgement. These two it phrases as a count, and a count is the thing this beat is
# not allowed to say: "65 commits exist only here" is a number out of this page's own
# books, and the fact underneath it -- none of this is anywhere but the laptop -- is the
# part a reviewer can do something about.
#
# Not "finished, not yet published", which is the tempting phrasing and one this file has
# no standing to use: nothing upstream knows whether the work is finished. A rung says
# where the work has got to, not how far along it is.
COUNTED_RUNGS = {
    "local-only": "still unpushed",
    "pre-landing": "leftover drafts from before it landed",
}

# Rungs that are a statement about a merge request, so the MR number is the reference the
# room already shares and leads the clause: "!10554 no longer merges". The others are
# statements about a branch or about a laptop and have no number to lead with.
MR_RUNGS = {"in-review", "came-back", "no-reviewer"}


def rung_clause(arc, landed=()):
    """Where the work got to, in the fewest words that are true and no numbers at all.

    A landing inside the window displaces the rung, because it is the only thing that can
    happen to a branch that is finished: "!10416 landed" is the whole update and the rung
    it is on now is implied by it.

    Otherwise the rung is work-arcs' `state`, verbatim, with two substitutions and one
    addition. The substitutions are `COUNTED_RUNGS`. The addition is the MR number, in
    front, where the rung is about a merge request -- the room navigates by that number and
    not by the workstream's name, which is arc-brief's summary and exists nowhere else.

    `local-only` is the one rung that can be true at the same time as an open merge
    request, and work-arcs is explicit that this is not simply "in review": an arc holding
    a review *and* commits no remote has is on the lower rung. Both halves are said, in
    that order, because the unpushed half is the one nobody else can see.
    """
    if landed:
        b, f = landed[0]
        iid = f.get("iid")
        ref = span(f"!{iid}", url=f.get("url")) if iid else (b.get("name") or "a branch")
        verb = " landed" if f.get("state") == "merged" else " closed unmerged"
        return [ref, verb, f" (+{len(landed) - 1} more)" if len(landed) > 1 else ""]

    stage = arc.get("stage") or ""
    mrs = arc.get("mrs") or []
    ref = (span(f"!{mrs[0].get('iid')}", url=mrs[0].get("url")) if mrs else "")

    if stage in COUNTED_RUNGS:
        words = COUNTED_RUNGS[stage]
        if stage == "local-only" and ref:
            return [words + ", ", ref, " out for review"]
        return [words]
    words = arc.get("state") or "no visible change"
    return [ref, f" {words}"] if ref and stage in MR_RUNGS else [words]


def moved_beat(data, since, said=None):
    """What happened to the code: one workstream, one line, the rung it reached.

    Membership is `own_activity` -- work-arcs' own answer to "when did Kyle last commit or
    open a session here" -- against the window, plus any workstream whose MR landed inside
    it. The second clause matters: a branch you finished last week and a reviewer merged on
    Tuesday has no activity of yours in this window at all, and it is the single most
    standup-worthy thing that can happen to a piece of work.

    One line, not a line and a bullet list under it. The version that had sub-lines put the
    workstream's name on one line and "65 commits still local" on the next, which is the
    ledger indented: two lines to say one thing, and the thing they said was a number. The
    rung goes on the line itself, where it is the second half of a sentence.

    Order is landings first, then `own_activity` descending. Neither is a score invented
    here: the landing split is a fact each arc carries, and the recency inside each half is
    the same order the arcs list already arrived in. Landings lead because they are the
    only finished thing in the beat, and the freshest thing leads the rest because it is
    the one whose details you can still answer a question about.

    Ids of the workstreams this named are added to `said`, so `next_beat` can leave them
    out rather than restating them as today's plan.
    """
    out = []
    for arc in data.get("arcs") or []:
        own = arc.get("own_activity") or 0
        landed = [(b, (b.get("mr_fate") or {})) for b in arc.get("branches") or []]
        landed = [(b, f) for b, f in landed
                  if f.get("state") in ("merged", "closed")
                  and date_in_window(f.get("at"), since)]
        if not in_window(own, since) and not landed:
            continue
        landed.sort(key=lambda x: (x[1].get("at") or "", x[1].get("iid") or 0),
                    reverse=True)
        out.append((bool(landed), own, arc.get("id"),
                    line(arc_head(arc) + [" — "] + rung_clause(arc, landed))))

    out.sort(key=lambda x: (not x[0], -x[1], x[3]["text"]))
    # Only what was actually said. A workstream the cap cut was not mentioned, so `next` is
    # free to raise it -- the one case where two beats naming the same work is the point.
    if said is not None:
        said.update(aid for _, _, aid, _ in out[:CAPS.get("moved", 3)])
    return capped([ln for _, _, _, ln in out], "moved")


# --------------------------------------------------------------------------- discussed


# How much of a quoted question survives into a spoken note. The lens and GitLab both hand
# over the whole message, which is right for a card you read and wrong for a line you glance
# at mid-sentence: past about this much you lose your place looking for the end of it. The
# link is on the line, so the rest is one click away rather than gone.
QUOTE_MAX = int(os.environ.get("STANDUP_QUOTE_MAX", "110"))

# The same argument, shorter, for a Jira summary. A quote is the substance of its line and
# earns the room; a summary sits behind a key the room already recognises and is there to
# jog Kyle's memory, so it can be cut at the point where it stops doing that. Untrimmed,
# UL-1482 read out to the end of "report fails to load with 500 errors when both line &
# reference time range are active" -- a whole line of a two-minute update.
SUMMARY_MAX = int(os.environ.get("STANDUP_SUMMARY_MAX", "60"))


def clip(text, n=None):
    t = " ".join((text or "").split())
    n = n or QUOTE_MAX
    return t if len(t) <= n else t[:n].rsplit(" ", 1)[0] + "…"


def discussed_beat(data, since, said=None):
    """What got worked out, in Slack and in review threads.

    This is the half of the work a commit log cannot show and the half a standup most
    wants. "We settled that the geo_filter pushes down to Postgres" is the outcome of two
    days of thinking; the commit that follows it is a diff.

    Slack items are windowed on the permalink of the message being quoted rather than on
    the thread, because a thread runs for a week and its conclusions do not: a decision
    reached last Tuesday in a thread somebody replied to this morning was already said at
    the last standup, and repeating it is how these notes stop being listened to.

    Review threads are windowed on either end -- somebody asked in the window, or you
    answered in it -- and the two are different sentences. `me` comes down the wire from
    work-arcs, which resolved it against GitLab; there is nothing here to guess with.
    """
    me = (data.get("me") or "").lower()
    out = []

    for arc in data.get("arcs") or []:

        for blk in arc.get("slack") or []:
            chan = "#" + (blk.get("channel") or "") if blk.get("channel") else "a DM"
            for side, word in (("decided", "settled"), ("open", "still open")):
                for it in blk.get(side) or []:
                    at = perma_epoch(it.get("url")) or perma_epoch(blk.get("url"))
                    if not in_window(at, since):
                        continue
                    who = it.get("who") or ""
                    # No arc name on the line. It was there and it was the longest thing
                    # on it, restating in this page's vocabulary what the channel and the
                    # sentence had already said in the room's -- and a line you cannot get
                    # to the end of is one you skip while talking.
                    out.append((at, line(
                        [span(chan, url=it.get("url") or blk.get("url")),
                         f" {word}: ", clip(it.get("what")),
                         f" — {who}" if who else ""])))

        for m in arc.get("mrs") or []:
            ref, url = f"!{m.get('iid')}", m.get("url")
            for t in m.get("threads") or []:
                author, last_by = t.get("author") or "", (t.get("last_by") or "").lower()
                quote = clip((t.get("quote") or "").strip().rstrip("."))
                mine = bool(me) and last_by == me
                if mine and date_in_window(t.get("last_at"), since):
                    said = f" answered {author}" if author else " answered"
                elif date_in_window(t.get("at"), since) and not mine:
                    said = f" {author} asked" if author else " asked"
                else:
                    continue
                out.append((0, line([span(ref, url=url), said,
                                     f": {quote}" if quote else "",
                                     "" if t.get("answered") or mine
                                     else " — unanswered"])))

    # Commitments this stage did not make and cannot rank: work-arcs closed them on
    # evidence, in its own order, and they are said in it.
    for c in (data.get("ledger") or {}).get("you_owe_closed") or []:
        # `promised` is what he said he would do and `closed_by` is the evidence work-arcs
        # accepted that he did it. Both, because "I said I'd look at the MR and I did" is
        # one of the few things at a standup that is worth saying about the past.
        #
        # Windowed on when it was *closed* and not on when it was promised. A commitment
        # made three weeks ago and delivered on Tuesday is Tuesday's news; the version of
        # this that read `asked` put every commitment ever closed into every standup,
        # which is how a beat stops being about an interval.
        at = int(float(c.get("closed_ts") or 0))
        if not in_window(at, since):
            continue
        promised = clip(c.get("promised") or c.get("title") or "")
        if not promised:
            continue
        out.append((at, line([f"closed: {promised}",
                              f" — {clip(c.get('closed_by'), 80)}"
                              if c.get("closed_by") else ""])))

    out.sort(key=lambda x: (-x[0], x[1]["text"]))
    return capped([ln for _, ln in out], "discussed")


# --------------------------------------------------------------------------- blocked


def who_of(row, cap=3):
    """The person on the other end, whether the ledger named one or a review panel.

    `review-silence` carries the whole reviewer list, which is right for the ledger and
    unsayable at a standup: five names read aloud is a list, and what the room needs is
    who to look at plus how many others. A panel of one is just a person.
    """
    who = row.get("who")
    if isinstance(who, (list, tuple)):
        names = [str(w) for w in who if w]
        if not names:
            return "no one"
        head = ", ".join(names[:cap])
        return head + (f" +{len(names) - cap}" if len(names) > cap else "")
    return str(who or "someone")


# Ledger refs that identify a kind of place rather than a place. `!10408` and `UB-6663`
# are things you can say and somebody can go to; two rows both reading "DM (6d)" name
# nothing at all, and the person is the only handle a DM has.
VAGUE_REFS = {"DM", "dm", ""}


def ref_span(row):
    ref = row.get("ref") or ""
    if ref in VAGUE_REFS:
        who = row.get("who")
        ref = (who if isinstance(who, str) else "") or ref
    return span(ref, of="ledger", fp=row.get("fp"), url=row.get("url")) if ref else ""


def age_of(row):
    days = row.get("days")
    return f" ({days}d)" if isinstance(days, int) and days else ""


# The ledger's kinds, in the order a standup gives them, each with the two sentences it is
# said in: one for a handful, which names them all, and one for a pile, which names the
# worst and counts the rest. Two templates rather than one clever one, because "I owe a
# review on 9" is what one template produces and it is not English.
#
# Everything the room can unstick comes before everything Kyle owes, because the ask is the
# only part of a standup that needs the other people to be in the room -- and his own debts
# are said straight after, out loud, because an ask from someone who volunteers what he is
# sitting on is an ask that gets taken seriously. Said once, though, in one clause: the
# version that gave each `you` kind its own line read out four consecutive sentences about
# Kyle's inbox, which is a status report to a room that came to hear an ask. Only the first
# of the four templates below is ever used -- see `self_debt_line`.
#
# The grouping itself is the fix for the shape this beat had first, which was twenty-nine
# lines: eleven of them "nobody has reviewed !104xx", differing only in a number. That is
# one sentence about one problem, and reading it eleven times buries the two rows next to
# it that were about something else. Grouping is a partition on the `kind` each row already
# carries -- not a re-ranking -- and inside every group the ledger's worst-first order is
# preserved exactly, so the row this names is the row work-arcs would have named.
DEBT_GROUPS = [
    ("they", "review-silence",
     "nobody has reviewed {refs}", "nobody has reviewed {n} MRs — oldest {refs}",
     "reviewers "),
    ("they", "ticket-stalled",
     "sitting with someone else: {refs}",
     "{n} tickets sitting with other people — oldest {refs}", ""),
    ("you", "review-owed",
     "I owe a review on {refs}", "I owe {n} reviews — oldest {refs}", ""),
    ("you", "reply-owed",
     "I owe a reply on {refs}", "I owe {n} replies — oldest {refs}", ""),
    ("you", "slack-mention",
     "waiting on me in Slack: {refs}",
     "{n} Slack threads waiting on me — oldest {refs}", ""),
    ("you", "slack-dm",
     "waiting on me in a DM: {refs}", "{n} DMs waiting on me — oldest {refs}", ""),
]

# Where a handful stops being a handful. Three references is still a sentence a person can
# say without losing the end of it; four is a list, and a list wants counting instead.
FEW = 3


def fill(tpl, rows, n):
    """One template, with the reference spans dropped into its `{refs}` hole.

    The spans cannot be formatted in as text -- they are what the page turns into links to
    the ledger row each one came from -- so the template is split around the placeholder
    and the parts are assembled either side of them.
    """
    before, _, after = tpl.replace("{n}", str(n)).partition("{refs}")
    parts = [before]
    for i, r in enumerate(rows):
        if i:
            parts.append(", ")
        parts += [ref_span(r), age_of(r)]
    parts.append(after)
    return parts


def group_line(rows, few, many, who_label):
    """One group of debts as one thing to say.

    Under four they are all named, because four references is still a sentence. Past that
    the first is named -- the ledger's own worst -- and the rest are counted, which is the
    form a person actually uses out loud: "the oldest is eighteen days and there are ten
    behind it".

    The person is appended only where the whole group shares one, since "reviewers brian,
    vadym, ajit +2" said once about ten MRs is a fact and said about a group of three
    different panels is a guess.
    """
    few_enough = len(rows) <= FEW
    parts = fill(few if few_enough else many,
                 rows if few_enough else rows[:1], len(rows))
    who = {who_of(r) for r in rows} if few_enough else {who_of(rows[0])}
    # Not when the reference already is the person. A DM has no ref of its own, so
    # `ref_span` falls back to whoever is in it, and appending the name again gives
    # "waiting on me in a DM: billcheung — billcheung".
    if len(who) == 1 and who != {"someone"} and next(iter(who)) not in text_of(parts):
        parts.append(f" — {who_label}{who.pop()}")
    return line(parts)


# Which of his own debts leads the one clause he gets. Not the ledger's worst, and the
# departure wants justifying: the ledger ranks by what will cost Kyle most, and a standup
# ranks by what the room is actually waiting on. What his teammates chase him for is
# reviews -- they never chase his in-flight code -- so a review he owes is the one self-debt
# with a claim on the meeting. A Slack DM he has not answered is his own business and the
# morning brief's; it is counted here and not named.
SELF_ORDER = ["review-owed", "reply-owed", "slack-mention", "slack-dm"]


def self_debt_line(rows):
    """Everything Kyle owes, as one thing to say.

    The kind the room is waiting on is named with its reference and its age, in the same
    two templates every other group uses; everything else he owes is one number on the end
    of it. "I owe 8 reviews — oldest !10408 (17d) — vadym; 11 more waiting on me" is a
    sentence a person says. The four-line version of it was a list of categories, and a
    list of categories is what a ledger is for.

    Nothing is dropped -- the tail counts every remaining row -- but nothing beyond the
    lead group is named, because a name in this beat is an invitation to discuss it and the
    only one worth discussing at a standup is the review somebody is blocked on.
    """
    if not rows:
        return None
    groups = {}
    for r in rows:
        groups.setdefault(r.get("kind"), []).append(r)
    # Known kinds in the order above; anything new upstream falls in behind them in the
    # ledger's own order, so a kind this file has never heard of can still lead the clause
    # when it is the only thing he owes.
    order = ([k for k in SELF_ORDER if k in groups]
             + [k for k in groups if k not in SELF_ORDER])
    lead = groups[order[0]]

    tpl = next(((few, many, wl) for side, kind, few, many, wl in DEBT_GROUPS
                if side == "you" and kind == order[0]), None)
    if tpl:
        parts = group_line(lead, *tpl)["parts"]
    else:
        parts = [f"I owe {who_of(lead[0])}: ", ref_span(lead[0]), age_of(lead[0])]

    rest = len(rows) - len(lead)
    return line(parts + ([f"; {rest} more waiting on me"] if rest else []))


def window_days(since):
    """The window in whole days, rounded up.

    Up, and not to the nearest: the ledger's `days` is an integer work-arcs truncated at
    the source, so the only safe comparison against it is one that cannot land short. A
    window rounded down would step over the day a stall turns a month and that crossing
    would never be said at all -- which is the failure the whole tail line exists to avoid.
    """
    secs = since.get("seconds") or 0
    return max(1, -(-int(secs) // 86400))


def milestone_line(rows, since):
    """A long stall, said on the standup where it turns another month.

    This replaces a line that read "still open, unchanged: DE-2585 (159d), UB-6663 (116d),
    UB-5628 (69d), !10272 (39d)" and was, by construction, identical on every standup for
    as long as those tickets sat there -- the fortieth-consecutive-time failure the module
    docstring names, in the one place in this file that was actually committing it. Nothing
    on that line was news; three of the four were months past anybody's ability to be
    surprised by them.

    A crossing is news, and it is news exactly once. A row is said on the standup whose
    window contains the day its silence passed a multiple of `MILESTONE_DAYS`, and windows
    do not overlap -- each opens at the standup the last one closed on -- so the same
    crossing cannot be reported twice. Between crossings the row is silent here and loud
    in the morning brief, which is the surface built for a cost only Kyle is carrying.
    """
    span_d = window_days(since)
    turned = [r for r in rows
              if isinstance(r.get("days"), int) and r["days"] > STALE_DAYS
              and r["days"] // MILESTONE_DAYS > (r["days"] - span_d) // MILESTONE_DAYS]
    if not turned:
        return None
    parts = ["another month with no movement: "]
    for i, r in enumerate(turned[:FEW]):
        if i:
            parts.append(", ")
        parts += [ref_span(r), age_of(r)]
    if len(turned) > FEW:
        parts.append(f", +{len(turned) - FEW} more")
    return line(parts)


def blocked_beat(data, since, said=None):
    """The asks the room can act on, then one clause for everything Kyle owes.

    The ledger arrives sorted worst-first and that order is not re-litigated here. What
    this does is *partition* it -- by side, so an ask comes before a confession; by kind, so
    eleven unreviewed MRs are one sentence; and by age, so a five-month stall is not read
    out in front of a five-day one.

    The age split is on a threshold rather than on a competing score, and it exists because
    the failure it fixes is specific and fatal to the tool. `they_owe` is led by a 159-day
    ticket stall, correctly: it is the largest open loop Kyle has. Read that out on Monday,
    Wednesday and Friday for five months and the room learns that these notes open with
    something nobody is going to do anything about, and stops listening before the item
    somebody could have fixed on the call. So the stalled rows are still said -- dropping
    them would let a real stall go quiet -- but on the day they change and not on the forty
    days they do not. See `milestone_line`.

    Three lines at the outside, and usually two: the asks (capped, because they are the
    only half that can grow into a list), the one clause for what he owes, and the tail on
    the rare standup where a stall turns a month.
    """
    led = data.get("ledger") or {}
    they = list(led.get("they_owe") or [])
    mine = list(led.get("you_owe") or [])

    def live(rows):
        return [r for r in rows
                if not (isinstance(r.get("days"), int) and r["days"] > STALE_DAYS)]

    asks, owed = live(they), live(mine)

    out, claimed = [], set()
    for side, kind, few, many, who_label in DEBT_GROUPS:
        if side != "they":
            continue
        grp = [r for r in asks if r.get("kind") == kind]
        if not grp:
            continue
        claimed.add(kind)
        out.append(group_line(grp, few, many, who_label))
    # Anything the table above has no phrase for is still said, in the ledger's own words,
    # rather than silently dropped: a new kind upstream must not make this beat quieter.
    for r in asks:
        if r.get("kind") in claimed:
            continue
        out.append(line([f"waiting on {who_of(r)}: ", ref_span(r), age_of(r)]))

    out = capped(out, "blocked")
    for extra in (self_debt_line(owed), milestone_line(they + mine, since)):
        if extra:
            out.append(extra)
    return out


# --------------------------------------------------------------------------- next


def next_beat(data, since, said=None):
    """What is in front of you — offered as a prompt, because it cannot be derived.

    Nothing in this pipeline knows Kyle's intentions, and a page that stated them would be
    guessing in the one beat where a standup is a commitment to other people. What it does
    know is what he was in the middle of and what the board says is his, and those two put
    together are enough to remember the answer from.

    The board leads and the workstreams fill in behind it, which is the reverse of how this
    beat was first written and the reverse for a reason. It used to open with the two most
    recent arcs unconditionally -- which are, by definition, the two `moved` had just
    listed -- so half of it was the previous beat repeated, in the phrasing that made it
    worst: "65 commits exist only here", twice inside eight lines. Now `moved` says where
    each workstream got to, and the only thing left for this beat that `moved` did not
    already cover is what the board says is his.

    So a workstream appears here only in the room left under the cap, and only if `moved`
    did not name it: on a fresh window, where `moved` is empty because the last standup was
    an hour ago, that is the whole beat and it is the right one. Being cut by the cap is not
    the same as being said, so the fourth workstream is still eligible here.

    Sprint tickets that are handed off are excluded on purpose: `handed_off` is work-arcs'
    word for "the status says this is somebody else's move now", and reading one out as
    today's plan is how you promise a room something you are waiting on them for.
    """
    out = []
    for it in (data.get("sprint") or {}).get("issues") or []:
        if it.get("done") or it.get("handed_off"):
            continue
        out.append(line([span(it.get("key", ""), url=it.get("url")),
                         f" {it.get('status') or ''}",
                         f" — {clip(it.get('summary'), SUMMARY_MAX)}"
                         if it.get("summary") else ""]))

    # Filler, and it fills rather than queues: an arc pushed past the cap would spend the
    # beat's one truncation line on something `moved` had covered two lines earlier.
    room = CAPS.get("next", 2) - len(out)
    arcs = sorted((a for a in data.get("arcs") or [] if a.get("own_activity")),
                  key=lambda a: -(a.get("own_activity") or 0))
    for arc in arcs:
        if room <= 0:
            break
        if arc.get("settled") or arc.get("stage") == "parked":
            continue
        if arc.get("id") in (said or ()):
            continue
        out.append(line(arc_head(arc) + [" — "] + rung_clause(arc)))
        room -= 1
    return capped(out, "next")


# --------------------------------------------------------------------------- assembly

BEATS = [("moved", "moved", moved_beat),
         ("discussed", "discussed", discussed_beat),
         ("blocked", "blocked / asks", blocked_beat),
         ("next", "in front of you", next_beat)]


def as_text(st):
    """The notes as they read — the same string the page's copy button hands over.

    Composed once, here, rather than once here and once in the renderer. Two projections of
    one composition is how the thing on the screen and the thing on the clipboard end up
    disagreeing about what you did on Tuesday.
    """
    head = st.get("for") or {}
    since = st.get("since") or {}
    out = [f"FOR {head.get('day','the next').upper()}'S STANDUP"
           + (f" — since {since.get('when')}" if since.get("when") else "")]
    if st.get("note"):
        out.append(f"({st['note']})")
    for b in st.get("beats") or []:
        if not b.get("items"):
            continue
        out += ["", b["lead"].upper()]
        for it in b["items"]:
            out.append("  " + it["text"])
            for s in it.get("subs") or []:
                out.append("    " + s["text"])
    if not any(b.get("items") for b in st.get("beats") or []):
        out += ["", "  nothing to report in this window"]
    return "\n".join(out) + "\n"


def build(data, now=None):
    cad = cadence(now)
    since = cad.get("since") or {}
    # What a beat has already said, so a later one does not say it again. Passed rather
    # than returned because only one pair of beats cares -- `moved` fills it, `next` reads
    # it -- and a return value threaded through all four would put the coupling everywhere
    # instead of in the two docstrings that explain it. BEATS' order is the standup's
    # order, so a beat can only ever be told about beats that come before it.
    said = set()
    beats = []
    for kind, lead, fn in BEATS:
        items = fn(data, since, said) if since else []
        beats.append({"kind": kind, "lead": lead, "items": items})

    note = ""
    # Said whenever the window is short, not only when it came back empty. "There is one
    # thing here because the last standup was an hour ago" and "there is one thing here
    # because you did one thing since Friday" are very different facts to stand up on.
    if cad.get("just_opened"):
        ago = since.get("ago") or "moments"
        note = (f"this window opened {ago} ago — everything before it was said at "
                f"{since.get('when', 'the last standup')}")
    elif cad.get("why"):
        note = cad["why"]

    st = {
        "v": 1,
        "cadence": {k: cad[k] for k in ("days", "day_names", "time", "tz", "why")},
        "for": cad.get("for") or {},
        "since": since,
        "beats": beats,
        "empty": not any(b["items"] for b in beats),
        "note": note,
        "source": "deterministic",
    }
    st["text"] = as_text(st)
    return st


def main():
    p = argparse.ArgumentParser(
        description="Assemble the next standup's notes from a work-arcs graph.")
    p.add_argument("--from", dest="src", default="",
                   help="read the graph from a file instead of stdin")
    p.add_argument("--out", default="", help="write to a file instead of stdout")
    p.add_argument("--text", action="store_true",
                   help="print the notes instead of the graph")
    p.add_argument("--at", default="",
                   help="pretend it is this instant (ISO 8601), to see any standup's "
                        "window without waiting for it")
    args = p.parse_args()

    now = None
    if args.at:
        try:
            now = datetime.fromisoformat(args.at)
        except ValueError:
            sys.exit(f"arc-standup: --at {args.at!r} is not an ISO 8601 instant")

    raw = Path(args.src).read_text() if args.src else sys.stdin.read()
    try:
        data = json.loads(raw)
    except ValueError as e:
        sys.exit(f"arc-standup: the graph on {args.src or 'stdin'} is not JSON ({e}). "
                 "Nothing upstream of here wrote it as JSON, so there are no notes to "
                 "assemble and no payload to pass on.")
    if not isinstance(data, dict):
        sys.exit(f"arc-standup: the graph on {args.src or 'stdin'} parsed as "
                 f"{type(data).__name__}, not the object arc-brief passes on — there is "
                 "nothing here to assemble notes from")

    data["standup"] = build(data, now)
    st = data["standup"]
    said = sum(len(b["items"]) for b in st["beats"])
    print(f"  standup: {said} line" + ("" if said == 1 else "s")
          + f" for {(st.get('for') or {}).get('day', '?')}"
          + (f", since {(st.get('since') or {}).get('when', '?')}" if st.get("since")
             else ""), file=sys.stderr)

    out = st["text"] if args.text else json.dumps(data, indent=1) + "\n"
    if args.out:
        Path(args.out).write_text(out)
    else:
        sys.stdout.write(out)


if __name__ == "__main__":
    main()
