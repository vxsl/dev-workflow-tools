#!/usr/bin/env python3
"""Name an arc and say what it is, from the evidence the arc already carries.

Everything upstream of this is deterministic: arc-cluster groups branches by the files
they touched, work-arcs joins branches to stashes, MRs, sessions and tickets. That
pipeline is a very good *extraction* layer with no *interpretation* layer at all, which
is why its output reads as a spreadsheet -- every number on an arc card is an input to a
judgement that nothing ever made.

The deterministic name is the specific failure. arc-cluster picks the first branch in
iteration order that contains a ticket key, so the arc holding UL-1640, UL-1440, UB-6944
and the impedance work is called `DE-3101` after one pushed branch inside it. That name
is not merely terse, it misrepresents the contents.

So: assemble each arc's evidence -- the stacking tree, commit subjects, MR titles, ticket
summaries, stashed files, and the prompts recorded against its sessions -- and have a
model write a name and two sentences. Cached on a fingerprint of that evidence, so the
inference is auditable, recomputes exactly when the work moves, and costs nothing on a
re-run that changed nothing.

Reads work-arcs --json on stdin (or --from FILE), writes the same JSON with each arc's
`brief` filled in. Read-only with respect to the work repo; the only thing it writes is
its own cache under $XDG_STATE_HOME/work-arcs/briefs.json.

    work-arcs --json | arc-brief | arcs-page -
    arc-brief --from arcs.json --refresh     # ignore the cache
"""

import argparse
import collections
import concurrent.futures as futures
import hashlib
import json
import os
import re
import subprocess
import sys
import threading
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import headless_claude  # noqa: E402
from statefile import load_store  # noqa: E402

STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "work-arcs"
CACHE = STATE / "briefs.json"
TURNS = STATE / "turns.jsonl"

# How long a brief nothing has asked for is kept. The cache is keyed on the evidence, the
# model and the prompt together, so every prompt reword and every model switch retires the
# whole generation before it in one go -- correctly, since a brief written by another model
# from another question is not this one's to serve. What was missing is the other half of
# that: nothing ever removed the generation being retired. Three weeks and a handful of
# prompt edits had left 914 entries carrying their full evidence text for 157 live arcs,
# about 2MB of answers to questions no longer being asked.
#
# By last use rather than by age, because the two differ exactly where it matters: an arc
# you have not touched since June is still a cache hit the day you return to it, and its
# brief should still be there. A month is well past the point where a prompt revision might
# be reverted, and well short of the horizon on which real work goes quiet.
CACHE_KEEP_DAYS = int(os.environ.get("ARC_BRIEF_KEEP_DAYS", "30"))

# Naming an arc from mixed evidence is a judgement, not an extraction, and a bad name
# here reproduces exactly the failure this tool exists to fix. `claude -p` resolves the
# alias, so there is no model id to keep in sync.
#
# Two defaults, because the two passes carry different risk. A blinded 15-arc A/B on
# identical evidence (2026-08-14) found brief names and summaries indistinguishable
# between opus and sonnet — sonnet even read landed-vs-residue status better twice —
# and briefs are ~90% of the pipeline's call volume, so they take the 5x cheaper
# model. The split pass keeps opus: a wrong split is exactly as damaging as a wrong
# merge (item 1c), splits are rare, and cheap configurations have been measured
# fabricating judgements (the thread lens's MAX_THINKING_TOKENS note).
DEFAULT_MODEL = os.environ.get("ARC_BRIEF_MODEL", "sonnet")
DEFAULT_SPLIT_MODEL = os.environ.get("ARC_SPLIT_MODEL", "opus")

PROMPT = """\
You are naming a unit of software work so an engineer can recognise it at a glance.

Below is everything one arc contains: branches (with the branch each was cut from),
commit subjects, merge request titles, Jira tickets, stashed file paths, and prompts the
engineer typed while working on it. These artifacts were grouped together because they
touch the same files -- the grouping is reliable, the existing label is not.

Read the branch annotations literally and do not go beyond them:

- `[THE WORK]` marks the branch that IS this arc -- normally the source branch of its
  merge request. Describe the arc as that branch's change. The others are its history.
- **Name the arc for what is still outstanding, not for what has finished.** A branch marked
  ALREADY MERGED or ABANDONED is done; its commit subjects are here as context for what the
  remaining work sits on top of. If the merged branches were about one thing and the
  unmerged ones about another, the arc is named after the unmerged ones. An engineer reading
  a name that describes finished work will believe the whole arc is finished.
- A branch marked as a superseded copy holds commits that already exist on the branch
  named. It is a cherry-pick, a pre-squash remnant or an abandoned rebase. It is NOT a
  second piece of work, NOT work happening elsewhere, and NOT something left undone.
- `(no parent in this arc)` means only that git records no ancestry. It does NOT mean the
  branch is unrelated to the others, and it is not evidence that work was done separately
  or left unstacked. Never infer separation from a missing edge.
- Where the same commit subject appears against two branches, that is one change written
  down twice. Say what the change is, once.

Return ONLY a JSON object, no prose and no code fence:

{"name": "...", "summary": "...", "blocker": "..."}

name     What the OUTSTANDING work IS, 3-7 words, in the engineer's own vocabulary as it
         appears in the evidence. Not a ticket key, not a branch name, not a file path. Say
         the subject matter. Good: "Dove catalog gating and dual-map neighborhoods". Bad:
         "UL-1632", "various fixes", "frontend work".
         Be specific enough to tell this arc from a neighbouring one. Several arcs in this
         repo touch lat/lng geometry in metadata, and generic names made four of them nearly
         indistinguishable on the page -- two of which were finished. Name the particular
         thing this arc does: which layer, which consumer, which stage of the change.
summary  Two sentences on what this work is doing and where it stands. Concrete: name
         the actual behaviour being changed. Draw on the prompts -- they say what the
         engineer was chasing in a way branch names never do. Never restate the counts
         you were given; the reader can already see them.
blocker  One short clause naming the single thing most in the way, and only what the
         evidence states. If a merge request is marked as no longer merging, that is the
         blocker. If a thread is quoted as unresolved, that is the blocker. Prefer whatever
         needs the engineer personally over anything waiting on a reviewer: an MR sitting
         in review with nothing outstanding is not a blocker, it is the normal end state.
         Empty string if nothing stands out. No hedging, no advice.

Evidence:
{evidence}
"""

SPLIT_CACHE = STATE / "splits.json"

# Editing the text below retires the whole cached generation: the fingerprint keys on the
# prompt as well as the evidence, deliberately, because a reworded question silently
# reusing an old reply is the one way a cache keyed on evidence can still go stale. So an
# edit here is not free, and the price is worth knowing before making one. Measured on the
# run that bought the `uncertain` field: 48 arcs to re-decide, 22 of them large enough for
# three votes, 104 headless calls, $28.68 at list prices and about $28 of that opus. The
# split pass kept opus after the A/B (bec7348) and this is what that costs to re-buy.
SPLIT_PROMPT = """\
You are deciding whether a group of git branches is one body of work or several.

They were grouped because they edit the same files, and that signal has a limit it
cannot pass: two tickets that touch the same module look identical by files however the
weights are set. Measured case -- one branch migrated the metric catalogs onto a new
adaptive-trend constructor while another hardened a lint rule about reference stability
in those same catalogs. Same files, unrelated intentions. Only the content of the changes
separates them, which is why you are being asked.

Below is each branch with its commit subjects and any ticket it names.

Return ONLY a JSON object, no prose and no code fence:

{"bodies": [{"name": "...", "branches": ["...", "..."]}], "uncertain": ["..."]}

- These branches were grouped because they edit the same files, and nothing more. That
  is weak evidence of shared intent and it is the only evidence behind the grouping.
  Splitting work that belongs together is as damaging as merging work that does not, so
  decide from the commits rather than from a prior in either direction.
- Do NOT split a stack, a rebase, or the variants of one change. `x-bak`,
  `x-before-squash`, `backup/x`, `x-preX`, `x-wip` are the SAME work as `x`. Successive
  refinements of one feature are one body however many branches they took.
- A branch annotated as a copy of another has been VERIFIED to hold commits that already
  exist on that branch. Keep it with the branch it copies, always. Repeated commit subjects
  across branches mean one change recorded twice, never two efforts at the same goal.
- `[the branch under review]` marks the branch carrying the merge request. Whatever it does
  is the main body of this group; put a branch elsewhere only if its commits serve a
  different goal from that one.
- Do NOT split because branches touch different files or different parts of a feature.
  Work spreads across a codebase; that is normal and not a second body.
- DO split when a branch's commits are plainly in service of a different goal -- another
  ticket that merely visits the same module, an unrelated hotfix, a drive-by fix
  committed while something else was checked out.
- `[commits name UB-1234]` is the ticket that branch's own commits are filed under. Two
  branches under different tickets are usually two bodies, and that is the single most
  reliable signal here -- but it is evidence, not a rule. A stack carries one ticket's
  commits across branches named for another, and unticketed branches are ordinary. Weigh
  it against the commits; do not apply it mechanically.
- If a split would leave a body of one branch, be sure that branch really is separate
  work rather than a stray commit belonging to the main body.
- Every branch listed must appear in exactly one body. Use branch names exactly as given.
- name: 3-7 words saying what that body IS, in the vocabulary of its own commits.
- uncertain: branches you KEPT in a body but could not justify keeping from the commits
  you were shown. Not the ones you split -- those you decided. Not the ones you are
  confident about. Only the ones where you had to guess, and a person who knows the work
  would settle it in a second. Almost always empty; an empty list is the normal answer
  and there is no credit for filling it. Never list more than two. Every name here must
  also appear in a body above.

Branches:
{evidence}
"""


def load_turns():
    """Session id -> the prompts typed in it. The richest description source there is.

    A branch name is chosen in one second before the work starts; a prompt is what the
    engineer actually said they were trying to do, at the moment they were doing it.
    """
    by_session = {}
    if not TURNS.exists():
        return by_session
    for line in TURNS.open(errors="replace"):
        line = line.strip()
        if not line:
            continue
        try:
            row = json.loads(line)
        except json.JSONDecodeError:
            continue
        sid, prompt = row.get("session"), (row.get("prompt") or "").strip()
        if sid and prompt:
            by_session.setdefault(sid, []).append(prompt)
    return by_session


def commit_subjects(repo, branch, main, limit=6):
    try:
        out = subprocess.run(
            ["git", "-C", str(repo), "log", "--format=%s", f"-{limit}",
             f"{main}..{branch}"],
            capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return []
    return [x for x in out.stdout.splitlines() if x.strip()]


def spawn_tree(branches):
    """The stacking edges, rendered as the tree they are.

    work-arcs derives `parents` for every branch and the page throws it away. An arc is
    not a bag of branches -- it is a few chains and some orphans, and which is which is
    most of what you want to know about it.

    Two more relations belong here, and leaving them out produced a brief that was
    confidently wrong. For UL-1634 this printed "(no parent in this arc)" against both the
    MR branch and a one-commit cherry-pick of one of its commits, and the model read the
    absence of an edge as evidence of independence: it reported "the lint work on a separate
    branch that isn't stacked onto the fix" when all four commits of the MR *are* the lint
    work. Neither branch is a parent of the other; they are the same change twice. So say
    which branch is the work, and say which branches are copies -- absence of a parent means
    only that, and the model should not have to infer the rest.
    """
    names = {b["name"] for b in branches}
    lines_out = []
    for b in branches:
        parents = [p for p in (b.get("parents") or []) if p in names and p != b["name"]]
        marks = []
        if b.get("authoritative"):
            marks.append("THE WORK")
        fate = (b.get("mr_fate") or {}).get("state")
        if fate == "merged":
            # Without this the namer cannot tell finished branches from live ones, and it
            # named an arc "Per-stream catalog gating with on-screen metadata first" after
            # the two branches that had already merged -- while the four branches actually
            # outstanding were about hydrating time filters and prioritising stream
            # metadata. The card then read as work that was already done.
            marks.append("ALREADY MERGED — finished, not outstanding")
        elif fate == "closed":
            marks.append("ABANDONED — its merge request was closed")
        if b.get("superseded_by") in names:
            marks.append(f"{b.get('superseded_kind', 'duplicate')} already on "
                         f"{b['superseded_by']} — a superseded copy, not separate work")
        tail = f"  [{'; '.join(marks)}]" if marks else ""
        if parents:
            lines_out.append(f"  {b['name']} <- cut from {', '.join(parents[:3])}{tail}")
        else:
            lines_out.append(f"  {b['name']} (no parent in this arc){tail}")
    return lines_out


def evidence_for(arc, repo, main, turns):
    """Everything known about one arc, in a stable order so the fingerprint is stable."""
    out = []
    # 14 meant a 39-branch arc was described from a third of itself, and the branch list is
    # where the stacking, the variants and the duplicates live -- the part a name most needs.
    branches = arc.get("branches", [])[:30]

    if arc.get("issues"):
        out.append("Jira tickets:")
        for i in arc["issues"][:5]:
            out.append(f"  {i.get('key','?')} [{i.get('status','?')}] {i.get('summary','')}")

    if arc.get("mrs"):
        out.append("Merge requests:")
        for m in arc["mrs"][:5]:
            draft = " (draft)" if m.get("draft") else ""
            out.append(f"  !{m.get('iid','?')}{draft} {m.get('title','')}"
                       f" [branch {m.get('branch','?')}]")
            # The state that says whose turn it is. A blocker naming a stalled review when
            # the MR is actually unmergeable, or unpushed commits when the real hold-up is
            # four unanswered questions, is a wrong blocker -- and one wrong reminder costs
            # more than ten right ones earn.
            state = []
            if m.get("conflicts"):
                state.append(f"NO LONGER MERGES into {m.get('target') or 'main'}")
            if m.get("approved") and m.get("qualifying"):
                # Both halves, because either alone misleads. "Approved and still open"
                # had the model writing "approved and waiting to merge" about a branch
                # QA was in the middle of testing; the status alone would lose that the
                # review is finished and only the verdict is outstanding.
                state.append(f"approved; QA has the branch ({m['qualifying']}) and the "
                             "merge waits on their verdict")
            elif m.get("approved"):
                state.append("approved and still open")
            pipe = m.get("pipeline") or {}
            if pipe.get("status") and pipe["status"] != "success":
                state.append(f"pipeline {pipe['status']}")
            if state:
                out.append(f"      {'; '.join(state)}")
            for t in m.get("threads", []):
                out.append(f"      unresolved thread from {t['author']} ({t['at']}): "
                           f"{t['quote']}")

    if arc.get("authoritative"):
        out.append(f"The branch that IS this work: {arc['authoritative']} "
                   f"({arc.get('authoritative_via','')})")

    out.append("Branches and how they stack:")
    out += spawn_tree(branches)

    subjects, seen = [], set()
    for b in branches[:6]:
        for s in commit_subjects(repo, b["name"], main):
            if s not in seen:
                seen.add(s)
                subjects.append(s)
    if subjects:
        out.append("Commit subjects:")
        out += [f"  {s}" for s in subjects[:24]]

    files, seen_f = [], set()
    for st in arc.get("stashes", [])[:6]:
        for f in st.get("files", [])[:6]:
            if f not in seen_f:
                seen_f.add(f)
                files.append(f)
    if files:
        out.append("Files in stashed work:")
        out += [f"  {f}" for f in files[:20]]

    prompts = []
    for s in arc.get("sessions", [])[:12]:
        for p in turns.get(s.get("id"), [])[:6]:
            p = " ".join(p.split())
            if len(p) > 300:
                p = p[:300] + "..."
            prompts.append(p)
    if prompts:
        out.append("Prompts typed while working on this:")
        out += [f"  - {p}" for p in prompts[:24]]

    return "\n".join(out)


# How many branches the split pass may see. The cap used to be 20 while the completeness
# check demanded a verdict on every branch in the arc, so for anything larger the two
# disagreed by construction and the answer was rejected every time -- "accounted for only 20
# of 39". The four biggest arcs on the page were never once split, and the failure read as
# the model being unable to count. Raised, and `known` is now derived from the same constant,
# so the check can only ever ask about branches that were actually shown.
SPLIT_BRANCHES = int(os.environ.get("ARC_SPLIT_BRANCHES", "60"))

# A ticket key anywhere in a branch name or its commit subjects. The two projects that
# file work here; a bare number is not a key and must not match.
TICKET_RE = re.compile(r"\b(U[BL]-\d+)\b")


def branch_ticket(name, subjects):
    """The ticket this branch's commits are in service of, or None.

    The single strongest discriminator available and, until now, the one the split pass
    was never told. It was inferable -- most subjects begin with the key -- but inference
    competed with a prompt whose stated prior was that one body is usually correct, and
    the prior won: a TDAT signup hotfix, a DOVE query-dedup ticket and the thor telemetry
    work were one nine-branch arc while every commit in them named a different ticket.

    Weighted so the branch name outranks any single commit. A branch called `UL-1633`
    that carries one drive-by commit naming UB-6802 is UL-1633's; the reverse reading
    would make every branch the ticket of whatever it last borrowed from.
    """
    counts = collections.Counter()
    for s in subjects:
        for k in TICKET_RE.findall(s):
            counts[k] += 1
    for k in TICKET_RE.findall(name):
        counts[k] += 3
    if not counts:
        return None
    top = counts.most_common()
    # A tie is not evidence -- say nothing rather than pick one arbitrarily.
    if len(top) > 1 and top[0][1] == top[1][1]:
        return None
    return top[0][0]


def split_evidence(arc, repo, main, limit=SPLIT_BRANCHES):
    """Each branch as its own commits, which is what tells two intentions apart.

    A superseded copy is the one case where identical commits are not evidence of two
    bodies of work -- they are evidence of one, written down twice. Left unmarked it reads
    as a second branch pursuing the same goal, which is exactly the shape the prompt is
    told to split on.

    The ticket each branch serves is stated outright rather than left to be read out of
    the subjects. It is not decisive on its own -- a long stack carries one ticket's
    commits across branches named for another, and plenty of real work names no ticket at
    all -- so it is given as evidence and not applied as a rule.
    """
    blocks = []
    shown = arc.get("branches", [])[:limit]
    names = {b["name"] for b in shown}
    for b in shown:
        marks = []
        if b.get("authoritative"):
            marks.append("the branch under review")
        if b.get("superseded_by") in names:
            marks.append(f"{b.get('superseded_kind','duplicate')} of "
                         f"{b['superseded_by']} — same work, not a second body")
        subs = commit_subjects(repo, b["name"], main, limit=5)
        tkt = branch_ticket(b["name"], subs)
        if tkt:
            marks.append(f"commits name {tkt}")
        lines = [f"  {b['name']}" + (f"  [{'; '.join(marks)}]" if marks else "")]
        lines += [f"      {s}" for s in subs] or ["      (no commits ahead of main)"]
        blocks.append("\n".join(lines))
    # Shown in the arc's own order, but identified independently of it. The display order
    # is `(-unpushed, age_days, name)` and `age_days` ticks over on its own, so a branch
    # crossing a day boundary used to rewrite the evidence text, miss the cache and buy a
    # fresh verdict on work that had not changed -- which is how one arc accumulated seven
    # mutually contradictory splits. Sorting the same blocks for the key means the cache
    # is invalidated by what a branch IS, never by where it sits in the list.
    return "\n".join(blocks), "\n".join(sorted(blocks))


def parse_split(text, known):
    """Take the partition, repairing it rather than discarding it over a bookkeeping slip.

    The invariant that matters is that no branch is lost off the page. That was enforced by
    rejecting any reply which failed to account for every branch exactly once -- and the
    cost of that strictness was the opposite of what it was for: the four largest arcs, 39,
    33, 26 and 22 branches, were all left whole because a reply mislaid one name out of
    dozens. The arcs most likely to hold several workstreams are the ones a model is most
    likely to miscount, so the check was failing hardest exactly where it mattered, and
    "left whole" means a 39-branch blob on the page.

    So enforce the invariant instead of testing for it. A duplicate keeps its first
    mention; an unmentioned branch joins the largest body, on the grounds that a branch
    nobody argued about is likelier to belong with the bulk than to be its own workstream.
    A reply that has lost track of a fifth of the arc is not a bookkeeping slip and is
    still rejected.

    Returns (bodies, note, uncertain) -- note describes any repair, so it is reported
    rather than done quietly, and uncertain is the branches the reply kept without being
    able to justify keeping them. An uncertainty naming a branch the reply did not place
    is dropped: the field is a comment on a decision, so it means nothing without one.
    """
    COVER_MIN = 0.8
    text = text.strip()
    if text.startswith("```"):
        text = re.sub(r"^```(?:json)?\s*", "", text)
        text = re.sub(r"\s*```$", "", text)
    try:
        obj = json.loads(text)
    except json.JSONDecodeError:
        m = re.search(r"\{.*\}", text, re.S)
        if not m:
            return None, "no JSON in reply", []
        try:
            obj = json.loads(m.group(0))
        except json.JSONDecodeError:
            return None, "unparseable JSON", []
    bodies = obj.get("bodies") if isinstance(obj, dict) else None
    if not isinstance(bodies, list) or not bodies:
        return None, "no bodies in reply", []

    seen, out, dupes = set(), [], 0
    for body in bodies:
        if not isinstance(body, dict):
            return None, "a body was not an object", []
        names = []
        for b in body.get("branches") or []:
            if b not in known:
                continue
            if b in seen:
                dupes += 1
                continue
            seen.add(b)
            names.append(b)
        if names:
            out.append({"name": str(body.get("name") or "").strip(), "branches": names})
    if not out:
        return None, "no known branches in reply", []

    notes = []
    if dupes:
        notes.append(f"{dupes} branch(es) listed twice, first mention kept")
    missing = known - seen
    if missing:
        if len(seen) < COVER_MIN * len(known):
            return None, (f"accounted for only {len(seen)} of {len(known)} branches"), []
        biggest = max(out, key=lambda b: len(b["branches"]))
        biggest["branches"].extend(sorted(missing))
        notes.append(f"{len(missing)} unlisted branch(es) put with '{biggest['name']}'")
    unsure = [b for b in (obj.get("uncertain") or [])
              if isinstance(b, str) and b in seen][:2]
    return out, ("; ".join(notes) if notes else None), unsure


# Voting nests a pool inside the arc pool, so `--jobs` has to mean what it says: without
# this, 6 arcs in flight at 3 votes each is 18 concurrent model processes rather than the
# 6 that were asked for. The outer pool stays wide so arcs keep moving; this caps what is
# actually running.
_MODEL_SLOTS = threading.BoundedSemaphore(6)


def set_model_slots(n):
    global _MODEL_SLOTS
    _MODEL_SLOTS = threading.BoundedSemaphore(max(1, n))


def ask_split_once(evidence, known, model, timeout, tries=2):
    prompt = SPLIT_PROMPT.replace("{evidence}", evidence)
    reason = "unknown"
    for attempt in range(tries):
        if attempt:
            time.sleep(2 * attempt)
        try:
            with _MODEL_SLOTS:
                r = headless_claude.run(
                    ["--model", model, "--dangerously-skip-permissions", prompt],
                    timeout=timeout)
        except (OSError, subprocess.SubprocessError) as e:
            reason = e.__class__.__name__
            continue
        if r.returncode != 0:
            reason = f"exit {r.returncode}"
            continue
        bodies, note, unsure = parse_split(r.stdout, known)
        if bodies:
            return bodies, note, unsure
        reason = note or "reply did not partition the branches"
    return None, reason, []


# How many independent verdicts a big arc gets. One sample is a coin flip: `splits.json`
# accumulated seven verdicts over this repo's query-log arc and they disagreed about
# everything -- one correctly isolated the thor telemetry work and the TDAT hotfix, another
# lumped nine branches into one, same model and same prompt. Small arcs get one sample
# because there is little for a partition to disagree about and they are the bulk of the
# runs; the cost is bounded by the threshold, not by the arc count.
SPLIT_VOTES = int(os.environ.get("ARC_SPLIT_VOTES", "3"))
SPLIT_VOTE_AT = int(os.environ.get("ARC_SPLIT_VOTE_AT", "5"))


def consensus_bodies(runs, known):
    """Merge several partitions of the same branches into the one they agree on.

    Majority co-membership, not majority partition: the verdicts rarely repeat exactly, so
    comparing them whole would throw away agreement they do share. Two branches end up
    together only if most samples put them together, which makes the result at least as
    fine as the median sample and removes the single-sample lottery -- a lump that only one
    verdict in three proposes cannot survive, and neither can a split only one proposes.

    Names come from the sample whose own partition is closest to the consensus, so the
    labels stay ones a model actually wrote about these exact groupings.
    """
    pair = collections.Counter()
    for bodies in runs:
        for body in bodies:
            names = body["branches"]
            for i, a in enumerate(names):
                for b in names[i + 1:]:
                    pair[(a, b) if a < b else (b, a)] += 1
    need = len(runs) / 2.0

    parent = {n: n for n in known}

    def find(x):
        while parent[x] != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x

    for (a, b), n in pair.items():
        if n > need and a in parent and b in parent:
            ra, rb = find(a), find(b)
            if ra != rb:
                parent[rb] = ra

    groups = collections.defaultdict(list)
    for n in sorted(known):
        groups[find(n)].append(n)

    # Label each consensus group from whichever sampled body overlaps it most -- and
    # never twice with the same name. Downstream, a body's name IS the arc it becomes:
    # work-arcs groups branches by the label this returns, so two groups sharing a name
    # are silently welded back into one and the split is computed and then thrown away.
    # Seen for real on a 26-branch arc that consensus cut five ways and that named four
    # of the five "Adaptive trend charts and metric time ranges".
    out, used = [], set()
    for members in sorted(groups.values(), key=lambda g: (-len(g), g[0])):
        want = set(members)
        ranked = []
        for bodies in runs:
            for body in bodies:
                nm = (body.get("name") or "").strip()
                ov = len(want & set(body["branches"]))
                # Only names of bodies that actually contain some of these branches. A
                # sibling group's label is not a fallback: it describes different work,
                # and borrowing it to dodge a collision is worse than a collision.
                if nm and ov:
                    ranked.append((ov, nm))
        ranked.sort(key=lambda x: (-x[0], x[1]))
        name = next((nm for _, nm in ranked if nm not in used), "")
        if not name:
            # The name that fits is taken, so qualify it rather than reach for another
            # group's: the branch is what a person would use to tell two slices of one
            # sprawling effort apart.
            base = ranked[0][1] if ranked else "unnamed"
            name = f"{base} ({members[0]})"
        used.add(name)
        out.append({"name": name, "branches": members})
    return out


def ask_split(evidence, known, model, timeout, tries=2):
    """One verdict for a small arc, a consensus of several for a big one."""
    votes = SPLIT_VOTES if len(known) >= SPLIT_VOTE_AT else 1
    if votes <= 1:
        return ask_split_once(evidence, known, model, timeout, tries)

    runs, notes, unsure = [], [], set()
    with futures.ThreadPoolExecutor(max_workers=votes) as pool:
        futs = [pool.submit(ask_split_once, evidence, known, model, timeout, tries)
                for _ in range(votes)]
        for f in futs:
            bodies, note, flagged = f.result()
            if bodies:
                runs.append(bodies)
                unsure |= set(flagged)
                if note:
                    notes.append(note)
    if not runs:
        return None, "no sample partitioned the branches", []

    bodies = consensus_bodies(runs, known)
    # Union across samples, not a majority. Co-membership takes a majority because a lump
    # one sample invents must not survive -- that is a claim about the work. This is not
    # a claim; it is a report of the model's own doubt, and one sample saying it could not
    # justify a branch while two said nothing is itself a disagreement about whether the
    # evidence settles it. Bounded by the same cap a single reply gets, so a talkative
    # sample cannot flood the queue.
    sizes = sorted(len(r) for r in runs)
    note = f"{len(runs)}/{votes} samples, {sizes} bodies → {len(bodies)}"
    if notes:
        note += "; " + "; ".join(sorted(set(notes)))
    return bodies, note, sorted(unsure)[:2]


def fingerprint(evidence, model, prompt=""):
    """What the brief was derived from, so a stale one is detectable and not just old.

    Cached inference is only safe if it is recomputable and auditable. Keying on the
    evidence rather than on a timestamp means the brief expires exactly when the work it
    describes changes -- and never drifts silently while the arc moves underneath it.
    """
    h = hashlib.sha256()
    h.update(model.encode())
    h.update(b"\0")
    # The prompt is part of what produced the answer. Leaving it out meant a reworded
    # question silently reused the old reply, which is the one way a cache keyed on
    # evidence can still go stale.
    h.update(prompt.encode())
    h.update(b"\0")
    h.update(evidence.encode())
    return h.hexdigest()[:20]


def parse_reply(text):
    """The model was asked for bare JSON; take it even when it arrives wrapped."""
    text = text.strip()
    if text.startswith("```"):
        text = re.sub(r"^```(?:json)?\s*", "", text)
        text = re.sub(r"\s*```$", "", text)
    try:
        obj = json.loads(text)
    except json.JSONDecodeError:
        m = re.search(r"\{.*\}", text, re.S)
        if not m:
            return None
        try:
            obj = json.loads(m.group(0))
        except json.JSONDecodeError:
            return None
    if not isinstance(obj, dict) or not obj.get("name"):
        return None
    return {"name": str(obj.get("name", "")).strip(),
            "summary": str(obj.get("summary", "")).strip(),
            "blocker": str(obj.get("blocker", "")).strip()}


def ask(evidence, model, timeout, tries=2):
    """One model call, retried once. Returns (brief, reason) -- brief is None on failure.

    Every other tool in this pipeline degrades rather than fails, and this one has to as
    well: the page must still render from the deterministic data when the model is
    unreachable, the CLI is missing, or one arc's evidence trips something.

    But degrading silently is its own failure. Running 8 at a time, two of the largest
    arcs came back empty and the page showed them under their cluster label with no
    description -- the arcs that most need explaining are the ones with the most going
    on, so a transient error lands hardest exactly where it hurts. One retry clears the
    transient case, and the reason is reported rather than swallowed.
    """
    prompt = PROMPT.replace("{evidence}", evidence)
    reason = "unknown"
    for attempt in range(tries):
        if attempt:
            time.sleep(2 * attempt)
        try:
            r = headless_claude.run(
                ["--model", model, "--dangerously-skip-permissions", prompt],
                timeout=timeout)
        except subprocess.TimeoutExpired:
            reason = f"timed out after {timeout}s"
            continue
        except (OSError, subprocess.SubprocessError) as e:
            reason = f"could not run claude ({e.__class__.__name__})"
            continue
        if r.returncode != 0:
            reason = f"exit {r.returncode}: {(r.stderr or '').strip()[:120]}"
            continue
        brief = parse_reply(r.stdout)
        if brief:
            return brief, None
        reason = f"unparseable reply: {(r.stdout or '').strip()[:120]!r}"
    return None, reason


def load_cache():
    return load_store(CACHE, "the brief cache")


def touched_at(entry):
    """When this brief was last served or written, however old the entry's shape is.

    Entries written before pruning existed carry no `last_used`, so they are dated by when
    they were written. That is the conservative reading -- it can only make an entry look
    older than it is, never newer -- and it is self-correcting: the first run that serves
    one stamps it.
    """
    if not isinstance(entry, dict):
        return 0
    for key in ("last_used", "at"):
        v = entry.get(key)
        if isinstance(v, (int, float)):
            return v
    return 0


def payload_of(entry):
    """The brief as everything downstream sees it: all of it but this file's bookkeeping.

    arc-morning keys its own cache on the prompt it builds, and that prompt embeds every
    arc's brief -- so a last-use stamp riding along in the payload would reword the question
    on every run and miss that cache every time, which is precisely the failure this file's
    own cache exists to avoid. The bookkeeping belongs to the file, not to the answer.
    """
    return {k: v for k, v in entry.items() if k != "last_used"}


def save_cache(cache, keep_days=CACHE_KEEP_DAYS, say=None):
    """Write the cache, less whatever nothing has asked for in keep_days.

    Pruning on write rather than on read, so the file the next run loads is already the
    file this one decided on -- a prune that lived in load_cache would be undone by any
    run that exits before saving.

    It says what it dropped. A cache that quietly shrinks looks exactly like a cache that
    is working and cold, and the difference is a run's worth of model calls -- the same
    reason load_store announces a corrupt store rather than starting empty in silence.
    """
    if keep_days > 0:
        cut = time.time() - keep_days * 86400
        kept = {fp: b for fp, b in cache.items() if touched_at(b) >= cut}
        dropped = len(cache) - len(kept)
        if dropped and say is not None:
            say(f"arc-brief: dropped {dropped} brief(s) unused for {keep_days}+ days, "
                f"{len(kept)} kept")
        cache = kept
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = CACHE.with_suffix(".tmp")
    tmp.write_text(json.dumps(cache, indent=1, sort_keys=True))
    tmp.replace(CACHE)
    return cache


def cached_bodies(entry):
    """The bodies out of a split-cache entry, whichever shape it was written in.

    The cache held a bare list of bodies before the uncertainty field existed and holds
    an envelope now. Both are read rather than the old ones discarded: a split costs an
    opus call, this repo has 81k of them cached, and the shape change adds a field to the
    verdict rather than changing it. Note that the prompt itself changed, so these entries
    will miss on the fingerprint anyway and are re-bought once -- this exists so that a
    cache written by either version is never *misread*, which is the failure that would
    silently assign branches to the wrong arcs.
    """
    if isinstance(entry, dict):
        b = entry.get("bodies")
        return b if isinstance(b, list) else []
    return entry if isinstance(entry, list) else []


def cached_unsure(entry):
    if isinstance(entry, dict) and isinstance(entry.get("uncertain"), list):
        return [b for b in entry["uncertain"] if isinstance(b, str)]
    return []


def do_split(data, repo, main_ref, args):
    """Ask which arcs hold more than one body of work, and emit the refined assignment.

    File overlap has a resolution limit: two tickets that edit the same module are
    structurally identical however the weights are set. Four independent rules already
    guard membership and the errors that survive all have this shape, so the last
    discriminator has to be the content of the changes -- which is exactly what the
    model is already reading in order to name the arc.

    Output is a branch -> arc-label map on stdout, for work-arcs to apply. Splitting
    here rather than partitioning the finished arcs keeps every count computed in one
    place; work-arcs simply clusters into more groups than it otherwise would.
    """
    cache = {} if args.refresh else load_store(SPLIT_CACHE, "the split cache")

    candidates = [a for a in data.get("arcs", []) if len(a.get("branches", [])) > 1]
    work, mapping, hits, unsure = [], {}, 0, []
    for arc in candidates:
        # Exactly the branches the model is shown -- see SPLIT_BRANCHES.
        known = {b["name"] for b in arc["branches"][:SPLIT_BRANCHES]}
        ev, ident = split_evidence(arc, repo, main_ref)
        fp = fingerprint(ident, args.model + ":split", SPLIT_PROMPT)
        cached = cache.get(fp)
        if cached:
            hits += 1
            for body in cached_bodies(cached):
                for name in body["branches"]:
                    mapping[name] = body["name"]
            unsure += cached_unsure(cached)
        else:
            work.append((arc, ev, fp, known))

    if work:
        set_model_slots(args.jobs)
        big = sum(1 for _, _, _, k in work if len(k) >= SPLIT_VOTE_AT)
        print(f"arc-brief --split: {hits} cached, {len(work)} to decide "
              f"({args.model}, {args.jobs} at a time"
              + (f", {big} voted ×{SPLIT_VOTES}" if big else "") + ")", file=sys.stderr)
        with futures.ThreadPoolExecutor(max_workers=max(1, args.jobs)) as pool:
            futs = {pool.submit(ask_split, ev, known, args.model, args.timeout):
                    (arc, fp, known) for arc, ev, fp, known in work}
            for fut in futures.as_completed(futs):
                arc, fp, known = futs[fut]
                bodies, reason, flagged = fut.result()
                if not bodies:
                    print(f"  ! left whole: {arc.get('label','?')} — {reason}",
                          file=sys.stderr)
                    continue
                if reason:
                    # A repaired partition is still a judgement about the arc, so say what
                    # was patched rather than let it pass as a clean answer.
                    print(f"  ~ repaired {arc.get('label','?')}: {reason}", file=sys.stderr)
                # The envelope, not the bare list: the uncertainty is part of the
                # verdict and is keyed on the same evidence, so caching it beside the
                # bodies is what stops a cache hit from silently losing it.
                cache[fp] = {"bodies": bodies, "uncertain": flagged}
                unsure += flagged
                if flagged:
                    print(f"  ? kept but unjustified in {arc.get('label','?')}: "
                          + ", ".join(flagged), file=sys.stderr)
                if len(bodies) > 1:
                    print(f"  split {arc.get('label','?')} ({len(known)} branches) → "
                          + " | ".join(f"{b['name']} ×{len(b['branches'])}"
                                       for b in bodies), file=sys.stderr)
                for body in bodies:
                    for name in body["branches"]:
                        mapping[name] = body["name"]
        try:
            SPLIT_CACHE.parent.mkdir(parents=True, exist_ok=True)
            tmp = SPLIT_CACHE.with_suffix(".tmp")
            tmp.write_text(json.dumps(cache, indent=1, sort_keys=True))
            tmp.replace(SPLIT_CACHE)
        except OSError:
            pass
    else:
        print(f"arc-brief --split: {hits} cached, nothing to decide", file=sys.stderr)

    # Two arcs can independently be named the same thing; keep them apart.
    seen = {}
    out = {}
    for arc in candidates:
        for b in arc["branches"]:
            label = mapping.get(b["name"])
            if not label:
                continue
            key = (arc.get("label"), label)
            if label in seen and seen[label] != key:
                label = f"{label} ({len(seen)})"
            seen.setdefault(label, key)
            out[b["name"]] = label
    # An envelope rather than the bare map this used to print. `assign` is a key no
    # branch can be named, which is how work-arcs tells the two shapes apart and stays
    # able to read a reply written before the uncertainty existed.
    json.dump({"assign": out,
               "uncertain": sorted({b for b in unsure if b in out})},
              sys.stdout, indent=1)
    print()


def main():
    p = argparse.ArgumentParser(
        description="Give each arc a name and a description derived from its evidence.")
    p.add_argument("--from", dest="src", type=Path, default=None,
                   help="work-arcs --json output (default: stdin)")
    p.add_argument("--repo", type=Path, default=None,
                   help="the work repo (default: the repo named in the input)")
    p.add_argument("--model", default=None,
                   help=f"claude -p model alias (default: {DEFAULT_MODEL} for briefs, "
                        f"{DEFAULT_SPLIT_MODEL} for --split)")
    p.add_argument("--refresh", action="store_true",
                   help="recompute every brief, ignoring cached ones")
    p.add_argument("--limit", type=int, default=0,
                   help="only brief the N most-engaged arcs (0 = all)")
    p.add_argument("--active", type=int, default=0, metavar="DAYS",
                   help="only brief arcs idle at most this long -- match arcs-page's "
                        "--focus so every card it renders has a description")
    p.add_argument("--jobs", type=int, default=6, help="concurrent model calls")
    p.add_argument("--timeout", type=int, default=180, help="seconds per model call")
    p.add_argument("--out", type=Path, default=None, help="write here instead of stdout")
    p.add_argument("--split", action="store_true",
                   help="emit a branch->arc map splitting arcs that hold several "
                        "bodies of work; for work-arcs to consume, not the page")
    args = p.parse_args()
    if args.model is None:
        args.model = DEFAULT_SPLIT_MODEL if args.split else DEFAULT_MODEL

    raw = args.src.read_text() if args.src else sys.stdin.read()
    try:
        data = json.loads(raw)
    except json.JSONDecodeError as e:
        sys.exit(f"arc-brief: input is not the JSON work-arcs emits ({e})")
    if not isinstance(data, dict):
        sys.exit(f"arc-brief: input parsed as {type(data).__name__}, not the object "
                 "`work-arcs --json` emits — there are no arcs in it to brief")

    repo = args.repo or Path(data.get("repo_path") or data.get("repo", ""))
    main_ref = data.get("main", "origin/main")
    # Loudly, because the silent version of this cost every brief its commit subjects for
    # as long as the tool has existed. `repo` in the JSON is a display name; older payloads
    # carry only that, and resolving it as a path makes every git call a no-op.
    if not (repo / ".git").exists():
        print(f"arc-brief: {repo} is not a git repo — no commit subjects will reach the "
              f"model, and the briefs will be markedly worse. Pass --repo.", file=sys.stderr)
    turns = load_turns()
    if not turns:
        print("arc-brief: no prompt log at "
              f"{TURNS} -- run arc-backfill for better names", file=sys.stderr)

    if args.split:
        return do_split(data, repo, main_ref, args)

    arcs = data.get("arcs", [])
    # The gap report embeds the same arc objects, so briefing `arcs` names them there
    # too. Anything only reachable through the gap still needs doing explicitly.
    extra = [a for a in (data.get("gap") or {}).get("unticketed_work", [])
             if not any(a is x for x in arcs)]
    todo = sorted(arcs, key=lambda a: -a.get("engagement", 0))
    if args.active:
        todo = [a for a in todo if a.get("age_days", 999) <= args.active]
    if args.limit:
        todo = todo[:args.limit]
    todo += extra

    cache = load_cache()
    now = int(time.time())
    work, hits = [], 0
    for arc in todo:
        ev = evidence_for(arc, repo, main_ref, turns)
        fp = fingerprint(ev, args.model, PROMPT)
        cached = None if args.refresh else cache.get(fp)
        if cached:
            # Reading is a use, and the stamp goes on the cache entry -- not on what is
            # handed downstream. See payload_of.
            cached["last_used"] = now
            arc["brief"] = payload_of(cached)
            hits += 1
        else:
            work.append((arc, ev, fp))

    if work:
        print(f"arc-brief: {hits} cached, {len(work)} to write "
              f"({args.model}, {args.jobs} at a time)", file=sys.stderr)
        with futures.ThreadPoolExecutor(max_workers=max(1, args.jobs)) as pool:
            futs = {pool.submit(ask, ev, args.model, args.timeout): (arc, ev, fp)
                    for arc, ev, fp in work}
            done = failed = 0
            for fut in futures.as_completed(futs):
                arc, ev, fp = futs[fut]
                brief, reason = fut.result()
                done += 1
                if brief is None:
                    failed += 1
                    print(f"  ! no brief for {arc.get('label','?')} — {reason}",
                          file=sys.stderr)
                    continue
                # The evidence rides along with the inference. A cached judgement you
                # cannot audit is worse than no judgement.
                brief = dict(brief, model=args.model, at=int(time.time()),
                             evidence_sha=fp, evidence=ev)
                arc["brief"] = brief
                cache[fp] = brief
                print(f"  [{done}/{len(work)}] {arc.get('label','?')} -> "
                      f"{brief['name']}", file=sys.stderr)
        if failed:
            print(f"arc-brief: {failed} arc(s) have no description; they fall back to "
                  f"their cluster label", file=sys.stderr)
    else:
        print(f"arc-brief: {hits} cached, nothing to write", file=sys.stderr)

    # Unconditionally, which the write above was not. A fully warm run writes no new brief
    # and used to skip saving entirely -- so the last-use stamps it just set were dropped on
    # the floor, and a month of warm runs would have pruned the very entries being served
    # every morning. Reading is a use, and a use has to be recorded to count.
    try:
        save_cache(cache, say=lambda m: print(m, file=sys.stderr))
    except OSError as e:
        # The briefs are already on the arcs; a cache that cannot be written costs the next
        # run its model calls and costs this one nothing.
        print(f"arc-brief: could not write the brief cache ({e})", file=sys.stderr)

    data["briefed"] = sum(1 for a in arcs if a.get("brief"))
    out = json.dumps(data, indent=1)
    if args.out:
        args.out.write_text(out)
        print(f"✓ {args.out}", file=sys.stderr)
    else:
        print(out)


if __name__ == "__main__":
    main()
