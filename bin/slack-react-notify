    "x": "❌", "no_entry": "⛔", "warning": "⚠️", "100": "💯",
    "joy": "😂", "rolling_on_the_floor_laughing": "🤣", "smile": "😄",
    "smiley": "😃", "grinning": "😀", "slightly_smiling_face": "🙂",
    "wink": "😉", "sob": "😭", "cry": "😢", "thinking_face": "🤔",
