# ── pure helpers (covered by --selftest) ────────────────────────────────────

_LINK_RE = re.compile(r"<(https?://[^>|]+)\|([^>]+)>")     # <url|label>
_BARE_LINK_RE = re.compile(r"<(https?://[^>]+)>")          # <url>
_CHAN_RE = re.compile(r"<#[CG][A-Z0-9]+(?:\|([^>]*))?>")   # <#C123|name> / <#C123>
_USER_RE = re.compile(r"<@[UW][A-Z0-9]+(?:\|([^>]*))?>")   # <@U123> / <@U123|name>
_SPECIAL_RE = re.compile(r"<!([^>|]+)(?:\|[^>]*)?>")        # <!here>, <!channel>, <!subteam^..|@t>


def slack_text_to_plain(text):
    """Turn Slack wire mrkdwn into a readable one-line snippet."""
    if not text:
        return ""
    t = text
    t = _LINK_RE.sub(r"\2", t)
    t = _BARE_LINK_RE.sub(r"\1", t)
    t = _CHAN_RE.sub(lambda m: "#" + (m.group(1) or "channel"), t)
    t = _USER_RE.sub(lambda m: "@" + (m.group(1) or "someone"), t)
    t = _SPECIAL_RE.sub(lambda m: "@" + m.group(1), t)
    # Unescape Slack's HTML entities AFTER stripping the real <...> markup.
    t = t.replace("&lt;", "<").replace("&gt;", ">").replace("&amp;", "&")
    t = re.sub(r"\s+", " ", t).strip()
    return t


def reaction_base(name):
    """Strip skin-tone / compound modifiers: '+1::skin-tone-3' -> '+1'."""
    return (name or "").split("::")[0]


def emojize(name):
    """Map a reaction name to a glyph, falling back to :name: (skin tones stripped)."""
    base = reaction_base(name)
    return EMOJI_MAP.get(base, f":{base}:" if base else "")


def slack_escape(s):
    """Escape mrkdwn control chars so dynamic text can't break links/mentions.
    Mirrors lib/slack.sh slack_escape (& first, so added entities aren't re-escaped)."""
    return (s or "").replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def truncate(text, n=SNIPPET_MAX):
    if len(text) <= n:
        return text
    return text[: n - 1].rstrip() + "…"


def should_notify(item_user, reactor, self_id, ignore_self=True):
    """Notify only for reactions on *my* messages, optionally skipping my own."""
    if not self_id:
        return False
    if item_user != self_id:
        return False
    if ignore_self and reactor == self_id:
        return False
    return True


def format_notification(reactor_name, reaction, channel_name, snippet):
    """Build (title, body) for the desktop notification. Pure / testable."""
    glyph = emojize(reaction)
    who = reactor_name or "Someone"
    title = f"{glyph} {who} reacted".strip()
    where = f"in {channel_name}" if channel_name else ""
    snippet = slack_text_to_plain(snippet)  # defensive: never leak raw mrkdwn
    if snippet:
        snip = truncate(snippet)
        body = f"{where}: “{snip}”" if where else f"“{snip}”"
    else:
        body = where or "reacted to your message"
    return title, body


def build_slack_message(reactor_name, reaction, channel_name, snippet, permalink):
    """Build the mrkdwn DM text. Pure / testable. Dynamic text is escaped so a
    stray <, > or & in a name/snippet can't corrupt the message or link."""
    who = slack_escape(reactor_name or "Someone")
    where = f" in {slack_escape(channel_name)}" if channel_name else ""
    lines = [f":{reaction_base(reaction)}: *{who}* reacted to your message{where}"]
    snippet = slack_text_to_plain(snippet)
    if snippet:
        lines.append("> " + slack_escape(truncate(snippet)))
    if permalink:
        lines.append(f"<{permalink}|View in Slack>")
    return "\n".join(lines)


def applescript_quote(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


# ── env / config ────────────────────────────────────────────────────────────

def load_env():
    if ENV_FILE.exists():
        for line in ENV_FILE.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                key, _, value = line.partition("=")
                value = value.strip().strip('"').strip("'")
                os.environ.setdefault(key.strip(), os.path.expandvars(value))


def _truthy(v, default=True):
    if v is None or v == "":
        return default
    return v.strip().lower() not in ("0", "false", "no", "off")


# ── Slack Web API ────────────────────────────────────────────────────────────
# Reads (users/channels/history/permalink) use the user token (SLACK_REACT_TOKEN)
# so they work in every channel you're in without inviting a bot. Outbound DMs
# use the bot token (SLACK_REACT_BOT_TOKEN) so the message comes from someone
# other than you — a self-sent message wouldn't trigger a Slack notification.

def slack_get(method, **params):
    qs = urllib.parse.urlencode(params)
    url = f"https://slack.com/api/{method}?{qs}"
    req = urllib.request.Request(url, headers={"Authorization": f"Bearer {API_TOKEN}"})
    try:
        with urllib.request.urlopen(req) as resp:
            return json.loads(resp.read())
    except urllib.error.URLError as e:
        print(f"  Slack API error ({method}): {e}")
        return {"ok": False, "error": str(e)}


def slack_post_bot(method, **kwargs):
    url = f"https://slack.com/api/{method}"
    data = json.dumps(kwargs).encode()
    req = urllib.request.Request(url, data=data, headers={
        "Authorization": f"Bearer {BOT_TOKEN}",
        "Content-Type": "application/json; charset=utf-8"})
    try:
        with urllib.request.urlopen(req) as resp:
            return json.loads(resp.read())
    except urllib.error.URLError as e:
        print(f"  Slack API error ({method}): {e}")
        return {"ok": False, "error": str(e)}


_dm_channel = ""


def ensure_dm_channel():
    """Open (once) the bot↔you DM and cache its channel id."""
    global _dm_channel
    if _dm_channel:
        return _dm_channel
    resp = slack_post_bot("conversations.open", users=SELF_ID)
    if resp.get("ok"):
        _dm_channel = resp.get("channel", {}).get("id", "")
    else:
        print(f"  conversations.open failed: {resp.get('error')} (check bot token / im:write)")
    return _dm_channel


def send_slack_dm(text):
    ch = ensure_dm_channel()
    if not ch:
        return
    resp = slack_post_bot("chat.postMessage", channel=ch, text=text,
                          mrkdwn=True, unfurl_links=False, unfurl_media=False)
    if resp.get("ok"):
        print(f"  [slack-dm] {text.splitlines()[0]}")
    else:
        print(f"  chat.postMessage failed: {resp.get('error')}")


_user_cache = {}
_channel_cache = {}


def resolve_user_name(user_id):
    if not user_id:
        return ""
    if user_id in _user_cache:
        return _user_cache[user_id]
    resp = slack_get("users.info", user=user_id)
    name = ""
    if resp.get("ok"):
        p = resp.get("user", {}).get("profile", {})
        name = p.get("display_name") or p.get("real_name") or p.get("real_name_normalized") or ""
    _user_cache[user_id] = name or user_id
    return _user_cache[user_id]


def resolve_channel_name(channel_id):
    if not channel_id:
        return ""
    if channel_id in _channel_cache:
        return _channel_cache[channel_id]
    resp = slack_get("conversations.info", channel=channel_id)
    name = ""
    if resp.get("ok"):
        ch = resp.get("channel", {})
        if ch.get("is_im"):
            name = "a DM"
        elif ch.get("is_mpim"):
            name = "a group DM"
        elif ch.get("name"):
            name = "#" + ch["name"]
    _channel_cache[channel_id] = name or channel_id
    return _channel_cache[channel_id]


def fetch_message_text(channel, ts):
    """Best-effort: the text of the reacted message. Uses conversations.replies,
    which returns the message at `ts` whether it's a top-level message, a thread
    parent, or a thread reply — conversations.history omits thread replies, so
    reactions on replies would otherwise come through with no snippet. Skipped
    silently on error (e.g. missing history scope)."""
    resp = slack_get("conversations.replies", channel=channel, ts=ts,
                     limit=1, inclusive="true")
    if resp.get("ok"):
        msgs = resp.get("messages", [])
        msg = next((x for x in msgs if x.get("ts") == ts), msgs[0] if msgs else None)
        if msg:
            return slack_text_to_plain(msg.get("text", ""))
    return ""


def get_permalink(channel, ts):
    resp = slack_get("chat.getPermalink", channel=channel, message_ts=ts)
    return resp.get("permalink", "") if resp.get("ok") else ""


# ── desktop notification (cross-platform) ───────────────────────────────────

def send_notification(title, body, url=None):
    print(f"  [notify] {title} — {body}" + (f"  {url}" if url else ""))
    cmd = os.environ.get("SLACK_REACT_NOTIFY_CMD", "").strip()
    try:
        if cmd:
            subprocess.run(shlex.split(cmd) + [title, body], check=False)
            return
        if platform.system() == "Darwin":
            if shutil.which("terminal-notifier"):
                args = ["terminal-notifier", "-title", title, "-message", body]
                if url:
                    args += ["-open", url]
                subprocess.run(args, check=False)
            else:
                script = f"display notification {applescript_quote(body)} with title {applescript_quote(title)}"
                subprocess.run(["osascript", "-e", script], check=False)
        elif shutil.which("notify-send"):
            subprocess.run(["notify-send", "-a", "Slack Reactions", title, body], check=False)
        # else: stdout line above is the only output we can give
    except Exception as e:
        print(f"  notify error: {e}")


# ── event handling ──────────────────────────────────────────────────────────

def handle_reaction(channel, ts, reactor, reaction, item_user):
    if not should_notify(item_user, reactor, SELF_ID, IGNORE_SELF):
        return
    reactor_name = resolve_user_name(reactor)
    channel_name = resolve_channel_name(channel)
    snippet = fetch_message_text(channel, ts) if INCLUDE_SNIPPET else ""
    url = get_permalink(channel, ts)
    if DELIVERY in ("slack", "both"):
        send_slack_dm(build_slack_message(reactor_name, reaction, channel_name, snippet, url))
    if DELIVERY in ("desktop", "both"):
        title, body = format_notification(reactor_name, reaction, channel_name, snippet)
        send_notification(title, body, url)


def socket_event_handler(client, req):
    client.send_socket_mode_response(SocketModeResponse(envelope_id=req.envelope_id))
    if req.type != "events_api":
        return
    event = req.payload.get("event", {})
    if event.get("type") != "reaction_added":
        return
    item = event.get("item", {})
    if item.get("type") != "message":
        return
    item_user = event.get("item_user", "")
    if DEBUG:
        mine = " (yours)" if item_user == SELF_ID else ""
        print(f"  [reaction_added] :{event.get('reaction','')}: by {event.get('user','')} "
              f"on msg by {item_user}{mine} in {item.get('channel','')}")
    handle_reaction(
        item.get("channel", ""),
        item.get("ts", ""),
        event.get("user", ""),
        event.get("reaction", ""),
        item_user,
    )


# ── auth ─────────────────────────────────────────────────────────────────────

def auth_test(token):
    """Return (auth_response_dict, granted_scopes_set) for the given token."""
    req = urllib.request.Request(
        "https://slack.com/api/auth.test",
        headers={"Authorization": f"Bearer {token}",
                 "Content-Type": "application/x-www-form-urlencoded"},
        data=b"",
    )
    with urllib.request.urlopen(req) as raw:
        scopes = {s.strip() for s in raw.headers.get("x-oauth-scopes", "").split(",") if s.strip()}
        return json.loads(raw.read()), scopes


# ── subcommands ───────────────────────────────────────────────────────────────

def run_selftest():
    """Internal unit checks on the pure formatting/filtering helpers."""
    failures = []

    def check(label, got, want):
        if got != want:
            failures.append(f"{label}: got {got!r}, want {want!r}")

    ME = "U_ME"
    check("notify on my message", should_notify(ME, "U_OTHER", ME), True)
    check("ignore other's message", should_notify("U_OTHER", "U_X", ME), False)
    check("ignore my own reaction", should_notify(ME, ME, ME, ignore_self=True), False)
    check("allow my own reaction when configured", should_notify(ME, ME, ME, ignore_self=False), True)
    check("no self id -> never notify", should_notify(ME, "U_X", ""), False)

    check("emoji known", emojize("tada"), "🎉")
    check("emoji unknown fallback", emojize("weird_custom"), ":weird_custom:")
    check("emoji skin tone stripped", emojize("+1::skin-tone-3"), "👍")

    check("plain link label", slack_text_to_plain("see <https://x.com|the docs>"), "see the docs")
    check("plain bare link", slack_text_to_plain("<https://x.com/a>"), "https://x.com/a")
    check("plain user mention", slack_text_to_plain("hi <@U123>"), "hi @someone")
    check("plain channel ref", slack_text_to_plain("in <#C1|general>"), "in #general")
    check("plain special here", slack_text_to_plain("<!here> ping"), "@here ping")
    check("plain entity unescape", slack_text_to_plain("a &lt;b&gt; &amp; c"), "a <b> & c")
    check("plain collapse ws", slack_text_to_plain("line1\n\n  line2"), "line1 line2")

    check("truncate short", truncate("hi", 10), "hi")
    check("truncate long", truncate("abcdefghij", 5), "abcd…")

    t, b = format_notification("Alice", "tada", "#general", "ship it")
    check("fmt title", t, "🎉 Alice reacted")
    check("fmt body", b, "in #general: “ship it”")
    t, b = format_notification("", "weird", "", "")
    check("fmt fallbacks", (t, b), (":weird: Someone reacted", "reacted to your message"))
    _, b = format_notification("Bo", "fire", "#x", "see <https://y.com|docs> & go")
    check("fmt cleans raw mrkdwn", b, "in #x: “see docs & go”")

    check("applescript quote", applescript_quote('a"b\\c'), '"a\\"b\\\\c"')

    check("slack_escape order", slack_escape("A & <b>"), "A &amp; &lt;b&gt;")
    check("reaction_base strips tone", reaction_base("+1::skin-tone-3"), "+1")
    check(
        "slack msg full",
        build_slack_message("Alice", "tada", "#general", "ship it", "https://s/p1"),
        ":tada: *Alice* reacted to your message in #general\n> ship it\n<https://s/p1|View in Slack>",
    )
    check(
        "slack msg minimal (no channel/snippet/link)",
        build_slack_message("", "wave", "", "", ""),
        ":wave: *Someone* reacted to your message",
    )
    check(
        "slack msg escapes + strips tone + cleans mrkdwn",
        build_slack_message("A&B", "+1::skin-tone-3", "#x", "hi <@U1> & <b>", ""),
        ":+1: *A&amp;B* reacted to your message in #x\n> hi @someone &amp; &lt;b&gt;",
    )

    if failures:
        print("SELFTEST FAILED:")
        for f in failures:
            print(f"  ✗ {f}")
        return 1
    print("SELFTEST PASSED (all checks ok)")
    return 0


def run_check():
    need_bot = DELIVERY in ("slack", "both")
    required = [("SLACK_REACT_TOKEN", API_TOKEN), ("SLACK_REACT_APP_TOKEN", APP_TOKEN)]
    if need_bot:
        required.append(("SLACK_REACT_BOT_TOKEN", BOT_TOKEN))
    missing = [n for n, v in required if not v]
    if missing:
        print(f"Missing from .env: {', '.join(missing)}")
        print(f"\n  delivery mode: {DELIVERY}"
              + ("  (needs a bot token to DM you)" if need_bot else ""))
        print(f"  .env location: {ENV_FILE}\n\nRun `slack-react-notify --help` for setup steps.")
        return 1

    ok = True

    # ── user token: events + reads ──
    try:
        auth, scopes = auth_test(API_TOKEN)
    except urllib.error.URLError as e:
        print(f"Error connecting to Slack: {e}")
        return 1
    if not auth.get("ok"):
        print(f"user token auth.test failed: {auth.get('error')}  (check SLACK_REACT_TOKEN)")
        return 1
    print("User token OK (events + reads)")
    print(f"  workspace: {auth.get('url', '?')}  ({auth.get('team', '?')})")
    print(f"  user:      {auth.get('user', '?')}  ({auth.get('user_id', '?')})")
    print(f"  notify to: {SELF_ID or auth.get('user_id', '?')}")
    needed = {"reactions:read", "users:read"}
    nice = {"channels:history", "groups:history", "im:history", "mpim:history",
            "channels:read", "groups:read", "im:read", "mpim:read"}
    miss_needed = sorted(needed - scopes)
    miss_nice = sorted(nice - scopes)
    if miss_needed:
        print(f"  ⚠ missing required user scopes: {', '.join(miss_needed)}")
        ok = False
    if miss_nice:
        print(f"  · optional user scopes not granted (snippets/channel names): {', '.join(miss_nice)}")
    if not miss_needed:
        print("  user scopes look good ✓")

    # ── bot token: delivery ──
    if need_bot:
        try:
            bauth, bscopes = auth_test(BOT_TOKEN)
        except urllib.error.URLError as e:
            print(f"Error connecting to Slack (bot token): {e}")
            return 1
        if not bauth.get("ok"):
            print(f"bot token auth.test failed: {bauth.get('error')}  (check SLACK_REACT_BOT_TOKEN)")
            return 1
        print(f"Bot token OK (DM delivery as @{bauth.get('user', '?')})")
        bmiss = sorted({"chat:write", "im:write"} - bscopes)
        if bmiss:
            print(f"  ⚠ missing bot scopes: {', '.join(bmiss)}")
            ok = False
        else:
            print("  bot scopes look good ✓")
    else:
        print(f"Delivery mode '{DELIVERY}': desktop only, no bot token needed.")

    print("\nNote: the API can't verify event subscriptions. Confirm in the app config:")
    print("  Event Subscriptions → 'Subscribe to events on behalf of users' → reaction_added")
    return 0 if ok else 1


def print_manifest():
    print("""# Slack app manifest for slack-react-notify.
# Create the app fast: https://api.slack.com/apps → "Create New App" →
#   "From a manifest" → pick your workspace → paste this (YAML) → Create.
# Then finish the manual steps the manifest can't do:
#   1. Basic Information → App-Level Tokens → Generate a token with the
#      `connections:write` scope  →  SLACK_REACT_APP_TOKEN (xapp-...)
#   2. OAuth & Permissions → Install to Workspace, authorize, then copy BOTH:
#        "User OAuth Token" (xoxp-...) →  SLACK_REACT_TOKEN     (events + reads)
#        "Bot User OAuth Token" (xoxb-...) →  SLACK_REACT_BOT_TOKEN (DMs you)
# Finally:  slack-react-notify --check
display_information:
  name: Reaction Notifier
  description: Slack messages when people react to my messages
features:
  bot_user:
    display_name: Reaction Notifier
    always_online: true
oauth_config:
  scopes:
    user:
      - reactions:read
      - users:read
      - channels:history
      - groups:history
      - im:history
      - mpim:history
      - channels:read
      - groups:read
      - im:read
      - mpim:read
    bot:
      - chat:write
      - im:write
settings:
  event_subscriptions:
    user_events:
      - reaction_added
  socket_mode_enabled: true
  org_deploy_enabled: false
  token_rotation_enabled: false""")
    return 0


def print_service(kind):
    exe = str(SCRIPT_DIR / "slack-react-notify")
    if kind == "systemd":
        print(f"""# Save to ~/.config/systemd/user/slack-react-notify.service then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now slack-react-notify
#   journalctl --user -u slack-react-notify -f      # view logs
[Unit]
Description=Slack reaction notification daemon
After=network-online.target
Wants=network-online.target

[Service]
ExecStart={exe}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target""")
    elif kind == "launchd":
        label = "com.dev-workflow-tools.slack-react-notify"
        plist = Path.home() / "Library" / "LaunchAgents" / f"{label}.plist"
        print(f"""<!-- Save to {plist} then:
       launchctl load -w {plist}
       launchctl list | grep slack-react   # confirm it's running
     Logs go to /tmp/slack-react-notify.{{out,err}}.log -->
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>{label}</string>
  <key>ProgramArguments</key>
  <array><string>{exe}</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/slack-react-notify.out.log</string>
  <key>StandardErrorPath</key><string>/tmp/slack-react-notify.err.log</string>
</dict>
</plist>""")
    else:
        print(f"Unknown service kind: {kind!r} (use 'systemd' or 'launchd')")
        return 1
    return 0


# ── globals populated after load_env() ────────────────────────────────────────

load_env()
API_TOKEN = os.environ.get("SLACK_REACT_TOKEN", "")       # xoxp user token: events + reads
APP_TOKEN = os.environ.get("SLACK_REACT_APP_TOKEN", "")   # xapp app-level token: Socket Mode
BOT_TOKEN = os.environ.get("SLACK_REACT_BOT_TOKEN", "")   # xoxb bot token: DM delivery
SELF_ID = os.environ.get("SLACK_REACT_USER_ID", "")
IGNORE_SELF = _truthy(os.environ.get("SLACK_REACT_IGNORE_SELF"), default=True)
INCLUDE_SNIPPET = _truthy(os.environ.get("SLACK_REACT_SNIPPET"), default=True)
DEBUG = _truthy(os.environ.get("SLACK_REACT_DEBUG"), default=False)
DELIVERY = (os.environ.get("SLACK_REACT_DELIVERY", "slack").strip().lower() or "slack")
if DELIVERY not in ("slack", "desktop", "both"):
    print(f"  (invalid SLACK_REACT_DELIVERY={DELIVERY!r}; using 'slack')")
    DELIVERY = "slack"


def main(argv):
    if "--help" in argv or "-h" in argv:
        print(HELP)
        return 0
    if "--selftest" in argv:
        return run_selftest()
    if "--print-manifest" in argv:
        return print_manifest()
    if "--print-service" in argv:
        i = argv.index("--print-service")
        kind = argv[i + 1] if i + 1 < len(argv) else ""
        return print_service(kind)
    if "--check" in argv:
        return run_check()

    # ── normal run ──
    need_bot = DELIVERY in ("slack", "both")
    if not API_TOKEN or not APP_TOKEN or (need_bot and not BOT_TOKEN):
        return run_check()  # prints the friendly "missing from .env" guidance

    global SELF_ID
    try:
        auth, _ = auth_test(API_TOKEN)
    except urllib.error.URLError as e:
        print(f"Error connecting to Slack: {e}")
        return 1
    if not auth.get("ok"):
        print(f"auth.test failed: {auth.get('error')}  (check SLACK_REACT_TOKEN)")
        return 1
    if not SELF_ID:
        SELF_ID = auth.get("user_id", "")
    if not SELF_ID:
        print("Could not determine your Slack user id; set SLACK_REACT_USER_ID in .env.")
        return 1

    print(f"  Identity: {auth.get('user', '?')} ({SELF_ID}) on {auth.get('url', '?')}")
    print(f"  Delivery: {DELIVERY} (ignore_self={IGNORE_SELF}, snippet={INCLUDE_SNIPPET})")
    if need_bot:
        dm = ensure_dm_channel()
        if dm:
            print(f"  DM channel ready ({dm})")
        else:
            print("  ⚠ could not open your DM — check SLACK_REACT_BOT_TOKEN / im:write")

    sm_client = SocketModeClient(app_token=APP_TOKEN, web_client=WebClient(token=API_TOKEN))
    sm_client.socket_mode_request_listeners.append(socket_event_handler)

    def _shutdown(*_):
        print("\nShutting down...")
        try:
            sm_client.disconnect()
        except Exception:
            pass
        sys.exit(0)

    signal.signal(signal.SIGINT, _shutdown)
    signal.signal(signal.SIGTERM, _shutdown)

    print("  Connecting to Slack via Socket Mode...")
    sm_client.connect()
    print("  Connected! Listening for reactions on your messages...")
    print("  (If nothing arrives, confirm Event Subscriptions has reaction_added")
    print("   under 'Subscribe to events on behalf of users'.)")
    while True:
        time.sleep(1)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
