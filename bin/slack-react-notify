#!/usr/bin/env -S python3 -u
"""
slack-react-notify: desktop notifications when people react to your Slack messages

Slack has no native notification for reactions on your own messages. This is a
small Socket Mode (WebSocket) daemon that listens for `reaction_added` events,
keeps only the ones where the reacted message is *yours*, and — by default —
DMs you on Slack. That Slack DM triggers Slack's own desktop + mobile
notification (a message you send yourself wouldn't), so you're reached on every
device. Set SLACK_REACT_DELIVERY=desktop for a local notify-send/osascript popup
instead, or =both for both.

It runs as its own dedicated Slack app — independent of ticket-bot — so the two
never fight over the same Socket Mode connection (Slack load-balances events
across simultaneous connections on one app, which would drop ~half of them).

Run:   slack-react-notify
Check: slack-react-notify --check     (validate tokens + identity, then exit)
Stop:  Ctrl+C

Requires in .env (see `slack-react-notify --help`):
  SLACK_REACT_APP_TOKEN   App-level token (xapp-...) for Socket Mode
  SLACK_REACT_TOKEN       User OAuth token (xoxp-...) — reaction events + reads
  SLACK_REACT_BOT_TOKEN   Bot token (xoxb-...) — DMs you (slack/both delivery)
  SLACK_REACT_USER_ID     (optional) your Slack user id; auto-detected otherwise
"""

import os
import platform
import re
import shlex
import shutil
import signal
import subprocess
import sys
import time
import json
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

try:
    from slack_sdk.web import WebClient
    from slack_sdk.socket_mode import SocketModeClient
    from slack_sdk.socket_mode.request import SocketModeRequest
    from slack_sdk.socket_mode.response import SocketModeResponse
except ImportError:
    print("Error: slack_sdk is required but not installed.")
    req = Path(__file__).resolve().parent.parent / "requirements.txt"
    print(f"  pip install -r {req}" if req.exists() else "  pip install slack_sdk")
    sys.exit(1)


HELP = """slack-react-notify: desktop notifications for reactions on your Slack messages

Usage:
  slack-react-notify            Start the daemon (runs in foreground)
  slack-react-notify --check    Validate tokens + print identity/scopes, then exit
  slack-react-notify --selftest Run internal unit checks, then exit
  slack-react-notify --print-manifest
                                Print a Slack app manifest to paste into
                                "Create New App → From a manifest"
  slack-react-notify --print-service systemd|launchd
                                Print a ready-to-use service definition
  slack-react-notify --help     Show this help

By default it DMs you on Slack (which also fires Slack's own desktop + mobile
notification, since a self-sent message wouldn't). Set SLACK_REACT_DELIVERY to
change that.

.env settings:
  SLACK_REACT_APP_TOKEN   (required) App-level token, xapp-...  (Socket Mode)
  SLACK_REACT_TOKEN       (required) User OAuth token, xoxp-...  (events + reads)
  SLACK_REACT_BOT_TOKEN   (required for slack delivery) Bot token, xoxb-... (DMs you)
  SLACK_REACT_DELIVERY    (optional) slack | desktop | both      (default: slack)
  SLACK_REACT_USER_ID     (optional) Your Slack user id; auto-detected via auth.test
  SLACK_REACT_NOTIFY_CMD  (optional) desktop-mode custom notifier; called as:
                          CMD "<title>" "<body>"  e.g. ~/bin/notification/claude-notify.sh
  SLACK_REACT_IGNORE_SELF (optional) "0" to also notify on your own reactions (default: ignore)
  SLACK_REACT_SNIPPET     (optional) "0" to skip fetching the reacted message text
  SLACK_REACT_DEBUG       (optional) "1" to log every reaction_added event received

Dedicated Slack app setup (separate from ticket-bot). Fastest path:
  `slack-react-notify --print-manifest` → paste at https://api.slack.com/apps →
  "Create New App" → "From a manifest". Then:
  1. Basic Information → App-Level Tokens → generate one with `connections:write`
     → save as SLACK_REACT_APP_TOKEN (xapp-...)
  2. OAuth & Permissions → Install to Workspace, authorize, then copy BOTH tokens:
       "User OAuth Token" (xoxp-...)      → SLACK_REACT_TOKEN     (events + reads)
       "Bot User OAuth Token" (xoxb-...)  → SLACK_REACT_BOT_TOKEN (DMs you)
  3. slack-react-notify --check   to confirm it all works.

Manual scope reference (the manifest sets these for you):
  User Token Scopes: reactions:read, users:read, channels:history, groups:history,
                     im:history, mpim:history, channels:read, groups:read,
                     im:read, mpim:read
                     (cover EVERY channel/DM you're in — no bot invites needed)
  Bot Token Scopes:  chat:write, im:write   (to DM you)
  Event Subscriptions → "Subscribe to events on behalf of users": reaction_added
"""

SCRIPT_DIR = Path(__file__).resolve().parent
ENV_FILE = SCRIPT_DIR.parent / ".env"

SNIPPET_MAX = 140

