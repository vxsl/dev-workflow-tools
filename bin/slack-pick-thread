#!/usr/bin/env bash
# Pick a Slack thread with fzf — one you've taken part in.
#
# Usage:
#   slack-pick-thread              Pick a thread; prints its permalink
#   slack-pick-thread --refresh    Rebuild the thread list first
#   slack-pick-thread --warm       Rebuild the thread list and exit (no picker)
#   slack-pick-thread --check      Report the token's identity and scopes, then exit
#
# Exit codes:
#   0  a thread was chosen — its permalink is on stdout
#   1  cancelled
#   2  unavailable (no user token, no fzf) — the caller should ask for a paste
#
# Why a picker: the destination for an MR link is nearly always a thread you were
# already in — the one that reported the bug, or asked for the change. Pasting its
# URL means leaving the terminal, finding the thread, "Copy link", and coming back.
# The same thread is two keystrokes away if we go and read the ones you're in.
#
# Requires a user token (xoxp) in SLACK_USER_TOKEN, issued by the same app as
# TICKET_CREATOR_BOT_TOKEN. A bot token cannot stand in: it can only see the
# channels the BOT is in, and the question here is which channels YOU are in.
#
# There is deliberately no fallback to another app's user token. This started out
# borrowing the reaction-notifier's, which worked because that app happened to
# carry the history scopes — but a token is issued per app install, so falling
# back means this tool's behaviour depends on which unrelated app is installed,
# --check reports scopes from an app you are not configuring, and the fix it
# prints names the wrong one. Set it up on its own app.
#
# search.messages would answer "what have I been part of" in one call, but needs a
# search:read scope. Without it the list is reconstructed from what the granted
# scopes do allow: the channels you're a member of (channels:read, groups:read) and
# the recent messages in each (channels:history, groups:history). A thread counts as
# yours if you started it, replied to it, or are mentioned in it. DMs are absent
# because im:read isn't granted — and they aren't where MRs get announced anyway.

set -e

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$(type -P "$0" || echo "$0")")")" && pwd)"

# .env assigns unconditionally, so sourcing it would overwrite a token passed in
# for this one run. Defaults belong in the file; an explicit value on the command
# line has to beat them, or `SLACK_USER_TOKEN=… slack-pick-thread --check` quietly
# checks a different token than the one you handed it.
# ${VAR+set} rather than a non-empty test, so that an explicit empty value counts
# as "the caller said no token" and turns the picker off, instead of silently
# falling through to whatever .env happens to hold.
_token_was_passed=${SLACK_USER_TOKEN+yes}
_token_from_env="${SLACK_USER_TOKEN:-}"
if [ -f "$SCRIPT_DIR/../.env" ]; then
    source "$SCRIPT_DIR/../.env"
fi
[ -n "$_token_was_passed" ] && SLACK_USER_TOKEN="$_token_from_env"

CACHE_DIR="${SLACK_PICKER_CACHE_DIR:-$HOME/.cache/publish-changes/slack-picker}"
THREADS_TSV="$CACHE_DIR/threads.tsv"
CHANNELS_TSV="$CACHE_DIR/channels.tsv"
USERS_TSV="$CACHE_DIR/users.tsv"
IDENTITY="$CACHE_DIR/identity"

# How long a thread list stays useful. A stale list is still served instantly and
# refreshed behind the picker — only a cold cache makes you wait.
THREADS_TTL="${SLACK_PICKER_TTL:-300}"
DIRECTORY_TTL="${SLACK_PICKER_DIRECTORY_TTL:-86400}"   # users and the channel list
HISTORY_DEPTH="${SLACK_PICKER_DEPTH:-40}"              # messages read per channel
FETCH_JOBS="${SLACK_PICKER_JOBS:-6}"                   # concurrent history calls

# REFRESH forces everything, directory caches included. FORCE_THREADS re-sweeps
# the threads alone — which is all the background refresher below wants, and all
# --warm should ask for: who exists and which channels you're in change on a scale
# of days, and re-fetching them every five minutes buys nothing.
REFRESH=false
FORCE_THREADS=false
WARM_ONLY=false
CHECK_ONLY=false
RENDER_MODE=""
RENDER_QUERY=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --refresh) REFRESH=true; FORCE_THREADS=true; shift ;;
        --warm)    FORCE_THREADS=true; WARM_ONLY=true; shift ;;
        --check)   CHECK_ONLY=true; REFRESH=true; shift ;;
        # Internal: what the picker's reload bindings call to redraw a scope.
        --render)  RENDER_MODE="$2"; shift 2 ;;
        --render-query) RENDER_MODE=query; RENDER_QUERY="$2"; shift 2 ;;
        --help|-h) sed -n '2,/^[^#]/{/^[^#]/!p;}' "$0"; exit 0 ;;
        *) echo "Unknown argument: $1" >&2; exit 2 ;;
    esac
done

RED='\033[38;5;167m'
GREEN='\033[38;5;114m'
YELLOW='\033[38;5;221m'
CYAN='\033[38;5;109m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

# ---------------------------------------------------------------------------
# Availability
# ---------------------------------------------------------------------------

# The scopes the sweep needs, split by what losing each one actually costs.
# Checked up front rather than discovered as an empty list: Slack answers every
# call with missing_scope, and that reads downstream as "you have no threads".
SCOPES_REQUIRED="channels:read channels:history"     # public channels — the floor
SCOPES_PRIVATE="groups:read groups:history"          # private channels
SCOPES_NAMES="users:read"                            # names instead of U0123ABC

# With search, the list is two calls and always fresh. Without it, the same list
# has to be reconstructed by reading every channel you're in — see refresh_threads.
# Slack grants this either as one umbrella scope or per conversation type.
has_search() {
    has_scope search:read || has_scope search:read.public || has_scope search:read.private
}

SLACK_TOKEN="${SLACK_USER_TOKEN:-}"
if [ -z "$SLACK_TOKEN" ]; then
    # Not configured is not the same as misconfigured: the picker is optional and
    # pasting a URL still works, so this stays a single line. A token that IS set
    # but cannot do the job gets the loud treatment further down.
    echo -e "  ${DIM}slack-pick-thread: SLACK_USER_TOKEN not set — see .env.example${RESET}" >&2
    exit 2
fi
for tool in curl jq awk; do
    command -v "$tool" >/dev/null 2>&1 || { echo "slack-pick-thread: $tool not found" >&2; exit 2; }
done
if [ -x "$HOME/.zsh/fzf/bin/fzf" ]; then
    FZF="$HOME/.zsh/fzf/bin/fzf"
elif command -v fzf >/dev/null 2>&1; then
    FZF="fzf"
else
    echo "slack-pick-thread: fzf not found" >&2
    exit 2
fi

# The cache holds message text from private channels. It's your own machine and
# your own messages, but it doesn't need to be readable by everyone on the box.
mkdir -p "$CACHE_DIR"
chmod 700 "$CACHE_DIR" 2>/dev/null || true

# ---------------------------------------------------------------------------
# Slack
# ---------------------------------------------------------------------------

# .text is empty for anything not typed as plain text: composed in blocks, posted
# by a workflow, or — most often — an uncaptioned screenshot, where the file name
# is the whole message. Those are still threads, and a blank row is a row you
# cannot pick, so dig the strings back out of wherever the message put them.
#
# Shared by both list sources: search matches and channel history carry the same
# message shape, and a row should not read differently depending on which found it.
JQ_MESSAGE_BODY='
def body:
      ( if (.text // "") != "" then .text
        else ( [ .blocks[]? | .. | objects | select(.text? | type == "string") | .text ]
               + [ .attachments[]? | (.fallback // .text // empty) ]
               + [ .files[]? | (.title // .name // empty) ]
               | map(select(. != "")) | join(" ") )
        end
      | gsub("[\\n\\t]+"; " ") | gsub(" +"; " ") );
'

slack_get() {
    local method="$1"; shift
    local args=() kv
    for kv in "$@"; do args+=(--data-urlencode "$kv"); done
    curl -s --max-time 20 -G "https://slack.com/api/${method}" \
        -H "Authorization: Bearer ${SLACK_TOKEN}" "${args[@]}"
}

# Seconds since $1 was last written, or a number large enough to read as expired.
age_of() {
    [ -f "$1" ] || { echo 999999999; return; }
    echo $(( $(date +%s) - $(stat -c %Y "$1" 2>/dev/null || echo 0) ))
}

stale() { [ "$(age_of "$1")" -gt "$2" ]; }

# A short, non-reversible stand-in for the token, so the cache can tell "same
# token as last time" from "you rotated it" without ever storing the token.
token_fingerprint() {
    if command -v sha256sum >/dev/null 2>&1; then
        printf '%s' "$SLACK_TOKEN" | sha256sum | cut -c1-16
    else
        printf '%s' "$SLACK_TOKEN" | cksum | tr -d ' '
    fi
}

# Who am I, which workspace, and what may this token do. The first decides whether
# a thread is yours, the second builds permalinks locally instead of a getPermalink
# call per row, and the third is checked before any of the sweep runs.
#
# auth.test carries the granted scopes in a response header, which is the only way
# to ask "what can this token do" without trying something and reading the error.
load_identity() {
    local fp
    fp=$(token_fingerprint)

    if [ "$REFRESH" != true ] && ! stale "$IDENTITY" "$DIRECTORY_TTL"; then
        # shellcheck disable=SC1090
        source "$IDENTITY"
        # A changed token invalidates everything cached about the old one, scopes
        # above all — otherwise adding the scope you were told to add appears to
        # do nothing until the 24h TTL runs out.
        if [ -n "${SLACK_ME:-}" ] && [ -n "${SLACK_HOST:-}" ] && [ "${SLACK_TOKEN_FP:-}" = "$fp" ]; then
            return 0
        fi
    fi

    local headers auth
    headers=$(mktemp)
    auth=$(curl -s --max-time 20 -D "$headers" -X POST "https://slack.com/api/auth.test" \
        -H "Authorization: Bearer ${SLACK_TOKEN}")
    SLACK_SCOPES=$(grep -i '^x-oauth-scopes:' "$headers" 2>/dev/null \
        | sed 's/^[^:]*: *//; s/[[:space:]]*$//' | tr ',' ' ' | tr -s ' ')
    rm -f "$headers"

    if [ "$(printf '%s' "$auth" | jq -r '.ok // false')" != "true" ]; then
        echo "slack-pick-thread: auth.test failed: $(printf '%s' "$auth" | jq -r '.error // "unknown"')" >&2
        return 1
    fi

    SLACK_ME=$(printf '%s' "$auth" | jq -r '.user_id')
    SLACK_WHO=$(printf '%s' "$auth" | jq -r '.user // "?"')
    SLACK_TEAM=$(printf '%s' "$auth" | jq -r '.team // "?"')
    # Only a bot token comes back with a bot_id. It is the one reliable way to
    # tell the two apart — the scope NAMES are identical between bot and user
    # tokens, so a bot token sails through a check that only reads scopes.
    SLACK_BOT_ID=$(printf '%s' "$auth" | jq -r '.bot_id // ""')
    # .url is "https://team.slack.com/"; permalinks want just the host.
    SLACK_HOST=$(printf '%s' "$auth" | jq -r '.url' | sed 's|^https://||; s|/$||')
    printf 'SLACK_ME=%s\nSLACK_HOST=%s\nSLACK_WHO=%s\nSLACK_TEAM=%s\nSLACK_BOT_ID=%s\nSLACK_TOKEN_FP=%s\nSLACK_SCOPES="%s"\n' \
        "$SLACK_ME" "$SLACK_HOST" "$SLACK_WHO" "$SLACK_TEAM" "$SLACK_BOT_ID" "$fp" "$SLACK_SCOPES" > "$IDENTITY"
}

# A bot token is not a weaker user token, it is a different subject. It would
# sweep the channels the BOT is in and call the result yours, and search.messages
# refuses it outright — so this is checked before the scopes, and separately.
require_user_token() {
    [ -z "${SLACK_BOT_ID:-}" ] && return 0
    {
        echo ""
        echo -e "${RED}${BOLD}  ✗ slack-pick-thread: SLACK_USER_TOKEN is a bot token${RESET}"
        echo ""
        echo -e "    ${DIM}it authenticates as${RESET} ${BOLD}${SLACK_WHO:-?}${RESET} ${DIM}(bot ${SLACK_BOT_ID}), not you${RESET}"
        echo ""
        echo -e "    ${DIM}A bot token can only see the channels the BOT is in. The question${RESET}"
        echo -e "    ${DIM}here is which channels YOU are in, so it has to be a user token.${RESET}"
        echo ""
        echo -e "    ${DIM}On OAuth & Permissions there are two, and it is the first one:${RESET}"
        echo -e "      ${BOLD}User OAuth Token${RESET}       ${DIM}xoxp-…   ← this one${RESET}"
        echo -e "      ${DIM}Bot User OAuth Token   xoxb-…   ← what is set now${RESET}"
        echo ""
        echo -e "    ${DIM}The user token only appears once the app has ${RESET}User Token Scopes${DIM}${RESET}"
        echo -e "    ${DIM}(a separate list from Bot Token Scopes) and has been reinstalled.${RESET}"
        echo ""
        echo -e "    ${DIM}Skipping the picker — paste a Slack URL instead.${RESET}"
        echo ""
    } >&2
    return 1
}

has_scope() {
    case " ${SLACK_SCOPES:-} " in *" $1 "*) return 0 ;; esac
    return 1
}

# Which of $@ this token does not have, space separated.
missing_scopes() {
    local want out=""
    for want in $@; do has_scope "$want" || out="$out $want"; done
    printf '%s' "${out# }"
}

# Refuse loudly rather than sweep 66 channels for an empty list. Silence here is
# the failure mode worth designing against: every call comes back missing_scope,
# every one is discarded, and the picker reports that you have no threads.
require_scopes() {
    local missing
    missing=$(missing_scopes "$SCOPES_REQUIRED")
    [ -z "$missing" ] && return 0

    {
        echo ""
        echo -e "${RED}${BOLD}  ✗ slack-pick-thread: SLACK_USER_TOKEN is missing scopes it needs${RESET}"
        echo ""
        echo -e "    ${RED}missing:${RESET} ${BOLD}${missing}${RESET}"
        echo -e "    ${DIM}granted:${RESET} ${DIM}${SLACK_SCOPES:-<none reported>}${RESET}"
        echo -e "    ${DIM}token:   ${SLACK_WHO:-?} @ ${SLACK_TEAM:-?}${RESET}"
        echo ""
        echo -e "    ${DIM}Add them under ${RESET}User Token Scopes${DIM} on the same app as${RESET}"
        echo -e "    ${DIM}TICKET_CREATOR_BOT_TOKEN, reinstall it, and put the new xoxp- token${RESET}"
        echo -e "    ${DIM}in .env as ${RESET}SLACK_USER_TOKEN${DIM}.${RESET}"
        echo -e "    ${DIM}Then: ${RESET}slack-pick-thread --check"
        echo ""
        echo -e "    ${DIM}Skipping the picker — paste a Slack URL instead.${RESET}"
        echo ""
    } >&2
    return 1
}

refresh_users() {
    { [ "$REFRESH" = true ] || stale "$USERS_TSV" "$DIRECTORY_TTL"; } || return 0
    local tmp="$USERS_TSV.$$"
    slack_get users.list "limit=1000" \
        | jq -r '.members[]? | [.id, (if (.profile.display_name // "") != "" then .profile.display_name else (.real_name // .name) end)] | @tsv' \
        > "$tmp" 2>/dev/null || true
    if [ -s "$tmp" ]; then mv "$tmp" "$USERS_TSV"; else rm -f "$tmp"; fi
}

# The channels you're in — not destinations in their own right, just the set of
# places a thread you've been in can be.
refresh_channels() {
    { [ "$REFRESH" = true ] || stale "$CHANNELS_TSV" "$DIRECTORY_TTL"; } || return 0
    local tmp="$CHANNELS_TSV.$$"
    # Ask only for what this token may see. Requesting private_channel without
    # groups:read fails the whole call, taking the public channels down with it —
    # so a missing private scope has to narrow the question, not break it.
    local types="public_channel"
    [ -z "$(missing_scopes "$SCOPES_PRIVATE")" ] && types="public_channel,private_channel"
    slack_get users.conversations \
        "types=$types" "exclude_archived=true" "limit=1000" \
        | jq -r '.channels[]? | [.id, .name] | @tsv' \
        > "$tmp" 2>/dev/null || true
    if [ -s "$tmp" ]; then mv "$tmp" "$CHANNELS_TSV"; else rm -f "$tmp"; fi
}

# One channel's recent thread parents, as raw rows:
#   last-activity ts │ mine? │ channel │ author id │ replies │ text │ channel/ts
#
# reply_users is how a thread declares its participants without a replies call per
# thread — Slack caps it at five, so a busy thread you're deep in can still miss;
# the mention test picks up most of what that loses.
fetch_channel_threads() {
    local id="$1" name="$2"
    slack_get conversations.history "channel=$id" "limit=$HISTORY_DEPTH" 2>/dev/null \
        | jq -r --arg ch "$id" --arg name "$name" --arg me "$SLACK_ME" "$JQ_MESSAGE_BODY"'
            .messages[]?
            | select((.reply_count // 0) > 0)
            | (.latest_reply // .ts) as $last
            | (if (.user == $me)
                    or ((.reply_users // []) | index($me))
                    or ((.text // "") | contains("<@" + $me + ">"))
               then "1" else "0" end) as $mine
            # .text is empty for anything not typed as plain text: composed in
            # blocks, posted by a workflow, or — most often here — an uncaptioned
            # screenshot, where the file name is the whole message. Those
            # are still threads, and a blank row is a row you cannot pick, so dig
            # the strings back out of wherever the message actually put them.
            | ( if (.text // "") != "" then .text
                else ( [ .blocks[]? | .. | objects | select(.text? | type == "string") | .text ]
                       + [ .attachments[]? | (.fallback // .text // empty) ]
                       + [ .files[]? | (.title // .name // empty) ]
                       | map(select(. != "")) | join(" ") )
                end
                | gsub("[\\n\\t]+"; " ") | gsub(" +"; " ") ) as $body
            | [ $last, $mine, $name, (.user // ""), ((.reply_count // 0) | tostring),
                $body, ($ch + "/" + .ts) ]
            | @tsv
        ' 2>/dev/null || true
}

# Ask Slack directly: the messages you sent, and the ones that named you. Two
# calls, and the answer is the question rather than a reconstruction of it.
#
# A reply's permalink carries ?thread_ts=<root>, which is the thread's identity —
# so the thread each message belongs to comes back with the message, and no call
# per thread is needed to find out. A message without one is top-level: it may be
# a thread root or a standalone message, and search does not say which. Both are
# somewhere you can post, so both are offered.
#
# $2 says whose words the row is showing: 1 yours, otherwise $kind — 2 for someone
# else naming you, 0 for someone else who merely matched what you searched for.
#
# Derived from the message author, not from which query found it. Slack's
# "@someone" search matches messages from that person as well as ones naming them,
# so the query a row arrived on says less about it than its author does.
search_threads() {
    local kind="$1" query="$2"
    slack_get search.messages "query=$query" "count=100" "sort=timestamp" \
        | jq -r --arg kind "$kind" --arg me "$SLACK_ME" "$JQ_MESSAGE_BODY"'
            .messages.matches[]?
            # A reply carries ?thread_ts=<root>; a top-level message carries none,
            # and is its own root. The fallback has to be inside the binding: a
            # capture that does not match yields an empty stream, and binding an
            # empty stream drops the message entirely rather than defaulting it.
            | ((.permalink | capture("thread_ts=(?<t>[0-9.]+)").t) // .ts) as $root
            # A DM has no channel name — Slack puts the other persons user id
            # there instead. Marked with @ so the renderer resolves it to a name
            # rather than printing #U0A1B2C3 as though it were a channel.
            | (if (.channel.is_im // false) or (.channel.is_mpim // false)
               then "@" + (.channel.name // .channel.id // "?")
               else (.channel.name // .channel.id // "?") end) as $where
            | [ .ts, (if (.user // "") == $me then "1" else $kind end),
                $where,
                (.user // ""),
                "",
                body,
                ((.channel.id // "") + "/" + $root) ]
            | @tsv
        ' 2>/dev/null || true
}

# One row per thread, newest first. A thread you have said five things in is one
# place to post, not five rows — and the most recent of those is what dates it.
write_threads() {
    local tmp="$THREADS_TSV.$$"
    sort -t $'\t' -k1,1nr | awk -F'\t' '!seen[$7]++' > "$tmp" || true
    if [ -s "$tmp" ]; then mv "$tmp" "$THREADS_TSV"; else rm -f "$tmp"; return 1; fi
}

refresh_threads_via_search() {
    { search_threads 1 "from:@${SLACK_WHO}"
      search_threads 2 "@${SLACK_WHO}"; } | write_threads
}

# Search the workspace for words, not for yourself — the thread about a thing you
# were never in. Reached from the picker with whatever you have typed so far, which
# is the search you were already halfway through expressing by filtering.
#
# Rows go to a file of their own, never the cache. A one-off search is a view, not
# a new answer to "which threads are yours" — persisting it would leave the next
# picker opening on someone else's search results for the rest of the TTL.
query_threads_file() {
    local out="$CACHE_DIR/query.tsv"
    search_threads 0 "$1" | sort -t $'\t' -k1,1nr | awk -F'\t' '!seen[$7]++' > "$out" 2>/dev/null || true
    printf '%s\n' "$out"
}

# Sweep every channel, a few at a time. Each writes its own file so concurrent
# output can't interleave, and the merge sorts newest-activity-first once — the
# picker's reload bindings then only ever filter an already-ordered list.
refresh_threads() {
    [ -s "$CHANNELS_TSV" ] || return 1

    local work tmp id name running=0
    work=$(mktemp -d)
    tmp="$THREADS_TSV.$$"

    while IFS=$'\t' read -r id name _; do
        [ -n "$id" ] || continue
        fetch_channel_threads "$id" "$name" > "$work/$id" &
        running=$((running + 1))
        if [ "$running" -ge "$FETCH_JOBS" ]; then
            wait
            running=0
        fi
    done < "$CHANNELS_TSV"
    wait

    cat "$work"/* 2>/dev/null | sort -t $'\t' -k1,1nr > "$tmp" || true
    rm -rf "$work"

    if [ -s "$tmp" ]; then mv "$tmp" "$THREADS_TSV"; else rm -f "$tmp"; return 1; fi
}

# ---------------------------------------------------------------------------
# Rendering
#
# Two tab-separated fields: what fzf shows, and the permalink behind it.
# --with-nth=1 hides the second; the selection is cut back down to it.
# ---------------------------------------------------------------------------

render_threads() {
    local scope="$1"
    local src="${2:-$THREADS_TSV}"
    [ -s "$src" ] || return 0
    awk -F'\t' -v OFS='\t' \
        -v scope="$scope" -v now="$(date +%s)" -v host="$SLACK_HOST" \
        -v usersfile="$USERS_TSV" '
        BEGIN {
            while ((getline u < usersfile) > 0) {
                split(u, p, "\t"); if (p[1] != "") name[p[1]] = p[2]
            }
            close(usersfile)
        }
        # 90s → " 90s", then m, h, d, w. Always four columns wide.
        function ago(ts,   d) {
            d = now - int(ts)
            if (d < 60)     return sprintf("%3ds", d)
            if (d < 3600)   return sprintf("%3dm", d / 60)
            if (d < 86400)  return sprintf("%3dh", d / 3600)
            if (d < 604800) return sprintf("%3dd", d / 86400)
            return sprintf("%3dw", d / 604800)
        }
        # Pad and clip to an exact width so the text column starts in the same
        # place on every row. gawk counts characters here, not bytes.
        function fit(s, w) {
            if (length(s) > w) return substr(s, 1, w - 1) "…"
            return sprintf("%-" w "s", s)
        }
        # Same clip without the padding. Applied after unmark, never before —
        # cutting the raw text first can leave half a <url|label> token behind,
        # which then has no closing bracket to be recognised by.
        function clip(s, w) {
            if (length(s) > w) return substr(s, 1, w - 1) "…"
            return s
        }
        # Slack ships its own markup inside message text: <@U123> for a person,
        # <#C123|name> for a channel, <url|label> for a link. Left alone it is
        # most of what a row shows and none of what you recognise a thread by.
        # Written out with match/substr rather than gawk gensub, so the picker
        # degrades to a plain awk rather than failing to parse under one.
        function unmark(s,   out, tok, bar, id) {
            out = ""
            while (match(s, /<[^>]*>/)) {
                out = out substr(s, 1, RSTART - 1)
                tok = substr(s, RSTART + 1, RLENGTH - 2)
                bar = index(tok, "|")
                if (substr(tok, 1, 1) == "@") {
                    id = bar ? substr(tok, 2, bar - 2) : substr(tok, 2)
                    out = out "@" ((id in name) ? name[id] : id)
                } else if (substr(tok, 1, 1) == "#") {
                    out = out "#" (bar ? substr(tok, bar + 1) : substr(tok, 2))
                } else if (substr(tok, 1, 1) == "!") {
                    out = out "@" (bar ? substr(tok, bar + 1) : substr(tok, 2))
                } else {
                    out = out (bar ? substr(tok, bar + 1) : tok)
                }
                s = substr(s, RSTART + RLENGTH)
            }
            out = out s
            gsub(/&lt;/, "<", out); gsub(/&gt;/, ">", out); gsub(/&amp;/, "\\&", out)
            return out
        }
        # 0 is a thread you had no part in, which only the channel sweep produces.
        scope == "mine" && $2 == "0" { next }
        {
            author = ($4 in name) ? name[$4] : $4
            # ● your words   ◐ someone else naming you   · someone else
            mark = "\033[2m·\033[0m"
            if ($2 == "1") mark = "\033[38;5;114m●\033[0m"
            else if ($2 == "2") mark = "\033[38;5;221m◐\033[0m"

            # Search does not report a reply count, and an invented one is worse
            # than none — say nothing rather than "(0 replies)".
            replies = ($5 == "") ? "" : "  \033[2m(" $5 " replies)\033[0m"

            # "C123/1785174817.436329" → ".../archives/C123/p1785174817436329".
            # Only the timestamp loses its dot; the host keeps its own.
            split($7, loc, "/")
            ts = loc[2]
            sub(/\./, "", ts)
            link = "https://" host "/archives/" loc[1] "/p" ts

            # A DM arrives as "@<user id>" — resolve it to a name, since an id is
            # not something you recognise a conversation by.
            where = $3
            if (substr(where, 1, 1) == "@") {
                who = substr(where, 2)
                where = "@" ((who in name) ? name[who] : who)
            } else {
                where = "#" where
            }

            print mark " \033[2m" ago($1) "\033[0m  " \
                  "\033[38;5;109m" fit(where, 22) "\033[0m " \
                  "\033[38;5;141m" fit(author, 14) "\033[0m " \
                  clip(unmark($6), 200) replies, \
                  link
        }
    ' "$src"
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

load_identity || exit 2

if [ "$CHECK_ONLY" = true ]; then
    echo ""
    echo -e "  ${BOLD}SLACK_USER_TOKEN${RESET}  ${DIM}(${SLACK_WHO:-?} @ ${SLACK_TEAM:-?})${RESET}"
    echo ""
    # Before any scope line, because the scope lines look identical either way and
    # would otherwise report a bot token as perfectly configured.
    if [ -n "${SLACK_BOT_ID:-}" ]; then
        echo -e "  ${RED}✗${RESET} bot token ${DIM}— needs the User OAuth Token (xoxp-), not the bot one${RESET}"
    else
        echo -e "  ${GREEN}✓${RESET} user token ${DIM}— authenticates as you${RESET}"
    fi
    echo ""
    # Split on | — scope names are full of colons.
    for group in "$SCOPES_REQUIRED|required — public channels" \
                 "$SCOPES_PRIVATE|optional — private channels" \
                 "$SCOPES_NAMES|optional — names instead of user ids"; do
        want="${group%%|*}"; note="${group#*|}"
        gone=$(missing_scopes "$want")
        if [ -z "$gone" ]; then
            echo -e "  ${GREEN}✓${RESET} ${want}  ${DIM}${note}${RESET}"
        else
            echo -e "  ${RED}✗${RESET} ${want}  ${DIM}${note}${RESET}"
            echo -e "    ${RED}missing: ${gone}${RESET}"
        fi
    done
    echo ""
    echo -e "  ${DIM}granted: ${SLACK_SCOPES:-<none reported>}${RESET}"
    echo ""
    # search:read would replace the whole 66-call sweep with one request, so say
    # so here rather than leaving it as folklore in a commit message.
    if has_scope search:read || has_scope search:read.public; then
        echo -e "  ${GREEN}✓${RESET} search:read ${DIM}— available (the sweep could be replaced by one call)${RESET}"
    else
        echo -e "  ${DIM}·${RESET} ${DIM}search:read.public/.private not granted — the thread list is${RESET}"
        echo -e "    ${DIM}swept one call per channel instead of fetched in one.${RESET}"
    fi
    echo ""
    [ -n "${SLACK_BOT_ID:-}" ] && exit 2
    [ -z "$(missing_scopes "$SCOPES_REQUIRED")" ] || exit 2
    exit 0
fi

require_user_token || exit 2
require_scopes || exit 2

# Where the list comes from. With search it is two calls and the answer is the
# question; without it, the same list has to be reconstructed by reading every
# channel you're in, one call each.
if has_search; then LIST_MODE=search; else LIST_MODE=sweep; fi

refresh_primary() {
    if [ "$LIST_MODE" = search ]; then
        refresh_threads_via_search
    else
        refresh_channels
        refresh_threads
    fi
}

# Reload bindings re-enter here. Nothing is printed to stderr on this path: fzf
# owns the terminal while it runs, and a stray line would land on top of it.
if [ -n "$RENDER_MODE" ]; then
    case "$RENDER_MODE" in
        # Threads matching words rather than matching you, so they are shown
        # whether or not you were in them.
        query)   render_threads all "$(query_threads_file "$RENDER_QUERY")" ;;
        all)     refresh_channels >/dev/null 2>&1 || true
                 refresh_threads >/dev/null 2>&1 || true
                 render_threads all ;;
        refresh) refresh_primary >/dev/null 2>&1 || true; render_threads mine ;;
        *)       render_threads mine ;;
    esac
    exit 0
fi

refresh_users

# Resolved once, and absolutely: it is handed to a detached process below and to
# fzf's reload bindings further down, neither of which inherits this cwd.
self=$(readlink -f "$0")

if [ "$LIST_MODE" = search ]; then
    # A second, and current. Nothing to gain by serving yesterday's answer.
    if [ ! -s "$THREADS_TSV" ] || [ "$FORCE_THREADS" = true ] || stale "$THREADS_TSV" "$THREADS_TTL"; then
        refresh_threads_via_search \
            || { echo -e "  ${YELLOW}slack-pick-thread: search returned nothing${RESET}" >&2; exit 2; }
    fi
elif [ ! -s "$THREADS_TSV" ] || [ "$FORCE_THREADS" = true ]; then
    # A cold sweep is worth waiting for; a stale one isn't. Serve what's on disk
    # and refresh behind the picker, so it only ever opens slowly once.
    echo "  Reading your Slack threads…" >&2
    refresh_primary || { echo "slack-pick-thread: could not read Slack threads" >&2; exit 2; }
elif stale "$THREADS_TSV" "$THREADS_TTL"; then
    # Detached, so closing the terminal on the picker doesn't take the refresh
    # with it and leave a half-written cache behind.
    if command -v setsid >/dev/null 2>&1; then
        setsid "$self" --warm >/dev/null 2>&1 < /dev/null &
    else
        ( "$self" --warm >/dev/null 2>&1 < /dev/null & )
    fi
fi

[ "$WARM_ONLY" = true ] && exit 0

# Open on the threads you're in — unless you aren't in any, in which case that
# view is an empty box telling you nothing.
scope=mine
[ -n "$(render_threads mine | head -1)" ] || scope=all

# Ctrl-A widens the net, but to different places. With search it means "look for
# these words across the workspace, mine or not" — the thread about a thing you
# were never in, which no amount of local filtering will surface. Without search
# there is nothing to search, so the only way to widen is the channel sweep.
if [ "$LIST_MODE" = search ]; then
    widen_bind="ctrl-a:change-prompt(  Slack search > )+reload('$self' --render-query {q})"
    widen_help='Ctrl-A: search the workspace for what you typed'
else
    widen_bind="ctrl-a:change-prompt(  Slack all threads > )+reload('$self' --render all)"
    widen_help='Ctrl-A: every recent thread in your channels'
fi

selection=$(
    render_threads "$scope" | $FZF \
        --ansi \
        --delimiter='\t' \
        --with-nth=1 \
        --height=80% \
        --reverse \
        --border=rounded \
        --print-query \
        --prompt="  Slack > " \
        --header="${widen_help}  │  Ctrl-R: back to your threads"$'\nOr paste a Slack URL and press Enter' \
        --bind "$widen_bind" \
        --bind "ctrl-r:change-prompt(  Slack > )+reload('$self' --render refresh)" \
        --bind 'ctrl-d:half-page-down,ctrl-u:half-page-up' \
    || true
)

# --print-query puts the typed text on line 1 and the selection, if any, on line
# 2. A query that matched nothing is how a pasted URL finds its way back out.
chosen=$(printf '%s\n' "$selection" | sed -n '2p')
query=$(printf '%s\n' "$selection" | sed -n '1p')

if [ -n "$chosen" ]; then
    printf '%s\n' "$chosen" | cut -f2
    exit 0
fi
if [[ "$query" =~ ^https://[^/]*slack\.com/ ]]; then
    printf '%s\n' "$query"
    exit 0
fi
exit 1
