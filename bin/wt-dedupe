#!/usr/bin/env bash
# wt-dedupe: Collapse byte-identical files across worktrees into shared btrfs extents.
#
# Every worktree gets its own physical copy of every git-tracked file. For large
# static fixtures that is pure waste: test_data/ is ~685M and there are 200+
# worktrees, so a big slice of the disk is the same bytes over and over.
#
# On btrfs the right primitive is a reflink (shared extent), not a symlink:
#   - invisible to git, so worktrees stay clean (a symlink would make git report
#     the whole directory as deleted, since these files are tracked)
#   - copy-on-write, so a later write to one copy diverges instead of silently
#     corrupting its siblings the way a hardlink would
#
# Identity comes from git rather than from reading bytes. Two worktrees that
# record the same blob hash for a path, with no unstaged modification to it,
# hold identical content by definition -- so a full byte comparison would mean
# re-reading a hundred-plus gigabytes to re-derive what the index already knows.
#
# Usage: wt-dedupe [--subpath DIR] [--canonical WT] [--min-size BYTES]
#                  [--repos DIR] [--apply]
# Default is a dry run; pass --apply to actually reflink.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$(type -P "$0" || echo "$0")")")" && pwd)"
if [ -f "$SCRIPT_DIR/../.env" ]; then
    set -a; source "$SCRIPT_DIR/../.env"; set +a
fi

REPOS_DIR="${WT_DEDUPE_REPOS:-$HOME/work/repos}"
SUBPATH="${WT_DEDUPE_SUBPATH:-test_data}"
CANONICAL="${WT_DEDUPE_CANONICAL:-}"
MIN_SIZE="${WT_DEDUPE_MIN_SIZE:-262144}"
APPLY=0

while [ $# -gt 0 ]; do
    case "$1" in
        --subpath)   SUBPATH="${2:?--subpath needs a value}"; shift 2 ;;
        --canonical) CANONICAL="${2:?--canonical needs a value}"; shift 2 ;;
        --min-size)  MIN_SIZE="${2:?--min-size needs a value}"; shift 2 ;;
        --repos)     REPOS_DIR="${2:?--repos needs a value}"; shift 2 ;;
        --apply)     APPLY=1; shift ;;
        -h|--help)   sed -n '2,24p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *)           echo "✗ Unknown argument: $1" >&2; exit 1 ;;
    esac
done

[ -d "$REPOS_DIR" ] || { echo "✗ No such repos directory: $REPOS_DIR" >&2; exit 1; }

# Worktrees holding the subpath, canonical first.
mapfile -t holders < <(
    find "$REPOS_DIR" -mindepth 2 -maxdepth 3 -type d -path "*/$SUBPATH" 2>/dev/null \
        | sed "s|/$SUBPATH\$||" | sort
)
[ "${#holders[@]}" -ge 2 ] || { echo "✗ Need >=2 worktrees with $SUBPATH" >&2; exit 1; }

if [ -n "$CANONICAL" ]; then
    canonical_wt="$REPOS_DIR/$CANONICAL"
else
    canonical_wt="${holders[0]}"
fi
[ -d "$canonical_wt/$SUBPATH" ] || { echo "✗ No $SUBPATH under $canonical_wt" >&2; exit 1; }

# The canonical copy must itself match its blobs, or we would propagate a
# local edit into every other worktree.
if [ -n "$(git -C "$canonical_wt" diff-files --name-only -- "$SUBPATH" 2>/dev/null)" ]; then
    echo "✗ $canonical_wt has unstaged changes under $SUBPATH; pick another --canonical" >&2
    exit 1
fi

declare -A canon_blob=()
while read -r _mode blob _stage path; do
    canon_blob["$path"]="$blob"
done < <(git -C "$canonical_wt" ls-files -s -- "$SUBPATH" 2>/dev/null)

echo "Canonical: ${canonical_wt#"$REPOS_DIR"/} (${#canon_blob[@]} tracked files under $SUBPATH)" >&2
echo "Holders:   ${#holders[@]} worktree(s)" >&2
echo "Threshold: files >= $(numfmt --to=iec --suffix=B "$MIN_SIZE" 2>/dev/null || echo "$MIN_SIZE")" >&2

# Physical offset of a file's first extent; two files already sharing extents
# report the same offset, which makes repeat runs cheap. awk must consume all of
# filefrag's output rather than exiting at the first match, or filefrag takes a
# SIGPIPE and kills the run.
first_extent() {
    filefrag -v "$1" 2>/dev/null \
        | awk '/^ *0:/ && !seen { gsub(/\.\./, "", $4); print $4; seen = 1 }' || true
}

saved_bytes=0; linked=0; already=0; skipped=0

for wt in "${holders[@]}"; do
    [ "$wt" = "$canonical_wt" ] && continue

    declare -A dirty=()
    while IFS= read -r p; do dirty["$p"]=1; done \
        < <(git -C "$wt" diff-files --name-only -- "$SUBPATH" 2>/dev/null)

    while read -r _mode blob _stage path; do
        [ "${canon_blob[$path]:-}" = "$blob" ] || { skipped=$((skipped + 1)); continue; }
        [ -n "${dirty[$path]:-}" ] && { skipped=$((skipped + 1)); continue; }

        src="$canonical_wt/$path"
        dst="$wt/$path"
        [ -f "$src" ] && [ -f "$dst" ] || { skipped=$((skipped + 1)); continue; }
        [ -L "$dst" ] && { skipped=$((skipped + 1)); continue; }

        size=$(stat -c %s "$dst" 2>/dev/null) || continue
        [ "$size" -ge "$MIN_SIZE" ] || { skipped=$((skipped + 1)); continue; }

        src_ext=$(first_extent "$src")
        if [ -n "$src_ext" ] && [ "$(first_extent "$dst")" = "$src_ext" ]; then
            already=$((already + 1)); continue
        fi

        saved_bytes=$((saved_bytes + size))
        linked=$((linked + 1))

        if [ "$APPLY" -eq 1 ]; then
            tmp="$dst.wt-dedupe.$$"
            dst_mtime=$(stat -c %Y "$dst")
            if cp --reflink=always "$src" "$tmp" 2>/dev/null; then
                chmod --reference="$dst" "$tmp" 2>/dev/null || true
                touch -d "@$dst_mtime" "$tmp"
                mv -f "$tmp" "$dst"
            else
                rm -f "$tmp"
                echo "✗ reflink failed: ${dst#"$REPOS_DIR"/}" >&2
                saved_bytes=$((saved_bytes - size)); linked=$((linked - 1))
            fi
        fi
    done < <(git -C "$wt" ls-files -s -- "$SUBPATH" 2>/dev/null)

    unset dirty
done

human=$(numfmt --to=iec --suffix=B "$saved_bytes" 2>/dev/null || echo "${saved_bytes}B")
if [ "$APPLY" -eq 1 ]; then
    echo "✓ Reflinked $linked file(s), $human of duplicate logical bytes collapsed" >&2
else
    echo "✓ Would reflink $linked file(s), $human of duplicate logical bytes" >&2
    echo "  (dry run -- re-run with --apply)" >&2
fi
echo "  $already already shared, $skipped skipped (below threshold, differing blob, or dirty)" >&2
echo "  note: du/stat report uncompressed size on this zstd btrfs; real reclaim is smaller" >&2
