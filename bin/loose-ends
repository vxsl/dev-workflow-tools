#!/usr/bin/env bash
# loose-ends: Find work you finished and then lost track of.
#
# Work arcs sprawl across Claude sessions, git branches, stashes and MRs. Any one
# of those alone looks fine; the loss happens in the joins. Reconstructing an arc
# by hand costs a whole session -- one such reconstruction turned up 26 unpushed
# commits, a 14-commit local-only branch, and a diagnosed prod correctness bug
# that existed nowhere but `git stash@{0}`.
#
# The naive version of this tool -- "list every anomaly" -- does not work here.
# Measured on this machine: 310 branches carry unpushed commits and 98 stashes
# touch source. A report of all of them is wallpaper. So this ranks instead of
# enumerating, and leans on one strong signal: a branch a Claude session actually
# worked on (91 of 439 branches) is work you invested in, not an experiment.
#
# Silence comes from --dismiss, not from having nothing to say. Findings are
# fingerprinted by content, so a dismissed item stays quiet until it changes --
# and any new work on it changes it.
#
# Read-only. Never pushes, never writes to a repo, never posts anywhere.
#
# Usage: loose-ends [--days N] [--repos DIR] [--all] [--dismiss] [--forget]
#                   [--no-mr] [--no-sessions] [--limit N]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$(type -P "$0" || echo "$0")")")" && pwd)"
if [ -f "$SCRIPT_DIR/../.env" ]; then
    set -a; source "$SCRIPT_DIR/../.env"; set +a
fi

DAYS="${LOOSE_ENDS_DAYS:-7}"
REPOS_DIR="${LOOSE_ENDS_REPOS:-$HOME/work/repos}"
PROJECTS_DIR="${LOOSE_ENDS_PROJECTS:-$HOME/.claude/projects}"
LIMIT="${LOOSE_ENDS_LIMIT:-8}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/loose-ends"
DISMISSED="$STATE_DIR/dismissed"
SHOW_ALL=0
DO_DISMISS=0
WANT_MR=1
WANT_SESSIONS=1

while [ $# -gt 0 ]; do
    case "$1" in
        --days)        DAYS="${2:?--days needs a value}"; shift 2 ;;
        --repos)       REPOS_DIR="${2:?--repos needs a value}"; shift 2 ;;
        --limit)       LIMIT="${2:?--limit needs a value}"; shift 2 ;;
        --all)         SHOW_ALL=1; shift ;;
        --dismiss)     DO_DISMISS=1; shift ;;
        --forget)      rm -f "$DISMISSED"; echo "✓ Forgot all dismissals" >&2; exit 0 ;;
        --no-mr)       WANT_MR=0; shift ;;
        --no-sessions) WANT_SESSIONS=0; shift ;;
        -h|--help)     sed -n '2,25p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *)             echo "✗ Unknown argument: $1" >&2; exit 1 ;;
    esac
done

[ -d "$REPOS_DIR" ] || { echo "✗ No such repos directory: $REPOS_DIR" >&2; exit 1; }
mkdir -p "$STATE_DIR"
touch "$DISMISSED"

NOW=$(date +%s)
CUTOFF_DAYS="$DAYS"

# Findings accumulate as "score<TAB>class<TAB>fingerprint<TAB>text" and are sorted
# and filtered at the end. The fingerprint is what --dismiss remembers; it embeds
# a sha or count so the item returns the moment the underlying work changes.
FINDINGS=$(mktemp); trap 'rm -f "$FINDINGS"' EXIT

add() { printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" >>"$FINDINGS"; }

# ---------------------------------------------------------------- session index
# A branch that appears in a session transcript is one a session invested in.
# Extracting it is a single rg pass over every transcript -- cheap even at 376M,
# because we never parse a transcript, only scan it for the gitBranch field.
#
# THE GOTCHA: the project directory comes from the session's cwd, so sessions run
# from $HOME land in projects/-home-kyle/ and record gitBranch=HEAD or nothing.
# Those are invisible to any repo-scoped search, so we index every project dir.
SESSION_BRANCHES=$(mktemp); trap 'rm -f "$FINDINGS" "$SESSION_BRANCHES"' EXIT
: >"$SESSION_BRANCHES"

if [ "$WANT_SESSIONS" -eq 1 ] && [ -d "$PROJECTS_DIR" ]; then
    # Emits "branch<TAB>transcript-path", deduped. `grep` here is a ugrep shell
    # function that silently skips files it thinks are binary -- rg only.
    rg -oN --with-filename '"gitBranch":"[^"]*"' "$PROJECTS_DIR" 2>/dev/null \
        | sed 's|:"gitBranch":"|\t|; s|"$||' \
        | awk -F'\t' 'NF==2 && $2!="" && $2!="HEAD" {print $2"\t"$1}' \
        | sort -u >"$SESSION_BRANCHES" || true
fi

sessions_for_branch() {
    [ -s "$SESSION_BRANCHES" ] || { echo 0; return; }
    awk -F'\t' -v b="$1" '$1==b' "$SESSION_BRANCHES" | wc -l
}

# ------------------------------------------------------------------ repo sweep
# Worktrees share one object store and one ref namespace, so 209 worktrees of ul
# are one repo to us. Dedupe by --git-common-dir or we would report everything
# two hundred times.
declare -A SEEN_REPO=()
REPOS=()
while IFS= read -r d; do
    [ -d "$d/.git" ] || [ -f "$d/.git" ] || continue
    common=$(git -C "$d" rev-parse --git-common-dir 2>/dev/null) || continue
    case "$common" in /*) ;; *) common="$d/$common" ;; esac
    common=$(readlink -f "$common" 2>/dev/null || echo "$common")
    [ -n "${SEEN_REPO[$common]:-}" ] && continue
    SEEN_REPO[$common]=1
    REPOS+=("$d")
done < <(find "$REPOS_DIR" -mindepth 1 -maxdepth 1 -type d | sort)

[ ${#REPOS[@]} -gt 0 ] || { echo "✗ No git repos under $REPOS_DIR" >&2; exit 1; }

for repo in "${REPOS[@]}"; do
    rname=$(basename "$repo")
    git -C "$repo" rev-parse --verify -q origin/main >/dev/null 2>&1 || continue

    # -- local main behind origin/main ------------------------------------------
    if behind=$(git -C "$repo" rev-list --count main..origin/main 2>/dev/null) \
       && [ "${behind:-0}" -gt 0 ]; then
        add 50 main-behind "$rname:main-behind:$behind" \
            "$rname: local main is $behind commit(s) behind origin/main"
    fi

    # -- worktree set, to tell a set-up workspace from a bare branch ------------
    declare -A HAS_WT=()
    while IFS= read -r line; do
        case "$line" in
            "branch refs/heads/"*) HAS_WT["${line#branch refs/heads/}"]=1 ;;
        esac
    done < <(git -C "$repo" worktree list --porcelain 2>/dev/null)

    # -- duplicate tips = two branches holding the same work --------------------
    while IFS= read -r sha; do
        [ -n "$sha" ] || continue
        names=$(git -C "$repo" for-each-ref --points-at "$sha" \
                    --format='%(refname:short)' refs/heads | paste -sd', ' -)
        add 60 dup-tip "$rname:dup:$sha" \
            "$rname: same tip ${sha:0:9} on multiple branches -- $names"
    done < <(git -C "$repo" for-each-ref --format='%(objectname)' refs/heads \
                | sort | uniq -d)

    # -- unpushed work ---------------------------------------------------------
    # Unpushed means "not reachable from any remote ref", which is stricter and
    # more honest than trusting an upstream's ahead-count: a branch tracking
    # origin/main can sit 5 commits ahead with no remote branch of its own.
    while IFS='|' read -r name sha ts; do
        [ -n "$name" ] || continue
        n=$(git -C "$repo" rev-list --count "$name" --not --remotes 2>/dev/null) || continue
        [ "${n:-0}" -gt 0 ] || continue
        age=$(( (NOW - ts) / 86400 ))
        [ "$age" -ge "$CUTOFF_DAYS" ] || continue

        nsess=$(sessions_for_branch "$name")
        wt="${HAS_WT[$name]:-}"

        # Tiering, not filtering: a session having worked the branch is the
        # strongest evidence the commits are real work rather than a spike.
        if [ "$nsess" -gt 0 ]; then
            score=$(( 200 + n ))
            why="$nsess session(s)"
        elif [ -n "$wt" ]; then
            score=$(( 100 + n ))
            why="worktree, no session"
        else
            score=$(( 10 + n ))
            why="no session, no worktree"
        fi
        add "$score" unpushed "$rname:unpushed:$name:$sha:$n" \
            "$rname: $name has $n unpushed commit(s), idle ${age}d ($why)"
    done < <(git -C "$repo" for-each-ref --no-merged origin/main \
                --format='%(refname:short)|%(objectname:short)|%(committerdate:unix)' \
                refs/heads)

    # -- stashes ---------------------------------------------------------------
    # This is the class that hid a prod bug, so it gets weighted on two things
    # the plain list cannot show: whether it touches source, and whether the
    # branch it was taken on still exists to return to.
    while IFS='|' read -r ref sha ts msg; do
        [ -n "$ref" ] || continue
        age=$(( (NOW - ts) / 86400 ))
        [ "$age" -ge "$CUTOFF_DAYS" ] || continue

        files=$(git -C "$repo" stash show --name-only "$sha" 2>/dev/null) || files=""
        nsrc=$(printf '%s\n' "$files" \
                | rg -c '\.(rs|ts|tsx|js|jsx|py|sql|go|java|kt|swift|c|cc|cpp|h|hpp)$' \
                || true)
        nsrc="${nsrc:-0}"

        # "WIP on <branch>: ..." / "On <branch>: ..." -- the branch it belongs to.
        base=$(printf '%s' "$msg" | sed -n 's/^\(WIP on\|On\) \([^:]*\):.*/\2/p')
        stranded=""
        case "$base" in
            # A stash taken on the mainline is not stranded -- main always exists
            # and is always an ancestor of origin/main, so testing it for
            # "merged" flags every such stash for no reason.
            main|master|"") ;;
            "(no branch)")
                stranded="taken on detached HEAD" ;;
            *)
                if ! git -C "$repo" rev-parse --verify -q "refs/heads/$base" >/dev/null 2>&1; then
                    stranded="branch gone"
                elif git -C "$repo" merge-base --is-ancestor \
                        "refs/heads/$base" origin/main 2>/dev/null; then
                    stranded="branch merged"
                fi ;;
        esac

        [ "$nsrc" -gt 0 ] || [ -n "$stranded" ] || continue

        score=$(( 120 + nsrc + age / 7 ))
        [ -n "$stranded" ] && score=$(( score + 60 ))
        detail="${nsrc} source file(s)"
        [ -n "$stranded" ] && detail="$detail, $stranded"
        add "$score" stash "$rname:stash:$sha" \
            "$rname: $ref on '${base:-?}' -- ${age}d old, $detail"
    done < <(git -C "$repo" stash list --format='%gd|%H|%ct|%gs' 2>/dev/null)

    # -- open MRs nobody has commented on --------------------------------------
    # An open MR is not an anomaly -- that is just work in flight. An open MR with
    # zero comments that has not moved in days is one nobody has picked up. The
    # list subcommand shows neither comment count nor age, so ask the API, which
    # returns both for every MR in a single request.
    if [ "$WANT_MR" -eq 1 ] && command -v glab >/dev/null 2>&1; then
        mr_cutoff=$(( NOW - CUTOFF_DAYS * 86400 ))
        mrs=$(cd "$repo" && timeout 30 glab api \
                'projects/:id/merge_requests?scope=created_by_me&state=opened&per_page=100' \
                2>/dev/null) || mrs=""
        if [ -z "$mrs" ]; then
            add 40 mr-unavailable "$rname:mr-unavailable" \
                "$rname: could not read MRs (glab failed or not authed) -- MR checks skipped"
        else
            while IFS='|' read -r num updated title; do
                [ -n "$num" ] || continue
                age=$(( (NOW - updated) / 86400 ))
                add $(( 70 + age )) mr-quiet "$rname:mr:$num:$updated" \
                    "$rname: !$num has no comments, idle ${age}d -- $(printf '%.60s' "$title")"
            done < <(printf '%s' "$mrs" | jq -r --argjson cut "$mr_cutoff" '
                        .[]
                        | select(.user_notes_count == 0)
                        | (.updated_at | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601) as $u
                        | select($u <= $cut)
                        | "\(.iid)|\($u)|\(.title)"' 2>/dev/null)
        fi
    fi
done

# --------------------------------------------- sessions that recorded no branch
# Substantive work with no branch attached is the case that hid the two most
# important sessions of the proof-case arc: both ran from $HOME, so both recorded
# gitBranch=HEAD and belonged to no repo directory at all.
if [ "$WANT_SESSIONS" -eq 1 ] && [ -d "$PROJECTS_DIR" ]; then
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        mtime=$(stat -c %Y "$f" 2>/dev/null) || continue
        age=$(( (NOW - mtime) / 86400 ))
        [ "$age" -ge "$CUTOFF_DAYS" ] || continue
        awk -F'\t' -v p="$f" '$2==p {found=1; exit} END{exit !found}' \
            "$SESSION_BRANCHES" && continue
        turns=$(rg -cN '"type":"user"' "$f" 2>/dev/null || echo 0)
        [ "${turns:-0}" -ge 40 ] || continue
        add $(( 90 + turns / 10 )) session-no-branch "session:$(basename "$f" .jsonl)" \
            "session $(basename "$f" .jsonl | cut -c1-8) -- $turns turns, ${age}d ago, no branch recorded"
    done < <(find "$PROJECTS_DIR" -name '*.jsonl' -size +200k 2>/dev/null)
fi

# ------------------------------------------------------------------- reporting
if [ ! -s "$FINDINGS" ]; then
    echo "✓ No loose ends (threshold ${DAYS}d)" >&2
    exit 0
fi

SHOWN=$(mktemp); trap 'rm -f "$FINDINGS" "$SESSION_BRANCHES" "$SHOWN"' EXIT
sort -t$'\t' -k1,1nr "$FINDINGS" >"$SHOWN"

if [ "$SHOW_ALL" -eq 0 ]; then
    KEPT=$(mktemp)
    # Match on FILENAME, not NR==FNR: an empty dismissal file makes NR==FNR true
    # for the findings too, which would dismiss everything on a first run.
    awk -F'\t' -v df="$DISMISSED" \
        'FILENAME==df {d[$0]=1; next} !($3 in d)' "$DISMISSED" "$SHOWN" >"$KEPT" || true
    ndismissed=$(( $(wc -l <"$SHOWN") - $(wc -l <"$KEPT") ))
    mv "$KEPT" "$SHOWN"
else
    ndismissed=0
fi

if [ ! -s "$SHOWN" ]; then
    echo "✓ No new loose ends ($ndismissed dismissed, threshold ${DAYS}d)" >&2
    exit 0
fi

# What the report will actually print, caps applied. --dismiss works off exactly
# this, because dismissing findings that were withheld behind "... and 89 more"
# would silence work nobody ever looked at. Use --all --dismiss for the rest.
DISPLAY=$(mktemp)
trap 'rm -f "$FINDINGS" "$SESSION_BRANCHES" "$SHOWN" "$DISPLAY"' EXIT
awk -F'\t' -v lim="$LIMIT" -v all="$SHOW_ALL" \
    '{ c[$2]++; if (all == 1 || c[$2] <= lim) print }' "$SHOWN" >"$DISPLAY"

if [ "$DO_DISMISS" -eq 1 ]; then
    cut -f3 "$DISPLAY" >>"$DISMISSED"
    sort -u -o "$DISMISSED" "$DISMISSED"
    nd=$(wc -l <"$DISPLAY"); nt=$(wc -l <"$SHOWN")
    echo "✓ Dismissed $nd shown finding(s); they return if the work changes" >&2
    [ "$nt" -gt "$nd" ] && \
        echo "  $(( nt - nd )) withheld finding(s) left alone (--all --dismiss for those)" >&2
    exit 0
fi

# Group by class so the output reads as a short list per kind, and always say
# what was withheld -- a silent cap reads as "nothing else to see".
for class in main-behind session-no-branch stash unpushed dup-tip mr-quiet mr-unavailable; do
    # Totals come from the full set, lines from the capped set, so the header count
    # is honest about how much exists and the footer says what it held back. Never
    # pipe awk into `head` here: the SIGPIPE that hands awk when head closes trips
    # `set -o pipefail` and kills the report halfway through.
    awk -F'\t' -v c="$class" -v shown="$SHOWN" '
        FILENAME == shown { if ($2 == c) tot++; next }
        $2 == c { buf = buf "  " $4 "\n"; n++ }
        END {
            if (tot == 0) exit 0
            printf "\n%s (%d)\n", c, tot
            printf "%s", buf
            if (tot > n) printf "  ... and %d more (--all)\n", tot - n
        }' "$SHOWN" "$DISPLAY" >&2
done

total=$(wc -l <"$SHOWN")
printf '\n✓ %s loose end(s), threshold %sd' "$total" "$DAYS" >&2
[ "$ndismissed" -gt 0 ] && printf ' (%s dismissed)' "$ndismissed" >&2
printf '\n  --dismiss to go quiet until they change; --all for everything\n' >&2
