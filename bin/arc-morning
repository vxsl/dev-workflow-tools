#!/usr/bin/env -S python3 -u
"""
arc-morning: the few sentences that make the page worth opening.

Everything else in this pipeline derives a fact and renders it near its neighbours. That
gives a page you can read, and it still asks you to do the reading -- to look at a ledger,
a cliff section and a Jira-mismatch table and work out for yourself which of the three is
about to cost you a day. This composes that judgement into prose:

    what changed under you, what you owe and what is owed to you, what you promised and
    did not do, what you dropped, and where the record contradicts itself.

Three rules hold it honest, and they are the whole design.

**Every claim is a projection of a derived input.** Not "you should look at UL-1692" but
"Jira calls UL-1692 In Qualification while nine days of work on it never reached a
remote", which is `gap.status_mismatch` said in a sentence. Nothing here counts anything:
the counts, the clocks and above all the *rankings* come down the wire already computed --
`ledger.they_owe` is sorted worst-first by work-arcs, `forgotten` is `fell_off_a_cliff`'s
own order, `since_last_run.changes` is sorted by CHANGE_RANK. A ranking re-implemented
here would be a second author for the same judgement, and the two would differ within a
month. This is `derive_lede`'s contract from arcs-page, which it supersedes, kept word for
word and given four more inputs to project.

**It selects rather than enumerates.** Five candidate sentences, in a fixed order of
what will bite soonest, and each one is dropped when it has nothing to say. The page holds
everything; this holds the part you would regret not having read. A brief that listed all
fourteen ledger rows would be the ledger with worse formatting.

**An acknowledged fact does not open the page.** `✕` on a row means "I have seen this",
and the loudest paragraph on the page is exactly where that has to be honoured or the
mechanism is decorative. So selection skips dismissed rows and the counts it quotes are
counts of unacknowledged ones -- the same numbers the ledger's own headings show.

Why a stage of its own rather than a function in work-arcs: the sentences name workstreams,
and the good name for a workstream is `brief.name`, which does not exist until arc-brief
has run. Composing this upstream would have meant either naming arcs by their raw cluster
label or teaching work-arcs to do arc-brief's job. It runs after arc-brief and before
arcs-page, and it adds one top-level `brief` key. (Each *arc* also carries a `brief` --
arc-brief's per-arc description. Different thing, same word; the collision is the price of
the obvious name for both.)

    work-arcs --json | arc-brief | arc-morning | arcs-page --out page.html

The model pass is garnish and is built to be removable. The deterministic composition below
is what ships: it is complete prose on its own, and `--no-model` is a supported way to run.
What the model adds is the joining -- turning five independent statements into a paragraph
-- and it is allowed to add nothing else. See `smooth()` for the contract and the four
checks that enforce it.
"""

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
from datetime import date, datetime, timedelta
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import headless_claude  # noqa: E402
from commitments import COMMITMENT_KINDS  # noqa: E402
from timespan import fmt_interval  # noqa: E402
from statefile import load_store  # noqa: E402
from workscale import work_scale  # noqa: E402

STATE = (Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
         / "work-arcs")
CACHE = STATE / "morning.json"

# A quiet interval is only news when it was long enough for noise to have been likely.
# Rebuilding the page twice in an hour and being told "nothing moved in the last 51
# minutes" is the stamp line said twice; being told it about the last fourteen hours is a
# fact about the night.
QUIET_MIN_SECONDS = 6 * 3600

# The window in which a date boundary crossed between two builds means a night passed
# rather than a midnight rebuild or a long weekend.
NIGHT_MIN, NIGHT_MAX = 4 * 3600, 20 * 3600


# --------------------------------------------------------------------------- parts


def ref(text, **kw):
    """A span of the brief that is a claim about one identifiable thing.

    `t` is the words; everything else says where the evidence for them is. arcs-page
    resolves those in its own order of preference -- a row on this page beats a link off
    it, because the point of the brief is that the cards below are the layer you expand
    into rather than a second place to look.
    """
    return {"t": text, **{k: v for k, v in kw.items() if v}}


# What each line is a fact ABOUT, in three words, set as a label beside it. The brief used
# to be one serif paragraph and it was not being read: five sentences each carrying a claim,
# a number, a superlative and a subordinate clause, run together with nothing to tell a
# reader which one was about what. The facts were right and the form hid them. These are the
# only presentation this stage holds, and they are here rather than in the page because the
# kind is this stage's own vocabulary -- the page has no business knowing that `contradiction`
# means Jira.
LEAD = {
    "changed": "since the build", "quiet": "since the build", "owed": "open loop",
    "overdue": "past due", "forgotten": "dropped", "contradiction": "jira disagrees",
    "allclear": "all clear",
}


def sentence(kind, parts):
    """One sentence, and the flat text that is a projection of it.

    `text` is never composed independently of `parts` -- it is `parts` joined -- so the
    two cannot drift, and the fingerprint the model cache keys on is the same string a
    reader sees.
    """
    parts = [p for p in parts if p != ""]
    return {"kind": kind, "parts": parts,
            "text": "".join(p if isinstance(p, str) else p["t"] for p in parts)}


def flat(sentences):
    """Every sentence's parts, space-joined into one paragraph's worth."""
    out = []
    for i, s in enumerate(sentences):
        if i:
            out.append(" ")
        out.extend(s["parts"])
    return out


def text_of(parts):
    return "".join(p if isinstance(p, str) else p["t"] for p in parts)


def live(rows):
    """Rows the reader has not already acknowledged. See the module docstring."""
    return [r for r in rows or [] if not r.get("dismissed")]


def days(n, unit="day"):
    return f"{n} {unit}" + ("" if n == 1 else "s")


def whoname(e):
    w = e.get("who")
    if isinstance(w, list):
        return w
    return [w] if w else []


# --------------------------------------------------------------------------- when


def interval_phrase(since, generated):
    """How long since the last build, phrased so it is true whenever the page is built.

    "Overnight" is the word the plan asks for and it is only sometimes the right one. A
    page rebuilt at 09:00 against last night's 22:00 build did span a night; the same page
    rebuilt twice before lunch did not, and telling a reader at 11:40 that something
    happened overnight when it happened forty minutes ago is a small lie that makes the
    large claims beside it worth less. So the word is earned from the interval: a calendar
    boundary crossed, and a gap long enough to have been a night and short enough not to
    have been a weekend. Everything else says how long it actually was.
    """
    secs = since.get("interval_seconds")
    prev = since.get("previous_generated")
    span = fmt_interval(secs)
    fmt = "%Y-%m-%dT%H:%M:%S%z"
    if isinstance(secs, int) and NIGHT_MIN <= secs <= NIGHT_MAX:
        try:
            a = datetime.strptime(prev, fmt)
            b = datetime.strptime(generated, fmt)
            if a.date() < b.date():
                return "overnight"
        except (ValueError, TypeError):
            pass
    if not span:
        return "since the last build"
    return f"in the {span} since the last build"


def today_of(data):
    """The build's own date, not the clock's.

    Every "N days overdue" in here is measured against this, so a brief recomposed from a
    saved payload says what it said when the payload was made instead of ageing on disk.
    """
    try:
        return datetime.strptime(data.get("generated", ""),
                                 "%Y-%m-%dT%H:%M:%S%z").date()
    except (ValueError, TypeError):
        return date.today()


# --------------------------------------------------------------------------- promises


WEEKDAYS = {n: i for i, n in enumerate(
    ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"])}


def _weekday_after(d, target, following=False):
    """The next `target` weekday on or after `d`; the one a week later if `following`."""
    ahead = (target - d.weekday()) % 7
    return d + timedelta(days=ahead + (7 if following else 0))


def _friday_of(d, following=False):
    """The Friday closing `d`'s week, or the next one when `d` is already past it."""
    f = d + timedelta(days=(4 - d.weekday()))
    if f < d:
        f += timedelta(days=7)
    return f + timedelta(days=7 if following else 0)


def promised_due(row, restatement=None):
    """The date a commitment named for itself, read out of its own words.

    A commitment row carries `promised` -- the model's three-to-eight word restatement of
    what was said -- and some of those restatements name a time: *take a look at it
    Monday*, *send it tomorrow*, *do it by the end of the week*. That is the only clock a
    commitment has. Its `days` field ages the message, not the promise, and a promise made
    six days ago for next Friday is not late.

    Read from `promised` alone and never from the quoted message. The quote is the whole
    Slack message and its dates are usually about something else -- "the release was
    Monday, I'll pick this up after" would resolve to a Monday that was never promised --
    while the restatement is by construction about the promise. Recall lost, false
    accusations avoided, which is the trade this page always makes.

    Ambiguity resolves to the later date, for the same reason. "Next Monday" said on a
    Friday might be in three days or in ten; it is read as ten, so a promise is called
    late only when it is late on every reading. Returns (date, the phrase it was read
    from) or None.
    """
    # A meeting row carries the timeframe Kyle stated as its own field, extracted apart
    # from the restatement, and that is a strictly better input than the restatement is:
    # `deadline` is the model's isolated answer to "what clock did he name", where
    # `promised` is a paraphrase of the deliverable that may or may not have kept the
    # phrase. Both are his words about the promise, which is the property that matters --
    # never the quote, whose other dates are usually about something else.
    said = (restatement if restatement is not None
            else (row.get("deadline") or row.get("promised"))) or ""
    said = said.lower()
    try:
        base = datetime.strptime(row.get("asked", "")[:10], "%Y-%m-%d").date()
    except (ValueError, TypeError):
        return None

    m = re.search(r"\bin (\d{1,2}) (?:days|day)\b", said)
    if m:
        return base + timedelta(days=int(m.group(1))), m.group(0)
    m = re.search(r"\bnext (" + "|".join(WEEKDAYS) + r")\b", said)
    if m:
        return _weekday_after(base, WEEKDAYS[m.group(1)], following=True), m.group(0)
    m = re.search(r"\b(?:on |by |come |this )?(" + "|".join(WEEKDAYS) + r")\b", said)
    if m:
        return _weekday_after(base, WEEKDAYS[m.group(1)]), m.group(1)
    if re.search(r"\bday after tomorrow\b", said):
        return base + timedelta(days=2), "the day after tomorrow"
    if re.search(r"\btomorrow\b", said):
        return base + timedelta(days=1), "tomorrow"
    # "in the next couple days", said at a standup, is a real clock and the commonest
    # shape a spoken one takes -- Kyle said exactly it of the Dove workspace migration on
    # 2026-08-24. Both readings resolve late, the way this function resolves every
    # ambiguity: a couple is two or three, so it is read as three, and a few is three to
    # five, so it is read as five. A promise is called late only when it is late on every
    # reading of what was said.
    m = re.search(r"\b(couple|few)(?: of)? (?:more )?(?:days|weeks)\b", said)
    if m:
        weeks = "weeks" in m.group(0)
        span = (3 if m.group(1) == "couple" else 5) * (7 if weeks else 1)
        return base + timedelta(days=span), m.group(0)
    if re.search(r"\bnext week\b", said):
        return _friday_of(base, following=True), "next week"
    if re.search(r"\b(?:end of (?:the )?week|this week|eow)\b", said):
        return _friday_of(base), "this week"
    if re.search(r"\b(?:today|tonight|end of (?:the )?day|eod|this (?:morning|"
                 r"afternoon|evening))\b", said):
        return base, "that day"
    return None


def overdue_commitments(ledger, today):
    """Commitments past the date they set for themselves, most overdue first.

    Total order down to the reference, because this decides text that a cache
    fingerprints -- the lesson `finalize` learned the expensive way.
    """
    out = []
    for e in live((ledger or {}).get("you_owe")):
        if e.get("kind") not in COMMITMENT_KINDS:
            continue
        due = promised_due(e)
        if not due:
            continue
        late = (today - due[0]).days
        if late > 0:
            out.append((late, e, due[0]))
    # Down to the fingerprint, not merely to the reference. One standup can hold two
    # promises whose restatements collide -- the ref is the meeting, shared by all of
    # them, where a Slack row's ref at least narrows to a channel -- and a tie here hands
    # the brief whatever order the rows arrived in, which is the arc-brief evidence
    # fingerprint lesson exactly.
    out.sort(key=lambda r: (-r[0], -(r[1].get("days") or 0),
                            r[1].get("ref") or "", r[1].get("promised") or "",
                            r[1].get("fp") or ""))
    return out


# --------------------------------------------------------------------------- clauses


def ledger_anchor(e):
    return ref(e.get("ref") or "it", fp=e.get("fp"), of="ledger", url=e.get("url"))


def they_clause(e):
    """One row of "they owe you", as the middle of a sentence rather than a table cell."""
    kind, n = e.get("kind"), e.get("days")
    who = whoname(e)
    if kind == "review-silence":
        if len(who) == 1:
            tail = f" has had nothing from {who[0]} for {days(n)}"
        else:
            tail = (f" has had nothing from any of its {len(who)} reviewers "
                    f"for {days(n)}") if who else f" has been silent for {days(n)}"
    elif kind == "ticket-stalled":
        tail = (f" has been sitting with {who[0] if who else 'someone else'} for "
                f"{days(n)}")
    elif kind == "slack-asked":
        tail = f": you asked {who[0] if who else 'them'} {days(n)} ago, and nothing came"
    else:
        tail = f" has been with {', '.join(who) or 'someone else'} for {days(n)}"
    return [ledger_anchor(e), tail]


def you_clause(e):
    """One row of "you owe them". The linked span is the artefact, not the person: the
    person is who it is about, the merge request is where the evidence is."""
    kind, n = e.get("kind"), e.get("days")
    who = (whoname(e) or ["someone"])[0]
    a = ledger_anchor(e)
    if kind == "review-owed":
        return [f"{who} has been waiting {days(n)} for your review of ", a]
    if kind == "reply-owed":
        return [f"{who} answered you on ", a, f" {days(n)} ago and it is still your turn"]
    if kind == "thread-reply":
        return [f"{who} is waiting on your reply on your own ", a, f", {days(n)} now"]
    if kind == "slack-dm":
        return [ref(f"a DM from {who}", fp=e.get("fp"), of="ledger", url=e.get("url")),
                f" has gone {days(n)} unanswered"]
    if kind == "slack-mention":
        return [f"{who} mentioned you in ", a,
                f" {days(n)} ago and you have not spoken there since"]
    if kind == "commitment":
        return ["you said you would ",
                ref(e.get("promised") or "do it", fp=e.get("fp"), of="ledger",
                    url=e.get("url")), f", {days(n)} ago"]
    if kind == "meeting-commitment":
        # Where it was said carries the weight here. A promise typed in Slack has a
        # permalink the reader can go and check; one said at a standup was heard by the
        # room and written down nowhere, and naming the meeting is what makes it findable
        # -- and what makes it credible enough to act on before opening the link.
        said = f"you said at {e['ref']} you would " if e.get("ref") else "you said you would "
        return [said,
                ref(e.get("promised") or "do it", fp=e.get("fp"), of="ledger",
                    url=e.get("url")), f", {days(n)} ago"]
    return [a, f", {days(n)}"]


# --------------------------------------------------------------------------- sentences


def since_sentence(data):
    """(a) What changed under you, as what it costs rather than as a list.

    The changes arrive ranked by CHANGE_RANK -- a conflict above a red pipeline above an
    approval nobody acted on -- so "the sharpest of them" is a fact about that ranking and
    not an opinion formed here. One of them is named and the rest are counted, because the
    strip further down the page is the list and this is the reason to read it.
    """
    since = data.get("since_last_run") or {}
    changes = since.get("changes") or []
    when = interval_phrase(since, data.get("generated", ""))
    lead = when[0].upper() + when[1:]

    if not changes:
        # Silence is only worth a sentence when the gap was long enough for it to mean
        # something, and never when there was no baseline to compare against -- the stamp
        # line already says which of the two it was.
        secs = since.get("interval_seconds")
        if not since.get("previous_generated") or not isinstance(secs, int) \
                or secs < QUIET_MIN_SECONDS:
            return None
        n = since.get("compared") or 0
        return sentence("quiet", [
            f"{lead}, nothing moved under you"
            + (f" — all {n} workstreams the last build saw are as you left them." if n
               else ".")])

    by_id = {a.get("id"): a for a in data.get("arcs") or []}
    top = changes[0]
    arc = by_id.get(top.get("id")) or {}
    name = (arc.get("brief") or {}).get("name") or top.get("label") or "one workstream"
    first = (top.get("evidence") or [{}])[0]
    what = first.get("what") or (top.get("what") or [""])[0]
    subject = ref(name, arc=top.get("id"), url=first.get("url"))

    if len(changes) == 1:
        return sentence("changed", [f"{lead}, ", subject, f" changed under you: {what}."])
    return sentence("changed", [
        f"{lead}, {len(changes)} of {since.get('compared', 0)} workstreams moved under "
        "you — the sharpest is ", subject, f", where {what}."])


def owed_sentence(data, skip_fp=""):
    """(b) The oldest open loop, in whichever direction it runs, with the other side's
    oldest beside it.

    Both sides in one sentence rather than one sentence each, and that is a judgement about
    what the ledger is for. Its whole claim is that the two directions are the same kind of
    fact -- an open loop with a person on the other end -- and splitting them across two
    sentences would have re-created the review queue it was built to stop being. Which of
    the two leads is decided by the clock alone, because ranking a debt of yours against a
    debt of theirs needs an exchange rate that does not exist.

    `skip_fp` is the row the overdue sentence is about to take. An overdue commitment is
    also a row on the "you owe them" side and is often the oldest one there, so without
    this the same fact opens two consecutive sentences -- and the second says strictly more
    about it. Suppressed silently rather than replaced: "nothing is owed the other way" is
    a claim about the ledger, and it would be false the moment it was made.
    """
    ledger = data.get("ledger")
    if not ledger:
        return None
    they, mine = live(ledger.get("they_owe")), live(ledger.get("you_owe"))
    you = [e for e in mine if not skip_fp or e.get("fp") != skip_fp]
    if not they and not you:
        return None
    t, y = (they[0] if they else None), (you[0] if you else None)

    def age(e):
        return (e.get("days") or 0) if e else -1

    # The superlative is measured against every un-dismissed row on both sides, the skipped
    # one included: "the oldest in either direction" is a claim about the ledger, not about
    # whatever this sentence was left holding. Where it does not hold, the framing drops to
    # something that does rather than the number being quietly restated as a record.
    oldest = max([age(e) for e in they + mine] or [-1])

    # `days` can tie -- two things owed the same day -- and the tiebreak is the side, with
    # yours winning, because your own debt is the one you can discharge this morning.
    if age(y) >= age(t):
        head = ("The oldest open loop in either direction is yours: " if age(y) >= oldest
                else "The oldest thing on your own side: ")
        if t is not None:
            # "; the longest anyone has kept you waiting is DE-1 has been sitting with
            # Neville" -- both clause builders produce whole predicates, so the two sides
            # have to be joined as independent clauses. The connector mirrors "on your own
            # side" in the branch below, which is the same sentence read from the far end.
            return sentence("owed", [head] + you_clause(y) + ["; the other way, "]
                            + they_clause(t) + ["."])
        return sentence("owed", [head] + you_clause(y) + ["."])

    tail = (" — the oldest open loop in either direction" if age(t) >= oldest
            else " — the longest anyone has kept you waiting")
    if y is not None:
        return sentence("owed", they_clause(t) + [tail + "; on your own side, "]
                        + you_clause(y) + ["."])
    if mine:
        return sentence("owed", they_clause(t) + [tail + "."])
    return sentence("owed", they_clause(t)
                    + [tail + ", and nothing is owed the other way."])


def overdue_sentence(data, today):
    """(c) A promise past the date it set for itself.

    The one row on this page that a person authored rather than an API, and the only one
    with a deadline of its own. It is placed above the forgotten work deliberately: a
    dropped workstream costs you a week eventually, and a promise somebody is waiting on
    costs you their patience today.
    """
    over = overdue_commitments(data.get("ledger"), today)
    if not over:
        return None
    late, e, due = over[0]
    where = e.get("ref") or ""
    who = (whoname(e) or [""])[0]
    # Three shapes of `where`: a Slack channel (`#tech-backend`), a meeting Kyle spoke in
    # (`FE standup`), and nothing at all -- a DM, where naming the room says less than the
    # counterpart already does. "in #chan" and "at FE standup" are not interchangeable
    # prepositions, and "You said in FE standup" was the sentence that made this a branch.
    spoken = e.get("kind") == "meeting-commitment" and where
    told = (f"You told {who} at {where}" if who and spoken
            else f"You said at {where}" if spoken
            else f"You told {who} in {where}" if who and where.startswith("#")
            else f"You told {who}" if who
            else f"You said in {where}" if where.startswith("#")
            else "You said")
    tail = ("." if len(over) == 1
            else f", and {len(over) - 1} other promise"
                 f"{'' if len(over) == 2 else 's'} of yours "
                 f"{'is' if len(over) == 2 else 'are'} also past its date.")
    # The resolved date rather than the words it was read from. "That Monday was 4 days
    # ago" reads well and "that tomorrow was 3 days ago" does not, and printing the date
    # the parse arrived at is also the only way to disagree with it: this is the one clock
    # on the page derived from a sentence rather than from an API.
    return sentence("overdue", [
        f"{told} you would ",
        ref(e.get("promised") or "do it", fp=e.get("fp"), of="ledger", url=e.get("url")),
        f" — that came due on {due.strftime('%a %-d %b')}, {days(late)} ago{tail}"])


def forgotten_sentence(data):
    """(d) The freshest thing you dropped, in the words the derivation already found.

    `activity.forgotten.why` is a finished sentence carrying the level, the derivative and
    the reason it is still open -- "19 sessions across 3 days, then nothing for 12 days,
    never landed" -- so it is lifted whole rather than reconstructed. The order is
    `forgotten`, which is `fell_off_a_cliff`'s: freshest cliff first, because the one you
    can still resume is the one you fell off most recently.
    """
    by_id = {a.get("id"): a for a in data.get("arcs") or []}
    order = data.get("forgotten")
    if order is None:
        return None
    fell = []
    for i in order:
        a = by_id.get(i)
        f = ((a or {}).get("activity") or {}).get("forgotten") or {}
        if f.get("verdict") and not f.get("dismissed"):
            fell.append((a, f))
    if not fell:
        return None
    arc, f = fell[0]
    name = (arc.get("brief") or {}).get("name") or arc.get("label") or "one workstream"
    why = (f.get("why") or "").rstrip(". ")
    rest = len(fell) - 1
    tail = ("." if not rest
            else f"; {rest} other{'' if rest == 1 else 's'} fell off longer ago.")
    return sentence("forgotten", [
        "The freshest thing you dropped is ",
        ref(name, fp=f.get("fp"), of="forgotten", arc=arc.get("id")),
        f" — {why}{tail}"])


def contradiction_sentence(data):
    """(e) The one place the record most undermines the rest of the page.

    The first row on the wire, which work-arcs ranks on how long each status has gone
    uncorrected -- not a `max()` taken here, and not the widest by days of work it used to
    be. Two reasons the clock won, both in `reconcile` at length: a status nobody has
    corrected in two months is wrong in a way that compounds every time the team reads it,
    while a fortnight of local work behind a ticket touched this morning is not; and
    ranking on the pile of unpushed commits made the size of this laptop's disk decide
    which ticket the brief called out, which is exactly the obsession the page was told to
    drop. One author for the ranking, so the brief, the page's lede and the table below
    them cannot name three different worst tickets.

    The staleness travels into the sentence because it decided the order, and a superlative
    whose figure is missing reads as an assertion. Where Jira never said when the ticket
    was last touched there is no clock and the sentence simply does not claim one.
    """
    mism = live((data.get("gap") or {}).get("status_mismatch"))
    if not mism:
        return None
    worst = mism[0]
    issue, arc = worst.get("issue") or {}, worst.get("arc") or {}
    n = arc.get("unpushed_live", 0)
    key = ref(issue.get("key") or worst.get("ref") or "a ticket",
              fp=worst.get("fp"), of="gap", url=issue.get("url"))
    rest = len(mism) - 1
    if n:
        scale = work_scale(arc.get("unpushed_days", 0), n)[0]
        body = ["Jira still calls ", key, f" “{issue.get('status','')}” while {scale} "
                "on it never reached a remote"]
    else:
        body = ["Jira still calls ", key, f" “{issue.get('status','')}”, "
                + (worst.get("why") or "and the code says otherwise").split(" but ")[-1]]
    stale = worst.get("stale_days") or 0
    if stale:
        body.append(f" — uncorrected for {stale} day{'' if stale == 1 else 's'}")
        body.append(f", the longest-standing of {rest + 1} tickets whose status the code "
                    "contradicts." if rest else ".")
    elif rest:
        body.append(f" — one of {rest + 1} tickets whose status the code contradicts.")
    else:
        body.append(".")
    return sentence("contradiction", body)


def allclear_sentence(data):
    """What to say when there is genuinely nothing, without claiming more than was asked.

    A run with `--no-ledger` has an empty ledger and an unconsulted one, and those are not
    the same sentence. Each clause is emitted only where the collection step actually ran,
    which is `mrs_known`'s rule applied to the whole document.
    """
    bits = []
    if data.get("ledger") is not None:
        bits.append("nothing is owed in either direction")
    if data.get("forgotten") is not None:
        bits.append("nothing has fallen off a cliff")
    if data.get("gap") is not None:
        bits.append("Jira agrees with the code")
    if not bits:
        return None
    if len(bits) > 1:
        bits[-1] = "and " + bits[-1]
    body = ", ".join(bits) if len(bits) > 2 else " ".join(bits)
    return sentence("allclear", [body[0].upper() + body[1:] + "."])


def compose(data):
    """The brief, in the order of what will bite soonest. Empty entries simply vanish."""
    today = today_of(data)
    # The overdue pick is made first so the ledger sentence can stand out of its way; it is
    # still *said* second, because it is the more specific of the two.
    over = overdue_commitments(data.get("ledger"), today)
    picked = [since_sentence(data),
              owed_sentence(data, over[0][1].get("fp", "") if over else ""),
              overdue_sentence(data, today),
              forgotten_sentence(data), contradiction_sentence(data)]
    picked = [s for s in picked if s]
    if not picked:
        picked = [s for s in [allclear_sentence(data)] if s]
    return picked


# --------------------------------------------------------------------------- the model


MODEL_PROMPT = """\
Below are the {n} line(s) that open Kyle's daily work page. Each one is an independent fact
the page's own pipeline derived. They are read as a list, one label and one line each, and
they are never to be joined into a paragraph.

Rewrite each line so it can be read at a glance: cut every word a reader does not need,
lead with the thing the line is about, keep the fact whole.

You are editing prose. You are not adding judgement.

Hard rules:
- Reply with exactly {n} line(s), one per input line, in the same order, and nothing else.
- Add no fact, number, name, ticket, date or inference that is not already in that line.
- Drop none either. Every numeral in a line must appear in your version of that line.
- These phrases are hyperlinks. Each must appear in the line it came from, verbatim,
  exactly once, and unbroken:
{anchors}
- Keep the punctuation you are given. The curly quotation marks and the em dashes are
  the page's own, and straightening them is a change to how it is set.
- Second person, plain declarative. No headings, no bullets, no numbering, no preamble,
  no sign-off. Do not tell him what to do about any of it; state what is true.

The lines:
{para}
"""


def _numbers(s):
    return set(re.findall(r"\d+", s))


def check(det, out, anchors):
    """Why the model's rewrite of one line cannot be used, or None if it can.

    Prose-smoothing is the only licence granted, so the checks are about what must have
    survived rather than about what was written. Together they make "no new facts" a thing
    the code enforces instead of a thing the prompt requests -- which matters, because the
    prompt is the part that cannot be tested.

    The numeral check is deliberately an equality of sets and not a subset: a number that
    vanished is a fact lost, and a number that appeared is a fact invented. Spelling one
    out ("twenty-nine") drops it from the set and fails, which is the safe direction --
    the deterministic paragraph is already good enough to fall back to.
    """
    if not out:
        return "the model returned nothing"
    for a in anchors:
        if out.count(a) != 1:
            return f"the link text {a!r} appeared {out.count(a)} times, not once"
    if _numbers(out) != _numbers(det):
        gone = sorted(_numbers(det) - _numbers(out))
        new = sorted(_numbers(out) - _numbers(det))
        return ("the numbers changed"
                + (f" — dropped {', '.join(gone)}" if gone else "")
                + (f" — invented {', '.join(new)}" if new else ""))
    if not 0.5 * len(det) <= len(out) <= 1.9 * len(det):
        return f"the rewrite is {len(out)} characters against {len(det)}"
    if re.search(r"^\s*(?:[-*#>]|\d+[.)])", out):
        return "the rewrite is formatted as a list item or a heading"
    return None


def reparts(out, parts):
    """Rebuild the linked spans over the model's words.

    The anchors survive verbatim by contract, so their positions in the rewrite are found
    rather than tracked, and everything between two of them is plain text. This is why the
    contract is "verbatim, exactly once" and not "roughly preserved": a span that moved or
    was reworded has nowhere to attach, and an unlinked claim in the opening paragraph is
    the one thing this page is not allowed to print.
    """
    links = [p for p in parts if not isinstance(p, str)]
    found = sorted(((out.index(p["t"]), p) for p in links), key=lambda x: x[0])
    built, at = [], 0
    for i, p in found:
        if i > at:
            built.append(out[at:i])
        built.append(p)
        at = i + len(p["t"])
    if at < len(out):
        built.append(out[at:])
    return built


def cache_key(model, prompt):
    """The whole question, hashed: the model and the prompt, and the prompt holds the
    paragraph. Item 1c's lesson in one line -- an evidence-keyed cache goes stale in
    exactly one way, and it is that the question changed while the evidence did not."""
    return hashlib.sha256(f"{model}\x00{prompt}".encode()).hexdigest()[:32]


def cache_read(key):
    entries = load_store(CACHE, "the brief-rewrite cache").get("entries")
    return entries.get(key) if isinstance(entries, dict) else None


def cache_write(key, value):
    store = load_store(CACHE, "the brief-rewrite cache") or {"v": 1}
    entries = store.get("entries")
    if not isinstance(entries, dict):
        entries = {}
    entries[key] = value
    # A brief is a fact about one morning and is never asked for twice once the day's
    # numbers have moved, so the store is a receipt trail rather than a cache to grow.
    if len(entries) > 60:
        for k, _ in sorted(entries.items(), key=lambda kv: kv[1].get("at", ""))[:-60]:
            entries.pop(k, None)
    store["entries"] = entries
    try:
        CACHE.parent.mkdir(parents=True, exist_ok=True)
        CACHE.write_text(json.dumps(store, indent=1, sort_keys=True))
    except OSError:
        pass


def smooth(sentences, model, generated, offline=False):
    """One small call that may tighten each line and may do nothing else.

    Its job changed with the shape of the block. It used to be handed a paragraph and asked
    to join the sentences into one considered whole -- which was the right instruction for a
    paragraph and is exactly wrong for a list: fusing five independent facts is what made the
    opening unreadable. Now each line is rewritten on its own, shorter, and the lines stay
    lines. One call either way; the model sees them together only so it does not repeat a
    construction five times.

    Cached on a fingerprint of the lines *and the prompt*, which is the whole of item 1c's
    lesson: an evidence-keyed cache goes stale in exactly one way, and it is that the
    question changed while the evidence did not.

    Returns (list of parts-lists, note) -- one entry per input line, or None for the whole
    pass. Rejection is all-or-nothing on purpose: a block where two lines are the model's
    and three are the pipeline's reads as two registers arguing, and the deterministic
    lines are good enough that there is nothing to salvage by mixing them.
    """
    per = [s["parts"] for s in sentences]
    dets = [text_of(p) for p in per]
    anchors = [[p["t"] for p in ps if not isinstance(p, str)] for ps in per]
    whole = "\n".join(dets)
    flatanchors = [a for line in anchors for a in line]
    dupes = [a for a in flatanchors if whole.count(a) != 1]
    if dupes:
        # Two spans with the same words cannot be told apart in the rewrite, so there is
        # no honest way to re-attach them. Rare, and cheaper to decline than to guess.
        return None, f"skipped — {dupes[0]!r} is not unique in the brief"
    if any("\n" in d for d in dets):
        # A line-per-line contract cannot survive a line that is already two.
        return None, "skipped — a line holds a newline of its own"

    prompt = MODEL_PROMPT.format(
        anchors="\n".join(f"    {a}" for a in flatanchors) or "    (none)",
        n=len(per), para=whole)
    key = cache_key(model, prompt)

    hit = cache_read(key)
    if hit and hit.get("prose"):
        return _relines(hit["prose"], per, dets, anchors)[0], f"cached ({model})"
    if hit and hit.get("why"):
        return None, f"cached refusal — {hit['why']}"
    if offline:
        return None, "not attempted"

    try:
        # Generous, and measured rather than guessed: a trivial `claude -p` returns in ~6s
        # and this one has taken 100 on the same machine, because the cost of a headless
        # session is mostly fixed and mostly not the tokens. It is paid once a morning and
        # the run degrades rather than fails, so waiting is cheaper than retrying.
        r = headless_claude.run(
            ["--model", model, "--dangerously-skip-permissions", prompt], timeout=240)
        out = r.stdout.strip() if r.returncode == 0 else ""
    except (OSError, subprocess.SubprocessError) as exc:
        # Nothing is cached on a failed call, so the next run asks again rather than
        # remembering an accident as a verdict.
        return None, f"unavailable — {type(exc).__name__}"

    built, why = _relines(out, per, dets, anchors)
    cache_write(key, {"at": generated, "prose": "" if why else out, "why": why or ""})
    if why:
        return None, f"rejected — {why}"
    return built, f"rewritten ({model})"


def _relines(out, per, dets, anchors):
    """Split the model's answer back into one parts-list per line, or say why not.

    Position is the whole contract: line i of the answer is the rewrite of line i, so an
    anchor the model moved to a different line has nowhere to attach. That is checked rather
    than trusted -- an unlinked claim in the opening block is the one thing this page is not
    allowed to print.
    """
    lines = [ln.strip() for ln in (out or "").splitlines() if ln.strip()]
    if len(lines) != len(per):
        return None, f"{len(lines)} line(s) came back for {len(per)}"
    for ln, det, anc in zip(lines, dets, anchors):
        why = check(det, ln, anc)
        if why:
            return None, why
    return [reparts(ln, ps) for ln, ps in zip(lines, per)], None


# --------------------------------------------------------------------------- main


def build(data, model="", offline=False):
    sentences = compose(data)
    # Snapshotted before anything is rewritten: `derived` is what a rewrite is auditable
    # against, so it cannot be read back off lines the rewrite has already replaced.
    derived = text_of(flat(sentences))
    lines = [{"kind": s["kind"], "lead": LEAD.get(s["kind"], ""),
              "parts": s["parts"], "text": s["text"]} for s in sentences]
    note, source = "not attempted", "deterministic"
    if sentences and model:
        smoothed, note = smooth(sentences, model, data.get("generated", ""), offline)
        if smoothed:
            for ln, parts in zip(lines, smoothed):
                ln["parts"], ln["text"] = parts, text_of(parts)
            source = "model"
    return {
        "v": 2,
        # What arcs-page renders: one labelled line per fact, in reading order. The page
        # never asks whether a model was involved -- that is this stage's business and
        # nobody else's.
        "lines": lines,
        # The deterministic composition, kept whole even when the rewrite is used.
        "sentences": sentences,
        # The same lines as one paragraph's worth of parts. Still emitted, because `--text`
        # and any reader of a v1 payload want one string of prose rather than nothing, and
        # because it costs a join.
        "parts": flat(lines),
        "text": " ".join(ln["text"] for ln in lines),
        "derived": derived,
        "source": source,
        "model": {"name": model, "note": note},
        "interval": interval_phrase(data.get("since_last_run") or {},
                                    data.get("generated", "")),
    }


def main():
    p = argparse.ArgumentParser(
        description="Compose the morning brief from a work-arcs graph.")
    p.add_argument("--from", dest="src", default="",
                   help="read the graph from a file instead of stdin")
    p.add_argument("--out", default="", help="write to a file instead of stdout")
    p.add_argument("--model", default=os.environ.get("WORK_ARCS_MORNING_MODEL", "sonnet"),
                   help="model for the prose pass (default: sonnet)")
    p.add_argument("--no-model", action="store_true",
                   help="deterministic composition only — no model call, ever")
    p.add_argument("--offline", action="store_true",
                   help="use a cached rewrite if there is one, but never make a call")
    p.add_argument("--text", action="store_true",
                   help="print the paragraph instead of the graph")
    args = p.parse_args()

    raw = Path(args.src).read_text() if args.src else sys.stdin.read()
    try:
        data = json.loads(raw)
    except ValueError as e:
        sys.exit(f"arc-morning: the graph on {args.src or 'stdin'} is not JSON ({e}). "
                 "Nothing upstream of here wrote it as JSON, so there is no brief to "
                 "compose and no payload to pass on.")
    if not isinstance(data, dict):
        sys.exit(f"arc-morning: the graph on {args.src or 'stdin'} parsed as "
                 f"{type(data).__name__}, not the object arc-brief passes on — there is "
                 "nothing here to compose a brief from")
    data["brief"] = build(data, "" if args.no_model else args.model, args.offline)

    b = data["brief"]
    print(f"  brief: {len(b['lines'])} line"
          + ("" if len(b["lines"]) == 1 else "s")
          + f" — {b['model']['note']}", file=sys.stderr)

    if args.text:
        # One line per line, with its label, because that is now the shape of the block and
        # `--text` exists to show what the page will show.
        out = "".join(f"{ln['lead']:>16}  {ln['text']}\n" for ln in b["lines"])
    else:
        out = json.dumps(data, indent=1) + "\n"
    if args.out:
        Path(args.out).write_text(out)
    else:
        sys.stdout.write(out)


if __name__ == "__main__":
    main()
