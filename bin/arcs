#!/usr/bin/env bash
# arcs: rebuild the work-arcs page, in one word instead of three.
#
# The pipeline was three programs joined by pipes and a flag you had to remember, which is
# fine to type once and wrong to type every morning -- and it was typed differently each
# time, so the page came back with a different --focus than the last one and looked like the
# work had changed when only the window had.
#
# Publishing is deliberately NOT here, and cannot be: the page lives as a Claude Code
# artifact, and only a Claude Code session can write to that URL. So this script does every
# deterministic part and then prints exactly what the publish step needs. `/arcs` is the
# one-word version that does both.
#
# The standup notes are part of the rebuild and not a mode of it: what to say on Monday is
# a projection of the same graph as everything else, and a second command to remember on a
# standup morning is a command that gets forgotten on a standup morning.
#
#   arcs                 # rebuild with your usual window
#   arcs --focus 30      # any arcs-page flag passes through
#   arcs --no-brief      # skip both model passes: faster, the cards lose their names and
#                        # the morning brief falls back to its deterministic prose. The
#                        # standup block is unaffected -- it makes no model call.
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
[ -f "$SCRIPT_DIR/../.env" ] && source "$SCRIPT_DIR/../.env"

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/work-arcs"
OUT="${WORK_ARCS_PAGE:-$STATE/page.html}"
FOCUS="${WORK_ARCS_FOCUS:-21}"
URL="${WORK_ARCS_ARTIFACT_URL:-}"

brief=1
page_args=()
while [ $# -gt 0 ]; do
    case "$1" in
        --no-brief) brief=0; shift ;;
        --focus) FOCUS="$2"; shift 2 ;;
        --focus=*) FOCUS="${1#*=}"; shift ;;
        --out) OUT="$2"; shift 2 ;;
        --out=*) OUT="${1#*=}"; shift ;;
        -h|--help) sed -n '2,18p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *) page_args+=("$1"); shift ;;
    esac
done

mkdir -p "$(dirname "$OUT")"

# Staged rather than piped, so a failure names the stage it happened in. A three-program
# pipe reports the exit status of the last one, which meant a GitLab timeout in work-arcs
# surfaced as arcs-page complaining that stdin was not JSON.
COST="$STATE/cost.json"
SNAP="$STATE/snapshot.json"

# The run-over-run baseline has to mean "the state the page last showed you". work-arcs
# writes it as soon as it has computed the graph, which is before arc-brief and arcs-page
# have had their chance to fail -- and a rebuild that died after moving the baseline would
# silently swallow an interval's worth of changes. That is the exact failure the --snapshot
# flag exists to prevent, arriving by a different door. So the old baseline is kept to one
# side and put back unless we reach the end.
finished=0
graph="$(mktemp)"
cleanup() {
    rm -f "$graph" "$graph.brief" "$graph.morning" "$graph.standup" "$COST.tmp"
    if [ "$finished" = 0 ] && [ -f "$SNAP.prev" ]; then
        mv -f "$SNAP.prev" "$SNAP"
        echo "  the rebuild did not finish, so the run-over-run baseline was put back —" >&2
        echo "  the next page still diffs against the last one you actually saw" >&2
    else
        rm -f "$SNAP.prev"
    fi
}
trap cleanup EXIT
[ -f "$SNAP" ] && cp -p "$SNAP" "$SNAP.prev"

# The quota position on either side of the run. This is the only place that knows a run is
# happening, which is what makes the pair a measurement rather than an inference: every
# model call sits between these two readings, so a run's cost and the quota it moved are
# bracketed rather than guessed at from the gaps between calls. arcs-cost degrades
# silently with no credentials and no network, so this cannot fail the rebuild.
arcs-cost --sample start || true

# --snapshot: this is the run whose state the next one is entitled to diff against. Every
# other caller -- a test, an experiment, a one-off --json -- reads the baseline and leaves
# it alone.
work-arcs --json --snapshot >"$graph"
if [ "$brief" = 1 ]; then
    arc-brief --from "$graph" >"$graph.brief"
    mv "$graph.brief" "$graph"
fi

# After arc-brief and not before it: the brief's sentences name workstreams, and the good
# name for a workstream is the one arc-brief derived. Its own model pass is optional and
# cached; --no-brief turns it off along with the other one, because "no model calls this
# run" has to mean one thing.
morning_args=()
if [ "$brief" = 0 ]; then morning_args+=(--no-model); fi
arc-morning --from "$graph" ${morning_args+"${morning_args[@]}"} >"$graph.morning"
mv "$graph.morning" "$graph"

# After arc-brief for the same reason arc-morning is, and after arc-morning only because
# the pipeline then reads in the order the page does: brief the arcs, brief the morning,
# script the standup. It makes no model call and needs no network -- the window comes off
# the clock -- so nothing here is behind --no-brief.
arc-standup --from "$graph" >"$graph.standup"
mv "$graph.standup" "$graph"

# After both model passes, because that is where the model calls are; before the page,
# which is what reads the result.
arcs-cost --sample end || true

# A sidecar rather than a key in the graph. arc-brief does pass unknown top-level keys
# through -- it reparses and redumps the whole payload -- so threading it down the pipe
# would work, but it would mean work-arcs growing a quota sampler in order to report a
# cost that is not its own. What the run spent is a fact about the run.
#
# Written fresh each time and passed only when that succeeded: a cost section quietly
# showing the previous run's numbers is the same failure as a wrong reminder.
cost_arg=()
if arcs-cost --json >"$COST.tmp" 2>/dev/null; then
    mv "$COST.tmp" "$COST"
    cost_arg=(--cost "$COST")
else
    rm -f "$COST.tmp"
fi

arcs-page --focus "$FOCUS" --out "$OUT" ${cost_arg+"${cost_arg[@]}"} \
    ${page_args+"${page_args[@]}"} <"$graph"

finished=1
echo
echo "  page:  $OUT"
# One line, only when there is something to say, and only at the end of a run somebody
# asked for. The questions are already on the page; this exists because the command line
# is where they get answered and a queue nobody knows about is a queue nobody opens. It
# is deliberately not a notification: the DE team's taskmaster bot is the shape to avoid,
# and a prompt that arrives uninvited is one the eye learns to skip.
q=$(python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(len(d.get("curation") or []))' "$graph" 2>/dev/null || echo 0)
if [ "${q:-0}" != "0" ]; then
    echo "  ask:   $q membership$([ "$q" = 1 ] || echo s) the grouping is unsure of — work-arcs --curate"
fi
if [ -n "$URL" ]; then
    echo "  live:  $URL"
    echo
    echo "  To republish, from a Claude Code session:"
    echo "    publish $OUT to $URL"
else
    echo
    echo "  No WORK_ARCS_ARTIFACT_URL set — add it to .env and this will print the"
    echo "  publish line too. Until then, publishing creates a new artifact each time."
fi
