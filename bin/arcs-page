# Parking is the one claim on this page that cannot be derived, so it is the one thing the
# page has to accept as input. It persists in the frame's own localStorage: the artifact runs
# on a per-artifact origin (`<uuid>.frame.claudeusercontent.com`), verified, so the store is
# isolated from every other page AND survives republishing, since the uuid does not change
# when the page is regenerated.
#
# Keyed on a fingerprint of the workstream's branch tips, never on its name. That is what
# makes a declaration safe here: land one commit and the fingerprint no longer matches, the
# park expires itself, and the row comes back. A park keyed on a name would be an assertion
# that never self-heals -- the failure mode every persisted correction in this pipeline is
# designed to avoid.
#
# Saving to disk is offered, not required: `work-arcs` computes its own counts and cannot see
# this store, so the file is what makes the two agree.
PARK_JS = r"""
(function(){
  var KEY='work-arcs:parked:v1', store={}, expired=[], warned=false;
  function read(){ try{ return JSON.parse(localStorage.getItem(KEY)||'{}')||{}; }
                   catch(e){ return {}; } }
  function write(){ try{ localStorage.setItem(KEY,JSON.stringify(store)); return true; }
                    catch(e){ return false; } }
  store=read();
  var list=document.getElementById('parkedlist'),
      sec=document.getElementById('parkedsec'),
      bar=document.getElementById('parkbar'), msg=document.getElementById('parkmsg'),
      saveBtn=document.getElementById('parksave'), dirty=false;

  function recount(){
    document.querySelectorAll('[data-list]').forEach(function(el){
      var n=el.querySelectorAll('.ws').length,
          c=document.querySelector('[data-count="'+el.dataset.list+'"]');
      if(c) c.textContent=n;
      var head=document.querySelector('[data-bucket="'+el.dataset.list+'"]');
      if(head) head.hidden=(n===0);
      el.hidden=(n===0);
    });
    var pn=list?list.querySelectorAll('.ws').length:0,
        pc=document.querySelector('[data-count="parked"]');
    if(pc) pc.textContent=pn;
    if(sec) sec.hidden=(pn===0);
  }
  function setBar(){
    if(!bar) return;
    bar.classList.toggle('on', dirty);
    if(msg) msg.textContent=Object.keys(store).length+' parked in this browser'
      +(warned?' — this browser could not save it, so it will not survive a reload':'');
  }
  // Apply what was parked before, and drop anything whose work has moved on since.
  document.querySelectorAll('.ws').forEach(function(el){
    var k=el.dataset.key, fp=el.dataset.fp;
    if(!(k in store)) return;
    if(store[k]!==fp){ expired.push(k); delete store[k]; return; }
    park(el,true,true);
  });
  if(expired.length){ write();
    var p=document.createElement('p'); p.className='note';
    var one=expired.length===1;
    p.textContent=expired.length+' parked workstream'+(one?'':'s')+' came back on '
      +(one?'its':'their')+' own: the work has moved since you parked '+(one?'it':'them')+'.';
    if(sec&&sec.parentNode) sec.parentNode.insertBefore(p,sec);
  }
  function park(el,on,quiet){
    el.dataset.parked=on?'1':'0';
    var btn=el.querySelector('.park');
    if(btn) btn.textContent=on?'unpark':'park';
    if(on&&list&&el.parentNode!==list) list.appendChild(el);
    if(!on&&list&&el.parentNode===list){
      var home=document.querySelector('[data-list]');
      if(home) home.appendChild(el);   // reappears under the first bucket until the next run
    }
    if(!quiet){
      if(on) store[el.dataset.key]=el.dataset.fp; else delete store[el.dataset.key];
      if(!write()) warned=true;
      dirty=true;
    }
    recount(); setBar();
  }
  document.addEventListener('click',function(ev){
    var btn=ev.target.closest?ev.target.closest('.park'):null;
    if(!btn) return;
    ev.preventDefault(); ev.stopPropagation();   // do not toggle the disclosure
    var el=btn.closest('.ws');
    park(el, el.dataset.parked!=='1', false);
  });
  if(saveBtn) saveBtn.addEventListener('click',function(){
    var out={}, now=Math.floor(Date.now()/1000);
    Object.keys(store).forEach(function(k){ out[k]={fingerprint:store[k],at:now,note:''}; });
    var data=JSON.stringify(out,null,1);
    var dl=window.claude&&window.claude.downloads;
    if(!dl){ if(msg) msg.textContent='Saving is not available in this view.'; return; }
    dl.save({filename:'parked.json',data:data}).then(function(){
      if(msg) msg.textContent='Saved. Move it to ~/.local/state/work-arcs/parked.json';
      dirty=false; setBar();
    }).catch(function(e){
      if(msg) msg.textContent=(e&&e.code==='declined')?'Not saved.'
        :('Could not save: '+((e&&e.code)||'unknown'));
    });
  });
  recount(); setBar();
})();
"""


# The page's two human inputs beyond parking, both held to the same contract: they
# persist in the artifact frame's own localStorage (per-artifact origin, so they survive
# republishing), they are keyed to content rather than to names, so any change to the
# fact underneath expires them, and saving to disk is offered rather than required --
# `work-arcs` reads dismissed.json and detached.json so the CLI and this page agree.
# Rows the files already dismissed arrive pre-marked and are adopted into the local
# store, which makes localStorage the single in-page authority after load.
#
# Acknowledgement is one store across every ✕ on the page -- a ledger row, a demand on
# its card, the same demand in the news, a Jira-mismatch row -- so acknowledging a fact
# anywhere acknowledges it everywhere it is rendered.
INTERACT_JS = r"""
(function(){
  function read(key){ try{ return JSON.parse(localStorage.getItem(key)||'{}')||{}; }
                      catch(e){ return {}; } }
  function saveFile(filename, data, msg, done){
    var dl=window.claude&&window.claude.downloads;
    if(!dl){ msg.textContent='Saving is not available in this view.'; return; }
    dl.save({filename:filename,data:data}).then(function(){
      msg.textContent='Saved. Move it to ~/.local/state/work-arcs/'+filename;
      done();
    }).catch(function(e){
      msg.textContent=(e&&e.code==='declined')?'Not saved.'
        :('Could not save: '+((e&&e.code)||'unknown'));
    });
  }
  var bar=document.getElementById('interactbar'),
      msg=document.getElementById('intmsg'),
      saveDis=document.getElementById('savedis'),
      saveDet=document.getElementById('savedet'),
      saveFil=document.getElementById('savefil');

  // --- acknowledgements ----------------------------------------------------
  var DKEY='work-arcs:dismissed:v1', dstore=read(DKEY), ddirty=false;
  function dwrite(){ try{ localStorage.setItem(DKEY,JSON.stringify(dstore)); }catch(e){} }
  var rows=[].slice.call(document.querySelectorAll('[data-fp]')), present={};
  rows.forEach(function(el){
    if(!el.dataset.fp) return;
    if(!(el.dataset.fp in present))
      present[el.dataset.fp]={ref:(el.querySelector('.ref')||{}).textContent||''};
    if(el.dataset.dismissed==='1' && !(el.dataset.fp in dstore))
      dstore[el.dataset.fp]=1;                    // adopt what the file already said
  });
  var pruned=false;
  Object.keys(dstore).forEach(function(k){
    if(!(k in present)){ delete dstore[k]; pruned=true; }  // the fact moved: expired
  });
  if(pruned) dwrite();

  // --- detachments -----------------------------------------------------------
  var TKEY='work-arcs:detached:v1', tstore=read(TKEY), tdirty=false;
  function twrite(){ try{ localStorage.setItem(TKEY,JSON.stringify(tstore)); }catch(e){} }
  var dets=[].slice.call(document.querySelectorAll('.tree .det'));
  var detOf={};
  dets.forEach(function(el){ detOf[el.dataset.branch]=el; });
  function peersOf(el){
    var out=[];
    el.ownerSVGElement.querySelectorAll('.det').forEach(function(d){
      if(d.dataset.branch!==el.dataset.branch) out.push(d.dataset.branch); });
    return out;
  }
  // Tested against the co-members rather than the label: the split pass rewords labels
  // between runs, and a recorded intent must not expire over a rewording. An entry
  // whose branch no longer shows grouped with mostly the same work has either been
  // applied by a build or overtaken by the clustering -- not this page's to keep.
  Object.keys(tstore).forEach(function(b){
    var el=detOf[b], e=tstore[b]||{};
    var keep=false;
    if(el){
      if(el.dataset.arc===(e.from||'')) keep=true;
      else if((e['with']||[]).length){
        var cur={}; peersOf(el).forEach(function(p){ cur[p]=1; });
        var hit=0; e['with'].forEach(function(p){ if(cur[p]) hit++; });
        keep=hit/e['with'].length>=0.5;
      }
    }
    if(!keep){ delete tstore[b]; twrite(); }
  });

  // --- filings ---------------------------------------------------------------
  // The one judgement on this page that no derivation can make: which ticket a workstream's
  // work IS, and therefore which of its branches are drafts from before it. Every state
  // this can reach was computed by work-arcs -- see filing() there -- so nothing here
  // derives a rung, a commit count or a demand. It records intent and swaps in the
  // pipeline's own answer.
  //
  // Seeded from the file work-arcs read, not only from the rows on screen: a workstream
  // outside the focus window has no row here, and a store built from rows alone would drop
  // its filing the moment this page saved one.
  var FKEY='work-arcs:filed:v1', fstore=read(FKEY), fdirty=false;
  function fwrite(){ try{ localStorage.setItem(FKEY,JSON.stringify(fstore)); }catch(e){} }
  var fblocks=[].slice.call(document.querySelectorAll('.fileas')), fexpired=[];
  (function(){
    var seed=document.getElementById('filedseed');
    var on={};
    try{ on=JSON.parse((seed&&seed.textContent)||'{}')||{}; }catch(e){ on={}; }
    Object.keys(on).forEach(function(k){ if(!(k in fstore)) fstore[k]=on[k]; });
  })();
  function fjson(el,attr){ try{ return JSON.parse(el.dataset[attr]||'null'); }
                           catch(e){ return null; } }
  var fby={};
  fblocks.forEach(function(el){
    el.__opts=fjson(el,'opts')||[];
    el.__off=fjson(el,'off');
    el.__ws=el.closest('.ws');
    fby[el.dataset.key]=el;
  });
  // Expired only where this page can see that it is. A filing whose workstream has no row
  // here was not checked, and "not rendered" is not "no longer true" -- the same rule the
  // dismissal prune is held to, for the same reason.
  Object.keys(fstore).forEach(function(k){
    var el=fby[k];
    if(!el) return;
    var want=(fstore[k]||{}).key, res=(fstore[k]||{}).residue;
    var o=el.__opts.filter(function(x){ return x.key===want; })[0];
    if(!o||(res&&o.residue_fp!==res)){ delete fstore[k]; fexpired.push(k); }
  });
  if(fexpired.length) fwrite();

  function fstate(el){
    var e=fstore[el.dataset.key];
    var o=e?el.__opts.filter(function(x){ return x.key===e.key; })[0]:null;
    return [o, o||el.__off];
  }
  function fapply(el){
    var pair=fstate(el), o=pair[0], st=pair[1], ws=el.__ws;
    el.querySelectorAll('.fa-o').forEach(function(b){
      b.classList.toggle('on', !!(o&&el.__opts[+b.dataset.i]
                                  &&el.__opts[+b.dataset.i].key===o.key)); });
    if(!ws||!st) return;
    ws.dataset.stage=st.stage||'';
    var sst=ws.querySelector(':scope > summary .st');
    if(sst) sst.textContent=st.state||'';
    var chip=ws.querySelector(':scope > summary .sprintchip.filed');
    if(chip) chip.hidden=!o;
    var live=ws.querySelector('.m-live'), b=live&&live.querySelector('b');
    if(live){ if(b) b.textContent=st.live;
      live.hidden=!(st.live&&st.stage!=='local-only'); }
    var cop=ws.querySelector('.m-copies');
    if(cop){ cop.hidden=!st.copies;
      cop.textContent=st.copies+(o?(' not on '+o.key):' only on a superseded copy'); }
    var fm=ws.querySelector('.filed-m');
    if(fm){ fm.hidden=!o;
      if(o) fm.textContent='filed as '+o.key
        +(o.residue.length?(', '+o.residue.length+' branch'
           +(o.residue.length===1?'':'es')+' history'):''); }
    var hist={}; (st.history||[]).forEach(function(n){ hist[n]=1; });
    ws.querySelectorAll('.tree text.n').forEach(function(n){
      n.classList.toggle('hist', !!hist[n.dataset.branch]); });
    // A demand the filing silences is not acknowledged -- nobody read it -- so it takes an
    // attribute of its own rather than borrowing the ✕ store's, which would have offered
    // it back under "N acknowledged" and saved it to dismissed.json.
    var keep={}; (st.demands||[]).forEach(function(f){ keep[f]=1; });
    ws.querySelectorAll('.needs li[data-fp]').forEach(function(li){
      li.dataset.filedOut=keep[li.dataset.fp]?'0':'1'; });
  }

  if(fexpired.length){
    var fp=document.createElement('p'); fp.className='note';
    var fone=fexpired.length===1;
    fp.textContent=fexpired.length+' filing'+(fone?'':'s')+' came back on '
      +(fone?'its':'their')+' own: a commit has landed on work '+(fone?'it':'they')
      +' set aside, so it is not history. '+(fone?'It is':'They are')+' counted again.';
    var host=fby[fexpired[0]];
    if(host&&host.parentNode) host.parentNode.insertBefore(fp,host);
  }

  function setBar(){
    if(!bar) return;
    bar.classList.toggle('on', ddirty||tdirty||fdirty);
    if(saveDis) saveDis.hidden=!ddirty;
    if(saveDet) saveDet.hidden=!tdirty;
    if(saveFil) saveFil.hidden=!fdirty;
    if(msg&&(ddirty||tdirty||fdirty))
      msg.textContent=Object.keys(dstore).length+' acknowledged, '
        +Object.keys(tstore).length+' detached, '
        +Object.keys(fstore).length+' filed in this browser';
  }

  function apply(){
    rows.forEach(function(el){
      el.dataset.dismissed=(el.dataset.fp in dstore)?'1':'0'; });
    // The ledger's sides carry their own counts and toggles.
    document.querySelectorAll('.ledger .side').forEach(function(side){
      var all=side.querySelectorAll('li[data-fp]').length,
          hid=side.querySelectorAll('li[data-dismissed="1"]').length,
          c=side.querySelector('[data-count]'), t=side.querySelector('.showdis');
      if(c) c.textContent=all-hid;
      if(t){ t.hidden=(hid===0);
        t.textContent=hid+' acknowledged — '+(side.dataset.show==='1'?'hide':'show'); }
    });
    // Everywhere else gets an auto-appended disclosure so nothing is concealed.
    document.querySelectorAll('[data-disgroup]').forEach(function(g){
      var hid=g.querySelectorAll(
        '[data-fp][data-dismissed="1"]:not([data-filed-out="1"])').length, t=g.__tog;
      // A group whose heading carries its own count keeps the two honest: a section
      // reading 6 above a list showing 2 is the sort of small lie that costs a page its
      // credit for everything else on it.
      var cf=g.dataset.countfor&&document.querySelector(g.dataset.countfor);
      if(cf) cf.textContent=g.querySelectorAll(
        '[data-fp]:not([data-filed-out="1"])').length-hid;
      if(!t){ t=document.createElement('button'); t.type='button';
        t.className='showdis'; g.__tog=t; g.insertAdjacentElement('afterend',t);
        t.addEventListener('click',function(){
          g.dataset.show=(g.dataset.show==='1')?'0':'1'; apply(); }); }
      t.hidden=(hid===0);
      t.textContent=hid+' acknowledged — '+(g.dataset.show==='1'?'hide':'show');
    });
    // A news block whose every item is acknowledged has nothing left to say.
    document.querySelectorAll('.news').forEach(function(n){
      var items=n.querySelectorAll('.item[data-fp]');
      n.style.display=(items.length&&n.querySelectorAll(
        '.item[data-dismissed="1"]').length===items.length
        &&n.closest('[data-disgroup]').dataset.show!=='1')?'none':''; });
    fblocks.forEach(fapply);
    dets.forEach(function(el){
      var on=el.dataset.branch in tstore;
      el.classList.toggle('on', on);
      var svg=el.ownerSVGElement;
      if(svg) svg.querySelectorAll('text.n').forEach(function(n){
        if(n.dataset.branch===el.dataset.branch) n.classList.toggle('detached', on);
      });
    });
    setBar();
  }

  document.addEventListener('click',function(ev){
    var t=ev.target;
    var dis=t.closest?t.closest('.dis'):null;
    if(dis){ ev.preventDefault();
      var el=dis.closest('[data-fp]'), fp=el&&el.dataset.fp;
      if(!fp) return;
      if(fp in dstore) delete dstore[fp]; else dstore[fp]=1;
      ddirty=true; dwrite(); apply(); return; }
    var det=t.closest?t.closest('.tree .det'):null;
    if(det){ ev.preventDefault();
      var b=det.dataset.branch;
      if(b in tstore) delete tstore[b];
      else tstore[b]={from:det.dataset.arc,'with':peersOf(det).sort().slice(0,12),
                      at:Math.floor(Date.now()/1000)};
      tdirty=true; twrite(); apply(); return; }
    var fo=t.closest?t.closest('.fileas .fa-o'):null;
    if(fo){ ev.preventDefault(); ev.stopPropagation();   // do not toggle the disclosure
      var blk=fo.closest('.fileas'), opt=blk.__opts[+fo.dataset.i];
      if(opt){
        var k=blk.dataset.key;
        if((fstore[k]||{}).key===opt.key) delete fstore[k];
        else fstore[k]={key:opt.key,branch:opt.branch,residue:opt.residue_fp,
                        at:Math.floor(Date.now()/1000)};
        fdirty=true; fwrite(); apply();
      }
      return; }
    var sh=t.closest?t.closest('.ledger .showdis'):null;
    if(sh&&!sh.hidden){ var side=sh.closest('.side');
      if(side){ side.dataset.show=(side.dataset.show==='1')?'0':'1'; apply(); } }
  });

  // A row linked from the run-over-run strip is a collapsed <details>, so jumping to it
  // lands you on a summary line that says nothing you did not just read. Open it.
  function openTarget(){
    var el=location.hash&&document.querySelector(location.hash);
    if(!el) return;
    var d=el.tagName==='DETAILS'?el:el.closest('details');
    if(d){ d.open=true; d.scrollIntoView({block:'center'}); }
  }
  window.addEventListener('hashchange', openTarget);
  openTarget();

  if(saveDis) saveDis.addEventListener('click',function(){
    var out={}, now=Math.floor(Date.now()/1000);
    Object.keys(dstore).forEach(function(k){
      out[k]={ref:(present[k]||{}).ref||'', at:now, note:''}; });
    saveFile('dismissed.json', JSON.stringify(out,null,1), msg,
             function(){ ddirty=false; setBar(); });
  });
  if(saveDet) saveDet.addEventListener('click',function(){
    saveFile('detached.json', JSON.stringify(tstore,null,1), msg,
             function(){ tdirty=false; setBar(); });
  });
  if(saveFil) saveFil.addEventListener('click',function(){
    saveFile('authoritative-ticket.json', JSON.stringify(fstore,null,1), msg,
             function(){ fdirty=false; setBar(); });
  });
  apply();
})();
"""


EVIDENCE_ID = {"ledger": "lg-", "forgotten": "fg-", "gap": "gp-"}

# How many Jira-mismatch rows the table shows. The only truncation on the page, and it is
# named rather than inlined because the morning brief has to know where the list stops in
# order not to link into the part of it that was cut.
MISMATCH_ROWS = 14


def brief_block(data, here, fps):
    """The morning brief: one labelled line per fact, each linked to its own evidence.

    It was one paragraph and it was not being read. Five sentences, each carrying a claim, a
    number, a superlative and a subordinate clause, set in serif at 1.46rem and run together
    -- the facts were right and the form hid them. Nothing about which sentence was about
    what survived being skimmed, so the block that exists to be the shortlist read as the
    densest thing on the page.

    So: one row per fact, its kind named in the margin, its subject linked. arc-morning
    hands down the lines with their labels, because the label is that stage's own vocabulary
    -- this page has no business knowing that `contradiction` means Jira.

    Resolution order within a line is deliberate: a row on this page beats a link off it,
    because the whole claim of the brief is that the sections below are the evidence layer
    you expand into rather than a second place to go looking. An external URL is the fallback
    for the cases where nothing here holds the fact. A span whose target is not on this page
    renders as plain text, which is the rule the run-over-run strip and the cliff section
    already follow: an anchor to a row that was never rendered is the same lie as a link to
    a 404.
    """
    brief = data.get("brief") or {}

    def spans(parts):
        out = []
        for p in parts or []:
            if isinstance(p, str):
                out.append(esc(p))
                continue
            t, of, fp = esc(p.get("t", "")), p.get("of"), p.get("fp")
            if of and fp and fp in fps.get(of, ()):
                out.append(f'<a href="#{EVIDENCE_ID[of]}{esc(fp)}">{t}</a>')
            elif p.get("arc") in here:
                out.append(f'<a href="#{anchor(p["arc"])}">{t}</a>')
            elif p.get("url"):
                out.append(link(p["url"], t))
            else:
                out.append(t)
        return "".join(out)

    lines = brief.get("lines")
    if not lines:
        # A v1 payload, or an arc-morning too old to label its lines. The words are the part
        # that matters and they are all here; one unlabelled row is a better degradation
        # than an empty block.
        parts = brief.get("parts") or []
        if not parts:
            return ""
        lines = [{"lead": "", "parts": parts}]
    out = ['<ul class="brief">']
    for ln in lines:
        body = spans(ln.get("parts"))
        if not body:
            continue
        out.append('<li>'
                   + (f'<span class="bk">{esc(ln.get("lead") or "")}</span>'
                      if ln.get("lead") else '<span class="bk"></span>')
                   + f'<span class="bs">{body}</span></li>')
    out.append("</ul>")
    return "".join(out) if len(out) > 2 else ""


# What the copy button does, and the whole of why it is a button rather than a link to a
# file. The notes exist to be talked from, which is a thing you do with the page open --
# but the same person pastes them into a thread when he misses the call, and re-composing
# them in JavaScript from the rendered DOM would be a second author for a string arc-standup
# already built. So the exact text arc-standup composed rides along in a data attribute and
# the button hands that over untouched.
#
# `navigator.clipboard` is tried first and is not assumed: this page runs sandboxed, and
# where the permission is refused the fallback selects the text so the keyboard shortcut
# does what the button could not. Failing silently would be the worse outcome by far --
# a person finds out the copy did nothing when they paste into the thread.
STANDUP_JS = r"""
(function(){
  var btn=document.getElementById('sucopy');
  if(!btn) return;
  var text=btn.getAttribute('data-text')||'';
  function flash(msg){
    var was=btn.textContent;
    btn.textContent=msg; btn.dataset.done='1';
    setTimeout(function(){ btn.textContent=was; btn.dataset.done='0'; },1600);
  }
  function fallback(){
    var ta=document.createElement('textarea');
    ta.value=text; ta.setAttribute('readonly','');
    ta.style.position='fixed'; ta.style.top='-1000px';
    document.body.appendChild(ta); ta.select();
    var ok=false;
    try{ ok=document.execCommand('copy'); }catch(e){ ok=false; }
    document.body.removeChild(ta);
    flash(ok?'copied':'press ⌘/ctrl-C');
  }
  btn.addEventListener('click',function(){
    if(navigator.clipboard&&navigator.clipboard.writeText){
      navigator.clipboard.writeText(text).then(function(){ flash('copied'); },fallback);
    } else { fallback(); }
  });
})();
"""


def standup_block(data, here, fps):
    """The next standup's notes, as something to talk from rather than something to read.

    arc-standup did the assembling; this does the setting, and the two decisions worth
    naming are both about what is *not* here.

    There is no per-line evidence control -- no ✕, no park, no file-as. Every other block
    on this page is a thing to act on and carries the controls for acting on it. This one
    is a thing to say out loud in twenty minutes' time, and it is a projection: the rows it
    is made of already exist below, with their controls, and acknowledging a debt in the
    ledger correctly makes it vanish from here on the next build. Controls here would be a
    second place to dismiss one fact.

    And there is no state. The block never remembers that it was read, whether the standup
    happened, or what was said last time. It cannot: the window is derived from the clock,
    so the honest thing for it to show after the meeting is the next meeting's -- which is
    exactly what it does, the moment the clock passes 10:30.
    """
    st = data.get("standup") or {}
    beats = [b for b in st.get("beats") or [] if b.get("items")]
    if not st.get("since"):
        return ""

    def spans(parts):
        out = []
        for p in parts or []:
            if isinstance(p, str):
                out.append(esc(p))
                continue
            t, of, fp = esc(p.get("t", "")), p.get("of"), p.get("fp")
            if of and fp and fp in fps.get(of, ()):
                out.append(f'<a href="#{EVIDENCE_ID[of]}{esc(fp)}">{t}</a>')
            elif p.get("arc") in here:
                out.append(f'<a href="#{anchor(p["arc"])}">{t}</a>')
            elif p.get("url"):
                out.append(link(p["url"], t))
            else:
                out.append(t)
        return "".join(out)

    head, since = st.get("for") or {}, st.get("since") or {}
    when = " &middot; ".join(x for x in (
        f'for {esc(head.get("when"))}' if head.get("when") else "",
        f'since {esc(since.get("when"))}' if since.get("when") else "") if x)

    out = ['<section class="standup" id="standup">', '<div class="hd">',
           '<span class="tag">Next standup</span>',
           f'<span class="when">{when}</span>',
           f'<button class="cp" id="sucopy" type="button" '
           f'data-text="{esc(st.get("text") or "")}">copy</button>']
    out.append("</div>")
    # Outside the header rather than a wrapping item inside it. As a flex child it was
    # inheriting `.note`'s 54em max-width, which clamped its hypothetical size to something
    # that fit beside the title -- so a caveat about the clock read as a third field of the
    # heading. A sibling has no such argument to lose.
    if st.get("note"):
        out.append(f'<p class="sunote">{esc(st["note"])}</p>')

    if not beats:
        # Said, not omitted. A block that disappears on a quiet window is indistinguishable
        # from one that broke, and the difference matters most on the morning you are about
        # to stand up and talk.
        out.append('<p class="none">Nothing in this window — the last standup covered it.'
                   "</p></section>")
        return "".join(out)

    out.append('<ul class="beats">')
    for b in beats:
        rows = []
        for it in b["items"]:
            body = spans(it.get("parts"))
            if not body:
                continue
            subs = "".join(f"<li>{spans(sb.get('parts'))}</li>"
                           for sb in it.get("subs") or []
                           if spans(sb.get("parts")))
            rows.append(f"<li>{body}"
                        + (f'<ul class="sub">{subs}</ul>' if subs else "") + "</li>")
        if not rows:
            continue
        out.append(f'<li><span class="bk">{esc(b.get("lead") or b.get("kind") or "")}'
                   f'</span><ul class="items">{"".join(rows)}</ul></li>')
    out.append("</ul></section>")
    return "".join(out)


def derive_lede(data, focus_days):
    """Compose the opening sentence from the data itself.

    Superseded by arc-morning's brief and kept as the degradation for a pipeline that did
    not run it -- one derived sentence where there would have been several. Only ever one
    of the two renders: two opening paragraphs each claiming to be the most consequential
    fact is worse than either alone.

    A hand-written lede goes stale the moment anything moves, which turns a dashboard
    back into a report. This picks the single most consequential fact available and
    states it with its numbers, in a fixed order of severity, and never editorialises
    beyond what the counts support.

    The order starts with the work that has come back to him -- a branch that stopped
    merging, a question nobody answered, an approval nobody acted on. That is a change from
    opening on the biggest number, which described the page rather than the day: "112
    unpushed across 15 branches" is true every morning and asks for nothing.
    """
    gap = data.get("gap") or {}
    arcs = [a for a in data.get("arcs", []) if a.get("age_days", 999) <= focus_days]
    bits = []

    # Says what the tiles above it cannot. The tiles already carry every count, so opening
    # with "411 commits across 23 workstreams" made the first paragraph a second reading of
    # the row directly above -- and it quoted a different no-ticket number than the gap
    # section further down, because the two count different things. Prose earns its place
    # here only by stating the contradictions, which no tile can hold.
    mism = gap.get("status_mismatch") or []
    if mism:
        worst = max(mism, key=lambda m: m.get("arc", {}).get("unpushed_live", 0))
        k = worst.get("issue", {})
        n = worst.get("arc", {}).get("unpushed_live", 0)
        bits.append(
            f'Jira believes <em>{esc(k.get("key",""))}</em> is '
            f'&ldquo;{esc(k.get("status",""))}&rdquo;, but {n} of its commits have '
            f"never reached a remote"
            + (f", and {len(mism)-1} other tickets claim a status the code contradicts"
               if len(mism) > 1 else "") + ".")

    unt = gap.get("unticketed_work") or []
    if unt:
        hidden = sum(a.get("unpushed_live", 0) for a in unt)
        bits.append(
            f"{len(unt)} workstream{'s' if len(unt) != 1 else ''} of real work "
            f"{'have' if len(unt) != 1 else 'has'} no ticket at all"
            + (f", carrying {hidden} unpushed commits" if hidden else "")
            + " — invisible to Jira, and so absent from Trellis&rsquo;s capacity, "
              "burndown and every initiative rollup.")

    if bits:
        return " ".join(bits)
    # Only when Jira and the code agree, so the tiles are all there is to report.
    loc = [a for a in arcs if a.get("stage") == "local-only"]
    if loc:
        n = sum(a.get("unpushed_live", 0) for a in loc)
        return (f"Jira and the code agree on everything they both know about. What Jira "
                f"does not know about is <em>{n} commits</em> across {len(loc)} "
                f"workstreams that no remote has.")
    return "Nothing outstanding — every workstream is pushed, ticketed, and says what it is."


ROW, INDENT, PAD = 17, 15, 4


def spawn_forest(branches):
    """Turn the multi-parent ancestry into the one tree a reader can follow.

    `parents` holds every branch in the arc whose tip is an ancestor of this one, so a
    branch cut from a stack lists its whole stack. The immediate parent is the ancestor
    with the most commits of its own -- the deepest one -- and that single edge is what
    "spawned this" means. Branches sharing a sha are mutual ancestors and would form a
    cycle, so the second edge of any loop is dropped.

    Supersession is the second kind of edge and it has to be drawn. A branch holding a
    cherry-pick of another's commits has no ancestry to either, so ancestry alone drew the
    pair as two independent roots -- and two roots is a picture of two pieces of work. It
    read that way to a human and it read that way to the model writing the brief. Copies
    hang off what they copy, on a dashed edge, because "this is that again" is a different
    claim from "this was cut from that".

    Returns (rows, parent, kind) -- kind says which of the two an edge is.
    """
    by_name = {b["name"]: b for b in branches}
    parent, kind = {}, {}

    def acyclic():
        for name in list(parent):
            seen, cur = {name}, parent.get(name)
            while cur is not None:
                if cur in seen:
                    del parent[name]
                    kind.pop(name, None)
                    break
                seen.add(cur)
                cur = parent.get(cur)

    for b in branches:
        cands = [by_name[p] for p in (b.get("parents") or [])
                 if p in by_name and p != b["name"]]
        if cands:
            parent[b["name"]] = max(cands,
                                    key=lambda c: c.get("commits_ahead", 0))["name"]
            kind[b["name"]] = "cut"
    acyclic()

    # Copy edges after cycle-breaking, not instead of ancestry. Two branches on the same
    # sha are each other's ancestor, so one of the pair always loses its edge to the cycle
    # break -- and `UL-1692-on-1637-wip` then floated as a root despite being a known copy
    # of a branch three rows below it. A branch left without a parent still has somewhere
    # to hang if it is a copy of something.
    for b in branches:
        if b["name"] in parent:
            continue
        sup = b.get("superseded_by")
        if sup in by_name and sup != b["name"]:
            parent[b["name"]] = sup
            kind[b["name"]] = "copy"
    acyclic()

    kids = {}
    for child, par in parent.items():
        kids.setdefault(par, []).append(child)
    for v in kids.values():
        # Copies last: a stack is the structure, a duplicate is a footnote to it.
        v.sort(key=lambda n: (kind.get(n) == "copy", -by_name[n].get("unpushed", 0)))

    order = [b["name"] for b in branches]
    roots = [n for n in order if n not in parent]

    rows = []

    def walk(name, depth):
        rows.append((by_name[name], depth))
        for k in kids.get(name, []):
            walk(k, depth + 1)

    for r in roots:
        walk(r, 0)
    return rows, parent, kind


def spawn_svg(arc, limit=12, base="", detachable=False):
    """Draw the arc's stacking tree, or nothing when there is no structure to show.

    Build the forest over every branch and prune afterwards, never the other way round.
    Taking the top N first and then looking for parents severs any edge whose parent
    happens to carry fewer commits than the cut -- on the heaviest arc that discarded
    half the structure, which is how a tree renders as a flat list. Keeping each shown
    branch's ancestors means an edge is only ever hidden with the branch it belongs to.

    The authoritative branch is always kept, whatever the cut. It is the one row that has
    to be there: a tree of an arc's variants that omits the branch under review is worse
    than no tree.
    """
    branches = arc.get("branches", [])
    if len(branches) < 2:
        return ""
    rows, parent, kind = spawn_forest(branches)
    if not rows:
        return ""
    auth = arc.get("authoritative")

    if len(rows) > limit:
        keep = set()
        head = [b for b in branches if b["name"] == auth]
        for b in head + [x for x in branches[:limit] if x["name"] != auth]:
            cur, guard = b["name"], 0
            while cur is not None and cur not in keep and guard < 40:
                keep.add(cur)
                cur = parent.get(cur)
                guard += 1
        rows = [(b, d) for b, d in rows if b["name"] in keep]
        # A kept branch whose parent was pruned would draw an edge to nothing.
        parent = {c: p for c, p in parent.items() if c in keep and p in keep}
        # Re-level so a surviving subtree does not start indented under empty space.
        shallowest = min(d for _, d in rows)
        rows = [(b, d - shallowest) for b, d in rows]

    at = {b["name"]: i for i, (b, _) in enumerate(rows)}
    depth_of = {b["name"]: d for b, d in rows}

    def x_of(d):
        return PAD + d * INDENT

    def y_of(i):
        return PAD + i * ROW + ROW // 2

    def tail_len(b):
        if b["name"] == auth:
            return 11
        if b.get("historical"):
            return len(b["historical"]) + 12
        if b.get("superseded_by"):
            return len(b["superseded_by"]) + 6
        return len(str(b.get("unpushed") or "")) + 2

    widest = max((len(b["name"]) + tail_len(b) + 2) * 6.4 + x_of(d) for b, d in rows)
    height = PAD * 2 + len(rows) * ROW
    # Room on the right for the detach column, an aligned rail of ✕s rather than one
    # trailing each name -- a control that jumps around per row cannot be aimed at.
    w = int(widest) + (34 if detachable else 16)
    svg = [f'<svg width="{w}" height="{height}" '
           f'viewBox="0 0 {w} {height}" role="img" '
           f'aria-label="how this arc&rsquo;s branches relate: solid edges were cut from '
           f'the branch above, dashed edges are copies of it">']

    # Elbows first so the dots sit on top of them.
    for b, d in rows:
        par = parent.get(b["name"])
        if par is None or par not in at:
            continue
        px, py = x_of(depth_of[par]), y_of(at[par])
        cx, cy = x_of(d), y_of(at[b["name"]])
        copy = " copy" if kind.get(b["name"]) == "copy" else ""
        svg.append(f'<path class="edge{copy}" d="M{px} {py + 5} V{cy} H{cx - 3}"/>')

    for b, d in rows:
        cx, cy = x_of(d), y_of(at[b["name"]])
        dup = b.get("superseded_by")
        # Struck through, not removed. The whole reason to declare a ticket is that these
        # branches were being counted as outstanding work; the whole reason to keep drawing
        # them is that "you have eleven drafts here" is still true and still worth knowing.
        hist = b.get("historical")
        # A copy's unpushed commits are not risk -- they already exist on the branch it
        # copies -- so it is marked as the copy it is instead of flagged red.
        cls = (" hist" if hist else
               (" dup" if dup else (" auth" if b["name"] == auth
                                    else (" risk" if b.get("unpushed") else ""))))
        head = " head" if b.get("worktree") else ""
        svg.append(f'<circle class="dot{cls}{head}" cx="{cx}" cy="{cy}" r="3.2"/>')
        # The tail rides in the same <text> as a dx-offset tspan. Positioning it with
        # its own x means guessing the font's advance width, and the guess ran short
        # often enough to jam `+13` against the branch name.
        if hist:
            tail = f'<tspan class="c hist" dx="7">history · {esc(hist)}</tspan>'
        elif dup:
            tail = (f'<tspan class="c dup" dx="7">= {esc(dup)}</tspan>')
        elif b["name"] == auth:
            tail = '<tspan class="c" dx="7">← the work</tspan>'
        elif b.get("unpushed"):
            tail = f'<tspan class="c" dx="7">+{b["unpushed"]}</tspan>'
        else:
            tail = ""
        label = (f'<text class="n{cls}" data-branch="{esc(b["name"])}" '
                 f'x="{cx + 8}" y="{cy + 4}">'
                 f'{esc(b["name"])}{tail}</text>')
        if base and b.get("pushed"):
            label = (f'<a href="{esc(base)}/-/tree/{esc(urlq(b["name"]))}" '
                     f'target="_blank" rel="noopener">{label}</a>')
        svg.append(label)
        if detachable:
            svg.append(f'<text class="det" data-branch="{esc(b["name"])}" '
                       f'data-arc="{esc(arc.get("label", ""))}" '
                       f'x="{int(widest) + 8}" y="{cy + 4}">'
                       '<title>not this work — pry this branch out of the arc '
                       '(applies on the next build)</title>✕</text>')

    svg.append("</svg>")
    legend = []
    if any(kind.get(b["name"]) == "copy" for b, _ in rows):
        legend.append("dashed = the same commits again, not separate work")
    if any(b.get("historical") for b, _ in rows):
        legend.append("struck through = you filed this work elsewhere, so these are "
                      "drafts from before it")
    hidden = len(branches) - len(rows)
    if hidden > 0:
        legend.append(f"{hidden} more branch{'es' if hidden != 1 else ''} in this arc")
    if detachable:
        legend.append("✕ = not this work; a detached branch stands on its own name "
                      "from the next build")
    leg = f'<div class="legend">{" · ".join(esc(x) for x in legend)}</div>' if legend else ""
    return f'<div class="tree">{"".join(svg)}{leg}</div>'


def esc(x):
    return html.escape(str(x), quote=True)


def urlq(x):
    return urllib.parse.quote(str(x), safe="")


def anchor(arc_id):
    """A stable in-page id for a workstream row, so another section can link to it.

    Slug plus a hash of the identity rather than the slug alone: arc labels are unique
    within a run but their slugs are not -- `selected state` and `selected-state` are the
    same slug, and the split pass has been observed emitting both names for the same arc
    within one evening. Two rows sharing an id makes one of them unreachable.
    """
    slug = re.sub(r"[^a-z0-9]+", "-", str(arc_id).lower()).strip("-")[:40]
    h = hashlib.sha1(str(arc_id).encode()).hexdigest()[:6]
    return f"ws-{slug}-{h}" if slug else f"ws-{h}"


def link(url, text, cls=""):
    """A hyperlink where there is somewhere to go, and plain text where there is not.

    Half the value of this page is being one click from the thing each row asserts. The
    other half is not lying about it: a branch that was never pushed has no page on
    GitLab, and a link to a 404 is worse than a label.
    """
    c = f' class="{cls}"' if cls else ""
    if not url:
        return f"<span{c}>{text}</span>"
    return f'<a{c} href="{esc(url)}" target="_blank" rel="noopener">{text}</a>'


MRKDWN_HOLD = "\x00%d\x00"


def rich(text):
    """Slack&rsquo;s own markup, set as type rather than printed as punctuation.

    `_slack_text` hands the page plain text with Slack&rsquo;s markers still in it, and
    deliberately: the model that reads a thread should see the words, not this page&rsquo;s
    HTML. Here is where `*bold*`, `_italic_`, `~struck~`, `` `code` `` and fenced blocks
    become what they mean. Unrendered, a quote from a bot that decorates every line arrived
    as `:pencil: _Add reportError alert_ :heavy_check_mark: *slack-FDV0-1787162578*`, which
    is the single largest source of noise in a quote on this page.

    Escaped first and matched second, so a message containing `<b>` is text and a message
    containing `*b*` is bold. Code spans are lifted out before the emphasis passes and put
    back after, because a `*` inside a code span is a `*`.
    """
    out = esc(text or "")
    held = []

    def hold(body, cls):
        held.append(f'<code class="{cls}">{body}</code>')
        return MRKDWN_HOLD % (len(held) - 1)

    out = re.sub(r"```(.+?)```", lambda m: hold(m.group(1).strip("\n"), "blk"),
                 out, flags=re.S)
    out = re.sub(r"`([^`\n]+)`", lambda m: hold(m.group(1), "in"), out)
    # Delimiters only where Slack itself takes them: flanked by a non-word character, so
    # `snake_case_name` and `a*b*c` are left alone.
    out = re.sub(r"(?<![*\w])\*([^*\n]+)\*(?!\w)", r"<b>\1</b>", out)
    out = re.sub(r"(?<![_\w])_([^_\n]+)_(?!\w)", r"<i>\1</i>", out)
    out = re.sub(r"(?<![~\w])~([^~\n]+)~(?!\w)", r"<s>\1</s>", out)
    for i, h in enumerate(held):
        out = out.replace(MRKDWN_HOLD % i, h)
    return out


def face(who, avatar=""):
    """A person, at 18px: their Slack avatar where there is one, their initials otherwise.

    The avatar arrives as an inline data URI because this page is an artifact and its CSP
    refuses every external host -- work-arcs fetches the bytes and stores them, so there is
    nothing here to load. It is decoration and takes an empty alt: the name beside it is the
    label, and a screen reader saying it twice is worse than not drawing it at all.

    The initials chip is not a placeholder for a missing avatar so much as the same job done
    without one. Its hue is a hash of the name, which is stable across runs and across
    sections, so the same person is the same colour everywhere on the page.
    """
    if avatar.startswith("data:image/"):
        return f'<img class="av" src="{esc(avatar)}" alt="" width="18" height="18">'
    letters = "".join(w[0] for w in re.split(r"[\s._-]+", who or "") if w)[:2].upper()
    if not letters:
        return ""
    hue = int(hashlib.sha1((who or "").encode()).hexdigest()[:4], 16) % 360
    return (f'<span class="av av-i" aria-hidden="true" '
            f'style="--av:hsl({hue} 34% 42%)">{esc(letters)}</span>')


# Whose message a ledger row quotes. Every other row quotes the other person; these two
# quote Kyle -- a commitment is read out of his own promise, and "you asked X, no reply"
# quotes the question he asked. Attributing either to the counterpart would put words in
# their mouth, which is the one failure a quote cannot survive.
MINE = ("commitment", "slack-asked")


def ledger_say(e, who):
    """A ledger row&rsquo;s quote, attributed to whoever actually said it."""
    if not e.get("quote"):
        return ""
    if e.get("kind") in MINE:
        return say({"text": e["quote"], "who": "you", "at": e.get("asked", "")})
    return say({"text": e["quote"], "who": who, "at": e.get("asked", "")})


def say(q, url="", clip=0):
    """One quoted message, set as a message: whose voice it is, then what they said.

    Every quote on this page used to be an unattributed grey slab. The names were in the
    sentence above -- "3 threads awaiting your reply -- brian, vadym spoke last" -- and then
    three anonymous slabs underneath for the reader to match back up, which is work, and
    doing it four times on one card is most of why the page was going unread.

    Takes either a string or a `{who, text, at, avatar, url}` record, because not every
    quote on the page has an author to name: a stacked merge request quotes the files it
    conflicts in, and those are paths, not speech. A string renders exactly as it always did.
    """
    if isinstance(q, str):
        q = {"text": q}
    if not isinstance(q, dict):
        return ""
    text = q.get("text") or q.get("quote") or ""
    if not text:
        return ""
    if clip and len(text) > clip:
        text = text[:clip].rstrip() + "\u2026"
    who, at = (q.get("who") or "").strip(), (q.get("at") or "").strip()
    body = f'<span class="said">{rich(text)}</span>'
    if not who:
        return f"<blockquote>{body}</blockquote>"
    return ('<blockquote class="msg"><span class="voice">'
            + face(who, q.get("avatar") or "")
            + f'<b class="nm">@{esc(who)}</b>'
            + (f'<span class="at">{esc(at)}</span>' if at else "")
            + "</span>"
            + link(q.get("url") or url, body, "said-l") + "</blockquote>")


def fmt_day(epoch):
    """An epoch as a date a person reads, or a shrug when there is nothing to show."""
    if not epoch:
        return "no date recorded"
    try:
        return datetime.fromtimestamp(epoch).strftime("%-d %b")
    except (ValueError, OSError, OverflowError):
        return "no date recorded"


SPARK_W, SPARK_H = 96, 18


def cliff_spark(act, span):
    """One tick per active day, on a real time axis shared by the whole section, ending
    at today.

    The one thing on this page that draws a shape rather than states a fact, and it is here
    because the shape *is* the claim: a dense band on the left and nothing at all on the
    right is what "fell off a cliff" looks like, and it lands before a word has been read.

    Three decisions make it legible with no legend, which was the condition for drawing it
    at all.

    The axis is time and not index, so the silence occupies its true width and the work its
    true density. Pack the active days evenly instead and 18 days of work followed by 43 of
    nothing renders identically to 18 days of steady work -- the exact confusion this
    section exists to undo.

    That axis is the *section's*, not the row's, so the rows are comparable to each other.
    Scaled per row they are not, and the failure is specific: an 8-day cliff after two days
    of work and a 43-day cliff after eighteen draw the same picture, sitting immediately
    beside the column that says 8d and 43d. A chart that has to be corrected by the number
    next to it is worse than no chart.

    And the ticks are all one height. A height axis was drawn first and it lied: `units` is
    transcript entries plus commits, and on UB-6908 a single 514-entry session flattened
    sixteen genuine commit days to the minimum stroke, so the picture said "one spike then
    nothing" about seventeen days of work. There is no honest scale for a sum of two
    incommensurable things, and the log axis that would make it readable needs a sentence to
    explain it, which is a legend. What the picture is for is *when*; how much is in the
    sentence beside it, in words that can name both units.

    aria-hidden, deliberately: every fact in it is in that sentence already, and announcing
    it twice is worse for a screen reader than not drawing it at all.
    """
    series = act.get("series") or []
    if not series or span <= 0:
        return ""
    w, h, pad = SPARK_W, SPARK_H, 1.5
    bar = max(1.6, min(4.0, w / (span + 1)))
    out = [f'<svg class="spark" width="{w}" height="{h}" viewBox="0 0 {w} {h}" '
           'aria-hidden="true" focusable="false">']
    for ago, _ in series:
        # Clamped, not dropped: the domain is the section's longest history, so nothing can
        # fall outside it -- but a day older than the axis would be drawn off the left edge
        # rather than not at all, which is the one way this could silently lose evidence.
        x = max(0.0, (span - min(ago, span)) / span * (w - bar))
        out.append(f'<rect x="{x:.1f}" y="{pad}" width="{bar:.1f}" '
                   f'height="{h - pad * 2:.1f}" rx="0.6"/>')
    out.append(f'<line class="base" x1="0" y1="{h - pad:.1f}" x2="{w}" '
               f'y2="{h - pad:.1f}"/>')
    out.append(f'<line class="now" x1="{w - 0.6}" y1="0" x2="{w - 0.6}" y2="{h}"/>')
    out.append("</svg>")
    return "".join(out)


def heat(arc):
    """Colour only where something is actually broken.

    Two wrong versions preceded this. The first marked "waiting on review" hot, which is
    backwards -- getting work up for review is most of the hard part done and the clock is
    then a reviewer's. The second coloured by `urgency`, which painted every unpublished
    workstream amber and so asserted that a swathe of local-only work is a milder form of a
    stalled review. It is not a milder form of anything; it is a different problem, and the
    page does not get to rank them.

    So severity hue is reserved for the rung where something has demonstrably gone wrong --
    a branch that stopped merging, a question left hanging, a red pipeline. Every other rung
    is neutral, and its section heading already says what it is.

    Calm is the one exception, and it is not a severity: work that is out for review with a
    reviewer named on it is asking nothing of him. Whose move it is next is the only ranking
    this page can make honestly, and it is worth making -- see the row styling, where the
    same distinction is drawn.
    """
    if arc.get("stage") == "in-review":
        return "calm"
    if arc.get("stage") != "came-back":
        return "plain"
    return "hot" if arc.get("urgency", 99) <= 2 else "warm"


DEMAND_LABEL = {"conflict": "rebase", "threads": "unanswered", "pipeline": "pipeline",
                "approved": "merge it", "stacked": "stacked", "unpushed": "unpushed",
                "unrequested": "no reviewer", "unreviewed": "no MR", "draft": "draft"}
DEMAND_SEV = {"conflict": 0, "threads": 1, "pipeline": 2, "approved": 3, "stacked": 4,
              "unpushed": 5, "unrequested": 6, "unreviewed": 7, "draft": 8}


def toks(n):
    for div, suf in ((1e9, "B"), (1e6, "M"), (1e3, "k")):
        if n >= div:
            return f"{n / div:.1f}{suf}"
    return str(int(n))


def money(x):
    return f"${x:,.0f}" if x >= 10 else f"${x:.2f}"


def render_cost(a, cost):
    """What the pipeline that builds this page spent to build it.

    Kept small and kept last on purpose. This is the one section describing the tool
    rather than the work, and its whole value is that the figures are honest, so what it
    says about their provenance matters as much as the numbers: which calls were counted
    and which were not, what the money unit is when nothing is billed, and where a figure
    is observed rather than derived. Where the pipeline cannot yet measure its share of
    the quota it says exactly that, because a confidently wrong cost would discredit the
    ledger sitting above it.
    """
    week, today = cost["windows"]["week"], cost["windows"]["today"]
    wp, tp = week["pipeline"], today["pipeline"]
    runs, q = cost["runs"], cost["quota"]

    a("<section>")
    a("<h2>What this assistant costs</h2>")
    a('<p class="note">Every model call this pipeline makes — naming an arc, splitting '
      "one, reading a commitment out of Slack, judging whether a DM wants a reply — runs "
      "with its own working directory, so its transcript lands in a Claude Code project "
      "of its own and can be counted apart from your sessions. <strong>These are the "
      "pipeline&rsquo;s calls only</strong>; your own work in Claude is the comparison "
      "figure beside them, never mixed in. Each response is counted once, by its message "
      "id, because the transcript records every assistant turn twice. Tokens are weighted "
      f"at {esc(cost['prices_as_of'])} before being compared, since this pipeline is "
      "almost entirely cache traffic and an interactive session is not — read raw it "
      "would look nearly free. <strong>Nothing here is billed</strong>: the subscription "
      "reports a percentage and no dollars, so the money is a unit of account for "
      "comparing one token mix with another.</p>")

    def fig(n, label, sub=""):
        a(f'<div class="fig"><span class="n">{esc(n)}</span>'
          f'<span class="l">{esc(label)}</span>'
          + (f'<span class="s">{esc(sub)}</span>' if sub else "")
          + "</div>")

    a('<div class="cost">')
    wbasis = ("this week" if cost["week_basis"] == "quota-window" else "last 7 days")
    fig(money(wp["list_cost"]), f"the pipeline, {wbasis}",
        f"{wp['calls']:,} calls")
    if week["share_pct"] is not None:
        fig(f"{week['share_pct']:.0f}%", f"of your Claude spend, {wbasis}",
            f"you: {money(week['interactive']['list_cost'])}")
    fig(money(tp["list_cost"]), "the pipeline, today",
        f"{tp['calls']:,} calls")
    if today["share_pct"] is not None:
        fig(f"{today['share_pct']:.0f}%", "of your Claude spend, today",
            f"you: {money(today['interactive']['list_cost'])}")
    if runs["last"]:
        last = runs["last"]
        pts = ""
        if last["session_points"] is not None:
            pts = f"≈ {last['session_points']:.1f}% of a 5h window"
        elif last["week_points"] is not None:
            pts = f"≈ {last['week_points']:.2f}% of the week"
        fig(money(last["list_cost"]), "the last rebuild of this page",
            pts or (f"median {money(runs['median_list_cost'])} of "
                    f"{runs['measured']} run{'s' if runs['measured'] != 1 else ''}"))
    a("</div>")

    # The quota sentence, which is the thing actually asked for and the thing least
    # possible to compute: the subscription publishes a whole-number percentage and no
    # rate, so the rate has to be observed from snapshots taken around each run.
    bits = []
    if q["seven_day"]:
        bits.append(f"Your weekly quota stood at "
                    f"<strong>{q['seven_day']['utilization']:.0f}% used</strong> when "
                    f"this ran.")
    if q["pipeline_share_pct"] is not None:
        sd = q["rates"]["seven_day"]
        bits.append(f"Of that, this pipeline accounts for about "
                    f"<strong>{q['pipeline_share_pct']:.1f} points</strong> — observed "
                    f"rather than calculated, from how far the quota actually moved "
                    f"across {sd['pairs']} sampled intervals either side of a run.")
    elif q["unmeasured"]:
        bits.append("Its share of that quota is <strong>not measurable yet</strong>: "
                    + esc(q["unmeasured"]) + ". A percentage is all the subscription "
                    "publishes, so the tokens-per-point rate has to be watched rather "
                    "than worked out, and a guess here would be worth less than the "
                    "gap.")
    if runs["measured"] == 0:
        bits.append("The cost of a single rebuild is not shown yet either — a run is "
                    "bracketed by its own two snapshots rather than guessed at from "
                    "the gaps between calls, which on this corpus would put it anywhere "
                    "between $4 and $16 depending on the gap you picked.")
    if bits:
        a('<p class="costq">' + " ".join(bits) + "</p>")

    by_model = sorted(wp["by_model"].items(), key=lambda kv: -kv[1]["list_cost"])
    if by_model:
        a('<div class="scroll"><table><thead><tr><th>Model</th>'
          f"<th>Calls, {esc(wbasis)}</th>"
          "<th>In</th><th>Out</th><th>Cache written</th><th>Cache read</th>"
          "<th>Weighted</th></tr></thead><tbody>")
        for name, v in by_model:
            a(f'<tr><td class="k">{esc(name)}</td>'
              f'<td class="d">{v["calls"]:,}</td>'
              f'<td class="d">{esc(toks(v["input"]))}</td>'
              f'<td class="d">{esc(toks(v["output"]))}</td>'
              f'<td class="d">{esc(toks(v["cache_write"]))}</td>'
              f'<td class="d">{esc(toks(v["cache_read"]))}</td>'
              f'<td class="d">{esc(money(v["list_cost"]))}</td></tr>')
        a("</tbody></table></div>")
    if wp["unpriced"]:
        a(f'<p class="note">{wp["unpriced"]:,} call(s) ran on a model with no listed '
          "price. They are counted above and left out of the weighting rather than "
          "priced at a guess.</p>")
    a("</section>")


def render(data, lede, focus_days, limit, cost=None):
    out = []
    a = out.append
    base = data.get("project_url") or ""
    arcs = [x for x in data.get("arcs", []) if x.get("age_days", 999) <= focus_days]
    by_rung = {}
    for x in arcs:
        by_rung.setdefault(x.get("stage") or "local-only", []).append(x)

    # Time is the primary grouping now, because that is how the work is actually recalled --
    # "what am I in the middle of" rather than "what state is everything in". The rungs stay
    # as a per-row fact and as the aggregate at the top; they are no longer the spine.
    BUCKETS = [("today", "Today", lambda d: d <= 0),
               ("week", "Earlier this week", lambda d: 1 <= d <= 6),
               ("lastweek", "Last week", lambda d: 7 <= d <= 13),
               ("earlier", "Earlier", lambda d: d >= 14)]
    live = [x for x in arcs
            if x.get("stage") not in ("landed", "abandoned", "parked")]
    buckets = []
    for key, title, test in BUCKETS:
        got = [x for x in live if test(x.get("age_days", 999))]
        # Within a bucket: what still wants something from him, then the biggest unfinished
        # thing. Still no ordering between rungs -- the only split applied here is whether the
        # next move is his, and work that is genuinely out for review sinks below work that is
        # not. That is a fact about whose clock is running, not a claim that review matters
        # less; it is the same judgement that stopped "waiting on review" rendering hot.
        got.sort(key=lambda x: (x.get("stage") == "in-review",
                                -x.get("unpushed_live", 0), -x.get("engagement", 0)))
        if got:
            buckets.append((key, title, got))
    gap = data.get("gap") or {}

    # The Slack lens's boundary, composed once and printed on every card that carries a
    # block. It is one constant sentence plus whatever this particular run could not see, and
    # both halves belong next to the reader rather than in a page-level note they scrolled
    # past: "somebody decided this" is the strongest claim on the page, and the terms it was
    # gathered under have to travel with it.
    slk = data.get("slack_threads") or {}
    slack_note = ("Threads you took part in, read with your own token, on your own page. "
                  "Only threads readable in full appear here — this token holds no DM "
                  f"history, so {slk['denied']} thread(s) in the window were never opened."
                  if slk.get("denied") else
                  "Threads you took part in, read with your own token, on your own page.")
    if not slk.get("complete", True):
        # The ledger's three-state note, applied to the same problem. A lens that
        # half-answered and says nothing looks complete, and a decision missing from a
        # complete-looking section reads as a decision nobody made.
        slack_note += (" Slack answered only part of this run"
                       + (f" ({slk['why']})" if slk.get("why") else "")
                       + ", so a thread may be missing from it.")

    # The three lists whose rows the morning brief can point at, resolved here rather than
    # where each section renders. The brief is the first thing on the page and the rows are
    # the last, so it has to know what will exist before any of it is emitted -- and a
    # second selection written here would be a second author for "which rows are on the
    # page", which is how a link to a row that was truncated away gets written.
    #
    # The order comes down the wire, as it does in the section itself: work-arcs ranks the
    # forgotten arcs and a ranking written twice will differ in one of them.
    by_id = {x.get("id"): x for x in data.get("arcs", [])}
    order = data.get("forgotten")
    if order is None:
        order = [x.get("id") for x in data.get("arcs", [])]
    fell = [by_id[i] for i in order if i in by_id
            and ((by_id[i].get("activity") or {}).get("forgotten") or {}).get("verdict")]
    mism = (gap.get("status_mismatch") or [])[:MISMATCH_ROWS]
    ledger = data.get("ledger")
    evidence_fps = {
        "ledger": {e.get("fp") for e in ((ledger or {}).get("they_owe") or [])
                   + ((ledger or {}).get("you_owe") or []) if e.get("fp")},
        "forgotten": {(x["activity"]["forgotten"]).get("fp") for x in fell},
        "gap": {m.get("fp") for m in mism if m.get("fp")},
    }

    try:
        stamp = datetime.fromisoformat(data.get("generated", "")).strftime(
            "%a %-d %b %Y, %-I:%M %p")
    except (ValueError, TypeError):
        stamp = data.get("generated", "unknown")

    a("<title>Work Arcs</title>")
    a(f"<style>{CSS}</style>")
    a('<div class="page">')
    a("<h1>Work Arcs</h1>")
    a('<div class="stamp">')
    a(f"<span>{esc(stamp)}</span>")
    a(f"<span>{link(base, esc(data.get('repo','')))}</span>")
    total = data.get("arc_count", 0)
    a(f"<span>{len(arcs)} workstreams touched &le; {focus_days}d"
      + (f", of {total}" if total and total != len(arcs) else "") + "</span>")
    a(f"<span>{len(live)} in play, {len(arcs) - len(live)} settled or parked</span>")
    # The run-over-run diff renders as a section of its own further down, and is absent
    # when nothing moved. Absent is right for the section and wrong for the mechanism: a
    # comparison that has silently stopped comparing looks exactly like a quiet night. So
    # the stamp -- which is already where facts about the build live -- says which it was,
    # in the smallest type on the page.
    sincer = data.get("since_last_run") or {}
    if sincer.get("previous_generated"):
        n, ago = sincer.get("changed") or 0, fmt_interval(sincer.get("interval_seconds"))
        was = f" ({esc(ago)} ago)" if ago else ""
        a("<span>" + (f"nothing changed since the last build{was}" if not n
                      else f"{n} of {sincer.get('compared', 0)} workstreams changed "
                           f"since the last build{was}") + "</span>")
    elif sincer.get("why"):
        a(f'<span>no run-over-run diff — {esc(sincer["why"])}</span>')
    a("</div>")
    # The brief when there is one, the derived lede when there is not, and never both --
    # see brief_block and derive_lede. A hand-passed --lede still wins over either, because
    # it is the one opening paragraph a person typed on purpose.
    here = {x.get("id") for x in arcs}
    block = brief_block(data, here, evidence_fps)
    if lede:
        a(f'<p class="lede">{lede}</p>')
    elif block:
        a(block)
    else:
        a(f'<p class="lede">{derive_lede(data, focus_days)}</p>')

    # --- the next standup, one block wide -----------------------------------
    # Directly under the brief and above the sprint strip, which is an argument about what
    # the top of this page is for. The brief is what will bite him and is right to lead
    # every day. Under it, on the three mornings a week when it is not empty, is the only
    # other thing he opens the page at 10:15 to get. The sprint strip is a fortnight's
    # frame and is still there underneath, where a fortnight belongs.
    #
    # It is not gated on the day. A block that exists on Monday, Wednesday and Friday and
    # is absent on Tuesday is one whose absence you have to diagnose; the window is always
    # well-defined, so on an off day it simply shows what has piled up for the next one,
    # which is a useful thing to have seen before you get there.
    a(standup_block(data, here, evidence_fps))

    # --- the declared lens, one strip wide ---------------------------------
    # The only thing on this page that comes from a plan rather than from evidence. Every
    # other section answers "what has happened"; this answers "what was this fortnight
    # supposed to be", which is the question the page could not answer at all before.
    #
    # A lens and not the spine, and the placement is the argument: near the top so it is
    # read, above the sections and outside them so nothing is grouped by it. Time stays the
    # grouping -- see the comment on BUCKETS -- because that is how the work is actually
    # recalled, and a page re-spined around sprint membership would have had no home for
    # the two thirds of these arcs that no sprint claims.
    #
    # Absent entirely when work-arcs sent no sprint: no Jira, no Sprint field on the
    # instance, or no open sprint. Absent, never wrong -- a strip guessing at a sprint is
    # worse than a page that does not mention sprints. Present even when nothing joined,
    # though, because "17 tickets and not one of them has work behind it" is the loudest
    # thing this could ever say and it must not be silence.
    sprint = data.get("sprint") or None
    if sprint:
        shown = {x.get("id") for x in arcs}
        a('<div class="sprint" id="sprint">')
        a('<div class="hd"><span class="tag">This sprint</span>')
        left = sprint.get("days_left")
        when = [esc(sprint.get("name") or "")]
        if isinstance(left, int):
            # Past its end and not yet closed is a real state -- a sprint runs until
            # somebody clicks the button -- so it is said rather than shown as "-2 days".
            when.append("ends today" if left == 0 else
                        f"{left} day{'' if left == 1 else 's'} left" if left > 0 else
                        f"ended {esc(sprint.get('ends',''))}, still open")
        # Both board names, where two boards run the same fortnight. On the line it is one
        # sprint; the tooltip is where the fact that it is two lives.
        boards = sprint.get("boards") or []
        title = f' title="{esc(" · ".join(boards))}"' if len(boards) > 1 else ""
        a(f'<span class="when"{title}>{" &middot; ".join(when)}</span></div>')

        play, mem = len(sprint.get("in_play") or []), len(sprint.get("arcs") or [])
        done, open_ = sprint.get("done") or 0, sprint.get("tickets") or 0
        bits = [f'<a href="#play"><b>{play}</b> workstream'
                f'{"" if play == 1 else "s"} in play</a>']
        if mem > play:
            bits.append(f"<b>{mem - play}</b> landed or set aside")
        bits.append(f"<b>{open_}</b> ticket{'' if open_ == 1 else 's'} still open"
                    + (f", <b>{done}</b> done" if done else ""))
        a(f'<div class="ln">{" &middot; ".join(bits)}</div>')

        empty = sprint.get("tickets_without_work") or []
        if empty:
            a(f'<div class="ln"><b>{len(empty)}</b> sprint ticket'
              f'{"" if len(empty) == 1 else "s"} with no work behind '
              + ("it" if len(empty) == 1 else "them") + " &mdash; "
              + " ".join(link(i.get("url", ""), esc(i.get("key", "")), "k")
                         + f' <span class="d">{esc(i.get("status",""))}</span>'
                         for i in empty)
              + "</div>")

        idle = sprint.get("untouched") or []
        if idle:
            n, days = len(idle), sprint.get("idle_days") or 0
            # Named, and linked to their own rows where those rows exist. An arc quiet for
            # a working week is by construction the likeliest to have fallen out of the
            # focus window, and an anchor to a row that was never rendered is the same lie
            # as a link to a 404 -- so the ones with no row read as plain text, exactly as
            # the run-over-run strip handles the same case.
            named = []
            for u in idle:
                arc = by_id.get(u.get("id")) or {}
                nm = esc((arc.get("brief") or {}).get("name")
                         or u.get("label") or u.get("id") or "?")
                if u.get("id") in shown:
                    nm = f'<a href="#{anchor(u.get("id"))}">{nm}</a>'
                named.append(f'{nm} <span class="d">{esc(u.get("days"))}d</span>')
            a(f'<div class="ln idle"><b>{n}</b> untouched for {days}+ days &mdash; '
              + " &middot; ".join(named) + "</div>")
        a("</div>")

    for s in data.get("stale_overrides") or []:
        a(f'<p class="note">Ignoring your hand-set authoritative branch '
          f'<code>{esc(s.get("branch",""))}</code> for {esc(s.get("label",""))}: '
          f'{esc(s.get("why",""))}. Re-set it if it is still right.</p>')
    # A declaration that no longer holds says so, loudly, and in the direction that
    # matters: it was suppressing counts, and a suppression that has quietly lapsed is the
    # one thing worse than one that never existed.
    for s in data.get("stale_tickets") or []:
        a(f'<p class="note">No longer filing {esc(s.get("label",""))} as '
          f'<code>{esc(s.get("key",""))}</code>: {esc(s.get("why",""))}. Everything it '
          'set aside is counted again — re-file it if it is still right.</p>')

    # Which sprint arcs have gone quiet, by id, so a row can wear the fact without
    # re-deriving the threshold. work-arcs owns that judgement -- it is the one that knows
    # cliff_days, `stage` and `parked` -- and a page that recomputed "untouched" would
    # eventually disagree with the strip three inches above it.
    idle_ids = {u.get("id"): u.get("days")
                for u in ((data.get("sprint") or {}).get("untouched") or [])}

    def sprint_chip(arc):
        """The lens, on the row. Absent on every row no sprint claims.

        Inside the name cell rather than as its own column: see the CSS note. Quiet by
        default because two thirds of the rows in the window wear one and a chip that
        loud would become the page's spine by sheer repetition -- which is the one thing
        the sprint was not to become. It speaks up only where the strip is already
        accusing it, and then it carries the number, so the claim and its evidence are
        the same object rather than two that can drift.
        """
        s = arc.get("sprint")
        if not s:
            return ""
        days = idle_ids.get(arc.get("id"))
        if days is not None:
            return (f' <span class="sprintchip idle" title="in {esc(s.get("name",""))} '
                    f'and untouched for {esc(days)} days">sprint &middot; '
                    f'{esc(days)}d</span>')
        return (f' <span class="sprintchip" title="in the current sprint, '
                f'{esc(s.get("name",""))}">sprint</span>')

    def plural(n, word):
        return f"{n} {word}" + ("" if n == 1 else "s")

    def heading(arc, brief):
        """The ticket belongs in the title, linked — it is half the name of the work.

        It used to sit in the grey subhead below, which read as metadata about the card
        rather than as what the card is called. `UL-1692 · SMP Neighborhoods per-map
        selected state` is how the work is referred to in speech, in Slack and in the MR
        title, so it is how the card should be titled. Absence carries information too: a
        heading with no key is a workstream nobody has filed.
        """
        name = esc(brief.get("name") or arc.get("label", "?"))
        tkt = arc.get("ticket")
        if not tkt:
            return f'<h3 class="arc-name">{name}</h3>'
        i = next((x for x in arc.get("issues", []) if x.get("key") == tkt), {})
        return ('<h3 class="arc-name">'
                + link(i.get("url", ""), esc(tkt), "tkt")
                + f'<span class="sep">·</span>{name}</h3>')

    def subhead(arc, brief):
        """What is left once the ticket has moved into the title: the other tickets it
        touches, the branch that IS the work, and the state it has reached."""
        sub = []
        issues = {i.get("key"): i for i in arc.get("issues", [])}
        tkt = arc.get("ticket")
        rest = [k for k in issues if k != tkt][:3]
        if rest:
            sub.append('<span class="key-2nd">also '
                       + " ".join(link(issues[k].get("url", ""), esc(k)) for k in rest)
                       + "</span>")
        if not tkt:
            # Said plainly rather than left to be inferred from a missing key. This is the
            # invisible-work case the whole tool exists to surface, so it gets words.
            sub.append('<span class="noticket" title="no Jira ticket names this work, so '
                       'it is absent from Trellis, capacity and every rollup">'
                       "no ticket</span>")
        if arc.get("authoritative"):
            mr = next((m for m in arc.get("mrs", [])
                       if m.get("branch") == arc["authoritative"]), None)
            # A branch named after its ticket says nothing the key did not already say.
            # Printing both read `UL-1692 also UL-1633 UL-1692 · !10398`.
            bits = [] if arc["authoritative"] == tkt else [esc(arc["authoritative"])]
            if mr:
                bits.append(link(mr.get("url", ""), "!" + str(mr.get("iid"))))
            if bits:
                sub.append(f'<span class="auth" title="the branch that IS this work '
                           f'({esc(arc.get("authoritative_via",""))})">'
                           f'{" &middot; ".join(bits)}</span>')
        if arc.get("state"):
            sub.append(f'<span class="arc-state">{esc(arc["state"])}</span>')
        return f'<div class="arc-sub">{"".join(sub)}</div>' if sub else ""

    def rows(bucket, note_reviewers=False):
        """The compact form: one line per workstream, for rungs where a card would
        overstate. Never a truncation — every member of the rung is here."""
        a('<ul class="parked-list">')
        for arc in bucket:
            brief = arc.get("brief") or {}
            nm = esc(brief.get("name") or arc.get("label", "?"))
            mrs = arc.get("mrs") or []
            ref = " ".join(link(m.get("url", ""), "!" + str(m.get("iid")))
                           for m in mrs[:3])
            if not ref and arc.get("settled"):
                f = next((b.get("mr_fate") for b in arc.get("branches", [])
                          if b.get("mr_fate")), None) or {}
                ref = link(f.get("url", ""), "!" + str(f.get("iid", "?")))
            tkt = arc.get("ticket")
            i = next((x for x in arc.get("issues", []) if x.get("key") == tkt), {})
            a(f'<li id="{anchor(arc.get("id"))}"><span class="nm">'
              + (link(i.get("url", ""), esc(tkt), "key") + " " if tkt else "")
              + f'{nm}</span>'
              f'<span class="mr">{ref or "&mdash;"}</span>'
              f'<span class="ag">{arc.get("age_days","?")}d</span>')
            bits = []
            if arc.get("authoritative") and arc["authoritative"] != tkt:
                bits.append(esc(arc["authoritative"]))
            if note_reviewers:
                rev = sorted({r for m in mrs for r in (m.get("reviewers") or [])})
                if rev:
                    bits.append("with " + esc(", ".join(rev[:5])))
            if arc.get("state"):
                bits.append(esc(arc["state"]))
            if bits:
                a(f'<span class="sub">{" · ".join(bits)}</span>')
            a("</li>")
        a("</ul>")

    def workstream_row(arc):
        """One line, with everything else behind a disclosure."""
        brief = arc.get("brief") or {}
        c = arc.get("counts", {})
        tkt = arc.get("ticket")
        i = next((x for x in arc.get("issues", []) if x.get("key") == tkt), {})
        nm = esc(brief.get("name") or arc.get("label", "?"))
        age = arc.get("age_days", 0)
        when = "today" if age <= 0 else (f"{age}d ago")
        a(f'<details class="ws" id="{anchor(arc.get("id"))}" '
          f'data-key="{esc(arc.get("label",""))}" '
          f'data-fp="{esc(arc.get("fingerprint",""))}" '
          f'data-stage="{esc(arc.get("stage") or "")}" '
          f'data-parked="{1 if arc.get("parked") else 0}">')
        a("<summary>")
        a(link(i.get("url", ""), esc(tkt), "tkt") if tkt
          else '<span class="tkt none">no ticket</span>')
        # The branch, where there is no ticket to identify the row. Four arcs came out with
        # near-identical lat/lng-in-metadata names, two of them finished, and with no key and
        # no branch on the row there was nothing on screen to tell them apart.
        auth = arc.get("authoritative")
        # Everything else on this row is derived; this one thing was declared. It rides
        # here because the row's own state is downstream of it -- "in qualification" where
        # the derivation said "85 commits exist only here" -- and a reader who cannot see
        # the declaration is in force cannot audit the rung it produced.
        ta = arc.get("ticket_authority") or {}
        hn = arc.get("historical_branches") or 0
        # Emitted either way and hidden when it does not apply, for the same reason the
        # metrics below are: the page's own control has to be able to put it back.
        filed = ('<span class="sprintchip filed"'
                 + ("" if ta.get("key") else " hidden")
                 + ' title="this workstream is filed as the ticket named on it, so the '
                   'branches outside that ticket are history: still drawn, no longer '
                   'counted, and back the moment a commit lands on one">filed</span>')
        a(f'<span class="nm">{nm}'
          + (f' <span class="onbr">{esc(auth)}</span>' if auth and not tkt else "")
          + sprint_chip(arc) + (" " + filed if filed else "")
          + "</span>")
        a(f'<span class="st">{esc(arc.get("state",""))}</span>')
        a(f'<span class="ag">{esc(when)}</span>')
        a('<button class="park" type="button" '
          'aria-label="set this workstream aside as backlog">park</button>')
        a("</summary>")
        a('<div class="body">')
        if brief.get("summary"):
            a(f'<p class="arc-sum">{esc(brief["summary"])}</p>')
        tautology = {"local-only": "unpushed", "not-proposed": "unreviewed",
                     "no-reviewer": "unrequested"}.get(arc.get("stage"))
        shown_d = [d for d in arc.get("demands", []) if d["kind"] != tautology]
        if shown_d:
            a('<ul class="needs" data-disgroup>')
            for d in shown_d[:4]:
                sev = DEMAND_SEV.get(d["kind"], 6)
                lbl = DEMAND_LABEL.get(d["kind"], d["kind"])
                a(f'<li data-fp="{esc(d.get("fp",""))}" '
                  f'data-dismissed="{1 if d.get("dismissed") else 0}">'
                  f'<div class="row"><span class="chip sev-{sev}">{esc(lbl)}</span>'
                  f'<span class="what">{link(d.get("url",""), esc(d["what"]))}</span>'
                  '<button class="dis" type="button" aria-label="acknowledge — returns '
                  'on its own if anything changes" title="acknowledge — returns on its '
                  'own if anything changes">&#x2715;</button></div>')
                for q in (d.get("quotes") or ([d["quote"]] if d.get("quote") else []))[:3]:
                    a(say(q, d.get("url", "")))
                a("</li>")
            a("</ul>")
        elif brief.get("blocker"):
            a(f'<p class="blocker">{esc(brief["blocker"])}</p>')
        told = {d.get("url") for d in shown_d if d["kind"] == "stacked"}
        for m in (arc.get("mrs") or [])[:3]:
            a(f'<div class="arc-sub">{link(m.get("url",""), "!" + str(m.get("iid")))}'
              f'<span>{esc(m.get("title",""))[:90]}</span>')
            # Where an MR points, whenever that is not main. It is a fact about every stacked
            # MR and not only the approved one whose demand fires -- an MR aimed at a branch
            # rather than at main cannot land until that branch does, and the row said
            # nothing about it at all. Suppressed where the demand above already said it,
            # since that one carries the same facts and an instruction besides.
            st = m.get("stack")
            if st and m.get("url") not in told:
                bits = ["&rarr; " + esc(st.get("target", ""))]
                if st.get("blocked_by"):
                    bits.append("behind !" + str(st["blocked_by"]))
                if st.get("rebase_clean") is True:
                    bits.append("rebase onto main: clean")
                elif st.get("rebase_clean") is False:
                    n = len(st.get("conflicts") or [])
                    bits.append(f"rebase onto main: {n} conflict"
                                + ("" if n == 1 else "s"))
                a(f'<span class="stack">{" &middot; ".join(bits)}</span>')
            a("</div>")
        # What Slack decided about this work. Last of the prose on the card because it is the
        # only part of it a model wrote: everything above is derived, and a reader who has
        # learned to trust the top of the card should meet the inferred part knowing which
        # part it is. Absent entirely when nothing joined, which is most cards.
        slack = arc.get("slack") or []
        if slack:
            a('<div class="slk" data-disgroup><div class="slk-h">From Slack</div>')
            for s in slack:
                ch = f"#{s['channel']}" if s.get("channel") else "a conversation"
                a(f'<div class="slk-t" data-fp="{esc(s.get("fp",""))}" '
                  f'data-dismissed="{1 if s.get("dismissed") else 0}">')
                a('<div class="hd">'
                  + link(s.get("url", ""), esc(ch), "ch")
                  + f'<span>{esc(s.get("asked",""))}</span>'
                  # How the thread was attached to this workstream, always, because the join
                  # is the one step of this that could be wrong in a way the reader cannot
                  # see from the words. "matched on UL-1744" is checkable in a second.
                  + f'<span>matched on {esc(s.get("how","").split(" ")[-1])}</span>'
                  + f'<span>{s.get("messages", 0)} messages</span>'
                  + '<button class="dis" type="button" aria-label="acknowledge this '
                    'thread — it returns if anyone adds to it" title="acknowledge — '
                    'returns if anyone adds to the thread">&#x2715;</button>'
                  + "</div>")
                a('<ul class="slk-i">')
                # One message can settle one thing and leave another standing, and both are
                # worth saying -- but its quote is worth printing once. The second item on
                # the same message keeps its link, moved onto the sentence, and drops the
                # blockquote: principle 5 is "the source one click away", not "the source
                # transcribed twice".
                quoted = set()
                for cls, mark, items in (("dec", "&#x2713;", s.get("decided") or []),
                                         ("opn", "?", s.get("open") or [])):
                    for it in items:
                        q, u = it.get("quote", ""), it.get("url", "")
                        what = esc(it.get("what", ""))
                        a(f'<li class="{cls}"><span class="mk">{mark}</span>'
                          + (f'<span class="what">{link(u, what)}</span>' if q in quoted
                             else f'<span class="what">{what}</span>' + say(it))
                          + "</li>")
                        quoted.add(q)
                a("</ul></div>")
            a(f'<p class="slk-note">{slack_note}</p></div>')
        # What this work IS, which is the one judgement on the card that no derivation can
        # make -- see filing() in work-arcs, which precomputes every state this control can
        # reach so the page only ever records intent. Placed directly above the tree because
        # the tree is where the consequence shows: the branches an option sets aside are the
        # ones drawn struck through the moment it is chosen.
        fl = arc.get("filing")
        if fl:
            opts = fl.get("options") or []
            a('<div class="fileas" data-key="' + esc(arc.get("label", "")) + '"'
              + ' data-filed="' + esc(fl.get("filed") or "") + '"'
              + ' data-off="' + esc(json.dumps(fl.get("off") or {})) + '"'
              + ' data-opts="' + esc(json.dumps(opts)) + '">'
              + '<span class="fa-h">this work is</span>')
            for i, o in enumerate(opts):
                n = len(o.get("residue") or [])
                a('<button class="fa-o" type="button" data-i="' + str(i) + '" '
                  + 'title="file this workstream as ' + esc(o["key"]) + ' — '
                  + esc(o.get("via", "")) + '. The ' + str(n) + ' branch(es) outside it '
                  + 'become history: still drawn, no longer counted, and back the moment a '
                  + 'commit lands on one">' + esc(o["key"])
                  + '<span class="fa-to">' + esc(o.get("state") or "") + '</span></button>')
            # Said in the markup rather than written by the script, so the block still
            # explains itself where the frame has no storage to offer.
            a('<span class="fa-why">Filing says what this work IS. Branches outside that '
              "ticket become history &mdash; still drawn, no longer counted as risk "
              "&mdash; and come back on their own the moment a commit lands on one."
              "</span>")
            a("</div>")
        # Detachable only where the clustering decided membership: an arc keyed on a
        # ticket or a prefix got its members from their own names, and the only way to
        # detach a branch from its own name is to rename it.
        a(spawn_svg(arc, base=base, detachable=arc.get("kind") == "cluster"))
        a('<div class="metrics">')
        # These three are the metrics a filing moves, and they are emitted in both states --
        # hidden rather than absent -- because the control has to correct them in either
        # direction, and a number that exists in only one of the two states cannot be.
        lv = arc.get("unpushed_live", 0)
        shown = bool(lv) and arc.get("stage") != "local-only"
        a('<span class="m-live"' + ("" if shown else " hidden")
          + "><b>" + str(lv) + "</b> unpushed</span>")
        cp = arc.get("unpushed_only_on_copies") or 0
        # Under a filing the same number means something more specific, and calling it
        # "only on a superseded copy" would credit a person's decision to a derivation.
        a('<span class="m-copies"' + ("" if cp else " hidden") + ">"
          + (str(cp) + " not on " + esc(ta["key"]) if ta.get("key")
             else str(cp) + " only on a superseded copy") + "</span>")
        a('<span class="filed-m"' + ("" if ta.get("key") else " hidden") + ">"
          + ("filed as " + esc(ta["key"]) if ta.get("key") else "")
          + ((", " + str(hn) + " branch" + ("" if hn == 1 else "es") + " history")
             if ta.get("key") and hn else "")
          + "</span>")
        a(f"<span>{plural(c.get('branches',0),'branch').replace('branchs','branches')}</span>")
        # Says outright that part of this arc is finished. Both of the "isn't this already
        # done?" reports were arcs where some branches had merged and some had not, and
        # nothing on the row admitted the mixture.
        if arc.get("landed_branches"):
            a(f"<span>{arc['landed_branches']} already merged</span>")
        if arc.get("superseded"):
            a(f"<span>{arc['superseded']} superseded</span>")
        if c.get("sessions"):
            a(f"<span>{plural(c['sessions'],'session')}</span>")
        a(f"<span>{esc(arc.get('authoritative') or '')}</span>")
        a("</div></div></details>")

    # --- what came back and has not been looked at -------------------------
    # The only thing on this page that is news rather than a state. It leaves by being
    # worked on: every entry postdates the last commit or session on its own arc, so
    # touching the work removes it without anything being dismissed.
    news = [x for x in arcs if x.get("notify")]
    news.sort(key=lambda x: (x.get("urgency", 99), -x.get("engagement", 0)))
    a('<section data-disgroup>')
    a("<h2>Since you last touched them</h2>")
    a('<p class="note">Things that came back after your last commit or session on them. '
      "Working on one removes it, and so does acknowledging it — the ✕ expires by "
      "itself if anything changes again. Everything else on this page is a standing "
      "state, not news.</p>")
    if not news:
        a('<div class="quiet">Nothing has come back since you last worked on any of '
          "these. Every open merge request is either untouched or already answered.</div>")
    for arc in news:
        brief = arc.get("brief") or {}
        tkt = arc.get("ticket")
        i = next((x for x in arc.get("issues", []) if x.get("key") == tkt), {})
        a('<div class="news">')
        a("<h3>" + (link(i.get("url", ""), esc(tkt), "tkt") + " &middot; " if tkt else "")
          + esc(brief.get("name") or arc.get("label", "?")) + "</h3>")
        for d in arc["notify"][:3]:
            a(f'<div class="item" data-fp="{esc(d.get("fp",""))}" '
              f'data-dismissed="{1 if d.get("dismissed") else 0}">')
            a('<button class="dis" type="button" aria-label="acknowledge — returns on '
              'its own if anything changes" title="acknowledge — returns on its own if '
              'anything changes">&#x2715;</button>')
            a(f'<span class="when">'
              + (esc(fmt_day(d.get("at"))) + (" (from the merge request&rsquo;s own "
                 "last update, which is the closest timestamp there is)"
                 if d.get("at_is_proxy") else ""))
              + "</span>")
            a(f'<span>{link(d.get("url",""), esc(d["what"]))}</span>')
            for q in (d.get("quotes") or [])[:3]:
                a(say(q, d.get("url", "")))
            a("</div>")
        a("</div>")
    a("</section>")

    # --- what moved between the last build and this one ---------------------
    # A different clock from the section above it, and the two must not be merged. "Since
    # you last touched them" is measured against your own last commit or session; this is
    # measured against the previous build of this page. An arc can be in one and not the
    # other: something that came back a week ago and you have not looked at is news by the
    # first clock and old by the second, and something that broke overnight on work you
    # touched this morning is the reverse.
    #
    # Silent when nothing moved -- no heading, no empty-state, nothing. That silence is the
    # plan's rule for the background layer, not a rendering shortcut: the page earns the
    # right to say "3 of your 58 background workstreams changed" only by saying nothing at
    # all on the mornings when none did. The one concession is a chip in the stamp line at
    # the top, because a mechanism that has quietly stopped working looks identical to a
    # quiet night, and the stamp is already where facts about the build live.
    #
    # No ✕ on these lines, unlike every other list on the page. A dismissal is a
    # content-fingerprinted acknowledgement, and it is worth persisting because the fact it
    # acknowledges outlives it. A diff line describes one interval and is gone on the next
    # build whether or not anyone looked, so there is nothing for an acknowledgement to
    # expire against -- only rows in the store that could never be pruned.
    since = data.get("since_last_run") or {}
    diffs = since.get("changes") or []
    if diffs:
        shown = {x.get("id") for x in arcs}
        bg = sum(1 for c in diffs if c.get("id") not in shown)
        ago = fmt_interval(since.get("interval_seconds"))
        a("<section>")
        a("<h2>Since the last build</h2>")
        note = ["What moved on its own in the "
                + (f"{esc(ago)} " if ago else "") + "since this page was last built — "
                "a different clock from the section above, which is measured against "
                "<em>your</em> last commit. Nothing here needs acknowledging: each line "
                "describes one interval and is gone by the next build."]
        if bg:
            # The sentence the whole feature exists for. These are arcs the focus window
            # deliberately hides, and they are the ones most worth a line: nobody was
            # watching them, which is exactly why something moving there is news.
            outside = len(data.get("arcs", [])) - len(arcs)
            note.append(f"<strong>{bg} of the {outside} workstreams outside the last "
                        f"{focus_days} days moved</strong>, and "
                        + ("has" if bg == 1 else "have")
                        + " no row below — the age is marked on "
                        + ("it" if bg == 1 else "each") + ".")
        a(f'<p class="note">{" ".join(note)}</p>')
        a('<ul class="lb">')
        for c in diffs:
            here = c.get("id") in shown
            arc = by_id.get(c.get("id")) or {}
            nm = esc((arc.get("brief") or {}).get("name") or c.get("label") or "?")
            age = c.get("age_days")
            a(f'<li data-bg="{0 if here else 1}">')
            why = ("in the window below" if here
                   else "outside the window below, so it has no row there")
            a(f'<span class="ag" title="{why}">'
              + (f"{esc(age)}d" if isinstance(age, int) else "&mdash;") + "</span>")
            tkt = c.get("ticket")
            i = next((x for x in arc.get("issues", []) if x.get("key") == tkt), {})
            # The name links to its own row where there is one, and stays plain text where
            # the window hides it -- an anchor to a row that was never rendered is the
            # same lie as a link to a 404.
            named = (f'<a href="#{anchor(c.get("id"))}">{nm}</a>' if here else nm)
            a('<span class="nm">'
              + (link(i.get("url", ""), esc(tkt), "tkt") + " &middot; " if tkt else "")
              + named + "</span>")
            a('<span class="cls">')
            for e in c.get("evidence") or []:
                a(f'<span class="cl" data-k="{esc(e.get("kind",""))}">'
                  + link(e.get("url", ""), esc(e.get("what", ""))) + "</span>")
                for q in (e.get("quotes") or [])[:2]:
                    # Tighter than on a card. This strip is one line per workstream and the
                    # quote is corroboration for a sentence already read, not the thing
                    # itself -- at full length four of them make the section a transcript.
                    a(say(q, e.get("url", ""), clip=140))
            a("</span></li>")
        a("</ul></section>")

    # --- the waiting-on ledger ----------------------------------------------
    # Both directions of "who is waiting on whom", which is what todo.md was for and
    # never kept up with. Absent entirely when GitLab was not asked -- an empty ledger
    # and an unconsulted one are different claims.
    if ledger is not None:
        they = ledger.get("they_owe") or []
        you = ledger.get("you_owe") or []
        covered = ledger.get("you_owe_covered") or 0
        closed = ledger.get("you_owe_closed") or []
        a("<section>")
        a("<h2>The ledger</h2>")
        a('<p class="note">Open loops with a person on the other end, longest open '
          "first. Every row is derived — a review request&rsquo;s own timestamp, who "
          "spoke last in a thread or a DM, an approval, a ticket&rsquo;s assignee — so "
          "it closes itself the moment either of you moves, and nothing is ever "
          "checked off. A question on your own merge request appears here <em>and</em> "
          "on its workstream: same fact, once by person, once by work. The one "
          "exception to &ldquo;derived&rdquo; is a commitment read out of your own "
          "Slack messages — those rows say so, and every Slack row quotes the message "
          "it is a claim about, one click away. A commitment closes the same way "
          "everything else here does, on evidence: you delivered it later in the same "
          "thread, the merge request you named merged, the ticket you named reached "
          "Done. Where nothing shows that, the row says so and gives the date it "
          "expires under instead of pretending. <strong>&#x2715; acknowledges a "
          "row</strong>: it leaves the list but stays counted, and it comes back on "
          "its own the moment the fact under it changes — a new message, a "
          "re-request, a touched ticket. Nothing here can be deleted, only "
          "acknowledged."
          # Three states, not two. "Consulted and half-answered" used to render as though
          # nothing were wrong, and that is the worst of the three to be quiet about: the
          # section looks complete and is not, so a missing row reads as a closed loop.
          # Absence of a section over a wrong section -- and where the section still has to
          # stand, it says what is missing from it.
          + (" <strong>Slack was not consulted this run</strong> — these are GitLab "
             "and Jira only." if not ledger.get("slack")
             else "" if ledger.get("slack_complete", True)
             else " <strong>Slack answered only part of this run</strong> — some Slack "
             "rows are missing and there is no telling which, so nothing here was "
             "expired on a Slack row's absence.") + "</p>")
        a('<div class="ledger">')

        def clock(e):
            d = e.get("days")
            if d is None:
                return '<span class="clk"></span>'
            hot = " hot" if d >= 14 else ""
            return f'<span class="clk{hot}">{d}d</span>'

        def row(e, inner):
            """One ledger row, carrying its own fingerprint so acknowledging it is a
            claim about this fact and expires with it.

            The fingerprint is also the row's id, so the morning brief can point a
            sentence at the row it is a projection of. Same string in both places on
            purpose: an anchor derived separately from the fingerprint would survive a
            change to one and not the other.
            """
            fp = e.get("fp", "")
            btn = ('<button class="dis" type="button" aria-label="acknowledge this '
                   'row — it returns on its own if anything changes" title="acknowledge '
                   '— returns on its own if anything changes">&#x2715;</button>'
                   if fp else "")
            return (f'<li data-fp="{esc(fp)}"'
                    + (f' id="lg-{esc(fp)}"' if fp else "")
                    + f' data-dismissed="{1 if e.get("dismissed") else 0}">'
                    + clock(e) + f'<div class="what">{inner}</div>{btn}</li>')

        def visible(entries):
            return sum(1 for e in entries if not e.get("dismissed"))

        a('<div class="side">')
        a(f'<h3>You owe them <span class="n" data-count>{visible(you)}</span></h3>')
        if you:
            a("<ul>")
            for e in you:
                who = esc(e.get("who", "?"))
                since = f' since {esc(e["asked"])}' if e.get("asked") else ""
                sub = {"review-owed": f"{who} asked for your review{since}",
                       "reply-owed": f"{who} answered your comment{since} — your turn",
                       "thread-reply": f"{who} awaits your reply on your own merge "
                                       f"request{since}",
                       "slack-mention": f"{who} mentioned you{since} — nothing from "
                                        "you in that thread or channel after it",
                       "slack-dm": f"{who} has the last word in your DM{since}",
                       "commitment": "you said you&rsquo;d "
                                     + esc(e.get("promised") or "do this")
                                     + (f" — {who} is relying on it" if e.get("who")
                                        else "") + since
                                     + " (inferred from your message, quoted)",
                       }.get(e.get("kind"), who)
                # How this row will die, said out loud. Every other row on the ledger
                # closes when the other person moves; a commitment whose fulfilment
                # nothing can show has only the sliding window, and a row that vanishes
                # one morning unexplained teaches the same distrust as a stale one.
                if e.get("kind") == "commitment" and e.get("expires_in") is not None:
                    sub += ('<span class="fade"> — nothing yet shows it landed, so it '
                            f'expires with the {e.get("window_days", 14)}-day Slack '
                            f'window in {esc(e["expires_in"])}d</span>')
                a(row(e, link(e.get("url", ""), esc(e.get("ref", "")), "ref")
                      + f' {esc(e.get("title",""))}'
                      + f'<span class="who">{sub}</span>'
                      + ledger_say(e, who)))
            a("</ul>")
            a('<button class="showdis" type="button" hidden></button>')
        else:
            a('<div class="quiet">Nobody is waiting on a review or a reply from '
              "you.</div>")
        if covered:
            a(f'<p class="covered">{covered} more review request'
              f'{"" if covered == 1 else "s"} already handled — you spoke, or someone '
              "approved before you got there.</p>")
        # Closed on evidence, with the evidence. Not a dismissal and not a checkbox: the
        # tool worked out that the promise was kept, so the row is gone rather than
        # acknowledged. It is still shown, because a reminder that disappears silently is
        # indistinguishable from a reminder the tool lost.
        if closed:
            a('<div class="covered">')
            a(f'{len(closed)} commitment{"" if len(closed) == 1 else "s"} closed on '
              "evidence rather than by the clock — the promise was kept, so the row is "
              "gone, and here is what showed it:")
            a('<ul class="cev">')
            for e in closed:
                a("<li>you said you&rsquo;d "
                  + esc(e.get("promised") or "do this") + " &mdash; "
                  + link(e.get("closed_url") or e.get("url", ""),
                         esc(e.get("closed_by", "")))
                  + "</li>")
            a("</ul></div>")
        a("</div>")

        a('<div class="side">')
        a(f'<h3>They owe you <span class="n" data-count>{visible(they)}</span></h3>')
        if they:
            a("<ul>")
            for e in they:
                who = e.get("who")
                who = ", ".join(who) if isinstance(who, list) else (who or "?")
                kind = e.get("kind")
                if kind == "review-silence":
                    sub = esc(f"no response from {who} since {e.get('asked','?')}")
                    if e.get("asked_is_proxy"):
                        sub += (" (clock from the merge request&rsquo;s last update "
                                "&mdash; no request note exists)")
                elif kind == "slack-asked":
                    sub = esc(f"you asked {who} on {e.get('asked','?')} — no reply")
                else:
                    sub = esc(f"with {who}"
                              + (f" · {e['status']}" if e.get("status") else "")
                              + f", untouched since {e.get('asked','?')}")
                a(row(e, link(e.get("url", ""), esc(e.get("ref", "")), "ref")
                      + f' {esc(e.get("title",""))}'
                      + f'<span class="who">{sub}</span>'
                      + ledger_say(e, who)))
            a("</ul>")
            a('<button class="showdis" type="button" hidden></button>')
        else:
            a('<div class="quiet">Nobody owes you anything — no silent reviews, '
              "no stalled hand-offs.</div>")
        a("</div>")

        a("</div></section>")

    # --- the conditions, as peers ------------------------------------------
    # Still peers, still no hero figure and no severity hue: there is no honest exchange
    # rate between a stalled review and a swathe of unpublished work. These are now an
    # aggregate rather than the page's spine, since time became the grouping.
    loc = by_rung.get("local-only", [])
    back = by_rung.get("came-back", [])
    rev = by_rung.get("in-review", [])
    noask = by_rung.get("no-reviewer", [])
    prop = by_rung.get("not-proposed", [])
    parked = by_rung.get("parked", [])
    done = by_rung.get("landed", []) + by_rung.get("abandoned", [])
    tiles = [
        (len(loc), "exist only on this laptop",
         f"{sum(x.get('unpushed_live',0) for x in loc)} commits, no remote has them"),
        (len(back), "have come back to you",
         "a rebase, a question, a red pipeline, an unmerged approval"),
        (len(prop), "are pushed but never proposed", "no merge request exists"),
        (len(noask), "have a merge request nobody was asked to read",
         "open, no reviewer, no comment — it is not moving"),
        (len(rev), "are out for review",
         "nothing outstanding, somebody has it — a reviewer&rsquo;s clock"),
        (len(parked), "are parked", "set aside on purpose, not forgotten"),
        (len(done), "have landed or been abandoned", "retired from the list below"),
    ]
    a('<ul class="conditions">')
    for n, label, sub in tiles:
        if not n:
            continue
        a(f'<li><a href="#play"><span class="v">{n}</span>'
          f'<span class="l">{label}</span><span class="sub">{sub}</span></a></li>')
    a("</ul>")

    # --- in play, by when you last touched it ------------------------------
    a("<section>")
    a('<div class="rung"><h2 id="play">In play</h2>'
      f'<span class="n">{len(live)} workstreams</span></div>')
    a('<p class="note">Grouped by when you last touched each one, and within a group by '
      "how much unfinished work it holds. Each row says which rung it has reached — only "
      "here, pushed, proposed, nobody asked, in review — but no rung is ranked against "
      "another: unpublished work is a first-class problem, not a milder stalled review. "
      "The one split the page does make is whether the next move is yours: a row in "
      "<span style=\"color:var(--calm)\">green</span> is out for review with someone "
      "named on it and wants nothing from you, so it sits at the foot of its group. "
      "Open a row for what it is, what it needs, and how its branches relate. "
      "<strong>Park</strong> sets one aside as backlog; it comes back on its own as soon "
      "as a commit lands on it.</p>")
    for key, title, got in buckets:
        a(f'<div class="rung" data-bucket="{key}">'
          f'<h2 id="{key}" style="font-size:1rem">{title}</h2>'
          f'<span class="n" data-count="{key}">{len(got)}</span></div>')
        a(f'<div class="wslist" data-list="{key}">')
        for arc in got:
            workstream_row(arc)
        a("</div>")
    a("</section>")

    # --- work that fell off a cliff -----------------------------------------
    # Not a filter over the page and not a rung: a lens. Every arc here also renders
    # wherever it already rendered, because de-emphasis is not hiding and this section is
    # making a claim about arcs rather than replacing their rows. Most of them have no row
    # at all -- an arc that went quiet five weeks ago is by construction outside the focus
    # window, which is precisely why nobody was going to notice it.
    #
    # Absent when empty, like the run-over-run strip and for the same reason: a section
    # that says "0 forgotten" every morning trains you to stop reading it, and then the
    # morning it says 1 you will not see that either.
    #
    # The order comes down the wire rather than being re-derived here. work-arcs already
    # ranks these -- freshest cliff first, because the one you can still resume is the one
    # you fell off most recently -- and a ranking written twice is a ranking that will
    # differ in one of them. Falls back to the verdicts on the arcs themselves so an older
    # graph still renders, in whatever order it arrived. Resolved at the top of render(),
    # because the morning brief points at these rows and is emitted before them.
    if fell:
        here = {x.get("id") for x in arcs}
        # One axis for every row: the longest history in the section, so the pictures can
        # be read against each other rather than only against themselves.
        cliff_span = max((d for x in fell for d, _ in x["activity"]["series"]), default=0)
        a("<section>")
        a('<div class="rung"><h2 id="cliff">Fell off a cliff</h2>'
          f'<span class="n" data-count="cliff">{len(fell)}</span></div>')
        a('<p class="note">Not the old work — <em>the dropped</em> work. Each of these '
          "took real investment and then stopped dead, and nothing closed it: no merge, "
          "no abandonment, no park, and nobody else holding it. The distinction is the "
          "derivative rather than the level, so an arc worked lightly but steadily is "
          "absent while one hammered for three days and dropped cold is here, and the "
          "silence is measured against each arc&rsquo;s own rhythm rather than against "
          "the calendar. Nothing is hidden from anywhere else by appearing here. "
          "<strong>&#x2715; acknowledges a row</strong> — it is keyed to the day the arc "
          "went quiet, so a single commit on it brings the row back by itself.</p>")
        a('<ul class="parked-list cliff" data-disgroup data-countfor="[data-count=cliff]">')
        for x in fell:
            act, f = x["activity"], x["activity"]["forgotten"]
            brief = x.get("brief") or {}
            nm = esc(brief.get("name") or x.get("label", "?"))
            # Linked only where the row exists. An anchor to a workstream the focus window
            # never rendered is the same lie as a link to a 404 -- the run-over-run strip
            # settled this already, and most rows here are outside the window.
            named = (f'<a href="#{anchor(x.get("id"))}">{nm}</a>'
                     if x.get("id") in here else nm)
            tkt = x.get("ticket")
            i = next((y for y in x.get("issues", []) if y.get("key") == tkt), {})
            a(f'<li data-fp="{esc(f.get("fp",""))}"'
              + (f' id="fg-{esc(f["fp"])}"' if f.get("fp") else "")
              + f' data-dismissed="{1 if f.get("dismissed") else 0}">')
            # `UB-6918 UB-6918` on an arc the split pass never renamed: where the label is
            # the key, printing both says the key twice and the name not at all.
            key = (link(i.get("url", ""), esc(tkt), "key") + " "
                   if tkt and nm != esc(tkt) else "")
            a(f'<span class="nm">{key}{named}</span>')
            a(cliff_spark(act, cliff_span))
            a(f'<span class="ag" title="last active {esc(act.get("last_active") or "?")}">'
              f'{act.get("cliff_days","?")}d</span>')
            a('<button class="dis" type="button" aria-label="acknowledge — returns on its '
              'own as soon as anything lands on this workstream" title="acknowledge — '
              'returns on its own as soon as anything lands on this workstream">'
              "&#x2715;</button>")
            a(f'<span class="why">{esc(f.get("why",""))}</span>')
            a("</li>")
        a("</ul></section>")

    # Always emitted, even empty: parking happens in the page, so the client needs somewhere
    # to move a row to without inventing structure.
    a(f'<section id="parkedsec"{"" if parked else " hidden"}>')
    a('<div class="rung"><h2 id="parked">Parked</h2>'
      f'<span class="n" data-count="parked">{len(parked)}</span></div>')
    a('<p class="note">Set aside on purpose. Still counted, still here — the difference '
      "between parked and forgotten is the whole point of saying so. Each returns to "
      "<em>In play</em> by itself as soon as a commit lands on it, because the park is "
      "keyed to the branch tips rather than to the name.</p>")
    a('<div class="wslist" id="parkedlist">')
    for arc in parked:
        workstream_row(arc)
    a("</div></section>")

    for s in data.get("stale_parks") or []:
        a(f'<p class="note">{esc(s.get("label",""))} is no longer parked: '
          f'{esc(s.get("why",""))}.</p>')

    for s in data.get("stale_detached") or []:
        a(f'<p class="note">{esc(s.get("branch",""))} is no longer detached: '
          f'{esc(s.get("why",""))} — the derivation has been allowed to speak.</p>')

    if done:
        a("<section>")
        a(f'<div class="rung"><h2 id="settled">Landed or abandoned</h2>'
          f'<span class="n">{len(done)}</span></div>')
        a('<p class="note">Finished, and shown once so it is clear they were retired '
          "rather than lost. These stayed on the page for as long as this tool existed: "
          "every merge request here squash-merges, and a squash leaves the branch "
          "unmerged by ancestry, which was the only test <code>git</code> was being "
          "asked.</p>")
        rows(done)
        a("</section>")

    # --- where Jira disagrees with the code --------------------------------
    if gap:
        # `mism` is the truncated list, resolved at the top of render(): the brief links
        # into this table and must not point at a row the truncation removed.
        if mism:
            a("<section>")
            a("<h2>Jira says otherwise</h2>")
            a('<p class="note">Tickets whose status asserts the work left your hands, '
              "while the commits are still on this laptop.</p>")
            a('<div class="scroll" data-disgroup><table><thead><tr>'
              "<th>Ticket</th><th>Claim</th><th>Reality</th><th>Summary</th><th></th>"
              "</tr></thead><tbody>")
            for m in mism:
                i = m.get("issue", {})
                a(f'<tr data-fp="{esc(m.get("fp",""))}"'
                  + (f' id="gp-{esc(m["fp"])}"' if m.get("fp") else "")
                  + f' data-dismissed="{1 if m.get("dismissed") else 0}"><td class="k">'
                  + link(i.get("url", ""), esc(i.get("key", "")))
                  + f'</td><td class="d">{esc(i.get("status",""))}</td>'
                  f'<td class="n">{esc(m.get("why","").split(" but ")[-1])}</td>'
                  f'<td class="d">{esc(i.get("summary",""))}</td>'
                  '<td><button class="dis" type="button" aria-label="acknowledge — '
                  'returns on its own if the status or the count moves" '
                  'title="acknowledge — returns on its own if the status or the count '
                  'moves">&#x2715;</button></td></tr>')
            a("</tbody></table></div></section>")

        unt = gap.get("unticketed_work") or []
        if unt:
            a("<section>")
            a("<h2>Real work with no ticket</h2>")
            a('<p class="note">Invisible to Jira, and therefore to Trellis — absent '
              "from capacity, burndown and every initiative rollup. Each has a one-step "
              "command to file it.</p>")
            a('<div class="scroll"><table><thead><tr>'
              "<th>What it is</th><th>Branches</th><th>Sessions</th><th>Unpushed</th>"
              "<th>File it</th></tr></thead><tbody>")
            for x in unt[:12]:
                cc = x.get("counts", {})
                nm = (x.get("brief") or {}).get("name") or x.get("label", "?")
                a(f'<tr><td class="d">{esc(nm)}</td>'
                  f'<td class="d">{cc.get("branches",0)}</td>'
                  f'<td class="d">{cc.get("sessions",0)}</td>'
                  f'<td class="n">{x.get("unpushed_live",0) or ""}</td>'
                  # Quoted: since arc-brief started deriving labels they are phrases, so
                  # the command as printed was `--jira-ify SMP Neighborhoods ODX journeys`
                  # and the shell would hand --jira-ify only the first word.
                  f"<td><code>work-arcs --jira-ify "
                  f"'{esc(x.get('label','?'))}'</code></td>"
                  "</tr>")
            a("</tbody></table></div></section>")

        empty = gap.get("tickets_without_work") or []
        if empty:
            a("<section>")
            a("<h2>Tickets with nothing behind them</h2>")
            a('<p class="note">Assigned and open, with no branch or session against '
              "them. Either they have not started, or they are done and nobody closed "
              "them.</p>")
            a('<div class="scroll"><table><thead><tr>'
              "<th>Ticket</th><th>Status</th><th>Summary</th><th>Initiative</th>"
              "</tr></thead><tbody>")
            for i in empty[:14]:
                init = ", ".join(i.get("initiatives") or []) or "—"
                a('<tr><td class="k">'
                  + link(i.get("url", ""), esc(i.get("key", "")))
                  + f'</td><td class="d">{esc(i.get("status",""))}</td>'
                  f'<td class="d">{esc(i.get("summary",""))}</td>'
                  f'<td class="d">{esc(init)}</td></tr>')
            a("</tbody></table></div></section>")

    # --- what this assistant costs -------------------------------------------
    # Absent unless `arcs` wrote a cost sidecar for this run. A stale figure here would
    # be indistinguishable from a current one, and unlike a stale arc it would never
    # correct itself on the next commit.
    if cost:
        render_cost(a, cost)

    a('<div id="parkbar"><span id="parkmsg"></span>'
      '<button type="button" id="parksave">Save for the command line</button>'
      '<span class="muted">Parking already applies here and survives reloads. Saving '
      'writes <code>parked.json</code> for <code>work-arcs</code>, so its own counts '
      'agree with this page.</span></div>')
    # The filings work-arcs itself read, so the store this page keeps is whole rather
    # than only what happens to be inside the focus window — see the note on FKEY.
    a('<script type="application/json" id="filedseed">'
      + json.dumps(data.get("filings") or {}) + "</script>")
    a('<div id="interactbar"><span id="intmsg"></span>'
      '<button type="button" id="savedis" hidden>Save acknowledgements</button>'
      '<button type="button" id="savedet" hidden>Save detachments</button>'
      '<button type="button" id="savefil" hidden>Save filings</button>'
      '<span class="muted">All three apply here and survive reloads. Saving writes '
      '<code>dismissed.json</code> / <code>detached.json</code> / '
      '<code>authoritative-ticket.json</code> into '
      '<code>~/.local/state/work-arcs/</code> — acknowledgements keep the CLI in '
      'agreement, while a detachment or a filing takes full effect when '
      '<code>work-arcs</code> next builds the page.</span></div>')
    a(f"<script>{PARK_JS}</script>")
    a(f"<script>{INTERACT_JS}</script>")
    a(f"<script>{STANDUP_JS}</script>")

    a("<footer>Derived, never declared — arcs come from the files your work "
      "touched, not from what branches were named, and which branch is the work comes "
      "from which one an open merge request points at. Nothing here is written to Jira, "
      "Slack or a repo unless you run the command yourself. Where a branch is called a "
      "superseded copy, its commits were checked against the other branch by "
      "<code>git patch-id</code>, not guessed at from its name.</footer>")
    a("</div>")
    return "\n".join(out)


def main():
    p = argparse.ArgumentParser(description="Render work-arcs --json as a page.")
    p.add_argument("--lede", default="",
                   help="override the derived opening sentence (normally unnecessary — "
                        "it is composed from the data so it cannot go stale)")
    p.add_argument("--focus", type=int, default=14, help="arcs idle at most this long")
    p.add_argument("--limit", type=int, default=0,
                   help="cap the cards shown (0 = every active arc)")
    p.add_argument("--out", type=Path)
    p.add_argument("--cost", type=Path, default=None,
                   help="`arcs-cost --json` for this run; `arcs` writes it fresh each "
                        "time and passes it. Without it the cost section is absent "
                        "rather than stale — an old figure would read as a current one")
    args = p.parse_args()
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError as e:
        sys.exit(f"arcs-page: stdin is not `work-arcs --json`: {e}")
    if not isinstance(data, dict):
        sys.exit(f"arcs-page: stdin parsed as {type(data).__name__}, not the object "
                 "`work-arcs --json` emits — there is no graph here to render")
    cost = None
    if args.cost:
        # Loud, because a silently dropped section is how a measurement stops being
        # taken without anyone noticing -- but not fatal, because the page is the point.
        try:
            cost = json.loads(args.cost.read_text())
        except (OSError, json.JSONDecodeError) as e:
            print(f"arcs-page: no cost section — {args.cost} unreadable ({e})",
                  file=sys.stderr)
    page = render(data, args.lede, args.focus, args.limit, cost)
    if args.out:
        args.out.write_text(page)
        print(f"✓ {args.out} ({len(page)} bytes)", file=sys.stderr)
    else:
        print(page)


if __name__ == "__main__":
    main()
