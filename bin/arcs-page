td.n{font-family:var(--mono);font-variant-numeric:tabular-nums;text-align:right;
     white-space:nowrap;color:var(--hot)}
td.d{color:var(--ink-soft)}
code{font-family:var(--mono);font-size:.75rem;background:var(--surface-2);
     border:1px solid var(--hairline);padding:.1rem .3rem;border-radius:2px}
footer{margin-top:3rem;padding-top:1.4rem;border-top:1px solid var(--hairline);
       color:var(--ink-soft);font-size:.85rem}
a{color:var(--accent)}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
"""


def derive_lede(data, focus_days):
    """Compose the opening sentence from the data itself.

    A hand-written lede goes stale the moment anything moves, which turns a dashboard
    back into a report. This picks the single most consequential fact available and
    states it with its numbers, in a fixed order of severity: work other people are
    waiting on, then work that exists nowhere but this laptop, then the arc carrying
    the most unlanded risk. It never editorialises beyond what the counts support.
    """
    gap = data.get("gap") or {}
    arcs = [a for a in data.get("arcs", []) if a.get("age_days", 999) <= focus_days]
    bits = []

    mism = gap.get("status_mismatch") or []
    if mism:
        worst = max(mism, key=lambda m: m.get("arc", {}).get("unpushed", 0))
        k = worst.get("issue", {})
        n = worst.get("arc", {}).get("unpushed", 0)
        bits.append(
            f'Jira believes <em>{esc(k.get("key",""))}</em> is '
            f'&ldquo;{esc(k.get("status",""))}&rdquo;, but {n} of its commits have '
            f"never reached a remote"
            + (f", and {len(mism)-1} other tickets claim a status the code contradicts"
               if len(mism) > 1 else "") + ".")

    unt = gap.get("unticketed_work") or []
    if unt:
        hidden = sum(a.get("unpushed", 0) for a in unt)
        bits.append(
            f"{len(unt)} arc{'s' if len(unt) != 1 else ''} of real work "
            f"{'have' if len(unt) != 1 else 'has'} no ticket at all"
            + (f", carrying {hidden} unpushed commits" if hidden else "")
            + " — invisible to Jira, and so absent from Trellis&rsquo;s capacity, "
              "burndown and every initiative rollup.")

    if arcs:
        top = max(arcs, key=lambda a: a.get("unpushed", 0))
        if top.get("unpushed", 0) > 0:
            c = top.get("counts", {})
            bits.append(
                f'The heaviest is <em>{esc(top.get("label","?"))}</em>: '
                f'{top["unpushed"]} unpushed across {c.get("branches",0)} branches '
                f'and {c.get("sessions",0)} sessions.')

    return " ".join(bits) if bits else (
        "Nothing outstanding — every arc is pushed, ticketed, and says what it is.")


def esc(x):
    return html.escape(str(x), quote=True)


def heat(arc):
    """State in form as well as number, so what needs attention reads at a glance."""
    if arc.get("state") == "waiting on review" or arc.get("unpushed", 0) >= 25:
        return "hot"
    if arc.get("unpushed", 0) > 0 or arc.get("state") == "at risk":
        return "warm"
    return "calm"


def render(data, lede, focus_days, limit):
    out = []
    a = out.append
    arcs = [x for x in data.get("arcs", []) if x.get("age_days", 999) <= focus_days]
    arcs.sort(key=lambda x: (-x.get("engagement", 0), x.get("age_days", 999)))
    gap = data.get("gap") or {}

    try:
        stamp = datetime.fromisoformat(data.get("generated", "")).strftime(
            "%a %-d %b %Y, %-I:%M %p")
    except (ValueError, TypeError):
        stamp = data.get("generated", "unknown")

    a("<title>Work Arcs</title>")
    a(f"<style>{CSS}</style>")
    a('<div class="page">')
    a("<h1>Work Arcs</h1>")
    a('<div class="stamp">')
    a(f"<span>{esc(stamp)}</span><span>{esc(data.get('repo',''))}</span>")
    a(f"<span>{data.get('arc_count',0)} arcs</span>")
    a(f"<span>active &le; {focus_days}d</span>")
    a("</div>")
    lede = lede or derive_lede(data, focus_days)
    if lede:
        a(f'<p class="lede">{lede}</p>')

    # --- what you are working on -------------------------------------------
    a("<section>")
    a("<h2>In flight</h2>")
    a('<p class="note">Arcs with real activity, ranked by how deeply you engaged with '
      "them rather than by which was touched most recently. Each card holds everything "
      "the arc contains — that is the difference from a list of branches.</p>")
    a('<div class="arcs">')
    for arc in arcs[:limit]:
        c = arc.get("counts", {})
        a(f'<div class="arc is-{heat(arc)}">')
        a('<div class="arc-head">'
          f'<span class="arc-name">{esc(arc.get("label","?"))}</span>'
          f'<span class="arc-state">{esc(arc.get("state",""))}</span></div>')
        a('<div class="metrics">')
        if arc.get("unpushed"):
            a(f"<span><b>{arc['unpushed']}</b> unpushed</span>")
        def plural(n, word):
            return f"{n} {word}" + ("" if n == 1 else "s")
        a(f"<span>{plural(c.get('branches',0),'branch').replace('branchs','branches')}</span>")
        if c.get("sessions"):
            a(f"<span>{plural(c['sessions'],'session')}</span>")
        if arc.get("stacked"):
            a(f"<span>{arc['stacked']} stacked</span>")
        if c.get("stashes"):
            a(f"<span>{plural(c['stashes'],'stash').replace('stashs','stashes')}</span>")
        a(f"<span>{arc.get('age_days','?')}d idle</span>")
        a("</div>")
        a('<div class="members">')
        for b in arc.get("branches", [])[:4]:
            cls = "risk" if b.get("unpushed") else ""
            tail = f" · {b['unpushed']} unpushed" if b.get("unpushed") else ""
            a(f'<span class="{cls}">{esc(b.get("name","?"))}{esc(tail)}</span>')
        extra = c.get("branches", 0) - 4
        if extra > 0:
            a(f"<span>+{extra} more</span>")
        a("</div></div>")
    a("</div></section>")

    # --- where Jira disagrees with the code --------------------------------
    if gap:
        mism = gap.get("status_mismatch") or []
        if mism:
            a("<section>")
            a("<h2>Jira says otherwise</h2>")
            a('<p class="note">Tickets whose status asserts the work left your hands, '
              "while the commits are still on this laptop.</p>")
            a('<div class="scroll"><table><thead><tr>'
              "<th>Ticket</th><th>Claim</th><th>Reality</th><th>Summary</th>"
              "</tr></thead><tbody>")
            for m in mism[:14]:
                i = m.get("issue", {})
                a(f'<tr><td class="k">{esc(i.get("key",""))}</td>'
                  f'<td class="d">{esc(i.get("status",""))}</td>'
                  f'<td class="n">{esc(m.get("why","").split(" but ")[-1])}</td>'
                  f'<td class="d">{esc(i.get("summary","")[:58])}</td></tr>')
            a("</tbody></table></div></section>")

        unt = gap.get("unticketed_work") or []
        if unt:
            a("<section>")
            a("<h2>Real work with no ticket</h2>")
            a('<p class="note">Invisible to Jira, and therefore to Trellis — absent '
              "from capacity, burndown and every initiative rollup. Each has a one-step "
              "command to file it.</p>")
            a('<div class="scroll"><table><thead><tr>'
              "<th>Arc</th><th>Branches</th><th>Sessions</th><th>Unpushed</th>"
              "<th>File it</th></tr></thead><tbody>")
            for x in unt[:12]:
                cc = x.get("counts", {})
                a(f'<tr><td class="k">{esc(x.get("label","?"))}</td>'
                  f'<td class="d">{cc.get("branches",0)}</td>'
                  f'<td class="d">{cc.get("sessions",0)}</td>'
                  f'<td class="n">{x.get("unpushed",0) or ""}</td>'
                  f'<td><code>work-arcs --jira-ify {esc(x.get("label","?"))}</code></td>'
                  "</tr>")
            a("</tbody></table></div></section>")

        empty = gap.get("tickets_without_work") or []
        if empty:
            a("<section>")
            a("<h2>Tickets with nothing behind them</h2>")
            a('<p class="note">Assigned and open, with no branch or session against '
              "them. Either they have not started, or they are done and nobody closed "
              "them.</p>")
            a('<div class="scroll"><table><thead><tr>'
              "<th>Ticket</th><th>Status</th><th>Summary</th><th>Initiative</th>"
              "</tr></thead><tbody>")
            for i in empty[:14]:
                init = ", ".join(i.get("initiatives") or []) or "—"
                a(f'<tr><td class="k">{esc(i.get("key",""))}</td>'
                  f'<td class="d">{esc(i.get("status",""))}</td>'
                  f'<td class="d">{esc(i.get("summary","")[:52])}</td>'
                  f'<td class="d">{esc(init[:44])}</td></tr>')
            a("</tbody></table></div></section>")

    a("<footer>Derived, never declared — arcs come from the files your work "
      "touched, not from what branches were named. Nothing here is written to Jira, "
      "Slack or a repo unless you run the command yourself.</footer>")
    a("</div>")
    return "\n".join(out)


def main():
    p = argparse.ArgumentParser(description="Render work-arcs --json as a page.")
    p.add_argument("--lede", default="",
                   help="override the derived opening sentence (normally unnecessary — "
                        "it is composed from the data so it cannot go stale)")
    p.add_argument("--focus", type=int, default=14, help="arcs idle at most this long")
    p.add_argument("--limit", type=int, default=12, help="arc cards to show")
    p.add_argument("--out", type=Path)
    args = p.parse_args()
    try:
        data = json.load(sys.stdin)
    except json.JSONDecodeError as e:
        sys.exit(f"arcs-page: stdin is not `work-arcs --json`: {e}")
    page = render(data, args.lede, args.focus, args.limit)
    if args.out:
        args.out.write_text(page)
        print(f"✓ {args.out} ({len(page)} bytes)", file=sys.stderr)
    else:
        print(page)


if __name__ == "__main__":
    main()
