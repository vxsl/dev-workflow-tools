#!/usr/bin/env -S python3 -u
"""
arcs-page: render `work-arcs --json` as the standing picture of your work.

The first version of this page listed artifacts -- 97 stash rows, 261 branch rows --
and was correctly called useless: `stash@{38}` on its own says nothing, and a flat
list of branches is the same wall of text in a nicer font. The unit was wrong.

This renders arcs. One card per arc, with the branches, sessions, stashes and MRs it
contains nested inside it, so the page answers "what am I working on" in one screen
instead of asking you to reassemble it from rows.

  work-arcs --json | arcs-page --out page.html

Deterministic: the same data renders the same page every time. The one sentence that
needs judgment comes in with --lede.
"""

import argparse
import html
import json
import sys
from datetime import datetime
from pathlib import Path

CSS = """
:root{
  --ground:#F6F7FA;--surface:#FFFFFF;--surface-2:#EFF1F6;
  --ink:#161922;--ink-soft:#59616F;--ink-faint:#8A91A0;
  --hairline:#E2E5EC;--accent:#4453C4;
  --hot:#A93826;--warm:#9C6414;--calm:#3F6E52;
  --hot-wash:#FBF0EE;--warm-wash:#FBF5EC;--calm-wash:#EFF5F1;
  --serif:ui-serif,Charter,"Bitstream Charter",Georgia,serif;
  --sans:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --mono:ui-monospace,SFMono-Regular,"SF Mono",Menlo,Consolas,monospace;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --ground:#0F1218;--surface:#161A22;--surface-2:#1C212B;
  --ink:#E3E6EC;--ink-soft:#8F97A6;--ink-faint:#6B7382;
  --hairline:#262B36;--accent:#93A0F7;
  --hot:#E27B63;--warm:#DFA24C;--calm:#7CB690;
  --hot-wash:#241A18;--warm-wash:#241E14;--calm-wash:#16211A;}}
:root[data-theme="dark"]{
  --ground:#0F1218;--surface:#161A22;--surface-2:#1C212B;
  --ink:#E3E6EC;--ink-soft:#8F97A6;--ink-faint:#6B7382;
  --hairline:#262B36;--accent:#93A0F7;
  --hot:#E27B63;--warm:#DFA24C;--calm:#7CB690;
  --hot-wash:#241A18;--warm-wash:#241E14;--calm-wash:#16211A;}

*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--ground);color:var(--ink);font-family:var(--sans);
     font-size:15px;line-height:1.55;-webkit-font-smoothing:antialiased}
.page{max-width:72rem;margin:0 auto;padding:3rem 1.5rem 5rem}
h1{font-family:var(--serif);font-weight:500;font-size:clamp(1.8rem,4vw,2.4rem);
   letter-spacing:-.015em;margin:0 0 .3rem;text-wrap:balance}
.stamp{font-family:var(--mono);font-size:.75rem;color:var(--ink-faint);
       display:flex;flex-wrap:wrap;gap:.2rem 1rem;margin-bottom:2rem}
.lede{font-family:var(--serif);font-size:clamp(1.1rem,2.1vw,1.32rem);line-height:1.5;
      max-width:36em;margin:0 0 2.5rem;text-wrap:pretty}
.lede em{color:var(--accent);font-style:normal;font-weight:600}

h2{font-family:var(--serif);font-weight:500;font-size:1.25rem;margin:0 0 .2rem;
   letter-spacing:-.01em}
.note{color:var(--ink-soft);font-size:.85rem;max-width:54em;margin:0 0 1.1rem}
section{margin-bottom:3rem}

/* One card per arc. Everything the arc contains lives inside it, which is the whole
   point -- the flat version made you reassemble this from unrelated rows. */
.arcs{display:grid;grid-template-columns:repeat(auto-fill,minmax(23rem,1fr));gap:.9rem}
.arc{background:var(--surface);border:1px solid var(--hairline);border-radius:4px;
     border-top:3px solid var(--hue,var(--hairline));padding:.9rem 1rem;
     display:flex;flex-direction:column;gap:.55rem;min-width:0}
.arc.is-hot{--hue:var(--hot);background:var(--hot-wash)}
.arc.is-warm{--hue:var(--warm)}
.arc.is-calm{--hue:var(--calm)}
.arc-head{display:flex;align-items:baseline;justify-content:space-between;gap:.6rem}
.arc-name{font-family:var(--mono);font-size:.95rem;overflow-wrap:anywhere;color:var(--ink)}
.arc-state{font-size:.68rem;text-transform:uppercase;letter-spacing:.06em;
           color:var(--hue,var(--ink-faint));white-space:nowrap}
.metrics{display:flex;flex-wrap:wrap;gap:.15rem 1rem;font-family:var(--mono);
         font-size:.75rem;color:var(--ink-soft);font-variant-numeric:tabular-nums}
.metrics b{color:var(--ink);font-weight:600}
.members{font-family:var(--mono);font-size:.72rem;color:var(--ink-faint);
         display:flex;flex-direction:column;gap:.15rem}
.members span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.members .risk{color:var(--hot)}

table{width:100%;border-collapse:collapse;font-size:.82rem}
.scroll{overflow-x:auto;border:1px solid var(--hairline);border-radius:4px;
        background:var(--surface)}
th{text-align:left;font-size:.68rem;text-transform:uppercase;letter-spacing:.06em;
   color:var(--ink-soft);font-weight:600;padding:.5rem .7rem;
   border-bottom:1px solid var(--hairline);white-space:nowrap}
td{padding:.45rem .7rem;border-bottom:1px solid var(--hairline);vertical-align:top}
tr:last-child td{border-bottom:none}
