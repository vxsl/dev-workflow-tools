# ============================================================================
# Jira Configuration
# ============================================================================
# Path to the repo that uses Jira. Jira features (rr ticket lookups, jira-fzf,
# oneshot) are only active when running inside this repo. Also place a
# .claude/settings.json with Atlassian MCP permissions in this repo (not globally)
# so Claude Code's Jira tools are scoped the same way.
JIRA_REPO="/path/to/your/repo"


# Your Jira instance domain (without https://)
JIRA_DOMAIN="company.atlassian.net"

# Your Jira project key (e.g. "PROJ", "DEV", "ENG")
# Used as the primary/default project when one must be picked.
JIRA_PROJECT="PROJ"

# Optional: comma-separated list of project keys to surface together in rr,
# oneshot, jira-fzf (ticket extraction, JQL queries, fzf pickers). The first
# entry is treated as primary. Falls back to JIRA_PROJECT alone if unset.
# Example: JIRA_PROJECTS="PROJ,OTHER"
# JIRA_PROJECTS="PROJ"

# Optional: extra project keys work-arcs should RECOGNISE in text, without their
# becoming boards you can file against. Everything in JIRA_PROJECTS is
# interpolated into `project IN (...)` by jira-fzf and rr.sh and offered by
# create-jira-ticket's board picker, so a project you only ever read from --
# typically the one holding company initiatives -- does not belong there: it
# floods the daily ticket picker and offers a menu item nobody wants. This
# widens work-arcs' ticket-key pattern and nothing else, so a key mentioned in
# a Slack commitment or a merge request title is still understood.
# Example: JIRA_EXTRA_PROJECTS="INIT"
# JIRA_EXTRA_PROJECTS=""

# Optional: the board new tickets always go on. With several projects in
# JIRA_PROJECTS, create-jira-ticket (and so oneshot) opens with a "Select board"
# picker; set this to the one key you file on and that step disappears. Must be
# one of JIRA_PROJECTS. `create-jira-ticket --project OTHER` still overrides it
# for a single run.
# JIRA_DEFAULT_PROJECT="PROJ"

# Your Jira email address
JIRA_EMAIL="your-email@company.com"

# Jira API token
# Get from: https://id.atlassian.com/manage-profile/security/api-tokens
# Required scopes: read:jira-work, write:jira-work, read:jira-user
# For sprint features: read:board:jira-software, read:sprint:jira-software, write:sprint:jira-software
JIRA_API_TOKEN="your-jira-api-token-here"

# ============================================================================
# Slack Integration
# ============================================================================
# Enables: posting ticket/MR links back to Slack threads
# Usage: oneshot https://slack.com/archives/...
# Leave empty to disable
TICKET_CREATOR_BOT_TOKEN=""

# Socket Mode app-level token (xapp-...) — required for ticket-bot
# Enable Socket Mode in your Slack app, then generate an App-Level Token
# with connections:write scope
SLACK_APP_TOKEN=""

# To set up:
# 1. Create bot at: https://api.slack.com/apps
# 2. Add bot scopes: chat:write, files:write, channels:read, channels:history,
#    groups:read, groups:history, im:history, im:write,
#    reactions:read, reactions:write, users:read
# 3. Enable Socket Mode, generate App-Level Token (connections:write)
# 4. Subscribe to events: message.channels, message.groups, message.im, reaction_added
# 5. Enable Interactivity (Features → Interactivity & Shortcuts); leave
#    the Request URL blank for Socket Mode. Required for the
#    "Create Jira ticket" button + modal on slack-thread jobs.
# 6. Install to workspace and copy the Bot User OAuth Token

# User OAuth token (xoxp-...) for the SAME app as TICKET_CREATOR_BOT_TOKEN.
# Enables: slack-pick-thread, the fzf picker of threads you've been in that
# publish-changes offers instead of asking you to paste a Slack URL.
#
# A bot token cannot be used here — it can only see the channels the BOT is in,
# and the question is which channels YOU are in.
#
# Add under "User Token Scopes" (not Bot Token Scopes):
#   channels:read, channels:history                    required
#   groups:read, groups:history                        to include private channels
#   users:read                                         names instead of user ids
#   search:read.public, search:read.private            optional, see below
# then reinstall the app and copy the User OAuth Token.
#
# Deliberately NOT im:history or mpim:history. work-arcs' Slack lens reads whole
# threads you posted in and joins them to the workstream they are about, and the
# two history scopes above are what let it do that in channels. DM and group-DM
# history it cannot read and does not ask for, so those threads are refused by
# Slack rather than filtered by us — 151 of the 219 threads in a measured
# fortnight, and the page says so on every card. Adding either scope would
# silently widen what the page can quote to the most private places in Slack; if
# you want that, it should be a decision you took on purpose.
#
# Without the search scopes the picker builds its list with one
# conversations.history call per channel you're in — for 66 channels that's
# ~5s, cached for 5 minutes and refreshed in the background. With them it can
# be a single search.messages call. Run `slack-pick-thread --check` to see
# what your token actually has.
#
# This must be the SAME app as TICKET_CREATOR_BOT_TOKEN above. There is no
# fallback to another app's user token: tokens are issued per app install, so
# borrowing one means the picker works or breaks according to an app you were
# not configuring, and --check would report that app's scopes instead.
SLACK_USER_TOKEN=""

# ============================================================================
# Slack Reaction Notifications (slack-react-notify)
# ============================================================================
# Get pinged when people react to YOUR Slack messages. By default the daemon
# DMs you on Slack, which fires Slack's own desktop + mobile notification
# (a message you send yourself wouldn't) — so you're reached on every device.
#
# Runs as its OWN dedicated Slack app — do NOT reuse the ticket-bot tokens
# above (Slack load-balances events across simultaneous Socket Mode
# connections on one app, so two daemons would each miss ~half the reactions).
#
# Fastest setup: `slack-react-notify --print-manifest`, paste it at
# https://api.slack.com/apps → "Create New App" → "From a manifest". Then:
# 1. Basic Information → App-Level Tokens → generate with connections:write
#    → SLACK_REACT_APP_TOKEN (xapp-...)
# 2. OAuth & Permissions → Install to Workspace, then copy BOTH tokens:
#      "User OAuth Token" (xoxp-...)     → SLACK_REACT_TOKEN     (events + reads)
#      "Bot User OAuth Token" (xoxb-...) → SLACK_REACT_BOT_TOKEN (DMs you)
# 3. Verify with: slack-react-notify --check
SLACK_REACT_APP_TOKEN=""
SLACK_REACT_TOKEN=""
SLACK_REACT_BOT_TOKEN=""
# Optional — delivery mode: slack (default) | desktop | both.
# "desktop" uses notify-send/osascript locally and needs no bot token.
# SLACK_REACT_DELIVERY="slack"
# Optional — your Slack user id; auto-detected via auth.test if left blank.
SLACK_REACT_USER_ID=""
# Optional — desktop-mode custom notifier, called as: CMD "<title>" "<body>".
# Defaults to notify-send (Linux) / osascript (macOS) when unset.
# SLACK_REACT_NOTIFY_CMD="$HOME/bin/notification/claude-notify.sh"
# Optional — set to 0 to also notify on your own reactions to your messages.
# SLACK_REACT_IGNORE_SELF="1"
# Optional — set to 0 to skip including the reacted message's text.
# SLACK_REACT_SNIPPET="1"

# ============================================================================
# QA Branch Integration
# ============================================================================
# Enables: auto-setting QA branch field when creating MRs
# Format: {branch-name}.{domain}
# Leave empty to disable
JIRA_QA_BRANCH_DOMAIN=""

# Examples:
# Single domain:
#   JIRA_QA_BRANCH_DOMAIN="https://qa.company.com"
# Multiple domains (shows menu to pick):
#   JIRA_QA_BRANCH_DOMAIN="https://qa.company.com,https://qa.company.ca"

# Field ID (auto-detected if empty)
JIRA_QA_BRANCH_FIELD=""

# Custom command to open QA branch URLs (optional)
# The URL is passed as $1. Falls back to default browser if empty.
# Example: open in a specific Chromium instance via DevTools Protocol:
#   JIRA_QA_BRANCH_OPEN_CMD="wmctrl -i -a $(wmctrl -lx | grep project-chromium | head -1 | awk '{print $1}') 2>/dev/null; curl -s -X PUT \"http://localhost:9222/json/new?\$1\" >/dev/null 2>&1"
JIRA_QA_BRANCH_OPEN_CMD=""

# ============================================================================
# Optional Tweaks
# ============================================================================
# Your JIRA username - used by rr.sh to highlight your assigned branches
JIRA_ME=""

# Max age (in days) of remote-only branches shown at the bottom of rr.
# Branches older than this are hidden. Set to 0 for no limit. Default: 90.
RR_REMOTE_MAX_AGE_DAYS=90

# How many pages of Jira results rr pulls for its branchless-ticket sections.
# Jira's /search/jql caps a page at 100 issues, so these are the ceiling on how
# far back (by last-updated) you can search the team's tickets by assignee name.
# Raise for more coverage, lower for a faster refresh. Defaults: 2 and 5.
RR_JIRA_ASSIGNED_PAGES=2
RR_JIRA_ACTIVE_PAGES=5

# FZF behavior: 0=exit after action, 1=stay open (for scratchpads)
FZF_PERSIST_MODE=0

# ============================================================================
# Tmux Pane Management (Optional)
# ============================================================================
# Enable pane management from rr
# When enabled, you can set worktrees as "active targets" for specific tmux panes
# and switch them between worktrees with keybindings
RR_PANE_MGMT_ENABLED=false

# Pane configuration format:
# RR_PANE_N_ID       - Tmux pane ID (format: session:window.pane)
# RR_PANE_N_DIR      - Subdirectory within worktree (optional, e.g., "client/web")
# RR_PANE_N_COMMAND  - Command to run
# RR_PANE_N_LABEL    - Short label for help/header (e.g., "dev", "tsc")
# RR_PANE_N_INDICATOR- Unicode symbol for visual indicator (e.g., "▶", "⏩")
# RR_PANE_N_KEY      - Keybinding (f4, f5, f6, f7, f10, f11, f12)

# Example Pane 1 - Dev Server
RR_PANE_1_ID="tmuxa-1:0.0"
RR_PANE_1_DIR="client/web"
RR_PANE_1_COMMAND="mkdir -p ~/.config/dev-workflow && if [ -f \"\$PWD/.env\" ]; then ln -sf \"\$PWD/.env\" ~/.config/dev-workflow/current.env; yarn install && yarn run-p tailwind dev; else echo \"✗ \$PWD/.env is missing — dev server not started; copy .env into this worktree, then rerun\"; fi"
RR_PANE_1_LABEL="dev"
RR_PANE_1_INDICATOR="▶"
RR_PANE_1_KEY="f4"

# Example Pane 2 - TSC Watch
RR_PANE_2_ID="tmuxa-1:0.1"
RR_PANE_2_DIR="client/web"
RR_PANE_2_COMMAND="yarn tsc-watch"
RR_PANE_2_LABEL="tsc"
RR_PANE_2_INDICATOR="⏩"
RR_PANE_2_KEY="f5"

# Add more panes by incrementing the number (3, 4, 5...)
# Available keys: f4-f7, f10-f12 (f1=help, f2=new wt, f3=new branch+wt, f8=delete wt, f9=internal auto-clear)

# ============================================================================
# Editor Integration (Optional)
# ============================================================================
# Auto-open/focus Cursor when navigating to a worktree via rr.
# Runs `cursor <path>` in the background — focuses an existing Cursor window
# at that path, or opens a new one (same behavior as GitLens worktree switcher).
# Tip: use `cursor --reuse-window <path>` variant by editing dev-workflow.zsh
# if you prefer to switch folders in your current window instead of per-worktree windows.
RR_CURSOR_SWITCH=false

# ============================================================================
# Worktree Customization (Optional)
# ============================================================================
# Automatically modify files in new worktrees after they're created

# VS Code workspace settings to inject (JSON format)
# These settings are merged into .vscode/settings.json in client/web
# Example: Disable Rust analyzer in all worktrees
VSCODE_WORKSPACE_SETTINGS='{"rust-analyzer.enable": false}'

# Files/directories to copy from the main repo to each new worktree
# Space-separated list of paths relative to the git root
# Default: client/web/.env client/web/ulweb/pkg client/web/.cursor client/web/.vscode
# WT_FILES_TO_COPY="client/web/.env client/web/.vscode"

# Paths to exclude when copying files (space-separated, supports wildcards)
# Useful for skipping large build artifacts like Rust's target/ directory
# Example: WORKTREE_COPY_EXCLUDE="target/ *.log build/"
WORKTREE_COPY_EXCLUDE="target/"

# Post-worktree hook script (runs after worktree creation and file copying)
# The script receives the worktree path as $1
# Example: POST_WORKTREE_HOOK="$HOME/bin/my-worktree-setup.sh"
POST_WORKTREE_HOOK=""

# ============================================================================
# fzedit (Optional)
# ============================================================================
# The pad infers its worktree from your most recently active tmux pane. These
# only matter before it has inferred anything, and for naming the ⊙ rows.

# Whose worktrees to offer on a cold start, and what ⊙ rows are named relative
# to. Empty means "no worktree rows until you are somewhere that resolves a repo".
# FZEDIT_DEFAULT_REPO="$HOME/work/repos/monorepo"

# Colon-separated dirs swept ahead of the rest of $HOME on the `home` rung, so
# their files outrank an incidental match elsewhere. Prepended to the built-in
# list ($HOME/work, ~/.config, ~/.xmonad, ~/bin).
# FZEDIT_PREFERRED_DIRS="$HOME/work/repos/monorepo/webapp"

# Home-sweep noise lives in ~/.config/fzedit/ignore, seeded on first run.

# The pad key is your WM's, not fzedit's. fzedit only needs to know which key it is
# so it can raise the pad when tig hands a file over -- and only under xmonad, which
# has no IPC to ask properly. Hyprland uses pad.sh and ignores this.
# FZEDIT_PAD_KEY="ctrl+alt+space"

# Worktree picking (^T) shells out to rr, so you get tickets, MR state and dirty
# flags rather than a second, worse picker. FZEDIT_NO_RR=1 falls back to the plain one.
# FZEDIT_RR_ARGS="-f"

# The picker draws as an inset panel rather than filling the pad window, so it reads as
# something you summoned rather than an application you are inside. Editors are
# unaffected: fzf hands the whole terminal to nvim, tig and the pager. fzf --margin
# syntax (rows/cols or %), and FZEDIT_MARGIN= (empty) fills the window again.
# FZEDIT_MARGIN="1,8%"
# FZEDIT_BORDER="rounded"

# ^T with a blank box writes here, named for the clock, so a scratchpad costs no naming
# decision. Keep it under $HOME: ~/.cache is the first thing the home sweep ignores, and a
# scratchpad the pad cannot find again is one you have lost.
# FZEDIT_SCRATCH_DIR="$HOME/scratch"
# FZEDIT_SCRATCH_EXT="md"
